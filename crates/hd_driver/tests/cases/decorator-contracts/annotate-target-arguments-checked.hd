# @dump: diagnostics
# @build: dev | checked
# test: consumed annotate calls check target arguments through plain, aliased and qualified names
use std.meta
use std.meta.annotate
use std.meta.annotate as targets

@annotate(.Missing) # diagnostic: unknown-variant
struct Plain: pass

@targets(kinds=[.Missing]) # diagnostic: unknown-variant
struct Aliased: pass

@meta.annotate([.Missing]...) # diagnostic: unknown-variant
struct Qualified: pass
