# @dump: diagnostics
# @build: dev | checked
# test: consumed annotate specializations require a type in both called and bare forms
use std.annotation
use std.annotation.annotate
use std.annotation.annotate as targets

@annotate::[1](.Field) # diagnostic: generic-kind-mismatch
struct PlainCall: pass

@targets::[1](.Field) # diagnostic: generic-kind-mismatch
struct AliasCall: pass

@annotation.annotate::[1](.Field) # diagnostic: generic-kind-mismatch
struct QualifiedCall: pass

@annotate::[1] # diagnostic: generic-kind-mismatch
struct PlainBare: pass

@targets::[1] # diagnostic: generic-kind-mismatch
struct AliasBare: pass

@annotation.annotate::[1] # diagnostic: generic-kind-mismatch
struct QualifiedBare: pass
