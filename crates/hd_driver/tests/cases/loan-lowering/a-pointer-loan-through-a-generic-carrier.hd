# @dump: stdout wat counts
# @build: dev | checked | release
use std.annotation.inline

struct Slots:
    items: List[string]

impl Slots:
    @inline(.Never)
    fn first['a](&'a self) -> &'a string:
        &self.items[0]

# A non-inlined call may write through a distinct pointer parameter. The
# false runtime argument keeps the successful path, while the write effect
# prevents whole-program loan elision from removing the loan under test.
@inline(.Never)
fn maybe_change(alias: *mut Slots, change: bool) -> void:
    if change:
        alias.items.push("alias")

struct Carrier[T]:
    value: T

@inline(.Never)
fn keep[T < ?Copy](value: T) -> T:
    value

@inline(.Never)
fn carried(p: *mut Slots, alias: *mut Slots) -> string:
    held := keep(Carrier { value: p.first() })
    maybe_change(alias, false)
    *held.value

pub fn main() -> void $ Console:
    p := box(Slots { items: ["held"] })
    println(carried(p, p))
    p.items.push("after")
    println(p.items.len())
