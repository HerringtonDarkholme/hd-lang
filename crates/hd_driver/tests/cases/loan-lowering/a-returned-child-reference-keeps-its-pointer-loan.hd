# @dump: stdout
# @build: dev | checked | release
# The argument is a stored local reference, and the callee hands out the
# counted child (a reference through it would be local to the callee,
# `ref.local.pointer`); the caller's own reference through it borrows the
# child, so the aliased child write panics borrow-conflict (#2174, #2339).
use std.meta.inline

struct Node:
    value: usize
    children: List[*mut Node]

@inline(.Never)
fn descend(node: &Node) -> *mut Node:
    node.children[0]

@inline(.Never)
fn maybe_change(alias: *mut Node, change: bool) -> void:
    if change:
        alias.children = []

pub fn main() -> void $ Console:
    let head: *mut Node = box(Node { value: 0, children: [] })
    let n = 1
    while n < 4:
        head = box(Node { value: n, children: [head] })
        n += 1
    let alias = head.children[0]
    let current = &*head
    current = &*descend(current)
    maybe_change(alias, true)
    println(current.value)
