# @dump: stdout
# @build: dev | release
# A returned reference into an object the callee reached through a
# pointer keeps that object's loan after inlining: the inliner moves the
# callee's closes to where the caller closes the INNER loan, so the alias
# write panics borrow-conflict in both builds.
struct Cell:
    value: string
    other: string

struct Outer:
    next: *mut Cell
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { next: box(Cell { value: orig(), other: second() }), other: second() })

impl Outer:
    fn slot_ref(&self) -> &string:
        &self.next.value

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := p.slot_ref()
    alias.next.value = fresh() # panic: borrow-conflict
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
