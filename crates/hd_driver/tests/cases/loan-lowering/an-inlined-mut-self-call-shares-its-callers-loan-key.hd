# @dump: stdout
# @build: dev | release
# An inlined `&mut self` method's own accesses go through the caller's
# lent pointer's key, so they are the loan's own; an alias read panics
# borrow-conflict in both builds (the inlined-parameter key in `borrow.rs`).
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

impl Cell:
    fn slot_mut(&mut self) -> &mut string:
        &mut self.value

fn probe(p: *mut Cell, alias: *Cell) -> string:
    r := p.slot_mut()
    seen_alias := alias.value # panic: borrow-conflict
    junk := churn()
    _ := seen_alias.len()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
