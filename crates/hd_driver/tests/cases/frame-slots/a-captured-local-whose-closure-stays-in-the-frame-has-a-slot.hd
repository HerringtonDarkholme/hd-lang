# @dump: wat
# @build: v8 release
# `read` shares `tally`, but `read` never leaves the frame and `&mut tally`
# is lent to one call, so `tally` lives in a frame slot, not a counted
# cell (#1399 19a4).
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn shared() -> i64:
    # subject
    let mut tally = Tally { n: 0 }
    read := fn() -> i64: tally.n
    bump(&mut tally)
    read()
