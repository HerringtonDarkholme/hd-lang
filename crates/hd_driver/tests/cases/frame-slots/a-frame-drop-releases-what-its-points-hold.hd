# @dump: own counts wat
# @build: v8 release
# expected: a frame's `.drop` frees only a frame that never started (#1430:
# checked builds trap on a started one), so it releases the exit set's locals
# and no value row. `holds`'s temporary has a row at the point, so the body's
# cancelled way out releases it (`release string (cancelled)`); `gone`'s
# temporary ends before the point, so nothing releases it there.
use std.annotation.inline
use std.time.{Clock, ms, sleep}

@inline(.Never)
fn text(n: i32) -> string:
    "t${n}"

@inline(.Never)
fn total(a: string, b: string) -> usize:
    a.len() + b.len()

fn pause!() -> string $ Clock:
    sleep!(ms(1))
    "x"

fn holds!() -> usize $ Clock:
    total(text(1), pause!())

fn gone!() -> usize $ Clock:
    n := text(1).len()
    sleep!(ms(1))
    n
