# @dump: own wat
# @build: v8
# A suspending root's local that only an await of a known body takes lives
# in a slot of its frame; one a trait value's method awaits keeps its cell,
# as that await's cold frame counts the reference.
# Keep the call boundary under test when small bang bodies can inline.
use std.meta.inline

use std.time.{Clock, ms, sleep}

trait Sizer:
    fn size!(&self, text: &string) -> usize $ Clock

struct Plain: pass

impl Sizer for Plain:
    fn size!(&self, text: &string) -> usize $ Clock:
        sleep!(ms(1))
        text.len()

@inline(.Never)
fn known!(text: &string) -> usize $ Clock:
    sleep!(ms(1))
    text.len()

fn through_known!(n: usize) -> usize $ Clock:
    let text = "k".repeat(n)
    known!(&text)

fn through_value!(sizer: &dyn Sizer, n: usize) -> usize $ Clock:
    let text = "v".repeat(n)
    sizer.size!(&text)

pub fn main!() -> void $ Console + Clock:
    let plain = Plain {}
    println("${through_known!(2)} ${through_value!(&plain, 3)}")
