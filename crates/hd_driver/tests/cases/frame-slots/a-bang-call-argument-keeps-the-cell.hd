# @dump: wat
# @build: v8 release
# `&mut tally` is an argument of a bang call, whose suspension the
# reference spans, so `tally` keeps its counted cell.
use std.time.{Clock, ms, sleep}

struct Tally:
    n: i64

fn bump!(t: &mut Tally) -> void $ Clock:
    sleep!(ms(1))
    t.n = t.n + 1

fn waits!() -> i64 $ Clock:
    # subject
    let mut tally = Tally { n: 0 }
    bump!(&mut tally)
    tally.n
