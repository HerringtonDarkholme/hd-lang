# @dump: wat
# @build: v8 release
# `user.name()` returns a reference into `user`, which outlives the call
# (spec/lang/13-values-and-references.md#dependent-results), so `user`
# keeps its counted cell (`rt:new`) rather than a slot of the frame. The
# result holds a count of the cell until its last use.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

# subject
fn length() -> usize:
    user := User { name: "ada", age: 36 }
    n := user.name()
    n.len()
