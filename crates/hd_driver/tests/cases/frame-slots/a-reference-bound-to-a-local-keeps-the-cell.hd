# @dump: wat
# @build: v8 release
# `r` holds the local reference past the expression that made it, so
# `tally` keeps its counted cell: only a reference that is one call's
# argument lends a slot.
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn bound() -> i64:
    # subject
    let mut tally = Tally { n: 0 }
    let r: &mut Tally = &mut tally
    bump(r)
    tally.n
