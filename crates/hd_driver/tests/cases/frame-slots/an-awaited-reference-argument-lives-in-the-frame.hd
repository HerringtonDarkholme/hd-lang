# @dump: own counts wat
# @build: v8 release
# `text` is borrowed only by `size!(&text)`, an await of a known body
# that keeps the reference uncounted in its own frame, so `text` lives in
# a slot of `caller`'s frame object (#1707): no cell, and no count of the
# reference. The frame is made at the declaration when `caller` runs
# without one, and a Ready exit frees it.
use std.time.{Clock, ms, sleep}

fn size!(text: &string) -> usize $ Clock:
    sleep!(ms(1))
    text.len()

# subject
fn caller!(n: usize) -> usize $ Clock:
    let text = "x".repeat(n)
    size!(&text)
