# @dump: own counts wat
# @build: v8 release
# expected: the ready `helper!` uses the plain body ABI, and moving
# `sink.text` into the result still releases its addressable local.
struct Sink:
    text: string

impl Sink:
    fn set(&mut self, value: string) -> void:
        self.text = value

# subject
fn helper!() -> string:
    let mut sink = Sink { text: "" }
    sink.set("helper")
    sink.text
