# @dump: wat
# @build: v8 release
# `bump!(&mut tally)` is the last access of `tally`, in a suspending body:
# its frame saves the local at the suspension point, so no reference takes
# the local and `tally` keeps its counted cell.
use std.time.{Clock, ms, sleep}

struct Tally:
    n: i64

fn bump!(t: &mut Tally) -> void $ Clock:
    sleep!(ms(1))
    t.n = t.n + 1

# subject
fn waits!() -> void $ Clock:
    let mut tally = Tally { n: 0 }
    bump!(&mut tally)
