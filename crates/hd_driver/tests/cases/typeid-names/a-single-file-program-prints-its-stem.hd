# @dump: stdout
# @single-file: true
# trait.typeid.name.single-file: a single-file program's declaration
# prints under the file's stem, then the name.
use std.inspect.TypeId

struct User:
    name: string

pub fn main() -> void $ Console:
    println("${TypeId::of::[User]()}")
    println("${TypeId::of::[User?]()}")
    println("${TypeId::of::[List[User]]()}")
    println("${TypeId::of::[(User, i32)]()}")
    println("${TypeId::of::[Map[string, User?]]()}")
