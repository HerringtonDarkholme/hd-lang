# @dump: stdout
# @build: dev | release checked
use std.meta.cold

struct Wide:
    f0: i32
    f1: i32
    f2: i32
    f3: i32
    f4: i32
    f5: i32
    f6: i32
    f7: i32
    f8: i32
    f9: i32
    f10: i32
    f11: i32
    f12: i32
    f13: i32
    f14: i32
    f15: i32
    f16: i32

@cold
fn make(n: i32) -> Wide $ Console:
    println("made")
    Wide {
        f0: n + 0,
        f1: n + 1,
        f2: n + 2,
        f3: n + 3,
        f4: n + 4,
        f5: n + 5,
        f6: n + 6,
        f7: n + 7,
        f8: n + 8,
        f9: n + 9,
        f10: n + 10,
        f11: n + 11,
        f12: n + 12,
        f13: n + 13,
        f14: n + 14,
        f15: n + 15,
        f16: n + 16,
    }

pub fn main() -> void $ Console:
    _ := make(7)
    panic("after wide result")
