# @dump: tir own counts wat
# @build: v8 release
# Feature: Loop Values and Infinite Loops (spec/lang/06-control-flow.md, #1364).
# expected: `break x` retains only the element it returns (the list is
# lent); the `else` string is a static literal; elements only tested take
# no count; `forever` returns its built string with no extra count.
fn first_long(xs: List[string]) -> string:
    for x in xs:
        if x.len() > 3:
            break x
    else:
        "none"

fn first_index(xs: List[string]) -> usize:
    let i: usize = 0
    while i < xs.len():
        if xs[i].len() > 3:
            break i
        i += 1
    else:
        xs.len()

fn forever(s: string) -> string:
    let out = s
    while true:
        if out.len() > 8:
            return out
        out += "!"
