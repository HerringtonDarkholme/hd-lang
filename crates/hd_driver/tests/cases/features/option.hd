# @dump: tir own counts wat
# @build: v8 release
# Feature: `Option` and `?` (#1364).
# expected: `unwrap` only reads its payload and takes no count.
# `question` cleans up its owned option state and the old string after
# concatenation; `+` creates a new string. `or_default` retains the owned
# string it returns from its borrowed input, whose caller keeps its count.
fn unwrap(o: string?) -> usize:
    match o:
        .Some(s) => s.len()
        .None => 0

fn question(o: string?) -> string?:
    s := o?
    .Some(s + "!")

fn or_default(o: string?) -> string:
    o.unwrap_or("none")
