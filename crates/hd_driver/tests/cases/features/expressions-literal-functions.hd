# @dump: tir own counts wat
# @build: v8 release
# Feature: Literal Suffixes and Prefixed Strings (spec/lang/05-expressions.md, #1364).
# expected: each literal is one plain call; `sql` moves the template's
# two lists into the query with no count; `tagged` retains `s` once to
# store it in `values` and frees the template after the call.
use std.ops.{Template, num_suffix, str_prefix}

struct Label:
    text: string

struct Query:
    text: List[string]
    params: List[i64]

@num_suffix
fn lbl(n: i64) -> Label:
    Label { text: "#${n}" }

@str_prefix
fn sql(t: Template[i64]) -> Query:
    Query { text: t.raw_parts, params: t.values }

@str_prefix
fn tag(t: Template[string]) -> usize:
    t.raw_parts.len() + t.values.len()

fn suffixed() -> Label:
    12lbl

fn prefixed(id: i64) -> Query:
    sql"select * from users where id = $id"

fn tagged(s: string) -> usize:
    tag"<$s>"
