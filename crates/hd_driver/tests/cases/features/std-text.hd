# @dump: tir own counts wat
# @build: v8 release
# Feature: `StringBuilder` and `string.split` (spec/std/text.md, #1364).
# expected: `build` appends each part into one buffer with no
# temporary string and no count per part; `fields` makes one string
# per field and reads each length with no count.
use std.text.StringBuilder

fn build(parts: &List[string]) -> string:
    sb := StringBuilder::new()
    for p in parts:
        sb.push(p)
        sb.push(",")
    sb.build()

fn fields(line: string) -> usize:
    let mut n = 0
    for f in line.split(","):
        n += f.len()
    n
