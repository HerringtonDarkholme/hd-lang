# @dump: tir own counts wat
# @build: v8 release
# Feature: Suspending Closures And Clauses, Suspending Function Values (spec/lang/07-functions.md, #1364).
# expected: `construct` allocates one suspension and frees it unrun;
# `closure_bang` and `stored` hold `key` in the suspending frame (by
# design, #1355) and build one string per `fetch`.
fn fetch!(key: string) -> string:
    key + "?"

fn construct(key: string) -> usize:
    _ := fetch(key)
    key.len()

fn run_twice!(body: fn!() -> string) -> usize:
    body!().len() + body!().len()

fn closure_bang!(key: string) -> usize:
    run_twice!():
        fetch!(key)

fn stored!(key: string) -> usize:
    loader := fn!(k: string) -> string: fetch!(k)
    loader!(key).len()
