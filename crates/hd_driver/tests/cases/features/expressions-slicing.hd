# @dump: tir own counts wat
# @build: v8 release
# Feature: Slicing strings and lists (spec/lang/05-expressions.md, #1364).
# expected: a string slice is a view that retains its base once; a list
# slice allocates one list and retains each copied element, including
# a whole-list selection. String slice length needs no allocation or count.
fn str_slice(s: string) -> string:
    s.slice(1, 3)

fn str_slice_len(s: string, n: usize) -> usize:
    s.slice(0, n).len()

fn list_slice(xs: List[string]) -> List[string]:
    xs.slice(1, xs.len())

fn list_full(xs: List[string]) -> List[string]:
    xs.slice(0, xs.len())

fn list_slice_len(xs: List[string]) -> usize:
    xs.slice(0, 2).len()
