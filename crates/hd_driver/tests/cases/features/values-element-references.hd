# @dump: tir own counts wat
# @build: v8 release
# Feature: Element References, Call-Scoped Access
# (spec/lang/13-values-and-references.md, #1364).
# expected: `&mut out[best]` is the element's address after one
# uniqueness check of `out`; no count for the element; `by_key` the
# same for a map value.
struct Player:
    name: string
    score: i32

fn reward(player: &mut Player, points: i32) -> void:
    player.score += points

fn rewarded(players: List[Player], best: usize, s: string) -> List[Player]:
    let mut out = players
    reward(&mut out[best], 10)
    out[best].score += 1
    out.push(Player { name: s, score: 0 })
    out

fn by_key(m: Map[string, Player], k: string) -> Map[string, Player]:
    let mut out = m
    reward(&mut out[k], 10)
    out
