# @dump: tir own counts wat
# @build: v8 release
# Feature: Standard Combinators, Typing `join!` (the list form)
# (spec/lang/11-requirements-and-suspension.md, #1364).
# expected: `all` moves each suspension out of the list into `join!`
# and the results into one new list; `lens` reads each result with no
# count.
use std.task.join

fn fetch!(key: string) -> string:
    key + "?"

fn all!(keys: List[string]) -> usize:
    let tasks: List[Suspend[string]] = [for k in keys => fetch(k)]
    results := join!(tasks...)
    let mut n = 0
    for r in &results:
        n += r.len()
    n
