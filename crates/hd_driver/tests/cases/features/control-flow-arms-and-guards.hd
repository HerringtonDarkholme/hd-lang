# @dump: tir own counts wat
# @build: v8 release
# Feature: Arms And Guards, Catch-All And Variant Patterns, Payload Patterns (spec/lang/06-control-flow.md, #1364).
# expected: a guard reads the payload with no count; `pick` retains only
# the payload it returns; a catch-all binding of the whole `string?`
# takes no count when it is only read.
enum Tag:
    Named(name: string)
    Pair(left: string, right: string)

fn pick(t: Tag) -> string:
    match t:
        .Named(n) if n.len() > 3 => n
        .Pair(right = r, left = l) if l.len() > r.len() => l
        .Pair(left = _, right = r) => r
        _ => "short"

fn whole(o: string?) -> usize:
    match o:
        .Some(s) if s.len() > 0 => s.len()
        other =>
            if other.is_some(): 1 else: 0
