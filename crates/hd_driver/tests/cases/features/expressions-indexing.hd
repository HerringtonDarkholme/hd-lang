# @dump: tir own counts wat
# @build: v8 release
# Feature: Map Indexing and String Indexing reads (spec/lang/05-expressions.md, #1364).
# expected: `map_index`, `string_byte` and `ref_list_index` take no
# count; `map_index_take` retains the returned value once.
fn map_index(m: Map[string, string], k: string) -> usize:
    m[k].len()

fn map_index_take(m: Map[string, string], k: string) -> string:
    m[k]

fn string_byte(s: string, i: usize) -> u8:
    s[i]

fn ref_list_index(xs: &List[string], i: usize) -> usize:
    xs[i].len()
