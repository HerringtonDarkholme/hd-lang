# @dump: tir own counts wat
# @build: v8 release
# Feature: Captured References (spec/lang/13-values-and-references.md, #1364).
# expected: `bump` moves `p` into one environment; `demo` retains
# `origin` once for it; `local#1` reads through the captured address
# without copying or releasing the list.
struct Point:
    name: string
    x: i32

fn bump(p: *mut Point) -> fn() -> void:
    fn() -> void: p.x = p.x + 1

fn demo(s: string) -> i32:
    origin := box(Point { name: s, x: 0 })
    step := bump(origin)
    step()
    step()
    origin.x

fn apply(f: fn() -> usize) -> usize:
    f()

fn local(xs: &List[string]) -> usize:
    apply(fn() -> usize: xs.len())
