# @dump: tir own counts wat
# @build: v8 release
# Feature: `defer` and `using` (#1364).
# expected: the deferred closure's environment holds `log` and `s` with
# one count each and runs once; `using` disposes the box once at the
# exit; no other count.
use std.ops.defer
use std.ops.Disposable

struct Res:
    name: string
    log: *mut List[string]

impl Disposable for Res:
    fn dispose(&mut self) -> void:
        self.log.push(self.name)

fn with_defer(log: *mut List[string], s: string) -> usize:
    defer(fn() -> void: log.push(s))
    s.len()

fn with_using(log: *mut List[string], s: string) -> usize:
    using r = box(Res { name: s, log: log })
    r.name.len()
