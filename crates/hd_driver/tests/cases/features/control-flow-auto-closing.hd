# @dump: tir own counts wat
# @build: v8 release
# Feature: Auto-Closing Calls (spec/lang/06-control-flow.md, #1364).
# expected: the hidden local is disposed once at exit and released once;
# `label` moves into the guard; no other count.
use std.ops.{AutoClosing, Disposable}

struct Guard:
    log: *mut List[string]
    label: string

impl Disposable for Guard:
    fn dispose(&mut self) -> void:
        self.log.push(self.label)

impl AutoClosing for Guard:
    pass

@auto_closing
fn guard(log: *mut List[string], label: string) -> Guard:
    Guard { log: log, label: label }

fn work(log: *mut List[string], label: string) -> void:
    guard(log, label)
    log.push("work")
