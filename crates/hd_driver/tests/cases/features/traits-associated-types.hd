# @dump: tir own counts wat
# @build: v8 release
# Feature: Generic Traits, Associated Types, Associated Type Bindings,
# Bound Associated Types (spec/lang/09-traits.md, #1364).
# expected: `Constant.get` retains the stored string it returns;
# `first` returns `get`'s owned result; `first_len` reads it with no count.
# `read` releases the owned result of the dynamic `get`: an implementation
# can return a fresh string. Dispatch takes no count of `source`.
trait Supplier:
    type Item
    fn get(&self) -> Self::Item

struct Constant:
    value: string

impl Supplier for Constant:
    type Item = string
    fn get(&self) -> string:
        self.value

fn first[T < Supplier](source: T) -> T::Item:
    source.get()

fn first_len(c: Constant) -> usize:
    first(c).len()

fn read(source: &dyn Supplier[Item = string]) -> usize:
    source.get().len()

fn read_const(c: Constant) -> usize:
    read(&c)
