# @dump: tir own counts wat
# @build: v8 release
# Feature: cleanup on the panic path; Runtime Panics, Panic Behavior and Panic Categories (spec/lang/06-control-flow.md, #1364).
# expected: no release, dispose or drop on a path that ends in `panic`,
# since a panic poisons the instance; the normal path releases `t` once;
# the panic message is built only on the panic path.
use std.ops.Disposable

struct Res:
    name: string
    log: *mut List[string]

impl Disposable for Res:
    fn dispose(&mut self) -> void:
        self.log.push(self.name)

fn must(s: string, n: i32) -> usize:
    t := s + "!"
    if n < 0:
        panic("negative: $t")
    t.len()

fn guarded(log: *mut List[string], s: string, n: i32) -> usize:
    using r = Res { name: s + "?", log: log }
    if n < 0:
        panic("negative")
    r.name.len()
