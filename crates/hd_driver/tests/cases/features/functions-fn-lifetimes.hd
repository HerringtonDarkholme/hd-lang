# @dump: tir own counts wat
# @build: v8 release
# Feature: Lifetimes In Function Types, Closure Annotations (spec/lang/07-functions.md, #1364).
# expected: a dependent `&string` result through a function value takes
# no count; the closure literal allocates nothing.
struct User:
    name: string

fn name_of(u: &User) -> &string:
    &u.name

fn apply(f: fn(&User) -> &string, u: &User) -> usize:
    f(u).len()

fn demo(a: &User) -> usize:
    apply(name_of, a) + apply(fn(u): &u.name, a)
