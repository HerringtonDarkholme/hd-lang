# @dump: tir own counts wat
# @build: v8 release
# Feature: Implementation Declarations, Method Parameter Defaults,
# Method Generic Parameters (spec/lang/09-traits.md, #1364).
# expected: the omitted `sep` is the static `", "` with no call and no
# count on `self`; `tagged` returns `value` with no count.
struct Joiner:
    parts: List[string]

impl Joiner:
    fn join(&self, sep: string = ", ") -> usize:
        self.parts.len() * sep.len()

    fn tagged[T](&self, value: T) -> T:
        value

fn joined(j: Joiner) -> usize:
    j.join()

fn generic_method(j: Joiner, s: string) -> usize:
    j.tagged(s).len()
