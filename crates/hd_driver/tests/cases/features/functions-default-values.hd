# @dump: tir own counts wat
# @build: v8 release
# Feature: Default Values, Requirement-Free Defaults (spec/lang/07-functions.md, #1364).
# expected: `with_default` allocates one fresh list per call, retains
# `s` once for the push, and frees the list after the call;
# `with_given` allocates nothing; `use_label`'s `"!"` default is
# static data with no count.
fn collect(item: string, into: &mut List[string] = &mut []) -> usize:
    into.push(item)
    into.len()

fn with_default(s: string) -> usize:
    collect(s)

fn with_given(s: string, out: &mut List[string]) -> usize:
    collect(s, out)

fn labeled(name: string, suffix: string = "!") -> string:
    name + suffix

fn use_label(s: string) -> string:
    labeled(s)
