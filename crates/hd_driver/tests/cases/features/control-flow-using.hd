# @dump: tir own counts wat
# @build: v8 release
# Feature: Cleanup Registration, Cleanup Scopes and Using Bindings (spec/lang/06-control-flow.md, #1364).
# expected: each `using` disposes once in LIFO order and its value is
# released once after dispose; the loop body disposes per round; a
# `using` of `&mut Res` disposes through the reference and releases
# nothing.
use std.ops.Disposable

struct Res:
    name: string
    log: *mut List[string]

impl Disposable for Res:
    fn dispose(&mut self) -> void:
        self.log.push(self.name)

fn two(log: *mut List[string], a: string, b: string) -> usize:
    using first = Res { name: a, log: log }
    using second = Res { name: b, log: log }
    first.name.len() + second.name.len()

fn per_round(log: *mut List[string], xs: List[string]) -> void:
    for x in xs:
        using r = Res { name: x, log: log }
        pass

fn by_ref(r: &mut Res) -> usize:
    using held = r
    held.name.len()
