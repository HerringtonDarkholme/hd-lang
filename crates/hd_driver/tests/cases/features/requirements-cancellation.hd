# @dump: tir own counts wat
# @build: v8 release
# Feature: Cancellation, Abandoning, Runtime Checks
# (spec/lang/11-requirements-and-suspension.md, #1364).
# expected: `stop` builds one frame, cancels it and frees it with `key`;
# `drop_now` the same through `abandon`; no count beyond the frame's.
use std.task.CleanupEnd

fn fetch!(key: string) -> string:
    key + "?"

fn stop!(key: string) -> bool:
    let mut job = fetch(key)
    end := job.cancel!()
    match end:
        .Finished => true
        .Abandoned => false

fn drop_now(key: string) -> void:
    let mut job = fetch(key)
    job.abandon()
