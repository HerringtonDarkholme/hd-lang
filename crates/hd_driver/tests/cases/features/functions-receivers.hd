# @dump: tir own counts wat
# @build: v8 release
# Feature: Methods And Receivers, Reference Receivers (spec/lang/07-functions.md, #1364).
# expected: `temp_receiver` frees the temporary once; `element_receiver`
# changes the element in place (one uniqueness check, no element
# count); `element_read` takes no count; `place_receiver` takes no
# count; `mut_self` copies `v` once (it is read after); `counted`
# retains `b` only if `keep`'s result outlives the call.
struct Vec2:
    name: string
    x: i64

impl Vec2:
    fn label_len(&self) -> usize:
        self.name.len()

    fn shift(&mut self, d: i64) -> void:
        self.x += d

    fn renamed(mut self, n: string) -> Vec2:
        self.name = n
        self

    fn keep(*self) -> *Vec2:
        self

fn make(s: string) -> Vec2:
    Vec2 { name: s, x: 0 }

fn temp_receiver(s: string) -> usize:
    make(s).label_len()

fn element_receiver(xs: &mut List[Vec2], i: usize) -> void:
    xs[i].shift(1)

fn element_read(xs: List[Vec2], i: usize) -> usize:
    xs[i].label_len()

fn place_receiver(s: string) -> i64:
    let mut p = make(s)
    p.shift(2)
    p.x

fn mut_self(v: Vec2, n: string) -> usize:
    w := v.renamed(n)
    w.name.len() + v.name.len()

fn counted(b: *Vec2) -> usize:
    b.keep().name.len()
