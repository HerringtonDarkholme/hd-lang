# @dump: tir own counts wat
# @build: v8 release
# Feature: Moves, Copy (spec/lang/13-values-and-references.md, #1364).
# expected: a `!Copy` value and a `UniqList` move with no count and no
# copy; `reborrow` passes `c` on with no count.
use std.collections.UniqList

struct Photo:
    width: u32
    tags: List[string]

impl !Copy for Photo

struct Album:
    cover: Photo

fn keep[T](x: T) -> void:
    pass

fn hold[T < ?Copy](x: T) -> T:
    x

fn export(photo: Photo) -> Photo:
    keep(photo.width)
    hold(photo)

fn into_field(photo: Photo) -> Album:
    Album { cover: photo }

fn uniq(xs: UniqList[string], s: string) -> UniqList[string]:
    let mut ys = xs
    ys.push(s)
    ys

fn grow(c: &mut Photo, s: string) -> void:
    c.tags.push(s)

fn reborrow(c: &mut Photo, s: string, t: string) -> void:
    grow(c, s)
    d := c
    grow(d, t)
