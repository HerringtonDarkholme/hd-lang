# @dump: tir own counts wat
# @build: v8 release
# Feature: Pipe Expressions, Substitution Steps and Bare Steps (spec/lang/05-expressions.md, #1364).
# expected: each pipe lowers as the direct call does (`chain` equals
# `direct`): no count beyond the strings the steps build;
# `literal_slot` retains `raw` once to store it.
struct Point:
    name: string
    x: usize

fn clean(raw: string) -> string:
    "[${raw}]"

fn tag(label: string, level: i64) -> string:
    "${label}:${level}"

fn bare(raw: string) -> string:
    raw |> clean

fn chain(raw: string) -> string:
    raw |> clean |> tag(_, 2)

fn direct(raw: string) -> string:
    tag(clean(raw), 2)

fn method_slot(raw: string) -> usize:
    raw |> _.len()

fn literal_slot(raw: string) -> Point:
    raw |> Point { name: _, x: 0 }
