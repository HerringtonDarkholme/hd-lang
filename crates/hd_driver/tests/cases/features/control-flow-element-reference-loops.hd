# @dump: tir own counts wat
# @build: v8 release
# Feature: Element Reference Loops (spec/lang/06-control-flow.md, #1364).
# expected: `for p in &xs` takes no count per element; `for p in &mut out`
# on a local copies `prices` once for `out` (or moves it at its last use)
# and checks uniqueness once, not per element; the old element released
# by `*p = ...` is the only count per round.
fn total_len(xs: List[string]) -> usize:
    let n: usize = 0
    for p in &xs:
        n += p.len()
    n

fn through_ref(r: &List[string]) -> usize:
    let n: usize = 0
    for p in &r:
        n += p.len()
    n

fn shouted(prices: List[string]) -> List[string]:
    let mut out = prices
    for p in &mut out:
        *p = *p + "!"
    out
