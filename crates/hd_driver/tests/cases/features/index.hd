# @dump: tir own counts wat
# @build: v8 release
# Feature: index read and write on List, Map and UniqList (#1364).
# expected: a read only used in place (`xs[i].len()`, `v.len()`) takes no
# count; a returned element takes one retain; a write releases the old
# element and takes no other count; `m[k] = v` retains only the key it
# stores.
use std.collections.{UniqList}

fn list_read(xs: List[string], i: usize) -> usize:
    xs[i].len()

fn list_take(xs: List[string], i: usize) -> string:
    xs[i]

fn list_write(xs: &mut List[string], i: usize, s: string) -> void:
    xs[i] = s

fn map_read(m: Map[string, string], k: string) -> usize:
    match m.get(k):
        .Some(v) => v.len()
        .None => 0

fn map_write(m: &mut Map[string, string], k: string, v: string) -> void:
    m[k] = v

fn uniq_read(xs: &UniqList[string], i: usize) -> usize:
    match xs.get_ref(i):
        .Some(s) => s.len()
        .None => 0

fn uniq_write(xs: &mut UniqList[string], i: usize, s: string) -> void:
    match xs.get_mut(i):
        .Some(r) => *r = s
        .None => panic("index")
