# @dump: tir own counts wat
# @build: v8 release
# Feature: a loop over a list behind a reference that passes each element
# on to a call that may write (spec/lang/06-control-flow.md flow.for.ref; bench plugins walk).
# The `&` loop pins the list once (#1399 9k): one count of the buffer over
# the loop, no per-round uniqueness test, and `walk(*child, sink)` lends the
# child with no count. `keep` stores the pointer it takes, so `save`'s call
# still retains each child: the stored pointer outlives the loop's pin.
pub struct Node:
    pub value: i64
    pub children: List[*Node]

trait Sink:
    fn emit(&mut self, value: i64) -> void

fn walk(node: &Node, sink: &mut dyn Sink) -> void:
    sink.emit(node.value)
    for child in &node.children:
        walk(*child, sink)

struct Total:
    sum: i64

impl Sink for Total:
    fn emit(&mut self, value: i64) -> void:
        self.sum += value

pub struct Keeper:
    pub saved: List[*Node]

fn keep(n: *Node, k: &mut Keeper) -> void:
    k.saved.push(n)

fn save(node: &Node, k: &mut Keeper) -> void:
    for e in &node.children:
        keep(*e, k)

pub fn run(root: *Node) -> i64:
    let mut total = Total { sum: 0 }
    walk(root, &mut total)
    let mut keeper = Keeper { saved: [] }
    save(root, &mut keeper)
    total.sum + i64(keeper.saved.len())
