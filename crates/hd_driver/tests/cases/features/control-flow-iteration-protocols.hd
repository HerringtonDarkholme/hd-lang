# @dump: tir own counts wat
# @build: v8 release
# Feature: Iteration Protocols (spec/lang/06-control-flow.md, #1364).
# expected: `next` retains the element it returns (a second owner);
# the loop releases each item at its last use; the cursor copy shares
# the list with one retain and no copy; `twice` makes two cursors with
# one retain each and no element copy.
struct Words:
    items: List[string]
    at: usize

impl Iterator[string] for Words:
    fn next(&mut self) -> string?:
        if self.at >= self.items.len():
            return .None
        self.at += 1
        .Some(self.items[self.at - 1])

fn user_cursor(words: Words) -> usize:
    let n: usize = 0
    for w in words:
        n += w.len()
    n

fn twice(xs: List[string]) -> usize:
    let n: usize = 0
    for x in xs.iter():
        n += x.len()
    for x in xs.iter():
        n += x.len()
    n
