# @dump: tir own counts wat
# @build: v8 release
# Feature: return (#1364).
# `use_rets` only reads the results and takes no count (#1365): an
# inlined copy that returns what it only read hands that borrow on.
# expected: `ret_param` borrows `s`; out of line it still keeps it and
# returns it (`kept [$0] returns $0`), so a caller of an uninlined copy
# counts the argument.
struct Rec:
    name: string

fn ret_param(s: string) -> string:
    s

fn ret_field(r: Rec) -> string:
    r.name

fn ret_new(n: i64) -> string:
    "n=${n}"

fn ret_ref_field(r: &Rec) -> &string:
    &r.name

fn use_rets(r: Rec) -> usize:
    ret_param(r.name).len() + ret_field(r).len() + ret_ref_field(&r).len()
