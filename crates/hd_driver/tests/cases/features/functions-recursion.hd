# @dump: tir own counts wat
# @build: v8 release
# Feature: Recursion (spec/lang/07-functions.md, #1364).
# expected: the recursive calls pass `xs` borrowed with no count per
# level; `closure_rec` captures `s` without a count per call.
fn count_long(xs: List[string], i: usize) -> usize:
    if i >= xs.len():
        return 0
    (if xs[i].len() > 3: 1 else: 0) + count_long(xs, i + 1)

fn by_ref(xs: &List[string], i: usize) -> usize:
    if i >= xs.len():
        return 0
    xs[i].len() + by_ref(xs, i + 1)

fn closure_rec(s: string) -> usize:
    down := fn(n: usize) -> usize:
        if n == 0: s.len() else: down(n - 1)
    down(3)
