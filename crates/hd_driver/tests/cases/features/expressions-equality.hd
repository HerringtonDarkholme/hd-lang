# @dump: tir own counts wat
# @build: v8 release
# Feature: Equality `==` and `!=` on counted values (spec/lang/05-expressions.md, #1364).
# expected: no count: `Eq.eq` takes both operands by address, and the
# `.Some(s)` operand needs no retain or allocation.
@derive(Eq)
struct Rec:
    name: string
    tags: List[string]

fn str_eq(a: string, b: string) -> bool:
    a == b

fn list_ne(a: List[string], b: List[string]) -> bool:
    a != b

fn rec_eq(a: Rec, b: Rec) -> bool:
    a == b

fn opt_none(o: string?) -> bool:
    o == .None

fn opt_some(o: string?, s: string) -> bool:
    o == .Some(s)

fn map_eq(a: Map[string, string], b: Map[string, string]) -> bool:
    a == b
