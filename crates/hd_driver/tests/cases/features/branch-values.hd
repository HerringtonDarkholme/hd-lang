# @dump: tir own counts wat
# @build: v8 release
# Feature: `if` and `match` as values (#1364).
# Each normal arm drops the unselected parameter before the join.
# `pick_len` drops the selected value after reading its length.
fn pick(c: bool, a: string, b: string) -> string:
    if c: a else: b

fn pick_len(c: bool, a: string, b: string) -> usize:
    s := if c: a else: b
    s.len()

fn pick_match(k: i64, a: string, b: string) -> string:
    match k:
        0 => a
        _ => b

fn pick_with_exit(k: i64, a: string, b: string) -> string:
    match k:
        0 => a
        1 => b
        2 => return "returned"
        _ => panic("branch")
