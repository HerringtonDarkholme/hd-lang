# @dump: tir own counts wat
# @build: v8 release
# Feature: Compound Assignment on index and field places (spec/lang/05-expressions.md, #1364).
# expected: `map_add` reads and replaces one value with no count (the key
# is only looked up); `list_append` and `field_append` build one new
# string and release only the old one.
struct Tally:
    log: string

fn map_add(m: &mut Map[string, i64], k: string) -> void:
    m[k] += 1

fn list_append(xs: &mut List[string], i: usize) -> void:
    xs[i] += "!"

fn field_append(t: &mut Tally, s: string) -> void:
    t.log += s
