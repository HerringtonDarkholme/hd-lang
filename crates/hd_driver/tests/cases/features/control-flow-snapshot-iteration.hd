# @dump: tir own counts wat
# @build: v8 release
# Feature: Snapshot Iteration and Iterator Snapshots (spec/lang/06-control-flow.md, #1364).
# expected: the loop's snapshot is one retain of the list (a second
# owner); the first `push` copies the list once, not once per round;
# `cursor_then_push` retains the list once for the cursor and copies it
# once at the push.
fn doubled(values: List[string]) -> List[string]:
    let mut out = values
    for v in out:
        out.push(v)
    out

fn cursor_then_push(values: List[string], s: string) -> usize:
    let mut items = values
    let mut cursor = items.iter()
    items.push(s)
    match cursor.next():
        .Some(first) => first.len() + items.len()
        .None => items.len()
