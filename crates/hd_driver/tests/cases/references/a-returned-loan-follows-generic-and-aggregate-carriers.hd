# @dump: wat counts
# @build: dev | release
# expected: each never-inlined carrier forwards existing loan provenance;
# expected: the aliasing push checks the live loan before changing storage.
use std.meta.inline

pub struct Slots:
    items: List[string]

impl Slots:
    fn get_ref['a](&'a self) -> (&'a string)?:
        if self.items.len() > 0: .Some(&self.items[0]) else: .None

struct Carrier[T]:
    padding: usize
    value: T

@inline(.Never)
fn keep[T < ?Copy](value: T) -> T:
    value

@inline(.Never)
fn optional[T < ?Copy](value: T?, fallback: T) -> T:
    match value:
        .Some(value) => value
        .None => fallback

@inline(.Never)
fn unwrap[T](value: Carrier[T]) -> T:
    value.value

pub fn through_generic(p: *mut Slots, alias: *mut Slots) -> string:
    held := keep((42, p.get_ref().expect("slot")))
    alias.items.push("grown")
    *held._1

pub fn through_optional(p: *mut Slots, q: *mut Slots, alias: *mut Slots) -> string:
    held := optional(.Some(p.get_ref().expect("slot")), q.get_ref().expect("slot"))
    alias.items.push("grown")
    *held

pub fn through_struct(p: *mut Slots, alias: *mut Slots) -> string:
    held := unwrap(Carrier { padding: 42, value: p.get_ref().expect("slot") })
    alias.items.push("grown")
    *held
