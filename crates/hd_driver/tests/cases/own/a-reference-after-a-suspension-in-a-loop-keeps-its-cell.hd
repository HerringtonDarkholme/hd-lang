# @dump: own
# Move's rule 4 holds for a suspension point nested in a loop body:
# `run` awaits only inside the `while`, yet the `Ref` of `c` at its last
# access counts the cell (no `take`) and `c`'s own `Drop` stays.
struct Counter:
    hits: i32
    name: string

fn pause!() -> void:
    return

fn tick(c: &mut Counter) -> void:
    c.hits = c.hits + 1

fn run!(n: i32) -> void:
    let mut c = Counter { hits: +0, name: "a" }
    let i = +0
    while i < n:
        pause!()
        i = i + 1
    tick(&mut c)
