# @dump: own
# expected: the guard reads `photo` in place and the arm moves it once the
# guard holds, as Rust binds by reference in a guard; today the first arm
# copies the payload for its guard and collection stops with an internal
# error (`copy of a non-copyable value`). Single subject, no await.
struct Photo:
    width: u32
    pixels: List[u8]

impl !Copy for Photo

fn keep(photo: Photo) -> u32:
    photo.width

fn guarded(small: Photo?) -> u32:
    match small:
        .Some(photo) if photo.width > 5 => keep(photo)
        .Some(photo) => photo.width
        _ => u32(0)
