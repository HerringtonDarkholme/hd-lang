# @dump: own
# A local a `Pin` names is never moved out of: its read at the last use
# copies, so the callee's parameter is a clone of the pinned list while
# the element reference lives (the pin's eager copy;
# `docs/compiler/ownership.md#references-count-nothing-formerly-phase-10`).
fn read_after(target: &i64, copy: List[i64]) -> i64:
    *target + copy[0]

fn run() -> i64:
    let mut xs = [1i64, 2]
    xs[1] = 3
    # subject
    read_after(&xs[0], xs)
