# @dump: own
# expected: a guard that assigns or mutably borrows the local a match
# reads, whose type is not copied, is rejected (`conflicting-access`), as
# Rust's fake borrows reject it; or the match reads its value before the
# guard runs. Today the guard changes the local while the match still
# reads it, so the matched value is copied and collection stops with an
# internal error (`copy of a non-copyable value`). With no twin to view
# it, `flow.match.guard.borrow.change` does not apply.
struct Photo:
    width: u32
    pixels: List[u8]

impl !Copy for Photo

fn bump(x: &mut (Photo?)) -> bool:
    *x = .None
    false

fn changed(n: Photo?) -> u32:
    let mut x = n
    match x:
        .Some(_) if bump(&mut x) => 1
        .Some(p) => p.width
        .None => 0
