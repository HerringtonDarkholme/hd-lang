# @dump: own counts
# A `:=` of a local whose local is read again later borrows it, even when
# a consumer takes a part of the binding: that part is copied alone, not
# all of the binding's value (an inlined `fact` binding its `self`, #165).
# When the binding's read could move, it still copies into the binding.
struct Facts:
    items: List[string]

struct Member:
    name: string
    facts: Facts
    doc: string

fn count(facts: Facts) -> usize:
    facts.items.len()

fn read_again(m: Member) -> usize:
    x := m
    count(x.facts) + m.name.len()

fn last_read(m: Member) -> usize:
    x := m
    count(x.facts) + x.doc.len()
