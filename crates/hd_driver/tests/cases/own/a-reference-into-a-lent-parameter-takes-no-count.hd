# @dump: own counts
# A reference into a lent parameter: `&mut h.c` refers into what `h` refers
# to, which its caller keeps alive for the whole call, so it takes no count
# where the referent is physical.
# Its `Drop` stays for an instance whose reference view makes the referent
# fresh; the `counts` view shows no count operation.
struct Counter:
    n: i64

struct Holder:
    c: Counter

fn bump(c: &mut Counter) -> void:
    c.n = c.n + 1

fn bump_inner(h: &mut Holder) -> void:
    # subject
    bump(&mut h.c)
