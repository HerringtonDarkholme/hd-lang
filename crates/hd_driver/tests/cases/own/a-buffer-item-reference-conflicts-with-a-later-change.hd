# @dump: own
# @build: std
use std.rt.memory.Buffer

struct Parcel:
    qty: i32

impl !Copy for Parcel

struct Bag[T < ?Copy]:
    buffer: Buffer[T]

impl[T < ?Copy] !Copy for Bag[T]

impl[T < ?Copy] Bag[T]:
    fn first['a](&'a self) -> &'a T:
        self.buffer.item_ref(0)

    fn push(&mut self, value: T) -> void:
        index := self.buffer.len()
        self.buffer.at(index).write(value)
        self.buffer.set_len(index + 1)

fn conflict(items: &mut Bag[Parcel]) -> i32:
    first := items.first()
    items.push(Parcel { qty: +2 })
    first.qty
