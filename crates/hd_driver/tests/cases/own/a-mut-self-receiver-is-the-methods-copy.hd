# @dump: own
# A `mut self` receiver of a list is the method's own copy, as a `mut`
# parameter is: the caller passes the element as a value argument, with no
# `IsUnique` before the call, and the method copies its receiver on entry
# before its push changes it. A default method's `mut Self` passes its
# receiver on the same way: a copy, then a move at its last use.
trait Bump:
    fn bump(mut self) -> usize

    fn bump_twice(mut self) -> usize:
        self.bump()
        self.bump()

impl Bump for List[i64]:
    fn bump(mut self) -> usize:
        self.push(1)
        self.len()

fn grow(mut grid: List[List[i64]], i: usize) -> usize:
    grid[i].bump()
