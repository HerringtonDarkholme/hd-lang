# @dump: own
# expected: each leaf that binds the matched value whole moves it, as a
# binding of a part does; today a whole binding that two paths of the
# decision reach reads `[%subject]` once per path and collection stops with
# an internal error (`copy of a non-copyable value`). It needs no guard:
# the catch-all row is in the `.Some` and the other branch.
struct Photo:
    width: u32
    pixels: List[u8]

impl !Copy for Photo

fn width(photo: Photo?) -> u32:
    match photo:
        .Some(p) => p.width
        .None => u32(0)

fn other_bind(small: Photo?, n: i32) -> u32:
    match (small, n):
        (.Some(p), 1) => p.width
        other => width(other._0)
