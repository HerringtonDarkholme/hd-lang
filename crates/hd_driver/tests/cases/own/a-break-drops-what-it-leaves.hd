# @dump: own
# Insertion's drops at a jump: a `break` drops each value and local of
# the blocks it leaves that may still hold a count, here the local `line`
# bound to the element the loop read, which `last = line` keeps, so it
# does not borrow; its drop after its last use that path never reaches.
fn last_short(lines: List[string]) -> string:
    let last = ""
    for line in lines:
        # subject
        if line.len() > 3:
            break
        last = line
    last
