# @dump: own
# Move's rule 4 stops at a suspension point: in `run`, which awaits, the
# `Ref` of `c` at its last access takes nothing (no `take`) and `c`'s
# own `Drop` stays, since a resume enters the body in the middle; `c`
# lives in a slot of the frame object (#1707). `fresh`, which does not
# suspend, takes the cell's count and drops nothing.
struct Counter:
    hits: i32
    name: string

fn bump!(c: &mut Counter) -> void:
    c.hits = c.hits + 1

fn tick(c: &mut Counter) -> void:
    c.hits = c.hits + 1

fn run!() -> void:
    let mut c = Counter { hits: +0, name: "a" }
    bump!(&mut c)

fn fresh() -> void:
    let mut c = Counter { hits: +0, name: "a" }
    tick(&mut c)
