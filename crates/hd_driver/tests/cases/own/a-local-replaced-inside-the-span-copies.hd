# @dump: own counts
# Borrow's boundary: the read of `cur` for the index copies, since the
# `if` in the index replaces `cur` before the element read uses the
# list the first read returned.
fn reassigned(s: List[string], t: List[string], c: bool) -> usize:
    let cur = s
    # subject
    n := cur[
        if c:
            cur = t
            0
        else:
            1
    ]
    n.len() + cur.len()
