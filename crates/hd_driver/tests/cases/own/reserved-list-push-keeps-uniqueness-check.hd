# @build: release
# @dump: wat
# expected: #2210. Both reserved outputs remain fresh across a callback
# that never receives them. Their push loops should have no list_unique,
# as the unreserved control already does; today reservation loses the proof.

fn with_capacity(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output = List::[usize].with_capacity(count)
    for index in 0..count:
        output.push(transform(index))
    output

fn reserve(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output: List[usize] = []
    output.reserve(count)
    for index in 0..count:
        output.push(transform(index))
    output

fn fresh(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output: List[usize] = []
    for index in 0..count:
        output.push(transform(index))
    output
