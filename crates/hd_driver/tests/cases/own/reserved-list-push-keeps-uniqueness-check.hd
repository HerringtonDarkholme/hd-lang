# @build: release
# @dump: wat
# #2210: both reserved outputs remain fresh across a callback that never
# receives them, so their push loops call no list_unique, as the unreserved
# control's does not. A reserve keeps a fresh list fresh (its reference
# reaches only `list_reserve`), and `with_capacity`'s list moves out of its
# inlined body fresh.

fn with_capacity(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output = List::[usize].with_capacity(count)
    for index in 0..count:
        output.push(transform(index))
    output

fn reserve(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output: List[usize] = []
    output.reserve(count)
    for index in 0..count:
        output.push(transform(index))
    output

fn fresh(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output: List[usize] = []
    for index in 0..count:
        output.push(transform(index))
    output
