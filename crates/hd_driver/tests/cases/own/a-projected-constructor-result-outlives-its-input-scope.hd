# @dump: counts stdout
# @build: dev | checked | release
# An inlined projection must transfer an owned result past its parameter's
# cleanup, even when the enclosing constructor can borrow that parameter.
fn projected[T, U](first: T, second: U) -> U:
    struct Pair:
        a: T
        b: U
    Pair { a: first, b: second }.b

pub fn main() -> void $ Console:
    kept := projected(+7, "live" + "payload")
    churn := "another" + "allocation"
    println(kept)
    println(churn)
