# @dump: own
# A guard that mutably borrows the local the match reads is rejected
# (`conflicting-access`, flow.match.guard.borrow.matched), as Rust's fake
# borrows reject it: the match still reads the local while the guard
# runs. No body reaches the ownership passes, so none copies the photo.
struct Photo:
    width: u32
    pixels: List[u8]

impl !Copy for Photo

fn bump(x: &mut (Photo?)) -> bool:
    *x = .None
    false

fn changed(n: Photo?) -> u32:
    let mut x = n
    match x:
        .Some(_) if bump(&mut x) => 1
        .Some(p) => p.width
        .None => 0
