# @dump: own
# Move's rule 4 holds for a suspension point nested in an `if`: `run`
# awaits only inside the `if`, yet the `Ref` of `c` at its last access
# counts the cell (no `take`) and `c`'s own `Drop` stays, as in
# a-reference-after-a-top-level-suspension-keeps-its-cell.hd.
struct Counter:
    hits: i32
    name: string

fn pause!() -> void:
    return

fn tick(c: &mut Counter) -> void:
    c.hits = c.hits + 1

fn run!(go: bool) -> void:
    let mut c = Counter { hits: +0, name: "a" }
    if go:
        pause!()
    tick(&mut c)
