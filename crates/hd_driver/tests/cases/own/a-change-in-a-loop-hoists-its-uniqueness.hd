# @dump: own
# Hoisting: a change of a list in every entered round of a loop makes the
# list unique once, before the loop (`IsUnique hoisted`), which the
# backend runs under the loop's entry test. In `fill` the local list is
# fresh and private, so the push's check hoists; it pushes, so it is no
# stable list. In `shift` the list is behind a reference: the checks in
# both loops hoist as `[*$0]` before the outer one, stay in the loops as
# `covered` for an instance where a view's getter makes the header fresh,
# and both loops keep the list stable (`loop %n keeps`). `total` only
# reads, so its loop keeps its list with no check at all.
fn fill(n: usize) -> List[i32]:
    let mut items: List[i32] = []
    let i: usize = 0
    while i < n:
        items.push(+1)
        i = i + 1
    items

fn shift(items: &mut List[i32]) -> void:
    let i: usize = 1
    while i < items.len():
        let j: usize = i
        while j > 0:
            items[j] = items[j - 1]
            j = j - 1
        items[0] = +0
        i = i + 1

fn total(items: &List[i32]) -> i32:
    let sum = +0
    let i: usize = 0
    while i < items.len():
        sum = sum + items[i]
        i = i + 1
    sum
