# @dump: own counts wat
# @build: release
# expected: inlined nonescaping field borrows take no count; returning a reference still retains
use std.annotation.inline

struct Point:
    x: i32

@inline(.Always)
fn write(target: &mut i32) -> void:
    *target += 1

@inline(.Always)
fn forward(point: &mut Point) -> void:
    write(&mut point.x)

@inline(.Never)
fn exercise(point: &mut Point) -> void:
    forward(point)

@inline(.Always)
fn identity['a](target: &'a i32) -> &'a i32:
    target

@inline(.Never)
fn project['a](point: &'a Point) -> &'a i32:
    identity(&point.x)

struct Owner:
    value: string

@inline(.Never)
fn recursive_owned(point: *Owner, depth: usize) -> usize:
    field := &point.value
    below := if depth == 0: 0 else: recursive_owned(point, depth - 1)
    field.len() + below

@inline(.Never)
fn recursive_borrowed(point: &Owner, depth: usize) -> usize:
    field := &point.value
    below := if depth == 0: 0 else: recursive_borrowed(point, depth - 1)
    field.len() + below
