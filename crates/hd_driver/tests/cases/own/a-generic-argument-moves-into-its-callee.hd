# @dump: own
# A type parameter's value parameter is owned: an instance that makes it a
# value receives the argument's count, so `value` moves into `keep`'s
# parameter at its last use and the caller moves `text + text` in. An
# instance that makes it a reference borrows it, and the backend releases
# what the call consumed after the call.
fn show[T](value: T) -> List[T]:
    # subject
    keep(value)

fn keep[T](value: T) -> List[T]:
    [value]

fn twice(text: string) -> List[string]:
    show(text + text)
