# @build: release
# @dump: wat
# #2217: reservation keeps the fresh list in a value local, like the
# unreserved control: the reserve's `&mut` reaches only `list_reserve`, so
# rt:list_reserve takes the list's value and its result goes back into the
# local, with no stack frame.

use std.meta.inline

@inline(.Never)
fn unreserved(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output: List[usize] = []
    for index in 0..count:
        output.push(transform(index))
    output

@inline(.Never)
fn reserved(count: usize, transform: fn(usize) -> usize) -> List[usize]:
    let mut output = List::[usize].with_capacity(count)
    for index in 0..count:
        output.push(transform(index))
    output
