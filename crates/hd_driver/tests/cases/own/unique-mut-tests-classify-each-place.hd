# @dump: own
# @build: std
# `own::unique_test` marks each `unique_mut` test's argument: `unique`
# where the place only ever holds a new box, `sticky` behind a `&mut`
# parameter that nothing else reaches, and nothing where a copy, a
# closure, another call or a store from outside can share the box.
use std.rt.memory.unique_mut

pub struct Cell:
    n: i64

pub struct Holder:
    store: *Cell
    tag: i64

# A struct literal's field holds a new box: unique.
pub fn literal_field(v: i64) -> i64:
    let mut h = Holder { store: box(Cell { n: 0 }), tag: 1 }
    match unique_mut(&mut h.store):
        .Some(c) => c.n = v
        .None => pass
    h.store.n

# A store of a new box through a local reference to the place: unique.
pub fn through_alias(v: i64) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    r := &mut p
    *r = box(Cell { n: 1 })
    match unique_mut(&mut p):
        .Some(c) => c.n = v
        .None => pass
    p.n

# A test of a stored reference's place, not of a `&mut` the call makes:
# no mark.
pub fn stored_reference(v: i64) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    r := &mut p
    match unique_mut(r):
        .Some(c) => c.n = v
        .None => pass
    p.n

# A copy of the box shares it: no mark.
pub fn copied(v: i64) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    q := p
    match unique_mut(&mut p):
        .Some(c) => c.n = v
        .None => pass
    q.n

# A store of a box from outside: no mark.
pub fn stored_from(v: i64, other: *Cell) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    p = other
    match unique_mut(&mut p):
        .Some(c) => c.n = v
        .None => pass
    p.n

# A struct literal whose field is not a new box: no mark.
pub fn literal_from(other: *Cell) -> i64:
    let mut h = Holder { store: other, tag: 1 }
    match unique_mut(&mut h.store):
        .Some(c) => c.n = 1
        .None => pass
    h.tag

# A closure captures the local: no mark.
pub fn captured(v: i64) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    read := fn() -> i64: p.n
    match unique_mut(&mut p):
        .Some(c) => c.n = v
        .None => pass
    read()

pub fn observe(h: &Holder) -> i64:
    h.tag

# Behind a `&mut` parameter, another call may reach the box: no mark.
pub fn called(h: &mut Holder) -> i64:
    match unique_mut(&mut h.store):
        .Some(c) => c.n = 1
        .None => h.store = box(Cell { n: 1 })
    observe(h)

# Behind a `&mut` parameter with no other call: sticky.
pub fn sticky(h: &mut Holder) -> void:
    match unique_mut(&mut h.store):
        .Some(c) => c.n = 1
        .None => h.store = box(Cell { n: 1 })

fn peek(r: &*Cell) -> i64:
    r.n

# A reference to the place passed to a call may copy the box: no mark.
pub fn referenced(v: i64) -> i64:
    let mut p: *Cell = box(Cell { n: 0 })
    seen := peek(&p)
    match unique_mut(&mut p):
        .Some(c) => c.n = v
        .None => pass
    seen + p.n
