# @dump: own counts
# Borrow: a `for` over a list reads each element from the loop's private
# snapshot, which no user code writes, so the element read borrows, and
# so does the binding `word` that holds it: it owns nothing, so its drops
# go and it leaves the exit set. The call in the body cannot reach the
# snapshot local, so it does not end the borrow.
fn note(n: usize) -> void:
    pass

fn count(words: List[string]) -> usize:
    let found: usize = 0
    # subject
    for word in words:
        note(found)
        match word:
            "n1" => found += 1
            _ => pass
    found
