# @dump: own counts wat stdout
# @build: release checked
# expected: an immutable collection view preserves the roots of a short lookup loan.
use std.meta.cold
use std.testing.assert_equal

@cold
# subject
fn lookup_size(values: *mut Map[string, string], key: string) -> usize:
    let readonly: *Map[string, string] = values
    match readonly.get(key):
        .Some(value) => value.len()
        .None => 0

pub fn main() -> void:
    values := box({ "key": "payload" })
    assert_equal(lookup_size(values, "key"), 7)
    assert_equal(lookup_size(values, "absent"), 0)
