# @dump: own counts wat
# @build: v8 program
# expected: main is an entry root with no suspension point, so `sink` lies in a frame slot; the framed helper keeps `sink` in a cell, and neither reference takes a count.
use std.ops.Update

struct Sink:
    text: string

impl Update[string] for Sink:
    fn update(&mut self, value: string) -> void:
        self.text = value

fn helper!() -> string:
    let mut sink = Sink { text: "" }
    sink() = "helper"
    sink.text

pub fn main!() -> void $ Console:
    let mut sink = Sink { text: "" }
    sink() = "kept"
    println(sink.text)
    _ := helper()
