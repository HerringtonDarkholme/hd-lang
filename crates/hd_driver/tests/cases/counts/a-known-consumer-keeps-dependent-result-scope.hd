# @dump: own counts wat
# @build: v8 release
# expected: the contextual consumer bonus retains the ordinary scope budget
# for a dependent result; `through` remains a call from `kept`.
# ref.dep.call; fn.trait.bound-sugar.
use std.function.Fn

fn through[F < Fn() -> void](text: &string, f: F) -> &string:
    f()
    let picked = text
    for _ in 0..2:
        f()
    picked

fn kept(text: &string) -> &string:
    through(text, fn() -> void: ())
