# @dump: counts mir
# @build: v8 release
# The read of `xs` keeps its count: `&mut xs` lets `pick` reach the local,
# and `pick` replaces it before the index reads the first value.
fn pick(out: &mut List[usize]) -> usize:
    *out = [7]
    0

fn lent(n: usize) -> usize:
    let mut xs: List[usize] = [n]
    # subject
    n := xs[pick(&mut xs)]
    n + xs.len()
