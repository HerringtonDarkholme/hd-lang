# @dump: counts
# @build: v8 release
# Passing a reference the caller holds to a `&` parameter lends it for
# the call (#676; binary_trees: check(left)).
struct Node:
    left: (&Node)?

fn depth(node: &Node) -> i64:
    match node.left:
        .None => 1
        .Some(left) =>
            # subject
            1 + depth(left)
