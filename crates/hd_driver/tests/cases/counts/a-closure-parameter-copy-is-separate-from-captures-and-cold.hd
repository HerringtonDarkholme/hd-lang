# @dump: own counts wat
# expected: a plain closure's explicit value parameter has an Entry local copy;
# its captured value belongs to Entry captures. A cold closure's explicit
# parameter receives its owner at the Cold/Entry boundary without another copy.
fn plain(captured: string) -> (fn(string) -> (string, string)):
    fn(value: string) -> (string, string): (captured, value)

fn cold_capture(captured: string) -> (fn!(string) -> (string, string)):
    fn!(value: string) -> (string, string): (captured, value)
