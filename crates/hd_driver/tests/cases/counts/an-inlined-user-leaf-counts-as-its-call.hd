# @dump: counts
# @build: v8 release
# expected: release inlining makes `both` and the same code written out
# in `by_hand` take no count. Their read-only struct borrows `name`;
# construction never introduces a retain or a matching release.
struct Tag:
    name: string
    n: i64

fn tag(name: string, n: i64) -> Tag:
    Tag { name: name, n: n }

fn size(t: Tag) -> i64:
    t.n + 1

fn both(name: string) -> i64:
    size(tag(name, 2)) + i64(name.len())

fn by_hand(name: string) -> i64:
    t := Tag { name: name, n: 2 }
    t.n + 1 + i64(name.len())
