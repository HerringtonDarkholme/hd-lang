# @dump: counts
# @build: v8 release
# `&mut tally` is the local's last access, so the reference takes the
# local. `tally` lives in a slot of the frame (DESIGN.md §23.38), so the
# reference is a loan: no retain for it, and its drop after the call
# releases the value in the slot, which has no counted part here.
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn once() -> void:
    let mut tally = Tally { n: 0 }
    # subject
    bump(&mut tally)
