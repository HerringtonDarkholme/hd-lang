# @dump: counts
# expected: every guarded binding is released after its last executed use

enum Message:
    Word(text: string)
    Empty

fn message(seed: string) -> Message:
    .Word(seed + "!")

fn reject!(text: string) -> bool $ Console:
    pause!()
    _ := $.use(Console).write_sync("${text}\n")
    false

pub fn main!() -> void $ Console:
    # subject
    kept := match message("pending 42"):
        .Word(text) if reject!(text) => "unexpected"
        .Word(text) => text
        .Empty => "empty"
    println("kept $kept")

# A suspension point: awaiting a suspending closure, so a caller of
# `pause!` keeps its frame and child (#2419).
fn pause!() -> void:
    step := fn!() -> void: pass
    step!()
