# @dump: counts
# expected: every guarded binding is released after its last executed use

enum Message:
    Word(text: string)
    Empty

fn message(seed: string) -> Message:
    .Word(seed + "!")

fn reject!(text: string) -> bool $ Console:
    _ := $.use(Console).write_sync("${text}\n")
    false

pub fn main!() -> void $ Console:
    # subject
    kept := match message("pending 42"):
        .Word(text) if reject!(text) => "unexpected"
        .Word(text) => text
        .Empty => "empty"
    println("kept $kept")
