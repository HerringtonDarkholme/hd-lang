# @dump: counts own
# @build: v8 release
# The callee read through `&self` borrows the environment, with no count
# (#1436): no alias can replace `transform` while the closure runs, as a
# path with no `*T` is exclusive at compile time and a caller's loan on a
# `*T` it crossed lasts the call (a-closure-replacing-its-own-field-
# during-the-call-panics). Through a bare `*mut` the count stays
# (closure-field-call-through-a-counted-reference).
struct Mapper:
    transform: fn(i32) -> i32

impl Mapper:
    fn apply(&self, x: i32) -> i32:
        # subject
        (self.transform)(x)
