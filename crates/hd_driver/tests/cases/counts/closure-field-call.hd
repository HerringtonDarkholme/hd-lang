# @dump: counts own
# @build: v8 release
# This plain body keeps its count of the environment for the call: a
# caller may pass a `self` that another alias can replace `transform`
# through while the closure runs. A caller whose `self` stage 7 keeps
# exclusive runs the exclusive copy instead, with no count (#1118,
# closure-field-call-from-a-local-runs-the-exclusive-copy).
struct Mapper:
    transform: fn(i32) -> i32

impl Mapper:
    fn apply(&self, x: i32) -> i32:
        # subject
        (self.transform)(x)
