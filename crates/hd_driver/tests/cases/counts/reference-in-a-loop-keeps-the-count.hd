# @dump: counts
# @build: v8 release
# `tally` is declared outside the loop, so each iteration's `&mut tally`
# reaches the same cell: the reference takes a count of its own, and the
# cell is released after the loop.
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn repeat(n: usize) -> void:
    let mut tally = Tally { n: 0 }
    # subject
    for _ in 0..n:
        bump(&mut tally)
