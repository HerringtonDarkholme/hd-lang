# @dump: own counts wat
# @build: v8 release
# expected: insertion takes the string key's stated count only on a miss; scalar keys need none.
fn bump(items: &mut Map[string, i32], key: string) -> void:
    *items.get_or_insert(key, +0) += 1

fn scalar(items: &mut Map[usize, i32], key: usize) -> void:
    *items.get_or_insert(key, +0) += 1
