# @dump: counts
# A `for` over a list that its body changes iterates a copy of the list
# as it was when the loop began (`flow.for.snapshot`): the copy counts the
# buffer, so the push copies the buffer first.
fn doubled(start: List[i32]) -> List[i32]:
    let mut xs = start
    xs.push(+1)
    for x in xs:
    #^^^^^^^^^^^
        xs.push(x)
    xs
