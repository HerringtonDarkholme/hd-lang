# @dump: counts
# A loop borrows its list, so a body that changes the list walks a copy
# of it (`flow.for.ref.conflict`): the copy counts the buffer, so the push
# copies the buffer first.
fn doubled(start: List[i32]) -> List[i32]:
    let mut xs = start
    xs.push(+1)
    snapshot := xs
    for x in snapshot:
    #^^^^^^^^^^^^^^^^^
        xs.push(*x)
    xs
