# @dump: own counts wat
# @build: v8 release
# expected: a returned parameter used only for reading borrows across the call.
# An owned result and a function-value adapter keep the result's count.
use std.annotation.inline

@inline(.Never)
fn ident(s: string) -> string:
    s

@inline(.Never)
fn generic[T](x: T) -> T:
    x

fn reads(s: string) -> usize:
    ident(s).len() + s.len()

fn keeps(s: string) -> string:
    ident(s)

fn generic_reads(s: string) -> usize:
    generic(s).len() + s.len()

fn adapter() -> fn(string) -> string:
    ident

struct Point:
    n: usize

@inline(.Never)
fn weaken(p: *mut Point) -> *Point:
    p

fn reads_weakened(p: *mut Point) -> usize:
    weaken(p).n

@inline(.Never)
fn explicit(s: string, first: bool) -> string:
    if first:
        return s
    s

fn reads_explicit(s: string, first: bool) -> usize:
    explicit(s, first).len() + s.len()

fn takes_temporary() -> string:
    ident("a longer heap string ${41 + 1}")

fn temporary_reference() -> usize:
    point := box(Point { n: 19 })
    result := weaken(point)
    result.n

struct Named:
    name: string

fn reads_field(value: Named) -> usize:
    ident(value.name).len()

fn reads_heap_field(value: *Named) -> usize:
    ident(value.name).len()

fn reads_heap_field_after(value: *Named, action: fn() -> void) -> usize:
    result := ident(value.name)
    action()
    result.len()

fn reads_element(value: List[string], index: usize) -> usize:
    ident(value[index]).len()
