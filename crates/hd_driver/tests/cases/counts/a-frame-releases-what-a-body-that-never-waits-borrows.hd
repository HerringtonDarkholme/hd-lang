# @dump: own counts wat
# @build: std
# expected: `change` takes the counted owner of `n`, even without a wait.
# Its body releases that owner; cold cancellation releases the saved owner.
# `change.drop` tests the exited flag so completed frames do not release twice.
# The constructor stores the transferred argument without retaining it.
use std.task.join

struct Note:
    text: string

fn change!(n: *mut Note) -> usize:
    n.text = "m"
    n.text.len()

fn other!() -> usize:
    1

pub fn main!() -> void $ Console:
    n := box::[Note](Note { text: "n" })
    let (a, _) = join!(change(n), other())
    println("$a")
