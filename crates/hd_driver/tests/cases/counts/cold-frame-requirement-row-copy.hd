# @dump: own counts wat
# @build: v8 release
# expected: the frame states its row copies and teardown release; provider order stays.
trait Value:
    fn value(&self) -> i32

fn read!() -> i32 $ Value:
    pause!()
    $.use(Value).value()

# Keep the frame path live: the stored closure can wait.
fn pause!() -> void:
    step := fn!() -> void: pass
    step!()
