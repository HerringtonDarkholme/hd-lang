# @dump: counts mir
# @build: v8 release
# Pushing to a list field through `&mut self` borrows the field's list
# (#676; StringBuilder.push in map_count and string_build). The two string
# releases are of the moved `line` parameter's zeroed slots (#656 pattern 2).
struct Log:
    lines: List[string]

impl Log:
    fn add(&mut self, line: string) -> void:
        # subject
        self.lines.push(line)
