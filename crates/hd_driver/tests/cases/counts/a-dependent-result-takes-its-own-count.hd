# @dump: counts
# A result that holds a local reference is owned, never lent
# (spec/lang/13-values-and-references.md#dependent-results): `name`
# retains the address it returns, though `&self.name` is a field of what a
# lent receiver refers to. `forward` passes the owned result on with no
# count of its own.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

fn forward(u: &User) -> &string:
    u.name()
