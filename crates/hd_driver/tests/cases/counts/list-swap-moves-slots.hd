# @dump: own counts wat
# @build: v8 release program
# expected: exchange the original string slots without retaining or releasing them.
use std.annotation.inline

@inline(.Never)
fn exchange(items: &mut List[string], left: usize, right: usize) -> void:
    # subject
    items.swap(left, right)

pub fn main() -> void:
    let mut items = ["left-${1}", "right-${2}"]
    exchange(&mut items, 0, 1)
