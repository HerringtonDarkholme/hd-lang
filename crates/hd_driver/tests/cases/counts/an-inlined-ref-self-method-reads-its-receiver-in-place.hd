# @dump: own counts
# A `&self` method reads its receiver in place: a `UniqMap` holds a
# value with a `std.rt.Drop`, so no copy of the method binds it by value
# (#1298), and the call lends the map with no count taken or released.
use std.collections.UniqMap

fn sizes(key: string) -> usize:
    let mut parcels = UniqMap::[string, i32].new()
    _ := parcels.insert(key, +1)
    # subject
    total := if parcels.is_empty(): 0 else: parcels.len()
    _ := parcels.insert("b", +2)
    total
