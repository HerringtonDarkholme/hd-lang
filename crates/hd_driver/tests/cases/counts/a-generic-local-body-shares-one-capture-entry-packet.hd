# @dump: own counts wat
# expected: two instantiations of one generic local body share one Entry
# captures declaration. A cold closure sharing a scalar cell also states
# Entry captures, separately from its Cold constructor packet.
# A locally called plain closure keeps its shared scalar in a frame slot.
fn generic(captured: string) -> (fn(i32) -> (string, i32), fn(string) -> (string, string)):
    fn pair[T](value: T) -> (string, T):
        (captured, value)
    (pair::[i32], pair::[string])

fn counter() -> (fn!() -> usize):
    let count: usize = 0
    fn!() -> usize:
        count += 1
        count

fn framed() -> usize:
    let count: usize = 0
    next := fn() -> usize:
        count += 1
        count
    next()
