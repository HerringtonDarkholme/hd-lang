# @dump: wat
# @build: v8 release
# Every `*Node` refers to a whole object, so its counts read the header:
# `rt:retain_known`, with no page-table search (#988).
struct Node:
    left: (*Node)?
    right: (*Node)?

fn leaf() -> *Node:
    box(Node { left: .None, right: .None })

fn both(n: *Node) -> (*Node, *Node):
    # subject
    (n, n)
