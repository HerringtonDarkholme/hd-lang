# @dump: wat
# @build: v8 release
# No reference in the program points inside an object holding a `Node`,
# so in release every `*Node` is a payload start and its counts read the
# header: `rt:retain_known`, with no page-table search (#704).
struct Node:
    left: (*Node)?
    right: (*Node)?

fn leaf() -> *Node:
    box(Node { left: .None, right: .None })

fn both(n: *Node) -> (*Node, *Node):
    # subject
    (n, n)
