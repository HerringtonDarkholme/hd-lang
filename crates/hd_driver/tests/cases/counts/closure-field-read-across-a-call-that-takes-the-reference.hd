# @dump: counts
# @build: v8 release
# Control for closure-field-call (#1118): `reset` receives `self` and
# replaces `transform`, so `f` keeps its count across that call, in
# stage 8 too.
struct Mapper:
    transform: fn(i32) -> i32

impl Mapper:
    fn reset(&mut self) -> void:
        self.transform = fn(x): x

    fn apply(&mut self, x: i32) -> i32:
        # subject
        f := self.transform
        self.reset()
        f(x)
