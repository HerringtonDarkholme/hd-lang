# @dump: counts
# @build: std
# Matching a reference into a buffer's room binds its counted payload by
# reference, so reading the string takes no count of it.
use std.rt.memory.Buffer

enum Item:
    Empty
    Some(string)

impl !Copy for Item

struct Box:
    items: Buffer[Item]

impl !Copy for Box

fn item_len(holder: &Box, index: usize) -> usize:
    match holder.items.at(index).as_ref():
        .Some(value) => value.len()
        .Empty => 0
