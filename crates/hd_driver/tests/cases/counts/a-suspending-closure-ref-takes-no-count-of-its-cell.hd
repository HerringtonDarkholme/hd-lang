# @dump: own counts wat
# @build: v8 release
# expected: a reference to a closure's own local or to a shared capture takes no count of the cell; a copied capture's reference points into the environment, with no new object.
struct Tally:
    n: i64

fn bump!(t: &mut Tally) -> void:
    pause!()
    t.n += 1

fn read!(t: &Tally) -> i64:
    pause!()
    t.n

fn local!() -> i64:
    run := fn!() -> i64:
        let mut tally = Tally { n: 0 }
        bump!(&mut tally)
        tally.n
    run!()

fn shared!() -> i64:
    let mut tally = Tally { n: 0 }
    run := fn!() -> void: bump!(&mut tally)
    run!()
    tally.n

fn copied!() -> i64:
    tally := Tally { n: 0 }
    run := fn!() -> i64: read!(&tally)
    run!()

# A suspension point: awaiting a suspending closure, so a caller of
# `pause!` keeps its frame and child (#2419).
fn pause!() -> void:
    step := fn!() -> void: pass
    step!()
