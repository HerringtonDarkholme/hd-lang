# @dump: own wat counts
# @build: v8 release
# `held` borrows `bag.items` and `keep` takes a copy of it, so the list has two
# owners when the push runs. The push keeps its check: `shared: a copy of the
# field`, and a `rt:list_unique` call in the WAT.
use std.annotation.inline

struct Bag:
    items: List[i32]

@inline(.Never)
fn keep(xs: List[i32]) -> List[i32]:
    xs

@inline(.Never)
fn snapshot(bag: &mut Bag) -> List[i32]:
    let held = bag.items
    let copy = keep(held)
    bag.items.push(9)
    copy

pub fn go() -> usize:
    let mut bag = Bag { items: [] }
    bag.items.push(1)
    snapshot(&mut bag).len()
