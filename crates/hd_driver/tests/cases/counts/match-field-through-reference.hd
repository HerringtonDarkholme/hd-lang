# @dump: counts
# @build: v8 release
# expected: no counts for the field or Some binding across this call-free
# match; a call or a reference store in an arm must keep ownership (#717).
struct Node:
    value: i64
    left: (&Node)?

fn left_value(node: &Node) -> i64:
    # subject
    match node.left:
        .None => 0
        .Some(left) => left.value
