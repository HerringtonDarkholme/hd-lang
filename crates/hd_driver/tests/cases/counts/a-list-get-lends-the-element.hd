# @dump: counts
# Borrow: `get` returns a reference to the element (std-collections.access.get),
# so reading a field through it retains neither the element nor its string.
struct Line:
    name: string
    cents: i64

fn first_cents(lines: List[Line]) -> i64:
    # subject
    match lines.get(0):
        .Some(line) => line.cents
        .None => 0
