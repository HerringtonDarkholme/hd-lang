# @dump: counts
# @build: v8 release
# `tally.n` reads the local after `&mut tally`, so the reference is not
# its last access. `tally` lives in a slot of the frame
# (crates/hd_wasm_linear/DESIGN.md §23.38), so the reference takes no
# count of its own either.
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn read_after() -> i64:
    let mut tally = Tally { n: 0 }
    # subject
    bump(&mut tally)
    tally.n
