# @dump: own counts
# @build: std checked
# Native Drop ownership transfers once while thin reference counts are lent.
use std.annotation.inline
use std.collections.UniqList
use std.function.{Fn, Tuple}
use std.rt.Drop
use std.testing.assert_equal
use std.time.{Clock, ms, sleep}

let empty_drops: usize = 0
let cold_starts: usize = 0

struct Resource:
    seen: *mut i32
    owned: UniqList[usize]

impl !Copy for Resource

impl Drop for Resource:
    fn drop(&mut self) -> void:
        *self.seen += 1

fn size(value: Resource) -> usize:
    value.owned.len()

fn ignore(value: Resource) -> usize:
    0

fn boxed_size(value: *Resource) -> usize:
    value.owned.len()

@inline(.Never)
fn read_boxed(callback: fn(*Resource) -> usize, value: *Resource) -> usize:
    callback(value)

enum Conditional:
    Empty
    Live(value: Resource)

impl !Copy for Conditional

fn conditional_size(value: Conditional) -> usize:
    match value:
        .Empty => 0
        .Live(resource) => size(resource)

@inline(.Never)
fn read_conditional(callback: fn(Conditional) -> usize, value: Conditional) -> usize:
    callback(value)

@inline(.Never)
fn read(callback: fn(Resource) -> usize, value: Resource) -> usize:
    callback(value)

@inline(.Never)
fn identity(callback: fn(Resource) -> Resource, value: Resource) -> Resource:
    callback(value)

fn keep(value: Resource) -> Resource:
    value

fn plain_controls() -> void:
    seen := box(+0)
    assert_equal(read(size, Resource { seen: seen, owned: UniqList::new() }), 0)
    assert_equal(*seen, +1, reason="named callback releases its native owner once")
    inspect := fn(value: Resource) -> usize: value.owned.len()
    assert_equal(read(inspect, Resource { seen: seen, owned: UniqList::new() }), 0)
    assert_equal(*seen, +2, reason="closure callback releases its native owner once")
    returned := identity(keep, Resource { seen: seen, owned: UniqList::new() })
    assert_equal(*seen, +2, reason="returning callback transfers the native Drop hook")
    assert_equal(returned.owned.len(), 0)
    assert_equal(*seen, +3, reason="the returned native owner drops at its last use")
    assert_equal(read(ignore, Resource { seen: seen, owned: UniqList::new() }), 0)
    assert_equal(*seen, +4, reason="an unused native input still runs its Drop hook")
    assert_equal(
        read_conditional(conditional_size, .Live(Resource { seen: seen, owned: UniqList::new() })),
        0,
    )
    assert_equal(*seen, +5, reason="a live conditional native payload transfers once")
    assert_equal(read_conditional(conditional_size, .Empty), 0)
    assert_equal(*seen, +5, reason="an absent conditional payload has no Drop hook")
    owner := box(Resource { seen: seen, owned: UniqList::new() })
    alias := owner
    assert_equal(read_boxed(boxed_size, owner), 0)
    assert_equal(
        *seen,
        +5,
        reason="a borrowed boxed alias does not transfer the payload's native hook",
    )
    assert_equal(alias.owned.len(), 0)
    assert_equal(*seen, +6, reason="the shared box retains its native payload until the last alias")

struct EmptyResource: pass

impl !Copy for EmptyResource

impl Drop for EmptyResource:
    fn drop(&mut self) -> void:
        empty_drops += 1

fn empty_size(value: EmptyResource) -> usize:
    0

@inline(.Never)
fn read_empty(callback: fn(EmptyResource) -> usize, value: EmptyResource) -> usize:
    callback(value)

@inline(.Never)
fn read_spread[Args < ?Copy & Tuple](callback: Fn[Args, usize, $ ()], value: Args) -> usize:
    callback(value...)

fn mixed_size(
    first: EmptyResource,
    value: Resource,
    marker: void,
    label: string,
    last: EmptyResource,
) -> usize:
    value.owned.len() + label.len()

fn empty_controls() -> void:
    assert_equal(read_empty(empty_size, EmptyResource {}), 0)
    assert_equal(empty_drops, 1, reason="a named callback drops its zero-leaf owner once")
    inspect := fn(value: EmptyResource) -> usize: 0
    assert_equal(read_empty(inspect, EmptyResource {}), 0)
    assert_equal(empty_drops, 2, reason="a literal callback drops its zero-leaf owner once")
    seen := box(+0)
    label := ["ke", "pt"].join("")
    let mut owned: UniqList[usize] = UniqList::new()
    owned.push(23)
    assert_equal(
        read_spread(
            mixed_size,
            (EmptyResource {}, Resource { seen: seen, owned: owned }, (), label, EmptyResource {}),
        ),
        5,
    )
    assert_equal(empty_drops, 4, reason="both zero-leaf spread owners drop once")
    assert_equal(*seen, +1, reason="the mixed spread transfers its unique resource once")
    assert_equal(label, "kept", reason="the Copy spread field keeps its caller's count")

fn delayed_size!(value: Resource) -> usize $ Clock:
    cold_starts += 1
    sleep!(ms(1))
    value.owned.len()

@inline(.Never)
fn prepared_native(literal: bool, seen: *mut i32) -> Suspend[usize] $ Clock:
    let constructor = delayed_size
    if literal:
        constructor = fn!(value: Resource) -> usize $ Clock:
            cold_starts += 1
            sleep!(ms(1))
            value.owned.len()
    let mut owned: UniqList[usize] = UniqList::new()
    owned.push(23)
    constructor(Resource { seen: seen, owned: owned })

pub fn main!() -> void $ Clock:
    plain_controls()
    empty_controls()
    seen := box(+0)
    for literal in [false, true]:
        before := *seen
        started := cold_starts
        pending := prepared_native(literal, seen)
        assert_equal(*seen, before, reason="an unpolled frame keeps its native input alive")
        assert_equal(cold_starts, started, reason="constructing a native callback does not poll it")
        assert_equal(
            pending!(),
            1,
            reason="the suspended callback reads its unique input after awaiting",
        )
        assert_equal(*seen, before + 1, reason="awaiting drops the mixed native owner once")
        assert_equal(cold_starts, started + 1)
        _ := prepared_native(literal, seen)
        assert_equal(
            *seen,
            before + 2,
            reason="abandoning an unpolled frame drops its mixed owner once",
        )
        assert_equal(cold_starts, started + 1, reason="abandonment never starts the callback body")
    assert_equal(*seen, +4, reason="named and literal cold frames each transfer both owners once")
