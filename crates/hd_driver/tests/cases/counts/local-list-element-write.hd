# @dump: counts mir
# @build: v8 release
# Writing an element of a local list borrows the list for the write, also
# inside a loop with an early exit (#676; fannkuch_redux's loops all sit
# inside `while true`).
fn fill(n: usize) -> usize:
    let mut count: List[usize] = []
    for i in 0..n:
        count.push(i)
    let r = n
    while r > 0:
        # subject
        count[r - 1] = r
        r = r - 1
        if r == 1:
            break
    r
