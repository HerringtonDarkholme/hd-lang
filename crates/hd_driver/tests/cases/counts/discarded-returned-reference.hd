# @dump: counts
# @build: v8 release
# expected: `add` transfers its incoming counted `*mut` owner to its result
# without retaining. `fill` borrows its receiver, copies it for each call,
# and releases the returned owner.
struct Tally:
    count: usize

# subject
impl Tally:
    fn add(*mut self) -> *mut Tally:
        self.count = self.count + 1
        self

    fn fill(*mut self, n: usize) -> void:
        for _ in 0..n:
            self.add()
