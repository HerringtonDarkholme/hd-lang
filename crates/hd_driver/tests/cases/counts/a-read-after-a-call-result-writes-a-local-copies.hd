# @dump: own counts wat
# @build: std
# expected: `b.item_mut(0).qty = +7` holds a reference to `b` in a call's
# result for that one statement. Both later reads of `b` copy today:
# `kept := b.label` retains and releases the string, and `b.items.len()` copies
# the list and releases it (both `conservative: copy read`). Neither should
# take a count: the result's last use ends before the first read, and `b`
# outlives the second. The new place-local facts have to bring the borrows back
# (#1399, step 12c); the second read also stands right before `b`'s `Drop`, so
# it needs a part of an addressed local to borrow or move.
struct Item:
    qty: i32

struct Bag:
    label: string
    items: List[Item]

impl Bag:
    fn item_mut(&mut self, i: usize) -> &mut Item:
        &mut self.items[i]

fn change_then_read(name: string) -> usize:
    let mut b = Bag { label: name, items: [Item { qty: +1 }] }
    b.item_mut(0).qty = +7
    kept := b.label
    kept.len() + b.items.len()
