# @dump: own counts wat
# @build: std
# expected: `b.item_mut(0).qty = +7` holds a reference to `b` in a call's
# result for that one statement. Neither later read of `b` takes a count: that
# reference's last use ends before the first read, no reference reads either
# part afterwards, and each read is its part's last use, so it moves out of the
# frame slot, which stores a zero there.
struct Item:
    qty: i32

struct Bag:
    label: string
    items: List[Item]

impl Bag:
    fn item_mut(&mut self, i: usize) -> &mut Item:
        &mut self.items[i]

fn change_then_read(name: string) -> usize:
    let mut b = Bag { label: name, items: [Item { qty: +1 }] }
    b.item_mut(0).qty = +7
    kept := b.label
    kept.len() + b.items.len()
