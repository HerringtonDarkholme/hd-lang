# @dump: own wat counts
# @build: v8 release
# `update` is inlined, so its base is a borrow of `base`. The copy takes a count
# of `kept` all the same, so the list has two owners when the push runs. The
# push keeps its check: `shared: a copy-update keeps the field`, and a
# `rt:list_unique` call in the WAT.
struct Record:
    kept: List[string]
    name: string

fn update(base: Record, name: string) -> Record:
    Record { ...base, name }

pub fn go() -> usize:
    base := Record { kept: ["a"], name: "old" }
    let mut copied = update(base, "new")
    copied.kept.push("b")
    base.kept.len() + copied.kept.len()
