# @dump: own counts
# expected: the parameter cell remains alive until `missing` returns; the local reference takes no count
struct Payload:
    count: u32
    note: string?
    tags: List[string]
    owner: string

struct Envelope:
    filter: Payload?

fn missing(payload: &(Payload?)) -> bool:
    match payload:
        .Some(p) => p.tags.len() == 0 && p.owner.len() == 0
        .None => true

fn absent(value: Result[Envelope, string]) -> Result[bool, string]:
    value.map(fn(value): missing(&value.filter))
    #^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
