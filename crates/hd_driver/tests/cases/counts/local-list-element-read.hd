# @dump: counts
# @build: v8 release
# Reading an element of a local list borrows the list for the read
# (#676; fannkuch_redux's perm[i]).
fn total(n: usize) -> usize:
    let mut xs: List[usize] = []
    for i in 0..n:
        xs.push(i)
    let sum: usize = 0
    for i in 0..n:
        # subject
        sum = sum + xs[i]
    sum
