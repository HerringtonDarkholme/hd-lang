# @dump: own counts wat
# @build: v8 release
# expected: the whole-local reference is a local reference, so it takes no count of tally's cell, which the frame holds while bump waits.
struct Tally:
    n: i64

fn bump!(t: &mut Tally) -> void:
    t.n += 1

fn direct!() -> i64:
    let mut tally = Tally { n: 0 }
    bump!(&mut tally)
    tally.n
