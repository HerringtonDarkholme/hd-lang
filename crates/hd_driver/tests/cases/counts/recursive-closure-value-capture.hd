# @dump: wat counts
# @build: v8 release
# One environment stores a scalar seed. The new-object descriptor is
# acyclic (no high CYCLIC bit), and no shared binding cell is allocated.
fn sum_to(limit: i32, seed: i32) -> i32:
    sum := fn(n: i32) -> i32:
        if n == 0: seed
        else: n + sum(n - 1)
    sum(limit)
