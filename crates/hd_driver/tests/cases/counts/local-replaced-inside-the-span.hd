# @dump: counts mir
# @build: v8 release
# The read of `cur` keeps its count: the `if` in the index replaces `cur`
# before the index reads the list the first read returned.
fn reassigned(s: List[usize], t: List[usize], c: bool) -> usize:
    let cur = s
    # subject
    n := cur[
        if c:
            cur = t
            0
        else:
            1
    ]
    n + cur.len()
