# @dump: own counts wat
# @build: v8 release
# expected: the closure acquires its borrowed text input at Cold or fresh Entry;
# polling an existing frame uses the count its constructor already holds.
use std.time.{Clock, ms, sleep}

fn make() -> (fn!(string) -> usize $ Clock):
    fn!(text: string) -> usize $ Clock:
        sleep!(ms(1))
        text.len()
