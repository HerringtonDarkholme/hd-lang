# @dump: own counts wat
# @build: v8 release
# expected: a generic spread keeps its argument-copy packet, while concrete
# Copy fields borrow and lower no argument retain; the owned tuple still drops.
use std.function.{Fn, Tuple}

fn call[Args < Tuple, O](f: Fn[Args, O, $ ()], args: Args) -> O:
    f(args...)

fn through(f: fn(string, List[i32]) -> usize, text: string, values: List[i32]) -> usize:
    call(f, (text, values))
