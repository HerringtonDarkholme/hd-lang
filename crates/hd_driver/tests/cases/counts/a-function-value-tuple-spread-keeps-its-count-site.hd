# @dump: own counts wat
# @build: v8 release
# expected: an explicit argument-copy packet supplies each owned parameter with its counted tuple fields.
use std.function.{Fn, Tuple}

fn call[Args < Tuple, O](f: Fn[Args, O, $ ()], args: Args) -> O:
    f(args...)

fn through(f: fn(string, List[i32]) -> usize, text: string, values: List[i32]) -> usize:
    call(f, (text, values))
