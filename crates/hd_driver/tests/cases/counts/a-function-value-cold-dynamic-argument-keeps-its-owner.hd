# @dump: own counts wat
# @build: v8 release
# expected: the cold adapter's value parameter states/acquires its Entry
# count before transferring it into the dynamic cold constructor. The
# ordinary dynamic reader keeps its Copy parameter borrowed, without an
# Entry copy. Both callbacks lend their erased receiver to its slot.
trait Echo[T]:
    fn echo!(&self, value: T) -> T
    fn read(&self, value: List[string]) -> usize

struct Echoer:
    padding: usize

impl[T] Echo[T] for Echoer:
    fn echo!(&self, value: T) -> T:
        value

    fn read(&self, value: List[string]) -> usize:
        value.len()

fn cold_adapter(dynamic: *dyn Echo[List[string]]) -> (fn(List[string]) -> Suspend[List[string]]):
    fn(value: List[string]) -> Suspend[List[string]]: dynamic.echo(value)

fn reader_adapter(dynamic: *dyn Echo[List[string]]) -> (fn(List[string]) -> usize):
    fn(value: List[string]) -> usize: dynamic.read(value)
