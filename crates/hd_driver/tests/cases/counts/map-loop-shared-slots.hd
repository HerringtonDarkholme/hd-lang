# @dump: own counts wat
# @build: v8 release std
# expected: lend real entry slots without a key, value or map copy.
fn seed() -> Map[usize, usize]:
    { 1: 2 }

fn sum(items: &Map[usize, usize]) -> usize:
    let total = 0
    # subject
    for (key, value) in items:
        total += key + value
    total
