# @dump: counts
# @build: std release
# A reference that a store uses at once counts nothing (#1345, #1336
# phase 10): `Ptr.as_mut` and `UniqList.get_mut` give a plain address, so
# neither store takes a retain and release pair of the element's room.
# Rule: ref.count.local.
use std.collections.UniqList
use std.rt.memory.Buffer

fn set_bool(list: &mut UniqList[bool], index: usize, value: bool) -> void:
    match list.get_mut(index):
        .Some(slot) => *slot = value
        .None => panic("bool index")

fn store_at(buffer: &mut Buffer[i64], index: usize, value: i64) -> void:
    *buffer.at(index).as_mut() = value
