# @dump: own
# @build: std
# `Buffer.len`'s explicit `@inline(.Always)` is copied even though it belongs
# to std.rt. The undecorated `capacity`, `set_len`, and `at` stay calls; all
# four methods borrow the buffer field without a count.
# Rules: annot.inline.always-copyable.v3, module.rt.buffer.borrowed-access.
use std.rt.memory.Buffer

struct Bag:
    buffer: Buffer[i32]

impl !Copy for Bag

impl Bag:
    fn touch(&self, len: usize) -> usize:
        capacity := self.buffer.capacity()
        held := self.buffer.len()
        self.buffer.set_len(len)
        address := self.buffer.at(0).address
        capacity + held + address
