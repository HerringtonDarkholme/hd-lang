# @dump: own
# @build: std
# `Buffer`'s capacity and address methods borrow a buffer field, so they
# take no count around their calls; growing it takes `&mut`.
# Rule: module.rt.buffer.borrowed-access.
use std.rt.memory.Buffer

struct Bag:
    buffer: Buffer[i32]

impl !Copy for Bag

impl Bag:
    fn touch(&mut self, len: usize) -> usize:
        capacity := self.buffer.capacity()
        self.buffer.grow(len)
        address := self.buffer.at(0).address
        capacity + address
