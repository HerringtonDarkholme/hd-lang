# @dump: own
# @build: std
# `Buffer`'s reading metadata and address methods borrow a buffer field, so
# they transfer no ownership around their calls. Changing its length takes
# the mutable borrow that the unique owner requires.
# Rule: module.rt.buffer.access.
use std.rt.memory.Buffer

struct Bag:
    buffer: Buffer[i32]

impl !Copy for Bag

impl Bag:
    fn touch(&mut self, len: usize) -> usize:
        capacity := self.buffer.capacity()
        held := self.buffer.len()
        self.buffer.set_len(len)
        address := self.buffer.at(0).address
        capacity + held + address
