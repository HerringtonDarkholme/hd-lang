# @dump: tir own counts wat
# expected: TIR borrows the counted pointee with Ref; ownership keeps the
# declared owner through the cold callback, then releases it. The local
# reference payload takes no count.
use std.annotation.cold

@cold
fn read(value: (&i32)?) -> i32:
    match value:
        .Some(item) => *item
        .None => -1

fn call() -> i32:
    let owner: *i32 = box(+7)
    let callback: fn((&i32)?) -> i32 = read
    callback(.Some(owner))
