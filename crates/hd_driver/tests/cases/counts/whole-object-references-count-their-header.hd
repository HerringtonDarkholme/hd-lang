# @dump: wat
# @build: v8 dev
# Every `*Node` refers to a whole object, so its counts read the header:
# `rt:retain_known`, with no page-table search, in dev as in release,
# though the program also refers to a field and an element (#988).
struct Node:
    left: (*Node)?
    right: (*Node)?

fn leaf() -> *Node:
    box(Node { left: .None, right: .None })

struct Pair:
    a: Node
    b: Node

fn left(n: &Node) -> bool:
    n.left.is_some()

fn first(nodes: &List[Node], pair: &Pair) -> bool:
    left(&nodes[0]) && left(&pair.b)

fn both(n: *Node) -> (*Node, *Node):
    # subject
    (n, n)
