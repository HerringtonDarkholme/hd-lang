# @dump: own counts wat
# @build: v8 release
# The whole-local reference is a local reference to tally's slot in the
# frame object (#1707), so it takes no count, and no cell is made.
struct Tally:
    n: i64

# Awaiting a suspending closure is a suspension point, so `bump!` and
# `direct!` keep their frames (#2419).
fn bump!(t: &mut Tally) -> void:
    step := fn!() -> i64: 1
    t.n += step!()

fn direct!() -> i64:
    let mut tally = Tally { n: 0 }
    bump!(&mut tally)
    tally.n
