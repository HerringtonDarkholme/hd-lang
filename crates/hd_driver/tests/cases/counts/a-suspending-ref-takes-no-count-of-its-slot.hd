# @dump: own counts wat
# @build: v8 release
# The whole-local reference is a local reference to tally's slot in the
# frame object (#1707), so it takes no count, and no cell is made.
struct Tally:
    n: i64

fn bump!(t: &mut Tally) -> void:
    t.n += 1

fn direct!() -> i64:
    let mut tally = Tally { n: 0 }
    bump!(&mut tally)
    tally.n
