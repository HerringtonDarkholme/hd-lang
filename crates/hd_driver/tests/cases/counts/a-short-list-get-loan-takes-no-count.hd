# @dump: counts
# Loan: the reference `get` returns ends before anything could change the
# list (emit/loan.rs), so it takes no count: no uniqueness check, pin or
# retain of the buffer.
struct Line:
    name: string
    cents: i64

fn first_cents(lines: &List[Line]) -> i64:
    # subject
    match lines.get(0):
        .Some(line) => line.cents
        .None => 0

fn last_name_len(lines: &List[Line]) -> usize:
    # subject
    match lines.last():
        .Some(line) => line.name.len()
        .None => 0
