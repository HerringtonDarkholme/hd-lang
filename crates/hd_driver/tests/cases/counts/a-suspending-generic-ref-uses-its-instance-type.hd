# @dump: own counts wat
# @build: v8 release
# expected: concrete scalar and record instances state the existing-cell copy; an open target stays unknown.
struct Tally:
    n: i64

fn copy![T](value: &T) -> T:
    *value

fn generic![T](value: T) -> T:
    # subject
    copy!(&value)

pub fn main!() -> void $ Console:
    println(generic!(+9))
    value := generic!(Tally { n: 2 })
    println(value.n)
