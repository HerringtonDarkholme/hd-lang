# @dump: own counts wat
# @build: v8 release
# expected: scalar and record instances take no count of the existing cell; the reference is local at every instance.
struct Tally:
    n: i64

fn copy![T](value: &T) -> T:
    pause!()
    *value

fn generic![T](value: T) -> T:
    # subject
    copy!(&value)

pub fn main!() -> void $ Console:
    println(generic!(+9))
    value := generic!(Tally { n: 2 })
    println(value.n)

# A suspension point: awaiting a suspending closure, so a caller of
# `pause!` keeps its frame and child (#2419).
fn pause!() -> void:
    step := fn!() -> void: pass
    step!()
