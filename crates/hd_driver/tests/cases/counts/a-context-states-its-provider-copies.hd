# @dump: own counts wat
# @build: v8 release
# expected: a new context moves direct providers, copies spread entries, and releases shadowed direct providers; an empty context has no count.
trait Tag:
    fn name(self) -> string

struct Named:
    label: string

impl Tag for Named:
    fn name(self) -> string:
        self.label

fn make(label: string) -> $.Context[$ Tag]:
    $.context(Tag=Named { label: label })

fn spread(ctx: $.Context[$ Tag]) -> $.Context[$ Tag]:
    $.context(ctx...)

fn shadow(ctx: $.Context[$ Tag], label: string) -> $.Context[$ Tag]:
    $.context(ctx..., Tag=Named { label: label })

fn empty() -> $.Context[$ ()]:
    $.context()

fn before_spread(ctx: $.Context[$ Tag], label: string) -> $.Context[$ Tag]:
    $.context(Tag=Named { label: label }, ctx...)

fn replace(first: string, last: string) -> $.Context[$ Tag]:
    $.context(Tag=Named { label: first }, Tag=Named { label: last })
