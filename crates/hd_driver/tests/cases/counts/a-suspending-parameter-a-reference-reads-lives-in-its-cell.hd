# @dump: own counts wat
# @build: std
# expected: `sized`'s cold constructor makes the cell from the arguments, once, and `u.len()` takes no count of the cell and no new object; the exit drop releases the cell, whose release runs the list's hook once. `main!`'s `let mut u` moves out of its cell at the await.
use std.collections.UniqList
use std.time.{Clock, ms, sleep}

fn sized!(u: UniqList[i32]) -> usize $ Clock:
    sleep!(ms(1))
    u.len()

pub fn main!() -> void $ Console + Clock:
    let mut u = UniqList::[i32].new()
    u.push(1)
    a := sized!(u)
    println("$a")
