# @dump: counts
# @build: v8 release
# `read` shares `tally`'s cell, so `tally` lives in a cell, not a frame
# slot. The local's release follows the reference's last use (cell locals
# outlive what points into them, #1299), so `&mut tally` takes no count
# (#1320, `ref.count.local`).
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn shared() -> i64:
    let mut tally = Tally { n: 0 }
    read := fn() -> i64: tally.n
    # subject
    bump(&mut tally)
    read()
