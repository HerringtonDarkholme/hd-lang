# @dump: counts
# @build: v8 release
# `read` shares `tally`, and neither `read` nor `&mut tally` leaves the
# frame, so `tally` lives in a frame slot (#1399 19a4). The local's
# release follows the closure's and the reference's last use, so
# `&mut tally` takes no count (#1320, `ref.count.local`).
struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn shared() -> i64:
    let mut tally = Tally { n: 0 }
    read := fn() -> i64: tally.n
    # subject
    bump(&mut tally)
    read()
