# @dump: own wat counts
# @build: v8 release
# `sink` borrows the row's provider, which the caller holds for the whole body,
# and a `&dyn` counts nothing: neither `line` nor `swapped`, which assigns its
# local, takes a count.
trait Sink:
    fn put(&mut self, text: string) -> void

struct Count:
    n: usize

impl Sink for Count:
    fn put(&mut self, text: string) -> void:
        self.n = self.n + text.len()

fn line(text: string) -> void $ Sink:
    let sink: &mut dyn Sink = $.use(Sink)
    sink.put(text)
    sink.put("!")

fn swapped(text: string, other: &mut dyn Sink) -> void $ Sink:
    let mut sink: &mut dyn Sink = $.use(Sink)
    sink.put(text)
    sink = other
    sink.put("!")

pub fn go() -> usize:
    first := box(Count { n: 0 })
    second := box(Count { n: 0 })
    $.with(Sink = first):
        line("ab")
        swapped("c", second)
    first.n + second.n
