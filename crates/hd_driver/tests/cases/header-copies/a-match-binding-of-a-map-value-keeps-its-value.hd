# @dump: stdout
# @build: checked
# Collection copies (`docs/compiler/tir-v2.md`, "List and Map buffers"):
# a match binding of a map's list keeps its value when the map's
# list changes in place afterwards, since its count makes the map's
# buffer shared and the change copies it first. The checked runtime's
# exit audit fails on a leak or a double free.
fn kept(mut m: Map[string, List[i64]]) -> usize:
    match m.get("a"):
        .Some(xs) =>
            m["a"].push(3)
            xs.len()
        .None => 0

pub fn main() -> void $ Console:
    let mut m: Map[string, List[i64]] = {"a": [1, 2]}
    println(kept(m))
    println(m["a"].len())
