# @dump: stdout
# @main: src/main.hd
# module.dep.identity, module.package.no-sharing: two packages whose
# manifests share the name `money` are two packages, so one's `Coin` is
# not the other's. The mismatch names neither by an internal `$` root:
# each type shows its dependency key, inside a generic type too, while a
# function path shows none. A key is shown as the manifest spells it,
# `my-wallet`, though source writes `dep.my_wallet`.
use dep.euro
use dep.yen.{Coin as Yen}
use dep.my_wallet.{Coin as Wallet}

pub fn main() -> void $ Console:
    let y: Yen = euro.make(1)
    let ys: List[Yen] = [euro.make(2)]
    let f: fn(i32) -> Yen = euro.make
    println(y.cents + f(3).cents)
    println(ys.len())
    let w: Wallet = euro.make(4)
    println(w.cents)
# @dependency: euro=money
# @file: src/lib.hd
pub struct Coin:
    pub cents: i32

pub fn make(n: i32) -> Coin:
    Coin { cents: n * 100 }
# @dependency: yen=money
# @file: src/lib.hd
pub struct Coin:
    pub cents: i32

pub fn make(n: i32) -> Coin:
    Coin { cents: n * 1000 }
# @dependency: my-wallet=money
# @file: src/lib.hd
pub struct Coin:
    pub cents: i32
