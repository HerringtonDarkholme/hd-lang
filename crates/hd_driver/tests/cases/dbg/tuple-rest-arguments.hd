# @dump: wat
# expected: each call passes the tuple and one static call-site record to the ordinary `dbg`;
# a function value's closure passes the record of the place that creates it; dispatch stays indirect.
fn direct(values: (List[string]...,)) -> void:
    dbg(values...)

fn function_value(values: (List[string]...,)) -> void:
    let show: fn((List[string]...,)) -> void = dbg
    show(values)
