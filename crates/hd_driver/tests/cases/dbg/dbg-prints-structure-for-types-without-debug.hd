# @dump: stdout
struct Node:
    label: string
    next: *Node?

struct Pair:
    left: List[Node]
    right: (i32, Node?)

enum Shape:
    Dot
    Pair(i32, string)
    Tagged(tag: bool)

pub fn main() -> void $ Console:
    list := Node { label: "a", next: .Some(box(Node { label: "b", next: .None })) }
    dbg(list)
    dbg(Pair { left: [list], right: (1, .None) })
    dbg([Shape.Dot, Shape.Pair(1, "x"), Shape.Tagged(tag=true)])
    dbg({ "k": Shape.Dot })
    let failed: Result[i32, Shape] = .Err(Shape.Dot)
    dbg(failed)
    println("done")
