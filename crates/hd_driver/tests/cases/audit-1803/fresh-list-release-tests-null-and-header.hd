# @build: release
# @dump: wat
# Audit #1803 draft 58, #2201: the list `[1, 2, 3]` is allocated in this
# function and owned by it alone, so its `Drop` is fresh (`drop_word::FRESH`)
# and its release goes straight to the free path (`rt:release_fresh`), with no
# null test or count-header load.
use std.meta.inline

@inline(.Never)
fn fresh() -> usize:
    xs := [1, 2, 3]
    ys := xs
    ys.len()

pub fn main() -> void $ Console:
    println("${fresh()}")
