# @build: release
# @dump: wat
# expected: audit #1803 draft 55 (#2205). Every point parks at one Pending exit
# and every cancellation leaves by one exit per body, and a child's cancel is
# one `rt:cancel_child` call: 50 awaits 25,385 B, 500 awaits 131,659 B (was
# 35,682 / 234,431), about 236 bytes an await (was 442), ratio 5.2 (was 6.6).
use std.task.{block_on}
use std.time.{Clock, s, sleep}

fn step!(x: i32) -> i32 $ Clock:
    sleep!(s(0))
    x + 1

fn three!(x: i32) -> i32 $ Clock:
    let mut v = x
    v = step!(v)
    v = step!(v)
    v = step!(v)
    v

pub fn main() -> void $ Console + Clock:
    _ := block_on(three(0))
    println("done")
