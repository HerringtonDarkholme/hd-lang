# @build: release
# @dump: wat
# expected: audit #1803 draft 86 (#2203). The flags word is loaded once to set
# RUNNING, and one test of the frame picks the save area and readies a fresh
# one. Still open: the RUNNING guard and the resume state each test the frame
# again (they are made by separate stages); one prologue would test it once.
use std.task.{block_on}
use std.time.{Clock, s, sleep}

fn step!(x: i32) -> i32 $ Clock:
    sleep!(s(0))
    x + 1

pub fn main() -> void $ Console + Clock:
    _ := block_on(step(1))
    println("done")
