# @dump: stdout
# @build: dev | checked
# A one-node ring that holds an arena with a value in it, found garbage by
# the collection at the entry's end. The node's glue runs while the
# collector marks and scans (`module.rt.drop.trace`) and again when it
# frees the ring. The arena's hook empties its drop list and frees its
# chunks in the first pass, so the string in it is never released: the
# checked run's audit reports it leaked.
# expected: exit 0 and `done` in both builds, no leak (#2345 report)
use std.arena.Arena

struct Item:
    name: string

struct Node:
    arena: Arena
    next: (*mut Node)?

fn ring() -> void:
    x := box(Node { arena: Arena::new(), next: .None })
    _ := x.arena.alloc(Item { name: "c" + "d" })
    x.next = .Some(x)

pub fn main() -> void $ Console:
    ring()
    println("done")
