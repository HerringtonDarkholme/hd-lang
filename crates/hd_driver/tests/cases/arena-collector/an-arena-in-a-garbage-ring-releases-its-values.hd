# @dump: stdout
# @build: dev | checked | release | release checked
# A one-node ring that holds an arena with a value in it, found garbage by
# the collection at the entry's end. The node's glue runs while the
# collector marks and scans (`module.rt.drop.trace`) and again when it
# frees the ring. Only that last pass empties the drop list, so the string
# in the arena is released, and the collector frees the chunk after it
# (`std.rt.cycle.hold_room`): the checked run's audit finds no leak.
use std.arena.Arena

struct Item:
    name: string

struct Node:
    arena: Arena
    next: (*mut Node)?

fn ring() -> void:
    x := box(Node { arena: Arena::new(), next: .None })
    _ := x.arena.alloc(Item { name: "c" + "d" })
    x.next = .Some(x)

pub fn main() -> void $ Console:
    ring()
    println("done")
