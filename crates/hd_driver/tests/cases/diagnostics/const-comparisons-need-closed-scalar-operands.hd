# @dump: diagnostics
# types.generic.const.no-symbolic-arithmetic and types.generic.const.nonconstant:
# comparing operands does not make symbolic or non-scalar inputs closed constants.

struct Flag[Value < const bool]:
    value: i32

fn symbolic_comparison[Value < const i32]() -> void:
    let _bad = Flag::[Value == Value] { value: +0 }

fn tuple_comparison() -> void:
    let _bad = Flag::[(1, 2) == (1, 2)] { value: +0 }
