# @dump: diagnostics
# @build: std
# annot.template.unique: templates are unique per trait and per kind.
# Each trait has one union template, and all traversal bodies check.
use std.structure.{Field, Structure, UnionType, Variant, Walker}

trait Probe < ?Copy:
    fn probe(&self) -> bool

trait Other < ?Copy:
    fn other(&self) -> bool

struct Noop: pass

impl[S < ?Copy] Walker[S] for Noop:
    type Error = never

    fn variant(&mut self, value: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < ?Copy](&mut self, field: Field[S, F], value: &F) -> Result[void, never]:
        .Ok(())

impl[T < ?Copy & UnionType] Probe for T by Structure:
    fn probe(&self) -> bool:
        let mut walker = Noop {}
        _ := Structure::walk(self, &mut walker)
        true

impl[T < ?Copy & UnionType] Other for T by Structure:
    fn other(&self) -> bool:
        let mut walker = Noop {}
        _ := Structure::walk(self, &mut walker)
        true
