# @dump: stdout
# `chars` and `bytes` are built on closures that assign a captured offset
# (`Iterator::from_fn`); `join`, `to_utf8` and `string::from_utf8` keep the
# two-byte character whole.
pub fn main() -> void $ Console:
    for c in "héllo".chars():
        println("${c}")
    for b in "héy".bytes():
        println("${b}")
    let parts: List[string] = ["ab", "cé", "d"]
    println(parts.join("-"))
    let bytes = "héllo".to_utf8()
    println("${bytes.len()}")
    match string::from_utf8(bytes):
        .Ok(text) => println(text)
        .Err(_) => println("invalid")
