# @dump: stdout
pub fn main() -> void $ Console:
    s := "héllo wörld"
    println("${s.len()} ${s[0]} ${s[1]}")
    word := s.slice(7, 12)
    println(word)
    println("${word.len()} ${word[0]} ${word[2]}")
    println(word.slice(0, 1))
    println(word.slice(1, 3))
    let lo: usize = 7
    let hi: usize = 10
    println(s.slice(lo, hi))
    println(s.slice(lo, s.len()))
    println(word[5])
