# @dump: functions
# @build: release
# Two members renamed to one key make an irregular walk, so the derived
# serializer keeps the tree fallback and searches for `std.encoding.Rename`.
use std.encoding.json.encode
use std.encoding.{Serialize, rename}

@derive(Serialize)
struct Pair:
    @rename("same")
    left: i64
    @rename("same")
    right: i64

pub fn main() -> void $ Console:
    println(encode(Pair { left: 1, right: 2 }))
