# @dump: functions
# @build: release
# A walker that asks a handle with no facts for `Skip` links no
# `Facts.find` or `FieldRecord.fact` search for `std.serde.Skip`.
use std.serde.Skip
use std.structure.{Field, Structure, Variant, Walker}

trait HasSkip:
    fn has_skip(self) -> bool

struct Finder:
    found: bool

impl[S] Walker[S] for Finder:
    type Error = never
    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        self.found = self.found || v.info.facts.find::[Skip]().is_some()
        .Ok(())
    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        self.found = self.found || h.fact::[Skip]().is_some()
        .Ok(())

impl[T] HasSkip for T by Structure:
    fn has_skip(self) -> bool:
        let mut finder = Finder { found: false }
        _ := Structure::walk(&self, &mut finder)
        finder.found

@derive(HasSkip)
struct Row:
    value: i64

pub fn main() -> void $ Console:
    println(Row { value: 1 }.has_skip())
