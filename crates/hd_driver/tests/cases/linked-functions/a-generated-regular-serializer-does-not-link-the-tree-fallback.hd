# @dump: functions
# @build: release
# A concrete `json.encode` instance links its tree fallback only when its
# selected serializer may make an irregular walk (#921). A derived
# regular serializer links no `JsonWriter`, `encode_fallback`,
# `enum_tagging` or `Skip` fact search.
use std.encoding.json.{encode, encode_pretty}
use std.encoding.Serialize

@derive(Serialize)
struct Row:
    id: i64
    name: string

pub fn main() -> void $ Console:
    value := [Row { id: 1, name: "one" }]
    println(encode(value))
    println(encode_pretty(value))
