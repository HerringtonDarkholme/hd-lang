# @dump: stdout
pub fn main() -> void $ Console:
    let mut m: Map[string, i32] = {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6, "g": 7, "h": 8}
    for k in ["a", "b", "c", "d", "e"]:
        _ := m.remove(k)
    let mut it = m.iter()
    match it.next():
        .Some((k, _)) => println(k)
        .None => println("none")
    _ := m.remove("f")
    m["i"] = 9
    println(m.len())
    while true:
        match it.next():
            .Some((k, _)) => println(k)
            .None => break
