# @dump: stdout
# Proving that a requested type is absent must not remove evaluation of the
# declaration's unrelated fact values.
use std.meta.facts_of
use std.meta.{Structure, Field, Variant, Walker}

struct Style:
    prefix: string = ""

fn no_prefix() -> string:
    panic("no prefix configured")

trait Label:
    fn label(self) -> string

struct Sink:
    n: i32

impl[S] Walker[S] for Sink:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

impl[T] Label for T by Structure:
    fn label(self) -> string:
        let mut w = Sink { n: 0 }
        _ := Structure::walk(&self, &mut w)
        match T::facts().find::[Style]():
            .Some(found) => found.prefix
            .None => "none"

struct Other: pass

fn other() -> Other:
    panic("unrelated fact ran")

@derive(Label)
@other()
struct Point:
    x: i64

pub fn main() -> void $ Console:
    println(Point { x: 1 }.label())
