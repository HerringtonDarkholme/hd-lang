# @dump: wat
# A cold call through `&mut dyn Sink` that `block_on` drives at once
# calls the drive slot (offset 4, frame and result) after the
# forbidden-context check. `block_on` polls only after a wait.
use std.task.block_on

trait Sink:
    fn put!(&mut self, text: string) -> i32

fn drive_put(s: &mut dyn Sink, text: string) -> i32:
    let call: mut Suspend[i32] = s.put(text)
    match block_on(call):
        .Completed(n) => n
        .Cancelled => 0
        .Abandoned => 0
