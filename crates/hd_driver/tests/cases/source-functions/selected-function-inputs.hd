# @dump: stdout
# @build: dev | checked
# Resolved source bodies retain their headers across generic, inferred and method checks.
trait Value:
    fn value(&self) -> i32
    fn doubled(&self) -> i32:
        self.value() * 2

struct Record:
    n: i32

impl Value for Record:
    fn value(&self) -> i32:
        self.n + 1

fn identity[T](value: T) -> T:
    value

fn inferred(value: i32):
    value + 1

pub fn main() -> void $ Console:
    record := Record { n: +20 }
    println("${identity(+42)} ${inferred(+41)} ${record.doubled()}")
