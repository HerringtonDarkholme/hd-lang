# @dump: stdout
# @fuel: 64
# A signature bound proved through 40 nested boxes runs out of fuel: one
# `item-too-complex` on its function, never a proved goal.
pub trait Marker

pub struct Box[T]:
    value: T

impl Marker for i32

impl[T < Marker] Marker for Box[T]

pub struct Need[T < Marker]:
    value: T

fn deep(value: Need[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[i32]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]) -> void:
    pass

pub fn main() -> void:
    pass
