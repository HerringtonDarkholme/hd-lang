# @dump: tests
# Generated by scripts/generate-libm-vectors.py from musl 1.2.5's src/math;
# do not edit. Each float method gives musl's result bit for bit
# (std-num.float-math.musl): a line is the input bits, then the result
# bits, or `nan` where musl's result is a NaN. A failure lists every
# input whose result differs.

fn check_f64(name: string, table: string) -> List[string]:
    words := table.split_whitespace()
    arity := if name == "powf" || name == "atan2" || name == "hypot": usize(2) else if name == "mul_add": usize(3) else: usize(1)
    let mut wrong: List[string] = []
    let i = usize(0)
    while i < words.len():
        a := f64::from_bits(u64::parse_radix(words[i], 16).unwrap())
        b := if arity > 1: f64::from_bits(u64::parse_radix(words[i + 1], 16).unwrap()) else: f64(0.0)
        c := if arity > 2: f64::from_bits(u64::parse_radix(words[i + 2], 16).unwrap()) else: f64(0.0)
        expected := words[i + arity]
        got := match name:
            "exp" => a.exp()
            "exp2" => a.exp2()
            "exp_m1" => a.exp_m1()
            "ln" => a.ln()
            "log2" => a.log2()
            "log10" => a.log10()
            "ln_1p" => a.ln_1p()
            "sin" => a.sin()
            "cos" => a.cos()
            "tan" => a.tan()
            "asin" => a.asin()
            "acos" => a.acos()
            "atan" => a.atan()
            "sinh" => a.sinh()
            "cosh" => a.cosh()
            "tanh" => a.tanh()
            "asinh" => a.asinh()
            "acosh" => a.acosh()
            "atanh" => a.atanh()
            "cbrt" => a.cbrt()
            "powf" => a.powf(b)
            "atan2" => a.atan2(b)
            "hypot" => a.hypot(b)
            "mul_add" => a.mul_add(b, c)
            _ => panic("unknown function $name")
        text := if got.is_nan(): "nan" else: got.to_bits().to_radix(16).pad_start(16, '0')
        if text != expected:
            wrong.push("${words.slice(i, i + arity).join(" ")} -> $text, musl $expected")
        i += arity + 1
    wrong

fn check_f32(name: string, table: string) -> List[string]:
    words := table.split_whitespace()
    arity := if name == "powf" || name == "atan2" || name == "hypot": usize(2) else if name == "mul_add": usize(3) else: usize(1)
    let mut wrong: List[string] = []
    let i = usize(0)
    while i < words.len():
        a := f32::from_bits(u32::parse_radix(words[i], 16).unwrap())
        b := if arity > 1: f32::from_bits(u32::parse_radix(words[i + 1], 16).unwrap()) else: f32(0.0)
        c := if arity > 2: f32::from_bits(u32::parse_radix(words[i + 2], 16).unwrap()) else: f32(0.0)
        expected := words[i + arity]
        got := match name:
            "exp" => a.exp()
            "exp2" => a.exp2()
            "exp_m1" => a.exp_m1()
            "ln" => a.ln()
            "log2" => a.log2()
            "log10" => a.log10()
            "ln_1p" => a.ln_1p()
            "sin" => a.sin()
            "cos" => a.cos()
            "tan" => a.tan()
            "asin" => a.asin()
            "acos" => a.acos()
            "atan" => a.atan()
            "sinh" => a.sinh()
            "cosh" => a.cosh()
            "tanh" => a.tanh()
            "asinh" => a.asinh()
            "acosh" => a.acosh()
            "atanh" => a.atanh()
            "cbrt" => a.cbrt()
            "powf" => a.powf(b)
            "atan2" => a.atan2(b)
            "hypot" => a.hypot(b)
            "mul_add" => a.mul_add(b, c)
            _ => panic("unknown function $name")
        text := if got.is_nan(): "nan" else: got.to_bits().to_radix(16).pad_start(8, '0')
        if text != expected:
            wrong.push("${words.slice(i, i + arity).join(" ")} -> $text, musl $expected")
        i += arity + 1
    wrong

