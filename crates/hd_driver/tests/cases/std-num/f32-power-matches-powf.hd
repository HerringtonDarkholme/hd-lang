# @dump: stdout
# @build: dev | release
# expected: each row has equal operator/method bits; NaN sign/payload are unspecified.

fn bits(value: f32) -> string:
    if value.is_nan(): "nan" else: value.to_bits().to_string()

fn show(x_bits: u32, y_bits: u32) -> void $ Console:
    x := f32::from_bits(x_bits)
    y := f32::from_bits(y_bits)
    println("${bits(x ** y)} ${bits(x.powf(y))}")

pub fn main() -> void $ Console:
    show(1095454373, 3248488448)
    show(1082633958, 3248158147)
    show(1074460728, 3247827845)
    for (x, y) in [
        (0u32, 0u32),
        (2143289344, 0),
        (1065353216, 2143289344),
        (3212836864, 2139095040),
        (2143289344, 1065353216),
        (1073741824, 2143289344),
        (0, 1077936128),
        (2147483648, 1077936128),
        (2147483648, 3225419776),
        (2147483648, 1073741824),
        (2147483648, 3221225472),
        (2139095040, 3212836864),
        (4286578688, 3225419776),
        (4286578688, 1077936128),
        (3221225472, 1056964608),
        (1073741824, 2139095040),
        (1056964608, 2139095040),
        (1056964608, 4286578688),
        (3221225472, 4286578688),
        (2139095039, 1073741824),
        (1, 1073741824),
        (1, 1065353216),
        (3221225472, 1073741824),
        (1082130432, 1056964608),
    ]:
        show(x, y)
