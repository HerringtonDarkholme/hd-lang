# @dump: functions stdout
# @build: dev | checked | release | release checked
# Both collected implementations of this closed drive slot are ready.
use std.meta.inline

trait Read:
    fn read!(&self) -> i32

struct Ready:
    value: i32

impl Read for Ready:
    fn read!(&self) -> i32:
        self.value

@inline(.Never)
fn read!() -> i32 $ Read:
    $.use(Read).read!()

struct Other:
    value: i32

impl Read for Other:
    fn read!(&self) -> i32:
        self.value + 1

pub fn main!() -> void $ Console:
    $.with(Read=box(Ready { value: 7 })):
        println(read!())
    $.with(Read=box(Other { value: 8 })):
        println(read!())
