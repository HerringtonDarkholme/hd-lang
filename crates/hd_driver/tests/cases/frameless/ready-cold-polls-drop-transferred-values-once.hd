# @dump: stdout
# @build: dev std | checked std | release std | release checked std
# Ready cold polls transfer non-Copy values out of their saved cells exactly once.
use std.meta.inline
use std.rt.Drop
use std.task.block_on

struct Token:
    name: string
    log: *mut List[string]

impl !Copy for Token

impl Drop for Token:
    fn drop(&mut self) -> void:
        self.log.push(self.name)

@inline(.Never)
fn length(value: &Token) -> usize:
    value.name.len()

fn inspect!(value: Token, read: fn(&Token) -> usize) -> usize:
    read(&value)

@inline(.Never)
fn drive(work: Suspend[usize]) -> usize:
    match block_on(work):
        .Completed(value) => value
        .Cancelled => panic("unexpected cancellation")
        .Abandoned => panic("unexpected abandonment")

pub fn main() -> void $ Console:
    let log: *mut List[string] = box([])
    println(drive(inspect(Token { name: "completed", log: log }, length)))
    _ := inspect(Token { name: "unstarted", log: log }, length)
    println(log.join(","))
