# @dump: functions
# @build: dev | release
# `outer!` waits only on `inner!`, which never waits: both complete at
# once, so neither links a `.poll`, `.cancel` or `.drop` (#2419).
# Release may inline both ready bodies; dev keeps their plain calls.
fn inner!(x: i32) -> i32:
    x * 2

fn outer!(x: i32) -> i32:
    inner!(x) + inner!(x + 1)

pub fn main!() -> void $ Console:
    println("${outer!(3)}")
