# @dump: wat
# @build: release
# A small generic local function called in a loop is inlined (#2222):
# the call names its lifted instance, as Swift's `apply %f<T>` names a
# `function_ref`, so the release inliner's rule for any function decides
# it. No closure value is made and no instance is left to emit.
fn total(xs: List[i32]) -> i32:
    fn twice[T](x: T) -> (T, T):
        (x, x)
    let sum: i32 = 0
    for x in xs:
        let (a, b) = twice(x)
        sum += a + b
    sum
