    char_3: char???
    string_1: string?
    string_2: string??
    string_3: string???
    list_1: List[i32]?
    list_2: List[i32]??
    list_3: List[i32]???
    a: A
    shape: Shape
    shape_1: Shape?
    pair: Pair
    tail: Tail
    tail_1: Tail?
    late_1: Late?
    mixed: Mixed
    mixed_1: Mixed?
    has_mixed: HasMixed
    result_string: Result[string, LoadErr]
    result_i32: Result[i32, LoadErr]
    big: Big
    big_1: Big?
    color: Color
    color_1: Color?
    with_never: WithNever
    with_never_2: WithNever2
    either_i32_bool: Either[i32, bool]
    either_i64_i32: Either[i64, i32]
    either_string_i32: Either[string, i32]
    either_bool_bool: Either[bool, bool]
    holder: Holder
    outer: Outer
    outer_1: Outer?
    json: Json
    json_1: Json?
    cookie: Cookie
    cookie_1: Cookie?
