# @dump: layout
# The size of each type in the enum layout gap table
# (docs/future-work/ENUM-LAYOUT.md, #1422): each field is one row's type.
# Struct fields are ordered by alignment, largest first.
use std.json.Json
use std.http.Cookie

enum A:
    Maybe(i32?)
    Must(i32)

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Tri(i32, i32, i32)
    Empty

enum Pair:
    L(bool, i32)
    M(i32)

enum Tail:
    V(i32, bool)
    W

struct Late:
    a: i32
    b: char

struct Mixed:
    a: i32
    b: f64
    c: bool

enum HasMixed:
    M(Mixed)
    N(i32)
    O

struct LoadErr:
    code: i32
    msg: string

enum Color:
    Red
    Green
    Blue

