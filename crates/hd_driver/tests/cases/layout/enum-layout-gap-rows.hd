enum WithNever:
    A(i32)
    B(never)

enum WithNever2:
    A(i32)
    B(i64, never)
    C

enum Either[L, R]:
    Left(L)
    Right(R)

struct Holder:
    flag: bool
    v: i32?
    w: i64

struct Outer:
    x: A?
    y: u8

# subject
struct Rows:
    i32_1: i32?
    i32_2: i32??
    i32_3: i32???
    i64_1: i64?
    i64_2: i64??
    bool_1: bool?
    bool_2: bool??
    bool_3: bool???
    char_1: char?
