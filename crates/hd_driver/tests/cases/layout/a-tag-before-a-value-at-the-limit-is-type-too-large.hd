# @dump: stdout
# `Limit` takes 2^31 - 1 bytes, the most a value may take;
# a union with `i32` puts a 1-byte tag before it, one byte past the limit.
type B0 = u8
type B1 = (B0, B0)
type B2 = (B1, B1)
type B3 = (B2, B2)
type B4 = (B3, B3)
type B5 = (B4, B4)
type B6 = (B5, B5)
type B7 = (B6, B6)
type B8 = (B7, B7)
type B9 = (B8, B8)
type B10 = (B9, B9)
type B11 = (B10, B10)
type B12 = (B11, B11)
type B13 = (B12, B12)
type B14 = (B13, B13)
type B15 = (B14, B14)
type B16 = (B15, B15)
type B17 = (B16, B16)
type B18 = (B17, B17)
type B19 = (B18, B18)
type B20 = (B19, B19)
type B21 = (B20, B20)
type B22 = (B21, B21)
type B23 = (B22, B22)
type B24 = (B23, B23)
type B25 = (B24, B24)
type B26 = (B25, B25)
type B27 = (B26, B26)
type B28 = (B27, B27)
type B29 = (B28, B28)
type B30 = (B29, B29)

type Limit = (B30, B29, B28, B27, B26, B25, B24, B23, B22, B21, B20, B19, B18, B17, B16, B15, B14, B13, B12, B11, B10, B9, B8, B7, B6, B5, B4, B3, B2, B1, B0)

pub fn main() -> void $ Console:
    let xs: List[Limit | i32] = []
    println(xs.len())
