# @dump: layout wat
# expected: Wrap[Carrier] is laid out from its instance, where `Item` is
# i32 (#1544): a value enum of tag and payload, 8 bytes inline in Holder.
# wrap returns the two values, unwrap tests the tag and returns the
# payload, with no allocation and no release. Runtime output is 42.
use std.annotation.inline

trait Value:
    type Item

struct Carrier: pass

impl Value for Carrier:
    type Item = i32

enum Wrap[T < Value]:
    Empty
    Present(value: T::Item)

struct Holder:
    value: Wrap[Carrier]

@inline(.Never)
fn unwrap(value: Wrap[Carrier]) -> i32:
    match value:
        .Empty => +0
        .Present(n) => n

@inline(.Never)
fn wrap(n: i32) -> Wrap[Carrier]:
    .Present(n)

pub fn main() -> void $ Console:
    held := Holder { value: wrap(+42) }
    println(unwrap(held.value))
