# @dump: layout
use std.http.Cookie
use std.json.Json
# Enum sizes against Rust's wasm32 layout (#1422).
enum A:
    Maybe(i32?)
    Must(i32)

enum Pair:
    L(bool, i32)
    M(i32)

enum Four:
    X(i32?)
    Y(i32)
    Z(u16)
    W

enum Wide:
    F(i64?)
    G(i32)
    H(i64)

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Tri(i32, i32, i32)
    Empty

struct Late:
    a: i32
    b: char

enum Tail:
    V(i32, bool)
    W

struct Mixed:
    a: i32
    b: f64
    c: bool

enum HasMixed:
    M(Mixed)
    N(i32)
    O

struct LoadErr:
    code: i32
    msg: string

enum WithNever:
    A(i32)
    B(never)

enum WithNever2:
    A(i32)
    B(i64, never)
    C

enum Tree:
    Leaf(i32)
    Node(*Tree, *Tree)

enum Cons:
    Nil
    Cons(i32, *Cons)

enum Either[L, R]:
    Left(L)
    Right(R)

struct Holder:
    flag: bool
    v: i32?
    w: i64

struct Outer:
    x: A?
    y: u8

enum Color:
    R
    G
    B

