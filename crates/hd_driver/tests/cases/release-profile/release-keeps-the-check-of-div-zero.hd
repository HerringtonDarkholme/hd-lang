# @dump: stdout
# @build: release
# Release keeps this check of every build (`types.arith.always`,
# `trait.num.from-i64-checked`, `std-time.duration.non-negative`): it panics
# with `integer-division-by-zero`.
fn f(a: i32, b: i32) -> i32: a / b

pub fn main() -> void $ Console:
    println(f(1, 0))
