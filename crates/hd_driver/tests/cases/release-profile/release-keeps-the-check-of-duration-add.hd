# @dump: stdout
# @build: release
# Release keeps this check of every build (`types.arith.always`,
# `trait.num.from-i64-checked`, `std-time.duration.non-negative`): it panics
# with `integer-overflow`.
use std.time.Duration

pub fn main() -> void $ Console:
    println((Duration::milliseconds(9223372036854775807) + Duration::milliseconds(1)).as_milliseconds())
