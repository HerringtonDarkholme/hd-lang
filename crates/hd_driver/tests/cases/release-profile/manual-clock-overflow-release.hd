# @dump: stdout
# @build: release
# A manual clock sleep past the last time point panics with
# `integer-overflow`, in a release build too, where ordinary addition wraps.
use std.time.{Clock, Duration, ManualClock, Timestamp}

pub fn main!() -> void:
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(1))
    clock.sleep!(Duration::milliseconds(9223372036854775807))
