# @dump: tests
# @filter: comp
# `@filter` selects the cases whose names contain the text, across
# modules, as `hd test --filter` does (cli.test.filter): only `compares`
# is planned, and it runs.
use std.testing.{assert, assert_equal}

fn add(a: i32, b: i32) -> i32:
    a + b

tests:
    it("adds"):
        assert_equal(add(2, 3), 5, reason="small sums")

    it("skips", ignore="slow"):
        assert(false, reason="never runs")

    it("times out", timeout=.None):
        assert(true, reason="no limit")

# @file: text.hd
use std.testing.assert

tests:
    it("compares"):
        assert("a" == "a", reason="equal text")
