# @dump: wat tests
# @build: tests
# @helpers: test_poll
# A test program's case dispatch (`hd.test`) over more cases than one
# function holds, 256, splits into a tree (#2049): the root picks a part by
# `case >> 8` and passes it `case & 255`; each part dispatches its run of
# 256 cases. Every case still runs its own body: case 256, in the second
# part, is the one that fails, and case 257 there suspends, so its poll
# gets the case's context through the part.
use std.testing.assert_equal
use std.task.channel

# subject
fn edit_me(x: i32) -> i32: x * 3 + 1

tests:
    it("case 0"):
        assert_equal(edit_me(+0), +1)
    it("case 1"):
        assert_equal(edit_me(+1), +4)
