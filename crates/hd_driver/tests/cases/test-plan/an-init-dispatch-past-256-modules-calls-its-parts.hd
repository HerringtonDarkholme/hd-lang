# @dump: wat tests
# @build: tests
# @helpers: test_init
# A test program's init dispatch (`hd.test.init`) has an arm per module
# with tests; over more than 256 it splits into a tree as the case dispatch
# does (#2049). Each module's binding is set by its own init before its
# case: the last module's case, in the second part, reads its own value.
use std.testing.assert_equal

# subject
pub fn edit_me(x: i32) -> i32: x * 3 + 1

tests:
    it("main"):
        assert_equal(edit_me(+1), +4)
# @file: m1.hd
use pkg.main.edit_me

let base: i32 = edit_me(+1)

tests:
