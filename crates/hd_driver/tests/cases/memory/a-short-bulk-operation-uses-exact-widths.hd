# @dump: wat
# @build: std release
# Constant copies and fills up to 16 bytes become exact-width operations,
# and 17 to 31 bytes the first and last 16 as overlapping `i64` pairs, the
# dynamic helper's last class; 32 stays `memory.copy`. Dynamic lengths call
# one shared helper. Loads precede stores even when ranges overlap.
use std.rt.memory.{copy, fill}

fn copy_eight(to: usize, from: usize) -> void:
    copy(to, from, 8)

fn fill_four(to: usize) -> void:
    fill(to, 0xab, 4)

fn copy_fifteen(to: usize, from: usize) -> void:
    copy(to, from, 15)

fn copy_twenty_seven(to: usize, from: usize) -> void:
    copy(to, from, 27)

fn fill_seventeen(to: usize, byte: u8) -> void:
    fill(to, byte, 17)

fn copy_dynamic(to: usize, from: usize, count: usize) -> void:
    copy(to, from, count)

fn fill_dynamic(to: usize, byte: u8, count: usize) -> void:
    fill(to, byte, count)

fn copy_thirty_two(to: usize, from: usize) -> void:
    copy(to, from, 32)
