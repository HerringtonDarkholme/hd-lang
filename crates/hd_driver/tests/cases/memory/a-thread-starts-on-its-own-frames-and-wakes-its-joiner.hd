# @dump: wat
# @build: std release
# @helpers: thread_start
# @helper: std/rt.thread/spawn
# @helper: std/rt.thread/join
# `thread_spawn` stores the work's code and environment in the block and
# calls the host's `thread_spawn`. A thread's instance enters through
# `hd.thread`: it takes the block's frame region, runs the runtime modules'
# inits, calls the work, then stores the state word atomically and wakes
# every wait on it; a stopped instance only stores and wakes. `join` waits
# with `memory.atomic.wait32` while the word is 0.
use std.rt.thread.{join, spawn}

fn work() -> void:
    pass

fn run() -> bool:
    match spawn(work):
        .Some(thread) => join(thread)
        .None => false
