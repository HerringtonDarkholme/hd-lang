# @dump: stdout
# The rows answer use sites: a reference type is no `AnyVal`, a newtype
# over one is no `AnyVal` either, and a function type is not inspectable.
use std.meta.Inspectable

struct User:
    name: string

type Owner(*User)

fn keep[T < AnyVal](x: T) -> T: x

fn erase[T < Inspectable & 'static](x: T) -> *dyn Inspectable: box(x)

pub fn main() -> void:
    let u: *User = box(User { name: "ann" })
    _ := keep(u)
    _ := keep(Owner(u))
    _ := erase(fn() -> i32: 1)
