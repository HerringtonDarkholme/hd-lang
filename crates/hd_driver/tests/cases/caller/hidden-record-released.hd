# @dump: own
# expected: a `@track_caller` body that reads no call-site record takes none
# (fn.caller.site-argument), so it releases its one owned parameter at exit as the
# plain body does, and its call passes only the written argument; the caller
# releases nothing.
@track_caller
fn take(text: string) -> void:
    _ := text.len()

fn plain(text: string) -> void:
    _ := text.len()

pub fn main() -> void:
    take("a${1}")
    plain("b${1}")
