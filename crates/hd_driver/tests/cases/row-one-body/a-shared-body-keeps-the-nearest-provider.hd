# @dump: functions stdout
# req.with.nearest.row-parameter: a local provider in the shared body is
# nearer than the caller's for a key of the row argument, and a
# suspending row-polymorphic function is one instance too (`both`,
# `both_later`).
trait Tag:
    fn name(self) -> string

struct Named:
    label: string

impl Tag for Named:
    fn name(self) -> string: self.label

fn both[$R](callback: fn() -> string $ R) -> string $ R:
    first := callback()
    $.with(Tag=Named { label: "inner" }):
        first + " " + callback()

fn both_later![$R](callback: fn!() -> string $ R) -> string $ R:
    first := callback!()
    $.with(Tag=Named { label: "inner" }):
        first + " " + callback!()

fn read_tag() -> string $ Tag:
    $.use(Tag).name()

fn read_tag_later!() -> string $ Tag:
    $.use(Tag).name()

fn plain() -> string: "plain"

fn plain_later!() -> string: "plain"

fn later!() -> string $ Tag:
    both_later!(read_tag_later) + " " + both_later!(plain_later)

pub fn main!() -> void $ Console:
    $.with(Tag=Named { label: "outer" }):
        println(both(read_tag))
        println(both(plain))
        println(later!())
