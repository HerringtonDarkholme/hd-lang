# @dump: stdout wat
# @build: release | release checked
# @helper: std/collections.uniq_list/impl[T < Copy] UniqList[T].to_list
# @helper: std/collections.list/impl[T] List[T].map
# @helper: std/collections.list/impl[T] List[T].take
# @helper: std/collections.list/impl[T] List[T].reversed
# @helper: std/collections.list/impl[T] List[T].sorted_by
# @helper: std/collections.list/impl[T] List[T].chunks
# @helper: std/collections.list/impl[T] List[T].zip
# @helper: std/collections.list/impl[T] List[T].sorted_by_key
# @helper: std/collections.list/impl[T] List[T].windows
# @helper: std/collections.list/impl[T < Ord] List[T].sorted
# @helper: std/collections.map/impl[K < Eq & Hash, V] Map[K, V].keys
# @helper: std/collections.map/impl[K < Eq & Hash, V] Map[K, V].values
# @helper: std/collections.map/impl[K < Eq & Hash, V] Map[K, V] #2.entries
# @helper: std/collections.view/impl[T] ListView[T].to_list
# @helper: std/collections.uniq_list/finish_sorted_list
# Exact reservations preserve values, aliases, view snapshots and callback order.
use std.collections.UniqList
use std.meta.inline

@inline(.Never)
fn map_once(values: &List[i32], transform: fn(&i32) -> i32) -> List[i32]:
    # subject
    values.map(transform)

pub fn main() -> void $ Console:
    let mut values: List[i32] = [+3, +1, +2]
    snapshot := values
    let mut seen: List[i32] = []
    mapped := map_once(&values, fn(value: &i32) -> i32:
        seen.push(*value)
        value + 10
    )
    println("map ${debug(mapped)} visits ${debug(seen)}")
    println("take ${debug(values.take(0))} ${debug(values.take(2))} ${debug(values.take(10))}")
    println("reverse ${debug(values.reversed())}")
    println("sorted ${debug(values.sorted())}")
    println("compare ${debug(values.sorted_by(fn(a: &i32, b: &i32) -> Ordering: b.cmp(a)))}")
    let mut keys_seen: List[i32] = []
    keyed := values.sorted_by_key(fn(value: &i32) -> i32:
        keys_seen.push(*value)
        *value
    )
    println("keyed ${debug(keyed)} visits ${debug(keys_seen)}")
    println("zip ${debug(values.zip([+7, +8]))}")
    pieces := values.chunks(2)
    windows := values.windows(2)
    view := values.view(1, 3)
    values[0] = 9
    println("aliases ${debug(values)} ${debug(snapshot)}")
    println("chunks ${debug(pieces[0].to_list())} ${debug(pieces[1].to_list())}")
    println("windows ${debug(windows[0].to_list())} ${debug(windows[1].to_list())}")
    println("view ${debug(view.to_list())}")
    let mut unique = UniqList::[i32].with_capacity(3)
    for value in snapshot:
        unique.push(value)
    println("unique ${debug(unique.to_list())}")
    let table: Map[string, i32] = { "first": +4, "second": +5 }
    println("map keys ${debug(table.keys().collect::[List[string]]().sorted())}")
    println("map values ${debug(table.values().collect::[List[i32]]().sorted())}")
    println("map entries ${debug(table.entries().sorted())}")
    let empty: List[i32] = []
    println("empty ${debug(empty.map(fn(x: &i32) -> i32: *x))} ${debug(empty.reversed())}")
    println("empty views ${empty.chunks(2).len()} ${empty.windows(2).len()}")
    println("oversized ${snapshot.chunks(10).len()} ${snapshot.windows(10).len()}")
