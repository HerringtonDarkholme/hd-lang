# @dump: stdout
# @build: v8 release
# expected: 100 returns under 20 using bindings share one exit chain per target
# and registered count (`own::scopes`), as rustc's drop tree does. Measured: main
# 15,314 B dev / 12,980 B release; a copy per exit site 56,986 / 54,652; shared
# chains 15,181 / 12,847. Each way out disposes all 20, last in, first out.
use std.ops.Disposable

struct R:
    n: i32
    log: *mut List[i32]

impl Disposable for R:
    fn dispose(&mut self) -> void:
        self.log.push(self.n)

fn many(k: i32, log: *mut List[i32]) -> i32:
