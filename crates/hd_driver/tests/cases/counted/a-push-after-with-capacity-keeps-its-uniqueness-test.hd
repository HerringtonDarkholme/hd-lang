# @dump: own
# @build: v8 release
# expected: the push's `IsUnique` stays (#2369 gap): the block comes from
# `with_capacity`'s `alloc_counted`, a call whose result the own pass does
# not know to be fresh, so it is not `FRESH`. In a loop it is hoisted.
use std.collections.PlainList

fn build() -> PlainList[i64]:
    let mut xs = PlainList::[i64].with_capacity(4)
    xs.push(7)
    xs
