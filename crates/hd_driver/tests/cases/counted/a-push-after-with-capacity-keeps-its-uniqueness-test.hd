# @dump: own
# @build: v8 release
# expected: the push's `is_unique` test stays (#2369 gap): the fresh
# analysis sees whole locals only, and the block comes from calls
# (`alloc`, not yet inlined here, and the cold `grown`) whose results the
# own pass does not know to be fresh.
use std.collections.PlainList

fn build() -> PlainList[i64]:
    let mut xs = PlainList::[i64].with_capacity(4)
    xs.push(7)
    xs
