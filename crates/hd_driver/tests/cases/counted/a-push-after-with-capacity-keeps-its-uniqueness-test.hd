# @dump: own
# @build: v8 release
# expected: the push's `is_unique` test stays (#2369 step 1 gap, see
# target issue "counted-fold-through-fields"): the list is a struct
# whose `block` field is fresh, but `push` lends `&mut xs` to its cold
# `reserve_slow`, so the whole-local fresh analysis drops it.
use std.collections.PlainList

fn build() -> PlainList[i64]:
    let mut xs = PlainList::[i64].with_capacity(4)
    xs.push(7)
    xs
