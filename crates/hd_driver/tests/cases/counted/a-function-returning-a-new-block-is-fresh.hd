# @dump: own
# @build: v8 release std
# A function whose every result is a block it allocated and copied to no
# other holder says `fresh` in its summary (#2369): a caller's store of
# its result makes the holder unique, so a loop's next `is_unique` test
# of that holder reads a flag. `shared` keeps a copy of its new block in
# `keep`, so it is not fresh.
use std.rt.{alloc_counted, tail_of}
use std.meta.inline

struct Head:
    len: usize

impl !Copy for Head

@inline(.Never)
fn grown(old: *Head, need: usize) -> *Head:
    fresh := alloc_counted::[Head](Head { len: old.len }, need * 8, 8)
    _ := tail_of(fresh, 8)
    fresh

@inline(.Never)
fn shared(keep: &mut List[*Head], need: usize) -> *Head:
    fresh := alloc_counted::[Head](Head { len: 0 }, need * 8, 8)
    keep.push(fresh)
    fresh
