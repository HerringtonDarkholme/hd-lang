# @dump: own
# @build: std release
# `std.rt.is_unique` of a block this body allocated, or moved out of a
# local that holds one, is `true` (#2369, `own::hoist::fold_fresh_blocks`,
# `fresh_buffers`' `OWNED` level): `fresh` and `moved` run no count load.
# A copy is a second holder, so `copied` keeps its test.
use std.rt.{alloc_counted, is_unique, tail_of}

struct Head:
    len: usize

fn fresh() -> bool:
    block := alloc_counted::[Head](Head { len: 0 }, 16, 8)
    _ := tail_of(block, 8)
    is_unique(block)

fn moved() -> bool:
    block := alloc_counted::[Head](Head { len: 0 }, 0, 8)
    other := block
    is_unique(other)

fn copied() -> bool:
    block := alloc_counted::[Head](Head { len: 0 }, 0, 8)
    other := block
    is_unique(block) && is_unique(other)
