# @dump: stdout
# @build: dev | checked | release | release checked
# A parameter over 16 values read whole keeps its address (#2170): the
# read passes the address on to a worker, or is copied with one
# memory.copy into a result block, or loads its leaves where a leaf
# value is needed. A whole move of a counted one sets its dead flag, so
# its exit releases nothing. Each neighbour: a generic `keep` returning
# its parameter; an early `return` of it; a tuple of it twice; a list
# literal of it; a closure that captures it (stays leaves) and one that
# reads it whole; a loop passing it each round; a counted one copied
# twice to an owning callee, moved whole as the result, moved on one
# branch only, stored whole in a list, and kept generically. The
# checked builds find no leak at exit.
use std.annotation.inline

struct Big:
    f0: i32
    f1: i32
    f2: i32
    f3: i32
    f4: i32
    f5: i32
    f6: i32
    f7: i32
    f8: i32
    f9: i32
    f10: i32
    f11: i32
    f12: i32
    f13: i32
    f14: i32
    f15: i32
    f16: i32

struct Named:
    big: Big
    name: string
    xs: List[i32]

fn whole_cap(b: Big) -> i32:
    let f: fn(i32) -> i32 = fn(y) -> i32:
        sum(b) + y
    f(1)

fn mk(x: i32) -> Big: Big { f0: x, f1: x + 1, f2: x + 2, f3: x + 3, f4: x + 4, f5: x + 5, f6: x + 6, f7: x + 7, f8: x + 8, f9: x + 9, f10: x + 10, f11: x + 11, f12: x + 12, f13: x + 13, f14: x + 14, f15: x + 15, f16: x + 16 }

fn named(x: i32) -> Named: Named { big: mk(x), name: "n${x}", xs: [x, x] }

@inline(.Never)
fn keep[T](x: T) -> T: x

@inline(.Never)
fn sum(b: Big) -> i32: b.f0 + b.f16

@inline(.Never)
fn early(b: Big, stop: bool) -> Big:
    if stop:
        return b
    mk(b.f1)

@inline(.Never)
fn twice(b: Big) -> (Big, Big): (b, b)

fn in_list(b: Big) -> List[Big]: [b]

fn closure(b: Big) -> i32:
    let f: fn(i32) -> i32 = fn(y) -> i32:
        b.f3 + y
    f(1)

fn looped(b: Big, n: i32) -> i32:
    let mut t = 0
    for _ in 0..n:
        t = t + sum(b)
    t

@inline(.Never)
fn take(n: Named) -> i32: i32(n.name.len()) + i32(n.xs.len())

fn copy_twice(n: Named) -> i32: take(n) + take(n)

@inline(.Never)
fn move_whole(n: Named) -> Named: n

fn move_maybe(n: Named, go: bool) -> i32:
    if go:
        return take(n)
    n.big.f2

fn store_whole(n: Named) -> List[Named]: [n]

pub fn main() -> void $ Console:
    println("${sum(keep(mk(1)))} ${keep(mk(2)).f16} ${sum(early(mk(3), true))} ${sum(early(mk(3), false))}")
    let (a, b) = twice(mk(4))
    println("${sum(a) + sum(b)} ${in_list(mk(5))[0].f9} ${closure(mk(6))} ${looped(mk(7), 3)} ${whole_cap(mk(1))}")
    let n = named(8)
    println("${copy_twice(n)} ${n.name} ${move_whole(named(9)).name} ${move_maybe(named(10), true)} ${move_maybe(named(11), false)}")
    println("${store_whole(named(12))[0].xs.len()} ${keep(named(13)).xs[1]}")
