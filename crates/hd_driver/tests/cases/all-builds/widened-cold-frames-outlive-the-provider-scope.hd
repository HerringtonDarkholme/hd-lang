# @dump: stdout wat counts
# @build: dev | checked | release | release checked
# expected: 40 then 60; projected providers survive ended scopes and unpolled drops.
use std.task.block_on
use std.time.{Clock, ms, sleep}

trait Base:
    fn base(&self) -> i32

trait Named < Base:
    fn name(&self) -> i32

struct Source:
    n: i32

impl Base for Source:
    fn base(&self) -> i32:
        self.n * 10

impl Named for Source:
    fn name(&self) -> i32:
        self.n

fn read!() -> i32 $ Base + Clock:
    sleep!(ms(1))
    $.use(Base).base()

# subject
fn construct() -> Suspend[i32] $ Named + Clock:
    read()

fn report(job: Suspend[i32]) -> void $ Console:
    match block_on(job):
        .Completed(value) => println(value)
        .Cancelled => println("cancelled")
        .Abandoned => println("abandoned")

pub fn main() -> void $ Console + Clock:
    let adapted: fn!() -> i32 $ Named + Clock = read
    let direct: Suspend[i32] = $.with(Named=box(Source { n: 4 })):
        construct()
    let converted: Suspend[i32] = $.with(Named=box(Source { n: 6 })):
        adapted()
    let unpolled: Suspend[i32] = $.with(Named=box(Source { n: 8 })):
        adapted()
    report(direct)
    report(converted)
    _ := unpolled
