# @dump: own
# @build: v8 release
# Release summaries, recursion: a strongly connected component reaches a
# fixed point. `walk` only reads `c` and passes it on to itself, and
# `ping` and `pong` pass `c` to each other and to `depth`, which only
# reads it, so every member borrows `c` and its calls take no count.
struct Config:
    name: string
    depth: i64

fn walk(c: Config, n: i64) -> i64:
    if n == 0:
        return c.depth
    walk(c, n - 1) + 1

fn ping(c: Config, n: i64) -> i64:
    if n == 0:
        return depth(c)
    pong(c, n - 1)

fn pong(c: Config, n: i64) -> i64:
    ping(c, n)

fn depth(c: Config) -> i64:
    c.depth
