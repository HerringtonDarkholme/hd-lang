# @dump: own
# @build: v8 release
# Release summaries, generics: a parameter whose type names a type
# parameter is kept when the body keeps it, as a closed one is: `pick`
# returns `x` unchanged on every path. `m` is only read, so it may be lent.
struct Member:
    name: string

fn pick[T](x: T, m: Member) -> T:
    if m.name == "":
        return x
    x
