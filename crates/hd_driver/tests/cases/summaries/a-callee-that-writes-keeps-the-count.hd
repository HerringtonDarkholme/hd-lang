# @dump: own counts
# @build: v8 release
# Release writes, the controls: `prune` clears the parent's field,
# `prune_global` stores through the top-level alias `ROOT`, and `ping`
# calls `pong`, which writes, in one component. The child each caller
# holds keeps its count across the call. `prune_global` calls `zero`,
# which is recursive and so stays a call, and the others take a
# reference, so a release build copies none of them into its caller.
struct Node:
    left: (*Node)?
    value: i64

ROOT := &mut Node { left: .None, value: 0 }

fn prune(parent: *mut Node) -> i64:
    parent.left = .None
    0

fn prune_global() -> i64:
    ROOT.left = .None
    zero(0)

fn zero(k: i64) -> i64:
    if k > 0: zero(k - 1) else: 0

fn ping(node: *mut Node, k: i64) -> i64:
    if k == 0:
        return 0
    pong(node, k - 1)

fn pong(node: *mut Node, k: i64) -> i64:
    node.value = k
    ping(node, k)

fn through_parent(node: *mut Node) -> i64:
    match node.left:
        .None => 0
        .Some(left) => prune(node) + left.value

fn through_alias(node: &Node) -> i64:
    match node.left:
        .None => 0
        .Some(left) => prune_global() + left.value

fn through_a_cycle(node: *mut Node) -> i64:
    match node.left:
        .None => 0
        .Some(left) => ping(node, 3) + left.value
