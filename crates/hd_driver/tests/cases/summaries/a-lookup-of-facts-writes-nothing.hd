# @dump: own counts
# @build: v8 release
# Release summaries, intrinsics: `Facts.find` downcasts each fact and
# `member_name` changes case in byte loops, and neither writes what its
# caller reaches (`has_style` has no `writes`), so `name_of` reads
# `frames[0].facts` in place for the call, with no copy (#904).
use std.structure.{Facts, Member}
use std.serde.{RenameAll, member_name}

struct Frame:
    facts: Facts
    n: usize

fn has_style(facts: Facts) -> bool:
    facts.find::[RenameAll]().is_some()

fn name_of(m: &Member, frames: &List[Frame]) -> string:
    member_name(m, frames[0].facts)
