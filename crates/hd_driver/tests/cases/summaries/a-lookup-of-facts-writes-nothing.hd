# @dump: own counts
# @build: v8 release
# Release summaries: `Facts.find` and `member_name` write nothing their
# callers reach. `member_name` can reach ordinary-hd `concat_all`, but its
# raw-address copy writes only its own new string, so both callers borrow
# their facts and have no `writes` summary (#1285).
use std.structure.{Facts, Member}
use std.serde.{RenameAll, member_name}

struct Frame:
    facts: Facts
    n: usize

fn has_style(facts: Facts) -> bool:
    facts.find::[RenameAll]().is_some()

fn name_of(m: &Member, frames: &List[Frame]) -> string:
    member_name(m, frames[0].facts)
