# @dump: stdout
# @build: dev | release
# A counter below a length read before an outer loop: the outer loop
# pops the list after the inner loop, so the second inner loop reads past
# the end and panics (`expr.index.list.range`). The rising-counter proof
# walks the outer loop's statements as well as the inner loop's own body.
fn total(xs: &mut List[i64]) -> i64:
    n := xs.len()
    let s = 0i64
    for k in 0..3usize:
        for i in 0..n:
            s = s + xs[i]
        let _ = xs.pop()
    s

pub fn main() -> void $ Console:
    let mut xs = [1i64, 2, 3, 4]
    println(total(&mut xs))
