# @dump: stdout
# @build: dev | release
# A counter below a length read before an outer loop: the outer loop
# replaces the local list with a shorter one after the inner loop, so the
# second inner loop reads past the end and panics
# (`expr.index.list.range`). The rising-counter proof walks the outer
# loop's statements as well as the inner loop's own body.
fn total() -> i64:
    let mut xs = [1i64, 2, 3, 4]
    let s = 0i64
    n := xs.len()
    for k in 0..2usize:
        for i in 0..n:
            s = s + xs[i]
        xs = [7i64]
    s

pub fn main() -> void $ Console:
    println(total())
