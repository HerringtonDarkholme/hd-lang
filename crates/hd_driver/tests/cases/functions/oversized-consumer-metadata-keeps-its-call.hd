# @dump: stdout
# @build: release checked
# expected: an oversized consumer string table keeps its call and callback result.
use std.testing.assert_equal

fn consume(callback: fn(usize) -> usize, seed: usize) -> usize:
    text := ""
    callback(seed) + text.len()

pub fn main() -> void:
    assert_equal(consume(fn(value: usize) -> usize: value + 1, 7), 4208)
