# @dump: own wat
# @build: v8 release
# The concrete integer hash chain is inline, with no call and no byte loop:
# one four-byte word enters the sponge, and `finish` folds it.
# expected: the branches on the constant width 32 and the empty sponge stay;
# release does not fold a branch whose condition is constant after inlining.
use std.hash.hash_of

fn digest(value: usize) -> u64:
    hash_of(value)
