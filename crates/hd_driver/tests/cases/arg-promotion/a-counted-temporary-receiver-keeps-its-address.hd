# @dump: wat
# @build: v8 release
# Release (§23.40, #1151): `make(n).size()` lends the temporary through a
# counted reference, which holds the temporary's cell, so the passes drop
# the local before the call. A loan of the value read there would be
# released before `size` reads it, so a counted referent is lent with no
# count only from a frame local (`ref_word::FRAME`): `total` calls the
# plain `size` with the cell. `named` lends `w` from its frame, so it
# passes the string's two words to the promoted copy.
struct Wrap:
    name: string

fn make(n: i32) -> Wrap:
    Wrap { name: "x${n}" }

impl Wrap:
    fn size(&self) -> usize:
        (self.name.len() + 1) * (self.name.len() + 2) * (self.name.len() + 3) / (self.name.len() + 4)

fn total(n: i32) -> usize:
    make(n).size()

fn named(n: i32) -> usize:
    let w = make(n)
    w.size()
