# @dump: tests
# @build: dev | release | release checked
# expected: arithmetic preserves each IEEE width, signed zero, infinities and NaN behavior.
use std.num.Integer
use std.testing.{assert, assert_equal}

tests:
    it("f32 rounds each operation"):
        value := (16777216.0f32 + 1.0f32) - 16777216.0f32
        assert_equal(value, 0.0f32)
        assert_equal((1.5f32 * 2.0f32 + 0.25f32) / 0.5f32 - 1.0f32, 5.5f32)

    it("f64 arithmetic and signed zeros"):
        assert_equal((1.5 * 2.0 + 0.25) / 0.5 - 1.0, 5.5)
        assert_equal((-0.0 * 2.0).to_bits(), 9223372036854775808u64)
        assert_equal((-0.0f32 * 2.0f32).to_bits(), 2147483648u32)

    it("infinities and NaNs keep their behavior"):
        assert(!(1.0 / 0.0).is_finite())
        assert((0.0 / 0.0).is_nan())
        assert((0.0f32 / 0.0f32).is_nan())

    it("subnormal arithmetic rounds to zero"):
        assert_equal((f64::from_bits(1) * 0.5).to_bits(), 0u64)
        assert_equal((f32::from_bits(1) * 0.5f32).to_bits(), 0u32)
