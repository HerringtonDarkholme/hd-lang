-- case: a scalar subject excludes the context function's counts --
fn add(left: i32, right: i32) -> i32:
    # subject
    left + right
-- counts --
no count operations
-- case: a marked copy excludes another copy in the same body --
fn copies(value: string) -> ((string, string), (string, string)):
    first := (value, value)
    # subject
    second := (value, value)
    (first, second)
-- counts --
app/main/copies
  retain string
  release (string, string) [0.0, 1.0]
  release string
  release string
  release (string, string) [0.0, 1.0]
  release (string, string) [0.0, 1.0]
