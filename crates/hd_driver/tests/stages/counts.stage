# Only surviving count/free operations inside the subject; source type labels.
-- context --
struct Text:
    value: string

fn context_copy(value: string) -> (string, string):
    (value, value)
-- case: unused owned parameter cleanup --
# subject
fn first(left: string, _right: string) -> string:
    left
-- counts --
app/main/first
  release string
  release string
  release string
-- case: returning two copies retains the shared string --
fn twice(value: string) -> (string, string):
    # subject
    (value, value)
-- counts --
app/main/twice
  retain string
  release string
  release string
  release (string, string) [0.0, 1.0]
  release string
-- case: assignment in a loop releases the previous string --
fn last(items: List[string]) -> string:
    let result = ""
    for value in items:
        # subject
        result = value
    result
-- counts --
app/main/last
  retain string
  release string
-- case: overwriting a counted struct field --
fn replace(value: Text, next: string) -> Text:
    let mut copy = value
    # subject
    copy.value = next
    copy
-- counts --
app/main/replace
  retain app.main.Text [value.0]
  release app.main.Text [value.0]
  retain app.main.Text [value.0]
  release app.main.Text [value.0]
  release app.main.Text [value.0]
  release app.main.Text [value.0]
  release string
  release app.main.Text [value.0]
  release app.main.Text [value.0]
-- case: replacing a list element --
fn replace(items: &mut List[string], next: string) -> void:
    # subject
    items[0] = next
-- counts --
app/main/replace
  release string
  release string
  release string
-- case: returning a counted struct --
fn twice(value: Text) -> (Text, Text):
    # subject
    (value, value)
