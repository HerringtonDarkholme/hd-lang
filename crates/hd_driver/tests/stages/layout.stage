# Actual inline memory layouts; counted offsets are bytes from the value's base.
# A ? after a counted offset means that only some variants hold that address.
-- context --
struct Point:
    x: i32
    y: i64
-- case: scalar alignment and trailing padding --
# subject
struct Aligned:
    small: u8
    total: i64
    tail: u16
-- layout --
app.main.Aligned size=24 align=8 cycle-capable=false
  counted: none
  small: u8 offset=0 size=1 align=1 counted=none
  total: i64 offset=8 size=8 align=8 counted=none
  tail: u16 offset=16 size=2 align=2 counted=none
-- case: nested fields use absolute offsets --
# subject
struct Nested:
    enabled: bool
    point: Point
    count: u32
-- layout --
app.main.Nested size=32 align=8 cycle-capable=false
  counted: none
  enabled: bool offset=0 size=1 align=1 counted=none
  point: app.main.Point offset=8 size=16 align=8 counted=none
  point.x: i32 offset=8 size=4 align=4 counted=none
  point.y: i64 offset=16 size=8 align=8 counted=none
  count: u32 offset=24 size=4 align=4 counted=none
-- case: list and string fields expose their counted leaves --
# subject
struct CollectionFields:
    items: List[i32]
    label: string
-- layout --
app.main.CollectionFields size=12 align=4 cycle-capable=false
  counted: 0, 4
  items: List[i32] offset=0 size=4 align=4 counted=0
  label: string offset=4 size=8 align=4 counted=4
-- case: references make a stored value cycle capable --
# subject
struct ReferenceField:
    target: &mut i32
-- layout --
app.main.ReferenceField size=4 align=4 cycle-capable=true
  counted: 0
  target: &mut i32 offset=0 size=4 align=4 counted=0
-- case: reference elements make a list cycle capable --
# subject
struct ReferenceList:
    items: List[&mut i32]
-- layout --
app.main.ReferenceList size=4 align=4 cycle-capable=true
  counted: 0
  items: List[&mut i32] offset=0 size=4 align=4 counted=0
-- case: optional counted leaves are conditional --
# subject
struct MaybeText:
    value: string?
-- layout --
app.main.MaybeText size=12 align=4 cycle-capable=false
  counted: 4?
  value: string? offset=0 size=12 align=4 counted=4?
-- case: an empty struct has no counted fields --
# subject
struct Empty: pass
-- layout --
app.main.Empty size=0 align=1 cycle-capable=false
  counted: none
-- case: a leaf counted by every variant is unconditional --
enum Either:
    First(text: string)
    Second(text: string)
# subject
struct AlwaysText:
    value: Either
-- layout --
app.main.AlwaysText size=12 align=4 cycle-capable=false
  counted: 4
  value: app.main.Either offset=0 size=12 align=4 counted=4
