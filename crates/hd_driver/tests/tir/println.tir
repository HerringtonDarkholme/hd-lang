std/console/println (Fn)
  local $0 value: T [param read]
  local $1 console: Ref[mut Console] [read assigned]
  local $2 call: mut Suspend[Result[(), ConsoleError]] [read assigned]
  %0 = ProviderGet #0 : Console
  %1 = Coerce %0 [ProviderAsRef -] : Ref[mut Console]
  %2 = Store [$1] %1 : ()
  %3 = Read [*$1] : mut Console
  %4 = Read [$0] : T
  %5 = Call std/format/Display.to_string for T [] via Bound (%4) : string
  %6 = Interp [%5 "\n"] : string
  %7 = Call std/console/Console.write for Console [] via TraitValue (%3, %6) : mut Suspend[Result[(), ConsoleError]]
  %8 = Store [$2] %7 : ()
  %9 = Read [$2] : mut Suspend[Result[(), ConsoleError]]
  %10 = Call std/task/block_on[Result[(), ConsoleError]] (%9) : BlockOn[Result[(), ConsoleError]]
  %11 = Block - : ()
  %12 = Call std/core/panic[] ("println: write! returned .Err(ConsoleError)") : never
  %13 = Block - : never
  %14 = Block - : ()
  %15 = Block - : ()
  %16 = Read [%10 as #0 .0] : Result[(), ConsoleError]
  %17 = ToArm #0 : never
  %18 = Block - : never
  %19 = ToArm #1 : never
