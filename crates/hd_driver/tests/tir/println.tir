std/console/println (Fn)
  local $0 value: T [param read]
  local $1 console: Ref[mut Console] [read assigned]
  %0 = ProviderGet #0 : Console
  %1 = Coerce %0 [ProviderAsRef -] : Ref[mut Console]
  %2 = Store [$1] %1 : ()
  %3 = Read [$1] : Ref[mut Console]
  %4 = Read [$0] : T
  %5 = Call std/format/Display.to_string for T [] via Bound (%4) : string
  %6 = Call std/console/println_write[] (%3, %5) : bool
  %7 = Read [$1] : Ref[mut Console]
  %8 = Call std/console/println_write[] (%7, "\n") : bool
  %9 = Block - : ()
  %10 = If %6 [%9 -] : ()
  %11 = Block - : ()
