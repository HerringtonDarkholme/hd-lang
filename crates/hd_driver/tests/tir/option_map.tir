std/option/impl[T < ?Copy] T?.map (Fn)
  local $0 self: T? [param read]
  local $1 transform: F [param read]
  local $2 value: T [read assigned]
  %0 = Read [$0] : T?
  %1 = Read [$1] : F
  %2 = Read [$2] : T
  %3 = CallValue %1 [%2] : U
  %4 = NewVariant #1 [%3] : U?
  %5 = Block %4 : U?
  %6 = NewVariant #0 [] : U?
  %7 = Block %6 : U?
  %8 = Read [%0 as #1 .0] : T
  %9 = Store [$2] %8 : ()
  %10 = ToArm #0 : never
  %11 = Block - : never
  %12 = ToArm #1 : never
  %13 = Block - : never
  %14 = SwitchTag %0 [#1 %11 %13] : never
  %15 = Block - : never
  %16 = Match %0 [%15 %5 %7] : U?
  %17 = Block %16 : U?
