  %5 = Block [%1 %2 %3 %4] %4 : map#0?
  %6 = NewVariant #0 [] : map#0?
  %7 = Block [%6] %6 : map#0?
  %8 = Unwrap %0 : impl [ T ] T ?#0
  %9 = LocalSet $2 %8 : ()
  %10 = ToArm #0 : never
  %11 = Block [%8 %9 %10] - : never
  %12 = ToArm #1 : never
  %13 = Block [%12] - : never
  %14 = Unreachable  : never
  %15 = Block [%14] - : never
