std/option/impl [ T ] T ?.map (Fn)
  local $0 self: T? [param read]
  local $1 transform: fn(T) -> U [param read]
  local $2 value: T [read assigned]
  %0 = Read [$0] : T?
  %1 = Read [$1] : fn(T) -> U
  %2 = Read [$2] : T
  %3 = CallValue %1 [%2] : U
  %4 = NewVariant #1 [%3] : U?
  %5 = Block %4 : U?
  %6 = NewVariant #0 [] : U?
  %7 = Block %6 : U?
  %8 = Read [%0 as #1 .0] : T
  %9 = Store [$2] %8 : ()
  %10 = ToArm #0 : never
  %11 = Block - : never
  %12 = ToArm #1 : never
  %13 = Block - : never
  %14 = Unreachable  : never
  %15 = Block - : never
  %16 = SwitchTag %0 [#0 %13 %15] : never
  %17 = Block - : never
  %18 = SwitchTag %0 [#1 %11 %17] : never
  %19 = Block - : never
  %20 = Match %0 [%19 %5 %7] : U?
  %21 = Block %20 : U?
