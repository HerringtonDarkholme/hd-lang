  local $1 transform: fn(impl [ T ] T ?#0) -> map#0 flags=33
  local $2 value: impl [ T ] T ?#0 flags=3
  %0 = LocalGet $0 : impl [ T ] T ?#0?
  %1 = LocalGet $1 : fn(impl [ T ] T ?#0) -> map#0
  %2 = LocalGet $2 : impl [ T ] T ?#0
  %3 = CallValue %1 [%2] : map#0
