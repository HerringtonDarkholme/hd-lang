std/text/simple_escape (Fn)
  local $0 escaped: u8 [param read]
  %0 = Read [$0] : u8
  %1 = NewVariant #1 ["\\"] : string?
  %2 = Block %1 : string?
  %3 = NewVariant #1 ["\""] : string?
  %4 = Block %3 : string?
  %5 = NewVariant #1 ["'"] : string?
  %6 = Block %5 : string?
  %7 = NewVariant #1 ["\n"] : string?
  %8 = Block %7 : string?
  %9 = NewVariant #1 ["\r"] : string?
  %10 = Block %9 : string?
  %11 = NewVariant #1 ["\t"] : string?
  %12 = Block %11 : string?
  %13 = NewVariant #1 ["\0"] : string?
  %14 = Block %13 : string?
  %15 = NewVariant #1 ["$"] : string?
  %16 = Block %15 : string?
  %17 = NewVariant #0 [] : string?
  %18 = Block %17 : string?
  %19 = Prim Eq [%0 92:u8] : bool
  %20 = ToArm #0 : never
  %21 = Block - : never
  %22 = Prim Eq [%0 34:u8] : bool
  %23 = ToArm #1 : never
  %24 = Block - : never
  %25 = Prim Eq [%0 39:u8] : bool
  %26 = ToArm #2 : never
  %27 = Block - : never
  %28 = Prim Eq [%0 110:u8] : bool
  %29 = ToArm #3 : never
  %30 = Block - : never
  %31 = Prim Eq [%0 114:u8] : bool
  %32 = ToArm #4 : never
  %33 = Block - : never
  %34 = Prim Eq [%0 116:u8] : bool
  %35 = ToArm #5 : never
  %36 = Block - : never
  %37 = Prim Eq [%0 48:u8] : bool
  %38 = ToArm #6 : never
  %39 = Block - : never
  %40 = Prim Eq [%0 36:u8] : bool
  %41 = ToArm #7 : never
  %42 = Block - : never
  %43 = ToArm #8 : never
  %44 = Block - : never
  %45 = If %40 [%42 %44] : never
  %46 = Block - : never
  %47 = If %37 [%39 %46] : never
  %48 = Block - : never
  %49 = If %34 [%36 %48] : never
  %50 = Block - : never
  %51 = If %31 [%33 %50] : never
  %52 = Block - : never
  %53 = If %28 [%30 %52] : never
  %54 = Block - : never
  %55 = If %25 [%27 %54] : never
  %56 = Block - : never
  %57 = If %22 [%24 %56] : never
  %58 = Block - : never
  %59 = If %19 [%21 %58] : never
  %60 = Block - : never
  %61 = Match %0 [%60 %2 %4 %6 %8 %10 %12 %14 %16 %18] : string?
  %62 = Block %61 : string?
