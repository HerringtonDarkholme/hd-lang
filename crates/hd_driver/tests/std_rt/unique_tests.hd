# The hd tests of `unique_mut` (spec 10 `module.rt.unique`): a box with a
# second counted reference reads as shared. Only std may use a runtime
# module, so the conformance runner adds this file to std as
# `std.rt_tests.unique_tests`.
use std.rt.memory.unique_mut

struct Count:
    n: i64

# Writes `v` through `r` when its box is unshared.
fn write_unique(r: &mut *Count, v: i64) -> bool:
    match unique_mut(r):
        .Some(c) =>
            c.n = v
            true
        .None => false

tests:
    use std.testing.{assert, it}

    it("a second counted reference makes a box read as shared"):
        let mut p: *Count = box(Count { n: 1 })
        assert(write_unique(&mut p, 2), "an unshared box is lent")
        other := p
        assert(!write_unique(&mut p, 3), "a box with two counted references is shared")
        assert(p.n == 2 && other.n == 2, "the shared box is unchanged")
