# The hd tests of std.rt.memory (spec/lang/10-modules.md#memory-intrinsics).
# Only std may use a runtime module, so the conformance runner adds this
# file to std as `std.rt_tests.memory_tests` and runs its cases on the linear
# backend (crates/hd_driver/tests/conformance.rs, `STD_RT_TESTS`). Each case
# runs in an instance of its own, so each starts with a fresh heap.
use std.testing.assert
use std.format.Display
use std.rt.bytes.{unsigned_width, signed_width, write_unsigned_sized, write_signed_sized, bytes_at}
use std.rt.memory.{
    Buffer,
    copy,
    copy_bytes,
    fill,
    grow,
    load_u8,
    load_u16,
    load_u32,
    load_u64,
    pages,
    store_u8,
    store_u16,
    store_u32,
    store_u64,
}

# Sentinel bytes catch a fixed-width padding store or a digit past the room.
fn exact_unsigned(value: u64) -> void:
    room := Buffer::[u8].new(32)
    fill(room.at(0).address, 0xa5, 32)
    width := unsigned_width(value)
    write_unsigned_sized(value, room.at(1), width)
    expected := value.to_string()
    assert(width == expected.len(), "the width is exact")
    for i in 0..32:
        byte := load_u8(room.at(i).address)
        if i >= 1 && i <= width:
            assert(byte == bytes_at(expected, i - 1), "each digit matches Display")
        else:
            assert(byte == 0xa5, "the writer stays inside its measured room")

fn exact_signed(value: i64) -> void:
    room := Buffer::[u8].new(32)
    fill(room.at(0).address, 0xa5, 32)
    width := signed_width(value)
    write_signed_sized(value, room.at(1), width)
    expected := value.to_string()
    assert(width == expected.len(), "the signed width is exact")
    for i in 0..32:
        byte := load_u8(room.at(i).address)
        if i >= 1 && i <= width:
            assert(byte == bytes_at(expected, i - 1), "sign and digits match Display")
        else:
            assert(byte == 0xa5, "the signed writer stays inside its room")

# The address of a page this case grows the heap by, which no other part of
# the program uses (module.rt.memory.grow.owner).
fn fresh_page() -> usize:
    match grow(1):
        .Some(before) => before * 65536
        .None => panic("the heap cannot grow by one page")

# Check the whole surrounding region, so partial widths, overlap and
# unaligned transfers cannot hide an overread or an extra written byte.
fn check_byte_copy(at: usize, from: usize, to: usize, count: usize) -> void:
    fill(at, 0xa5, 1024)
    for i in 0..512:
        store_u8(at + i, u8(i % 251))
    copy_bytes(at + to, at + from, count)
    for i in 0..1024:
        expected := if i >= to && i - to < count:
            u8((from + i - to) % 251)
        else if i < 512:
            u8(i % 251)
        else:
            u8(0xa5)
        if load_u8(at + i) != expected:
            panic("copy changed a byte outside the snapshot result")

tests:
    use std.testing.{assert, it}

    it("grow adds pages and gives the size before them"):
        before := pages()
        grown := grow(2)
        after := pages()
        unchanged := grow(0)
        after_zero := pages()
        # Comparisons may allocate payload views, so measure before asserting.
        assert(before > 0, "the heap starts with a page")
        assert(grown == .Some(before), "grow gives the size before")
        assert(after == before + 2, "the heap is 2 pages larger")
        assert(unchanged == .Some(after), "grow(0) gives the size")
        assert(after_zero == after, "grow(0) adds nothing")

    it("a grow past the largest heap is refused and changes nothing"):
        before := pages()
        refused := grow(65536)
        after := pages()
        assert(refused == .None, "no heap holds 65,537 pages")
        assert(after == before, "a refused grow keeps the size")

    it("grown pages read as zero"):
        at := fresh_page()
        assert(load_u64(at) == 0, "the first bytes are 0")
        assert(load_u8(at + 65535) == 0, "the last byte is 0")

    it("each width stores and loads its bytes, least significant first"):
        at := fresh_page()
        store_u32(at, 0x04030201)
        assert(load_u8(at) == 0x01, "the low byte comes first")
        assert(load_u8(at + 3) == 0x04, "the high byte comes last")
        assert(load_u16(at + 1) == 0x0302, "a u16 inside a u32")
        assert(load_u32(at) == 0x04030201, "the u32 reads back")
        store_u64(at + 8, 0x0807060504030201)
        assert(load_u32(at + 12) == 0x08070605, "the high half of a u64")
        assert(load_u64(at + 8) == 0x0807060504030201, "the u64 reads back")
        store_u16(at + 5, 0xbeef)
        assert(load_u8(at + 5) == 0xef, "the low byte of a u16")
        assert(load_u8(at + 6) == 0xbe, "the high byte of a u16")
        store_u8(at + 7, 0xff)
        assert(load_u64(at) == 0xffbeef0004030201, "the 8 bytes together")

    it("the largest value of each width reads back whole"):
        at := fresh_page()
        store_u64(at, 18446744073709551615)
        assert(load_u64(at) == 18446744073709551615, "the largest u64")
        store_u32(at, 4294967295)
        assert(load_u32(at) == 4294967295, "the largest u32")
        assert(load_u64(at) == 18446744073709551615, "every bit stays set")

    it("an address need not be aligned"):
        at := fresh_page()
        store_u64(at + 3, 0x1122334455667788)
        assert(load_u64(at + 3) == 0x1122334455667788, "an unaligned u64")
        assert(load_u32(at + 5) == 0x33445566, "an unaligned u32")

    it("fill sets each byte of its range and no other"):
        at := fresh_page()
        fill(at + 1, 0xab, 6)
        assert(load_u8(at) == 0, "the byte before is untouched")
        assert(load_u8(at + 1) == 0xab, "the first byte is set")
        assert(load_u8(at + 6) == 0xab, "the last byte is set")
        assert(load_u8(at + 7) == 0, "the byte after is untouched")
        fill(at, 0x11, 0)
        assert(load_u8(at) == 0, "a fill of 0 bytes sets none")

    it("copy moves bytes between ranges that overlap, in either direction"):
        at := fresh_page()
        store_u64(at, 0x0807060504030201)
        copy(at + 2, at, 4)
        assert(load_u64(at) == 0x0807040302010201, "a copy to a later address")
        store_u64(at, 0x0807060504030201)
        copy(at, at + 2, 4)
        assert(load_u64(at) == 0x0807060506050403, "a copy to an earlier address")

    it("a string the runtime allocates leaves a grown page alone"):
        at := fresh_page()
        fill(at, 0x5a, 65536)
        let text = "ab"
        let count: usize = 0
        while count < 17:
            text = "${text}${text}"
            count = count + 1
        assert(load_u8(at) == 0x5a, "the page's first byte is kept")
        assert(load_u8(at + 65535) == 0x5a, "the page's last byte is kept")
        assert(text != "ab", "the text grew")

    it("short copies preserve every byte at every alignment and overlap"):
        at := fresh_page()
        for count in 0..65:
            for from in 32..40:
                for to in 24..48:
                    check_byte_copy(at, from, to, count)

    it("bulk and disjoint copies preserve the snapshot and surrounding bytes"):
        at := fresh_page()
        for count in [0, 1, 2, 3, 4, 7, 8, 9, 15, 16, 31, 32, 63, 64, 127, 256]:
            check_byte_copy(at, 7, 600, count)
            check_byte_copy(at, 7, 19, count)
            check_byte_copy(at, 19, 7, count)
        # A short copy right at the heap end must not read a wider word.
        end := pages() * 65536
        store_u64(at + 7, 0x0807060504030201)
        for count in [1, 2, 4, 8]:
            copy_bytes(end - count, at + 7, count)
            for i in 0..count:
                assert(load_u8(end - count + i) == u8(i + 1), "exact width")
            copy_bytes(at + 600, end - count, count)
            for i in 0..count:
                assert(load_u8(at + 600 + i) == u8(i + 1), "exact read width")

    it("measured integer writers cover every decimal boundary without padding stores"):
        exact_unsigned(0)
        let boundary = 1u64
        for digits in 1..21:
            exact_unsigned(boundary - 1)
            exact_unsigned(boundary)
            exact_unsigned(boundary + 1)
            if digits < 20:
                boundary *= 10
        exact_unsigned(18446744073709551615u64)
        exact_signed(-9223372036854775808i64)
        exact_signed(9223372036854775807i64)
        exact_signed(-1)
        exact_signed(0)
