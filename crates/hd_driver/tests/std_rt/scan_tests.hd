# The hd tests of std's byte scans (#428,
# docs/future-work/PERFORMANCE_ROADMAP.md §3.9): the compiler supplies a
# SIMD128 body for each scan primitive, and that body must give what the
# primitive's hd reference body gives. Only std may declare a primitive,
# so the conformance runner adds this file to std as
# `std.rt.scan_tests` (crates/hd_driver/tests/conformance.rs,
# `STD_RT_TESTS`).
use std.format.debug
use std.testing.Choices
use std.text.Utf8Error

@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

@intrinsic("bytes_slice")
fn bytes_slice(text: string, start: usize, end: usize) -> string:
    panic("intrinsic")

# Raw bytes, which here are not always UTF-8: a scan reads bytes only, and
# 128 and 255 check that its compares are unsigned.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

@intrinsic("bytes_index_json")
fn bytes_index_json(text: string, from: usize) -> usize:
    panic("intrinsic")

@intrinsic("bytes_index")
fn bytes_index(text: string, from: usize, byte: u8) -> usize:
    panic("intrinsic")

@intrinsic("bytes_mismatch")
fn bytes_mismatch(left: string, right: string) -> usize:
    panic("intrinsic")

@intrinsic("utf8_valid_len")
fn utf8_valid_len(bytes: List[u8]) -> usize:
    panic("intrinsic")

@intrinsic("bytes_index_pair")
fn bytes_index_pair(text: string, from: usize, first: u8, last: u8, gap: usize) -> usize:
    panic("intrinsic")

# The reference body of `bytes_index_json` in lib/std/json.hd.
fn reference_json(text: string, from: usize) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        byte := bytes_at(text, index)
        if byte < 32 || byte == 34 || byte == 92:
            return index
        index = index + 1
    size

# The reference body of `bytes_index` in lib/std/text.hd.
fn reference_index(text: string, from: usize, byte: u8) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        if bytes_at(text, index) == byte:
            return index
        index = index + 1
    size

# The byte values the scans are checked at.
fn edge_byte(k: usize) -> u8:
    match k % 8:
        0 => 0
        1 => 31
        2 => 32
        3 => 34
        4 => 92
        5 => 127
        6 => 128
        _ => 255

# A byte that no JSON scan stops at, varied by position.
fn plain_byte(k: usize) -> u8:
    match k % 5:
        0 => 32
        1 => 127
        2 => 128
        3 => 255
        _ => 97

# A view of `len` plain bytes, `start` bytes into its buffer, with `byte`
# at offset `at` when `at < len`. The buffer's bytes before the view are
# `"`, which a scan stops at; after it come 1 to 7 plain bytes, then `"`.
# A scan that reads outside the view gives a wrong answer.
fn view(start: usize, len: usize, at: usize, byte: u8) -> string:
    let mut bytes: List[u8] = []
    let k: usize = 0
    while k < start + len + 16:
        if k < start || k >= start + len + 1 + start % 7:
            bytes.push(34)
        else if k >= start + len:
            bytes.push(plain_byte(k))
        else if k - start == at:
            bytes.push(byte)
        else:
            bytes.push(plain_byte(k))
        k = k + 1
    bytes_slice(string_from_bytes(bytes), start, start + len)

@derive(Debug)
struct Scan:
    start: usize
    len: usize
    at: usize
    byte: u8
    from: usize

fn scan(c: &mut Choices) -> Scan:
    let start: usize = c.int(0..32)
    let len: usize = c.int(0..=80)
    let at: usize = c.int(0..=len)
    let byte_at: usize = c.int(0..8)
    let from: usize = c.int(0..=len + 2)
    Scan { start: start, len: len, at: at, byte: edge_byte(byte_at), from: from }

# A byte that is not `needle`, varied by position, over the edge values.
fn other_byte(k: usize, needle: u8) -> u8:
    byte := edge_byte(k)
    if byte == needle: edge_byte(k + 1) else: byte

# A view of `len` bytes, `start` bytes into its buffer, none of them
# `needle` except one at offset `at` when `at < len`. Every byte of the
# buffer outside the view is `needle`, so a scan that reads outside the
# view gives a wrong answer.
fn needle_view(start: usize, len: usize, at: usize, needle: u8) -> string:
    let mut bytes: List[u8] = []
    let k: usize = 0
    while k < start + len + 16:
        if k < start || k >= start + len:
            bytes.push(needle)
        else if k - start == at:
            bytes.push(needle)
        else:
            bytes.push(other_byte(k, needle))
        k = k + 1
    bytes_slice(string_from_bytes(bytes), start, start + len)

@derive(Debug)
struct Index:
    start: usize
    len: usize
    at: usize
    needle: u8
    from: usize

fn index_case(c: &mut Choices) -> Index:
    let start: usize = c.int(0..32)
    let len: usize = c.int(0..=80)
    let at: usize = c.int(0..=len)
    let needle_at: usize = c.int(0..8)
    let from: usize = c.int(0..=len + 2)
    Index { start: start, len: len, at: at, needle: edge_byte(needle_at), from: from }

# The reference body of `bytes_mismatch` in lib/std/text.hd.
fn reference_mismatch(left: string, right: string) -> usize:
    left_size := bytes_len(left)
    right_size := bytes_len(right)
    shorter := if left_size < right_size: left_size else: right_size
    let index: usize = 0
    while index < shorter:
        if bytes_at(left, index) != bytes_at(right, index):
            return index
        index = index + 1
    shorter

# The old loops of `string_equal` and `string_compare`.
fn reference_equal(left: string, right: string) -> bool:
    bytes_len(left) == bytes_len(right) && reference_mismatch(left, right) == bytes_len(left)

fn reference_compare(left: string, right: string) -> i32:
    at := reference_mismatch(left, right)
    if at < bytes_len(left) && at < bytes_len(right):
        return if bytes_at(left, at) < bytes_at(right, at): -1 else: 1
    if bytes_len(left) < bytes_len(right): -1 else if bytes_len(left) > bytes_len(right): 1 else: 0

# A view of `len` bytes, `start` bytes into its buffer. Byte `k` of the view
# is `edge_byte(k)`, except byte `at` (when `at < len`), which is `repl`.
# Every byte of the buffer outside the view is `fill`, and the two sides of
# a comparison use different fills, so a compare that reads outside either
# view gives a wrong answer.
fn mview(start: usize, len: usize, at: usize, repl: u8, fill: u8) -> string:
    let mut bytes: List[u8] = []
    let k: usize = 0
    while k < start + len + 16:
        if k < start || k >= start + len:
            bytes.push(fill)
        else if k - start == at:
            bytes.push(repl)
        else:
            bytes.push(edge_byte(k - start))
        k = k + 1
    bytes_slice(string_from_bytes(bytes), start, start + len)

# A byte that differs from the one `edge_byte` puts at view offset `at`.
fn changed(at: usize, pick: usize) -> u8:
    other_byte(pick, edge_byte(at))

# Both views for one comparison: the right one differs at `at` when
# `at` is below the shorter length.
fn pair(left_start: usize, left_len: usize, right_start: usize, right_len: usize, at: usize, pick: usize) -> List[string]:
    [mview(left_start, left_len, 1000, 0, 1), mview(right_start, right_len, at, changed(at, pick), 2)]

@derive(Debug)
struct Mismatch:
    left_start: usize
    left_len: usize
    right_start: usize
    right_len: usize
    at: usize
    pick: usize

fn mismatch_case(c: &mut Choices) -> Mismatch:
    let left_start: usize = c.int(0..32)
    let right_start: usize = c.int(0..32)
    let left_len: usize = c.int(0..=80)
    # Often the same length, and often a prefix of the other side.
    let shape: usize = c.int(0..4)
    let right_len: usize = match shape:
        0 => left_len
        1 => if left_len > 0: left_len - 1 else: 0
        2 => left_len + 1
        _ => c.int(0..=80)
    let bigger = if left_len > right_len: left_len else: right_len
    let at: usize = c.int(0..=bigger)
    let pick: usize = c.int(0..8)
    Mismatch { left_start: left_start, left_len: left_len, right_start: right_start, right_len: right_len, at: at, pick: pick }

fn continuation(byte: u8) -> bool:
    byte >= 128 && byte < 192

fn scalar(point: i32) -> bool:
    point >= 0 && point <= 1114111 && (point < 55296 || point > 57343)

# The `from_utf8` loop before `utf8_valid_len` (lib/std/text.hd), with the
# length of the list for a valid one. Its reference body is this loop with
# each error replaced by its offset.
fn reference_decode(bytes: List[u8]) -> Result[usize, Utf8Error]:
    let index: usize = 0
    size := bytes.len()
    while index < size:
        lead := i32(bytes[index])
        if lead < 128:
            index = index + 1
            continue
        let width: usize = 1
        let point = lead
        let lowest: i32 = 0
        if lead >= 240 && lead <= 244:
            width = 4
            point = lead - 240
            lowest = 65536
        else if lead >= 224 && lead < 240:
            width = 3
            point = lead - 224
            lowest = 2048
        else if lead >= 194 && lead < 224:
            width = 2
            point = lead - 192
            lowest = 128
        else:
            return .Err(Utf8Error.InvalidSequence(index))
        let at: usize = 1
        while at < width:
            if index + at >= size:
                return .Err(Utf8Error.Truncated(index))
            if !continuation(bytes[index + at]):
                return .Err(Utf8Error.InvalidSequence(index))
            point = point * 64 + i32(bytes[index + at]) - 128
            at = at + 1
        if point < lowest || !scalar(point):
            return .Err(Utf8Error.InvalidSequence(index))
        index = index + width
    .Ok(size)

# The reference body of `utf8_valid_len` in lib/std/text.hd.
fn reference_valid_len(bytes: List[u8]) -> usize:
    match reference_decode(bytes):
        .Ok(size) => size
        .Err(.InvalidSequence(at)) => at
        .Err(.Truncated(at)) => at

# What `string::from_utf8` gives, with the string's length for `.Ok`.
fn decode(bytes: List[u8]) -> Result[usize, Utf8Error]:
    match string::from_utf8(bytes):
        .Ok(text) => .Ok(text.len())
        .Err(error) => .Err(error)

# Valid characters, by `k`: ASCII, then 2-, 3- and 4-byte scalars, with the
# least and greatest of each width and both sides of the surrogates.
fn utf8_char(k: usize) -> List[u8]:
    match k % 14:
        0 => [97]
        1 => [195, 169]
        2 => [226, 130, 172]
        3 => [240, 159, 152, 128]
        4 => [194, 128]
        5 => [223, 191]
        6 => [224, 160, 128]
        7 => [239, 191, 191]
        8 => [237, 159, 191]
        9 => [238, 128, 128]
        10 => [240, 144, 128, 128]
        11 => [244, 143, 191, 191]
        12 => [127]
        _ => [0]

# A malformed sequence of category `kind`, variant `pick`: overlong (0, 1,
# 2), surrogate (3), out of range (4), truncated (5, only at the end), stray
# continuation (6), and a bad continuation at byte 2 (7), 3 (8) or 4 (9).
fn bad_sequence(kind: usize, pick: usize) -> List[u8]:
    p := pick % 2
    match kind:
        0 => if p == 0: [192, 128] else: [193, 191]
        1 => if p == 0: [224, 128, 128] else: [224, 159, 191]
        2 => if p == 0: [240, 128, 128, 128] else: [240, 143, 191, 191]
        3 => if p == 0: [237, 160, 128] else: [237, 191, 191]
        4 => match pick % 3:
            0 => [244, 144, 128, 128]
            1 => [245, 128, 128, 128]
            _ => [255]
        5 => match pick % 3:
            0 => [195]
            1 => [226, 130]
            _ => [240, 159, 152]
        6 => if p == 0: [128] else: [191]
        7 => if p == 0: [226, 65, 172] else: [195, 195]
        8 => if p == 0: [226, 130, 65] else: [240, 159, 65, 128]
        _ => if p == 0: [240, 159, 152, 65] else: [244, 143, 191, 240]

# The `k`th character of fill style `mix`: all ASCII (0), ASCII with a
# multibyte character every 7 (1), all multibyte (2), or every kind (3).
fn fill_char(mix: usize, k: usize) -> List[u8]:
    match mix % 4:
        0 => utf8_char(if k % 3 == 0: 12 else: 0)
        1 => if k % 7 == 6: utf8_char(k / 7 % 11 + 1) else: utf8_char(0)
        2 => utf8_char(k % 11 + 1)
        _ => utf8_char(k)

# Valid characters of style `mix` from `bytes.len()` up to exactly `target`
# bytes, ASCII filling the last gap.
fn fill_to(bytes: &mut List[u8], mix: usize, target: usize, seed: usize) -> void:
    let k = seed
    let more = true
    while more:
        piece := fill_char(mix, k)
        if bytes.len() + piece.len() <= target:
            for byte in piece:
                bytes.push(byte)
            k = k + 1
        else:
            more = false
    while bytes.len() < target:
        bytes.push(97)

# `len` bytes of style `mix`, with the malformed sequence `kind`/`pick` at
# byte `at` when `kind` is below 10 (a truncated one ends the list).
fn utf8_bytes(mix: usize, at: usize, kind: usize, pick: usize, len: usize) -> List[u8]:
    let mut bytes: List[u8] = []
    if kind >= 10:
        fill_to(&mut bytes, mix, len, at)
        return bytes
    fill_to(&mut bytes, mix, at, 0)
    for byte in bad_sequence(kind, pick):
        bytes.push(byte)
    if kind != 5:
        fill_to(&mut bytes, mix, len, at)
    bytes

@derive(Debug)
struct Utf8Case:
    mix: usize
    at: usize
    kind: usize
    pick: usize
    len: usize

fn utf8_case(c: &mut Choices) -> Utf8Case:
    let mix: usize = c.int(0..4)
    let at: usize = c.int(0..=96)
    let kind: usize = c.int(0..=11)
    let pick: usize = c.int(0..6)
    let len: usize = c.int(at..=at + 48)
    Utf8Case { mix: mix, at: at, kind: kind, pick: pick, len: len }

# The reference body of `bytes_index_pair` in lib/std/text.hd.
fn reference_pair(text: string, from: usize, first: u8, last: u8, gap: usize) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size && gap < size - index:
        if bytes_at(text, index) == first && bytes_at(text, index + gap) == last:
            return index
        index = index + 1
    size

# The gaps `bytes_index_pair` is checked at: a needle's length minus 1.
fn pair_gap(k: usize) -> usize:
    match k % 8:
        0 => 1
        1 => 2
        2 => 3
        3 => 15
        4 => 16
        5 => 17
        6 => 31
        _ => 0

# A byte that is neither `first` nor `last`, varied by position.
fn background(k: usize, first: u8, last: u8) -> u8:
    let j = k
    while edge_byte(j) == first || edge_byte(j) == last:
        j = j + 1
    edge_byte(j)

# A view of `len` bytes, `start` bytes into its buffer, with no `first` or
# `last` in it except `first` at offsets `a` and `d`, and `last` at offset
# `a + gap`, each when inside the view. The buffer outside the view is
# `first` (fill 0), `last` (fill 1), or alternating runs of `gap` of each
# (fill 2), so that a scan that reads outside the view finds a pair there.
fn pair_view(start: usize, len: usize, gap: usize, first: u8, last: u8, fill: usize, a: usize, d: usize) -> string:
    let mut bytes: List[u8] = []
    let g = if gap == 0: 1 else: gap
    let k: usize = 0
    while k < start + len + gap + 32:
        if k < start || k >= start + len:
            if fill == 0:
                bytes.push(first)
            else if fill == 1:
                bytes.push(last)
            else if (k / g) % 2 == 0:
                bytes.push(first)
            else:
                bytes.push(last)
        else if k - start == a + gap:
            bytes.push(last)
        else if k - start == a || k - start == d:
            bytes.push(first)
        else:
            bytes.push(background(k, first, last))
        k = k + 1
    bytes_slice(string_from_bytes(bytes), start, start + len)

@derive(Debug)
struct PairCase:
    start: usize
    len: usize
    gap: usize
    first: u8
    last: u8
    fill: usize
    a: usize
    d: usize
    from: usize

fn pair_case(c: &mut Choices) -> PairCase:
    let start: usize = c.int(0..32)
    let len: usize = c.int(0..=80)
    let gap: usize = pair_gap(c.int(0..8))
    let first: u8 = edge_byte(c.int(0..8))
    # Often the same byte as `first`.
    let last: u8 = if c.int(0..4) == 0: first else: edge_byte(c.int(0..8))
    let fill: usize = c.int(0..3)
    let a: usize = c.int(0..=len + 1)
    let d: usize = c.int(0..=len + 1)
    let from: usize = c.int(0..=len + 2)
    PairCase { start: start, len: len, gap: gap, first: first, last: last, fill: fill, a: a, d: d, from: from }

# A text of `len` bytes over `a` and `b` (or only `a` when `wide` is 1),
# `start` bytes into its buffer, from a counter.
fn ab_text(start: usize, len: usize, seed: usize, wide: usize) -> string:
    let mut bytes: List[u8] = []
    let state = seed * 2654435761 + 1
    let k: usize = 0
    while k < start + len + 3:
        state = state * 1103515245 + 12345
        bytes.push(if wide == 1 || (state >> 16) % 3 == 0: 97 else: 98)
        k = k + 1
    bytes_slice(string_from_bytes(bytes), start, start + len)

# The naive search: the first offset at or after `from` where `needle` is.
fn naive_find(text: string, needle: string, from: usize) -> usize?:
    size := bytes_len(text)
    width := bytes_len(needle)
    let at = from
    while at + width <= size:
        let k: usize = 0
        while k < width && bytes_at(text, at + k) == bytes_at(needle, k):
            k = k + 1
        if k == width:
            return .Some(at)
        at = at + 1
    .None

# The naive split around non-overlapping, left to right occurrences.
fn naive_split(text: string, needle: string) -> List[string]:
    let mut pieces: List[string] = []
    width := bytes_len(needle)
    let from: usize = 0
    let searching = true
    while searching:
        match naive_find(text, needle, from):
            .Some(at) =>
                pieces.push(bytes_slice(text, from, at))
                from = at + width
            .None =>
                pieces.push(bytes_slice(text, from, bytes_len(text)))
                searching = false
    pieces

@derive(Debug)
struct Search:
    start: usize
    len: usize
    seed: usize
    wide: usize
    needle_start: usize
    needle_len: usize
    needle_seed: usize

fn search_case(c: &mut Choices) -> Search:
    let start: usize = c.int(0..32)
    # Long enough for the adaptive fallback in `search_from` to switch
    # between the prefilter and plain windows.
    let len: usize = c.int(0..=700)
    let seed: usize = c.int(0..1000)
    let wide: usize = c.int(0..4)
    let needle_start: usize = c.int(0..32)
    let needle_len: usize = c.int(2..=20)
    let needle_seed: usize = c.int(0..1000)
    Search { start: start, len: len, seed: seed, wide: wide, needle_start: needle_start, needle_len: needle_len, needle_seed: needle_seed }

tests:
    use std.testing.{assert_equal, it, it_prop_with}

    it_prop_with("bytes_index_json gives what its reference body gives", gen=scan, cases=2000, prop=fn!(s: Scan):
        text := view(s.start, s.len, s.at, s.byte)
        assert_equal(bytes_index_json(text, s.from), reference_json(text, s.from), reason=debug(s))
    )

    it("bytes_index_json agrees at every length, view start and 16-byte edge"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                let at: usize = 0
                while at <= len:
                    let k: usize = 0
                    while k < 8:
                        text := view(start, len, at, edge_byte(k))
                        got := bytes_index_json(text, 0)
                        want := reference_json(text, 0)
                        if got != want:
                            assert_equal(got, want, reason="start $start, length $len, byte ${edge_byte(k)} at $at")
                        k = k + 1
                    at = at + 1
                len = len + 1
            start = start + 1

    it("bytes_index_json starts at every offset, and past the end gives the length"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                text := view(start, len, len / 2, 92)
                let from: usize = 0
                while from <= len + 2:
                    got := bytes_index_json(text, from)
                    want := reference_json(text, from)
                    if got != want:
                        assert_equal(got, want, reason="start $start, length $len, from $from")
                    from = from + 1
                len = len + 1
            start = start + 1

    it_prop_with("bytes_index gives what its reference body gives", gen=index_case, cases=2000, prop=fn!(s: Index):
        text := needle_view(s.start, s.len, s.at, s.needle)
        assert_equal(bytes_index(text, s.from, s.needle), reference_index(text, s.from, s.needle), reason=debug(s))
    )

    it("bytes_index agrees at every length, view start and 16-byte edge"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                let at: usize = 0
                while at <= len:
                    let k: usize = 0
                    while k < 8:
                        needle := edge_byte(k)
                        text := needle_view(start, len, at, needle)
                        got := bytes_index(text, 0, needle)
                        want := reference_index(text, 0, needle)
                        if got != want:
                            assert_equal(got, want, reason="start $start, length $len, byte $needle at $at")
                        k = k + 1
                    at = at + 1
                len = len + 1
            start = start + 1

    it("bytes_index starts at every offset, and past the end gives the length"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                text := needle_view(start, len, len / 2, 255)
                let from: usize = 0
                while from <= len + 2:
                    got := bytes_index(text, from, 255)
                    want := reference_index(text, from, 255)
                    if got != want:
                        assert_equal(got, want, reason="start $start, length $len, from $from")
                    from = from + 1
                len = len + 1
            start = start + 1

    it("bytes_index finds the first of several matches, and any byte but the needle is skipped"):
        text := string_from_bytes([7, 9, 7, 9, 7, 9, 7, 9, 7, 9, 7, 9, 7, 9, 7, 9, 7, 9, 7, 9])
        assert_equal(bytes_index(text, 0, 9), 1, reason="bytes_index(text, 0, 9)")
        assert_equal(bytes_index(text, 2, 9), 3, reason="bytes_index(text, 2, 9)")
        assert_equal(bytes_index(text, 0, 8), 20, reason="bytes_index(text, 0, 8)")
        assert_equal(bytes_index(text, 19, 9), 19, reason="bytes_index(text, 19, 9)")
        assert_equal(bytes_index(text, 20, 9), 20, reason="bytes_index(text, 20, 9)")
        assert_equal(bytes_index(text, 99, 9), 20, reason="bytes_index(text, 99, 9)")
        assert_equal(bytes_index("", 0, 9), 0, reason="bytes_index(\"\", 0, 9)")

    it_prop_with("bytes_mismatch gives what its reference body gives", gen=mismatch_case, cases=2000, prop=fn!(m: Mismatch):
        views := pair(m.left_start, m.left_len, m.right_start, m.right_len, m.at, m.pick)
        left := views[0]
        right := views[1]
        assert_equal(bytes_mismatch(left, right), reference_mismatch(left, right), reason=debug(m))
        assert_equal(bytes_mismatch(right, left), reference_mismatch(right, left), reason=debug(m))
        assert_equal(left == right, reference_equal(left, right), reason=debug(m))
        assert_equal(left != right, !reference_equal(left, right), reason=debug(m))
        assert_equal(left < right, reference_compare(left, right) < 0, reason=debug(m))
        assert_equal(left >= right, reference_compare(left, right) >= 0, reason=debug(m))
        assert_equal(right > left, reference_compare(right, left) > 0, reason=debug(m))
    )

    it("bytes_mismatch agrees at every pair of view starts and 16-byte edge"):
        let left_start: usize = 0
        while left_start < 32:
            let right_start: usize = 0
            while right_start < 32:
                let shape: usize = 0
                while shape < 3:
                    left_len := if shape == 2: 33 else: 40
                    right_len := if shape == 1: 40 else if shape == 2: 20 else: 40
                    let place: usize = 0
                    while place < 9:
                        at := match place:
                            0 => 1000
                            1 => 0
                            2 => 15
                            3 => 16
                            4 => 17
                            5 => 19
                            6 => 31
                            7 => 32
                            _ => 39
                        views := pair(left_start, left_len, right_start, right_len, at, place)
                        got := bytes_mismatch(views[0], views[1])
                        want := reference_mismatch(views[0], views[1])
                        if got != want:
                            assert_equal(got, want, reason="starts $left_start and $right_start, lengths $left_len and $right_len, at $at")
                        place = place + 1
                    shape = shape + 1
                right_start = right_start + 1
            left_start = left_start + 1

    it("bytes_mismatch agrees at every pair of lengths and difference position"):
        let left_len: usize = 0
        while left_len < 50:
            let right_len: usize = 0
            while right_len < 50:
                shorter := if left_len < right_len: left_len else: right_len
                let at: usize = 0
                while at <= shorter:
                    views := pair((left_len * 5 + at) % 32, left_len, (right_len * 3 + at) % 32, right_len, at, left_len + at)
                    got := bytes_mismatch(views[0], views[1])
                    want := reference_mismatch(views[0], views[1])
                    if got != want:
                        assert_equal(got, want, reason="lengths $left_len and $right_len, at $at")
                    at = at + 1
                right_len = right_len + 1
            left_len = left_len + 1

    it("bytes_mismatch gives the shorter length for a prefix and the common length when equal"):
        assert_equal(bytes_mismatch("", ""), 0, reason="empty")
        assert_equal(bytes_mismatch("", "abc"), 0, reason="empty and abc")
        assert_equal(bytes_mismatch("abc", "abc"), 3, reason="equal")
        assert_equal(bytes_mismatch("abc", "abcd"), 3, reason="prefix")
        assert_equal(bytes_mismatch("abcd", "abc"), 3, reason="prefix, swapped")
        assert_equal(bytes_mismatch("abcd", "abxd"), 2, reason="differ at 2")

    it("string comparison orders by unsigned byte"):
        low := string_from_bytes([127])
        high := string_from_bytes([128])
        top := string_from_bytes([255])
        assert_equal(low < high, true, reason="127 < 128")
        assert_equal(high < top, true, reason="128 < 255")
        assert_equal(top > low, true, reason="255 > 127")
        assert_equal("ab" < "abc", true, reason="prefix is smaller")
        assert_equal("abc" == "abc", true, reason="equal")
        assert_equal("abc" == "abd", false, reason="not equal")

    it_prop_with("utf8_valid_len and from_utf8 give what the reference loop gives", gen=utf8_case, cases=2000, prop=fn!(u: Utf8Case):
        bytes := utf8_bytes(u.mix, u.at, u.kind, u.pick, u.len)
        assert_equal(utf8_valid_len(bytes), reference_valid_len(bytes), reason=debug(u))
        assert_equal(decode(bytes), reference_decode(bytes), reason=debug(u))
    )

    it("utf8_valid_len and from_utf8 agree for every malformed category at every offset"):
        let mix: usize = 0
        while mix < 4:
            let kind: usize = 0
            while kind < 10:
                let pick: usize = 0
                while pick < 3:
                    let at: usize = 0
                    while at < 70:
                        bytes := utf8_bytes(mix, at, kind, pick, at + 37)
                        got := utf8_valid_len(bytes)
                        want := reference_valid_len(bytes)
                        if got != want || want != at:
                            assert_equal(got, want, reason="mix $mix, kind $kind, pick $pick, at $at")
                            assert_equal(want, at, reason="the sequence starts at $at")
                        decoded := decode(bytes)
                        expected := reference_decode(bytes)
                        if decoded != expected:
                            assert_equal(decoded, expected, reason="mix $mix, kind $kind, pick $pick, at $at")
                        at = at + 1
                    pick = pick + 1
                kind = kind + 1
            mix = mix + 1

    it("utf8_valid_len accepts valid input of every length and characters across each 16-byte edge"):
        let mix: usize = 0
        while mix < 4:
            let len: usize = 0
            while len < 140:
                let seed: usize = 0
                while seed < 4:
                    bytes := utf8_bytes(mix, seed, 10, 0, len)
                    assert_equal(utf8_valid_len(bytes), len, reason="mix $mix, length $len, seed $seed")
                    seed = seed + 1
                len = len + 1
            mix = mix + 1
        # One character of each width starting at every offset, so each
        # straddles a 16-byte edge somewhere, in ASCII on both sides.
        let k: usize = 1
        while k < 12:
            let at: usize = 0
            while at < 70:
                let mut bytes: List[u8] = []
                while bytes.len() < at:
                    bytes.push(97)
                for byte in utf8_char(k):
                    bytes.push(byte)
                while bytes.len() < 90:
                    bytes.push(97)
                assert_equal(utf8_valid_len(bytes), 90, reason="character $k at $at")
                # Cut inside the character: valid up to its start.
                width := utf8_char(k).len()
                let cut: usize = 1
                while cut < width:
                    let mut short: List[u8] = []
                    let j: usize = 0
                    while j < at + cut:
                        short.push(bytes[j])
                        j = j + 1
                    assert_equal(utf8_valid_len(short), at, reason="character $k at $at cut after $cut")
                    assert_equal(decode(short), reference_decode(short), reason="character $k at $at cut after $cut")
                    cut = cut + 1
                at = at + 1
            k = k + 1

    it("utf8_valid_len and from_utf8 on small cases"):
        assert_equal(utf8_valid_len([]), 0, reason="empty")
        assert_equal(utf8_valid_len([104, 105]), 2, reason="hi")
        assert_equal(utf8_valid_len([104, 255, 105]), 1, reason="255")
        assert_equal(decode([104, 255, 105]), .Err(Utf8Error.InvalidSequence(1)), reason="255")
        assert_equal(decode([97, 226, 130]), .Err(Utf8Error.Truncated(1)), reason="truncated")
        assert_equal(decode([226, 130, 172]), .Ok(3), reason="euro")

    it_prop_with("bytes_index_pair gives what its reference body gives", gen=pair_case, cases=3000, prop=fn!(s: PairCase):
        text := pair_view(s.start, s.len, s.gap, s.first, s.last, s.fill, s.a, s.d)
        assert_equal(bytes_index_pair(text, s.from, s.first, s.last, s.gap), reference_pair(text, s.from, s.first, s.last, s.gap), reason=debug(s))
    )

    it("bytes_index_pair agrees at every length, view start, gap and match position"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                let g: usize = 0
                while g < 8:
                    gap := pair_gap(g)
                    let m: usize = 0
                    while m < 6:
                        # Matches at the start, around the last full vector
                        # and the end, and none (`len + 1` is outside).
                        a := match m:
                            0 => 0
                            1 => if len > gap: len - gap - 1 else: 0
                            2 => if len > gap: len - gap else: 0
                            3 => len / 2
                            4 => len
                            _ => len + 1
                        first := edge_byte(a + g)
                        last := if m == 3: first else: edge_byte(a + g + 3)
                        text := pair_view(start, len, gap, first, last, (start + m) % 3, a, len)
                        got := bytes_index_pair(text, 0, first, last, gap)
                        want := reference_pair(text, 0, first, last, gap)
                        if got != want:
                            assert_equal(got, want, reason="start $start, length $len, gap $gap, match $a, bytes $first $last")
                        m = m + 1
                    g = g + 1
                len = len + 1
            start = start + 1

    it("bytes_index_pair starts at every offset, and past the end gives the length"):
        let start: usize = 0
        while start < 32:
            let len: usize = 0
            while len < 50:
                let g: usize = 0
                while g < 8:
                    gap := pair_gap(g)
                    text := pair_view(start, len, gap, 255, 128, (start + g) % 3, len / 3, len / 2)
                    let from: usize = 0
                    while from <= len + 2:
                        got := bytes_index_pair(text, from, 255, 128, gap)
                        want := reference_pair(text, from, 255, 128, gap)
                        if got != want:
                            assert_equal(got, want, reason="start $start, length $len, gap $gap, from $from")
                        from = from + 1
                    g = g + 1
                len = len + 1
            start = start + 1

    it("bytes_index_pair finds the first pair, and needs room for the gap"):
        text := string_from_bytes([1, 9, 1, 9, 1, 1, 9, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 5])
        assert_equal(bytes_index_pair(text, 0, 1, 9, 1), 0, reason="from 0, gap 1")
        assert_equal(bytes_index_pair(text, 1, 1, 9, 1), 2, reason="from 1, gap 1")
        assert_equal(bytes_index_pair(text, 0, 1, 9, 3), 0, reason="from 0, gap 3")
        assert_equal(bytes_index_pair(text, 4, 1, 9, 3), 4, reason="from 4, gap 3")
        assert_equal(bytes_index_pair(text, 0, 1, 5, 20), 0, reason="gap 20, last byte")
        assert_equal(bytes_index_pair(text, 1, 1, 5, 20), 21, reason="gap 20 from 1")
        assert_equal(bytes_index_pair(text, 0, 9, 5, 19), 1, reason="gap 19")
        assert_equal(bytes_index_pair(text, 0, 1, 5, 21), 21, reason="gap 21 needs 22 bytes")
        assert_equal(bytes_index_pair(text, 0, 1, 9, 99), 21, reason="gap past the end")
        assert_equal(bytes_index_pair(text, 99, 1, 9, 1), 21, reason="from past the end")
        assert_equal(bytes_index_pair("", 0, 1, 9, 0), 0, reason="empty")

    it_prop_with("find and split with a multi-byte needle give what a naive search gives", gen=search_case, cases=3000, prop=fn!(s: Search):
        text := ab_text(s.start, s.len, s.seed, s.wide)
        needle := ab_text(s.needle_start, s.needle_len, s.needle_seed, s.wide % 2)
        assert_equal(text.find(needle), naive_find(text, needle, 0), reason="find in ${debug(s)}")
        assert_equal(text.split(needle), naive_split(text, needle), reason="split in ${debug(s)}")
        assert_equal(text.contains(needle), naive_find(text, needle, 0) != .None, reason="contains in ${debug(s)}")
    )

    it("find and split agree with a naive search on overlapping and repeated patterns"):
        texts := ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "abababababababababababababababababababab", "aabaabaabaabaabaabaabaabaabaabaab", "abaababaabaababaabaababaabaababaab", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab"]
        needles := ["aa", "aaa", "ab", "aba", "abab", "aab", "aabaab", "abaab", "ba", "aaaaaaaaaaaaaaaaaab", "abababababababababab", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab", "abaababaabaababaab", "b", "baab"]
        for text in texts:
            for needle in needles:
                assert_equal(text.find(needle), naive_find(text, needle, 0), reason="find $needle in $text")
                assert_equal(text.split(needle), naive_split(text, needle), reason="split $needle in $text")

    it("find and split agree with a naive search on long dense texts, across the hand-over between loops"):
        let wide: usize = 0
        while wide < 3:
            text := ab_text(5, 30000, 7 + wide, wide)
            let at: usize = 0
            while at < 29000:
                let width: usize = 2
                while width <= 12:
                    needle := bytes_slice(text, at, at + width)
                    assert_equal(text.find(needle), naive_find(text, needle, 0), reason="find $width bytes at $at, wide $wide")
                    width = width + 5
                at = at + 3989
            needle := bytes_slice(text, 29000, 29011)
            assert_equal(text.split(needle), naive_split(text, needle), reason="split wide $wide")
            # A `c` inside the needle: no match in the text, then one at the end.
            for pattern in ["acb", "abcbbbbbba", "aaacaaaa", "bcbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]:
                assert_equal(text.find(pattern), naive_find(text, pattern, 0), reason="find $pattern, wide $wide")
                ended := text + pattern
                assert_equal(ended.find(pattern), .Some(30000), reason="find $pattern at the end, wide $wide")
                assert_equal(ended.split(pattern), [text, ""], reason="split $pattern at the end, wide $wide")
            wide = wide + 1
