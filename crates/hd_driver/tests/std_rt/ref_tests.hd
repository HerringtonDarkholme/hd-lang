# The hd tests of references on the linear backend (crates/hd_wasm_linear/DESIGN.md
# §23.20): a reference to a local shares the local's cell, an element
# reference a callee keeps owns its list's pin until its last copy dies, and each is
# released after its last use, so taking references in a loop runs in
# bounded memory. A reference is an address, so writing through one to a
# local allocates nothing. Only std may read the heap's size, so the
# conformance runner adds this file to std as `std.rt.ref_tests`. Only the
# checked runtime counts allocations: in a build without it `allocated()`
# stays 0, and the cases that compare it check nothing.
use std.rt.memory.pages
use std.rt.checked.{allocated, released}

struct Holder:
    slot: *mut i32

fn label(n: i32) -> string:
    "r$n"

fn bump(x: &mut i32) -> void:
    *x = *x + 1

fn keep(x: *mut i32) -> *mut i32:
    x

fn keep_string(x: *mut string) -> *mut string:
    x

fn grow(xs: &mut List[string], n: i32) -> void:
    xs.push(label(n))

struct Upto:
    at: i64
    end: i64

impl Iterator[i64] for Upto:
    fn next(&mut self) -> i64?:
        if self.at >= self.end:
            return .None
        self.at = self.at + 1
        .Some(self.at - 1)

fn add(total: i64, item: i64) -> i64:
    total + item

fn odd(item: i64) -> bool:
    item % 2 == 1

fn small(item: i64) -> bool:
    item < 100

tests:
    use std.testing.{assert, it}

    it("a reference to a local writes the local"):
        let mut n = +1
        bump(&mut n)
        r := &mut n
        *r = *r + 10
        assert(n == 12, "the writes reached the local")

    it("writing through `&mut` to a local in a loop allocates nothing"):
        let mut total = +0
        let round = +0
        before := allocated()
        while round < 100:
            bump(&mut total)
            r := &mut total
            *r = *r + 1
            round = round + 1
        assert(allocated() == before, "no round allocated a block")
        assert(total == 200, "every round wrote the local twice")

    it("consuming an iterator allocates nothing per call"):
        # Each consumer's cursor lives in its frame (DESIGN.md §23.38).
        let round = +0
        let total: i64 = 0
        before := allocated()
        while round < 100:
            total = total + Upto { at: 0, end: 4 }.fold(0, add)
            assert(allocated() == before, "fold allocated no block")
            total = total + Upto { at: 0, end: 4 }.sum()
            assert(allocated() == before, "sum allocated no block")
            total = total + i64(Upto { at: 0, end: 4 }.count())
            assert(allocated() == before, "count allocated no block")
            if Upto { at: 0, end: 4 }.any(odd) && Upto { at: 0, end: 4 }.all(small):
                total = total + 1
            assert(allocated() == before, "any and all allocated no block")
            if Upto { at: 0, end: 4 }.find(odd) == .Some(1):
                total = total + 1
            assert(allocated() == before, "find allocated no block")
            round = round + 1
        assert(total == 100 * (6 + 6 + 4 + 2), "every consumer read every item")

    it("an element reference pins its list until its last use"):
        let mut xs = [+1, 2, 3]
        r := keep(&mut xs[1])
        *r = 20
        xs.push(4)
        assert(xs.len() == 4 && xs[1] == 20, "the push ran after the reference's last use")
        saved := Holder { slot: keep(&mut xs[0]) }
        *saved.slot = 10
        xs.push(5)
        assert(xs[0] == 10 && xs.len() == 5, "the field copy died before the push")

    it("references taken in a loop run in bounded memory"):
        let round = +0
        let start: usize = 0
        let right = +0
        while round < 2030:
            if round == 30:
                start = pages()
            let mut n = round
            bump(&mut n)
            let mut xs = [label(round), label(n)]
            for s in &mut xs:
                *s = *s + "!"
            r := keep_string(&mut xs[0])
            if *r == label(round) + "!" && xs[1] == label(round + 1) + "!":
                right = right + 1
            grow(&mut xs, round)
            xs.push(label(round))
            round = round + 1
        assert(right == 2030, "every round wrote through its references")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "each cell, pin and list is freed")
