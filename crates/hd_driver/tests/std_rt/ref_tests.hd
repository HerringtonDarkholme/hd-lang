# The hd tests of references on the linear backend (crates/hd_wasm/DESIGN.md
# §23.20): a reference to a local shares the local's cell, an element
# reference lasts for its call, and each is released after its last use, so taking references in a loop runs in
# bounded memory. A reference is an address, so writing through one to a
# local allocates nothing. Only std may read the heap's size, so the
# conformance runner adds this file to std as `std.rt_tests.ref_tests`. Only the
# checked runtime counts allocations, so the runner also builds this file
# checked in every mode (`STD_RT_CHECKED_TOO`); without it `allocated()`
# stays 0, and the cases that compare it check nothing.
use std.rt.memory.{make_unique, pages, unique_mut}
use std.rt.checked.{allocated, released, retained, live}
use std.annotation.inline

fn label(n: i32) -> string:
    "r$n"

fn bump(x: &mut i32) -> void:
    *x = *x + 1

fn grow(xs: &mut List[string], n: i32) -> void:
    xs.push(label(n))

struct Upto:
    at: i64
    end: i64

impl Iterator[i64] for Upto:
    fn next(&mut self) -> i64?:
        if self.at >= self.end:
            return .None
        self.at = self.at + 1
        .Some(self.at - 1)

struct Pair:
    left: i32
    right: i32

impl Pair:
    fn left(&self) -> &i32:
        &self.left

fn add(total: i64, item: i64) -> i64:
    total + item

fn odd(item: &i64) -> bool:
    item % 2 == 1

fn small(item: &i64) -> bool:
    item < 100

@inline(.Always)
fn inline_bump(target: &mut i32) -> void:
    *target += 1

@inline(.Always)
fn forward_left(point: &mut Pair) -> void:
    inline_bump(&mut point.left)

@inline(.Never)
fn twice_left(point: &mut Pair) -> void:
    forward_left(point)
    forward_left(point)

struct Tagged[T]:
    marker: T
    value: i32

@inline(.Always)
fn forward_value[T](point: &mut Tagged[T]) -> void:
    inline_bump(&mut point.value)

@inline(.Never)
fn twice_value[T](point: &mut Tagged[T]) -> void:
    forward_value(point)
    forward_value(point)

fn projected_round(round: i32) -> i32:
    let mut point = Tagged { marker: [label(round)], value: round }
    twice_value(&mut point)
    point.value

@inline(.Never)
fn reference_value(value: &i32) -> i32:
    *value

@inline(.Never)
fn projected_depth[T](point: &Tagged[T], depth: usize) -> i32:
    field := &point.value
    below := if depth == 0: +0 else: projected_depth(point, depth - 1)
    reference_value(field) + below

fn projected_read_round(round: i32) -> i32:
    point := Tagged { marker: [label(round)], value: round }
    projected_depth(&point, 4)

struct TextCell:
    value: string

@inline(.Always)
fn inline_length(target: &mut string) -> usize:
    target.len()

@inline(.Never)
fn field_length(point: &mut TextCell) -> usize:
    inline_length(&mut point.value)

@inline(.Never)
fn borrowed_depth(point: &TextCell, depth: usize) -> usize:
    field := &point.value
    below := if depth == 0: 0 else: borrowed_depth(point, depth - 1)
    field.len() + below

@inline(.Never)
fn closure_number(by: fn(&i32) -> i32, value: &i32) -> i32:
    by(value)

@inline(.Never)
fn closure_field(by: fn(&TextCell) -> &string, point: &TextCell) -> &string:
    by(point)

@inline(.Never)
fn closure_copy[T](by: fn(&T) -> T, value: &T) -> T:
    by(value)

@inline(.Never)
fn generic_closure_copy[T](value: &T) -> T:
    closure_copy(fn(input: &T): *input, value)

fn closure_view_round(round: i32) -> usize:
    point := TextCell { value: label(round).repeat(20) }
    copy := generic_closure_copy(&point)
    field := closure_field(fn(value): &value.value, &copy)
    field.len()

struct Count:
    n: i64

struct CountHolder:
    store: *Count

# Writes `v` through `r` when its box is unshared.
fn write_unique(r: &mut *Count, v: i64) -> bool:
    match unique_mut(r):
        .Some(c) =>
            c.n = v
            true
        .None => false

# Two tests of one place: the second finds the box unique once the first
# copied it.
fn set_twice(h: &mut CountHolder, a: i64, b: i64) -> void:
    match unique_mut(&mut h.store):
        .Some(c) => c.n = a
        .None => h.store = box(Count { n: a })
    match unique_mut(&mut h.store):
        .Some(c) => c.n += b
        .None => h.store = box(Count { n: h.store.n + b })

# Adds `0..n` to the holder's count, copying a shared box once first.
fn add_upto(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        match unique_mut(&mut h.store):
            .Some(c) => c.n += i
            .None => h.store = box(Count { n: h.store.n + i })
        i += 1

fn copy_count(c: &Count) -> Count:
    Count { n: c.n }

# Adds `0..n` to the holder's count through `make_unique`, which the loop
# runs once before it.
fn add_made(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        i += 1

# Two writes of a parameter's box with nothing between that could share
# it: the second test reads the flag the first one set.
fn make_twice(h: &mut CountHolder, a: i64, b: i64) -> void:
    make_unique(&mut h.store, copy_count).n = a
    make_unique(&mut h.store, copy_count).n += b

# Counts `k` up and returns it: a call in a loop's test, which runs on
# every check of the test, so the loop's writes stay in it.
fn next_k(k: &mut i64) -> i64:
    *k += 1
    *k

fn add_while_counting(h: &mut CountHolder, n: i64) -> void:
    let mut k: i64 = 0
    while next_k(&mut k) <= n:
        make_unique(&mut h.store, copy_count).n += k

# The inner loop writes on each of its iterations.
fn add_grid(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        let mut j: i64 = 0
        while j < n:
            make_unique(&mut h.store, copy_count).n += 1
            j += 1
        i += 1

# `rows` rounds of an inner loop that writes `cols` times.
fn add_rows(h: &mut CountHolder, rows: i64, cols: i64) -> void:
    let mut i: i64 = 0
    while i < rows:
        let mut j: i64 = 0
        while j < cols:
            make_unique(&mut h.store, copy_count).n += 1
            j += 1
        i += 1

# Adds `0..n` to the holder's count, but leaves at `stop`: the loop may
# leave before its write, so the call stays in it.
fn add_until(h: &mut CountHolder, n: i64, stop: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        if i == stop:
            break
        make_unique(&mut h.store, copy_count).n += i
        i += 1

# The same with no loop test: the break is the loop's one exit.
fn add_until_true(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while true:
        if i >= n:
            break
        make_unique(&mut h.store, copy_count).n += i
        i += 1

# Skips every `i` up to `skip` before its write.
fn add_skipping(h: &mut CountHolder, n: i64, skip: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        i += 1
        if i <= skip:
            continue
        make_unique(&mut h.store, copy_count).n += i

# Returns at `stop`, before its write.
fn add_or_return(h: &mut CountHolder, n: i64, stop: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        if i == stop:
            return
        make_unique(&mut h.store, copy_count).n += i
        i += 1

# A match whose one arm always runs.
fn add_matched(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        match i:
            _ => make_unique(&mut h.store, copy_count).n += i
        i += 1

fn pick(h: &mut CountHolder) -> &mut CountHolder:
    h

# The place is behind a call's result, which the passes don't follow.
fn add_picked(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut pick(h).store, copy_count).n += i
        i += 1

# The copy is a function value, not an item.
fn add_with(h: &mut CountHolder, n: i64, copy: fn(&Count) -> Count) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy).n += i
        i += 1

# The holder is itself a counted box.
fn add_boxed(h: *mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        i += 1

fn add_with_a_call(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    let mut calls: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        next_k(&mut calls)
        i += 1

# A new box replaces the place's on one iteration.
fn add_resetting(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        if i == 1:
            h.store = box(Count { n: 100 })
        i += 1

# Another holder's box replaces the place's on one iteration.
fn add_sharing(h: &mut CountHolder, other: &CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        if i == 1:
            h.store = other.store
        i += 1

# A box in a plain local.
fn sum_in_a_local(start: *Count, n: i64) -> i64:
    let mut p = start
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut p, copy_count).n += i
        i += 1
    p.n

fn tick!(k: i64) -> i64:
    k + 1

# A loop that suspends on each iteration.
fn add_suspending!(h: &mut CountHolder, n: i64) -> void:
    let mut i: i64 = 0
    while i < n:
        make_unique(&mut h.store, copy_count).n += i
        i = tick!(i)

# Each iteration shares the box before its write, so each write copies it;
# the shared copies keep the counts before each write.
fn add_shared(h: &mut CountHolder, n: i64) -> List[i64]:
    let mut kept: List[i64] = []
    let mut i: i64 = 0
    while i < n:
        keep := h.store
        make_unique(&mut h.store, copy_count).n += 1
        kept.push(keep.n)
        i += 1
    kept

tests:
    use std.testing.{assert, it}

    it("a reference to a local writes the local"):
        let mut n = +1
        bump(&mut n)
        r := &mut n
        *r = *r + 10
        assert(n == 12, "the writes reached the local")

    it("writing through `&mut` to a local in a loop allocates nothing"):
        let mut total = +0
        let round = +0
        before := allocated()
        while round < 100:
            bump(&mut total)
            r := &mut total
            *r = *r + 1
            round = round + 1
        assert(allocated() == before, "no round allocated a block")
        assert(total == 200, "every round wrote the local twice")

    it("a reference bound to a local declared in a loop allocates nothing"):
        # The local lives in a slot of the frame (DESIGN.md §23.38).
        let round = +0
        let total = +0
        before := allocated()
        while round < 100:
            let mut n = round
            r := &mut n
            *r = *r + 1
            total = total + *r
            round = round + 1
        assert(allocated() == before, "no round allocated a block")
        assert(total == 5050, "every round wrote through its reference")

    it("a getter's source declared in a loop allocates nothing"):
        let round = +0
        let total = +0
        before := allocated()
        while round < 100:
            pair := Pair { left: round, right: 1 }
            total = total + *pair.left() + pair.right
            round = round + 1
        assert(allocated() == before, "no round allocated a block")
        assert(total == 5050, "every round read through the getter")

    it("consuming an iterator allocates nothing per call"):
        # Each consumer's cursor lives in its frame (DESIGN.md §23.38).
        let round = +0
        let total: i64 = 0
        before := allocated()
        while round < 100:
            total = total + Upto { at: 0, end: 4 }.fold(0, add)
            assert(allocated() == before, "fold allocated no block")
            total = total + Upto { at: 0, end: 4 }.sum()
            assert(allocated() == before, "sum allocated no block")
            total = total + i64(Upto { at: 0, end: 4 }.count())
            assert(allocated() == before, "count allocated no block")
            if Upto { at: 0, end: 4 }.any(odd) && Upto { at: 0, end: 4 }.all(small):
                total = total + 1
            assert(allocated() == before, "any and all allocated no block")
            # Measure find without Option.eq's payload-view allocations.
            match Upto { at: 0, end: 4 }.find(odd):
                .Some(1) => total = total + 1
                _ => pass
            assert(allocated() == before, "find allocated no block")
            round = round + 1
        assert(total == 100 * (6 + 6 + 4 + 2), "every consumer read every item")

    it("an element reference lasts for its call"):
        let mut xs = [+1, 2, 3]
        bump(&mut xs[1])
        xs.push(4)
        assert(xs.len() == 4 && xs[1] == 3, "the push ran after the call")

    it("references taken in a loop run in bounded memory"):
        let round = +0
        let start: usize = 0
        let right = +0
        while round < 2030:
            if round == 30:
                start = pages()
            let mut n = round
            bump(&mut n)
            let mut xs = [label(round), label(n)]
            for s in &mut xs:
                *s = *s + "!"
            if xs[0] == label(round) + "!" && xs[1] == label(round + 1) + "!":
                right = right + 1
            grow(&mut xs, round)
            xs.push(label(round))
            round = round + 1
        assert(right == 2030, "every round wrote through its references")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "each cell, pin and list is freed")

    it("inlined field loans take no parent count"):
        point := box(Pair { left: +0, right: +1 })
        before := retained()
        let round = +0
        while round < 1000:
            twice_left(point)
            round += 1
        assert(retained() == before, "the caller keeps the parent alive")
        assert(point.left == 2000 && point.right == 1, "every field write reached the parent")

    it("inlined field loans release their fresh owners"):
        before := live()
        let round = +0
        let sum = +0
        while round < 1000:
            sum += projected_round(round)
            round += 1
        assert(sum == 501500, "every projected field write reached the parent")
        assert(live() == before, "no fresh projected owner remains live")

    it("a caller's local reference keeps recursive stored field loans alive"):
        point := box(TextCell { value: "live".repeat(20) })
        before := retained()
        assert(borrowed_depth(point, 40) == 41 * 80, "each recursive field loan stays valid")
        assert(retained() == before, "the caller's loan needs no parent count")
        assert(point.value.len() == 80, "the parent remains valid after recursion")

    it("inlined mutable field loans preserve counted referents"):
        point := box(TextCell { value: "live".repeat(20) })
        before := retained()
        let round = +0
        while round < 1000:
            assert(field_length(point) == 80, "the mutable loan reads the same string")
            round += 1
        assert(retained() == before, "the field loan takes no parent count")
        assert(point.value.len() == 80, "the counted referent remains valid")

    it("moving stored field loans preserves cleanup"):
        before := live()
        let round = +0
        let sum = +0
        while round < 1000:
            sum += projected_read_round(round)
            round += 1
        assert(sum == 2497500, "every moved field loan reads its parent")
        assert(live() == before, "each fresh projected owner is released once")

    it("a read-only closure borrows its physical reference parameter"):
        point := box(+42)
        reference := &*point
        before := retained()
        let round = +0
        while round < 1000:
            assert(
                closure_number(fn(value): *value, reference) == 42,
                "the closure reads its caller's value",
            )
            round += 1
        assert(retained() == before, "the closure takes no referent count")
        assert(*reference == 42, "the caller's loan stays valid")

    it("closure copies and dependent results preserve erased reference cleanup"):
        before := live()
        let round = +0
        let total: usize = 0
        while round < 1000:
            total += closure_view_round(round)
            round += 1
        assert(total > 60000, "every copy and dependent field result stays valid")
        assert(live() == before, "every copied value and fresh view is released once")

    it("unique_mut lends an unshared box and refuses a shared one"):
        let mut p: *Count = box(Count { n: 1 })
        assert(write_unique(&mut p, 5), "an unshared box is lent")
        assert(p.n == 5, "the write reached the box")
        let q = p
        assert(!write_unique(&mut p, 7), "a shared box is refused")
        assert(p.n == 5 && q.n == 5, "the shared box is unchanged")

    it("a copy-on-write loop copies a shared box once"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        add_upto(&mut h, 4)
        assert(h.store.n == 6, "an unshared box is written in place")
        keep := h.store
        before := allocated()
        add_upto(&mut h, 4)
        assert(allocated() - before <= 1, "one copy at most, then the copy is written in place")
        assert(h.store.n == 12 && keep.n == 6, "the shared box keeps its value")

    it("make_unique writes an unshared box in place and copies a shared one"):
        let mut p: *Count = box(Count { n: 1 })
        before := allocated()
        make_unique(&mut p, copy_count).n = 5
        assert(allocated() == before, "an unshared box is written in place")
        assert(p.n == 5, "the write reached the box")
        q := p
        make_unique(&mut p, copy_count).n = 7
        assert(allocated() - before <= 1, "a shared box is copied once")
        assert(p.n == 7 && q.n == 5, "the shared box keeps its value")

    it("a make_unique loop copies a shared box once, before the loop"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        add_made(&mut h, 4)
        assert(h.store.n == 6, "an unshared box is written in place")
        keep := h.store
        before := allocated()
        add_made(&mut h, 4)
        assert(allocated() - before <= 1, "one copy, then the copy is written in place")
        assert(h.store.n == 12 && keep.n == 6, "the shared box keeps its value")
        add_made(&mut h, 0)
        assert(h.store.n == 12, "an empty loop writes nothing")

    it("an empty make_unique loop over a shared box copies nothing"):
        let mut h = CountHolder { store: box(Count { n: 3 }) }
        keep := h.store
        before := allocated()
        add_made(&mut h, 0)
        assert(allocated() == before, "the loop runs no iteration, so nothing is copied")
        shared := match unique_mut(&mut h.store):
            .Some(_) => false
            .None => true
        assert(shared && keep.n == 3, "the box stays shared")

    it("an outer loop whose inner write loop is empty copies nothing"):
        let mut h = CountHolder { store: box(Count { n: 3 }) }
        keep := h.store
        before := allocated()
        add_rows(&mut h, 4, 0)
        assert(allocated() == before, "no inner iteration ran, so nothing is copied")
        add_rows(&mut h, 2, 3)
        assert(allocated() - before <= 1, "one copy, then the copy is written in place")
        assert(h.store.n == 9 && keep.n == 3, "the shared box keeps its value")

    it("a make_unique loop that leaves before its first write copies nothing"):
        let mut h = CountHolder { store: box(Count { n: 3 }) }
        keep := h.store
        before := allocated()
        add_until(&mut h, 4, 0)
        add_until_true(&mut h, 0)
        add_skipping(&mut h, 4, 4)
        add_or_return(&mut h, 4, 0)
        assert(allocated() == before, "no iteration reaches the write, so nothing is copied")
        shared := match unique_mut(&mut h.store):
            .Some(_) => false
            .None => true
        assert(shared && keep.n == 3, "the box stays shared")

    it("a make_unique loop that leaves after a write copies a shared box once"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        keep := h.store
        before := allocated()
        add_until(&mut h, 4, 2)
        assert(allocated() - before <= 1, "one copy, then the copy is written in place")
        add_until_true(&mut h, 2)
        add_skipping(&mut h, 4, 3)
        add_or_return(&mut h, 4, 3)
        assert(allocated() - before <= 1, "the copy stays unique")
        assert(h.store.n == 1 + 1 + 4 + 3 && keep.n == 0, "the shared box keeps its value")

    it("two writes of a parameter's box test its count once"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        keep := h.store
        make_twice(&mut h, 4, 3)
        assert(h.store.n == 7 && keep.n == 0, "the first write copied the shared box")
        make_twice(&mut h, 1, 1)
        assert(h.store.n == 2, "an unshared box is written in place")

    it("make_unique loops the passes leave alone write each iteration"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        keep := h.store
        add_while_counting(&mut h, 3)
        assert(h.store.n == 6 && keep.n == 0, "a loop with a call in its test")
        add_grid(&mut h, 3)
        assert(h.store.n == 15, "an inner loop")
        add_matched(&mut h, 3)
        assert(h.store.n == 18, "a match arm that always runs")
        add_picked(&mut h, 3)
        assert(h.store.n == 21, "a place behind a call")
        add_with(&mut h, 3, copy_count)
        assert(h.store.n == 24, "a copy function value")
        add_with_a_call(&mut h, 3)
        assert(h.store.n == 27, "a loop that calls a writing function")
        shared := h.store
        add_resetting(&mut h, 4)
        assert(h.store.n == 105 && shared.n == 27, "a new box stored in the loop")
        other := CountHolder { store: box(Count { n: 50 }) }
        add_sharing(&mut h, &other, 4)
        assert(h.store.n == 55 && other.store.n == 50, "a shared box stored in the loop")
        let boxed: *mut CountHolder = box(CountHolder { store: box(Count { n: 1 }) })
        add_boxed(boxed, 3)
        assert(boxed.store.n == 4, "a holder in a box")
        p := box(Count { n: 10 })
        assert(sum_in_a_local(p, 4) == 16 && p.n == 10, "a box in a local")
        add_suspending!(&mut h, 3)
        assert(h.store.n == 58, "a loop that suspends")

    it("a loop that shares the box on each iteration copies it on each write"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        kept := add_shared(&mut h, 3)
        assert(h.store.n == 3, "every write reached the box")
        assert(kept == [0, 1, 2], "each shared copy keeps the count before its write")

    it("two tests of one place share the found-unique flag"):
        let mut h = CountHolder { store: box(Count { n: 0 }) }
        keep := h.store
        set_twice(&mut h, 3, 4)
        assert(h.store.n == 7 && keep.n == 0, "the first test copies, the second writes the copy")
