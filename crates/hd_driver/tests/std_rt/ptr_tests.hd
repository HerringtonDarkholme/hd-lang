# The hd tests of std.rt.memory's typed memory
# (spec/lang/10-modules.md#typed-memory). Only std may use a runtime
# module, so the conformance runner adds this file to std as
# `std.rt.ptr_tests` and runs its cases on the linear backend
# (crates/hd_driver/tests/conformance.rs, `STD_RT_TESTS`).
use std.rt.memory.{Ptr, grow, load_u8, load_u32, pages, size_of, store_u32}
use std.rt.checked.released

struct Body:
    mass: f64
    id: i32
    alive: bool

fn fresh_page() -> usize:
    match grow(1):
        .Some(before) => before * 65536
        .None => panic("the heap cannot grow by one page")

fn label(n: i32) -> string:
    "n$n"

tests:
    use std.testing.{assert, it}

    it("size_of gives each number type's width in bytes"):
        assert(size_of::[u8]() == 1, "u8")
        assert(size_of::[i8]() == 1, "i8")
        assert(size_of::[bool]() == 1, "bool")
        assert(size_of::[u16]() == 2, "u16")
        assert(size_of::[i16]() == 2, "i16")
        assert(size_of::[u32]() == 4, "u32")
        assert(size_of::[i32]() == 4, "i32")
        assert(size_of::[f32]() == 4, "f32")
        assert(size_of::[char]() == 4, "char")
        assert(size_of::[usize]() == 4, "usize on Wasm32")
        assert(size_of::[u64]() == 8, "u64")
        assert(size_of::[i64]() == 8, "i64")
        assert(size_of::[f64]() == 8, "f64")
        assert(size_of::[Body]() >= 13, "a struct holds its fields")

    it("offset moves by whole values of T"):
        let p: Ptr[i64] = Ptr { address: 1000 }
        assert(p.offset(0).address == 1000, "offset 0 is the same address")
        assert(p.offset(3).address == 1024, "3 values of 8 bytes")
        let q: Ptr[u8] = Ptr { address: 1000 }
        assert(q.offset(3).address == 1003, "3 values of 1 byte")

    it("a number written reads back, in its own bytes only"):
        at := fresh_page()
        let p: Ptr[i32] = Ptr { address: at }
        p.offset(1).write(-2)
        assert(load_u32(at) == 0, "the value before is untouched")
        assert(load_u32(at + 8) == 0, "the value after is untouched")
        assert(load_u32(at + 4) == 0xfffffffe, "4 bytes, least significant first")
        assert(p.offset(1).read() == -2, "the value reads back")
        let b: Ptr[u8] = Ptr { address: at }
        b.write(0xab)
        assert(load_u8(at) == 0xab, "a u8 is one byte")
        assert(load_u8(at + 1) == 0, "the next byte is untouched")
        store_u32(at + 16, 7)
        assert(p.offset(4).read() == +7, "an untyped store reads as a typed value")

    it("a struct written reads back whole"):
        at := fresh_page()
        let p: Ptr[Body] = Ptr { address: at }
        p.write(Body { mass: 1.5, id: +3, alive: true })
        p.offset(1).write(Body { mass: -2.0, id: +4, alive: false })
        first := p.read()
        second := p.offset(1).read()
        assert(first.mass == 1.5 && first.id == +3 && first.alive, "the first value")
        assert(second.mass == -2.0 && second.id == +4 && !second.alive, "the second value")

    it("a write stores a copy, which a later change of the source misses"):
        at := fresh_page()
        let p: Ptr[List[i32]] = Ptr { address: at }
        let mut xs = [+1, +2]
        p.write(xs)
        xs.push(+3)
        back := p.read()
        assert(back.len() == 2, "the copy keeps its length")
        assert(xs.len() == 3, "the source changed")

    it("a counted value written and read back keeps its text"):
        at := fresh_page()
        let p: Ptr[Option[string]] = Ptr { address: at }
        p.write(.Some(label(+12)))
        p.offset(1).write(.None)
        assert(p.read() == .Some("n12"), "the payload reads back")
        assert(p.offset(1).read() == .None, "the empty variant reads back")

    it("writes and reads of counted values run in bounded memory"):
        at := fresh_page()
        let p: Ptr[string] = Ptr { address: at }
        p.write(label(+0))
        _ := p.read()
        start := pages()
        let n = +0
        while n < 200000:
            p.write(label(n))
            text := p.read()
            assert(text.len() > 1, "each value reads back")
            n = n + 1
        # The checked runtime never reuses a block (crates/hd_wasm_linear/DESIGN.md §23.24).
        if released() == 0:
            assert(pages() <= start + 1, "each value read back is released")
