# The release-glue tests for std.rt.Drop. The conformance runner adds this
# file to std as `std.rt_tests.drop_tests`, since only std may implement the
# runtime trait.
use std.rt.Drop
use std.rt.cycle.marking
use std.collections.{UniqList, UniqListIntoIter, UniqMap}
use std.iter.Iterable
use std.rt.memory.pages
use std.rt.checked.released

let log = ""
let box_drops: usize = 0
let enum_drops: usize = 0
let list_drops: usize = 0
let cycle_drops: usize = 0
let empty_drops: usize = 0
let cursor_cycle_drops: usize = 0

struct Inner:
    name: string

impl Drop for Inner:
    fn drop(&mut self) -> void:
        log = log + self.name

struct Outer:
    name: string
    inner: Inner

impl Drop for Outer:
    fn drop(&mut self) -> void:
        log = log + self.name

fn make_and_release() -> void:
    _ := Outer { name: "outer,", inner: Inner { name: "inner" } }

struct Token:
    kind: usize

impl !Copy for Token

impl Drop for Token:
    fn drop(&mut self) -> void:
        match self.kind:
            0 => box_drops = box_drops + 1
            1 => enum_drops = enum_drops + 1
            _ => list_drops = list_drops + 1

enum Payload:
    Token(Token)

fn release_box() -> void:
    _ := box(Token { kind: 0 })

fn release_enum() -> void:
    _ := Payload.Token(Token { kind: 1 })

fn release_list() -> void:
    let mut items = UniqList::[Token].new()
    items.push(Token { kind: 2 })

fn take_list(items: UniqList[Token]) -> usize:
    items.len()

fn release_param() -> void:
    let mut items = UniqList::[Token].new()
    items.push(Token { kind: 2 })
    items.push(Token { kind: 2 })
    _ := take_list(items)

fn release_popped() -> void:
    let mut items = UniqList::[Token].new()
    items.push(Token { kind: 2 })
    items.push(Token { kind: 2 })
    items.push(Token { kind: 2 })
    _ := items.pop()
    items.truncate(1)

fn release_map() -> void:
    let mut items = UniqMap::[usize, Token].new()
    for key in 0..20:
        _ := items.insert(key, Token { kind: 2 })
    _ := items.insert(3, Token { kind: 2 })
    _ := items.remove(4)

fn release_cursor[T < ?Copy](value: T) -> void:
    pass

fn release_list_cursor(taken: usize) -> void:
    let mut items = UniqList::[Token].new()
    for _ in 0..3:
        items.push(Token { kind: 2 })
    let mut cursor = Iterable::[Token]::iter(items)
    for _ in 0..taken:
        _ := cursor.next()
    release_cursor(cursor)

fn release_map_cursor(taken: usize) -> void:
    let mut items = UniqMap::[string, Token].new()
    for index in 0..4:
        _ := items.insert("key-$index", Token { kind: 2 })
    _ := items.remove("key-1")
    let mut cursor = Iterable::[(string, Token)]::iter(items)
    for _ in 0..taken:
        _ := cursor.next()
    release_cursor(cursor)

fn scalars(n: i32) -> usize:
    let mut items = UniqList::[i32].new()
    for i in 0..n:
        items.push(i)
    items.len()

struct EmptyToken: pass

impl !Copy for EmptyToken

impl Drop for EmptyToken:
    fn drop(&mut self) -> void:
        if !marking():
            empty_drops = empty_drops + 1

fn release_empty_cursor(taken: usize) -> void:
    let mut items = UniqList::[EmptyToken].with_capacity(4)
    for _ in 0..4:
        items.push(EmptyToken {})
    let mut cursor = Iterable::[EmptyToken]::iter(items)
    for _ in 0..taken:
        _ := cursor.next()

struct CycleToken:
    next: (*mut CycleToken)?

# A trace runs `drop` in every pass; the count changes only outside one
# that marks or scans (`module.rt.drop.trace`).
impl Drop for CycleToken:
    fn drop(&mut self) -> void:
        if !marking():
            cycle_drops = cycle_drops + 1

struct CursorCycle:
    cursor: UniqListIntoIter[*mut CursorCycle]?

impl !Copy for CursorCycle

impl Drop for CursorCycle:
    fn drop(&mut self) -> void:
        if !marking():
            cursor_cycle_drops = cursor_cycle_drops + 1

fn release_cursor_cycle() -> void:
    node := box(CursorCycle { cursor: .None })
    let mut items = UniqList::[*mut CursorCycle].new()
    items.push(node)
    items.push(node)
    let mut cursor = Iterable::[*mut CursorCycle]::iter(items)
    _ := cursor.next()
    node.cursor = .Some(cursor)

struct Pressure:
    next: (*mut Pressure)?

fn release_cycle() -> void:
    token := box(CycleToken { next: .None })
    token.next = .Some(token)
    for _ in 0..200000:
        pressure := box(Pressure { next: .None })
        pressure.next = .Some(pressure)

tests:
    use std.testing.{assert, it}

    it("release glue calls Drop before releasing fields"):
        log = ""
        make_and_release()
        assert(log == "outer,inner", "the outer hook ran before its field's hook: $log")

    it("a boxed value calls Drop exactly once"):
        box_drops = 0
        release_box()
        assert(box_drops == 1, "a boxed value drops once: $box_drops")

    it("an enum payload calls Drop exactly once"):
        enum_drops = 0
        release_enum()
        assert(enum_drops == 1, "an enum payload drops once: $enum_drops")

    it("a UniqList element calls Drop exactly once"):
        list_drops = 0
        release_list()
        assert(list_drops == 1, "a UniqList element drops once: $list_drops")

    it("a UniqList parameter drops each element once"):
        list_drops = 0
        release_param()
        assert(list_drops == 2, "both elements drop once: $list_drops")

    it("a UniqList drops what pop and truncate remove, then the rest"):
        list_drops = 0
        release_popped()
        assert(list_drops == 3, "each element drops once: $list_drops")

    it("a UniqMap drops each value once"):
        list_drops = 0
        release_map()
        assert(list_drops == 21, "each value drops once: $list_drops")

    it("a consuming list cursor releases its rest at every consumption point"):
        for taken in 0..=3:
            list_drops = 0
            release_list_cursor(taken)
            assert(list_drops == 3, "yielded and unyielded values drop once: $list_drops")

    it("a consuming map cursor releases its rest and skips removed entries"):
        for taken in 0..=3:
            list_drops = 0
            release_map_cursor(taken)
            assert(list_drops == 4, "removed, yielded and unyielded values drop once: $list_drops")

    it("UniqLists of scalars free their rooms"):
        _ := scalars(+8)
        start := pages()
        let total: usize = 0
        for _ in 0..100000:
            total += scalars(+8)
        assert(total == 800000, "each list holds eight: $total")
        if released() == 0:
            assert(pages() <= start + 1, "each room is freed")

    it("a collector-freed cycle calls Drop exactly once"):
        cycle_drops = 0
        release_cycle()
        assert(cycle_drops == 1, "the collected cycle drops once: $cycle_drops")

    it("a consuming cursor drops zero-sized items once at every position"):
        for taken in 0..=4:
            empty_drops = 0
            release_empty_cursor(taken)
            assert(empty_drops == 4, "each logical element drops once: $empty_drops")

    it("a partially consumed cursor traces only its unread range in a cycle"):
        cursor_cycle_drops = 0
        release_cursor_cycle()
        for _ in 0..200000:
            pressure := box(Pressure { next: .None })
            pressure.next = .Some(pressure)
        assert(cursor_cycle_drops == 1, "the cursor cycle drops once: $cursor_cycle_drops")
