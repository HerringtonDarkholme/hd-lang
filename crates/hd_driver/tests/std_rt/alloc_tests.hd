# The hd tests of std.rt.alloc (crates/hd_wasm/DESIGN.md §23.6). Only std
# may use a runtime module, so the conformance runner adds this file to std
# as `std.rt_tests.alloc_tests` and runs its cases on the linear backend
# (crates/hd_driver/tests/conformance.rs, `STD_RT_TESTS`). Each case runs
# in an instance of its own, so each starts with a fresh heap.
use std.rt.alloc.{
    alloc,
    alloc_class,
    block_bytes,
    block_of,
    block_size,
    free,
    free_class,
    reclaim,
    release,
    release_known,
    retain,
    retain_known,
}
use std.rt.cycle.{collect, pending}
use std.rt.memory.{grow, load_u32, pages, store_u32, store_u8}

PAGE := 65536

fn unexpected_trace(block: usize) -> void:
    panic("a candidate without counts is freed, not traced")

fn unexpected_release(address: usize) -> void:
    panic("a candidate without counts releases nothing")

tests:
    use std.testing.{assert, it}

    it("a block's size is its class, or whole pages over 32 KiB"):
        assert(block_size(0) == 16, "the smallest class")
        assert(block_size(16) == 16, "16 bytes fit class 1")
        assert(block_size(17) == 32, "17 bytes take class 2")
        assert(block_size(128) == 128, "the last class in steps of 16")
        assert(block_size(129) == 160, "then about 25% apart")
        assert(block_size(1601) == 2048, "the last one-page class")
        assert(block_size(2049) == 2560, "the first medium class")
        assert(block_size(32768) == 32768, "the last medium class")
        assert(block_size(32769) == PAGE, "a large block is a page")
        assert(block_size(PAGE + 1) == 2 * PAGE, "or a run of pages")

    it("blocks of one class come from one page, in order"):
        a := alloc(1)
        b := alloc(16)
        assert(a % 16 == 0, "a block is 16-aligned")
        assert(a % PAGE == 16, "a fresh page's first slot follows its header")
        assert(b == a + 16, "the next slot of the class")
        c := alloc(17)
        assert(c / PAGE != a / PAGE, "another class has a page of its own")
        assert(alloc(32) == c + 32, "its next slot is 32 bytes on")

    it("a freed block is the next one its class gives"):
        a := alloc(24)
        b := alloc(24)
        free(a)
        assert(alloc(24) == a, "the freed slot comes back first")
        free(b)
        free(a)
        assert(alloc(24) == a, "the last freed slot comes back first")
        assert(alloc(24) == b, "then the one freed before it")

    it("an address inside a block finds the block"):
        a := alloc(100)
        b := alloc(100)
        assert(block_of(a) == a, "a block's own address")
        assert(block_of(a + 99) == a, "its last byte")
        assert(block_of(b + 5) == b, "inside the next block")
        run := alloc(70000)
        assert(block_of(run + PAGE + 10) == run, "a later page of a large run")
        assert(block_of(run + 69999) == run, "the run's last byte")
        assert(block_of(16) == 0, "static data is in no block")
        assert(block_of(a / PAGE * PAGE) == 0, "a page header is in no block")

    it("a large run spans whole pages"):
        run := alloc(100000)
        assert(run % PAGE == 0, "a run starts on a page")
        store_u8(run + 2 * PAGE - 1, 7)
        small := alloc(8)
        assert(small < run || small >= run + 2 * PAGE, "no block lies in the run")

    it("an empty page returns to the pool unless it heads its class"):
        # A page holds 31 blocks of 2 KiB, so the 32nd starts a second.
        first := alloc(2048)
        let n: usize = 1
        while n < 31:
            _ := alloc(2048)
            n = n + 1
        second := alloc(2048)
        assert(second / PAGE != first / PAGE, "the 32nd block is on a new page")
        free(first)
        free(second)
        assert(alloc(PAGE) == second / PAGE * PAGE, "a run reuses the empty page")
        a := alloc(40)
        free(a)
        assert(alloc(40) == a, "the only page of a class stays with it")

    it("freed runs next to each other make one run"):
        first := alloc(PAGE)
        second := alloc(PAGE)
        assert(second == first + PAGE, "two runs side by side")
        free(first)
        free(second)
        assert(alloc(2 * PAGE) == first, "the freed pages hold a run of two")

    it("blocks over many pages all come back"):
        # Each block holds the address of the one before, so the chain
        # needs no list.
        first := alloc(16)
        store_u32(first, 0)
        let last = first
        let count: usize = 1
        while count < 10000:
            block := alloc(16)
            store_u32(block, u32(last))
            last = block
            count = count + 1
        assert(last / PAGE != first / PAGE, "the blocks fill more than one page")
        let seen: usize = 0
        while last != 0:
            assert(block_of(last) == last, "each block finds itself")
            before := usize(load_u32(last))
            free(last)
            last = before
            seen = seen + 1
        assert(seen == 10000, "every block is in the chain")

    it("pages another part of the program grew stay out of the allocator"):
        _ := alloc(16)
        grown := match grow(1):
            .Some(page) => page * PAGE
            .None => 0
        assert(grown != 0, "the heap grows")
        assert(block_of(grown) == 0, "the grown page is in no block")
        run := alloc(PAGE)
        assert(run != grown, "the allocator does not hand it out")

    it("a count goes up and down through any address in its block"):
        a := alloc(32)
        store_u32(a, 1)
        # No release glue, so the cycle collector leaves it alone.
        store_u32(a + 4, 0)
        retain(a + 12)
        assert(load_u32(a) == 2, "an interior address counts its block")
        assert(release(a + 8) == 0, "a count is left")
        assert(load_u32(a) == 1, "one count is left")
        assert(release(a + 20) == a, "the last count gives the block")
        retain(16)
        assert(release(16) == 0, "static data has no count")

    it("every class-span offset uses the exact reciprocal quotient"):
        let sizes: List[usize] = [
            16,
            32,
            48,
            64,
            80,
            96,
            112,
            128,
            160,
            208,
            256,
            320,
            400,
            512,
            640,
            800,
            1024,
            1280,
            1600,
            2048,
            2560,
            3200,
            4096,
            5120,
            6400,
            8192,
            10240,
            12800,
            16384,
            20480,
            25600,
            32768,
        ]
        for size in sizes:
            first := alloc(size)
            page := first / PAGE * PAGE
            let offset: usize = 0
            span := if size <= 2048: PAGE else: 4 * PAGE
            while offset < span - 16:
                expected := page + 16 + offset / size * size
                assert(
                    block_of(page + 16 + offset) == expected,
                    "the class table gives the exact slot",
                )
                offset += 1

    it("known payload counts agree with interior-address counts"):
        block := alloc(32)
        store_u32(block, 1)
        store_u32(block + 4, 0)
        retain_known(block + 8)
        assert(load_u32(block) == 2, "a known payload increments its header")
        assert(release_known(block + 8) == 0, "the first release leaves one count")
        assert(release(block + 15) == block, "an interior release sees the same final count")
        free(block)
        retain_known(0)
        assert(release_known(0) == 0, "null stays uncounted")
        retain_known(16)
        assert(release_known(16) == 0, "a static zero-count header stays uncounted")

    it("known releases leave acyclic blocks out of the candidate buffer"):
        block := alloc(32)
        store_u32(block, 3)
        store_u32(block + 4, 1)
        before := pending()
        assert(release_known(block + 8) == 0, "two counts remain")
        assert(release_known(block + 8) == 0, "one count remains")
        assert(pending() == before, "nonzero glue alone does not make a candidate")
        assert(release_known(block + 8) == block, "the final count returns the block")
        free(block)

    it(
        "known releases buffer cyclic blocks once, and a collection frees one whose last count went",
    ):
        block := alloc(64)
        store_u32(block, 3)
        store_u32(block + 4, 0x80000001)
        before := pending()
        assert(release_known(block + 8) == 0, "the shared cyclic block stays live")
        assert(pending() == before + 1, "the block becomes a candidate")
        assert((usize(load_u32(block + 4)) & 0x40000000) != 0, "the candidate is marked buffered")
        assert(release_known(block + 8) == 0, "one count remains")
        assert(pending() == before + 1, "a second release does not buffer twice")
        assert(release_known(block + 8) == block, "the final release returns the block")
        assert(pending() == before + 1, "the candidate stays in the buffer")
        free(block)
        assert(load_u32(block) == 0, "free leaves the candidate in the buffer with no count")
        collect(unexpected_trace, unexpected_release, free)
        assert(pending() == before, "the collection frees it and empties its entry")
        assert(alloc(64) == block, "its block is reused")

    it("constant classes agree with block classification"):
        let sizes: List[usize] = [
            16,
            32,
            48,
            64,
            80,
            96,
            112,
            128,
            160,
            208,
            256,
            320,
            400,
            512,
            640,
            800,
            1024,
            1280,
            1600,
            2048,
            2560,
            3200,
            4096,
            5120,
            6400,
            8192,
            10240,
            12800,
            16384,
            20480,
            25600,
            32768,
        ]
        for i in 0..sizes.len():
            bytes := sizes[i]
            first := alloc_class(bytes - 1, i + 1)
            assert(block_bytes(first) == bytes, "the supplied class matches the page table")
            assert(block_of(first + bytes - 1) == first, "the entire class belongs to the block")
            free_class(first, i + 1)
            second := alloc_class(bytes, i + 1)
            assert(second == first, "the freed slot is reused")
            free_class(second, i + 1)

    it("constant-class frees wait on the freed list until reclaim retires empty non-head pages"):
        let mut slots: List[usize] = []
        for i in 0..32:
            slots.push(alloc_class(2048, 20))
        first := slots[0]
        second_page := slots[31]
        assert(first / PAGE != second_page / PAGE, "the 32nd slot crosses a page boundary")
        free_class(first, 20)
        assert(alloc_class(2048, 20) == first, "a freed block is reused first")
        free_class(second_page, 20)
        for i in 0..31:
            free_class(slots[i], 20)
        assert(block_of(second_page) == second_page, "a listed block's page still counts it")
        reclaim()
        assert(block_of(second_page) == 0, "an empty non-head page returns to the pool")
        again := alloc_class(2048, 20)
        assert(again / PAGE == first / PAGE, "the empty head page stays cached")
        free_class(again, 20)

    it("medium slots cross pages and release through interior addresses"):
        let mut blocks: List[usize] = []
        for i in 0..12:
            block := alloc(25600)
            store_u32(block, 1)
            store_u32(block + 4, 0)
            blocks.push(block)
        for block in blocks:
            assert(block_bytes(block) == 25600, "later-page starts keep the span class")
            assert(block_of(block + 25599) == block, "the last byte resolves across pages")
            retain(block + 25599)
            assert(release(block + 16384) == 0, "an interior retain belongs to one block")
            assert(release(block + 25599) == block, "the final release finds the slot")
            free(block)

    it("empty medium spans return all pages to the pool"):
        # Seven 32 KiB slots fit a four-page span after its header.
        let mut blocks: List[usize] = []
        for i in 0..8:
            blocks.push(alloc_class(32768, 32))
        first := blocks[0] / PAGE * PAGE
        second := blocks[7] / PAGE * PAGE
        assert(
            second >= first + 4 * PAGE || first >= second + 4 * PAGE,
            "the eighth slot starts a disjoint span",
        )
        free_class(blocks[7], 32)
        for i in 0..7:
            free_class(blocks[i], 32)
        reclaim()
        for i in 0..4:
            assert(block_of(first + i * PAGE + 32) == 0, "every first-span page is free")
            assert(block_of(second + i * PAGE + 32) == 0, "every second-span page is free")
        run := alloc(4 * PAGE)
        assert(run == first, "the earliest entire span is reusable")
        free(run)

    it("medium metadata survives page-table relocation"):
        first := alloc_class(25600, 31)
        _ := match grow(17000):
            .Some(before) => before
            .None => panic("the heap can reserve space for a table move")
        _ := alloc(32768)
        assert(block_bytes(first) == 25600, "the moved prefix keeps its size table")
        assert(block_of(first + 25599) == first, "the moved prefix keeps its reciprocal")
        free_class(first, 31)
        assert(alloc_class(25600, 31) == first, "the moved prefix keeps freed lists")
        free_class(first, 31)

    it("one hundred thousand live 2.1 KiB lists fit the heap"):
        before := pages()
        let mut lists: List[List[usize]] = []
        for i in 0..100000:
            lists.push([for j in 0..528 => i + j])
        after := pages()
        assert(after - before < 6000, "medium lists share spans instead of taking pages")
        assert(lists.len() == 100000, "every list remains live")
        for i in 0..lists.len():
            assert(lists[i][0] == i, "the first element stays intact")
            assert(lists[i][527] == i + 527, "the last element stays intact")

    it("a failed large search preserves smaller holes and newly freed runs"):
        first := alloc(PAGE)
        second := alloc(PAGE)
        free(first)
        large := alloc(2 * PAGE)
        assert(alloc(PAGE) == first, "a smaller request reuses the skipped hole")
        free(first)
        free(second)
        assert(alloc(2 * PAGE) == first, "freeing pages invalidates a failed-search proof")
        free(first)
        free(large)
