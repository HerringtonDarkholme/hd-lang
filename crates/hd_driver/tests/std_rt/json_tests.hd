# The hd tests of `std.json.decode`'s one-pass key-loop reader (#1809): it
# names each key's member in text order, skips unknown values once, and
# lets a syntax error anywhere in the text win over a typed error.
# The conformance runner adds this file to std as `std.rt_tests.json_tests`.
use std.json.{decode, parse, Json, JsonError}
use std.serde.{Deserialize, Deserializer, Serialize}

@derive(Serialize, Deserialize, Debug, Eq)
struct Point:
    x: i64
    y: i64

@derive(Serialize, Deserialize, Debug, Eq)
struct Row:
    id: i64
    name: string
    at: Point
    tags: List[string]

@derive(Serialize, Deserialize, Debug, Eq)
struct Node:
    label: string
    kids: List[Node]

# More than 16 members, so the reader lists its keys in a map.
@derive(Serialize, Deserialize, Debug, Eq)
struct Wide:
    a0: i64
    a1: i64
    a2: i64
    a3: i64
    a4: i64
    a5: i64
    a6: i64
    a7: i64
    a8: i64
    a9: i64
    b0: i64
    b1: i64
    b2: i64
    b3: i64
    b4: i64
    b5: i64
    b6: i64
    b7: i64

# A reader that reads its object's first value and stops: `decode` may run
# it before the end of the text is checked (std-json.decode.parse-error.v2),
# and the parse error still wins.
struct Guarded:
    value: i64

impl Deserialize for Guarded:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Guarded, R::Error]:
        input.begin_map()?
        _ := input.next_key()?
        .Ok(Guarded { value: input.int("i64")? })

fn nested(depth: i32) -> string:
    let mut parts: List[string] = []
    let i = +0
    while i < depth:
        parts.push("{\"skip\":{\"deep\":[1,{\"a\":[]}]},\"kids\":[")
        i = i + 1
    let j = +0
    parts.push("{\"label\":\"leaf\",\"kids\":[]}")
    while j < depth:
        parts.push("],\"label\":\"n$j\"}")
        j = j + 1
    parts.join("")

fn brackets(depth: i32) -> string:
    let mut parts: List[string] = []
    let i = +0
    while i < depth:
        parts.push("[")
        i = i + 1
    while i > 0:
        parts.push("]")
        i = i - 1
    parts.join("")

fn depth_of(node: Node) -> i32:
    if node.kids.len() == 0:
        return +0
    1 + depth_of(node.kids[0])

tests:
    use std.testing.{assert, it}

    it("reads keys in any order"):
        found := decode::[Row](
            "{\"tags\":[\"t\"],\"at\":{\"y\":2,\"x\":1},\"name\":\"n\",\"id\":7}",
        )
        assert(
            found == .Ok(Row { id: 7, name: "n", at: Point { x: 1, y: 2 }, tags: ["t"] }),
            "every member found",
        )

    it("steps over unknown keys that hold nested values"):
        text := "{\"skip\":[{\"a\":[1,[2,{\"b\":\"]}\"}]]}],\"id\":3,\"more\":{\"x\":{\"y\":[[],{}]}},\"name\":\"q\",\"at\":{\"z\":[1],\"x\":4,\"y\":5},\"tags\":[]}"
        assert(
            (
                decode::[Row](text)
                == .Ok(Row { id: 3, name: "q", at: Point { x: 4, y: 5 }, tags: [] })
            ),
            "unknown members skipped",
        )

    it("scans list items of every kind between recorded containers"):
        texts := [
            "[ \"a\\\"]\" , \"b\\\\\" ,\"\\u005d\",-1.5e3 , true,false , null,0 ]",
            "[ [ ] , { } , [ 1 , [ ] , { \"k\" : [ { } ] } ] , \"}\" ]",
            "{\"a\":[1,\"x\",[2,{\"b\":[]}],{}],\"c\":{ },\"d\":[ ]}",
            " [ ] ",
            "17",
        ]
        for text in texts:
            assert(decode::[Json](text) == parse(text), "decode reads what parse reads")
        strings := decode::[List[string]]("[\"a]\",\"b\\\"\", \"c\" ]")
        assert(strings == .Ok(["a]", "b\"", "c"]), "strings with brackets and escapes")
        lists := decode::[List[List[i64]]]("[[1, 2], [], [3]]")
        assert(lists == .Ok([[1, 2], [], [3]]), "lists of lists")

    it("rejects a repeated record key"):
        found := decode::[Point]("{\"x\":1,\"y\":2,\"x\":3}")
        assert(found == .Err(JsonError.DuplicateField("$.x")), "a repeated key is an error")
        escaped := decode::[Point]("{\"x\":1,\"y\":2,\"\\u0078\":3}")
        assert(escaped == .Err(JsonError.DuplicateField("$.x")), "an escaped repeat too")

    it("reads distinct keys that share a length and first byte"):
        found := decode::[Point]("{\"xa\":0,\"xb\":0,\"y\":2,\"x\":1}")
        assert(found == .Ok(Point { x: 1, y: 2 }), "every member found")

    it("matches escaped keys"):
        found := decode::[Point]("{\"\\u0078\":1,\"y\\u0000\":9,\"y\":2}")
        assert(found == .Ok(Point { x: 1, y: 2 }), "escaped key decoded")

    it("reads a record of more than 16 members in any order"):
        text := "{\"b7\":17,\"b6\":16,\"b5\":15,\"b4\":14,\"b3\":13,\"b2\":12,\"b1\":11,\"b0\":10,\"a9\":9,\"a8\":8,\"a7\":7,\"a6\":6,\"a5\":5,\"a4\":4,\"a3\":3,\"a2\":2,\"a1\":1,\"a0\":-1}"
        match decode::[Wide](text):
            .Ok(wide) =>
                assert(
                    wide.a0 == -1 && wide.a1 == 1 && wide.b0 == 10 && wide.b7 == 17,
                    "wide record read",
                )
            .Err(_) => assert(false, "wide record failed")
        repeated := decode::[Wide](text.replace("\"b7\":17", "\"a0\":7,\"b7\":17"))
        match repeated:
            .Err(error) => assert(error == JsonError.DuplicateField("$.a0"), "wide repeat")
            .Ok(_) => assert(false, "wide repeat accepted")

    it("names keys of a wide record by scan, then by its name table, escaped or not"):
        # Reversed keys miss every guess: the first 64 misses of a decode
        # scan the members, later ones use the type's name table.
        names := ["a0", "a1", "a2", "a3", "a4", "a5", "a6", "a7", "a8", "a9", "b0", "b1", "b2", "b3", "b4", "b5", "b6", "b7"]
        let mut objects: List[string] = []
        for row in 0..8:
            let mut parts: List[string] = []
            let at = names.len()
            while at > 0:
                at -= 1
                key := if row % 3 == 2 && at == 1: "\\u0061\\u0031" else: names[at]
                parts.push("\"$key\":${row * 100 + at}")
                if at == 9:
                    parts.push("\"zz\":{\"a0\":[1]}")
            objects.push("{" + parts.join(",") + "}")
        match decode::[List[Wide]]("[" + objects.join(",") + "]"):
            .Ok(rows) =>
                assert(rows.len() == 8, "every row")
                assert(rows[7].a1 == 701 && rows[7].b7 == 717 && rows[0].a0 == 0, "every member found")
                assert(rows[2].a1 == 201 && rows[5].a1 == 501, "escaped keys found")
            .Err(error) => assert(false, "wide rows failed: $error")

    it("reads deep nesting with skipped members at every level"):
        match decode::[Node](nested(40)):
            .Ok(node) =>
                assert(node.label == "n39", "outer label")
                assert(depth_of(node) == 40, "every level read")
            .Err(_) => assert(false, "deep record failed")
        assert(decode::[Json](brackets(128)).is_ok(), "128 levels read")
        assert(
            decode::[Json](brackets(129)) == .Err(JsonError.NestingTooDeep(128)),
            "129 levels rejected",
        )

    it("reports a decode error's path through the index"):
        found := decode::[List[Row]](
            "[{\"id\":1,\"name\":\"a\",\"at\":{\"x\":1,\"y\":2},\"tags\":[]},{\"at\":{\"y\":\"no\",\"x\":1},\"id\":2,\"name\":\"b\",\"tags\":[]}]",
        )
        assert(
            (
                found == .Err(JsonError.WrongType("\$[1].at.x", "i64"))
                || found == .Err(JsonError.WrongType("\$[1].at.y", "i64"))
            ),
            "path of the bad member",
        )
        missing := decode::[Row]("{\"id\":1,\"at\":{\"x\":1,\"y\":2},\"tags\":[]}")
        assert(missing == .Err(JsonError.MissingField("\$.name")), "missing member")

    it("reports a syntax error after a member that would fail decoding"):
        found := decode::[Row](
            "{\"id\":\"wrong\",\"name\":\"a\",\"at\":{\"x\":1,\"y\":2},\"tags\":[] x}",
        )
        assert(found == .Err(JsonError.UnexpectedCharacter(54)), "the parse error wins")
        nested_bad := decode::[Row](
            "{\"id\":true,\"at\":{\"x\":1,\"y\":2,},\"name\":\"a\",\"tags\":[]}",
        )
        assert(nested_bad == .Err(JsonError.UnexpectedCharacter(29)), "a nested parse error wins")

    it("returns the parse error after a reader that stopped early"):
        match decode::[Guarded]("{\"value\":1"):
            .Err(error) => assert(error == JsonError.UnexpectedEnd(10), "the parse error returned")
            .Ok(_) => panic("malformed text accepted")
        match decode::[List[Guarded]]("[{\"value\":1},]"):
            .Err(error) =>
                assert(error == JsonError.UnexpectedCharacter(13), "the parse error returned")
            .Ok(_) => panic("malformed text accepted")
        match decode::[Guarded]("{\"value\":1,\"more\":[2]}"):
            .Ok(found) => assert(found.value == 1, "valid text keeps the value")
            .Err(error) => panic("valid text rejected: $error")
