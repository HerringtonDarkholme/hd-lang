# The hd tests of std.thread, std.rt.thread and the wait intrinsics
# (spec/lang/10-modules.md#thread-intrinsics, spec/std/thread.md). Only
# std may use a runtime module, so the conformance runner adds this file
# to std as `std.rt_tests.thread_tests` (crates/hd_driver/tests/conformance.rs,
# `STD_RT_TESTS`). A program that starts threads shares its heap with them.
use std.collections.{UniqList, UniqMap}
use std.core.{Eq, Hash}
use std.marker.Send
use std.rt.alloc.{alloc, block_of, free_block}
use std.rt.memory.{
    atomic_add_u32,
    atomic_load_u32,
    atomic_notify,
    atomic_wait_u32,
    load_u32,
    pages,
    Ptr,
    store_u32,
    string_bytes,
}
use std.rt.unique
use std.task.{join, race}
use std.testing.{assert, assert_equal}
use std.thread.{Handle, Scope, background, scope}

# A word on the shared heap: the program's own bindings are there too, so
# each thread reads the address the first one stored.
COUNTER := alloc(16)

# How many blocks each side allocates, and the addresses of the main
# thread's blocks and of a thread's.
COUNT := 20000
MINE := alloc(4 * COUNT)
THEIRS := alloc(4 * COUNT)

# Allocates COUNT blocks, each holding `first` plus its number, and keeps
# their addresses at `list`.
fn allocate(list: usize, first: usize) -> void:
    let i: usize = 0
    while i < COUNT:
        block := alloc(48)
        store_u32(block, u32(first + i))
        store_u32(list + 4 * i, u32(block))
        i = i + 1

# Whether every block at `list` still holds `first` plus its number.
fn intact(list: usize, first: usize) -> bool:
    let i: usize = 0
    while i < COUNT:
        if load_u32(usize(load_u32(list + 4 * i))) != u32(first + i):
            return false
        i = i + 1
    true

fn release(list: usize) -> void:
    let i: usize = 0
    while i < COUNT:
        free_block(usize(load_u32(list + 4 * i)))
        i = i + 1

# Waits until both threads arrive, so that what follows runs at once.
fn arrive() -> void:
    _ := atomic_add_u32(COUNTER, 1)
    _ := atomic_notify(COUNTER, u32(0xffffffff))
    while atomic_load_u32(COUNTER) < 2:
        _ := atomic_wait_u32(COUNTER, 1, -1)

fn add_one() -> void:
    _ := atomic_add_u32(COUNTER, 1)

fn stop() -> i32:
    panic("a thread stops")
    0

# The gates that background threads wait at until a task opens them.
GATE := alloc(4)
LATE := alloc(4)

fn opened(gate: usize) -> void:
    while atomic_load_u32(gate) == 0:
        _ := atomic_wait_u32(gate, 0, -1)

fn gated(gate: usize, text: string) -> string:
    opened(gate)
    text.repeat(2)

# Opens `gate` from a task, which runs only while the task that awaits
# the gated thread is suspended, not its thread.
fn open!(gate: usize) -> string:
    store_u32(gate, 1)
    _ := atomic_notify(gate, u32(0xffffffff))
    "open"

fn now!(text: string) -> string:
    text

# Waits at `gate`, then counts its end in COUNTER.
fn counted(gate: usize) -> u32:
    opened(gate)
    add_one()
    1

fn none!() -> u32:
    0

# A `Send` crossing that runs its closure here and gives its value: the
# captures cross as they would into a thread (fn.crossing.mode.unique).
fn crossed[T < ?Copy & Send](code: fn() -> T + Send) -> T:
    code()

# The count of the block that holds `address`, 0 in static data.
fn count_at(address: usize) -> u32:
    block := block_of(address)
    if block == 0: 0 else: load_u32(block)

# The buffer a list holds, and the bytes a string views.
fn buffer[T](items: &List[T]) -> usize:
    usize(load_u32(address_of(items)))

fn bytes_of(text: &string) -> usize:
    string_bytes(*text).address

@intrinsic("mem_ref_address")
fn address_of[T < ?Copy](target: &T) -> usize:
    panic("intrinsic")

# Whether two strings view different bytes.
fn apart(text: &string, other: &string) -> bool:
    bytes_of(text) != bytes_of(other)

# Where a map's first key's bytes are.
fn first_key(entries: &UniqMap[string, string]) -> usize:
    for key in entries.keys():
        return bytes_of(&key)
    0

# The table a map holds.
fn table[K < Eq & Hash, V](entries: &Map[K, V]) -> usize:
    usize(load_u32(address_of(entries)))

# The forms a capture may hold a buffer in.
struct Held:
    items: List[string]
    name: string
    n: i32

enum Shape:
    Dot
    Words(List[string])

type Label(string)

# A value with no buffer, which a thread may borrow (module.marker.sync).
struct Point:
    x: i32
    y: i32

fn crossed_generic[T < Send & 'static](value: T) -> T:
    crossed(fn() -> T: value)

# How often each side changes its own list at once with the other.
ROUNDS := 20000

# `items` with its first element pushed and popped ROUNDS times, which
# counts it up and down, and then `mark`; once both threads arrived.
fn changed(items: List[string], mark: string) -> List[string]:
    arrive()
    let mut items = items
    let i: usize = 0
    while i < ROUNDS:
        items.push(items[0])
        _ := items.pop()
        i = i + 1
    items.push(mark)
    items

# `value + 1`, from a thread of the scope `s`, which a function takes.
fn on_thread(s: &mut Scope, value: i32) -> i32:
    s.spawn(fn() -> i32: value + 1).join()

tests:
    it("a thread's work has run when join returns"):
        store_u32(COUNTER, 0)
        scope(fn(s: &mut Scope) -> void:
            s.spawn(fn() -> void: add_one()).join()
        )
        assert_equal(atomic_load_u32(COUNTER), 1u32)

    it("a scope waits for the threads whose handles it dropped"):
        store_u32(COUNTER, 0)
        scope(fn(s: &mut Scope) -> void:
            for _ in 0..4:
                _ := s.spawn(fn() -> void: add_one())
        )
        assert_equal(atomic_load_u32(COUNTER), 4u32)

    it("handles give their values in any order, and a scope passes on whole"):
        word := "ab".repeat(2)
        total := scope(fn(s: &mut Scope) -> usize:
            first := s.spawn(fn() -> usize: word.len())
            second := s.spawn(fn() -> List[string]: ["x".repeat(3)])
            second.join()[0].len() + first.join() + usize(on_thread(s, 1))
        )
        assert_equal(total, word.len() + 5)

    it("a dropped handle's value is dropped where its thread ends"):
        lengths := scope(fn(s: &mut Scope) -> usize:
            _ := s.spawn(fn() -> List[string]: ["x".repeat(3)])
            s.spawn(fn() -> List[string]: ["y".repeat(2)]).join()[0].len()
        )
        assert_equal(lengths, 2)

    it("a handle that leaves its scope still gives its value"):
        handle := scope(fn(s: &mut Scope) -> Handle[string]:
            s.spawn(fn() -> string: "z".repeat(2))
        )
        assert_equal(handle.join(), "zz")

    it("a thread borrows a frozen reference until its scope ends"):
        point := Point { x: 3, y: 4 }
        at := &point
        sum := scope(fn(s: &mut Scope) -> i32:
            s.spawn(fn() -> i32: at.x + at.y).join() + at.x
        )
        assert_equal(sum, 10)

    it("join of a thread that stopped panics", expect_panic="thread-stopped"):
        _ := scope(fn(s: &mut Scope) -> i32:
            s.spawn(fn() -> i32: stop()).join()
        )

    it("a scope panics once every thread ended when one stopped", expect_panic="thread-stopped"):
        store_u32(COUNTER, 0)
        scope(fn(s: &mut Scope) -> void:
            _ := s.spawn(fn() -> i32: stop())
            _ := s.spawn(fn() -> void: add_one())
        )

    it("a wait for a value the word does not hold returns 1"):
        store_u32(COUNTER, 3)
        assert_equal(atomic_wait_u32(COUNTER, 7, -1), 1u32)

    it("a wait past its time returns 2"):
        store_u32(COUNTER, 3)
        assert_equal(atomic_wait_u32(COUNTER, 3, 1000), 2u32)

    it("a notify with no waits wakes none"):
        assert_equal(atomic_notify(COUNTER, 1), 0u32)

    it("two threads allocate at once and their blocks never overlap"):
        store_u32(COUNTER, 0)
        scope(fn(s: &mut Scope) -> void:
            thread := s.spawn(fn() -> void:
                arrive()
                allocate(THEIRS, 0)
            )
            arrive()
            allocate(MINE, COUNT)
            thread.join()
        )
        assert(intact(THEIRS, 0) && intact(MINE, COUNT))

    it("blocks a thread frees go back to the heap that allocated them"):
        allocate(MINE, 0)
        scope(fn(s: &mut Scope) -> void:
            s.spawn(fn() -> void: release(MINE)).join()
        )
        before := pages()
        first := load_u32(MINE)
        allocate(MINE, COUNT)
        assert_equal(pages(), before)
        assert(intact(MINE, COUNT))
        let reused = false
        let i: usize = 0
        while i < COUNT:
            reused = reused || load_u32(MINE + 4 * i) == first
            i = i + 1
        assert(reused)

    it("a thread that starts after one ended adopts its heap and reuses its freed blocks"):
        scope(fn(s: &mut Scope) -> void:
            s.spawn(fn() -> void: allocate(THEIRS, 0)).join()
        )
        release(THEIRS)
        before := pages()
        scope(fn(s: &mut Scope) -> void:
            s.spawn(fn() -> void: allocate(THEIRS, 0)).join()
        )
        assert_equal(pages(), before)
        assert(intact(THEIRS, 0))

    it("a crossing copies a shared list and its strings; each thread changes its own"):
        word := "ab".repeat(3)
        mine := [word, "cd".repeat(2)]
        theirs := crossed(fn() -> List[string]: mine)
        assert(buffer(&theirs) != buffer(&mine))
        assert_equal(count_at(buffer(&theirs)), 1u32)
        assert(bytes_of(&theirs[0]) != bytes_of(&word))
        assert_equal(count_at(bytes_of(&theirs[0])), 1u32)
        store_u32(COUNTER, 0)
        let (back, own) = scope(fn(s: &mut Scope) -> (List[string], List[string]):
            thread := s.spawn(fn() -> List[string]: changed(theirs, "t"))
            own := changed(mine, "m")
            (thread.join(), own)
        )
        assert_equal(back, ["ababab", "cdcd", "t"])
        assert_equal(own, ["ababab", "cdcd", "m"])
        assert_equal(mine, ["ababab", "cdcd"])
        assert_equal(word, "ababab")

    it("a crossing moves a buffer that no one else holds, as it is"):
        let mine = ["ab".repeat(3), "cd".repeat(2)]
        list := buffer(&mine)
        text := bytes_of(&mine[0])
        theirs := crossed(fn() -> List[string]: mine)
        assert_equal(count_at(list), 1u32)
        assert_equal(bytes_of(&theirs[0]), text)
        assert_equal(buffer(&theirs), list)

    it("a crossing makes a map's table, its keys and its values unique"):
        key := "k".repeat(2)
        values := ["v".repeat(2)]
        entries := { key: values }
        theirs := crossed(fn() -> Map[string, List[string]]: entries)
        for (k, v) in &theirs:
            assert(bytes_of(k) != bytes_of(&key))
            assert(buffer(v) != buffer(&values))
            assert_equal(count_at(bytes_of(k)), 1u32)
        assert(table(&theirs) != table(&entries))
        assert_equal(count_at(bytes_of(&key)), 2u32)
        assert_equal(entries, { key: values })
        counts := { 1: 2 }
        own := crossed(fn() -> Map[i32, i32]: counts)
        assert(table(&own) != table(&counts))
        assert_equal(count_at(table(&own)), 1u32)
        assert_equal(own, counts)

    it("a struct crosses with buffers of its own"):
        word := "ab".repeat(3)
        held := Held { items: [word], name: word, n: 1 }
        got := crossed(fn() -> Held: held)
        assert(apart(&got.items[0], &word) && apart(&got.name, &word))
        assert_equal(held.name, word)

    it("a tuple, a newtype, an option, an enum and a union cross with buffers of their own"):
        word := "ab".repeat(3)
        pair := (word, Label(word))
        let maybe: string? = .Some(word)
        shape := Shape.Words([word])
        let either: string | i32 = ._0(word)
        let (both, one, words, member) = crossed(
            fn() -> ((string, Label), string?, Shape, string | i32): (pair, maybe, shape, either)
        )
        let (text, label) = both
        unwrapped := string(label)
        assert(apart(&text, &word) && apart(&unwrapped, &word))
        match one:
            .Some(text) => assert(apart(&text, &word))
            .None => assert(false)
        match words:
            .Words(items) => assert(apart(&items[0], &word))
            .Dot => assert(false)
        match member:
            ._0(text) => assert(apart(&text, &word))
            ._1(_) => assert(false)
        let (kept, _) = pair
        assert_equal(kept, word)

    it("a generic value and a nested closure's capture cross with buffers of their own"):
        word := "ab".repeat(3)
        deep := crossed_generic([[word]])
        assert(apart(&deep[0][0], &word))
        outer := crossed(fn() -> usize:
            crossed(fn() -> usize: 0) + bytes_of(&word)
        )
        assert(outer != bytes_of(&word))
        inner := crossed(fn() -> string:
            (fn() -> string: word)()
        )
        assert(apart(&inner, &word))

    it("unique copies the shared strings a UniqList and a UniqMap hold"):
        word := "ab".repeat(3)
        let mut owned: UniqList[string] = UniqList::new()
        owned.push(word)
        let mut keyed: UniqMap[string, string] = UniqMap::new()
        keyed[word] = word
        unique(&mut owned)
        unique(&mut keyed)
        here := bytes_of(&word)
        assert(
            (
                bytes_of(&owned[0]) != here
                && bytes_of(&keyed[word]) != here
                && first_key(&keyed) != here
            ),
        )

    it("background gives the value its thread's closure returned"):
        word := "ab".repeat(2)
        assert_equal(background!(fn() -> string: word + "c"), "ababc")

    it("a task runs on while background waits for its thread"):
        store_u32(GATE, 0)
        let (text, opened) = join!(background(fn() -> string: gated(GATE, "ab")), open(GATE))
        assert_equal(text + opened, "ababopen")

    it("a cancelled background returns at once, and its thread runs on"):
        store_u32(LATE, 0)
        store_u32(COUNTER, 0)
        won := race!(background(fn() -> u32: counted(LATE)), none())
        assert_equal((won, atomic_load_u32(COUNTER)), (0u32, 0u32))
        _ := open!(LATE)
        while atomic_load_u32(COUNTER) == 0:
            _ := atomic_wait_u32(COUNTER, 0, 1000000)

    it("background of a thread that stopped panics", expect_panic="thread-stopped"):
        _ := background!(fn() -> i32: stop())
