        assert_equal(
            hash_string(
                "->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz",
                18446744073709551615u64,
            ),
            3225516294u32,
        )
        assert_equal(
            hash_string(
                "->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWh",
                18446744073709551615u64,
            ),
            1370281280u32,
        )
        assert_equal(
            hash_string(
                "->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3DUfw):K\\m~0ARct&7HYj{->O`q#4EVgx*;L]n 1BSdu'8IZk|.?Par\$5FWhy+<M^o!2CTev(9J[l}/@Qbs%6GXiz,=N_p\"3",
                18446744073709551615u64,
            ),
            2992991963u32,
        )
        assert_equal(hash_string("hé🙂漢字", 0u64), 2215734121u32)
        assert_equal(hash_string("hé🙂漢字", 1u64), 78199910u32)
        assert_equal(hash_string("hé🙂漢字", 18446744073709551615u64), 2256722765u32)

    it("canonical Hash bytes preserve sponge crossings and raw byte writes"):
        assert_equal(hash_key(StreamKey0 {}, 0u64), 289446562u32)
        assert_equal(hash_key(StreamKey1 {}, 0u64), 3231654477u32)
        assert_equal(hash_key(StreamKey2 {}, 0u64), 1575145332u32)
        assert_equal(hash_key(StreamKey3 {}, 0u64), 3401088151u32)
        assert_equal(hash_key(StreamKey4 {}, 0u64), 2241051510u32)
        assert_equal(hash_key(StreamKey5 {}, 0u64), 4037217772u32)
        assert_equal(hash_key(StreamKey0 {}, 1u64), 667104166u32)
        assert_equal(hash_key(StreamKey1 {}, 1u64), 107776722u32)
        assert_equal(hash_key(StreamKey2 {}, 1u64), 1035078816u32)
        assert_equal(hash_key(StreamKey3 {}, 1u64), 2169446648u32)
        assert_equal(hash_key(StreamKey4 {}, 1u64), 1482709122u32)
        assert_equal(hash_key(StreamKey5 {}, 1u64), 4144913961u32)
        assert_equal(hash_key(StreamKey0 {}, 18446744073709551615u64), 467805393u32)
        assert_equal(hash_key(StreamKey1 {}, 18446744073709551615u64), 3231654477u32)
        assert_equal(hash_key(StreamKey2 {}, 18446744073709551615u64), 2273441253u32)
        assert_equal(hash_key(StreamKey3 {}, 18446744073709551615u64), 2849172291u32)
        assert_equal(hash_key(StreamKey4 {}, 18446744073709551615u64), 1002211661u32)
        assert_equal(hash_key(StreamKey5 {}, 18446744073709551615u64), 2366655773u32)

    it("hash_of is foldhash's default fixed state over the Hash bytes"):
        assert_equal(DefaultHasher::new().finish(), 589684135938649225u64)
        assert_equal(hash_of(42u32), 9174106799469798059u64)
        assert_equal(hash_of(18364758544493064720u64), 10628260816633449540u64)
        assert_equal(hash_of("hd"), 1927349526242060103u64)
        let pair: (u8, string) = (7, "a")
        assert_equal(hash_of(pair), 16210116857368862073u64)
        # Eight length bytes and 40 text bytes: two full sponge blocks and a third.
        assert_equal(
            hash_of("abcdefghijklmnopqrstuvwxyz0123456789ABCD"),
            1336580192291833804u64,
        )
        assert_equal(hash_of(""), 16200781398385399916u64)
        assert_equal(hash_of("abcdefgh"), 1975664701518251446u64)
        assert_equal(hash_of("abcdefghijklmnop"), 9251196824928732509u64)
        assert_equal(hash_of("abcdefghijklmnopq"), 16705508687924400420u64)

    it("empty Hash streams preserve the supplied seed"):
        assert_equal(hash_key(EmptyKey {}, 0u64), 0u32)
        assert_equal(hash_key(EmptyKey {}, 1u64), 1u32)
        assert_equal(hash_key(EmptyKey {}, 18446744073709551615u64), 4294967295u32)

    it("seed requests remain effects across consecutive calls and loops"):
        first := map_hash_seed()
        second := map_hash_seed()
        assert(first != second)
        let previous = second
        for _ in 0..8:
            current := map_hash_seed()
            assert(current != previous)
            previous = current
