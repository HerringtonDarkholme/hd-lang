# The hd tests of lists on the linear backend (crates/hd_wasm_linear/DESIGN.md
# §23.17): a list's buffer grows, copies only when shared, and frees its
# elements at its last release, so building lists in a loop runs in
# bounded memory; `string_from_bytes` takes over a buffer nothing else
# holds and copies a shared one. Only std may read the heap's size, so the conformance
# runner adds this file to std as `std.rt.list_tests`.
use std.rt.memory.{Ptr, grow, load_u32, pages, string_bytes}
use std.rt.checked.released
use std.text.StringBuilder

struct Row:
    name: string
    cells: List[i32]

fn label(n: i32) -> string:
    "n$n"

fn names(n: i32) -> List[string]:
    let mut out: List[string] = []
    let i = +0
    while i < n:
        out.push(label(i))
        i = i + 1
    out

fn rows(n: i32) -> List[Row]:
    let mut out: List[Row] = []
    let i = +0
    while i < n:
        out.push(Row { name: label(i), cells: [i, i + 1] })
        i = i + 1
    out

fn fresh_page() -> usize:
    match grow(1):
        .Some(before) => before * 65536
        .None => panic("the heap cannot grow by one page")

# The address of the buffer of `bytes`, read from a copy of the list
# written at `at` and moved out again, so the buffer's count is as it was.
fn buffer_address(at: usize, bytes: List[u8]) -> usize:
    let p: Ptr[List[u8]] = Ptr { address: at }
    p.write(bytes)
    address := usize(load_u32(at))
    _ := p.read()
    address

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# Room in `items` for at least `count` more elements; 0 does nothing.
@intrinsic("list_reserve")
fn list_reserve[T](items: &mut List[T], count: usize) -> void:
    panic("intrinsic")

tests:
    use std.testing.{assert, it}

    it("a growing list keeps every element in order"):
        let mut xs: List[i32] = []
        let i = +0
        while i < 100000:
            xs.push(i * 2)
            i = i + 1
        assert(xs.len() == 100000, "every push landed")
        assert(xs[0] == 0 && xs[50000] == 100000 && xs[99999] == 199998, "in order")

    it("lists of strings built in a loop run in bounded memory"):
        let total: usize = 0
        let round = +0
        let start: usize = 0
        while round < 330:
            if round == 30:
                start = pages()
            let built = names(1000)
            total = total + built[999].len()
            round = round + 1
        assert(total == 1320, "each list was whole while held")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "each list's buffers and strings are reused")

    it("lists of structs holding lists free every inner list"):
        let cells = +0
        let round = +0
        let start: usize = 0
        while round < 330:
            if round == 30:
                start = pages()
            let built = rows(500)
            cells = cells + built[499].cells[1]
            round = round + 1
        assert(cells == 165000, "each row kept its cells")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "the rows' lists and names are reused")

    it("a copy shares its buffer until either side changes"):
        let mut xs: List[string] = ["a", "b" + "c"]
        let mut ys = xs
        ys.push("d")
        xs[0] = "z"
        assert(xs.len() == 2 && ys.len() == 3, "the push changed ys only")
        assert(ys[0] == "a" && xs[0] == "z", "the store changed xs only")
        let mut grid: List[List[i32]] = [[+1], [2]]
        let mut other = grid
        other[0].push(5)
        assert(grid[0].len() == 1 && other[0].len() == 2, "the inner lists are apart")

    it("copies made and changed in a loop run in bounded memory"):
        let base = names(100)
        let round = +0
        let start: usize = 0
        while round < 20000:
            if round == 30:
                start = pages()
            let mut copy = base
            copy.push("x")
            assert(copy.len() == 101, "the copy grew")
            round = round + 1
        assert(base.len() == 100, "the source is unchanged")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "each copy's buffer is reused")

    it("extends of counted lists in a loop run in bounded memory"):
        base := names(50)
        more := rows(20)
        let total: usize = 0
        let round = +0
        let start: usize = 0
        while round < 3000:
            if round == 30:
                start = pages()
            let mut words = base
            words.extend(base)
            words.extend(words)
            let mut built: List[Row] = []
            built.extend(more)
            built.extend(built)
            built[0].cells.push(1)
            total = total + words.len() + built.len() + built[0].cells.len()
            round = round + 1
        assert(total == 3000 * 243, "each extend kept every element")
        assert(base.len() == 50 && more[0].cells.len() == 2, "the sources are unchanged")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() == start, "each extended list's buffers are reused")

    it("a for loop iterates the list as it was"):
        let mut xs: List[i32] = [+1, 2, 3]
        let seen = +0
        for x in xs:
            xs.push(x)
            seen = seen + 1
        assert(seen == 3 && xs.len() == 6, "the pushes were not visited")

    it("string_from_bytes views an unshared buffer's bytes in place"):
        at := fresh_page()
        let mut bytes: List[u8] = [104, 105]
        bytes.push(33)
        buffer := buffer_address(at, bytes)
        text := string_from_bytes(bytes)
        assert(string_bytes(text).address == buffer + 16, "the string took over the list's buffer")
        assert(text == "hi!", "the bytes read as the string")

    it("list_reserve grows the buffer once for every later push"):
        at := fresh_page()
        let mut bytes: List[u8] = [97]
        list_reserve(&mut bytes, 50)
        buffer := buffer_address(at, bytes)
        assert(load_u32(buffer) >= 51, "room for the element and 50 more")
        let i = +0
        while i < 50:
            bytes.push(98)
            i = i + 1
        assert(buffer_address(at, bytes) == buffer, "no push moved the buffer")
        assert(bytes.len() == 51 && bytes[0] == 97 && bytes[50] == 98, "every byte kept")
        list_reserve(&mut bytes, 0)
        assert(buffer_address(at, bytes) == buffer, "reserving 0 changes nothing")

    it("list_reserve copies a shared buffer, which the other holder keeps"):
        at := fresh_page()
        let mut bytes: List[u8] = [120, 121]
        bytes.push(122)
        kept := bytes
        buffer := buffer_address(at, bytes)
        list_reserve(&mut bytes, 0)
        assert(buffer_address(at, bytes) == buffer, "reserving 0 copies nothing")
        list_reserve(&mut bytes, 1)
        assert(buffer_address(at, bytes) != buffer, "the list has its own buffer")
        bytes[0] = 65
        assert(kept[0] == 120 && bytes[0] == 65 && bytes.len() == 3, "the other holder is unchanged")

    it("StringBuilder.reserve makes the room in one buffer"):
        out := StringBuilder::new()
        out.reserve(100)
        let i = +0
        while i < 100:
            out.push_ascii(97)
            i = i + 1
        text := out.build()
        # The string took over the builder's buffer, whose first word is
        # its capacity: exactly the room reserved, so no push grew it.
        assert(usize(load_u32(string_bytes(text).address - 16)) == 100, "one buffer of the reserved size")
        assert(text.len() == 100, "every byte kept")

    it("string_from_bytes copies a shared buffer, which a later change misses"):
        at := fresh_page()
        let mut bytes: List[u8] = [120, 121]
        buffer := buffer_address(at, bytes)
        let mut kept = bytes
        text := string_from_bytes(bytes)
        assert(string_bytes(text).address != buffer + 16, "the string has bytes of its own")
        kept[0] = 122
        assert(text == "xy", "a change of the other holder misses the string")
        assert(kept[0] == 122, "the other holder changed")

    it("strings made from lists in a loop run in bounded memory"):
        let total: usize = 0
        let round = +0
        let start: usize = 0
        while round < 3000:
            if round == 300:
                start = pages()
            let mut bytes: List[u8] = [97, 98]
            bytes.push(99)
            total = total + string_from_bytes(bytes).len()
            round = round + 1
        assert(total == 9000, "each string was whole while held")
        if released() == 0:
            assert(pages() == start, "each taken-over buffer is freed with its string")

    it("string builders in a loop run in bounded memory"):
        let total: usize = 0
        let round = +0
        let start: usize = 0
        while round < 3000:
            if round == 300:
                start = pages()
            out := StringBuilder::new()
            let i = +0
            while i < 20:
                out.push(label(i)).push_char('é').push_ascii(33)
                i = i + 1
            total = total + out.build().len()
            round = round + 1
        assert(total == 3000 * 110, "each built string was whole while held")
        if released() == 0:
            assert(pages() == start, "each builder's buffer is freed with its string")
