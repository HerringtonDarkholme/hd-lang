# The hd tests of std.rt.cycle (crates/hd_wasm_linear/DESIGN.md §23.28), the cycle
# collector: a loop that drops reference cycles runs in bounded memory,
# since a collection frees each cycle once the candidate buffer is full.
# Only std may read the heap's size, so the conformance runner adds this
# file to std as `std.rt.cycle_tests`, as it does count_tests.hd.
use std.rt.alloc.{alloc, free_block}
use std.rt.cycle.{collect, opaque, pending, suspect}
use std.rt.memory.{pages, store_u32}
use std.rt.checked.released
use std.testing.assert

# The heap's pages in a bounded run: the static page, the page table, a
# page for each size class the objects use, the garbage dropped before a
# collection (the candidate buffer's threshold of 10,000), and the buffer.
# The rings take 23 pages; without the collector they take 430.
BOUND := 32

struct Stop:
    name: string
    next: &mut Stop?

fn ring(round: i32) -> i32:
    first := &mut Stop { name: "first $round", next: .None }
    second := &mut Stop { name: "second $round", next: .Some(first) }
    first.next = .Some(second)
    match first.next:
        .Some(stop) => if stop.name == "second $round": 1 else: 0
        .None => 0

fn sum_to(limit: i32) -> i32:
    sum := fn(n: i32) -> i32:
        if n == 0: 0
        else: n + sum(n - 1)
    sum(limit)

fn biased_sum_to(limit: i32, seed: i32) -> i32:
    sum := fn(n: i32) -> i32:
        if n == 0: seed
        else: n + sum(n - 1)
    sum(limit)

struct FrameRing:
    value: i32
    task: mut Suspend[i32]?

fn frame_value!(ring: &mut FrameRing) -> i32:
    ring.value

fn frame_ring(n: i32) -> i32:
    ring := &mut FrameRing { value: n, task: .None }
    ring.task = .Some(frame_value(ring))
    ring.value

fn captured_frame_ring(n: i32) -> i32:
    ring := &mut FrameRing { value: n, task: .None }
    run := fn!() -> i32: ring.value
    ring.task = .Some(run())
    ring.value

struct Body:
    x: f64
    tags: List[string]

# Each takes its argument as its own copy, so a caller that keeps the
# value gives a count that the callee's release leaves above zero.
fn floats(xs: List[f64]) -> i32:
    i32(xs.len())

fn bodies(xs: List[Body]) -> i32:
    i32(xs.len())

fn apply(f: fn(i32) -> i32) -> i32:
    f(1)


struct Dir:
    value: i32
    kids: List[Dir]

fn directory_total(dir: Dir) -> i32:
    let total = dir.value
    for child in dir.kids:
        total += directory_total(child)
    total

struct ListRing:
    value: i32
    next: List[&mut ListRing]

fn list_count(xs: List[&mut ListRing]) -> usize:
    xs.len()

fn copied_list_ring(n: i32) -> i32:
    first := &mut ListRing { value: n, next: [] }
    xs := [first]
    first.next = xs
    assert(list_count(xs) == 1, "a copied cyclic list keeps its element")
    first.next[0].value


let traced: usize = 0
let probe: usize = 0

fn trace_probe(block: usize) -> void:
    if block == probe:
        traced = traced + 1

fn unexpected_release(address: usize) -> void:
    panic("a live probe frame must not be released")

fn unexpected_free(block: usize) -> void:
    panic("a live probe frame must not be freed")


tests:
    it("a running frame remains a candidate until its saved slots are stable"):
        block := alloc(64)
        probe = block
        store_u32(block, 1)
        # A descriptor naming glue, with the bit that makes it take part.
        store_u32(block + 4, 0x80000001)
        # task::F_FLAGS follows the counted header; RUNNING is 128.
        store_u32(block + 20, 128)
        opaque(block + 8)
        suspect(block)
        traced = 0
        collect(trace_probe, unexpected_release, unexpected_free)
        assert(traced == 0, "a running frame's saved slots are not read")
        store_u32(block + 20, 0)
        collect(trace_probe, unexpected_release, unexpected_free)
        assert(traced > 0, "the deferred candidate is traced once it is idle")
        free_block(block)

    use std.testing.{assert, it}

    it("values of acyclic types never become candidates"):
        before := pending()
        let xs: List[f64] = [1.0, 2.0]
        let bs: List[Body] = [Body { x: 1.0, tags: ["a"] }]
        n := +3
        add := fn(k: i32) -> i32: k + n
        let total = +0
        let round = +0
        while round < 1000:
            total = total + floats(xs) + bodies(bs) + apply(add)
            round = round + 1
        assert(pending() == before, "no list, struct or closure of acyclic types became a candidate")
        assert(total == 7000 && xs.len() == 2 && bs.len() == 1 && add(0) == 3, "the values stay alive")
        _ := ring(+1)
        assert(pending() > before, "a dropped ring of references is a candidate")

    it("two hundred thousand dropped rings run in bounded memory"):
        let total = +0
        let round = +0
        while round < 200000:
            total = total + ring(round)
            round = round + 1
        assert(total == 200000, "each ring reaches its second stop")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() <= BOUND, "the rings' blocks are reused")

    it("two hundred thousand dropped recursive closures run in bounded memory"):
        let total = +0
        let round = +0
        while round < 200000:
            total = total + sum_to(round % 10)
            round = round + 1
        assert(total == 3300000, "each closure sums its range")
        # Checked frees quarantine blocks; only the normal allocator reuses them.
        if released() == 0:
            assert(pages() <= BOUND, "the closures' blocks are reused")

    it("two hundred thousand immutable recursive closures make no candidates"):
        before := pending()
        let total = +0
        for round in 0..200000:
            total += sum_to(round % 10)
            total += biased_sum_to(round % 10, 1)
        assert(total == 6800000, "recursive closures keep their own captured seed")
        assert(pending() == before, "neither a cell nor an environment back-link becomes a candidate")

    it("dropped argument and capture frame cycles reuse their heap"):
        let total = +0
        let round = +0
        while round < 200000:
            total += frame_ring(round % 10)
            total += captured_frame_ring(round % 10)
            round += 1
        assert(total == 1800000, "each frame retains its argument or capture")
        if released() == 0:
            assert(pages() <= 256, "cycle collection reuses suspension frames")

    it("copied cyclic list headers keep their collection eligibility"):
        let total = +0
        let round = +0
        while round < 20000:
            total += copied_list_ring(round % 10)
            round += 1
        assert(total == 90000, "each copied list reaches its ring")
        if released() == 0:
            assert(pages() <= 64, "cyclic headers and buffers are collected and reused")

    it("recursive values remain acyclic when copies are written"):
        before := pending()
        root := Dir { value: +1, kids: [Dir { value: +2, kids: [] }] }
        let mut changed = root
        changed.kids[0].value = +9
        let total = +0
        for _ in 0..1000:
            total += directory_total(root) + directory_total(changed)
        assert(total == 13000, "the old and changed copies keep separate children")
        assert(pending() == before, "value-only recursion never buffers a candidate")
