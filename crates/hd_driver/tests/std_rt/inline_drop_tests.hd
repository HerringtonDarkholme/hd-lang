# A moved or uninitialized place must not run an inline Drop hook.
# This module joins std because only std may implement its runtime trait.
use std.rt.Drop
use std.annotation.inline
use std.collections.UniqList

let drops: usize = 0
let empty_drops: usize = 0

struct Token:
    id: usize

impl !Copy for Token

impl Drop for Token:
    fn drop(&mut self) -> void:
        drops = drops + 1

struct Empty: pass

impl !Copy for Empty

impl Drop for Empty:
    fn drop(&mut self) -> void:
        empty_drops = empty_drops + 1

struct Pair:
    left: Token
    right: Token

impl !Copy for Pair

fn identity[T < ?Copy](value: T) -> T:
    value

fn moved(id: usize) -> usize:
    value := identity(Token { id: id })
    value.id

fn empty_move() -> void:
    _ := identity(Empty {})

let cascade_drops: usize = 0

struct Cascade:
    depth: usize
    name: string

impl !Copy for Cascade

impl Drop for Cascade:
    fn drop(&mut self) -> void:
        if self.depth > 0:
            _ := Cascade { depth: self.depth - 1, name: "level-${self.depth - 1}" }
        if self.name != "level-${self.depth}":
            panic("a nested drop overwrote its parent's value")
        cascade_drops = cascade_drops + 1

fn cascade() -> void:
    _ := Cascade { depth: 15, name: "level-15" }

fn nested_move() -> usize:
    value := identity(Pair { left: Token { id: 0 }, right: Token { id: 0 } })
    value.left.id + value.right.id

fn take_left(value: Pair) -> Token:
    value.left

fn partial_move() -> usize:
    value := take_left(Pair { left: Token { id: 0 }, right: Token { id: 0 } })
    value.id

fn replaced() -> usize:
    let value = Token { id: 0 }
    value = Token { id: 1 }
    value.id

fn branch(take: bool) -> usize:
    value := Token { id: 0 }
    if take:
        back := identity(value)
        return back.id
    value.id

fn read(value: &Token) -> usize:
    value.id

fn addressed_move() -> usize:
    value := Token { id: 0 }
    _ := read(&value)
    back := identity(value)
    back.id

# `value` lives in a counted cell, since a reference reads it across
# the await: its whole move releases the cell.
fn moved_cell!(take: bool) -> usize:
    value := Token { id: 1 }
    _ := read(&value)
    let job: Suspend[Token] = relayed(Token { id: 2 })
    other := job!()
    _ := read(&value)
    if take:
        back := identity(value)
        return back.id + other.id
    value.id + other.id

# A parameter a reference reads across the await lives in a cell, which
# a frame never polled still releases.
fn held_cell!(value: Token) -> usize:
    _ := read(&value)
    let job: Suspend[Token] = relayed(Token { id: 2 })
    other := job!()
    _ := read(&value)
    value.id + other.id

# `value` lives in a frame slot, since a reference reads its field.
fn addressed_field(take: bool, restore: bool) -> usize:
    let mut value = Pair { left: Token { id: 1 }, right: Token { id: 2 } }
    _ := read(&value.left)
    if take:
        first := identity(value.left)
        if restore:
            value.left = Token { id: 3 }
            return first.id + value.left.id
        return first.id
    value.left.id

fn restored_field() -> usize:
    let mut value = Pair { left: Token { id: 0 }, right: Token { id: 0 } }
    first := identity(value.left)
    value.left = Token { id: 1 }
    whole := identity(value)
    first.id + whole.left.id + whole.right.id

fn captured_cell() -> usize:
    let value = Token { id: 0 }
    read := fn() -> usize: value.id
    _ := read()
    value = Token { id: 1 }
    read()

enum Choice:
    Empty
    Value(Token)

fn moved_enum(present: bool) -> usize:
    value := if present: Choice.Value(Token { id: 0 }) else: Choice.Empty
    back := identity(value)
    match back:
        .Empty => 1
        .Value(token) => token.id

fn relayed![T < ?Copy](value: T) -> T:
    identity(value)

enum Slot[T < ?Copy]:
    Vacant
    Held(T)

impl[T < ?Copy] !Copy for Slot[T]

fn relayed_slot![T < ?Copy](value: Slot[T]) -> Slot[T]:
    identity(value)

fn relayed_option![T < ?Copy](value: T?) -> T?:
    identity(value)

struct Named:
    token: Token
    name: string

impl !Copy for Named

struct ReadRoom[T < ?Copy]:
    text: string
    guard: T

impl[T < ?Copy] !Copy for ReadRoom[T]

struct ReadContainer[T < ?Copy]:
    room: ReadRoom[T]

impl[T < ?Copy] !Copy for ReadContainer[T]

impl[T < ?Copy] ReadRoom[T]:
    fn length(&self) -> usize:
        self.text.len()

fn room_length[T < ?Copy](room: &ReadRoom[T]) -> usize:
    room.length()

@inline(.Never)
fn container_length[T < ?Copy](container: &ReadContainer[T]) -> usize:
    field := &container.room
    room_length(field)

fn local_room(id: usize) -> usize:
    room := ReadRoom { text: "owned".repeat(40), guard: Token { id: id } }
    room_length(&room)

fn boxed_room(id: usize) -> usize:
    room := box(ReadRoom { text: "owned".repeat(40), guard: Token { id: id } })
    room_length(room)

fn container_room(id: usize) -> usize:
    container := ReadContainer {
        room: ReadRoom { text: "owned".repeat(40), guard: Token { id: id } },
    }
    container_length(&container)

fn consume_named(value: Named) -> usize:
    if value.name.len() == 0:
        panic("lost the name")
    value.token.id

fn named_suspension!() -> usize:
    let job: Suspend[Named] = relayed(Named { token: Token { id: 7 }, name: "token-${drops}" })
    value := job!()
    if value.name.len() == 0:
        panic("lost the name")
    value.token.id

# Each part below holds a Drop value only through parts that have no
# Drop of their own: a tuple, an option and a user enum, each inside a
# struct inside a struct.
struct Holder:
    pair: (usize, (string, Token))
    maybe: Token?
    slot: Slot[Token]

impl !Copy for Holder

struct Outer:
    holder: Holder
    id: usize

impl !Copy for Outer

fn outer(id: usize) -> Outer:
    Outer {
        holder: Holder {
            pair: (id, ("pair", Token { id: id })),
            maybe: .Some(Token { id: id }),
            slot: Slot.Held(Token { id: id }),
        },
        id: id,
    }

fn released_outer(id: usize) -> usize:
    value := identity(outer(id))
    value.id

# A newtype over a Drop value holds its base by value, so releasing it
# releases the base (module.rt.drop.glue), wherever the newtype sits.
type Wrapped(Token)

type Rewrapped(Wrapped)

type Around[T < ?Copy](T)

struct WrapHolder:
    wrapped: Wrapped
    id: usize

impl !Copy for WrapHolder

enum WrapChoice:
    Nothing
    Value(Wrapped)

impl !Copy for WrapChoice

let guard_drops: usize = 0
let guard_saw: usize = 0

type Guarded(Token)

impl Drop for Guarded:
    fn drop(&mut self) -> void:
        guard_drops = guard_drops + 1
        guard_saw = drops

let flag_drops: usize = 0

type Flag(usize)

impl !Copy for Flag

impl Drop for Flag:
    fn drop(&mut self) -> void:
        flag_drops = flag_drops + 1

type Label(string)

impl !Copy for Label

impl Drop for Label:
    fn drop(&mut self) -> void:
        if string(*self).len() == 0:
            panic("a label dropped after its text")
        flag_drops = flag_drops + 1

struct FlagHolder:
    flag: Flag
    label: Label
    id: usize

impl !Copy for FlagHolder

fn wrapped_alone(id: usize) -> void:
    _ := identity(Wrapped(Token { id: id }))

# A newtype over a `!Copy` base moves (`types.newtype.holds`): each move
# hands the one base on, so it drops once, at the last holder.
fn wrapped_moved(id: usize) -> usize:
    first := Wrapped(Token { id: id })
    second := first
    third := identity(second)
    Token(third).id

fn wrapped_field(id: usize) -> usize:
    value := identity(WrapHolder { wrapped: Wrapped(Token { id: id }), id: id })
    value.id

fn wrapped_payload(id: usize) -> void:
    _ := identity(WrapChoice.Value(Wrapped(Token { id: id })))

# `Wrapped` holds a `!Copy` base, so it moves (`types.newtype.holds`)
# and its elements go in a `UniqList`.
fn wrapped_elements(id: usize) -> usize:
    let mut items = UniqList::[Wrapped].new()
    items.push(Wrapped(Token { id: id }))
    items.push(Wrapped(Token { id: id + 1 }))
    identity(items).len()

fn wrapped_option(id: usize) -> void:
    let value: Wrapped? = .Some(Wrapped(Token { id: id }))
    _ := identity(value)

fn wrapped_twice(id: usize) -> void:
    _ := identity(Rewrapped(Wrapped(Token { id: id })))

fn wrapped_generic(id: usize) -> void:
    _ := identity(Around(Token { id: id }))

fn wrapped_tuple(id: usize) -> usize:
    pair := identity((id, Wrapped(Token { id: id })))
    pair._0

fn wrapped_boxed(id: usize) -> void:
    _ := box(Wrapped(Token { id: id }))

fn wrapped_cell() -> usize:
    let value = Wrapped(Token { id: 0 })
    read := fn() -> usize: Token(value).id
    _ := read()
    value = Wrapped(Token { id: 1 })
    read()

fn guarded(id: usize) -> void:
    _ := identity(Guarded(Token { id: id }))

fn flag_alone(id: usize) -> void:
    _ := identity(Flag(id))
    _ := identity(Label("label-${id}"))

fn flag_field(id: usize) -> usize:
    value := identity(FlagHolder { flag: Flag(id), label: Label("label-${id}"), id: id })
    value.id

trait Relay:
    fn relay!(&self, value: Token) -> Token

struct Forwarder: pass

impl Relay for Forwarder:
    fn relay!(&self, value: Token) -> Token:
        value

@derive(Eq, Hash)
struct CollectionKey:
    number: usize
    label: string

fn copy_collection_referents() -> void:
    let mut values: List[*mut Token] = [box(Token { id: 1 }), box(Token { id: 2 })]
    let mut entries: Map[CollectionKey, *mut Token] = {}
    key := CollectionKey { number: 1, label: "same" }
    entries[key] = values[0]
    entries[key] = values[1]
    _ := entries.remove(key)
    values.truncate(0)

tests:
    use std.testing.{assert_equal, it}

    it("zero and nonzero payloads move their Drop ownership"):
        before := drops
        assert_equal(moved(0), 0)
        assert_equal(drops, before + 1)
        assert_equal(moved(7), 7)
        assert_equal(drops, before + 2)

    it("small generic readers keep local and boxed Drop owners alive"):
        before := drops
        for id in 0..100:
            assert_equal(local_room(id), 200)
            assert_equal(boxed_room(id), 200)
            assert_equal(container_room(id), 200)
        assert_equal(drops, before + 300)

    it("a Drop value under parts without a Drop of their own drops once"):
        before := drops
        assert_equal(released_outer(3), 3)
        assert_equal(drops, before + 3)

    it("a newtype over a Drop value drops its base once, alone and as a field"):
        before := drops
        wrapped_alone(1)
        assert_equal(drops, before + 1)
        assert_equal(wrapped_field(2), 2)
        assert_equal(drops, before + 2)

    it("a moved newtype over a Drop value drops its base once"):
        before := drops
        assert_equal(wrapped_moved(3), 3)
        assert_equal(drops, before + 1)

    it("a newtype over a Drop value drops its base once wherever it sits"):
        before := drops
        wrapped_payload(1)
        assert_equal(drops, before + 1)
        assert_equal(wrapped_elements(1), 2)
        assert_equal(drops, before + 3)
        wrapped_option(1)
        assert_equal(drops, before + 4)
        wrapped_twice(1)
        assert_equal(drops, before + 5)
        wrapped_generic(1)
        assert_equal(drops, before + 6)
        assert_equal(wrapped_tuple(1), 1)
        assert_equal(drops, before + 7)
        wrapped_boxed(1)
        assert_equal(drops, before + 8)
        assert_equal(wrapped_cell(), 1)
        assert_equal(drops, before + 10)

    it("a newtype with a Drop of its own runs it, then its base's"):
        before := drops
        guards := guard_drops
        guarded(1)
        assert_equal(guard_drops, guards + 1)
        assert_equal(guard_saw, before)
        assert_equal(drops, before + 1)

    it("a newtype with a Drop over a base without one drops, alone and as a field"):
        before := flag_drops
        flag_alone(1)
        assert_equal(flag_drops, before + 2)
        assert_equal(flag_field(2), 2)
        assert_equal(flag_drops, before + 4)

    it("a zero-sized value still has Drop ownership"):
        before := empty_drops
        empty_move()
        assert_equal(empty_drops, before + 1)

    it("nested Drop calls keep each invocation's value in its own frame"):
        before := cascade_drops
        cascade()
        assert_equal(cascade_drops, before + 16)

    it("nested fields drop once after the container moves"):
        before := drops
        assert_equal(nested_move(), 0)
        assert_equal(drops, before + 2)

    it("a field move leaves only the other field to drop"):
        before := drops
        assert_equal(partial_move(), 0)
        assert_equal(drops, before + 2)

    it("replacement drops both initialized values once"):
        before := drops
        assert_equal(replaced(), 1)
        assert_equal(drops, before + 2)

    it("both branches release exactly one value"):
        before := drops
        assert_equal(branch(true), 0)
        assert_equal(drops, before + 1)
        assert_equal(branch(false), 0)
        assert_equal(drops, before + 2)

    it("an addressed local can move without dropping the empty cell"):
        before := drops
        assert_equal(addressed_move(), 0)
        assert_equal(drops, before + 1)

    it("a cell moved whole on one branch drops its payload once"):
        before := drops
        assert_equal(moved_cell!(true), 3)
        assert_equal(drops, before + 2)
        assert_equal(moved_cell!(false), 3)
        assert_equal(drops, before + 4)

    it("a parameter's cell drops its payload once, polled or not"):
        before := drops
        _ := held_cell(Token { id: 1 })
        assert_equal(drops, before + 1)
        let job: Suspend[usize] = held_cell(Token { id: 1 })
        assert_equal(job!(), 3)
        assert_equal(drops, before + 3)

    it("a slot's moved field skips its hook and a restored one runs it"):
        before := drops
        assert_equal(addressed_field(false, false), 1)
        assert_equal(drops, before + 2)
        assert_equal(addressed_field(true, false), 1)
        assert_equal(drops, before + 4)
        assert_equal(addressed_field(true, true), 4)
        assert_equal(drops, before + 7)

    it("a moved field can be restored before moving the whole value"):
        before := drops
        assert_equal(restored_field(), 1)
        assert_equal(drops, before + 3)

    it("a shared cell drops each initialized payload once"):
        before := drops
        assert_equal(captured_cell(), 1)
        assert_equal(drops, before + 2)

    it("enum guards exclude an inactive variant after a move"):
        before := drops
        assert_equal(moved_enum(false), 1)
        assert_equal(drops, before)
        assert_equal(moved_enum(true), 0)
        assert_equal(drops, before + 1)

    it("a suspension transfers the parameter's Drop ownership"):
        before := drops
        let job: Suspend[Token] = relayed(Token { id: 0 })
        value := job!()
        assert_equal(value.id, 0)
        _ := identity(value)
        assert_equal(drops, before + 1)

    it("a suspension transfers an optional parameter's Drop ownership"):
        before := drops
        let job: Suspend[Token?] = relayed_option(.Some(Token { id: 0 }))
        value := job!()
        _ := identity(value)
        assert_equal(drops, before + 1)

    it("a suspension transfers a user enum parameter's Drop ownership"):
        before := drops
        let job: Suspend[Slot[Token]] = relayed_slot(Slot.Held(Token { id: 0 }))
        value := job!()
        _ := identity(value)
        assert_equal(drops, before + 1)

    it("an unpolled suspension still owns its parameter"):
        before := drops
        _ := relayed(Token { id: 0 })
        assert_equal(drops, before + 1)

    it("suspending generic values preserve their counted fields"):
        before := drops
        for _ in 0..20:
            assert_equal(named_suspension!(), 7)
        assert_equal(drops, before + 20)

    it("a reused local tracks each loop iteration independently"):
        before := drops
        for i in 0..20:
            value := identity(Token { id: i })
            assert_equal(value.id, i)
        assert_equal(drops, before + 20)

    it("a dynamic suspension takes its inline argument"):
        before := drops
        forwarder := Forwarder {}
        let relay: &dyn Relay = &forwarder
        let job: Suspend[Token] = relay.relay(Token { id: 0 })
        value := job!()
        assert_equal(value.id, 0)
        _ := identity(value)
        assert_equal(drops, before + 1)

    it("Copy collections release each boxed Drop referent once"):
        before := drops
        copy_collection_referents()
        assert_equal(drops, before + 2)
