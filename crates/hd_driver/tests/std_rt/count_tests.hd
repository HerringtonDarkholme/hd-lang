# The hd tests of counting on the linear backend (crates/hd_wasm_linear/DESIGN.md
# §23.16): ordinary code that allocates in a loop runs in bounded memory,
# since each value's last release frees its block for the next. Only std
# may read the heap's size, so the conformance runner adds this file to std
# as `std.rt.count_tests`, as it does alloc_tests.hd.
use std.rt.memory.pages
use std.rt.checked.{released, retained}
use std.testing.assert

# The heap's pages in a bounded run: the static page, the page table, a
# page for each size class the objects use, and the cycle collector's
# candidate buffer (crates/hd_wasm_linear/DESIGN.md §23.28), which grows with the
# live candidates, not with the loop. Without the frees the chains alone
# need about 50 MB.
BOUND := 12

# The checked runtime poisons released blocks and deliberately quarantines
# them forever (DESIGN §23.24). Its release counter advances only when the
# driver links checked counting; in the normal runtime it stays zero.
# Keep the reuse regression in normal mode, while checked runs keep every
# workload/value assertion and the entry audit for leaked counts.
fn assert_reuse_bound(reason: string) -> void:
    if released() == 0:
        assert(pages() <= BOUND, reason)

struct Node:
    name: string
    next: List[Node]

enum Shape:
    Named(string, i32)
    Pair(string, string)
    Empty

fn label(n: i32) -> string:
    "n$n"

fn chain(n: i32) -> List[Node]:
    let head: List[Node] = []
    let i = +0
    while i < n:
        head = [Node { name: label(i), next: head }]
        i = i + 1
    head

fn length(node: List[Node]) -> i32:
    let count = +0
    let at = node
    while at.len() > 0:
        count = count + 1
        at = at[0].next
    count

struct Pair:
    left: string
    right: string

# An owned parameter, consumed by a construction (crates/hd_wasm_linear/DESIGN.md
# §23.25).
fn wrap(s: string, t: string) -> Pair:
    Pair { left: s, right: t }

# A borrowed parameter: neither side counts it.
fn left_of(p: &Pair) -> string:
    p.left

# An owned parameter returned: its count moves out.
fn pass_on(s: string) -> string:
    s

fn pick(n: i32) -> Shape:
    if n % 3 == 0:
        return .Named(label(n), n)
    if n % 3 == 1:
        return .Pair(label(n), label(n + 1))
    .Empty

tests:
    use std.testing.it

    it("a million short strings run in bounded memory"):
        let total: usize = 0
        let i = +0
        while i < 1000000:
            total = total + label(i).len()
            i = i + 1
        assert(total == 6888890, "every string was built")
        assert_reuse_bound("each string's block is reused")

    it("the last release of a chain frees every node and its name"):
        let round = +0
        while round < 300:
            assert(length(chain(1000)) == 1000, "the chain is whole while held")
            round = round + 1
        assert_reuse_bound("the nodes' and names' blocks are reused")

    it("an enum's release frees the payload of the variant it holds"):
        let named = +0
        let i = +0
        while i < 300000:
            match pick(i):
                .Named(_, _) => named = named + 1
                _ => pass
            i = i + 1
        assert(named == 100000, "every third is named")
        assert_reuse_bound("the payloads' blocks are reused")

    it("moved and borrowed arguments keep their values and run in bounded memory"):
        let total: usize = 0
        let i = +0
        while i < 200000:
            p := wrap(pass_on(label(i)), label(i))
            total = total + left_of(&p).len() + p.right.len()
            i = i + 1
        assert(total == 2577780, "every pair holds both strings")
        assert_reuse_bound("the strings' and pairs' blocks are reused")

    it("an argument used again after the call is not moved"):
        s := label(7)
        t := pass_on(s)
        p := wrap(s, t)
        assert(s == "n7" && t == "n7", "both still hold the string")
        assert(left_of(&p) == "n7" && p.right == s, "and so does the pair")

    it("immutable loop elements add no per-element counts"):
        words := [label(+1), label(+2), label(+3), label(+4)]
        before := retained()
        let found: usize = 0
        let round: usize = 0
        while round < 1000:
            for word in words:
                match word:
                    "n1" => found += 1
                    _ => pass
            round += 1
        added := retained() - before
        assert(found == 1000, "every snapshot is read without changing its source")
        if released() != 0:
            assert(added <= 2000, "at most two snapshot ownership counts per round: $added")
