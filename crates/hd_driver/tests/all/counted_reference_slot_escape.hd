# trait.dyn.value-methods and fn.capture.locals. The checked runs' exit audit
# fails on any owner these calls leak, and a freed target's poison fails each read.
use std.annotation.cold
use std.testing.assert_equal

struct Held[T]:
    value: T

trait Escape:
    fn capture(&self, value: *i32) -> fn() -> *i32
    fn hold(&self, value: *i32) -> Held[*i32]
    fn text(&self, value: string) -> Held[string]

struct Store:
    tag: usize

impl Escape for Store:
    @cold
    fn capture(&self, value: *i32) -> fn() -> *i32:
        fn() -> *i32: value

    @cold
    fn hold(&self, value: *i32) -> Held[*i32]:
        Held { value: value }

    @cold
    fn text(&self, value: string) -> Held[string]:
        Held { value: value }

@cold
fn named_capture(value: *i32) -> fn() -> *i32:
    fn() -> *i32: value

@cold
fn named_hold(value: *i32) -> Held[*i32]:
    Held { value: value }

@cold
fn named_text(value: string) -> Held[string]:
    Held { value: value }

@cold
fn bound_capture[S < Escape](store: &S, value: *i32) -> fn() -> *i32:
    store.capture(value)

@cold
fn bound_hold[S < Escape](store: &S, value: *i32) -> Held[*i32]:
    store.hold(value)

@cold
fn bound_text[S < Escape](store: &S, value: string) -> Held[string]:
    store.text(value)

@cold
fn capture(route: usize, dynamic: &dyn Escape, store: &Store, value: *i32) -> fn() -> *i32:
    if route == 0:
        return named_capture(value)
    if route == 1:
        return dynamic.capture(value)
    bound_capture(store, value)

@cold
fn hold(route: usize, dynamic: &dyn Escape, store: &Store, value: *i32) -> Held[*i32]:
    if route == 0:
        return named_hold(value)
    if route == 1:
        return dynamic.hold(value)
    bound_hold(store, value)

@cold
fn text(route: usize, dynamic: &dyn Escape, store: &Store, value: string) -> Held[string]:
    if route == 0:
        return named_text(value)
    if route == 1:
        return dynamic.text(value)
    bound_text(store, value)

@cold
fn fresh_target() -> *i32:
    box(+11)

@cold
fn closure_fresh(route: usize, dynamic: &dyn Escape, store: &Store) -> void:
    saved := capture(route, dynamic, store, fresh_target())
    assert_equal(*saved(), 11, reason="the returned closure owns the fresh target")
    assert_equal(*saved(), 11)

@cold
fn closure_live(route: usize, dynamic: &dyn Escape, store: &Store) -> void:
    value := box(+11)
    saved := capture(route, dynamic, store, value)
    assert_equal(*value, 11)
    assert_equal(*saved(), 11, reason="the caller and closure both keep the target")
    assert_equal(*saved(), 11)
    assert_equal(*value, 11)

@cold
fn holder_fresh(route: usize, dynamic: &dyn Escape, store: &Store) -> void:
    saved := hold(route, dynamic, store, fresh_target())
    assert_equal(*saved.value, 11, reason="the returned holder owns the fresh target")
    assert_equal(*saved.value, 11)

@cold
fn holder_live(route: usize, dynamic: &dyn Escape, store: &Store) -> void:
    value := box(+11)
    saved := hold(route, dynamic, store, value)
    assert_equal(*value, 11)
    assert_equal(*saved.value, 11, reason="the caller and holder both keep the target")
    assert_equal(*saved.value, 11)
    assert_equal(*value, 11)

@cold
fn text_control(route: usize, dynamic: &dyn Escape, store: &Store) -> void:
    value := "slot-$route"
    saved := text(route, dynamic, store, value)
    assert_equal(saved.value, value)
    assert_equal(value, "slot-$route")

pub fn main() -> void:
    store := Store { tag: 0 }
    let dynamic: *dyn Escape = box(Store { tag: 1 })
    for route in 0..3:
        closure_fresh(route, dynamic, &store)
        closure_live(route, dynamic, &store)
        holder_fresh(route, dynamic, &store)
        holder_live(route, dynamic, &store)
        text_control(route, dynamic, &store)
