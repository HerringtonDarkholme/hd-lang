# Private control for the existing accepted whole-tuple kind conversion.
use std.annotation.cold
use std.testing.assert_equal

@cold
fn consume(first: *i32, second: *i32) -> void:
    source := (first, "owned-${*second}", second)
    let converted: (&i32, string, &i32) = source
    assert_equal(*converted._0 + *converted._2, 18)
    assert_equal(converted._1, "owned-11")
    assert_equal(source._1, "owned-11")

@cold
fn outcome(read_after: bool) -> void:
    first := box(+7)
    second := box(+11)
    consume(first, second)
    if read_after:
        assert_equal(*first, 7)
        assert_equal(*second, 11)

# The checked runs' exit audit fails on any owner the conversion leaks.
pub fn main() -> void:
    for read_after in [false, true]:
        outcome(read_after)
