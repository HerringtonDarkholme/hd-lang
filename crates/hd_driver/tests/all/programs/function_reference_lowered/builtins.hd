fn texts(xs: List[i32], show: fn(&i32) -> string) -> List[string]:
    [for x in xs => show(&x)]

pub fn main() -> void $ Console:
    show := i32::to_string
    println(show(&-4))
    let xs: List[i32] = [1, 2, 3]
    ys := texts(xs, i32::to_string)
    println(ys.len())
    println(ys[2])
    half := f64::to_string
    println(half(&1.5))
    let flag: fn(&bool) -> string = Display::to_string
    println(flag(&true))
    let text: fn(&string) -> string = string::to_string
    println(text(&"x"))
