pub trait Tag:
    fn name(self) -> string

pub trait Log:
    fn tag(self) -> string

struct Named:
    label: string

impl Tag for Named:
    fn name(self) -> string:
        self.label

impl Log for Named:
    fn tag(self) -> string:
        "log:" + self.label

fn current() -> string $ Tag:
    $.use(Tag).name()

fn both() -> string $ Tag + Log:
    $.use(Tag).name() + "," + $.use(Log).tag()

fn read() -> i32 $ Tag + Log:
    42

fn call(job: fn() -> i32 $ Tag + Log) -> i32 $ Tag + Log:
    job()

pub fn main() -> void $ Console:
    $.with(Tag=Named { label: "a" }, Log=Named { label: "b" }):
        println(call(read))
