use std.cmp.Ordering

pub struct Point:
    pub x: i32
    pub y: i32

impl Eq for Point:
    fn eq(&self, other: &Point) -> bool:
        self.x == other.x

pub fn count(xs: List[i32], fallback: i32?) -> i32:
    3

pub fn rank(o: Ordering, seen: Map[string, List[i32]]) -> Result[i32, string]?:
    .None

pub fn total(a: i32, b: i32) -> i32:
    a + b
