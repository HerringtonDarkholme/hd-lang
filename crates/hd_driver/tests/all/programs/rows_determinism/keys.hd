pub trait Clock:
    fn now(self) -> i32

pub trait Tag:
    fn id(self) -> i32

pub struct FixedClock:
    pub value: i32

pub struct FixedTag:
    pub value: i32

impl Clock for FixedClock:
    fn now(self) -> i32:
        self.value

impl Tag for FixedTag:
    fn id(self) -> i32:
        self.value
