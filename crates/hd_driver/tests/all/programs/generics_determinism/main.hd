use pkg.geo.shapes.{Supplier, Named, Ints, Words}

fn second[A, B](a: A, b: B) -> B:
    b

fn label[T < Named](t: T) -> string:
    t.name()

pub fn main() -> void $ Console:
    println(label(Ints { value: 3 }))
    words := Words { value: "w" }
    println(label(words))
    println(second(+1, "x"))
    println("${Ints { value: 4 }.get()}")
