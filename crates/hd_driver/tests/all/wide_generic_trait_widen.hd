use std.annotation.cold
use std.weak.{Weak, weak}

# The runtime harness expands this type argument beyond specialization's
# leaf budget. No value of Big is constructed.
type Big = (i32,)

trait Base[T]:
    fn read(&self) -> i32

trait Child[T] < Base[T]:
    fn extra(&self) -> i32

struct Payload:
    number: i32
    label: string

impl[T] Base[T] for Payload:
    fn read(&self) -> i32:
        self.number + i32(self.label.len())

impl[T] Child[T] for Payload:
    fn extra(&self) -> i32:
        self.number

let witness: Weak[Payload]? = .None

@cold
fn fresh() -> *mut Payload:
    value := box(Payload { number: +14, label: "abc" })
    witness = weak(value)
    value

@cold
fn read_base[T](value: &dyn Base[T]) -> i32:
    value.read()

@cold
fn widened[T](value: &dyn Child[T]) -> i32:
    let base: &dyn Base[T] = value
    read_base(base)

fn local!() -> i32:
    let child: &dyn Child[Big] = fresh()
    widened::[Big](child)

fn expired() -> bool:
    match witness:
        .Some(seen) => seen.upgrade().is_none()
        .None => false

pub fn main!() -> void $ Console:
    if local!() != 17:
        panic("wrong result")
    if !expired():
        panic("leaked owner")
    println("ok")
