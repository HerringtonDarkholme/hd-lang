# req.suspend.cold: an owned list survives direct, stored and function-value calls.
use std.function.{SuspendFn, Tuple}
use std.ops.Disposable
use std.task.{BlockOn, block_on, race}
use std.testing.assert_equal
use std.time.{Clock, ms, sleep}

fn size![T](values: List[T]) -> usize:
    values.len()

fn delayed![T](values: List[T], before: usize = values.len()) -> usize $ Clock:
    sleep!(ms(1))
    before + values.len()

struct Marker:
    events: *mut List[usize]

impl Disposable for Marker:
    fn dispose(&mut self) -> void:
        self.events.push(2)

fn prepare!() -> usize $ Clock:
    sleep!(ms(2))
    0

fn slow![T](values: List[T], n: usize, events: *mut List[usize]) -> usize $ Clock:
    events.push(1)
    sleep!(ms(50))
    values.len() + n

fn pending![T](values: List[T], events: *mut List[usize]) -> usize $ Clock:
    using mark = Marker { events: events }
    slow!(values, prepare!(), events)

fn quick!() -> usize $ Clock:
    sleep!(ms(10))
    7

fn check!(values: List[string], refs: List[*i32]) -> void $ Clock:
    let mut current = values
    cold := delayed(current)
    current.push("new")
    assert_equal(cold!(), 2)
    assert_equal(delayed!(current), 4)
    assert_equal(current.len(), 2)

    f := delayed::[string]
    from_ref := f(current, current.len())
    current.push("newer")
    assert_equal(from_ref!(), 4)
    assert_equal(current.len(), 3)

    assert_equal(delayed!(refs), 2)
    assert_equal(*refs[0], +7)
    events := box::[List[usize]]([])
    assert_equal(race!(pending(current, events), quick()), 7)
    assert_equal(*events, [1, 2])

trait Echo[T]:
    fn echo!(&self, value: T) -> T $ Clock

struct Echoer:
    padding: usize

impl Echoer:
    fn inherent![T](&self, value: T) -> T $ Clock:
        sleep!(ms(1))
        value

impl[T] Echo[T] for Echoer:
    fn echo!(&self, value: T) -> T $ Clock:
        sleep!(ms(1))
        value

trait Taking:
    fn take!(self, suffix: string) -> string $ Clock

struct Prefix:
    text: string

impl Taking for Prefix:
    fn take!(self, suffix: string) -> string $ Clock:
        sleep!(ms(1))
        self.text + suffix

fn bound![S < Echo[List[string]]](echoer: &S, values: List[string], depth: usize) -> usize $ Clock:
    if depth > 0:
        return bound!(echoer, values, depth - 1)
    result := echoer.echo!(values)
    result.len() + values.len()

fn bound_ref![S < Echo[List[string]]](echoer: &S, values: List[string]) -> usize $ Clock:
    method := S::echo
    pending := method(echoer, values)
    result := pending!()
    result.len() + values.len()

fn methods!() -> void $ Clock:
    prefix := Prefix { text: "prefix-" + "value" }
    by_value := prefix.take("-direct")
    assert_equal(by_value!(), "prefix-value-direct")
    assert_equal(prefix.text, "prefix-value")
    let erased: *dyn Taking = box(prefix)
    erased_task := erased.take("-dynamic")
    assert_equal(erased_task!(), "prefix-value-dynamic")
    echoer := Echoer { padding: 0 }
    assert_equal(bound!(&echoer, ["bound"], 1), 2)
    assert_equal(bound_ref!(&echoer, ["bound-reference"]), 2)
    live := ["inherent"]
    cold := echoer.inherent(live)
    assert_equal(cold!(), ["inherent"])
    assert_equal(live, ["inherent"])
    assert_equal(echoer.inherent!(["direct"]), ["direct"])
    inherent_ref := Echoer::inherent::[string]
    from_method_ref := inherent_ref(&echoer, "method-reference")
    assert_equal(from_method_ref!(), "method-reference")

    text := "trait-" + "argument"
    cold_trait := echoer.echo(text)
    assert_equal(cold_trait!(), "trait-argument")
    assert_equal(text, "trait-argument")
    assert_equal(echoer.echo!(["static"]), ["static"])

    let dynamic: *dyn Echo[List[string]] = box(echoer)
    live_dynamic := ["dynamic"]
    cold_dynamic := dynamic.echo(live_dynamic)
    assert_equal(cold_dynamic!(), ["dynamic"])
    assert_equal(live_dynamic, ["dynamic"])
    assert_equal(dynamic.echo!(["awaited"]), ["awaited"])

    adapter := fn(value: List[string]) -> Suspend[List[string]] $ Clock: dynamic.echo(value)
    via_adapter := adapter(["adapter"])
    assert_equal(via_adapter!(), ["adapter"])

    let thin: *dyn Echo[*i32] = box(echoer)
    reference := box(+19)
    cold_reference := thin.echo(reference)
    assert_equal(*cold_reference!(), +19)
    assert_equal(*reference, +19)

fn generic_value![T](value: T) -> T $ Clock:
    loader := fn!(item: T) -> T $ Clock:
        sleep!(ms(1))
        item
    loader!(value)

fn generic_loader![T](values: List[T]) -> usize $ Clock:
    loader := fn!(words: List[T]) -> usize $ Clock:
        sleep!(ms(1))
        words.len()
    loader!(values)

fn spread_loader![Args < Tuple, O, $ R](loader: SuspendFn[Args, O, $ R], args: Args) -> O $ R:
    loader!(args...)

fn run_loader!(loader: fn!(List[string]) -> usize $ Clock, values: List[string]) -> usize $ Clock:
    loader!(values)

fn anonymous!() -> void $ Clock:
    prefix := "prefix-" + "value"
    loader := fn!(words: List[string]) -> usize $ Clock:
        sleep!(ms(1))
        words.len() + prefix.len()
    let mut values = ["first"]
    cold := loader(values)
    values.push("second")
    assert_equal(cold!(), 13)
    assert_equal(values.len(), 2)
    assert_equal(loader!(values), 14)
    assert_equal(values.len(), 2)
    assert_equal(run_loader!(loader, values), 14)
    assert_equal(values.len(), 2)
    assert_equal(generic_value!("generic-" + "string"), "generic-string")
    assert_equal(generic_value!(values), values)
    pointer := box(+17)
    assert_equal(*generic_value!(pointer), +17)
    assert_equal(*pointer, +17)
    assert_equal(generic_loader!(values), 2)
    assert_equal(generic_loader!([box(+7)]), 1)
    assert_equal(spread_loader!(loader, (values,)), 14)
    assert_equal(values.len(), 2)
    _ := loader(["cancelled before entry"])
    events := box::[List[usize]]([])
    cancelled := fn!(words: List[string]) -> usize $ Clock:
        using mark = Marker { events: events }
        events.push(1)
        sleep!(ms(50))
        words.len()
    assert_equal(race!(cancelled(values), quick()), 7)
    assert_equal(*events, [1, 2])
    assert_equal(values.len(), 2)

pub fn main() -> void $ Clock:
    match block_on(size(["a", "b", "c"])):
        .Completed(n) => assert_equal(n, 3)
        _ => panic("fused call did not complete")
    match block_on(anonymous()):
        .Completed(()) => ()
        _ => panic("anonymous routes did not complete")
    match block_on(methods()):
        .Completed(()) => ()
        _ => panic("method routes did not complete")
    match block_on(check(["start"], [box(+7)])):
        .Completed(()) => ()
        _ => panic("resumed calls did not complete")
