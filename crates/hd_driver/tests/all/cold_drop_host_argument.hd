# module.rt.drop.glue; fn.suspension.hold: host argument cleanup calls
# each inline Drop hook before releasing fields, including on cancellation.
use std.rt.Drop
use std.serde.{Serialize, Serializer}
use std.task.block_on

pub struct Counter:
    pub drops: usize

pub struct Marker:
    pub counter: *mut Counter

impl !Copy for Marker

impl Drop for Marker:
    fn drop(&mut self) -> void:
        self.counter.drops += 10

pub enum Only:
    Held(Marker)
    Impossible(never)

pub struct Payload:
    values: List[string]
    counter: *mut Counter
    marker: Marker?
    single: Only
    tuple: (Marker,)

impl !Copy for Payload

impl Drop for Payload:
    fn drop(&mut self) -> void:
        self.counter.drops += 1

impl Serialize for Payload:
    fn serialize[W < Serializer](&self, out: &mut W) -> Result[void, W::Error]:
        self.values.serialize(out)

pub trait Child:
    fn child!(&self, values: Payload) -> u32
    fn inspect(&self, values: Payload) -> u32

fn payload(counter: *mut Counter, values: List[string]) -> Payload:
    Payload {
        values: values,
        counter: counter,
        marker: .Some(Marker { counter: counter }),
        single: .Held(Marker { counter: counter }),
        tuple: (Marker { counter: counter },)
    }

fn abandoned(child: &dyn Child, counter: *mut Counter) -> void:
    _ := child.child(payload(counter, ["one"]))

pub fn main!() -> void $ Child:
    let child: &dyn Child = $.use(Child)
    counter := box(Counter { drops: 0 })
    let mut values = ["one"]
    waiting := child.child(payload(counter, values))
    values.push("two")
    if waiting!() != 7:
        panic("wrong pending host result")
    if values != ["one", "two"]:
        panic("parent list changed")
    if counter.drops != 31:
        panic("normal host hook count ${counter.drops}")
    abandoned(child, counter)
    if counter.drops != 62:
        panic("abandoned host hook count")
    match block_on(child.child(payload(counter, ["one"]))):
        .Completed(7) => pass
        _ => panic("blocking host did not complete")
    if counter.drops != 93:
        panic("blocking host hook count")
    if (
        child.child!(
            Payload {
                values: ["ready"],
                counter: counter,
                marker: .None,
                single: .Held(Marker { counter: counter }),
                tuple: (Marker { counter: counter },)
            },
        )
        != 7
    ):
        panic("absent marker host result")
    if counter.drops != 114:
        panic("absent marker hook count")
    match block_on(child.child(payload(counter, ["ready"]))):
        .Completed(7) => pass
        _ => panic("ready blocking host did not complete")
    if counter.drops != 145:
        panic("ready blocking hook count")
    if child.inspect(payload(counter, ["one"])) != 7:
        panic("synchronous host result")
    if counter.drops != 176:
        panic("synchronous host hook count ${counter.drops}")
