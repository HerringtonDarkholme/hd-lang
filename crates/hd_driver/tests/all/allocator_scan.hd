# scan_steps is injected by allocator_init.rs only in this test's std source.
use std.rt.alloc.{alloc, free, scan_steps}
use std.rt.memory.{load_u32, store_u32}

fn measured(size: usize, count: usize) -> usize:
    before := scan_steps()
    let last: usize = 0
    for i in 0..count:
        block := alloc(size)
        store_u32(block, u32(last))
        last = block
    steps := scan_steps() - before
    while last != 0:
        previous := usize(load_u32(last))
        free(last)
        last = previous
    steps

pub fn main() -> void $ Console:
    for size in [65536, 131072]:
        # 100 and 1,000 blocks: a rescan of the occupied prefix costs about
        # n * n / 2 steps, 500,000 at 1,000, far past the bounds. 10,000
        # blocks of 128 KiB grew Node's heap by 1.3 GB (21 s, 2026-11-23).
        small := measured(size, 100)
        large := measured(size, 1000)
        println("$size $small $large")
        if small > 400 || large > 4000 || large > 12 * (small + 100):
            panic("the page search rescans occupied prefixes")
