# fn.type.declared-variance and types.variance.no-insertion.
use std.annotation.cold
use std.testing.{assert, assert_equal}
use std.weak.{Weak, weak}

struct CallbackBox[+F]:
    callback: F

struct NestedCallbacks[+F]:
    callbacks: List[(F,)]

@cold
fn read(value: &i32) -> i32:
    *value

@cold
fn read_cold!(value: &i32) -> i32:
    *value

@cold
fn extract[F](nested: NestedCallbacks[F]) -> F:
    nested.callbacks[0]._0

@cold
fn plain(kind: usize) -> fn(*i32) -> i32:
    if kind == 0:
        let source: (fn(&i32) -> i32, usize) = (read, 19)
        let viewed: (fn(*i32) -> i32, usize) = source
        assert_equal(viewed._1, 19)
        return viewed._0
    if kind == 1:
        let source: CallbackBox[fn(&i32) -> i32] = CallbackBox { callback: read }
        let viewed: CallbackBox[fn(*i32) -> i32] = source
        return viewed.callback
    let source: NestedCallbacks[fn(&i32) -> i32] = NestedCallbacks { callbacks: [(read,)] }
    let viewed: NestedCallbacks[fn(*i32) -> i32] = source
    extract(viewed)

@cold
fn cold_view(kind: usize) -> fn!(*i32) -> i32:
    if kind == 0:
        let source: (fn!(&i32) -> i32, usize) = (read_cold, 19)
        let viewed: (fn!(*i32) -> i32, usize) = source
        assert_equal(viewed._1, 19)
        return viewed._0
    if kind == 1:
        let source: CallbackBox[fn!(&i32) -> i32] = CallbackBox { callback: read_cold }
        let viewed: CallbackBox[fn!(*i32) -> i32] = source
        return viewed.callback
    let source: NestedCallbacks[fn!(&i32) -> i32] = NestedCallbacks { callbacks: [(read_cold,)] }
    let viewed: NestedCallbacks[fn!(*i32) -> i32] = source
    extract(viewed)

fn expired(seen: Weak[i32]?) -> bool:
    match seen:
        .Some(link) => link.upgrade().is_none()
        .None => false

fn alive(seen: Weak[i32]?) -> bool:
    match seen:
        .Some(link) => link.upgrade().is_some()
        .None => false

@cold
fn fresh_target(seen: &mut (Weak[i32]?)) -> *i32:
    value := box(+7)
    *seen = weak(value)
    value

@cold
fn plain_fresh(adapted: fn(*i32) -> i32) -> Weak[i32]?:
    let mut seen: Weak[i32]? = .None
    assert_equal(adapted(fresh_target(&mut seen)), 7)
    seen

@cold
fn plain_live(adapted: fn(*i32) -> i32) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    assert_equal(adapted(value), 7)
    assert_equal(*value, 7)
    seen

@cold
fn cold_fresh!(adapted: fn!(*i32) -> i32) -> Weak[i32]?:
    let mut seen: Weak[i32]? = .None
    pending := adapted(fresh_target(&mut seen))
    assert(alive(seen), reason="the unrun cold call keeps its argument")
    assert_equal(pending!(), 7)
    seen

@cold
fn cold_live!(adapted: fn!(*i32) -> i32) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    pending := adapted(value)
    assert_equal(*value, 7)
    assert(alive(seen), reason="the caller and cold frame keep the target")
    assert_equal(pending!(), 7)
    assert_equal(*value, 7)
    seen

@cold
fn cold_cancel!(adapted: fn!(*i32) -> i32) -> Weak[i32]?:
    let mut seen: Weak[i32]? = .None
    pending := adapted(fresh_target(&mut seen))
    assert(alive(seen), reason="cancellation starts from a live target")
    _ := pending.cancel!()
    seen

@cold
fn retained_owner(adapted: fn(*i32) -> i32) -> (Weak[i32]?, *i32):
    value := box(+7)
    seen := weak(value)
    owner := value
    assert_equal(adapted(value), 7)
    (seen, owner)

pub fn main!() -> void:
    for kind in 0..3:
        assert(
            expired(plain_fresh(plain(kind))),
            reason="a fresh plain argument has no orphan owner",
        )
        assert(
            expired(plain_live(plain(kind))),
            reason="a live plain caller eventually releases its owner",
        )
        assert(
            expired(cold_fresh!(cold_view(kind))),
            reason="cold completion releases the fresh argument",
        )
        assert(
            expired(cold_live!(cold_view(kind))),
            reason="a live cold caller eventually releases its owner",
        )
        assert(
            expired(cold_cancel!(cold_view(kind))),
            reason="cold cancellation releases the fresh argument",
        )
        let (seen, owner) = retained_owner(plain(kind))
        assert(alive(seen), reason="a separate strong owner prevents expiry")
        assert_equal(*owner, 7)
        _ := owner
        assert(expired(seen), reason="the last explicit owner releases the target")
