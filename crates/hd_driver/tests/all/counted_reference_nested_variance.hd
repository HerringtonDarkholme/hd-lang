# fn.type.declared-variance and types.variance.no-insertion.
use std.annotation.cold
use std.testing.assert_equal

struct CallbackBox[+F]:
    callback: F

struct NestedCallbacks[+F]:
    callbacks: List[(F,)]

@cold
fn read(value: &i32) -> i32:
    *value

@cold
fn read_cold!(value: &i32) -> i32:
    *value

@cold
fn extract[F](nested: NestedCallbacks[F]) -> F:
    nested.callbacks[0]._0

@cold
fn plain(kind: usize) -> fn(*i32) -> i32:
    if kind == 0:
        let source: (fn(&i32) -> i32, usize) = (read, 19)
        let viewed: (fn(*i32) -> i32, usize) = source
        assert_equal(viewed._1, 19)
        return viewed._0
    if kind == 1:
        let source: CallbackBox[fn(&i32) -> i32] = CallbackBox { callback: read }
        let viewed: CallbackBox[fn(*i32) -> i32] = source
        return viewed.callback
    let source: NestedCallbacks[fn(&i32) -> i32] = NestedCallbacks { callbacks: [(read,)] }
    let viewed: NestedCallbacks[fn(*i32) -> i32] = source
    extract(viewed)

@cold
fn cold_view(kind: usize) -> fn!(*i32) -> i32:
    if kind == 0:
        let source: (fn!(&i32) -> i32, usize) = (read_cold, 19)
        let viewed: (fn!(*i32) -> i32, usize) = source
        assert_equal(viewed._1, 19)
        return viewed._0
    if kind == 1:
        let source: CallbackBox[fn!(&i32) -> i32] = CallbackBox { callback: read_cold }
        let viewed: CallbackBox[fn!(*i32) -> i32] = source
        return viewed.callback
    let source: NestedCallbacks[fn!(&i32) -> i32] = NestedCallbacks { callbacks: [(read_cold,)] }
    let viewed: NestedCallbacks[fn!(*i32) -> i32] = source
    extract(viewed)

@cold
fn fresh_target() -> *i32:
    box(+7)

@cold
fn plain_fresh(adapted: fn(*i32) -> i32) -> void:
    assert_equal(adapted(fresh_target()), 7)

@cold
fn plain_live(adapted: fn(*i32) -> i32) -> void:
    value := box(+7)
    assert_equal(adapted(value), 7)
    assert_equal(*value, 7)

@cold
fn cold_fresh!(adapted: fn!(*i32) -> i32) -> void:
    pending := adapted(fresh_target())
    assert_equal(pending!(), 7, reason="the unrun cold call keeps its argument")

@cold
fn cold_live!(adapted: fn!(*i32) -> i32) -> void:
    value := box(+7)
    pending := adapted(value)
    assert_equal(*value, 7)
    assert_equal(pending!(), 7, reason="the caller and cold frame keep the target")
    assert_equal(*value, 7)

@cold
fn cold_cancel!(adapted: fn!(*i32) -> i32) -> void:
    pending := adapted(fresh_target())
    _ := pending.cancel!()

@cold
fn retained_owner(adapted: fn(*i32) -> i32) -> *i32:
    value := box(+7)
    owner := value
    assert_equal(adapted(value), 7)
    owner

# The checked runs' exit audit fails on any owner these calls leak, and a
# freed target's poison fails each read.
pub fn main!() -> void:
    for kind in 0..3:
        plain_fresh(plain(kind))
        plain_live(plain(kind))
        cold_fresh!(cold_view(kind))
        cold_live!(cold_view(kind))
        cold_cancel!(cold_view(kind))
        owner := retained_owner(plain(kind))
        assert_equal(*owner, 7, reason="a separate strong owner keeps the target")
