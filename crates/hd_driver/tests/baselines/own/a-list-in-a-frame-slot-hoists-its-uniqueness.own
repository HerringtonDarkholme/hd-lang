# Hoisting (#1353): `xs` lives in a frame slot because a later `&mut xs`
# addresses it, but no reference to it lives while the loop runs. The
# push's uniqueness check hoists before the loop, as for a list in a
# Wasm local, and the loop runs no check (`IsUnique hoisted`; the counts
# view names the loop's line either way). In `touch_each` the reference
# is taken in the loop, so the push keeps its check there.
use std.annotation.inline

@inline(.Never)
fn touch(xs: &mut List[u32]) -> void:
    xs.push(0)
