# @dump: own
# Hoisting: a loop with no entry test (`while true`) runs its body
# whenever it is entered, so the changes in its body and in the inner
# loops that stand there make each list unique once, before it
# (`IsUnique hoisted` for both lists before the outer loop). The lists
# are calls' results moved into their locals: hoisting's fresh values,
# though not fresh buffers (`IsUnique fresh`, only new collections), so
# a store into one list's buffer leaves the other's check hoisted.
use std.annotation.inline

@inline(.Never)
fn filled(n: usize, value: usize) -> List[usize]:
    [for _ in 0..n => value]
