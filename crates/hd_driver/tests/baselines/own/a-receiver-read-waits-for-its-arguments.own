# @dump: own counts
# A call's operand that reads a local's place moves to just before the
# call when a later operand reads the same place and nothing between them
# can change it. `m.at(m.infos[i].position)` then moves `m` into the call
# and `m.peek(...)` takes the local's own reference, with no count, as when
# the argument is read into a local first. `m.at(m.pop())` changes `m` in
# its argument, so the receiver stays a copy read before it.
struct Info:
    position: usize
    name: string

struct Members:
    infos: List[Info]

impl Members:
    fn at(self, position: usize) -> usize:
        self.infos.len() + position
