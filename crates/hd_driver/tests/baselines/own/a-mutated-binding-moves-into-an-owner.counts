use std.rt.bytes.bytes_at
use std.meta.Facts

struct Record:
    text: string
    size: usize
    at: usize
    index: List[usize]
    pending: List[usize]
    held: usize

struct Owner:
    inner: Record
    at: usize
    entry: usize
    present: bool
    depth: usize
    steps: List[i64]
    names: List[string]
    open: usize
    frames: List[usize]
    facts: Facts

impl Record:
    fn mutate(&mut self) -> void:
        size := self.size
        let index = self.at
        while index < size:
            byte := bytes_at(self.text, index)
            if byte != 32 && byte != 9 && byte != 10 && byte != 13:
                break
            index = index + 1
        self.at = index

fn own_after_mutation(p: Record, root: usize) -> Owner:
    let mut s = p
    s.at = 0
    s.mutate()
    start := s.at
    Owner {
        inner: s,
        at: start,
        entry: root,
        present: true,
        depth: 0,
        steps: [],
        names: [],
        open: 0,
        frames: [],
        facts: Facts { items: [] },
    }

fn make_owner(text: string) -> Owner:
    p := Record { text: text, size: text.len(), at: 0, index: [], pending: [], held: 0 }
    own_after_mutation(p, 0)
