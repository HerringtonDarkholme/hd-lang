# Release (§23.40, #1167): `size` only reads through `&self`, and its
# referent holds a string, so the inliner copies it by value even where
# the receiver is an element of a local's list (`local`), a place behind
# a reference (`behind`), or a temporary read through one (`total`). The
# copy's `self` binds the place's value, and the passes borrow it: no pin
# of the list, no count of the element.
struct Text:
    s: string

impl Text:
    fn size(&self) -> usize:
        self.s.len() + 1

type Wrapped(Text)

impl Wrapped:
    fn total(&self) -> usize:
        Text(*self).size()

struct Shelf:
    texts: List[Text]

fn behind(shelf: &Shelf, i: usize) -> usize:
    shelf.texts[i].size()

fn local(n: usize) -> usize:
    let mut xs: List[Text] = []
    for i in 0..n:
        xs.push(Text { s: "x" })
    let sum: usize = 0
    for i in 0..n:
        sum = sum + xs[i].size()
    sum
