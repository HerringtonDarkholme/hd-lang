# @build: v8 release
# Release borrowed receivers: `Shelf.weight` only reads its list field, so
# `self` borrows and `total` calls it with no count at the call and no
# release in the method. `weight` has more than 16 instructions, so a
# release build leaves it a call.
struct Shelf:
    books: List[string]
    n: i64

impl Shelf:
    fn weight(self) -> i64:
        i64(self.books.len()) * (self.n + 1) * (self.n + 2) * (self.n + 3) / (self.n + 4)

fn total(s: Shelf, times: i64) -> i64:
    let sum: i64 = 0
    for _ in 0..times:
        sum = sum + s.weight()
    sum
