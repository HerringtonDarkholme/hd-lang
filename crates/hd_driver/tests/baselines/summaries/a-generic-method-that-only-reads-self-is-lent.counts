    fn keep(self, all: &mut List[Handle[S]]) -> void:
        if (self.n + 1) * (self.n + 2) * (self.n + 3) * (self.n + 4) > 0:
            all.push(self)

fn total(h: Handle[i32], times: i64) -> i64:
    let sum: i64 = 0
    for _ in 0..times:
        sum = sum + h.weight()
    sum

fn generic_total[S](h: Handle[S]) -> i64:
    h.weight() + h.weight()

