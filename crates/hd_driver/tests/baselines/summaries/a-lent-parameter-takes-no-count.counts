fn total(f: Field, times: i64) -> i64:
    let sum: i64 = 0
    for _ in 0..times:
        sum = sum + weight(f)
    sum

fn collect(f: Field) -> usize:
    let mut all: List[Field] = []
    remember(&mut all, f)
