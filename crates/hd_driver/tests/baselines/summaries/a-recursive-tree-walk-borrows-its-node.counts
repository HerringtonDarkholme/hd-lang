# Release summaries, recursion: `walk` only reads its node and passes the
# children on to itself, so the component's fixed point borrows `n`: no
# count at either call and no release of `n` in the body. `leftmost`
# returns `last`, so `last` stays kept through the recursion, while `n`
# borrows.
struct Node:
    left: *Node?
    right: *Node?
    val: i32

fn walk(n: *Node?) -> i64:
    match n:
        .None => 0
        .Some(node) => i64(node.val) + walk(node.left) + walk(node.right)

fn leftmost(n: *Node?, last: *Node) -> *Node:
    match n:
        .None => last
