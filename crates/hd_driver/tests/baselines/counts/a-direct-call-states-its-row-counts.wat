      local.get $t3
      local.get $t4
      i64.store $heap align=1
      i32.const 1
      local.set $t7
    end
    local.get $t8
    local.get $t7
    i32.and
    if
      local.get $t0
      i32.load $heap offset=32
      call $retain
      i32.const 0
      local.set $t7
    end
    local.get $t0
    local.get $t7
  )
)
