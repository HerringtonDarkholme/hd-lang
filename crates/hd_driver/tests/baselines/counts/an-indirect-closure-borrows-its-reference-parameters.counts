# @build: v8 release
# Two possible closures keep the call indirect. Each borrows its local
# reference parameters without a referent count (#1343).
use std.annotation.inline

@inline(.Never)
fn apply(by: fn(&i32, &i32) -> i32, left: &i32, right: &i32) -> i32:
    by(left, right)

fn difference(reverse: bool, left: &i32, right: &i32) -> i32:
    by := if reverse: fn(a: &i32, b: &i32): *b - *a else: fn(a: &i32, b: &i32): *a - *b
    apply(by, left, right)
