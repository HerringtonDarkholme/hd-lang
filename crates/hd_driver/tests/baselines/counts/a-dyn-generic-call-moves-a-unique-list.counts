# A generic method called through a trait value owns its open argument:
# the caller moves the list into the open value's box, and nothing is
# released after the call. The box's glue releases the list's buffer.
# An open result moves out of a box with one holder (`rt:take_box`), and
# the caller drops the list through the buffer's own release,
# `rt:release_buffer`. Rule: #1279.
use std.collections.UniqList

trait Sink:
    fn take[T < ?Copy](&self, x: T) -> usize
    fn relay[T < ?Copy](&self, x: T) -> T

struct Bin:
    n: usize

impl Sink for Bin:
    fn take[T < ?Copy](&self, x: T) -> usize:
        self.n

    fn relay[T < ?Copy](&self, x: T) -> T:
        x

fn drop_into(s: &dyn Sink, list: UniqList[string]) -> usize:
    s.take(list)
