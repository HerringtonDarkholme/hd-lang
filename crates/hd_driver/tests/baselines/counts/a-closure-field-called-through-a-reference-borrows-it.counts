# @build: v8 release
# #1436, route B: a function value read through a reference (`&self` or
# `&mut self`) and only called borrows its environment, with no count, as
# Swift's `@callee_guaranteed` apply of a field of a `@guaranteed` struct
# does. Nothing can replace `transform` during the call: a path with no
# `*T` is exclusive at compile time, and the caller's loan on a `*T` it
# crossed (`ownership.md`, "Pointer Loans") lasts the call, which a
# function-value call never elides, so an alias's write panics
# `borrow-conflict`. Through a `*mut` with no reference
# (closure-field-call-through-a-counted-reference) the count stays.
struct Mapper:
    transform: fn(i32) -> i32
    calls: i32

impl Mapper:
    fn apply(&self, x: i32) -> i32:
        (self.transform)(x)

    fn apply_counted(&mut self, x: i32) -> i32:
        self.calls += 1
        (self.transform)(x)
