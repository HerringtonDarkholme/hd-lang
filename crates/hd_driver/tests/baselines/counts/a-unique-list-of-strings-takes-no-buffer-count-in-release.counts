fn first_len(words: &UniqList[string]) -> usize:
    match words.get_ref(0):
        .Some(word) => word.len()
        .None => 0

fn total(words: &UniqList[string]) -> usize:
    let total: usize = 0
    for word in words.iter():
        total += word.len()
    total

fn finish(words: UniqList[string]) -> usize:
    words.len()
