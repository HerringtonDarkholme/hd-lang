# A raw copy of one slot's `Buffer[u8]` into the next slot of an outer
# buffer, then a read of each (the room-audit probe of
# `checked_rooms_reject_leaks_and_double_frees`).
# Each slot then owns the same inner room, so the second read's `Drop`
# reports "double free of the block". sroa forwards `at`'s `&self` to
# `[$0 .ptr]`; the read through `[ptr %p]` is an access of `slots`'
# room, so `Drop [$0]` follows it (before the fix it came first, and the
# read gave the freed room's poison bytes).
use std.rt.memory.{Buffer, copy, size_of}

pub fn main() -> void:
    slots := Buffer::[Buffer[u8]].new(2)
