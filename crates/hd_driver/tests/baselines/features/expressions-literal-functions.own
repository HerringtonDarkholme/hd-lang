>   %1 = Read move [$0 .values] : List[i64]
>   %2 = NewStruct [%0 %1] : Query
>   %3 = Block %2 : Query
>   exit sub 0 drops [$0]
>   summary kept [$0]

@str_prefix
fn tag(t: Template[string]) -> usize:
    t.raw_parts.len() + t.values.len()
