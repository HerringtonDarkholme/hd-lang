fn literal_slot(raw: string) -> Point:
> app/main/literal_slot
>   local $0 raw: string [param read] value
>     uses $0: entry -> %1 consume last
>   %0 = Retain %5 Entry local $0 #0 : ()
    raw |> Point { name: _, x: 0 }
>   %1 = Read move [$0] : string
>   %2 = Intrinsic Empty [] : ()
>   %3 = NewStruct [%1 0:usize] : Point
>   %4 = Drop [$0] : ()
>   %5 = Block %3 : Point
>   exit sub 0 drops [$0]
>   summary kept [$0]
