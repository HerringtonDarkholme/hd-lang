fn literal_slot(raw: string) -> Point:
    raw |> Point { name: _, x: 0 }
> app/main/literal_slot
>   local $0 raw: string [param read] value
>     uses $0: entry -> %0 consume
>   %0 = Read move [$0] : string
>   %1 = NewStruct [%0 0:usize] : Point
>   %2 = Block %1 : Point
>   exit sub 0 drops [$0]
>   summary kept [$0]
