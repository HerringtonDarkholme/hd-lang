fn by_value(m: Map[string, string]) -> usize:
    let n: usize = 0
    for (k, v) in m:
        n += k.len() + v.len()
    n

fn by_ref(m: &Map[string, string]) -> usize:
    let n: usize = 0
    for (_, v) in m:
        n += v.len()
    n

