    local.tee $mutable.0
    i32.const 644 ;; &vtable[]
    ;; 46 |     println(read(mutable))
    call $read
    local.get $mutable.0
    if
      local.get $mutable.0
      call $rt:release_ref
    else
      call $skipped_test
    end
    local.get $provider0
    local.get $provider0.vtable
    call $"println[i32]"
    ;; 48 |     println(reader(boxed))
    local.get $boxed.0
    local.get $boxed.1
    call $read
    local.get $provider0
    local.get $provider0.vtable
    call $"println[i32]"
    ;; 49 |     callback := fn() -> i32: read(boxed)
    local.get $boxed.0
    local.get $boxed.1
    ;; 42 |     println(read(&S {}))
    call $read
    local.set $boxed.1
    local.get $boxed.0
    if
      local.get $boxed.0
      call $rt:release_ref
    else
      call $skipped_test
    end
    ;; (no span)
    local.get $boxed.1
    local.get $provider0
    local.get $provider0.vtable
    call $"println[i32]"
    local.get $t0
    i32.const 8
    i32.add
    global.set $stack
  )
  (func $"impl Tail for S.t" (param $self i32) (result i32)
    ;; 28 |         2
    i32.const 2
  )
  (func $read (param $x.0 i32) (param $x.1 i32) (result i32)
    ;; 39 |     x.d() + x.t() + left(x) + right(x)
    local.get $x.0
    local.get $x.1
    i32.load $heap
    i32.load $heap
    i32.load $heap
    call_indirect $table0 (param i32) (result i32)
    local.get $x.0
    local.get $x.1
    i32.load $heap offset=8
    i32.load $heap
    call_indirect $table0 (param i32) (result i32)
    i32.add
    local.get $x.0
    local.get $x.1
    i32.load $heap
    call $left
    i32.add
    local.get $x.0
    local.get $x.1
    i32.load $heap offset=4
    call $right
    i32.add
  )
  (func $"impl Base for S.d" (param $self i32) (result i32)
    ;; 20 |         1
    i32.const 1
  )
  (func $right (param $x.0 i32) (param $x.1 i32) (result i32)
    ;; 36 |     x.d()
    local.get $x.0
    local.get $x.1
    i32.load $heap
    i32.load $heap
    call_indirect $table0 (param i32) (result i32)
  )
)
