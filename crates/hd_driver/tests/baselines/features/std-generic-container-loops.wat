      local.set $b
    ;; (no span)
      local.get $saved
      call $rt:release_ref'1
    ;; 41 |     q.items[0] + saved.items[0]
      local.get $a
      local.get $b
      i64.add
    ;; (no span)
      local.set $a
    end
    local.get $a
    local.get $t0
    i32.const 16
    i32.add
    global.set $locals
  )
)
