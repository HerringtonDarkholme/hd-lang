# Feature: Function Types And Values, Function Type Constructors, Passing
# Function Values, Generic Function Values (spec/lang/07-functions.md, #1364).
# expected: a named function, a generic instance and a variant
# constructor as values make no closure object and no count; `apply`
# passes `s` borrowed; `variant_value` moves `s` into the payload.
use std.function.Fn

enum Event:
    Named(name: string)

fn width(s: string) -> usize:
    s.len()

fn apply(f: fn(string) -> usize, s: string) -> usize:
    f(s)

fn named_value(s: string) -> usize:
    apply(width, s)

fn ident[T](x: T) -> T:
    x

fn map_one[A, B](x: A, f: fn(A) -> B) -> B:
    f(x)

fn generic_value(s: string) -> string:
    map_one(s, ident)

fn variant_value(s: string) -> Event:
    map_one(s, Event.Named)

fn spelled() -> Fn[(string,), usize, $ ()]:
    width
