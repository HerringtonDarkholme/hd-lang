use std.collections.{Deque, Heap, Set}

fn seen(s: &mut Set[string], a: string, b: string) -> bool:
    _ := s.insert(a)
    s.contains(b)

fn queue(q: &mut Deque[string], a: string) -> usize:
    q.push_back(a)
    match q.pop_front():
        .Some(x) => x.len()
        .None => 0
