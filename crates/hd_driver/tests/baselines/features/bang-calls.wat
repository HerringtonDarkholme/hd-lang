    if
      local.get $t0
      call $rt:release_ref'1
    end
  )
  (func $label'2 (param $t1 i32) (param $t2 i32) (result i32) (local $t0 i32)
    ;; 9 |     s + "!"
    call $rt:frame'4
    local.tee $t0
    local.get $t1
    if
      local.get $t1
      call $retain
    end
    local.get $t1
    i32.store $heap offset=24
    local.get $t0
    local.get $t2
    i32.store $heap offset=28
    local.get $t0
  )
)
