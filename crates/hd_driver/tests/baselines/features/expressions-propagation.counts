# @build: v8 release
# Feature: Propagation of a `Result` and Error Conversion through `From` (spec/lang/05-expressions.md, #1364).
# expected: the `Ok` payload is only read and freed at its last use; an
# `Err` moves into the caller's result, and `From` moves it into the
# wrapper, with no count.
use std.convert.From

enum ReadError:
    Missing(path: string)

enum AppError:
    Read(error: ReadError)

impl From[ReadError] for AppError:
    fn from(value: ReadError) -> AppError:
        AppError.Read(value)

fn read(path: string) -> Result[string, ReadError]:
    if path.len() > 0: .Ok(path + "/") else: .Err(ReadError.Missing(path))

fn result_try(path: string) -> Result[usize, ReadError]:
    text := read(path)?
    .Ok(text.len())

fn converted(path: string) -> Result[usize, AppError]:
    text := read(path)?
    .Ok(text.len())
