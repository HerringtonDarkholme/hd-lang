# Emitter: the Wasm instructions that come from a subject (`wat`).
-- context --
struct Body:
    x: f64
    vx: f64
-- case: a field read through a list element --
fn x_of(bodies: &List[Body], i: usize) -> f64:
    bodies[i].x
    #^^^^^^^^^^
-- wat --
x_of
  block
    local.get bodies
    local.tee t0
    drop
    block
      local.get t0
      i32.load
      local.set t1
    end
    local.get t1
    i32.load
    local.set t2
    local.get i
    local.tee t3
    local.get t2
    i32.load offset=4
    i32.ge_u
    if
      call rt:panic
    end
    local.get t2
    local.get t3
    i32.const 16
    i32.mul
    i32.add
    f64.load offset=8
    local.set t4
  end
  local.get t4
  end
-- case: a field write through a list element --
fn place(bodies: &mut List[Body], i: usize, x: f64) -> void:
    bodies[i].x = x
    #^^^^^^^^^^^^^^
-- wat --
place
  block
    local.get bodies
    local.tee t0
    drop
    block
      local.get t0
      i32.load
      local.tee t1
      call rt:retain_known
    end
    local.get t1
    local.set t2
    local.get x
    local.set t3
    local.get t2
    local.tee t4
    i32.load
    local.set t5
    local.get i
    local.tee t6
    local.get t5
    i32.load offset=4
    i32.ge_u
    if
      call rt:panic
    end
    local.get t4
    call rt:list_unique
    local.get t4
    i32.load
    local.get t6
    i32.const 16
    i32.mul
    i32.add
    local.get t3
    f64.store offset=8
  end
  local.get t2
  call rt:release_ref
  end
-- case: a local struct field write --
fn moved(dt: f64) -> f64:
    let mut b = Body { x: 1.0, vx: 2.0 }
    b.x = b.x + dt * b.vx
    #^^^^^^^^^^^^^^^^^^^^
    b.x
-- wat --
moved
  drop
  local.get dt
  local.get b.vx
  f64.mul
  local.set t0
  local.get b.x
  local.get t0
  f64.add
  local.set t1
  local.get b.x
  drop
  local.get t1
  local.get b.vx
  local.set b.vx
  local.tee b.x
-- case: a call of a small function --
fn add(a: i32, b: i32) -> i32: a + b

fn twice(a: i32) -> i32:
    add(a, a)
    #^^^^^^^^
-- wat --
twice
  local.get a
  local.get a
  call add
  end
-- case: a string literal --
fn greet() -> string:
    "hello"
    #^^^^^^
-- wat --
greet
  block
    i32.const &"hello"
    i32.const 5
    local.set t0
    local.set t1
  end
  local.get t1
  local.get t0
  end
-- case: a top-level binding --
let calls = +0

fn count() -> void:
    calls = calls + 1
    #^^^^^^^^^^^^^^^^
-- wat --
count
  global.get calls
  i64.extend_i32_s
  i32.const 1
  i64.extend_i32_s
  i64.add
  local.tee t0
  i64.const 2147483647
  i64.gt_s
  local.get t0
  i64.const -2147483648
  i64.lt_s
  i32.or
  if
    call rt:panic
    unreachable
  end
  local.get t0
  i32.wrap_i64
  global.set calls
  end
-- case: a closure call --
fn apply(f: fn(i32) -> i32, x: i32) -> i32:
    f(x)
    #^^^
-- wat --
apply
  block
    local.get f.0
    local.get f.1
    local.set t0
    local.set t1
    i32.const 0
    local.set f.0
    i32.const 0
    local.set f.1
    local.get t0
    local.get x
    i32.const 0
    local.get t1
    call_indirect (i32 i32 i32) -> (i32)
    local.set t2
    local.get t0
    call rt:release_ref
    i32.const 0
    local.set t1
    i32.const 0
    local.set t0
    local.get t2
    local.set t3
  end
  local.get t0
  call rt:release_ref
  local.get f.1
  call rt:release_ref
  local.get t3
  end
-- case: an empty list --
fn none() -> List[Body]:
    []
    #^
-- wat --
none
  block
    i32.const &empty-buffer
    call rt:list_header
    local.tee t0
    local.set t1
    i32.const 0
    local.set t0
  end
  local.get t0
  call rt:release_ref
  local.get t1
  end
-- case: a generic call --
fn identity[T](x: T) -> T: x

fn one() -> i32:
    identity(+1)
    #^^^^^^^^^^^
-- wat --
one
  i32.const 1
  call identity[i32]
  end
-- case: two instances of one generic --
fn identity[T](x: T) -> T: x

fn moved(x: f64) -> f64:
    identity(identity(Body { x: x, vx: 1.0 }).x)
    #^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
-- wat --
moved
  local.get x
  f64.const 0x1p+0
  call identity[Body]
  drop
  call identity[f64]
  end
-- case: a std call --
fn hello() -> void $ Console:
    println("hello")
    #^^^^^^^^^^^^^^^^
-- wat --
hello
  i32.const &"hello"
  i32.const 5
  local.get provider0
  local.get provider0.vtable
  call println[string]
  end
-- case: a binding's release at the function's exit --
fn count(xs: List[i32]) -> usize:
    ys := xs
    #^^^^^^^
    ys.len()
-- wat --
count
  local.get xs
  local.set t0
  i32.const 0
  local.set xs
  local.get ys
  call rt:release_ref
  local.get t0
  local.set ys
  i32.const 0
  local.set t0
  local.get t0
  call rt:release_ref
  local.get ys
  call rt:release_ref
-- case: a nested binding's release at the function's exit --
fn first(xs: List[i32], c: bool) -> usize:
    if c:
        # subject
        ys := xs
        ys.len()
    else:
        0
-- wat --
first
  local.get xs
  local.tee t0
  call rt:retain_known
  local.get ys
  call rt:release_ref
  local.get t0
  local.set ys
  i32.const 0
  local.set t0
  local.get t0
  call rt:release_ref
  local.get ys
  call rt:release_ref
-- case: a top-level binding in a release build --
let total = +0

fn add(n: i32) -> void:
    total = total + n
    #^^^^^^^^^^^^^^^^
-- wat (wasmtime, release) --
add
  global.get total
  local.get n
  i32.add
  global.set total
  end
