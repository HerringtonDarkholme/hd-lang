# @dump: wat
# @build: v8 release
# expected: the loop reads the list `split` returned; no `rt:list_copy` of
# it, since nothing else holds that list (map_count: 650k words copied).
fn words(text: string) -> usize:
    let count: usize = 0
    for word in text.split(" "):
        count = count + word.len()
    count
