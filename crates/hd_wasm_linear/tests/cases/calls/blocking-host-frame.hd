# @dump: wat
# expected: synchronous block_on passes caller-local storage; stored and asynchronous calls keep their heap lifetime.
use std.fs.{FsError, FsRead}
use std.path.Path
use std.task.block_on

# subject
pub fn synchronous(path: Path) -> bool $ FsRead:
    let call: mut Suspend[Result[string, FsError]] = $.use(FsRead).read_text(path)
    match block_on(call):
        .Completed(.Ok(_)) => true
        _ => false

pub fn stored(path: Path) -> bool $ Console + FsRead:
    let call: mut Suspend[Result[string, FsError]] = $.use(FsRead).read_text(path)
    println("stored")
    match block_on(call):
        .Completed(.Ok(_)) => true
        _ => false

pub fn asynchronous!(path: Path) -> Result[string, FsError] $ FsRead:
    $.use(FsRead).read_text!(path)
