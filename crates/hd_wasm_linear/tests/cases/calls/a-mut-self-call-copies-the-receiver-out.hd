# @dump: wat
# A `mut self` method of a list returns the receiver's final value after
# its result, with a count of its own (`(result i32 i32)`), and the caller
# stores it into the place the argument read, `rows[i]`: a retain for the
# place, the old value's release, then the copied-out value's release.
trait Grow:
    fn grow(mut self, n: i64) -> usize

impl Grow for List[i64]:
    fn grow(mut self, n: i64) -> usize:
        self.push(n)
        self.len()

fn grow_row(mut rows: List[List[i64]], i: usize) -> usize:
    rows[i].grow(1)
    #^^^^^^^^^^^^^^
