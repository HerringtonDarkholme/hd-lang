fn f32_abs(value: f32) -> f32:
    value.abs()

fn f32_trunc(value: f32) -> f32:
    value.trunc()

fn f32_floor(value: f32) -> f32:
    value.floor()

fn f32_ceil(value: f32) -> f32:
