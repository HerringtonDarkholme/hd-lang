fn f64_abs(value: f64) -> f64:
    value.abs()

fn f64_trunc(value: f64) -> f64:
    value.trunc()

fn f64_floor(value: f64) -> f64:
    value.floor()

fn f64_ceil(value: f64) -> f64:
    value.ceil()

fn f64_round_ties_even(value: f64) -> f64:
