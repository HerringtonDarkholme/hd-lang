# expected: direct popcnt/clz/ctz, width-correct narrow counts, and u32 results without bit loops (#760).

fn i8_count_ones(value: i8) -> u32:
    value.count_ones()

fn i8_leading_zeros(value: i8) -> u32:
    value.leading_zeros()

fn i8_trailing_zeros(value: i8) -> u32:
    value.trailing_zeros()

fn u16_count_ones(value: u16) -> u32:
