# @dump: wat
# @build: v8 release
# A store after `get_ref` reuses its hash and search; an intervening map
# change makes the final store hash and probe again.
fn tally(counts: &mut Map[string, i64], word: string) -> void:
    counts[word] = counts.get_ref(word).copied().unwrap_or(0) + 1

fn tally_match(counts: &mut Map[string, i64], word: string) -> void:
    counts[word] = match counts.get_ref(word):
        .Some(seen) => *seen + 1
        .None => 1

fn changed_between(counts: &mut Map[string, i64], word: string, other: string) -> void:
    seen := counts.get_ref(word).copied().unwrap_or(0)
    counts[other] = 0
    counts[word] = seen + 1
