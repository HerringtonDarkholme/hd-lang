# @dump: wat
# @build: v8 release
# expected: get-or-insert hashes and probes `word` once, reuses a miss's
# probe for insertion, and its returned reference updates the stored entry.
fn increment_or_insert(counts: &mut Map[string, i64], word: string) -> void:
    *counts.get_or_insert(word, 0) += 1
