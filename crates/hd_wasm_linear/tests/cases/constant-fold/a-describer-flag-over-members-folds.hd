# @dump: wat
# @build: v8 release
# A per-type flag derived through a describer, as std.serde derives
# `regular` (#1445): the template runs `T::describe` with a describer
# whose `member` answers each member type's flag. The generated
# traversal and the describer's hooks are copied, the `?` arms that a
# known `.Ok(())` rules out are dead, and the copy makes one constant,
# so `entry` keeps only the fast arm, for a nested type too.
use std.structure.{Structure, Describer, Variant, Field}

trait Fast:
    fn regular() -> bool

impl Fast for i32:
    fn regular() -> bool:
        true

impl[T < Fast] Fast for List[T]:
    fn regular() -> bool:
        T::regular()

struct Probe: pass

impl[S < ?Copy] Describer[S] for Probe:
    type Error = void

    fn variant(&mut self, v: Variant[S]) -> Result[void, void]:
        .Ok(())

    fn member[F < ?Copy & Fast](&mut self, h: Field[S, F]) -> Result[void, void]:
        if F::regular(): .Ok(()) else: .Err(())

impl[T < ?Copy] Fast for T by Structure:
    fn regular() -> bool:
        let mut p = Probe {}
        T::describe(&mut p).is_ok()

@derive(Fast)
struct Inner:
    x: i32
    y: i32

@derive(Fast)
struct Outer:
    a: Inner
    xs: List[Inner]

fn slow(n: i32) -> string:
    let mut s = ""
    for i in 0..n:
        s = s + "$i,"
    s

fn pick[T < Fast](n: i32) -> string:
    if T::regular(): "fast" else: slow(n)

# subject
fn entry(n: i32) -> string:
    pick::[Outer](n)
