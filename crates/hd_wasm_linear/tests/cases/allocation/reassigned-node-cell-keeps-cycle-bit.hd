# @dump: wat
# @build: release
# A counted reference to a reassigned local cell can close a Node cycle.

struct Node:
    next: (*Node)?

fn make_cycle() -> *Node:
    let node = box(Node { next: .None })
    parent := box(Node { next: .Some(node) })
    node = box(Node { next: .Some(parent) })
    parent
