# @dump: wat
# @build: v8 release
# `cursor` lives in a slot of the function's frame on the local stack
# (crates/hd_wasm_linear/DESIGN.md §23.38): no `rt:new` box, and no retain
# or release around each `next` call (Iterator.fold and Sum.sum in
# closures and dyn_iter).
struct Counter:
    at: i64
    end: i64

impl Counter:
    fn next(&mut self) -> i64?:
        if self.at >= self.end:
            return .None
        value := self.at
        self.at = value + 1
        .Some(value)

fn total(counter: Counter) -> i64:
    let mut cursor = counter
    let sum: i64 = 0
    while true:
        match cursor.next():
            .Some(value) => sum = sum + value
            .None => break
    sum
