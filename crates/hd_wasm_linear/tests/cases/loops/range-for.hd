# @dump: wat
# @build: v8 release
# expected: one `i32.lt_u; i32.eqz; br_if` exit test and one increment per
# iteration; no `if (result i32)` around the test, no empty `block`, and no
# second bounds test before the increment (every `for i in 0..n` in
# fannkuch_redux, nbody, map_count and string_build).
# tracked by #667
fn sum(n: usize) -> usize:
    let total: usize = 0
    for i in 0..n:
        total = total + i
    total
