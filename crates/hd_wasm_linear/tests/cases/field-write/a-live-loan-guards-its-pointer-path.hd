# @dump: tir wat
# expected: the pointer-slot write checks a shared path-marker loan; the marker is registered immediately before the borrowed field and ends with it
struct User:
    name: string

struct Team:
    lead: *mut User

fn replace(t: *mut Team, alias: *mut Team) -> string:
    n := &t.lead.name
    alias.lead = box(User { name: "new" })
    *n
