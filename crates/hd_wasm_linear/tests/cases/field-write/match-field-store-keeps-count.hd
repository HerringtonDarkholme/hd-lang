# @dump: counts
# expected: a store through another reference may replace the same
# field; keep ownership of the option and payload until their last uses.
struct Node:
    value: i64
    left: (&Node)?

fn value(node: &Node, other: &mut Node) -> i64:
    match node.left:
        .None => 0
        .Some(left) =>
            other.left = .None
            left.value
