# @dump: tir wat
# expected: a path rooted at a local reference registers a shared marker on the pointer slot it reads, so the alias write checks the loan table
struct User:
    name: string

struct Team:
    lead: *mut User

fn replace(t: &Team, alias: *mut Team) -> string:
    n := &t.lead.name
    alias.lead = box(User { name: "new" })
    *n
