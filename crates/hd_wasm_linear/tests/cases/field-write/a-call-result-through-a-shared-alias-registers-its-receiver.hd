# @dump: wat
# expected: the shared receiver's address is kept before the call; the binding of the call's result registers the whole object and the write through the writable alias checks the loan table
struct User:
    name: string
    age: i32

impl User:
    fn label(&self) -> &string:
        &self.name

fn older(view: *User, alias: *mut User) -> string:
    held := view.label()
    alias.age += 1
    *held
