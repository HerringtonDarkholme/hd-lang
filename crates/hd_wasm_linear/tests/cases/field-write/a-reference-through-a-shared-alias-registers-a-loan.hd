# @dump: wat
# expected: the binding registers the shared counted reference's field as a loan; the overlapping write checks the loan table and the last use ends the loan
struct User:
    name: string
    age: i32

fn rename(view: *User, alias: *mut User) -> string:
    held := &view.name
    alias.age += 1
    alias.name = "b"
    *held
