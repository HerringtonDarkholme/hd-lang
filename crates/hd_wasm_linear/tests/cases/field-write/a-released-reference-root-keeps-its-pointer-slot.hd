# @dump: wat
# expected: the pointer slot's address is kept in a local before `r`'s last use releases it; the marker registered at the store uses that local, not the cleared `r`
struct User:
    name: string

struct Team:
    lead: *mut User

fn replace(t: *mut Team, alias: *mut Team) -> string:
    r := &*t
    n := &r.lead.name
    alias.lead = box(User { name: "new" })
    *n
