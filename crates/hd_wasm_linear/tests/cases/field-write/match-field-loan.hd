# @dump: counts tir
# expected: a call-free match borrows the option and payload from the
# caller-owned node for the match span, without retain/release pairs.
struct Node:
    value: i64
    left: (*Node)?

fn value(node: &Node) -> i64:
    alias := node
    match alias.left:
        .None => 0
        .Some(left) => left.value
