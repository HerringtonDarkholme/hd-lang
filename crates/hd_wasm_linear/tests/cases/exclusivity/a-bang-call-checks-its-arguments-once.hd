# @dump: wat
# expected: the first poll checks the whole `*mut User` argument; a resumed poll skips the check
use std.time.{Clock, sleep}

struct User:
    name: string

struct Team:
    lead: *mut User

fn wait!(user: *mut User) -> void $ Clock:
    sleep!(1ms)
    _ := user.name

fn conflict!(t: &Team, alias: *mut User) -> string $ Clock:
    held := &t.lead.name
    wait!(alias)
    *held
