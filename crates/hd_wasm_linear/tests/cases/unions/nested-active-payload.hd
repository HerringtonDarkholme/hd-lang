# @dump: wat counts
# expected: each union keeps its own tag, and the nested match borrows the
# active string payload without retain/release traffic.
type Inner = i32 | string
type Nested = Inner | bool

fn nested_length(value: Nested) -> usize:
    match value:
        ._0(inner) =>
            match inner:
                ._0(_) => 0
                ._1(text) => text.len()
        ._1(_) => 0
