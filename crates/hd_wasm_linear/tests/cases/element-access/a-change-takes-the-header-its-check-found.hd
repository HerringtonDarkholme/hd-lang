# @dump: wat
# A push through a reference (`b.parts`, behind `&mut`) reads its list
# right after the list's `IsUnique`. The check walks the place to the
# header, which may go through a reference view's getter, and the read
# takes that header from the check's local (`local.get $t0`) instead of
# walking the place again.
struct Builder:
    parts: List[string]

fn push(b: &mut Builder, text: string) -> void:
    b.parts.push(text)
    #^^^^^^^^^^^^^^^^^
