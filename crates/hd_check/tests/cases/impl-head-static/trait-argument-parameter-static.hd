# @dump: diagnostics
# @build: dev | checked | release
trait Saved[A]:
    pass
struct Holder:
    value: i32
impl Saved[&'static i32] for Holder:
    pass
fn require_saved['a, A < 'a, T < Saved[A]](value: T, marker: A) -> void:
    pass
fn inspect['a](value: Holder, marker: &'static i32) -> void:
    require_saved(value, marker)
