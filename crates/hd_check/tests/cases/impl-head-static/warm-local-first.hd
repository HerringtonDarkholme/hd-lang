trait Saved:
    fn number(&self) -> i32

struct Wrapped[T]:
    value: T

impl Saved for Wrapped[&'static i32]:
    fn number(&self) -> i32:
        +7

fn require_saved[T < Saved](value: T) -> void:
    pass

fn rejected['a](value: Wrapped[&'a i32]) -> void:
    require_saved(value)

fn accepted(value: Wrapped[&'static i32]) -> void:
    require_saved(value)
