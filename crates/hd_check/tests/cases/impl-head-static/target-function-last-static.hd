# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    pass
struct Wrapped[T]:
    value: T
impl Saved for Wrapped[(&'static i32, fn() -> void)]:
    pass
fn require_saved[T < Saved](value: T) -> void:
    pass
fn inspect['a](value: Wrapped[(&'static i32, fn() -> void)]) -> void:
    require_saved(value)
