# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    pass
struct Wrapped[T]:
    value: T
impl Saved for Wrapped[(fn() -> void, &'static i32)]:
    pass
fn require_saved[T < Saved](value: T) -> void:
    pass
fn inspect['a](value: Wrapped[(fn() -> void, &'static i32)]) -> void:
    require_saved(value)
