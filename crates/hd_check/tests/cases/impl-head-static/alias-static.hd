# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    fn number(&self) -> i32

struct Wrapped[T]:
    value: T

type Fixed = &'static i32

impl Saved for Wrapped[Fixed]:
    fn number(&self) -> i32:
        +7

fn require_saved[T < Saved](value: T) -> void:
    pass

fn inspect['a](value: Wrapped[&'static i32]) -> void:
    require_saved(value)
