# @dump: diagnostics
# A path through a missing module member is poison, so a later use reports nothing. Error recovery reports one diagnostic per failure.
use pkg.words

fn run() -> i32:
    let h = words.Nope::make
    let w = h + 1
    w
# @file: words.hd
pub fn join_words(words: List[string], separator: string) -> string:
    let out = ""
    for word in words:
        out = if out == "": squash(word) else: "$out$separator${squash(word)}"
    out

fn squash(word: string) -> string:
    word

pub struct Phrase:
    pub text: string

struct Draft:
    text: string
