# @dump: diagnostics
# A variant pattern naming an unknown field hides no later arm. Error recovery reports one diagnostic per failure.
enum Choice:
    One(value: i32)
    Pair(left: i32, right: i32)

fn pick(choice: Choice) -> i32:
    match choice:
        Choice.One(value=v) => v
        Choice.Pair(missing=a, right=b) => a + b
        Choice.Pair(left=a, right=b) => a - b
