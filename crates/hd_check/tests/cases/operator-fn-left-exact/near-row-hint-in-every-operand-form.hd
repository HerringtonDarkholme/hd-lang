# @dump: diagnostics
# The hint names the implementation's function type for each form of a
# function operand: a function reference (`by_ref`), a closure
# (`by_closure`) and a parameter of function type (`by_param`); with an
# implementation for the operand's own row that takes another right
# operand alongside (`expr.op.left-dispatch.exact-function.message`).
use std.ops.Shr

trait Db

struct Layer:
    depth: i32

struct Other:
    depth: i32

impl Shr[Other] for fn(i32) -> i32:
    type Out = i32
    fn shr(self, rhs: Other) -> i32:
        rhs.depth

impl Shr[Layer] for fn(i32) -> i32 $ Db:
    type Out = i32
    fn shr(self, rhs: Layer) -> i32:
        rhs.depth

fn get(n: i32) -> i32:
    n

fn by_ref(layer: Layer) -> i32:
    get >> layer

fn by_closure(layer: Layer) -> i32:
    let f = fn(n: i32) -> i32: n + 1
    f >> layer

fn by_param(f: fn(i32) -> i32, layer: Layer) -> i32:
    f >> layer

fn fits(f: fn(i32) -> i32 $ Db, layer: Layer) -> i32:
    f >> layer

pub fn main() -> void:
    pass
