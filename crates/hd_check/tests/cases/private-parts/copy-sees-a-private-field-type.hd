use pkg.shapes.{Holder, make}

fn twice(w: Holder) -> (Holder, Holder):
    (w, w)

fn check() -> void:
    _ := twice(make())
# @file: shapes.hd
struct Token:
    n: i32

impl !Copy for Token

pub struct Holder:
    token: Token

pub fn make() -> Holder:
    Holder { token: Token { n: 1 } }
