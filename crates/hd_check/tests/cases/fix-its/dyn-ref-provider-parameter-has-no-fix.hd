# @dump: diagnostics
# A value whose written reference would itself be an error, or that is no
# place, struct literal or local with an initializer, gets no fix-it.
# A parameter has no initializer to box, and boxing at the use would
# copy it.
trait Shape:
    fn area(&self) -> f64

struct Square:
    side: f64

impl Shape for Square:
    fn area(&self) -> f64:
        self.side * self.side

trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn show(shape: &dyn Shape) -> f64:
    shape.area()

fn count(counter: &mut dyn Counter) -> void:
    counter.bump()

fn demo(tally: Tally) -> void:
    $.with(Counter=tally):
        pass
