# @dump: diagnostics
use std.meta.annotate
use std.meta.Structure

struct Rename:
    name: string

fn rename(name: string) -> Rename:
    Rename { name: name }

struct Label:
    text: string

fn label(text: string) -> Label:
    Label { text: text }

@annotate::[F](.Field)
struct Tag[F]:
    value: F

fn tag[F](value: F) -> Tag[F]:
    Tag::[F] { value: value }

struct Tool:
    id: i32

impl Tool:
    @rename("a")
    @rename("b")  # here
    fn id_of(self) -> i32:
        self.id
