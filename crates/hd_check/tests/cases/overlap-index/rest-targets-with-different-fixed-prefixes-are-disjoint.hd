# @dump: diagnostics
# expected: sharing an argument index key does not make incompatible fixed tuple prefixes overlap.
trait Pick[A]:
    fn pick(self, value: A) -> i32

impl[T] Pick[i32] for (i32, List[T]...):
    fn pick(self, value: i32) -> i32:
        1

impl[U] Pick[i32] for (string, List[U]...):
    fn pick(self, value: i32) -> i32:
        2
