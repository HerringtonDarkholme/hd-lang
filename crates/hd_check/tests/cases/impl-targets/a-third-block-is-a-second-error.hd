# @dump: diagnostics
use std.structure.Structure

struct Tag:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

struct User:
    name: string
    email: string

struct Group:
    title: string

impl User by Structure:
    name += [tag("n")]

impl User by Structure:
    email += [tag("e")]

impl User by Structure
