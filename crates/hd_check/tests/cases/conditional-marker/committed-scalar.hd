# @dump: diagnostics
# @build: dev | checked | release
use std.ops.{AutoClosing, Disposable}
struct Wrapped[T]:
    value: T
impl[T < 'static] Disposable for Wrapped[T]:
    fn dispose(&mut self) -> void:
        pass
impl[T < 'static] AutoClosing for Wrapped[T]:
    pass
fn inspect(value: Wrapped[i32]) -> void:
    copy := value
    pass
