# @dump: diagnostics
# @build: std
# Projected targets are invalid, but their name conflicts still recover.
trait Source:
    type Item

trait Marker:
    fn marker(self) -> i32

impl[T < Source] Marker for (T::Item):
    fn marker(self) -> i32:
        +1

impl Marker for i32:
    fn marker(self) -> i32:
        +2

impl[U < Source] Marker for (U::Item):
    fn marker(self) -> i32:
        +3
