# @dump: diagnostics
# @build: dev | checked | release
trait Saved[A]:
    fn touch(self, value: A) -> void

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved[T] for Wrapped[T]:
    fn touch(self, value: T) -> void:
        pass

struct Holder[T]:
    Wrapped[T]

impl Saved[&'static i32] for Holder[&'static i32] by Wrapped
