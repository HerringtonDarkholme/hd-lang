# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    pass

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    pass

trait Shelf:
    type Item < Saved

impl Shelf for Wrapped[(&'static i32, fn() -> void)]:
    type Item = Wrapped[(&'static i32, fn() -> void)]
