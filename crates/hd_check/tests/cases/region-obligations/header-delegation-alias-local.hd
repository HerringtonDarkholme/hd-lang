# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    fn touch(self) -> void

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    fn touch(self) -> void:
        pass

type Borrowed['s] = Wrapped[&'s i32]

struct Holder[T]:
    Wrapped[T]

impl['a] Saved for Holder[Borrowed['a]] by Wrapped
