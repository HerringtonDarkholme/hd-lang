# @dump: diagnostics
# @build: dev | checked | release
# known (#2264): an impl target records no lifetime a `Suspend` in its type arguments names, so this reports nothing yet
trait Saved:
    pass

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    pass

struct Holder[T]:
    Wrapped[T]

impl['a] Saved for Holder[Suspend[i32, 'a]] by Wrapped
