# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    pass

struct Pair[A, B]:
    first: A
    second: B

impl[A < 'static, B] Saved for Pair[A, B]:
    pass

# expected: only the first default argument must outlive static
fn inspect['a, T < Saved = Pair[&'a i32, &'static i32]](value: T) -> void:
    pass
