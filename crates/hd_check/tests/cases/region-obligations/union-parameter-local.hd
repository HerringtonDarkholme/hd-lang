struct Wrapped[T]:
    value: T

fn require_static[T < 'static](value: Wrapped[T] | i64) -> void:
    pass

# expected: the structured parameter rejects local-reference-escapes for the local slot
fn inspect['a](value: Wrapped[&'a i32] | i64) -> void:
    require_static(value)
