# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    fn touch(&mut self) -> void

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    fn touch(&mut self) -> void:
        pass

struct Holder[T]:
    Wrapped[T]

impl['a] Saved for Holder[&'a i32] by Wrapped
