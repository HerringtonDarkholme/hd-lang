# @dump: diagnostics
# @build: dev | checked | release
trait Saved[A]:
    fn get(&self) -> A

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved[T] for Wrapped[T]:
    fn get(&self) -> T:
        self.value

struct Holder[T]:
    Wrapped[T]

impl['a] Saved[&'a i32] for Holder[&'a i32] by Wrapped
