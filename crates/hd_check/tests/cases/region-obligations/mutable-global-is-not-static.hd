# @dump: diagnostics
# @build: dev | checked | release
trait Saved:
    pass

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    pass

fn require_saved[T < Saved](value: T) -> void:
    pass

struct Number:
    value: i32

let mut number = Number { value: +7 }

pub fn main() -> void:
    require_saved(Wrapped { value: &number })
