use std.ops.{AutoClosing, Disposable}

struct Wrapped[T]:
    value: T

impl[T < 'static] Disposable for Wrapped[T]:
    fn dispose(&mut self) -> void:
        pass

impl[T < 'static] AutoClosing for Wrapped[T]:
    pass

# expected: an inapplicable conditional marker does not forbid an ordinary local binding
fn inspect['a](value: Wrapped[&'a i32]) -> void:
    copy := value
    pass
