# @dump: diagnostics
# types.limit.references.error on written types: R10 holds 1,024 references and checks,
# R11 holds 2,048 and is reported once on the item that writes it. Each use of an alias counts.
struct Point:
    x: i32

type R0 = &Point
type R1 = (R0, R0)
type R2 = (R1, R1)
type R3 = (R2, R2)
type R4 = (R3, R3)
type R5 = (R4, R4)
type R6 = (R5, R5)
type R7 = (R6, R6)
type R8 = (R7, R7)
type R9 = (R8, R8)
type R10 = (R9, R9)
type R11 = (R10, R10)

fn at_the_limit(r: R10) -> i32: 0

fn past_the_limit(r: R11) -> i32: 0

fn keep[T](t: T) -> i32: 0

fn main() -> void $ Console:
    n := keep(0)
    println(n.to_string())
