# @dump: diagnostics
# types.limit.references counts function types too: F11 holds 2,048 of them.
# A struct instance counts its type arguments, not its fields: Two^20[&Point] holds one.
struct Point:
    x: i32

struct Two[T]:
    a: T
    b: T

type F0 = fn() -> i32
type F1 = (F0, F0)
type F2 = (F1, F1)
type F3 = (F2, F2)
type F4 = (F3, F3)
type F5 = (F4, F4)
type F6 = (F5, F5)
type F7 = (F6, F6)
type F8 = (F7, F7)
type F9 = (F8, F8)
type F10 = (F9, F9)
type F11 = (F10, F10)

fn takes(f: F11) -> i32: 0

fn keep[T](t: T) -> i32: 0

fn main() -> void $ Console:
    p := Point { x: 1 }
    t0 := &p
    t1 := Two { a: t0, b: t0 }
    t2 := Two { a: t1, b: t1 }
    t3 := Two { a: t2, b: t2 }
    t4 := Two { a: t3, b: t3 }
    t5 := Two { a: t4, b: t4 }
    t6 := Two { a: t5, b: t5 }
    t7 := Two { a: t6, b: t6 }
    t8 := Two { a: t7, b: t7 }
    t9 := Two { a: t8, b: t8 }
    t10 := Two { a: t9, b: t9 }
    t11 := Two { a: t10, b: t10 }
    t12 := Two { a: t11, b: t11 }
    t13 := Two { a: t12, b: t12 }
    t14 := Two { a: t13, b: t13 }
    t15 := Two { a: t14, b: t14 }
    t16 := Two { a: t15, b: t15 }
    t17 := Two { a: t16, b: t16 }
    t18 := Two { a: t17, b: t17 }
    t19 := Two { a: t18, b: t18 }
    t20 := Two { a: t19, b: t19 }
    n := keep(t20)
    println(n.to_string())
