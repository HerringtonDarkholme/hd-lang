# @dump: diagnostics
# The diagnostic states the edit; the guide explains the rule.
struct Holder['a]:
    target: &'a mut i32

fn twice['a, 'b](r: &'b Holder['a]) -> (Holder['a], Holder['a]):
    (*r, *r) # diagnostic: move-out-of-place

pub fn main() -> void $ Console:
    let mut x = +1
    h := Holder { target: &mut x }
    pair := twice(&h)
    println("ok")
