# @dump: diagnostics fixed
# A field initializer borrows the existing local instead of copying it.
trait Named:
    fn number(&self) -> i32

struct Item:
    value: i32

impl Named for Item:
    fn number(&self) -> i32:
        self.value

struct Borrowed['a]:
    item: &'a dyn Named

fn inspect() -> i32:
    value := Item { value: 1 }
    held := Borrowed { item: value }
    held.item.number()
