# @dump: diagnostics
# The compiler-supplied `Fn` row of a named function, asked through an
# impl's bound (`F < Fn[(B,), B]`) while `B` is still a variable, can
# neither hold nor fail: it waits on that variable. The later
# annotation decides `B = i32`, and the goal then holds: no diagnostic.
use std.ops.Fn

trait Takes[A]:
    fn take(self) -> i32

struct W[F]:
    f: F

impl[B, F < Fn[(B,), B]] Takes[B?] for W[F]:
    fn take(self) -> i32: 0

fn need[A, T < Takes[A]](t: T, a: A) -> i32:
    t.take()

fn none_of[U]() -> U?:
    .None

fn double(x: i32) -> i32:
    x * 2

fn go() -> i32:
    let e = none_of()
    let r = need(W { f: double }, e)
    let fixed: i32? = e
    r

pub fn main() -> void:
    pass
