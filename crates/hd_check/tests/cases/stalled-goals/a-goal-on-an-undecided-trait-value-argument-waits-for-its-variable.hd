# @dump: diagnostics
# A trait goal whose argument holds a trait value with an undecided
# argument (`(*dyn Gen[?U])?`) is canonicalized through the trait value
# and waits on its variable. The later annotation decides it, and the
# goal then holds: no diagnostic.
trait Takes[A]:
    fn take(self) -> i32

trait Gen[X]:
    fn get(self) -> X

impl Takes[(*dyn Gen[i32])?] for i32:
    fn take(self) -> i32: self

fn need[A, T < Takes[A]](t: T, a: A) -> i32:
    t.take()

fn mk[U]() -> (*dyn Gen[U])?:
    .None

fn go(n: i32) -> i32:
    let g = mk()
    let r = need(n, g)
    let fixed: (*dyn Gen[i32])? = g
    r

pub fn main() -> void:
    pass
