# @file: a.hd
use pkg.b.{eat}

pub fn bite[T](xs: List[T], depth: i32) -> i32:
    if depth == 0: 0
    else: eat([xs], depth - 1) + 1
# @file: b.hd
use pkg.a.{bite}

pub fn eat[T](xs: List[T], depth: i32) -> i32:
    bite(xs, depth)
