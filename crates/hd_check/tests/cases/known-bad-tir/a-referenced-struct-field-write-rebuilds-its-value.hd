struct Record:
    items: List[i32]

struct Bag:
    items: List[i32]

impl Iterable[i32] for Bag:
    type IntoIter = ListIter[i32]
    fn iter(self) -> ListIter[i32]: self.items.iter()
# expected: Store directly through the parameter pointer plus the field offset.
fn update(body: &mut Body) -> void:
