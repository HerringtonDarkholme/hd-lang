use std.iter.ListIter

struct Body:
    x: f64
    vx: f64

struct Nested:
    body: Body

struct Record:
    items: List[i32]

struct Bag:
    items: List[i32]

impl Iterable[i32] for Bag:
    type IntoIter = ListIter[i32]
    fn iter(self) -> ListIter[i32]: self.items.iter()
# expected: Load the length field from the list header.
fn length(items: List[i32]) -> usize:
    # subject
    items.len()
