# @dump: tir
# Current RC TIR patterns for the IR design study (#667, #668).
# Snapshots record today's output; each expected note names the desired IR shape.
use std.iter.ListIter

struct Body:
    x: f64
    vx: f64

struct Nested:
    body: Body

struct Record:
    items: List[i32]

struct Bag:
    items: List[i32]

impl Iterable[i32] for Bag:
    type IntoIter = ListIter[i32]
    fn iter(self) -> ListIter[i32]: self.items.iter()
# expected: Keep the buffer alive around the ordinary call with visible count operations.
impl Body:
    fn speed(&self) -> f64: self.vx
fn speed(items: &mut List[Body], index: usize) -> f64:
    # subject
    items[index].speed()
