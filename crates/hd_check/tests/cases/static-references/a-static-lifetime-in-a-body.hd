# @dump: diagnostics
# In a body, `'static` is checked on a `let` annotation's reference slots
# (`ref.static.value`), its own and one nested in a list, and
# `&'static mut T` is no type (`ref.static.no-mut`).
struct Point:
    x: i32

impl Point:
    fn get(&self) -> i32:
        self.x

let origin = Point { x: 1 }
let mut moving = Point { x: 3 }

fn kept() -> i32:
    let p: &'static Point = &origin
    p.get()

fn local() -> i32:
    q := Point { x: 2 }
    let p: &'static Point = &q
    p.x

fn nested() -> usize:
    let ps: List[&'static Point] = [&origin]
    ps.len()

fn writable() -> i32:
    let p: &'static mut Point = &mut moving
    p.x
