# @dump: diagnostics
trait Show:
    fn show(self) -> string

struct Clock:
    hour: i32

impl Show for Clock:
    fn show(self) -> string: "${self.hour}h"

fn greet[T < Show](t: T) -> string:
    "hi ${t.show()}"

tests:
    use std.testing.assert_equal

    impl Show for Clock:
        fn show(self) -> string: "clock:${self.hour}"

    it("greets the clock"):
        assert_equal(greet(Clock { hour: 3 }), "hi 3h", reason="the module's impl")
