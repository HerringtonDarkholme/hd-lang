# @dump: diagnostics
trait Supplier:
    type Item
    fn get(self) -> Self::Item

struct Counter:
    start: i32

impl Supplier for Counter:
    type Item = i32
    fn get(self) -> i32:
        self.start

struct Name:
    text: string

impl Supplier for Name:
    type Item = string
    fn get(self) -> string:
        self.text

struct Opaque:
    id: i32

struct Vault:
    inside: Opaque

impl Supplier for Vault:
    type Item = Opaque
    fn get(self) -> Opaque:
        self.inside

fn first[T, S < Supplier[Element = T]](s: S) -> T:
    s.get()

fn read(s: &dyn Supplier[Element = i32]) -> i32:
    s.get()
