# @dump: diagnostics
fn add(left: i32, right: i32) -> i32: left + right
fn apply(value: i32, f: fn(i32) -> i32) -> i32: f(value)
fn pair(left: i32, right: i32) -> (i32, i32): (left, right)

fn run(n: i32) -> i32:
    a := n |> add(_, 1)
    b := n |> add(1, _)
    c := n |> _ * 2
    d := n |> pair(_, 0)._0
    a + b + c + d
