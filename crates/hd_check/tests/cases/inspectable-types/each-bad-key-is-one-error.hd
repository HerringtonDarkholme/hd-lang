# @dump: diagnostics
# One error per written key, none for the others around it.
use std.meta.Inspectable

trait Storage < Inspectable:
    fn get(self, key: string) -> string?

trait Cache < Storage:
    fn evict(mut self) -> void

trait Clock:
    fn now(self) -> i64

struct MemoryStorage: pass

impl Storage for MemoryStorage:
    fn get(self, key: string) -> string?:
        .None

fn load() -> void $ Storage + Cache + Clock:
    pass

fn run(job: fn() -> void $ Storage) -> void:
    pass
