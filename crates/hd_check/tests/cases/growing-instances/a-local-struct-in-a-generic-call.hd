# @dump: diagnostics
# A struct declared in a body, with two growing fields, passed to a
# generic function: the proof stops at its instance (#2013).
fn keep[T](t: T) -> T:
    t

fn main():
    struct G[T]:
        x: G[(T, T)]
        y: G[(T, bool)]
    let g: G[i32]? = .None
    let u = keep(g)
