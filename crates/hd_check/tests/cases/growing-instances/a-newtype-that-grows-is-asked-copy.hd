# @dump: diagnostics
# A newtype that grows through its base is `recursive-value-type` at its
# declaration (`types.newtype.no-recursion`), as a struct is, not
# `item-too-complex`: asking `Copy` of `G[i32]` stops at the declaration
# instead of walking `G[(i32, i32)]`, `G[((i32, i32), (i32, i32))]` and
# on without end (#2002, #2004).
type G[T](G[(T, T)])

fn take(g: G[i32]) -> G[i32]:
    h := g
    h
