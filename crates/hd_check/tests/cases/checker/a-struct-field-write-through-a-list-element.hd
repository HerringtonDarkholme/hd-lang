# @dump: tir
# Checker: the TIR of a subject.
struct Body:
    x: f64
    vx: f64

struct Counter:
    count: i32

impl Counter:
    fn bump(&mut self, by: i32) -> void:
        self.count = self.count + by
fn step(bodies: &mut List[Body], i: usize, dt: f64) -> void:
    bodies[i].x = bodies[i].x + dt * bodies[i].vx
    #^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
