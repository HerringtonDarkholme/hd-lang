# @dump: tir
# Migrated from #658 sample: a_bound_narrows_the_choice_to_its_trait (#684).
trait Left:
    fn label(self) -> i32

trait Right:
    fn label(self) -> i32

struct User:
    value: i32

impl Left for User:
    fn label(self) -> i32: self.value

impl Right for User:
    fn label(self) -> i32: self.value + 100

fn pick[T < Left](x: T) -> i32:
    x.label()

fn both(user: User) -> i32:
    pick(user)
