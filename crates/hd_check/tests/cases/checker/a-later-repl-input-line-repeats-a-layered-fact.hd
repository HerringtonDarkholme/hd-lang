# @dump: tir
# @repl: 3
# A REPL session's later input derives for a type an earlier input
# declares, and its member lines edit the declaration facts as within one
# module (annot.fact.shared, annot.line.extend). Input 2 is the type's
# block with no trait, a layer of its own (annot.no-trait.declaration-facts,
# annot.no-trait.then-blocks); its `Tag` makes this input's second `+=` a
# repeat (annot.line.duplicate).
impl Probe for Point by Structure:
    x += [note("n")]
    y += [tag("again")]
# @input: 1
use std.structure.{Structure, Field, Variant, Walker}
struct Tag:
    text: string

struct Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        self.out = self.out + h.info.name + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(&self, &mut w)
        w.out

struct Point:
    @tag("a")
    x: i64
    y: i64
# @input: 2
impl Point by Structure:
    y += [tag("b")]
