# @dump: tir
# Checker: an impl on `*T` lowers its target to the local carrier for the
# receiver, but the `box` it returns as its declared `*T` stays counted:
# `Counted[T]` from the `Ref` to the result, with no lend to `Ref[T]`.
trait Make:
    fn make(city: string) -> Result[Self, string]

struct Place:
    city: string

impl Make for Place:
    fn make(city: string) -> Result[Place, string]:
        .Ok(Place { city })
# subject
impl[T < Make & 'static] Make for *T:
    fn make(city: string) -> Result[*T, string]:
        .Ok(box(T::make(city)?))
