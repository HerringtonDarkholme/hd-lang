# @dump: tir
# fn.trait.bound-sugar: a body-local generic function's bound may write the
# function traits as `Fn(A) -> R $ Row`, as a header does; the input,
# the output and the row become the trait's arguments.
use std.function.Fn

fn top[F < Fn(i32) -> i32](f: F) -> i32:
    f(+1)

fn run() -> i32:
    fn apply[F < Fn(i32) -> i32](f: F) -> i32:
        f(+1)
    fn quiet[F < Fn() -> void $ Console](f: F) -> void:
        pass
    apply(fn(x: i32) -> i32: x + 1) + top(fn(x: i32) -> i32: x + 1)
