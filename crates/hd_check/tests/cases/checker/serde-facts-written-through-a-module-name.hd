# @dump: tir
# std-serde.enum-tagging.static-names: a tagging or rename fact written
# through a module name, `serde.tag(...)` or
# `serde.EnumTagging.Internal(...)`, names the std item as a bare name
# does, so its shape checks apply.
use std.serde
use std.serde.Serialize

@derive(Serialize)
@serde.EnumTagging.Internal("kind")
enum Point:
    Pair(x: i32, y: i32)

@derive(Serialize)
@serde.tag("kind")
@serde.rename_all(serde.RenameCase.SnakeCase)
enum Shape:
    @serde.rename("round")
    Circle(radius: i32)
    BigSquare(side: i32)

@derive(Serialize)
@serde.untagged()
enum Loose:
    One(a: i32)
    Two(b: string)

fn run() -> void:
    _ := Point.Pair(1, 2)
    _ := Shape.Circle(1)
    _ := Loose.One(1)
