# @dump: tir
# std-serde.enum-tagging.static-names: a tagging or rename fact written
# through a module name, `encoding.tag(...)` or
# `encoding.EnumTagging.Internal(...)`, names the std item as a bare name
# does, so its shape checks apply.
use std.encoding
use std.encoding.Serialize

@derive(Serialize)
@encoding.EnumTagging.Internal("kind")
enum Point:
    Pair(x: i32, y: i32)

@derive(Serialize)
@encoding.tag("kind")
@encoding.rename_all(encoding.RenameCase.SnakeCase)
enum Shape:
    @encoding.rename("round")
    Circle(radius: i32)
    BigSquare(side: i32)

@derive(Serialize)
@encoding.untagged()
enum Loose:
    One(a: i32)
    Two(b: string)

fn run() -> void:
    _ := Point.Pair(1, 2)
    _ := Shape.Circle(1)
    _ := Loose.One(1)
