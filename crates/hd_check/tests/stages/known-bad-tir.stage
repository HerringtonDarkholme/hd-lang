  %30 = Loop %29 - : ()
  %31 = LocalGet $1 : List[i32]
  %32 = LocalGet $2 : List[i32]
  %33 = Intrinsic SnapEnd [%31 %32] : ()
  %34 = Block - : ()
-- case: a map loop uses slot intrinsics --
