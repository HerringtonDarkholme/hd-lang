# Current RC TIR patterns for the IR design study (#667, #668).
# Snapshots record today's output; each expected note names the desired IR shape.
-- context --
use std.iter.ListIter

struct Body:
    x: f64
    vx: f64

struct Nested:
    body: Body

struct Record:
    items: List[i32]

struct Bag:
    items: List[i32]

impl Iterable[i32] for Bag:
    type IntoIter = ListIter[i32]
    fn iter(self) -> ListIter[i32]: self.items.iter()
-- case: a mutable list reference reads through a getter --
# expected: Load the list header from its address without a getter closure.
fn read[T](items: &mut List[T]) -> usize:
    # subject
    items.len()
-- tir --
app/main/read
  local $0 items: Ref[mut List[T]]
  %0 = LocalGet $0 : Ref[mut List[T]]
  %1 = Field %0 .0 : fn() -> List[T]
  %2 = CallValue %1 [] : List[T]
  %3 = Block %2 : List[T]
  %4 = RefRead %0 %3 : List[T]
  %5 = Intrinsic ListLen [%4] : usize
  %6 = Block %5 : usize
-- case: a mutable generic reference reads through a getter --
# expected: Load the declared value from a pointer without a getter closure.
fn read[T](value: &mut T) -> T:
    # subject
    *value
-- tir --
app/main/read
  local $0 value: Ref[mut T]
  %0 = LocalGet $0 : Ref[mut T]
  %1 = Field %0 .0 : fn() -> T
  %2 = CallValue %1 [] : T
  %3 = Block %2 : T
  %4 = RefRead %0 %3 : T
  %5 = Intrinsic ValueCopy [%4] : T
  %6 = Block %5 : T
-- case: a local struct field write rebuilds its value --
# expected: Store directly at the local struct address plus the field offset.
fn update(value: Body) -> Body:
    let mut body = value
    # subject
    body.x = 1.0
    body
-- tir --
app/main/update
  local $1 body: Body
  %2 = LocalGet $1 : Body
  %3 = LocalGet $1 : Body
  %4 = CopyData %3 [.x = 1.0:f64] : Body
  %5 = LocalSet $1 %4 : ()
-- case: a referenced struct field write rebuilds its value --
# expected: Store directly through the parameter pointer plus the field offset.
fn update(body: &mut Body) -> void:
    # subject
    body.x = 1.0
-- tir --
app/main/update
  local $0 body: Ref[mut Body]
  %0 = LocalGet $0 : Ref[mut Body]
  %1 = Field %0 .0 : fn() -> Body
  %2 = CallValue %1 [] : Body
  %3 = Block %2 : Body
  %4 = RefRead %0 %3 : Body
  %5 = Field %0 .0 : fn() -> Body
  %6 = CallValue %5 [] : Body
  %7 = Block %6 : Body
  %8 = RefRead %0 %7 : Body
  %9 = CopyData %8 [.x = 1.0:f64] : Body
  %10 = Field %0 .1 : fn(Body) -> ()
  %11 = CallValue %10 [%9] : ()
  %12 = Block - : ()
  %13 = RefWrite [%0 %9] %12 : ()
  %14 = Block - : ()
-- case: a nested field write rebuilds each enclosing value --
# expected: Add both constant field offsets and store without rebuilding aggregates.
fn update(value: Nested) -> Nested:
    let mut nested = value
    # subject
    nested.body.x = 1.0
    nested
-- tir --
app/main/update
  local $1 nested: Nested
  %2 = LocalGet $1 : Nested
  %3 = Field %2 .body : Body
  %4 = LocalGet $1 : Nested
  %5 = Field %4 .body : Body
  %6 = CopyData %5 [.x = 1.0:f64] : Body
  %7 = CopyData %4 [.body = %6] : Nested
  %8 = LocalSet $1 %7 : ()
-- case: a list loop uses a snapshot and index desugaring --
# expected: Lower for through Iterable and one Loop; inline its cursor to memory operations.
fn visit(items: List[i32]) -> void:
    # subject
    for _item in items:
        pass
