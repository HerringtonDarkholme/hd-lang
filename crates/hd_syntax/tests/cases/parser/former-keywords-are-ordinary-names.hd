# @dump: tree
# `defer`, `elif`, `const` and `as` are ordinary names: a function, a binding,
# a callee, a receiver and a generic callee.
fn defer(action: fn() -> void) -> void: action()
fn use(action: fn() -> void) -> void:
    defer(action)
fn bind(action: fn() -> void) -> void:
    defer := action
    defer()

fn called(n: bool):
    if n: pass
    elif(1)

fn bound(n: bool):
    if n: pass
    elif := 1
    elif

fn receiver(n: bool):
    if n: pass
    elif.ready()

fn generic(n: bool):
    if n: pass
    elif::[i32](1)

fn const(x: i32): x
fn as(x: i32): x
fn f(): const(as(1))
