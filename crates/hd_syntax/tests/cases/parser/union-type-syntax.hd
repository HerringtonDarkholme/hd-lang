# @dump: tree
# Union type syntax is flat unless parentheses preserve a nested union.
type Flat = A | B | C
type NestedLeft = (A | B) | C
type NestedRight = A | (B | C)
type NestedBoth = (A | B) | (C | D)
type NestedDeep = ((A | B) | C) | D
type Applied = Box[A] | B
type FunctionResult = fn() -> A | B
