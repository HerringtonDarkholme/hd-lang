# subject
fn places(r: &mut Point, items: List[Point], i: i32):
    w := &f(x) + 1
    y := -*r
    z := *-r
    aa := &*r
    bb := *&x
    cc := &x ** 2
    dd := *r ** 2
    ee := a & b
    ff := a & &b
    gg := a && b
    hh := a ^ b
    return *r
