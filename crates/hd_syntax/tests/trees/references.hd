fn places(r: &mut Point, items: List[Point], i: i32):
    p := &items[i].pos
    q := &mut r.pos.x
    s := *r.pos
    t := (*r).pos
    *r = Point { x: 1, y: 2 }
    *r.x += 1
    u := &mut Point { x: 1, y: 2 }
    v := &Box::[i32] { value: 1 }
    w := &f(x) + 1
    y := -*r
    z := *-r
    aa := &*r
    bb := *&x
    cc := &x ** 2
    dd := *r ** 2
    ee := a & b
    ff := a & &b
    gg := a && b
    hh := a ^ b
    return *r
