data Parser[T, ^doc]:
    source: ^{doc} Document
    items: List[T]?

impl[^doc] Parser[Item, ^{doc}]:
    fn take(^mut self, xs: ^mut List[^Item]) -> ^{self, xs.len, $Log, static} mut Item: pass
    fn peek(^self) -> ^fn() -> Parser[Item, ^]: pass
    fn swap(^mut self, d: Suspend[^{d} Doc], e: Pair[^, ^{e}]) -> void: pass

fn pick[T](a: ^dyn Show, own: i32) -> (T, ^T?): pass

fn body() -> void:
    let x = make()
    let own: i32 = x ^ 1
