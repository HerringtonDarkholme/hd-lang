data Parser[T]:
    source: ^Document
    items: List[T]?

impl Parser[Item]:
    fn take(^mut self, xs: ^mut List[^Item]) -> ^mut Item: pass
    fn peek(^self) -> ^fn() -> Parser[Item]: pass
    fn swap(^mut self, d: Suspend[^Doc], e: Pair[^A, ^mut B]) -> void: pass

fn pick[T](a: ^dyn Show, own: i32) -> (T, ^T?): pass

fn body() -> void:
    let x = make()
    let own: i32 = x ^ 1
