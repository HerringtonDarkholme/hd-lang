        i32.load $heap
        local.set $self
        local.get $index
        local.get $self
        i32.load $heap offset=4
        i32.ge_u
        if
          call $rt:panic'1
          unreachable
        end
        local.get $self
        local.get $index
        i32.const 8
        i32.mul
        i32.add
        local.set $self
        local.get $self
        i32.const 16
        i32.add
        local.set $self
      else
        i32.const 0
        local.set $self
      end
    end
    local.get $self
  )
  (func $hold_ref (param $value i32) (result i32)
    ;; 13 |     value
    block
    end
    local.get $value
  )
  (func $length (param $slot i32) (result i32 i32) (local $t0 i32)
    ;; 71 |     *slot
    block
      local.get $slot
      i32.load $heap
      local.set $t0
      local.get $slot
      i32.load $heap offset=4
      local.set $slot
      local.get $t0
      call $retain
    end
    local.get $t0
    local.get $slot
  )
)
