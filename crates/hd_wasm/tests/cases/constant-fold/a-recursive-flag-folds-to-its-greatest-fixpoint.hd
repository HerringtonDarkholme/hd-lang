# @dump: wat
# @build: v8 release
# A flag that asks itself again (a recursive type's derived flag) reads
# `true` for that inner call (annot.bound.recursive.flag). A release build
# solves the cycle at compile time (#1542), so `entry` keeps only the fast
# arm, with no call, as for a flag that does not recur.
trait Fast:
    fn regular() -> bool

struct A:
    x: i32

struct Node:
    x: i32

impl Fast for A:
    fn regular() -> bool:
        true

impl Fast for Node:
    fn regular() -> bool:
        A::regular() && Node::regular()

fn slow(n: i32) -> string:
    let mut s = ""
    for i in 0..n:
        s = s + "$i,"
    s

fn pick[T < Fast](n: i32) -> string:
    if T::regular(): "fast" else: slow(n)

# subject
fn entry(n: i32) -> string:
    pick::[Node](n)
