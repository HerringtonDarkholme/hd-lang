# @dump: counts wat
# A closure literal for a bare `F` has its own type (`fn.closure.type`), a
# value of its code's table slot and its captures: no closure object. So
# `apply[main#closure2]` and `each[main#closure1]` take it as values, keep
# no count of `k`, and call the closure's code directly (`call $main#2`)
# with the value's image in a frame area as its environment: no
# `call_indirect`. `each` keeps nothing of its argument, so `total`'s cell
# is a slot of `main`'s frame (#1449), held as an uncounted address: no
# `rt:new`, and no retain or release of any capture.
use std.ops.{Fn, FnMut}
use std.meta.inline

@inline(.Never)
fn apply[F < Fn(i32) -> i32](f: F, x: i32) -> i32:
    f(x) + f(x + 1)

@inline(.Never)
fn each[F < FnMut(i32) -> void](xs: List[i32], mut f: F) -> void:
    for x in xs:
        f(x)

pub fn main() -> void $ Console:
    let k = +3
    let total = +0
    each([1, 2], fn(x): total += x)
    println("${apply(fn(x): x * k, 4)} $total")
