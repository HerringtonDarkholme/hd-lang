# @dump: counts wat
# A closure literal for a bare `F` has its own type (`fn.closure.type`), so
# `apply` and `each` are instantiated for it (`apply[main#closure2]`) and
# call the closure's code directly in every build (`call $main#2`), with
# no `call_indirect`. expected: the closure is still an object
# (`rt:new/class-1`) that each instance releases at its last use; by-value
# captures will remove the object and its count.
use std.ops.{Fn, FnMut}
use std.meta.inline

@inline(.Never)
fn apply[F < Fn(i32) -> i32](f: F, x: i32) -> i32:
    f(x) + f(x + 1)

@inline(.Never)
fn each[F < FnMut(i32) -> void](xs: List[i32], mut f: F) -> void:
    for x in xs:
        f(x)

pub fn main() -> void $ Console:
    let k = +3
    let total = +0
    each([1, 2], fn(x): total += x)
    println("${apply(fn(x): x * k, 4)} $total")
