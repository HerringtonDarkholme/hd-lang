# @dump: wat
# @build: v8 release std
# `make_unique` (module.rt.make-unique) where the module links weak
# references: an upgrade makes a second owner that no copy shows, so the
# test loads the count and the weak side-entry word together, and the
# passes' marks don't drop it.
use std.rt.memory.make_unique
use std.weak.weak

struct Count:
    n: i64

fn copy_count(c: &Count) -> Count:
    Count { n: c.n }

fn write(p: &mut *Count, v: i64) -> void:
    # subject
    make_unique(p, copy_count).n = v

fn watched(c: &Count) -> bool:
    weak(c).is_some()
