# @dump: wat
# @build: v8 release std
# `make_unique` (module.rt.make-unique.copy): a loop that may break before
# its write keeps the call and its count test in the loop, so a loop that
# breaks first copies nothing.
use std.rt.memory.make_unique
use std.collections.UniqList
use std.annotation.inline

struct L:
    store: *UniqList[i64]

fn copied(u: &UniqList[i64]) -> UniqList[i64]:
    let mut c = UniqList::[i64].with_capacity(u.len())
    for i in 0..u.len():
        c.push(u[i])
    c

impl L:
    @inline
    fn set(&mut self, i: usize, v: i64) -> void:
        make_unique(&mut self.store, copied)[i] = v

fn write_until(xs: &mut L, n: usize, stop: usize) -> void:
    # subject
    for i in 0..n:
        if i == stop:
            break
        xs.set(i, 5)
