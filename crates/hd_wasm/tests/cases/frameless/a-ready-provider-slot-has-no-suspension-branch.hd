# @dump: wat
# @build: dev program | release program
# @helpers: app/main/read
# The dynamic read uses the drive slot and discards its proven-zero frame, without a suspension point.
use std.meta.inline

trait Read:
    fn read!(&self) -> i32

struct Ready:
    value: i32

impl Read for Ready:
    fn read!(&self) -> i32:
        self.value

@inline(.Never)
fn read!() -> i32 $ Read:
    $.use(Read).read!()

pub fn main!() -> void $ Console:
    $.with(Read=box(Ready { value: 7 })):
        println(read!())
