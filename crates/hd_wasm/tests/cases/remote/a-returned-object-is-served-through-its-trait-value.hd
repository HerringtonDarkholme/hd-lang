# @dump: wat
# @build: v8 release
# @helpers: std/remote/serve
# A method that returns a `*mut dyn Counter` has it served (R3): its
# result's codec boxes a closure over the reference into the home's
# table, and that closure calls `serve[Counter]`, the dispatcher of the
# trait value, which tests the interface, switches on the method number
# and calls through the trait value's table.
use std.remote.{CrossError, Home, Remote, Rooted, handle_call}

trait Counter < Remote:
    fn add!(&mut self, by: i64) -> Result[i64, string | CrossError]

trait Bank < Remote:
    fn open!(&mut self, cents: i64) -> Result[*mut dyn Counter, string | CrossError]

struct Tally:
    total: i64

impl Counter for Tally:
    fn add!(&mut self, by: i64) -> Result[i64, string]:
        self.total += by
        .Ok(self.total)

struct Teller:
    fee: i64

impl Bank for Teller:
    fn open!(&mut self, cents: i64) -> Result[*mut dyn Counter, string]:
        .Ok(box(Tally { total: cents - self.fee }))

fn answer!(home: &mut Home[Teller, string], rooted: &mut Rooted[Teller], frame: List[u8]) -> List[u8]:
    handle_call!(home, rooted, frame)
    #^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
