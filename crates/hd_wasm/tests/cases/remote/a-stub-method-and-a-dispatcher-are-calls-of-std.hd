# @dump: wat
# @build: v8 release
# @helpers: app/main/Users.count std/remote/serve
# A remote trait's stub method is one `stub_call` with its trait's
# interface (`interface_of`), the method's number and its arguments as one
# tuple; `serve[S]` takes the head `handle_call!` read, compares its
# interface, switches on the method number and runs one arm: `serve_args`,
# the root's implementation, `serve_ran`. Framing, encoding and refusals
# are std's plain hd. Both are bang functions, so most of each is its
# suspension frame: stack check, frame setup, the poll, cancel and drop
# functions.
# expected: a stub method whose body only awaits one call forwards to
# the callee's frame and has none of its own; `serve[S]` lends the head to
# `serve_args` and `serve_ran` instead of retaining a copy for each.
use std.remote.{CrossError, Home, Remote, Rooted, Transport, handle_call, remote}

trait Users < Remote:
    fn count!(&mut self, since: i64) -> Result[i64, string | CrossError]

struct Table:
    rows: i64

impl Users for Table:
    fn count!(&mut self, since: i64) -> Result[i64, string]:
        pause!()
        .Ok(self.rows - since)

fn answer!(home: &mut Home[Table, string], rooted: &mut Rooted[Table], frame: List[u8]) -> List[u8]:
    handle_call!(home, rooted, frame)

fn connect!(transport: *mut dyn Transport) -> Result[i64, string | CrossError]:
    users := remote::[Users](transport)
    users.count!(3)
    #^^^^^^^^^^^^^^

# Keep the frame path live: the stored closure can wait.
fn pause!() -> void:
    step := fn!() -> void: pass
    step!()
