# @dump: wat counts
# @build: v8 release
# Updates and counts only `pending`: the key moves into the field, and
# the parts are neither copied nor counted.
# JSON: TextWriter.name_next writes one field through a reference.
# The discarded read is removed by #669.

struct WriterState:
    pending: string
    parts: List[string]
    depth: usize

fn name_next(state: &mut WriterState, key: string) -> void:
    # subject
    state.pending = key
