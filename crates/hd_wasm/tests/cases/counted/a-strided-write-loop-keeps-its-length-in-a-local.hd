# @dump: wat
# @build: v8 release
# Sieve's inner loop over a builtin `List` and a `PlainList` (#2369): both
# make the block unique once before the loop, keep the block and its
# length in locals (the copy keeps the length), and keep the bounds test
# `j += i` does not decide. Only the panic call differs.
use std.collections.PlainList

fn mark_builtin(flags: &mut List[bool], i: usize, n: usize) -> void:
    let mut j = i * i
    while j < n:
        flags[j] = false
        j += i

fn mark_std(flags: &mut PlainList[bool], i: usize, n: usize) -> void:
    let mut j = i * i
    while j < n:
        flags[j] = false
        j += i
