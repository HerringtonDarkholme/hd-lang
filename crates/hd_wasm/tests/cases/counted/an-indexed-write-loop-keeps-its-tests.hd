# @dump: wat
# @build: v8 release
# `xs[i] *= 2` on a `PlainList` is `IndexMut::index_mut` (#2369 step 2b):
# a bounds test, `make_unique`, then the store. The make-unique is the
# builtin's `IsUnique` and leaves the loop, under the entry test.
# expected: as the builtin's loop, the block in a local and no bounds test
# in it (switch step 0b: the tail store makes the loop not read-only to
# `loop_loads`, so the block and length loads stay and the guard is kept).
use std.collections.PlainList

fn double(xs: &mut PlainList[i64]) -> void:
    # subject
    for i in 0..xs.len():
        xs[i] *= 2
