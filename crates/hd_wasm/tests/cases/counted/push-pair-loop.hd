# @dump: wat
# @build: v8 release
# A push loop of two-leaf values over a `PlainList` (#2369): the value's
# value's two leaves are stored at `offset=16` and `offset=24`, through
# the built-in `ListPush` as the builtin list's are.
use std.collections.PlainList

fn build(n: i64) -> PlainList[(i64, i64)]:
    let mut xs = PlainList::[(i64, i64)].new()
    let mut i: i64 = 0
    # subject
    while i < n:
        xs.push((i, n))
        i += 1
    xs
