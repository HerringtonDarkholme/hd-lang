# @dump: wat
# @build: v8 release
# An index-sum loop over a `PlainList` (#2369): the block's address leaves
# the loop, and the bounds test goes, since `i < n` decides it (`n` and
# the guard's length load read one unchanged place through two inlined
# `self` copies of `xs`, #2368): one value load per value, as the builtin.
use std.collections.PlainList

fn sum_index(xs: &PlainList[i64]) -> i64:
    let mut s: i64 = 0
    let mut i: usize = 0
    n := xs.len()
    # subject
    while i < n:
        s += xs[i]
        i += 1
    s
