# @dump: wat
# @build: v8 release
# `xs[i] = 7` on a local `PlainList`: the inlined `self` is a local
# reference `&xs`, which names no parameter, so the make-unique stays in
# the loop.
# expected: as the parameter form, one `rt:list_unique` before the loop
# (issue: target/lane296/issues/1-a-local-lists-write-loop-keeps-its-make-unique.md).
use std.collections.PlainList

fn fill(n: usize) -> PlainList[i64]:
    let mut xs = PlainList::[i64].with_capacity(n)
    let mut k: usize = 0
    while k < n:
        xs.push(0)
        k += 1
    # subject
    for i in 0..xs.len():
        xs[i] = 7
    xs
