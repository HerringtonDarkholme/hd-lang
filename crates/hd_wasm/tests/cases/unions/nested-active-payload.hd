# @dump: wat counts
# @build: dev | release
# expected: each union keeps its tag and the payload bindings borrow.
# The dev value-parameter ABI releases `value` once at exit; release
# uses the read-only parameter summary and takes no count.
type Inner = i32 | string
type Nested = Inner | bool

fn nested_length(value: Nested) -> usize:
    match value:
        ._0(inner) =>
            match inner:
                ._0(_) => 0
                ._1(text) => text.len()
        ._1(_) => 0
