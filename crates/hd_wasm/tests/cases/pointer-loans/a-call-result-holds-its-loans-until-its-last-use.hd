# @dump: wat
# `slot` hands out the `*mut Cell` behind `p.next` (a reference through it
# would be local to `slot`, `ref.local.pointer`), and `r`, the caller's own
# `&mut` through it, takes an exclusive loan on that `Cell` until its last
# use. The write through `alias` in its live range keeps the loan.
struct Cell:
    value: string

struct Outer:
    next: *mut Cell

impl Outer:
    fn slot(&mut self) -> *mut Cell:
        self.next

fn probe(p: *mut Outer, alias: *mut Cell) -> string:
    r := &mut p.slot().value
    alias.value = "b"
    *r
