# @dump: wat
# @build: dev | release
# expected: the loan holds across later(alias) and observe; disjoint access and post-call mutation remain valid
struct Slots:
    items: List[string]

impl Slots:
    fn at['a](&'a mut self, index: usize) -> &'a mut string:
        &mut self.items[index]

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

struct Outer:
    items: Slots

fn observe(r: &mut string, alias: *mut Outer) -> string:
    *r = "through the reference"
    *r

fn later(alias: *mut Outer) -> *mut Outer:
    alias.items.push("changed before observe")
    alias

# subject
fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    observe(p.items.at(0), later(alias))

pub fn main() -> void $ Console:
    p := box(Outer { items: Slots { items: ["orig-" + "z".repeat(40)] } })
    other := box(Outer { items: Slots { items: ["other"] } })
    println(probe(p, other))
    p.items.push("after call")
    println("ok")
