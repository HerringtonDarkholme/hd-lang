# @dump: wat
# @build: dev | release
# expected: only the selected branch takes a loan; each loop iteration clears its call headers
struct Slots:
    items: List[string]

impl Slots:
    fn at['a](&'a self, index: usize) -> &'a string:
        &self.items[index]

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

struct Outer:
    items: Slots

fn observe(r: &string, alias: *mut Outer) -> string:
    *r

fn later(alias: *mut Outer) -> *mut Outer:
    alias.items.push("changed before observe")
    alias

# subject
fn probe(p: *mut Outer, other: *mut Outer) -> void:
    for round in 0..4:
        pick := round % 2 == 0
        alias := if pick: other else: p
        _ := observe(if pick: p.items.at(0) else: other.items.at(0), later(alias))

pub fn main() -> void $ Console:
    p := box(Outer { items: Slots { items: ["orig-" + "z".repeat(40)] } })
    other := box(Outer { items: Slots { items: ["other-" + "y".repeat(40)] } })
    probe(p, other)
    println("ok")
