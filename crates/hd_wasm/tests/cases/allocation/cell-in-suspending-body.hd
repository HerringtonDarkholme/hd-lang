# @dump: wat
# @build: v8 release
# A suspending body reads its cell with no zero test after the
# suspension: the declaration stored on every path, the frame keeps the
# cell's local across the point, and a resume continues on that path
# (DESIGN.md, "Cells made before use"). Compare
# allocation/new-reference, the same in a plain body.
use std.time.{Clock, ms, sleep}

struct Tally:
    n: i64

fn bump(t: &mut Tally) -> void:
    t.n = t.n + 1

fn waits!() -> i64 $ Clock:
    let mut tally = Tally { n: 0 }
    sleep!(ms(1))
    bump(&mut tally)
    #^^^^^^^^^^^^^^^
    tally.n
