    fn g62(&self) -> i32:
        +62
    fn g63(&self) -> i32:
        +63

struct W[A]:
    a: A

impl[A] Get for W[A]:
    pass

fn l0[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l1((a, +0), out)
    l1((a, 0u8), out)

fn l1[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l2((a, +0), out)
    l2((a, 0u8), out)

fn l2[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l3((a, +0), out)
    l3((a, 0u8), out)

fn l3[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l4((a, +0), out)
    l4((a, 0u8), out)

fn l4[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l5((a, +0), out)
    l5((a, 0u8), out)

fn l5[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l6((a, +0), out)
    l6((a, 0u8), out)

fn l6[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l7((a, +0), out)
    l7((a, 0u8), out)

fn l7[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l8((a, +0), out)
    l8((a, 0u8), out)

fn l8[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    l9((a, +0), out)
    l9((a, 0u8), out)

fn l9[A < 'static](a: A, out: &mut List[*dyn Get]) -> void:
    out.push(box(W { a: a }))

@inline(.Never)
fn apply(f: fn(i32) -> i32, x: i32) -> i32:
    f(x)

pub fn main() -> void $ Console:
    let mut out: List[*dyn Get] = []
    l0(+0, &mut out)
    let sum = +0
    for g in out:
        sum = sum + g.g63()
    # subject
    if sum > 0:
        target := box(Leaf { value: apply(fn(x: i32) -> i32: x + sum, +1) })
        println("$sum ${weak(target).is_some()}")
