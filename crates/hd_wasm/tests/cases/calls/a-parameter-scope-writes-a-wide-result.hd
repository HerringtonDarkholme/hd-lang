# @dump: own wat
# @build: std | std release
# expected: scope forwarding writes every result field; scalar constants are stored and a wide parameter is copied.
use std.rt.inline

struct Wide:
    a: i32
    b: i32
    c: i32
    d: i32
    e: i32
    f: i32
    g: i32
    h: i32
    i: i32
    j: i32
    k: i32
    l: i32
    m: i32
    n: i32
    o: i32
    p: i32
    q: i32

@inline(.Always)
fn identity(value: Wide) -> Wide:
    value

# subject
fn parameter_scope(value: Wide) -> Wide:
    identity(value)
