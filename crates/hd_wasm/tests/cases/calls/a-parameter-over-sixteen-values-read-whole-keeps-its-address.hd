# @dump: wat
# @build: std
# A parameter over 16 values read whole keeps its address (#2170).
# `keep[Big]` copies its parameter into the result block with one
# memory.copy, and `main` passes `make`'s result block on to it, loading
# nothing. `moved_on` moves its counted parameter whole to `take` on one
# branch: the move sets the parameter's dead flag, and the exit releases
# it only when the flag is clear. `loud_on` does the same for a value
# with a `Drop` hook, whose exit runs the hook only when it did not move.
use std.annotation.inline
use std.rt.Drop

struct Big:
    f0: i32
    f1: i32
    f2: i32
    f3: i32
    f4: i32
    f5: i32
    f6: i32
    f7: i32
    f8: i32
    f9: i32
    f10: i32
    f11: i32
    f12: i32
    f13: i32
    f14: i32
    f15: i32
    f16: i32

struct Named:
    big: Big
    name: string

struct Loud:
    big: Big
    id: i32

impl !Copy for Loud

impl Drop for Loud:
    fn drop(&mut self) -> void:
        self.id = 0

fn make(x: i32) -> Big: Big { f0: x, f1: x, f2: x, f3: x, f4: x, f5: x, f6: x, f7: x, f8: x, f9: x, f10: x, f11: x, f12: x, f13: x, f14: x, f15: x, f16: x }

@inline(.Never)
fn keep[T](x: T) -> T: x

@inline(.Never)
fn take(n: Named) -> i32: i32(n.name.len())

fn moved_on(n: Named, go: bool) -> i32:
    if go:
        return take(n)
    n.big.f2

@inline(.Never)
fn hold(l: Loud) -> i32: l.id

fn loud_on(l: Loud, go: bool) -> i32:
    if go:
        return hold(l)
    l.big.f1

pub fn main() -> void $ Console:
    let b = keep(make(1))
    let n = Named { big: make(2), name: "n" }
    let l = Loud { big: make(3), id: 3 }
    println("${b.f16} ${moved_on(n, true)} ${loud_on(l, false)}")
