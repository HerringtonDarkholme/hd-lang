# @dump: wat
# @build: std
# An enum over 16 values with a `Drop` hook in a payload passes by
# address, as such a struct does (#2170). `consume` takes it only to drop
# it: its exit copies it into a heap frame (`rt:heap_frame`), runs the
# enum's hook witness there, each hook under its variant's test, copies
# it back and releases `name` and `part.id` from the address by the
# enum's own switch walk.
use std.rt.Drop

struct Part:
    id: string

impl !Copy for Part

impl Drop for Part:
    fn drop(&mut self) -> void:
        self.id = ""

struct Big:
    f0: i32
    f1: i32
    f2: i32
    f3: i32
    f4: i32
    f5: i32
    f6: i32
    f7: i32
    f8: i32
    f9: i32
    f10: i32
    f11: i32
    f12: i32
    f13: i32
    f14: i32
    f15: i32
    name: string

enum Holder:
    Wide(Big, Part)
    Narrow(Part)

fn mk(x: i32) -> Big: Big { f0: x + 0, f1: x + 1, f2: x + 2, f3: x + 3, f4: x + 4, f5: x + 5, f6: x + 6, f7: x + 7, f8: x + 8, f9: x + 9, f10: x + 10, f11: x + 11, f12: x + 12, f13: x + 13, f14: x + 14, f15: x + 15, name: "n${x}" }

# subject
fn consume(h: Holder) -> i32: 1

pub fn main() -> void $ Console:
    println("${consume(.Wide(mk(1), Part { id: "p" }))} ${consume(.Narrow(Part { id: "q" }))}")
