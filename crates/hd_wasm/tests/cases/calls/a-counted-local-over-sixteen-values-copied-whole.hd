# @dump: wat
# A counted local over 16 values read whole stays in its frame slot
# (#2031). `copied`'s `let b = a` copies `a`'s slot into `b`'s with one
# memory.copy, then `Outer`'s copy glue (`rt:retain_at`) takes the
# copy's counts from `b`'s address: `Big`'s glue for `inner`, the string
# retained and the list through its copy glue, stored back; `take(b)`
# passes `b`'s address and clears its live flag. `moved`'s `let b = a`
# shares `a`'s bits (no copy is needed), and its exit releases them.
# `moved_on` moves `a` whole to `take`, clearing its live flag, so its
# exit releases nothing; the early `return` before it releases `a`.
# `copy_kept` and `field_kept` move the source on and keep the copy: the
# callee gets the copy in its block, the same way.
struct Big:
    f0: i32
    f1: i32
    f2: i32
    f3: i32
    f4: i32
    f5: i32
    f6: i32
    f7: i32
    f8: i32
    f9: i32
    f10: i32
    f11: i32
    f12: i32
    f13: i32
    f14: i32
    f15: i32
    f16: i32
    name: string

struct Outer:
    inner: Big
    tag: string
    xs: List[i32]

fn mk(x: i32) -> Outer: Outer { inner: Big { f0: x, f1: x, f2: x, f3: x, f4: x, f5: x, f6: x, f7: x, f8: x, f9: x, f10: x, f11: x, f12: x, f13: x, f14: x, f15: x, f16: x, name: "n${x}" }, tag: "t${x}", xs: [x] }

fn take(o: Outer) -> i32: o.inner.f3 + i32(o.xs.len())

fn copied(x: i32) -> i32:
    let a = mk(x)
    let b = a
    let n = take(b)
    n + i32(a.tag.len())

fn moved(x: i32) -> i32:
    let a = mk(x)
    let b = a
    i32(b.tag.len())

fn moved_on(x: i32) -> i32:
    let a = mk(x)
    if x > 5:
        return 0
    take(a) + 1

fn copy_kept(x: i32) -> i32:
    let a = mk(x)
    let b = a
    let n = take(a)
    n + b.inner.f3 + i32(b.tag.len())

fn field_kept(o: Outer) -> i32:
    let b = o.inner
    let n = take(o)
    n + b.f3 + i32(b.name.len())

pub fn main() -> void $ Console:
    println("${copied(1)} ${moved(2)} ${moved_on(6)} ${copy_kept(3)} ${field_kept(mk(4))}")
