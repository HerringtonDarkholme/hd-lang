# @dump: wat
# @build: v8 release std
# A header reached through global or indirect storage is not an unchanged parameter field.
use std.rt.bytes.panic_with
use std.rt.memory.{Buffer, Ptr}

struct Header:
    length: usize

struct Holder:
    ptr: Ptr[usize]

let GLOBAL = box(Header { length: 16 })

fn global_bound(anchor: &Header, n: usize) -> usize:
    let i: usize = 0
    let total: usize = 0
    # subject
    while i < n:
        if i >= GLOBAL.length:
            panic_with("index", "index")
        total = total + i
        i = i + 1
    total + anchor.length
