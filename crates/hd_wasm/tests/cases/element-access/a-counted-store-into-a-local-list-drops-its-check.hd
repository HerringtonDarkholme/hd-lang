# @dump: wat
# @build: v8 release
# A counted store into a local list (`[$xs [%i]] <- ..`) below its own
# length drops its bounds check: the rising proof clears stores as reads.
fn ramp(n: usize) -> i64:
    let mut xs: List[i64] = []
    for k in 0..n:
        xs.push(i64(k))
    let s = 0i64
    # subject
    for i in 0..xs.len():
        xs[i] = i64(i) * 2
        s = s + xs[i]
    s
