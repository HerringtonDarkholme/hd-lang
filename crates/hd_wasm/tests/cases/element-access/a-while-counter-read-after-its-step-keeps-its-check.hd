# @dump: wat
# @build: v8 release
# A read after the counter's step keeps the check: `i = i + 1` may reach
# the length the test compared against.
fn total(xs: &List[i64]) -> i64:
    let s = 0i64
    let i = 0usize
    # subject
    while i < xs.len():
        i = i + 1
        s = s + xs[i]
    s
