# @dump: wat
# @build: v8 release
# expected: no bounds check: `xs[i].len()` passes `Ref [*$0 [%i]]`, an
# element reference, under the same test `i < xs.len()` that proves a
# read; the list proofs mark reads and stores only, and `for i in
# 0..xs.len()` keeps this check too (#2175 step 6b: the element `Ref`
# paths read the element word's bit).
fn total(xs: &List[string]) -> usize:
    let n = 0usize
    let i = 0usize
    # subject
    while i < xs.len():
        n = n + xs[i].len()
        i = i + 1
    n
