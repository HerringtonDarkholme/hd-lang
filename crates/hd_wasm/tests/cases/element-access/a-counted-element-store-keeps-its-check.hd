# @dump: wat
# @build: v8 release
# expected: no bounds check: `i` rises from 0 below `xs.len()`, which
# nothing in the loop changes, so the store `xs[i] = ..` is in range as
# the read `xs[i]` after it is; the rising proof clears element reads
# only (`hd_opt::prove` `Lists::rising`), so the store keeps its
# `rt:panic`. Go's `prove` clears the store's `IsInBounds` too.
# Known: /tmp/lt220/a-counted-element-store-keeps-its-bounds-check.md
fn bump(xs: &mut List[i64]) -> i64:
    let s = 0i64
    # subject
    for i in 0..xs.len():
        xs[i] = xs[i] + 1
        s = s + xs[i]
    s
