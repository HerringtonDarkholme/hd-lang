# @dump: wat
# @build: v8 release
# A counter below the length of a list two fields into a borrowed struct
# (`o.bag.xs`, the place `[*$0 .bag .xs]`) drops its bounds check
# (#2187): a list place is a local and any path of fields and
# dereferences from it.
struct Bag:
    xs: List[i64]

struct Outer:
    n: i64
    bag: Bag

fn total(o: &Outer) -> i64:
    let s = 0i64
    # subject
    for i in 0..o.bag.xs.len():
        s = s + o.bag.xs[i]
    s
