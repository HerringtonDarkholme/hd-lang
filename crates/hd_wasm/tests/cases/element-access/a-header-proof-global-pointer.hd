# @dump: wat
# @build: v8 release std
# A header reached through global or indirect storage is not an unchanged parameter field.
use std.rt.bytes.panic_with
use std.rt.memory.{Buffer, Ptr}

struct Header:
    length: usize

struct Holder:
    ptr: Ptr[usize]

let ROOM = Buffer::[usize].new(16)
let GLOBAL = box(Holder { ptr: ROOM.at(0) })

fn global_pointer(header: &Header, n: usize) -> usize:
    raw := GLOBAL.ptr
    let i: usize = 0
    let total: usize = 0
    # subject
    while i < n:
        raw.offset(i).write(i)
        if i >= header.length:
            panic_with("index", "index")
        total = total + i
        i = i + 1
    total
