# @dump: wat
# @build: v8 release std
use std.rt.bytes.panic_with

# A conditional read cannot supply an uninitialized cached header value.
# Four nested inline fields exceed the compact header-key path; keep the check.
struct Header:
    length: usize

struct One:
    header: Header

struct Two:
    inner: One

struct Three:
    inner: Two

struct Four:
    inner: Three

fn deep(root: &Four, n: usize) -> usize:
    let i: usize = 0
    let total: usize = 0
    while i < n:
        # subject
        if i >= root.inner.inner.inner.header.length:
            panic_with("index", "index")
        total += i
        i = i + 1
    total
