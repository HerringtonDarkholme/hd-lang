# @dump: wat
# @build: v8 release
# A test `i < xs.len() && s < 100` (#2186): the read runs only once the
# whole test held, so the length bound holds at the read.
fn total(xs: &List[i64]) -> i64:
    let s = 0i64
    let i = 0usize
    # subject
    while i < xs.len() && s < 100:
        s = s + xs[i]
        i = i + 1
    s
