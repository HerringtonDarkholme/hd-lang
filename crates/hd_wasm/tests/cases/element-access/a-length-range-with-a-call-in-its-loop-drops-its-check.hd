# @dump: wat
# @build: v8 release
# `for i in 0..xs.len()` with a call that reaches no list in its loop:
# the hoisting pass lists `*xs` stable, so `xs[i]` drops its check.
fn depth(n: i64) -> i64:
    if n <= 0:
        return 0
    1 + depth(n - 1)

fn total(xs: &List[i64]) -> i64:
    let s = 0i64
    # subject
    for i in 0..xs.len():
        s = s + xs[i] + depth(3)
    s
