# @dump: wat
# @build: v8 release
# Counted loops over lists no reference reaches, across calls that may
# write: `copy_twice`'s by-value parameter across a push, in both loops
# (the second's row takes the twin's region, #2190), and `pick`'s
# `if`-bound local across a call that pops another list read nothing
# checked. `captured`'s parameter, which a closure captures, keeps its check.
# `lent_between` passes its list to a call, a kept read, so it has no twin
# and both loops keep their checks; `shrunk_between`'s second loop keeps its
# check, as the list pops between the loops.
struct Bag:
    items: List[i64]

fn drain(b: &mut Bag) -> void:
    let _ = b.items.pop()

fn pick(b: &mut Bag, whole: bool) -> i64:
    ys := if whole: b.items else: [9i64]
    n := ys.len()
    let s = 0i64
    for i in 0..n:
        drain(b)
        s = s + ys[i]
    s

fn copy_twice(xs: List[i64]) -> i64:
    n := xs.len()
    let mut out: List[i64] = []
    for i in 0..n:
        out.push(xs[i])
    let s = 0i64
    for i in 0..n:
        s = s + xs[i]
    i64(out.len()) + s

fn sum(xs: List[i64]) -> i64:
    let s = 0i64
    for x in xs:
        s = s + x
    s

fn lent_between(xs: List[i64]) -> i64:
    n := xs.len()
    let mut out: List[i64] = []
    for i in 0..n:
        out.push(xs[i])
    let s = sum(xs)
    for i in 0..n:
        s = s + xs[i]
    i64(out.len()) + s

fn shrunk_between(xs: List[i64]) -> i64:
    let mut ys = xs
    n := ys.len()
    let mut out: List[i64] = []
    for i in 0..n:
        out.push(ys[i])
    let _ = ys.pop()
    let s = 0i64
    for i in 0..n:
        s = s + ys[i]
    i64(out.len()) + s

fn captured(xs: List[i64]) -> i64:
    f := fn() -> i64:
        i64(xs.len())
    n := xs.len()
    let mut out: List[i64] = []
    for i in 0..n:
        out.push(xs[i] + f())
    i64(out.len())

pub fn main() -> void $ Console:
    let mut b = Bag { items: [1i64, 2, 3, 4] }
    s := pick(&mut b, true)
    println("$s ${b.items.len()}")
    println(copy_twice([1i64, 2, 3]))
    println(lent_between([1i64, 2, 3]))
    println(shrunk_between([1i64, 2, 3]))
    println(captured([1i64, 2]))
