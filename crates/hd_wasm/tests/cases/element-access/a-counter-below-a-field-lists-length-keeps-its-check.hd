# @dump: wat
# @build: v8 release
# expected: no bounds check: `b.xs` is a list in a field of a borrowed
# struct, which nothing in the loop changes, and `i < b.xs.len()` holds
# at each read, in the `while` form shown and the `for i in
# 0..b.xs.len()` form below alike; the list proofs root a list at a
# local or a reference local only (`list.rs` `list_root`).
# Known: /tmp/lt214/a-field-lists-counter-keeps-its-checks.md
struct Bag:
    xs: List[i64]

fn total(b: &Bag) -> i64:
    let s = 0i64
    let i = 0usize
    # subject
    while i < b.xs.len():
        s = s + b.xs[i]
        i = i + 1
    s

fn total_for(b: &Bag) -> i64:
    let s = 0i64
    for i in 0..b.xs.len():
        s = s + b.xs[i]
    s
