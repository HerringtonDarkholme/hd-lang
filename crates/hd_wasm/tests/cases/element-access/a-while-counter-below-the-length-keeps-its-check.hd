# @dump: wat
# @build: v8 release
# expected: no bounds check: the loop test `i < xs.len()` runs before
# each read, and `i = i + 1` is the counter's one step after it, as
# `for i in 0..xs.len()` proves today (length-range-proof.hd).
# Known: while-counter-keeps-bounds-check.md
fn total(xs: &List[i64]) -> i64:
    let s = 0i64
    let i = 0usize
    # subject
    while i < xs.len():
        s = s + xs[i]
        i = i + 1
    s
