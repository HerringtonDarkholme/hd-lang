# @dump: wat
# @build: v8 release
# expected: an unchanged field read through a reference loads once, not
# per read or per iteration (issue: a loop reloads an unchanged struct
# field read through a reference on every iteration)
use std.collections.UniqList

# Guard proofs keep checks when the bound is a scalar reference, a unary
# test supplies no index fact, or the counter has extra/non-unit writes.
# Parameter counters also exercise schedules without a declaration store.
struct Header:
    length: usize

fn parameter_falls(items: &UniqList[usize], mut cursor: usize) -> usize:
    let total: usize = 0
    while cursor > 0:
        # subject
        total += items[cursor]
        cursor = cursor - 1
    cursor = 0
    total + cursor
