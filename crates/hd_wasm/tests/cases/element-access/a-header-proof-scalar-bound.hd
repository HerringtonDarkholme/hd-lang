# @dump: wat
# @build: v8 release std
use std.rt.bytes.panic_with

# Guard proofs keep checks when the bound is a scalar reference, a unary
# test supplies no index fact, or the counter has extra/non-unit writes.
# Parameter counters also exercise schedules without a declaration store.
struct Header:
    length: usize

fn scalar_bound(header: &Header, bound: &usize) -> usize:
    let i: usize = 0
    let total: usize = 0
    while i < *bound:
        # subject
        if i >= *bound:
            panic_with("index", "index")
        total += header.length
        i = i + 1
    total
