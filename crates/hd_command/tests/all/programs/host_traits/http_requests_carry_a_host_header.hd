use std.http.{Http, Request, get}
use std.url.{Url}
use std.cli.{Args, args}

pub fn main!() -> void $ Console + Http + Args:
    base := args()[0]
    match get!("${base}/host"):
        .Ok(r) => println(r.text().expect("body"))
        .Err(e) => println(debug(e))
    request := Request::get(Url::parse("${base}/host").expect("URL"))
        .set_header(.Host, "example.test")
    match request.send!():
        .Ok(r) => println(r.text().expect("body"))
        .Err(e) => println(debug(e))
