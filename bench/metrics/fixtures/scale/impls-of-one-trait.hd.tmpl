{{! One struct per `items` entry implementing one trait, each passed to a bounded generic: one instance per type. }}
trait Area:
    fn area(&self) -> i32

fn twice[T < Area](x: T) -> i32: x.area() * 2

{{#each items}}
struct R{{i}}:
    w: i32

impl Area for R{{i}}:
    fn area(&self) -> i32: self.w

{{/each}}
pub fn main() -> void $ Console:
    let t = +0
{{#each items}}
    t = t + twice(R{{i}} { w: +2 })
{{/each}}
    println("$t")
