{{! Closures nested one per `items` entry, each capturing the outermost parameter. }}
fn run(x0000: i32) -> i32:
{{#each items}}
{{pad}}c{{i}} := fn(x{{next}}: i32) -> i32:
{{/each}}
{{lastPad}}x{{last}} + x0000
{{#each reversed}}
{{pad}}c{{i}}(x{{i}})
{{/each}}

pub fn main() -> void $ Console:
    let t = +0
    t = run(+1)
    println("$t")
