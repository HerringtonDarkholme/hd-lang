# Twenty structs that share field types, each derived and run through json.
# Measures template code that should be shared across structs (#927).
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}

@derive(Serialize, Deserialize, Eq, Debug)
struct User:
    name_0: string
    count_1: i32
    items_2: List[string]
    note_3: string?

@derive(Serialize, Deserialize, Eq, Debug)
struct Team:
    count_0: i32
    items_1: List[string]
    note_2: string?
    limit_3: i32?
    active_4: bool

@derive(Serialize, Deserialize, Eq, Debug)
struct Project:
    items_0: List[string]
    note_1: string?
    limit_2: i32?
    active_3: bool
    name_4: string
    count_5: i32

@derive(Serialize, Deserialize, Eq, Debug)
struct Task:
    note_0: string?
    limit_1: i32?
    active_2: bool
    name_3: string

@derive(Serialize, Deserialize, Eq, Debug)
struct Comment:
    limit_0: i32?
    active_1: bool
    name_2: string
    count_3: i32
    items_4: List[string]

@derive(Serialize, Deserialize, Eq, Debug)
struct Tag:
    active_0: bool
    name_1: string
    count_2: i32
    items_3: List[string]
    note_4: string?
    limit_5: i32?

@derive(Serialize, Deserialize, Eq, Debug)
struct Repo:
    name_0: string
    count_1: i32
    items_2: List[string]
    note_3: string?

@derive(Serialize, Deserialize, Eq, Debug)
struct Issue:
    count_0: i32
    items_1: List[string]
    note_2: string?
    limit_3: i32?
    active_4: bool

@derive(Serialize, Deserialize, Eq, Debug)
struct Review:
    items_0: List[string]
    note_1: string?
    limit_2: i32?
    active_3: bool
    name_4: string
    count_5: i32

@derive(Serialize, Deserialize, Eq, Debug)
struct Label:
    note_0: string?
    limit_1: i32?
    active_2: bool
    name_3: string

@derive(Serialize, Deserialize, Eq, Debug)
struct Branch:
    limit_0: i32?
    active_1: bool
    name_2: string
    count_3: i32
    items_4: List[string]

@derive(Serialize, Deserialize, Eq, Debug)
struct Commit:
    active_0: bool
    name_1: string
    count_2: i32
    items_3: List[string]
    note_4: string?
    limit_5: i32?

@derive(Serialize, Deserialize, Eq, Debug)
struct Release:
    name_0: string
    count_1: i32
    items_2: List[string]
    note_3: string?

@derive(Serialize, Deserialize, Eq, Debug)
struct Asset:
    count_0: i32
    items_1: List[string]
    note_2: string?
    limit_3: i32?
    active_4: bool

@derive(Serialize, Deserialize, Eq, Debug)
struct Hook:
    items_0: List[string]
    note_1: string?
    limit_2: i32?
    active_3: bool
    name_4: string
    count_5: i32

@derive(Serialize, Deserialize, Eq, Debug)
struct Org:
    note_0: string?
    limit_1: i32?
    active_2: bool
    name_3: string

@derive(Serialize, Deserialize, Eq, Debug)
struct Member:
    limit_0: i32?
    active_1: bool
    name_2: string
    count_3: i32
    items_4: List[string]

@derive(Serialize, Deserialize, Eq, Debug)
struct Invite:
    active_0: bool
    name_1: string
    count_2: i32
    items_3: List[string]
    note_4: string?
    limit_5: i32?

@derive(Serialize, Deserialize, Eq, Debug)
struct Token:
    name_0: string
    count_1: i32
    items_2: List[string]
    note_3: string?

@derive(Serialize, Deserialize, Eq, Debug)
struct Event:
    count_0: i32
    items_1: List[string]
    note_2: string?
    limit_3: i32?
    active_4: bool

fn round_user(i: i64) -> usize:
    value := User {
        name_0: "s${i}",
        count_1: i32(i) + +7,
        items_2: ["a${i}", "b"],
        note_3: (if i % 2 == 0: .Some("o${i}") else: .None),
    }
    text := encode(value)
    back := match decode::[User](text):
        .Ok(v) => v
        .Err(e) => panic("decode: $e")
    if back != value:
        panic("round trip")
    text.len() + debug(back).len()

fn round_team(i: i64) -> usize:
    value := Team {
        count_0: i32(i) + +7,
        items_1: ["a${i}", "b"],
        note_2: (if i % 2 == 0: .Some("o${i}") else: .None),
        limit_3: (if i % 3 == 0: .Some(i32(i)) else: .None),
        active_4: i % 2 == 1,
    }
    text := encode(value)
    back := match decode::[Team](text):
        .Ok(v) => v
        .Err(e) => panic("decode: $e")
    if back != value:
        panic("round trip")
    text.len() + debug(back).len()

