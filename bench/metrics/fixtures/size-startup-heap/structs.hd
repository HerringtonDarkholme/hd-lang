pub fn main() -> void $ Console:
    let total: usize = 0
    let i: i64 = 0
    while i < 3:
        total += round_user(i)
        total += round_team(i)
        total += round_project(i)
        total += round_task(i)
        total += round_comment(i)
        total += round_tag(i)
        total += round_repo(i)
        total += round_issue(i)
        total += round_review(i)
        total += round_label(i)
        total += round_branch(i)
        total += round_commit(i)
        total += round_release(i)
        total += round_asset(i)
        total += round_hook(i)
        total += round_org(i)
        total += round_member(i)
        total += round_invite(i)
        total += round_token(i)
        total += round_event(i)
        i += 1
    println("$total")
