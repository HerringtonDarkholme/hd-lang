# Sums a 1,000-element list by index with `+`, `*` and `-`, for `rounds`
# rounds. `hd test --release` runs it with checks on; `hd run --release`
# runs it through `main` with checks off.
pub fn sum_loop() -> i64:
    let mut values: List[i64] = []
    for i in +0..1000:
        values.push(i64(i))
    let total: i64 = 0
    let round: i64 = 0
    while round < 100:  # param: rounds
        let j: usize = 0
        while j < values.len():
            total = total + values[j] * 3 - round
            j = j + 1
        round = round + 1
    total

tests:
    it("sums by index"):
        assert(sum_loop() != 1, reason="the loop ran")
