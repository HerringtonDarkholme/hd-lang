# The list_dir! loop without the call.
use std.fs.{FsRead, read_text}
use std.path.Path

pub fn main!() -> void $ Console + FsRead:
    let total: usize = 0
    let i: i64 = 0
    while i < 10000: # param: count
        let found: List[i64] = [i, i, i, i]
        total = total + found.len()
        i = i + 1
    println("total ${total}")
