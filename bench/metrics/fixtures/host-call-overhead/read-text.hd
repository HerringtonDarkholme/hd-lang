# A loop of read_text! of the package manifest.
use std.fs.{FsRead, read_text}
use std.path.Path

pub fn main!() -> void $ Console + FsRead:
    let total: usize = 0
    let i: i64 = 0
    while i < 10000:  # param: count
        text := read_text!(Path("hd.toml")).expect("hd.toml")
        total = total + text.len()
        i = i + 1
    println("total ${total}")
