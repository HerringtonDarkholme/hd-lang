{{! Scale independent chains, each with 16 map/filter pairs (32 stages), below the fixed trait proof depth limit. }}
{{#each chains}}
fn run_{{i}}(values: List[i32]) -> usize:
    values
        .iter()
{{#each pairs}}
        .map(fn(x: i32) -> i32: x + {{add}})
        .filter(fn(x: &i32) -> bool: x % {{modulus}} != 0)
{{/each}}
        .count()
{{/each}}
