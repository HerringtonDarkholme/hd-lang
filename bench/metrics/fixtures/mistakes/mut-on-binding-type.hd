# mistake: `let x: mut T` where `let mut x: T` is meant
# log: 2026-10-03 dogfood #199 calc
# expect: syntax-error
# cascade: not-writable
# fixed:     let mut chars: List[char] = []

fn letters(text: string) -> List[char]:
    let chars: mut List[char] = [] # diagnostic: syntax-error
    for c in text.chars():
        chars.push(c)
    chars
