# race! of two ready tasks per iteration.
use std.task.{all, race}

fn echo!(value: i64) -> i64: value

fn echo_plain(value: i64) -> i64: value

fn work!() -> i64:
    let total: i64 = 0
    let i: i64 = 0
    while i < 200000:  # param: count
        total = total + race!(echo(i), echo(i)) + echo_plain(i + 1)
        i = i + 1
    total

pub fn main!() -> void $ Console:
    println("${work!()}")
