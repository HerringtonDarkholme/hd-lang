# mistake: a readonly value as a provider of a `mut` requirement
# log: 2026-10-03 example reshape #249; 2026-10-06 probe 4
# expect: mutable-upgrade

trait Clock:
    fn tick(mut self) -> i64

data ManualClock:
    now: i64

impl Clock for ManualClock:
    fn tick(mut self) -> i64:
        self.now = self.now + 1
        self.now

fn stamp() -> i64 $ Clock:
    $.use(Clock).tick()

fn run() -> i64:
    let clock = ManualClock { now: 0 }
    $.with(Clock=clock):  # diagnostic: mutable-upgrade
        stamp()
