# @dump: counts
# @build: release

fn even(value: &i32) -> bool:
    *value % 2 == 0

pub fn main() -> void:
    xs := [+1, +2, +3, +4, +5, +6, +7, +8]
    let total: usize = 0
    let i: usize = 0
    while i < 500000:
        # subject
        kept := xs.filter(even)
        total += kept.len()
        i += 1
    if total != 2000000:
        panic("bad filter total")
