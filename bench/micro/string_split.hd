# @dump: counts
# @build: release

pub fn main() -> void:
    text := "alpha,beta,gamma,delta,epsilon,zeta,eta,theta"
    let total: usize = 0
    let i: usize = 0
    while i < 500000:
        # subject
        parts := text.split(",")
        total += parts.len()
        i += 1
    if total != 4000000:
        panic("bad split total")
