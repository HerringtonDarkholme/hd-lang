# @dump: counts
# @build: release

pub fn main() -> void:
    let mut xs: List[i32] = []
    let fill: usize = 0
    while fill < 2000000:
        xs.push(+1)
        fill += 1
    let total = +0
    let i: usize = 0
    while i < 2000000:
        # subject
        value := xs.pop()
        total += value.unwrap_or(+0)
        i += 1
    if total != 2000000:
        panic("bad pop total")
