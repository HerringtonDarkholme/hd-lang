# @dump: counts
# @build: release

pub fn main() -> void:
    xs := [+1, +2, +3, +4, +5, +6, +7, +8]
    let found: usize = 0
    let i: usize = 0
    while i < 4000000:
        # subject
        present := xs.contains(+8)
        if present:
            found += 1
        i += 1
    if found != 4000000:
        panic("value not found")
