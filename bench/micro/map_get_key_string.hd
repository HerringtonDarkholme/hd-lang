# @dump: counts
# @build: release

pub fn main() -> void:
    values := { "needle": +7, "other": +11 }
    let total = +0
    let i: usize = 0
    while i < 10000000:
        # subject
        found := values.get("needle")
        total += found.unwrap_or(+0)
        i += 1
    if total != 70000000:
        panic("bad map total")
