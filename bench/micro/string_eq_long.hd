# @dump: counts
# @build: release

use std.text.StringBuilder

fn make_long() -> string:
    out := StringBuilder::new()
    out.push("abcdefghijklmnopqrstuvwxyz012345")
    out.push("ABCDEFGHIJKLMNOPQRSTUVWXYZ678901")
    out.build()

pub fn main() -> void:
    left := make_long()
    right := make_long()
    let equal: usize = 0
    let i: usize = 0
    while i < 20000000:
        # subject
        same := left == right
        if same:
            equal += 1
        i += 1
    if equal != 20000000:
        panic("long strings differ")
