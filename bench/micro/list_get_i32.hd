# @dump: counts
# @build: release

pub fn main() -> void:
    xs := [+1, +2, +3, +4, +5, +6, +7, +8]
    let total = +0
    let i: usize = 0
    while i < 10000000:
        # subject
        value := xs.get(i % 8)
        total += value.unwrap_or(+0)
        i += 1
    if total != 45000000:
        panic("bad get total")
