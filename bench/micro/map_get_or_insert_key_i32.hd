# @dump: counts
# @build: release

fn bump(value: &mut i32) -> void:
    *value += 1

pub fn main() -> void:
    let mut values = { +1: +0 }
    let i: usize = 0
    while i < 10000000:
        # subject
        bump(values.get_or_insert(+1, +0))
        i += 1
    if values.get(+1).unwrap_or(+0) != 10000000:
        panic("bad map value")
