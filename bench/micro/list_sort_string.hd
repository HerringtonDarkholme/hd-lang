# @dump: counts
# @build: release

pub fn main() -> void:
    template := ["hh", "cc", "ff", "aa", "gg", "bb", "ee", "dd"]
    let total: usize = 0
    let i: usize = 0
    while i < 200000:
        let mut xs = template
        # subject
        xs.sort()
        total += xs[0].len()
        i += 1
    if total != 400000:
        panic("bad sort total")
