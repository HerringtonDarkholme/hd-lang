# @dump: counts
# @build: release

pub fn main() -> void:
    xs := [+1, +2, +3, +4, +5, +6, +7, +8]
    let total = +0
    let i: usize = 0
    while i < 4000000:
        # subject
        for x in xs:
            total += x
        i += 1
    if total != 144000000:
        panic("bad loop total")
