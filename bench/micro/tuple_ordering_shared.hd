# #1379: shared generated tuple comparisons, with non-inlined value-parameter calls.
# Four activations print checksum and guest milliseconds; discard the first.
use std.annotation.cold
use std.time.{Clock, elapsed, monotonic}

type Words = (
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    string,
    usize,
)

@cold
fn label(n: usize) -> string:
    "tuple-$n"

@cold
fn ordered(left: Words, right: Words) -> bool:
    left < right

pub fn main() -> void $ Console + Clock:
    text := label(12345)
    left := (
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        1,
    )
    right := (
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        text,
        2,
    )
    for _ in 0..4:
        start := monotonic()
        let sum: u64 = 0
        for i in 0..1000000:
            if i % 2 == 0:
                if ordered(left, right):
                    sum += 1
            else:
                if ordered(right, left):
                    sum += 1
        println("$sum ${elapsed(start).as_milliseconds()}")
