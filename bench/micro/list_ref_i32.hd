# @dump: counts
# @build: release

fn read(value: &i32) -> i32:
    *value

pub fn main() -> void:
    xs := [+1, +2, +3, +4, +5, +6, +7, +8]
    let total = +0
    let i: usize = 0
    while i < 10000000:
        # subject
        value := read(&xs[i % 8])
        total += value
        i += 1
    if total != 45000000:
        panic("bad reference total")
