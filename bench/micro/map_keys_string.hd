# @dump: counts
# @build: release

pub fn main() -> void:
    values := { "a": +10, "bb": +20, "ccc": +30, "dddd": +40 }
    let total: usize = 0
    let i: usize = 0
    while i < 1000000:
        # subject
        keys := values.keys()
        total += keys.len()
        i += 1
    if total != 4000000:
        panic("bad keys total")
