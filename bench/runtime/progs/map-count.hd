fn tally(n: i32, buckets: i32) -> i32:
    let counts: mut Map[i32, i32] = {}
    let i = +0
    while i < n:
        key := (i * 31 + 7) % buckets
        counts[key] = match counts.get(key):
            .Some(seen) => seen + 1
            .None => 1
        i = i + 1
    let total = +0
    let b = +0
    while b < buckets:
        total = total + counts.get_or(b, 0)
        b = b + 1
    total

pub fn main() -> void $ Console:
    println(tally(200000, 5000))
