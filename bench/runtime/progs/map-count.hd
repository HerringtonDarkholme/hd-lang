fn tally(n: i32, buckets: i32) -> i32:
    let mut counts: Map[i32, i32] = {}
    for i in 0..n:
        key := (i * 31 + 7) % buckets
        counts[key] = match counts.get(key):
            .Some(seen) => seen + 1
            .None => 1
    let total = +0
    for b in 0..buckets:
        total += counts.get(b).unwrap_or(0)
    total

pub fn main() -> void $ Console:
    println(tally(200000, 5000))
