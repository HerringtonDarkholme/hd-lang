fn fill(n: i32) -> List[i32]:
    let mut items: List[i32] = []
    let state = +12345
    for _ in 0..n:
        state = (state * 31 + 7) % 100003
        items.push(state)
    items

fn sort(items: &mut List[i32]) -> void:
    for i in 1..items.len():
        key := items[i]
        let j: usize = i
        while j > 0:
            if items[j - 1] <= key:
                break
            items[j] = items[j - 1]
            j = j - 1
        items[j] = key

fn checksum(items: List[i32]) -> i32:
    let total = +0
    for value in items:
        total = (total + value) % 1000003
    total

pub fn main() -> void $ Console:
    let mut items = fill(30000)
    sort(&mut items)
    println(checksum(items))
