# #1379: repeated ordinary value parameters addressed only by read-only
# comparisons. Keep the wrappers visible so the benchmark exercises their
# borrowed-parameter contract rather than only an inlined comparison.
use std.annotation.inline

@derive(Eq, PartialOrd, Ord)
struct Key:
    name: string
    number: i32

@inline(.Never)
fn different(a: List[string], b: List[string]) -> bool:
    a != b

@inline(.Never)
fn same(a: Key, b: Key) -> bool:
    a == b

@inline(.Never)
fn before(a: Key, b: Key) -> bool:
    a < b

@inline(.Never)
fn text(n: usize) -> string:
    "item-$n"

pub fn main() -> void $ Console:
    name := text(17)
    left := [name, "tail"]
    right := [name, "other"]
    key := Key { name: name, number: +3 }
    other := Key { name: name, number: +2 }
    let checksum = 0
    for _ in 0..3_000_000:
        if different(left, right):
            checksum = checksum + 1
        if same(key, key):
            checksum = checksum + 1
        if before(other, key):
            checksum = checksum + 1
    println("$checksum")
