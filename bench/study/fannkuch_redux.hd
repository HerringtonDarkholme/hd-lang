# fannkuch-redux, n = 10 (benchmarks game). Prints checksum and max flips.
N := 10

pub fn main() -> void $ Console:
    n := N
    let mut perm: List[usize] = []
    let mut perm1: List[usize] = []
    let mut count: List[usize] = []
    for i in 0..n:
        perm.push(0)
        perm1.push(i)
        count.push(0)
    let max_flips: i64 = 0
    let checksum: i64 = 0
    let perm_count: i64 = 0
    let r: usize = n
    while true:
        while r != 1:
            count[r - 1] = r
            r = r - 1
        for i in 0..n:
            perm[i] = perm1[i]
        let flips: i64 = 0
        let k = perm[0]
        while k != 0:
            let i: usize = 0
            let j = k
            while i < j:
                t := perm[i]
                perm[i] = perm[j]
                perm[j] = t
                i = i + 1
                j = j - 1
            flips = flips + 1
            k = perm[0]
        if flips > max_flips:
            max_flips = flips
        checksum = if perm_count % 2 == 0: checksum + flips else: checksum - flips
        let done = true
        while r != n:
            p0 := perm1[0]
            for i in 0..r:
                perm1[i] = perm1[i + 1]
            perm1[r] = p0
            count[r] = count[r] - 1
            if count[r] > 0:
                done = false
                break
            r = r + 1
        if done:
            break
        perm_count = perm_count + 1
    println("$checksum $max_flips")
