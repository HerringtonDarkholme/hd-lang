use std.time.{Clock, Duration, ms, sleep}

fn feed[A, B, $R](value: A, step: fn(A) -> B $ R) -> B $ R: step(value)

fn delayed[T, $R](limit: Duration) -> (fn(fn!() -> T $ R) -> (fn!() -> T $ R + Clock)):
    fn(work: fn!() -> T $ R) -> (fn!() -> T $ R + Clock):
        fn!() -> T $ R + Clock:
            sleep!(limit)
            work!()
fn work!() -> usize $ Console:
    println("run")
    7
pub fn main!() -> void $ Console + Clock:
    wrapped := feed(work, delayed(ms(1)))
    println("built")
    println(wrapped!())
