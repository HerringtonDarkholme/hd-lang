struct Counter:
    calls: usize
fn next_width(state: &mut Counter) -> usize:
    state.calls += 1
    state.calls
fn format(value: string, width: usize) -> string: "$value:$width"
fn format_step(width: usize) -> (fn(string) -> string):
    fn(value: string) -> string: format(value, width)
pub fn main() -> void $ Console:
    direct := &mut Counter { calls: 0 }
    curried := &mut Counter { calls: 0 }
    literal := fn(value: string) -> string: format(value, next_width(direct))
    configured := format_step(next_width(curried))
    for word in ["a", "b", "c"]:
        println("${literal(word)} ${configured(word)}")
    println("calls ${direct.calls} ${curried.calls}")
