# points: 3.3M two-field records, 10 rounds, each round a new list.
N := 3_300_000

struct Point:
    x: i64
    y: i64

pub fn main() -> void $ Console:
    let mut points = [for i in 0..N => Point { x: i64(i), y: i64(i * 7 % 1000) }]
    for round in 0..10:
        r := i64(round)
        points = points.map(fn(p): Point { x: (p.x + p.y) % 1_000_003, y: (p.y * 3 + r) % 1000 })
    let sum: i64 = 0
    for p in points:
        sum += p.x + p.y
    println(sum)
