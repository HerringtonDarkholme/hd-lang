# spectral-norm, n = 2000 (benchmarks game). Prints trunc(norm * 1e9).
N := 2800

fn a(i: usize, j: usize) -> f64:
    1.0 / f64((i + j) * (i + j + 1) / 2 + i + 1)

fn mul_av(n: usize, v: &List[f64], out: &mut List[f64]) -> void:
    for i in 0..n:
        let s = 0.0
        for j in 0..n:
            s += a(i, j) * v[j]
        out[i] = s

fn mul_atv(n: usize, v: &List[f64], out: &mut List[f64]) -> void:
    for i in 0..n:
        let s = 0.0
        for j in 0..n:
            s += a(j, i) * v[j]
        out[i] = s

fn mul_atav(n: usize, v: &List[f64], out: &mut List[f64], tmp: &mut List[f64]) -> void:
    mul_av(n, v, tmp)
    mul_atv(n, tmp, out)

pub fn main() -> void $ Console:
    n := N
    let mut u = [for _ in 0..n => 1.0]
    let mut v = [for _ in 0..n => 0.0]
    let mut tmp = [for _ in 0..n => 0.0]
    for _ in 0..10:
        mul_atav(n, &u, &mut v, &mut tmp)
        mul_atav(n, &v, &mut u, &mut tmp)
    let vbv = 0.0
    let vv = 0.0
    for i in 0..n:
        vbv += u[i] * v[i]
        vv += v[i] * v[i]
    println(i64((vbv / vv).sqrt() * 1000000000.0))
