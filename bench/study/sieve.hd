# sieve of Eratosthenes below 16M. Prints the prime count.
N := 16_000_000

pub fn main() -> void $ Console:
    n := N
    let mut flags = [for _ in 0..n => true]
    flags[0] = false
    flags[1] = false
    let i: usize = 2
    while i * i < n:
        if flags[i]:
            let j = i * i
            while j < n:
                flags[j] = false
                j += i
        i += 1
    let count: usize = 0
    for flag in flags:
        if flag:
            count += 1
    println(count)
