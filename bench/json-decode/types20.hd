        .Err(error) => panic("T5: $error")
    match decode::[T6]("{\"m6_0\":6,\"m6_1\":\"x\",\"m6_2\":true,\"m6_3\":1.5,\"m6_5\":[1,2]}"):
        .Ok(v) => total += v.m6_5.len()
        .Err(error) => panic("T6: $error")
    match decode::[T7]("{\"m7_0\":7,\"m7_1\":\"x\",\"m7_2\":true,\"m7_3\":1.5,\"m7_5\":[1,2]}"):
        .Ok(v) => total += v.m7_5.len()
        .Err(error) => panic("T7: $error")
    match decode::[T8]("{\"m8_0\":8,\"m8_1\":\"x\",\"m8_2\":true,\"m8_3\":1.5,\"m8_5\":[1,2]}"):
        .Ok(v) => total += v.m8_5.len()
        .Err(error) => panic("T8: $error")
    match decode::[T9]("{\"m9_0\":9,\"m9_1\":\"x\",\"m9_2\":true,\"m9_3\":1.5,\"m9_5\":[1,2]}"):
        .Ok(v) => total += v.m9_5.len()
        .Err(error) => panic("T9: $error")
    match decode::[T10](
        "{\"m10_0\":10,\"m10_1\":\"x\",\"m10_2\":true,\"m10_3\":1.5,\"m10_5\":[1,2]}",
    ):
        .Ok(v) => total += v.m10_5.len()
        .Err(error) => panic("T10: $error")
    match decode::[T11](
        "{\"m11_0\":11,\"m11_1\":\"x\",\"m11_2\":true,\"m11_3\":1.5,\"m11_5\":[1,2]}",
    ):
        .Ok(v) => total += v.m11_5.len()
