pub fn main() -> void $ Console:
    let total: usize = 0
    match decode::[T0]("{\"m0_0\":0,\"m0_1\":\"x\",\"m0_2\":true,\"m0_3\":1.5,\"m0_5\":[1,2]}"):
        .Ok(v) => total += v.m0_5.len()
        .Err(error) => panic("T0: $error")
    match decode::[T1]("{\"m1_0\":1,\"m1_1\":\"x\",\"m1_2\":true,\"m1_3\":1.5,\"m1_5\":[1,2]}"):
        .Ok(v) => total += v.m1_5.len()
        .Err(error) => panic("T1: $error")
