# Wasm size of decode with 20 derived types (#1809): each type is read once
# from a fixed text, so every derived `deserialize` is linked.
use std.json.decode
use std.serde.Deserialize

@derive(Deserialize)
struct T0:
    m0_0: i64
    m0_1: string
    m0_2: bool
    m0_3: f64
    m0_4: string?
    m0_5: List[i64]

@derive(Deserialize)
struct T1:
    m1_0: i64
    m1_1: string
    m1_2: bool
    m1_3: f64
    m1_4: string?
    m1_5: List[i64]

