fn fib(n: i32) -> i32:
    let a = +0
    let b = +1
    let i = +0
    while i < n:
        t := a + b
        a = b
        b = t
        i = i + 1
    return a

fn classify(x: i32) -> i32:
    if x < 0:
        return -1
    else if x == 0:
        return 0
    else:
        return 1

pub fn main() -> void $ Console:
    println(1 + 2 * 3)
    println((1 + 2) * 3)
    println(10 - 4 - 3)
    println(fib(10))
    println(classify(-5))
    println(classify(0))
    println(classify(7))
    println(17 % 5 + 100 / 7)
    println(-(+2 + 3) * 2)
