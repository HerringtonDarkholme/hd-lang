fn classify(c: i32) -> i32:
    if c >= 48:
        if c <= 57:
            return 2
    if c >= 65:
        if c <= 90:
            return 1
    if c >= 97:
        if c <= 122:
            return 1
    if c == 32:
        return 0
    return -1

fn count_tokens(limit: i32) -> i32:
    state := +0
    tokens := +0
    i := +0
    while i < limit:
        c := (i * 17 + 11) % 128
        kind := classify(c)
        if state == 0:
            if kind == 1:
                state = 1
            else if kind == 2:
                state = 2
        else if state == 1:
            if kind != 1:
                if kind != 2:
                    tokens = tokens + 1
                    state = 0
        else:
            if kind != 2:
                tokens = tokens + 1
                state = 0
        i = i + 1
    if state != 0:
        tokens = tokens + 1
    return tokens

fn main():
    println(classify(65))
    println(classify(53))
    println(classify(35))
    println(count_tokens(10000))
