use pkg.metrics.shapes.{Rect, Square, Measure, adjusted}

fn twice[T < Measure](value: T) -> i32:
    return value.measure() + value.measure()

fn main():
    rect := Rect { width: 6, height: 7 }
    square := Square { side: 9 }
    println(rect.measure())
    println(square.measure())
    println(adjusted(rect, 1))
    println(adjusted(square, 1))
    println(twice(rect))
