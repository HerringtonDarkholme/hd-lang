fn gcd(a: i32, b: i32) -> i32:
    let x = a
    let y = b
    while y != 0:
        next := x % y
        x = y
        y = next
    return x

fn fib(n: i32) -> i32:
    let a = +0
    let b = +1
    let i = +0
    while i < n:
        next := a + b
        a = b
        b = next
        i = i + 1
    return a

fn integer_kernel(rounds: i32) -> i32:
    let x = +7
    let total = +0
    let i = +1
    while i <= rounds:
        x = (x * 17 + i * 13) % 10007
        total = total + x % 97
        i = i + 1
    return total

fn polynomial(x: i32) -> i32:
    return ((3 * x + 5) * x - 7) * x + 11

fn main() -> void $ Console:
    println(gcd(1071, 462))
    println(fib(30))
    println(polynomial(12))
    println(integer_kernel(10000))
