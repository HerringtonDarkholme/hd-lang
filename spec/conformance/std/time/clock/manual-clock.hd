# test: ManualClock's sleep! returns at once and advances now() and monotonic(), through $.with and directly; a zero sleep leaves the time
# Spec std/time Manual Clock: std-time.manual.new-ref, std-time.manual.now, std-time.manual.monotonic, std-time.manual.sleep.deadline, std-time.manual.sleep.zero, and std-time.manual.reads (STDLIB decisions 4 and 10; task #220; SLEEP-NEGATIVE, task #223).
use std.time.{Clock, Duration, Instant, ManualClock, Timestamp, ms, s}

fn wait_twice!() -> Timestamp $ Clock:
    let mut clock = $.use(Clock)
    clock.sleep!(2s)
    clock.sleep!(3s)
    clock.now()

tests:
    use std.testing.{assert, assert_equal}

    it("sleeps in virtual time"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            assert(
                wait_twice!() == Timestamp::from_unix_milliseconds(5000),
                reason="five virtual seconds",
            )
        assert(
            clock.now() == Timestamp::from_unix_milliseconds(5000),
            reason="the provider kept its time",
        )

    it("sleep! advances now and monotonic alike"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(1000))
        assert(clock.now() == Timestamp::from_unix_milliseconds(1000), reason="the start")
        assert(
            clock.monotonic() == Instant::from_milliseconds(1000),
            reason="milliseconds since the epoch",
        )
        assert(
            clock.now() == Timestamp::from_unix_milliseconds(1000),
            reason="reads do not advance",
        )
        clock.sleep!(250ms)
        assert_equal(
            clock.now().since(Timestamp::from_unix_milliseconds(1000)).as_milliseconds(),
            250,
            reason="now advanced",
        )
        assert_equal(
            clock.monotonic().since(Instant::from_milliseconds(1000)).as_milliseconds(),
            250,
            reason="monotonic advanced",
        )

    it("a zero duration leaves the time"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(1000))
        clock.sleep!(Duration::milliseconds(0))
        assert(clock.now() == Timestamp::from_unix_milliseconds(1000), reason="unchanged")

    it("allows the largest deadline and a zero sleep there"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(9223372036854775806))
        clock.sleep!(Duration::milliseconds(1))
        assert_equal(clock.now().unix_milliseconds(), 9223372036854775807)
        clock.sleep!(Duration::milliseconds(0))
        assert_equal(clock.now().unix_milliseconds(), 9223372036854775807)

    it("allows a largest duration from the minimum timestamp"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(-9223372036854775807 - 1))
        clock.sleep!(Duration::milliseconds(9223372036854775807))
        assert_equal(clock.now().unix_milliseconds(), -1)
