# test: it_prop and it_prop_with run generated scalar cases whose draws obey the bounds of int and the default generators
# Spec std/testing Choices And Arbitrary: std-testing.choices.int-range, std-testing.arbitrary.std, std-testing.arbitrary.float, std-testing.prop.discard.
# Also covers std-testing.choices.float-range, std-testing.choices.bool,
# std-testing.choices.string-max-chars, std-testing.choices.assume,
# std-testing.choices.draw, std-testing.choices.from-case,
# std-testing.choices.no-size, std-testing.choices.string-limit,
# std-testing.arbitrary, std-testing.prop.generate-and-shrink,
# std-testing.prop.body-no-discard, and std-testing.edge.int-type.
use std.testing.{assert, Choices, it_prop, it_prop_with}

fn small(c: &mut Choices) -> i64:
    c.int(0..=9)

fn even(c: &mut Choices) -> i64:
    let value: i64 = c.int(0..=100)
    c.assume(value % 2 == 0)
    value

fn byte(c: &mut Choices) -> u8:
    c.int(250..=255)

tests:
    it_prop("addition commutes", prop=fn!(value: i64):
        let one: i64 = 1
        assert(
            value.wrapping_add(one) == one.wrapping_add(value),
            reason="commutes, with wrapping at the largest value",
        )
    )

    it_prop_with(
        "draws stay in range",
        gen=small,
        cases=50,
        prop=fn!(n: i64): assert(n >= 0 && n <= 9, reason="in range")
    )

    it_prop_with(
        "assume discards odd values",
        gen=even,
        prop=fn!(n: i64): assert(n % 2 == 0, reason="only even values reach the property")
    )

    it_prop_with(
        "int takes its type from the context",
        gen=byte,
        prop=fn!(b: u8): assert(b >= 250, reason="from 250 to 255")
    )

    it_prop(
        "an f64 draw reaches NaN",
        expect_panic="assertion-failed",
        prop=fn!(x: f64): assert(!x.is_nan(), reason="only a NaN fails")
    )

    it_prop(
        "an f64 draw reaches an infinity",
        expect_panic="assertion-failed",
        prop=fn!(x: f64): assert(x.is_nan() || x.is_finite(), reason="only an infinity fails")
    )

    it_prop(
        "an f64 draw reaches -0.0",
        expect_panic="assertion-failed",
        prop=fn!(x: f64): assert(x != 0.0 || 1.0 / x > 0.0, reason="only -0.0 fails")
    )

    it_prop("an f64 draw reaches a subnormal", expect_panic="assertion-failed", prop=fn!(x: f64):
        let least_normal: f64 = 2.2250738585072014e-308
        assert(
            x == 0.0 || !(x > -least_normal && x < least_normal),
            reason="only a subnormal fails",
        )
    )
