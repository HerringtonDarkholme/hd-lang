# test: an Arc of a value that is Send and Sync is both, alone and as a part of a struct, a tuple and an optional
# Spec std/sync: std-sync.arc.send, std-sync.weak.send. Spec lang/10 Markers: module.marker.explicit.only.
use std.meta.{Send, Sync}
use std.sync.{Arc, Weak}

struct Holder:
    shared: Arc[i64]
    seen: u32

fn share[T < ?Copy & Send & Sync](value: T) -> void:
    pass

fn main() -> void:
    arc := Arc::new(5i64)
    let weak: Weak[i64] = Arc::downgrade(&arc)
    share(weak)
    share((arc.clone(), 1))
    share(Holder { shared: arc.clone(), seen: 0 })
    let held: Arc[i64]? = .Some(arc)
    share(held)
