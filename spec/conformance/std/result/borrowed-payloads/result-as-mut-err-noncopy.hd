# test: as_mut writes the err payload in place without copying either side
# Spec std Result: std-result.as-mut, std-result.as-mut.in-place.
struct Item:
    n: i32

impl !Copy for Item

fn increment(value: &mut Result[Item, Item]):
    let view: Result[&mut Item, &mut Item] = value.as_mut()
    match view:
        .Ok(item) => item.n += 1
        .Err(item) => item.n += 1

tests:
    use std.testing.assert_equal

    it("writes the borrowed err payload in its owner"):
        let mut value: Result[Item, Item] = .Err(Item { n: 7 })
        increment(&mut value)
        let actual = match value:
            .Ok(item) => item.n
            .Err(item) => item.n
        assert_equal(actual, 8)
