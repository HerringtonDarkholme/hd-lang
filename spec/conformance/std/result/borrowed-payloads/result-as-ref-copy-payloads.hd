# test: as_ref returns references even when the payloads are copied
# Spec std Result: std-result.as-ref.
fn positive(value: &Result[i32, string]) -> bool:
    match value.as_ref():
        .Ok(number) => *number > 0
        .Err(_) => false

tests:
    use std.testing.assert_equal

    it("borrows a successful copied payload"):
        let value: Result[i32, string] = .Ok(3)
        assert_equal(positive(&value), true, reason="the successful value")
        assert_equal(value.ok(), .Some(3), reason="the owner is still usable")

    it("borrows a copied error payload"):
        let value: Result[i32, string] = .Err("missing")
        assert_equal(positive(&value), false, reason="the error variant")
        assert_equal(value.err(), .Some("missing"), reason="the original error")
