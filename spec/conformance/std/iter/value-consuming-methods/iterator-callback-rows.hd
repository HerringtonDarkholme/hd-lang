# test: eager iterator consumers forward callback requirements
use std.iter.{FilterMap, ListIter}

fn named(values: List[i32]) -> FilterMap[ListIter[i32], i32, i32]:
    values.iter().filter_map(fn(value: i32) -> i32?: .Some(value))

fn visit(value: i32) -> void $ Console:
    println("$value")

fn positive(value: i32) -> bool $ Console:
    println("$value")
    value > 0

fn run(values: List[i32]) -> usize? $ Console:
    values.iter().for_each(visit)
    let mut cursor = values.iter()
    cursor.position(positive)
