# test: min and max return the smallest and largest remaining item, min the first of equal ones and max the last, and .None when empty
# Spec std/iter More Adapters: std-iter.adapter.min.value, std-iter.adapter.max.value, std-iter.adapter.min-max.tie, std-iter.adapter.min-max.drain.
# expect-stdout: (Option.Some(9), Option.Some(1), Option.None, Option.Some("fig"))
# expect-stdout: (Option.Some("c"), Option.Some("a"))
use std.cmp.{Ord, Ordering, PartialOrd}

struct Job:
    rank: i32
    name: string

impl Eq for Job:
    fn eq(&self, other: &Job) -> bool:
        self.rank == other.rank

impl PartialOrd for Job:
    fn partial_cmp(&self, other: &Job) -> Ordering?:
        .Some(self.rank.cmp(&other.rank))

impl Ord for Job:
    fn cmp(&self, other: &Job) -> Ordering:
        self.rank.cmp(&other.rank)

fn name(job: Job) -> string:
    job.name

pub fn main() -> void $ Console:
    let numbers: List[i32] = [3, 9, 1, 9]
    let empty: List[i32] = []
    jobs := [
        Job { rank: 2, name: "a" },
        Job { rank: 5, name: "b" },
        Job { rank: 5, name: "c" },
        Job { rank: 2, name: "d" },
    ]
    println(
        debug(
            (
                numbers.iter().max(),
                numbers.iter().min(),
                empty.iter().max(),
                ["pear", "fig"].iter().min(),
            ),
        ),
    )
    println(debug((jobs.iter().max().map(name), jobs.iter().min().map(name))))
