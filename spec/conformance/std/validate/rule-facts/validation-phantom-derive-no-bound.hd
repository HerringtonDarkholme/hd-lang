# test: Debug and Eq derived for a phantom struct do not require its type parameter to implement either trait
# Standard Validation: std-validate.rule.declarations
use std.meta.annotate
use std.format.debug

struct Opaque: pass

@annotate::[F](.Field)
@derive(Debug, Eq)
struct Phantom[F]:
    value: usize

fn probe() -> bool:
    let fact: Phantom[Opaque] = Phantom::[Opaque] { value: 1 }
    _ := debug(fact)
    fact == fact
