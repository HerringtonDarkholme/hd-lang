        assert_equal(i32::try_from(u16(65535)), .Ok(i32(65535)), reason="u16 to i32: 65535")

    it("u16 to i64"):
        assert_equal(i64::try_from(u16(0)), .Ok(i64(0)), reason="u16 to i64: 0")
        assert_equal(i64::try_from(u16(65535)), .Ok(i64(65535)), reason="u16 to i64: 65535")

    it("u16 to u8"):
        assert_equal(u8::try_from(u16(0)), .Ok(u8(0)), reason="u16 to u8: 0")
        assert_equal(u8::try_from(u16(255)), .Ok(u8(255)), reason="u16 to u8: 255")
        assert_equal(u8::try_from(u16(256)), .Err(TryFromIntError {}), reason="u16 to u8: 256")
        assert_equal(u8::try_from(u16(65535)), .Err(TryFromIntError {}), reason="u16 to u8: 65535")

    it("u32 to i8"):
        assert_equal(i8::try_from(u32(0)), .Ok(i8(0)), reason="u32 to i8: 0")
        assert_equal(i8::try_from(u32(127)), .Ok(i8(127)), reason="u32 to i8: 127")
        assert_equal(i8::try_from(u32(128)), .Err(TryFromIntError {}), reason="u32 to i8: 128")
        assert_equal(
            i8::try_from(u32(4294967295)),
            .Err(TryFromIntError {}),
            reason="u32 to i8: 4294967295",
        )

    it("u32 to i16"):
        assert_equal(i16::try_from(u32(0)), .Ok(i16(0)), reason="u32 to i16: 0")
        assert_equal(i16::try_from(u32(32767)), .Ok(i16(32767)), reason="u32 to i16: 32767")
        assert_equal(
