        assert_equal(usize::try_from(i64(0)), .Ok(usize(0)), reason="i64 to usize: 0")
        assert_equal(
            usize::try_from(i64(4294967295)),
            .Ok(usize(4294967295)),
            reason="i64 to usize: 4294967295",
        )
        assert_equal(
            usize::try_from(i64(4294967296)),
            .Err(TryFromIntError {}),
            reason="i64 to usize: 4294967296",
        )
        assert_equal(
            usize::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to usize: 9223372036854775807",
        )

    it("i64 to u64"):
        assert_equal(
            u64::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to u64: -9223372036854775808",
        )
        assert_equal(u64::try_from(i64(-1)), .Err(TryFromIntError {}), reason="i64 to u64: -1")
        assert_equal(u64::try_from(i64(0)), .Ok(u64(0)), reason="i64 to u64: 0")
