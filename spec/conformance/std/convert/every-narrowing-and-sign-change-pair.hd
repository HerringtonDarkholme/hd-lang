# test: every narrowing and signedness pair, with table-driven boundary checks
# Spec std/num Fallible Integer Conversions: std-num.try-from.impls, std-num.try-from.exact, std-num.try-from.range, std-num.try-from.profiles, std-num.try-from.usize.
use std.convert.TryFrom
use std.num.{Integer, TryFromIntError}
use std.testing.assert_equal

fn add_neighbors[S < Integer](values: &mut List[S], value: S) -> void:
    values.push(value)
    if value > S::min_value():
        values.push(value - S::one())
    if value < S::max_value():
        values.push(value + S::one())

fn check_pair[S < Integer, T < Integer & TryFrom[S, Error = TryFromIntError]]() -> void:
    let mut values = [S::min_value(), S::max_value(), S::zero()]
    # Test each destination boundary and its neighbors when the source can hold it.
    low := i64(T::min_value())
    if low < 0:
        if low >= i64(S::min_value()):
            add_neighbors(&mut values, S::from_i64(low))
    else:
        add_neighbors(&mut values, S::zero())
    high := u64(T::max_value())
    if high <= u64(S::max_value()):
        add_neighbors(&mut values, S::from_u64(high))
    # Independent bit-width oracle: exact signed/unsigned views, without the implementation's bound comparisons.
    width := (~T::zero()).count_ones()
    signed := T::min_value() < T::zero()
    for value in values:
        negative := value < S::zero()
        let fits = false
        if negative:
            needed := 64 - u64(~i64(value)).leading_zeros() + 1
            fits = signed && needed <= width
        else:
            needed := 64 - u64(value).leading_zeros()
            usable := width - (if signed: 1 else: 0)
            fits = needed <= usable
        result := T::try_from(value)
        assert_equal(result.is_ok(), fits, reason="range agrees with the value's bit width")
        match result:
            .Ok(converted) =>
                if negative:
                    assert_equal(i64(converted), i64(value), reason="negative value is exact")
                else:
                    assert_equal(u64(converted), u64(value), reason="nonnegative value is exact")
            .Err(_) => pass

tests:
    use std.testing.it_each

    it_each(
        "narrowing and sign-change pairs",
        [
            fn() -> void: check_pair::[i8, u8](),
            fn() -> void: check_pair::[i8, u16](),
            fn() -> void: check_pair::[i8, u32](),
            fn() -> void: check_pair::[i8, usize](),
            fn() -> void: check_pair::[i8, u64](),
            fn() -> void: check_pair::[i16, i8](),
            fn() -> void: check_pair::[i16, u8](),
            fn() -> void: check_pair::[i16, u16](),
            fn() -> void: check_pair::[i16, u32](),
            fn() -> void: check_pair::[i16, usize](),
            fn() -> void: check_pair::[i16, u64](),
            fn() -> void: check_pair::[i32, i8](),
            fn() -> void: check_pair::[i32, i16](),
            fn() -> void: check_pair::[i32, u8](),
            fn() -> void: check_pair::[i32, u16](),
            fn() -> void: check_pair::[i32, u32](),
            fn() -> void: check_pair::[i32, usize](),
            fn() -> void: check_pair::[i32, u64](),
            fn() -> void: check_pair::[i64, i8](),
            fn() -> void: check_pair::[i64, i16](),
            fn() -> void: check_pair::[i64, i32](),
            fn() -> void: check_pair::[i64, u8](),
            fn() -> void: check_pair::[i64, u16](),
            fn() -> void: check_pair::[i64, u32](),
            fn() -> void: check_pair::[i64, usize](),
            fn() -> void: check_pair::[i64, u64](),
            fn() -> void: check_pair::[u8, i8](),
            fn() -> void: check_pair::[u8, i16](),
            fn() -> void: check_pair::[u8, i32](),
            fn() -> void: check_pair::[u8, i64](),
            fn() -> void: check_pair::[u16, i8](),
            fn() -> void: check_pair::[u16, i16](),
            fn() -> void: check_pair::[u16, i32](),
            fn() -> void: check_pair::[u16, i64](),
            fn() -> void: check_pair::[u16, u8](),
            fn() -> void: check_pair::[u32, i8](),
            fn() -> void: check_pair::[u32, i16](),
            fn() -> void: check_pair::[u32, i32](),
            fn() -> void: check_pair::[u32, i64](),
            fn() -> void: check_pair::[u32, u8](),
            fn() -> void: check_pair::[u32, u16](),
            fn() -> void: check_pair::[usize, i8](),
            fn() -> void: check_pair::[usize, i16](),
            fn() -> void: check_pair::[usize, i32](),
            fn() -> void: check_pair::[usize, i64](),
            fn() -> void: check_pair::[usize, u8](),
            fn() -> void: check_pair::[usize, u16](),
            fn() -> void: check_pair::[u64, i8](),
            fn() -> void: check_pair::[u64, i16](),
            fn() -> void: check_pair::[u64, i32](),
            fn() -> void: check_pair::[u64, i64](),
            fn() -> void: check_pair::[u64, u8](),
            fn() -> void: check_pair::[u64, u16](),
            fn() -> void: check_pair::[u64, u32](),
            fn() -> void: check_pair::[u64, usize]()
        ],
        body=fn!(action: fn() -> void): action()
    )
