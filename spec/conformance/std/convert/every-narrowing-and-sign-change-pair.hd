    it("u8 to i8"):
        assert_equal(i8::try_from(u8(0)), .Ok(i8(0)), reason="u8 to i8: 0")
        assert_equal(i8::try_from(u8(127)), .Ok(i8(127)), reason="u8 to i8: 127")
        assert_equal(i8::try_from(u8(128)), .Err(TryFromIntError {}), reason="u8 to i8: 128")
        assert_equal(i8::try_from(u8(255)), .Err(TryFromIntError {}), reason="u8 to i8: 255")

