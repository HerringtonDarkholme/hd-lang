        assert_equal(i64::try_from(u8(255)), .Ok(i64(255)), reason="u8 to i64: 255")

    it("u16 to i8"):
        assert_equal(i8::try_from(u16(0)), .Ok(i8(0)), reason="u16 to i8: 0")
        assert_equal(i8::try_from(u16(127)), .Ok(i8(127)), reason="u16 to i8: 127")
