# test: every narrowing and signedness-changing integer pair returns the exact value or a range error
# Spec std/num Fallible Integer Conversions: std-num.try-from.impls, std-num.try-from.exact, std-num.try-from.range, std-num.try-from.profiles, std-num.try-from.usize.
use std.convert.TryFrom
use std.num.TryFromIntError

tests:
    use std.testing.assert_equal

    it("i8 to u8"):
        assert_equal(u8::try_from(i8(-128)), .Err(TryFromIntError {}), reason="i8 to u8: -128")
        assert_equal(u8::try_from(i8(-1)), .Err(TryFromIntError {}), reason="i8 to u8: -1")
        assert_equal(u8::try_from(i8(0)), .Ok(u8(0)), reason="i8 to u8: 0")
        assert_equal(u8::try_from(i8(127)), .Ok(u8(127)), reason="i8 to u8: 127")

    it("i8 to u16"):
        assert_equal(u16::try_from(i8(-128)), .Err(TryFromIntError {}), reason="i8 to u16: -128")
        assert_equal(u16::try_from(i8(-1)), .Err(TryFromIntError {}), reason="i8 to u16: -1")
        assert_equal(u16::try_from(i8(0)), .Ok(u16(0)), reason="i8 to u16: 0")
        assert_equal(u16::try_from(i8(127)), .Ok(u16(127)), reason="i8 to u16: 127")

    it("i8 to u32"):
        assert_equal(u32::try_from(i8(-128)), .Err(TryFromIntError {}), reason="i8 to u32: -128")
        assert_equal(u32::try_from(i8(-1)), .Err(TryFromIntError {}), reason="i8 to u32: -1")
        assert_equal(u32::try_from(i8(0)), .Ok(u32(0)), reason="i8 to u32: 0")
        assert_equal(u32::try_from(i8(127)), .Ok(u32(127)), reason="i8 to u32: 127")

    it("i8 to usize"):
        assert_equal(
            usize::try_from(i8(-128)),
            .Err(TryFromIntError {}),
            reason="i8 to usize: -128",
        )
        assert_equal(usize::try_from(i8(-1)), .Err(TryFromIntError {}), reason="i8 to usize: -1")
        assert_equal(usize::try_from(i8(0)), .Ok(usize(0)), reason="i8 to usize: 0")
        assert_equal(usize::try_from(i8(127)), .Ok(usize(127)), reason="i8 to usize: 127")

    it("i8 to u64"):
        assert_equal(u64::try_from(i8(-128)), .Err(TryFromIntError {}), reason="i8 to u64: -128")
        assert_equal(u64::try_from(i8(-1)), .Err(TryFromIntError {}), reason="i8 to u64: -1")
        assert_equal(u64::try_from(i8(0)), .Ok(u64(0)), reason="i8 to u64: 0")
        assert_equal(u64::try_from(i8(127)), .Ok(u64(127)), reason="i8 to u64: 127")

    it("i16 to i8"):
        assert_equal(
            i8::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to i8: -32768",
        )
        assert_equal(i8::try_from(i16(-129)), .Err(TryFromIntError {}), reason="i16 to i8: -129")
        assert_equal(i8::try_from(i16(-128)), .Ok(i8(-128)), reason="i16 to i8: -128")
        assert_equal(i8::try_from(i16(0)), .Ok(i8(0)), reason="i16 to i8: 0")
        assert_equal(i8::try_from(i16(127)), .Ok(i8(127)), reason="i16 to i8: 127")
        assert_equal(i8::try_from(i16(128)), .Err(TryFromIntError {}), reason="i16 to i8: 128")
        assert_equal(i8::try_from(i16(32767)), .Err(TryFromIntError {}), reason="i16 to i8: 32767")

    it("i16 to u8"):
        assert_equal(
            u8::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to u8: -32768",
        )
        assert_equal(u8::try_from(i16(-1)), .Err(TryFromIntError {}), reason="i16 to u8: -1")
        assert_equal(u8::try_from(i16(0)), .Ok(u8(0)), reason="i16 to u8: 0")
        assert_equal(u8::try_from(i16(255)), .Ok(u8(255)), reason="i16 to u8: 255")
        assert_equal(u8::try_from(i16(256)), .Err(TryFromIntError {}), reason="i16 to u8: 256")
        assert_equal(u8::try_from(i16(32767)), .Err(TryFromIntError {}), reason="i16 to u8: 32767")

    it("i16 to u16"):
        assert_equal(
            u16::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to u16: -32768",
        )
        assert_equal(u16::try_from(i16(-1)), .Err(TryFromIntError {}), reason="i16 to u16: -1")
        assert_equal(u16::try_from(i16(0)), .Ok(u16(0)), reason="i16 to u16: 0")
        assert_equal(u16::try_from(i16(32767)), .Ok(u16(32767)), reason="i16 to u16: 32767")

    it("i16 to u32"):
        assert_equal(
            u32::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to u32: -32768",
        )
        assert_equal(u32::try_from(i16(-1)), .Err(TryFromIntError {}), reason="i16 to u32: -1")
        assert_equal(u32::try_from(i16(0)), .Ok(u32(0)), reason="i16 to u32: 0")
        assert_equal(u32::try_from(i16(32767)), .Ok(u32(32767)), reason="i16 to u32: 32767")

    it("i16 to usize"):
        assert_equal(
            usize::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to usize: -32768",
        )
        assert_equal(usize::try_from(i16(-1)), .Err(TryFromIntError {}), reason="i16 to usize: -1")
        assert_equal(usize::try_from(i16(0)), .Ok(usize(0)), reason="i16 to usize: 0")
        assert_equal(usize::try_from(i16(32767)), .Ok(usize(32767)), reason="i16 to usize: 32767")

    it("i16 to u64"):
        assert_equal(
            u64::try_from(i16(-32768)),
            .Err(TryFromIntError {}),
            reason="i16 to u64: -32768",
        )
        assert_equal(u64::try_from(i16(-1)), .Err(TryFromIntError {}), reason="i16 to u64: -1")
        assert_equal(u64::try_from(i16(0)), .Ok(u64(0)), reason="i16 to u64: 0")
        assert_equal(u64::try_from(i16(32767)), .Ok(u64(32767)), reason="i16 to u64: 32767")

    it("i32 to i8"):
        assert_equal(
            i8::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to i8: -2147483648",
        )
        assert_equal(i8::try_from(i32(-129)), .Err(TryFromIntError {}), reason="i32 to i8: -129")
        assert_equal(i8::try_from(i32(-128)), .Ok(i8(-128)), reason="i32 to i8: -128")
        assert_equal(i8::try_from(i32(0)), .Ok(i8(0)), reason="i32 to i8: 0")
        assert_equal(i8::try_from(i32(127)), .Ok(i8(127)), reason="i32 to i8: 127")
        assert_equal(i8::try_from(i32(128)), .Err(TryFromIntError {}), reason="i32 to i8: 128")
        assert_equal(
            i8::try_from(i32(2147483647)),
            .Err(TryFromIntError {}),
            reason="i32 to i8: 2147483647",
        )

    it("i32 to i16"):
        assert_equal(
            i16::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to i16: -2147483648",
        )
        assert_equal(
            i16::try_from(i32(-32769)),
            .Err(TryFromIntError {}),
            reason="i32 to i16: -32769",
        )
        assert_equal(i16::try_from(i32(-32768)), .Ok(i16(-32768)), reason="i32 to i16: -32768")
        assert_equal(i16::try_from(i32(0)), .Ok(i16(0)), reason="i32 to i16: 0")
        assert_equal(i16::try_from(i32(32767)), .Ok(i16(32767)), reason="i32 to i16: 32767")
        assert_equal(
            i16::try_from(i32(32768)),
            .Err(TryFromIntError {}),
            reason="i32 to i16: 32768",
        )
        assert_equal(
            i16::try_from(i32(2147483647)),
            .Err(TryFromIntError {}),
            reason="i32 to i16: 2147483647",
        )

    it("i32 to u8"):
        assert_equal(
            u8::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to u8: -2147483648",
        )
        assert_equal(u8::try_from(i32(-1)), .Err(TryFromIntError {}), reason="i32 to u8: -1")
        assert_equal(u8::try_from(i32(0)), .Ok(u8(0)), reason="i32 to u8: 0")
        assert_equal(u8::try_from(i32(255)), .Ok(u8(255)), reason="i32 to u8: 255")
        assert_equal(u8::try_from(i32(256)), .Err(TryFromIntError {}), reason="i32 to u8: 256")
        assert_equal(
            u8::try_from(i32(2147483647)),
            .Err(TryFromIntError {}),
            reason="i32 to u8: 2147483647",
        )

    it("i32 to u16"):
        assert_equal(
            u16::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to u16: -2147483648",
        )
        assert_equal(u16::try_from(i32(-1)), .Err(TryFromIntError {}), reason="i32 to u16: -1")
        assert_equal(u16::try_from(i32(0)), .Ok(u16(0)), reason="i32 to u16: 0")
        assert_equal(u16::try_from(i32(65535)), .Ok(u16(65535)), reason="i32 to u16: 65535")
        assert_equal(
            u16::try_from(i32(65536)),
            .Err(TryFromIntError {}),
            reason="i32 to u16: 65536",
        )
        assert_equal(
            u16::try_from(i32(2147483647)),
            .Err(TryFromIntError {}),
            reason="i32 to u16: 2147483647",
        )

    it("i32 to u32"):
        assert_equal(
            u32::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to u32: -2147483648",
        )
        assert_equal(u32::try_from(i32(-1)), .Err(TryFromIntError {}), reason="i32 to u32: -1")
        assert_equal(u32::try_from(i32(0)), .Ok(u32(0)), reason="i32 to u32: 0")
        assert_equal(
            u32::try_from(i32(2147483647)),
            .Ok(u32(2147483647)),
            reason="i32 to u32: 2147483647",
        )

    it("i32 to usize"):
        assert_equal(
            usize::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to usize: -2147483648",
        )
        assert_equal(usize::try_from(i32(-1)), .Err(TryFromIntError {}), reason="i32 to usize: -1")
        assert_equal(usize::try_from(i32(0)), .Ok(usize(0)), reason="i32 to usize: 0")
        assert_equal(
            usize::try_from(i32(2147483647)),
            .Ok(usize(2147483647)),
            reason="i32 to usize: 2147483647",
        )

    it("i32 to u64"):
        assert_equal(
            u64::try_from(i32(-2147483648)),
            .Err(TryFromIntError {}),
            reason="i32 to u64: -2147483648",
        )
        assert_equal(u64::try_from(i32(-1)), .Err(TryFromIntError {}), reason="i32 to u64: -1")
        assert_equal(u64::try_from(i32(0)), .Ok(u64(0)), reason="i32 to u64: 0")
        assert_equal(
            u64::try_from(i32(2147483647)),
            .Ok(u64(2147483647)),
            reason="i32 to u64: 2147483647",
        )

    it("i64 to i8"):
        assert_equal(
            i8::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to i8: -9223372036854775808",
        )
        assert_equal(i8::try_from(i64(-129)), .Err(TryFromIntError {}), reason="i64 to i8: -129")
        assert_equal(i8::try_from(i64(-128)), .Ok(i8(-128)), reason="i64 to i8: -128")
        assert_equal(i8::try_from(i64(0)), .Ok(i8(0)), reason="i64 to i8: 0")
        assert_equal(i8::try_from(i64(127)), .Ok(i8(127)), reason="i64 to i8: 127")
        assert_equal(i8::try_from(i64(128)), .Err(TryFromIntError {}), reason="i64 to i8: 128")
        assert_equal(
            i8::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to i8: 9223372036854775807",
        )

    it("i64 to i16"):
        assert_equal(
            i16::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to i16: -9223372036854775808",
        )
        assert_equal(
            i16::try_from(i64(-32769)),
            .Err(TryFromIntError {}),
            reason="i64 to i16: -32769",
        )
        assert_equal(i16::try_from(i64(-32768)), .Ok(i16(-32768)), reason="i64 to i16: -32768")
        assert_equal(i16::try_from(i64(0)), .Ok(i16(0)), reason="i64 to i16: 0")
        assert_equal(i16::try_from(i64(32767)), .Ok(i16(32767)), reason="i64 to i16: 32767")
        assert_equal(
            i16::try_from(i64(32768)),
            .Err(TryFromIntError {}),
            reason="i64 to i16: 32768",
        )
        assert_equal(
            i16::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to i16: 9223372036854775807",
        )

    it("i64 to i32"):
        assert_equal(
            i32::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to i32: -9223372036854775808",
        )
        assert_equal(
            i32::try_from(i64(-2147483649)),
            .Err(TryFromIntError {}),
            reason="i64 to i32: -2147483649",
        )
        assert_equal(
            i32::try_from(i64(-2147483648)),
            .Ok(i32(-2147483648)),
            reason="i64 to i32: -2147483648",
        )
        assert_equal(i32::try_from(i64(0)), .Ok(i32(0)), reason="i64 to i32: 0")
        assert_equal(
            i32::try_from(i64(2147483647)),
            .Ok(i32(2147483647)),
            reason="i64 to i32: 2147483647",
        )
        assert_equal(
            i32::try_from(i64(2147483648)),
            .Err(TryFromIntError {}),
            reason="i64 to i32: 2147483648",
        )
        assert_equal(
            i32::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to i32: 9223372036854775807",
        )

    it("i64 to u8"):
        assert_equal(
            u8::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to u8: -9223372036854775808",
        )
        assert_equal(u8::try_from(i64(-1)), .Err(TryFromIntError {}), reason="i64 to u8: -1")
        assert_equal(u8::try_from(i64(0)), .Ok(u8(0)), reason="i64 to u8: 0")
        assert_equal(u8::try_from(i64(255)), .Ok(u8(255)), reason="i64 to u8: 255")
        assert_equal(u8::try_from(i64(256)), .Err(TryFromIntError {}), reason="i64 to u8: 256")
        assert_equal(
            u8::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to u8: 9223372036854775807",
        )

    it("i64 to u16"):
        assert_equal(
            u16::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to u16: -9223372036854775808",
        )
        assert_equal(u16::try_from(i64(-1)), .Err(TryFromIntError {}), reason="i64 to u16: -1")
        assert_equal(u16::try_from(i64(0)), .Ok(u16(0)), reason="i64 to u16: 0")
        assert_equal(u16::try_from(i64(65535)), .Ok(u16(65535)), reason="i64 to u16: 65535")
        assert_equal(
            u16::try_from(i64(65536)),
            .Err(TryFromIntError {}),
            reason="i64 to u16: 65536",
        )
        assert_equal(
            u16::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to u16: 9223372036854775807",
        )

    it("i64 to u32"):
        assert_equal(
            u32::try_from(i64(-9223372036854775808)),
            .Err(TryFromIntError {}),
            reason="i64 to u32: -9223372036854775808",
        )
        assert_equal(u32::try_from(i64(-1)), .Err(TryFromIntError {}), reason="i64 to u32: -1")
        assert_equal(u32::try_from(i64(0)), .Ok(u32(0)), reason="i64 to u32: 0")
        assert_equal(
            u32::try_from(i64(4294967295)),
            .Ok(u32(4294967295)),
            reason="i64 to u32: 4294967295",
        )
        assert_equal(
            u32::try_from(i64(4294967296)),
            .Err(TryFromIntError {}),
            reason="i64 to u32: 4294967296",
        )
        assert_equal(
            u32::try_from(i64(9223372036854775807)),
            .Err(TryFromIntError {}),
            reason="i64 to u32: 9223372036854775807",
        )

    it("i64 to usize"):
        assert_equal(
