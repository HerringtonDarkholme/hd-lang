# test: inverse trigonometric functions and scaled logarithms retain reduction accuracy
use std.testing.assert

fn near(value: f64, expected: u64) -> void:
    assert(
        value.to_bits().abs_diff(expected) <= 1,
        "actual bits ${value.to_bits()}, expected $expected",
    )

tests:
    it("log2 agrees with high precision across reduction boundaries"):
        near(f64::from_bits(1).log2(), 13875810354254053376)
        near(f64::from_bits(4503599627370495).log2(), 13875572859742453760)
        near(f64::from_bits(4503599627370496).log2(), 13875572859742453760)
