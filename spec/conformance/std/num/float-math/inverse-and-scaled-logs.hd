    it("inverse domains and non-finite inputs follow IEEE behavior"):
        inf := f64::from_bits(0x7ff0000000000000)
        nan := f64::from_bits(0x7ff8000000000001)
        assert(inf.asin().is_nan())
        assert((-inf).asin().is_nan())
        assert(inf.acos().is_nan())
        assert((-inf).acos().is_nan())
        assert(nan.atan().is_nan())
        assert(nan.asin().is_nan())
        assert(nan.acos().is_nan())
        assert(nan.atan2(1.0).is_nan())
        assert(1.0.atan2(nan).is_nan())
        assert(nan.log2().is_nan())
        assert(nan.log10().is_nan())
        assert_equal(0.0.log2(), -inf)
        assert_equal((-0.0).log10(), -inf)
        assert((-inf).log2().is_nan())
        assert((-inf).log10().is_nan())
