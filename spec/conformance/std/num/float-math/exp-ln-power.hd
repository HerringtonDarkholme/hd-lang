# test: float logarithm, exponential, signed power and sign preserve IEEE special values
use std.testing.assert

fn near(value: f64, expected: u64) -> void:
    assert(
        value.to_bits().abs_diff(expected) <= 1,
        "actual bits ${value.to_bits()}, expected $expected",
    )

tests:
    it("logarithm normalizes binary64 values including subnormals"):
        near(f64::from_bits(1).ln(), 13873131416795836867)
        near(f64::from_bits(4503599627370495).ln(), 13872814373467765970)
