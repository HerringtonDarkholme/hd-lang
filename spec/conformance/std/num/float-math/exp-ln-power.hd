    it("special values retain their specified signs and domains"):
        inf := f64::from_bits(0x7ff0000000000000)
        nan := f64::from_bits(0x7ff8000000000001)
        assert_equal(0.0.ln(), -inf)
        assert_equal((-0.0).ln(), -inf)
        assert((-1.0).ln().is_nan())
        assert_equal(inf.ln(), inf)
        assert((-inf).ln().is_nan())
        assert(nan.ln().is_nan())
        assert_equal(inf.exp(), inf)
        assert_equal((-inf).exp().to_bits(), 0)
        assert(nan.exp().is_nan())
        assert_equal(0.0.exp(), 1.0)
        assert_equal((-0.0).exp(), 1.0)
        assert_equal(0.0.signum(), 1.0)
        assert_equal((-0.0).signum(), -1.0)
        assert_equal(inf.signum(), 1.0)
        assert_equal((-inf).signum(), -1.0)
        assert(nan.signum().is_nan())

    it("integer powers consume all signed exponent bits without overflow"):
        assert_equal(2.0.powi(-3), 0.125)
        assert_equal((-2.0).powi(3), -8.0)
        assert_equal((-0.0).powi(3).to_bits(), 0x8000000000000000)
        assert_equal((-0.0).powi(-3), -1.0 / 0.0)
        assert_equal((-1.0).powi(-2147483648), 1.0)
        assert_equal(1.0.powi(2147483647), 1.0)
        assert_equal(0.0.powi(0), 1.0)
        assert_equal(2.0.powf(3.0), 8.0)
        assert((-2.0).powf(0.5).is_nan())

    it("binary32 forwards and integer powers keep the receiver width"):
        x := f32(2.0)
        assert_equal(x.ln().to_bits(), f32(0.6931471805599453).to_bits())
        assert_equal(f32(1.0).exp().to_bits(), f32(2.718281828459045).to_bits())
        assert_equal(x.powi(-3), f32(0.125))
        assert_equal(x.powf(f32(3.0)), f32(8.0))
        assert_equal(f32(-0.0).signum(), f32(-1.0))
