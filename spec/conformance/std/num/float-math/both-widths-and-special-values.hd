# test: every float math method keeps both widths and IEEE special inputs
use std.testing.assert

fn near32(value: f32, expected: u32) -> void:
    if (expected & 0x7fffffff) > 0x7f800000:
        assert(value.is_nan())
    else:
        assert(
            value.to_bits().abs_diff(expected) <= 1,
            "binary32 bits ${value.to_bits()} vs $expected",
        )

fn near64(value: f64, expected: u64) -> void:
    if (expected & 0x7fffffffffffffff) > 0x7ff0000000000000:
        assert(value.is_nan())
    else:
        assert(
            value.to_bits().abs_diff(expected) <= 1,
            "binary64 bits ${value.to_bits()} vs $expected",
        )

tests:
    it("sin checks binary32 and both-width special values"):
        assert_equal(f32::from_bits(0).sin().to_bits(), 0)
        assert_equal(f32::from_bits(2147483648).sin().to_bits(), 2147483648)
        assert(f32::from_bits(2139095040).sin().is_nan())
        assert(f32::from_bits(4286578688).sin().is_nan())
        assert(f32::from_bits(2143289345).sin().is_nan())
        assert_equal(f64::from_bits(0).sin().to_bits(), 0)
        assert_equal(f64::from_bits(9223372036854775808).sin().to_bits(), 9223372036854775808)
        assert(f64::from_bits(9218868437227405312).sin().is_nan())
        assert(f64::from_bits(18442240474082181120).sin().is_nan())
        assert(f64::from_bits(9221120237041090561).sin().is_nan())
        near32(f32::from_bits(1).sin(), 1)
        near32(f32::from_bits(2147483649).sin(), 2147483649)
        near32(f32::from_bits(8388607).sin(), 8388607)
        near32(f32::from_bits(8388608).sin(), 8388608)
        near32(f32::from_bits(1065353215).sin(), 1062693540)
        near32(f32::from_bits(1065353216).sin(), 1062693540)
        near32(f32::from_bits(1065353217).sin(), 1062693542)
        near32(f32::from_bits(2139095039).sin(), 3204815283)
        near32(f32::from_bits(4286578687).sin(), 1057331635)
        near32(f32::from_bits(844411867).sin(), 844411867)
        near32(f32::from_bits(859103849).sin(), 859103849)
        near32(f32::from_bits(221929743).sin(), 221929743)
        near32(f32::from_bits(976055033).sin(), 976055032)
        near32(f32::from_bits(1599971809).sin(), 1058294054)
        near32(f32::from_bits(1200532190).sin(), 3205022395)
        near32(f32::from_bits(2003258644).sin(), 1046439867)
        near32(f32::from_bits(1161500942).sin(), 1052380013)
        near32(f32::from_bits(1667047477).sin(), 1055854935)
        near32(f32::from_bits(87803670).sin(), 87803670)
        near32(f32::from_bits(358704528).sin(), 358704528)
        near32(f32::from_bits(495690580).sin(), 495690580)
        near32(f32::from_bits(1702205336).sin(), 3205803928)
        near32(f32::from_bits(1990384397).sin(), 3212765879)
        near32(f32::from_bits(1285904332).sin(), 3212829770)
        near32(f32::from_bits(1685383642).sin(), 3201831709)
        near32(f32::from_bits(2105776360).sin(), 3210474604)
        near32(f32::from_bits(791595850).sin(), 791595850)
        near32(f32::from_bits(1493484277).sin(), 3202286200)
