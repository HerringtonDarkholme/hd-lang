    it("binary32 atan2 preserves every signed-axis and infinity quadrant"):
        assert_equal(
            f32::from_bits(4286578688).atan2(f32::from_bits(4286578688)).to_bits(),
            3222719460,
        )
        assert_equal(
            f32::from_bits(3212836864).atan2(f32::from_bits(4286578688)).to_bits(),
            3226013659,
        )
        assert_equal(
            f32::from_bits(2147483648).atan2(f32::from_bits(4286578688)).to_bits(),
            3226013659,
        )
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(4286578688)).to_bits(), 1078530011)
        assert_equal(
            f32::from_bits(1065353216).atan2(f32::from_bits(4286578688)).to_bits(),
            1078530011,
        )
        assert_equal(
            f32::from_bits(2139095040).atan2(f32::from_bits(4286578688)).to_bits(),
            1075235812,
        )
        assert_equal(
            f32::from_bits(4286578688).atan2(f32::from_bits(3212836864)).to_bits(),
            3217625051,
        )
        assert_equal(
            f32::from_bits(3212836864).atan2(f32::from_bits(3212836864)).to_bits(),
            3222719460,
        )
        assert_equal(
            f32::from_bits(2147483648).atan2(f32::from_bits(3212836864)).to_bits(),
            3226013659,
        )
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(3212836864)).to_bits(), 1078530011)
        assert_equal(
            f32::from_bits(1065353216).atan2(f32::from_bits(3212836864)).to_bits(),
            1075235812,
        )
        assert_equal(
            f32::from_bits(2139095040).atan2(f32::from_bits(3212836864)).to_bits(),
            1070141403,
        )
        assert_equal(
            f32::from_bits(4286578688).atan2(f32::from_bits(2147483648)).to_bits(),
            3217625051,
        )
        assert_equal(
            f32::from_bits(3212836864).atan2(f32::from_bits(2147483648)).to_bits(),
            3217625051,
        )
        assert_equal(
            f32::from_bits(2147483648).atan2(f32::from_bits(2147483648)).to_bits(),
            3226013659,
        )
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(2147483648)).to_bits(), 1078530011)
        assert_equal(
            f32::from_bits(1065353216).atan2(f32::from_bits(2147483648)).to_bits(),
            1070141403,
        )
        assert_equal(
            f32::from_bits(2139095040).atan2(f32::from_bits(2147483648)).to_bits(),
            1070141403,
        )
        assert_equal(f32::from_bits(4286578688).atan2(f32::from_bits(0)).to_bits(), 3217625051)
        assert_equal(f32::from_bits(3212836864).atan2(f32::from_bits(0)).to_bits(), 3217625051)
        assert_equal(f32::from_bits(2147483648).atan2(f32::from_bits(0)).to_bits(), 2147483648)
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(0)).to_bits(), 0)
        assert_equal(f32::from_bits(1065353216).atan2(f32::from_bits(0)).to_bits(), 1070141403)
        assert_equal(f32::from_bits(2139095040).atan2(f32::from_bits(0)).to_bits(), 1070141403)
        assert_equal(
            f32::from_bits(4286578688).atan2(f32::from_bits(1065353216)).to_bits(),
            3217625051,
        )
        assert_equal(
            f32::from_bits(3212836864).atan2(f32::from_bits(1065353216)).to_bits(),
            3209236443,
        )
        assert_equal(
            f32::from_bits(2147483648).atan2(f32::from_bits(1065353216)).to_bits(),
            2147483648,
        )
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(1065353216)).to_bits(), 0)
        assert_equal(
            f32::from_bits(1065353216).atan2(f32::from_bits(1065353216)).to_bits(),
            1061752795,
        )
        assert_equal(
            f32::from_bits(2139095040).atan2(f32::from_bits(1065353216)).to_bits(),
            1070141403,
        )
        assert_equal(
            f32::from_bits(4286578688).atan2(f32::from_bits(2139095040)).to_bits(),
            3209236443,
        )
        assert_equal(
            f32::from_bits(3212836864).atan2(f32::from_bits(2139095040)).to_bits(),
            2147483648,
        )
        assert_equal(
            f32::from_bits(2147483648).atan2(f32::from_bits(2139095040)).to_bits(),
            2147483648,
        )
        assert_equal(f32::from_bits(0).atan2(f32::from_bits(2139095040)).to_bits(), 0)
        assert_equal(f32::from_bits(1065353216).atan2(f32::from_bits(2139095040)).to_bits(), 0)
        assert_equal(
            f32::from_bits(2139095040).atan2(f32::from_bits(2139095040)).to_bits(),
            1061752795,
        )
        nan := f32::from_bits(0x7fc00001)
        assert(nan.atan2(f32(1.0)).is_nan())
        assert(f32(1.0).atan2(nan).is_nan())
