# test: trigonometric kernels reduce the complete finite binary64 range
use std.testing.assert

fn near(value: f64, expected: u64) -> void:
    assert(
        value.to_bits().abs_diff(expected) <= 1,
        "actual bits ${value.to_bits()}, expected $expected",
    )

tests:
    it("sin full-range vectors 1"):
        near(f64::from_bits(0).sin(), 0)
        near(f64::from_bits(9223372036854775808).sin(), 9223372036854775808)
        near(f64::from_bits(1).sin(), 1)
        near(f64::from_bits(9223372036854775809).sin(), 9223372036854775809)
        near(f64::from_bits(4503599627370496).sin(), 4503599627370496)
