    it("trigonometric non-finite values are NaN and zeros keep their signs"):
        inf := f64::from_bits(0x7ff0000000000000)
        nan := f64::from_bits(0x7ff8000000000001)
        assert(inf.sin().is_nan())
        assert((-inf).sin().is_nan())
        assert(inf.cos().is_nan())
        assert((-inf).cos().is_nan())
        assert(inf.tan().is_nan())
        assert((-inf).tan().is_nan())
        assert(nan.sin().is_nan())
        assert(nan.cos().is_nan())
        assert(nan.tan().is_nan())
        assert_equal((-0.0).sin().to_bits(), 0x8000000000000000)
        assert_equal((-0.0).tan().to_bits(), 0x8000000000000000)
        assert_equal((-0.0).cos(), 1.0)
