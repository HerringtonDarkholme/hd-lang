# test: float constants have Rust's module paths and no associated-constant mechanism
use std.f64.consts.{PI, E}
use std.f32.consts.{PI as PI32, E as E32}

fn wave(turns: f64) -> f64:
    (turns * 2.0 * PI()).sin()

fn growth(time: f64) -> f64:
    time.exp() / E()

tests:
    it("constant functions return correctly rounded values at each width"):
        assert_equal(PI().to_bits(), 0x400921fb54442d18)
        assert_equal(E().to_bits(), 0x4005bf0a8b145769)
        assert_equal(PI32().to_bits(), 0x40490fdb)
        assert_equal(E32().to_bits(), 0x402df854)

    it("the printed wave and growth examples use module constants"):
        assert_equal(wave(0.0), 0.0)
        assert((growth(1.0) - 1.0).abs() < 5.0e-16)
        assert((growth(0.0) - 0.36787944117144233).abs() < 1.0e-16)
