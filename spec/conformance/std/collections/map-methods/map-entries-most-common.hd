# test: entries lists the pairs in the map's order, and most_common orders a tally by count with ties in the map's order
# Spec std/collections Map Methods: std-collections.map.entries and std-collections.map.most-common,
# with std-collections.map.most-common.tie-order for the order of equal counts.
use std.collections.counts

tests:
    use std.testing.assert_equal

    it("entries follow the map's order"):
        stock := { "tea": 3, "milk": 1, "jam": 2 }
        pairs := stock.entries()
        keys := stock.keys().collect::[List[string]]()
        values := stock.values().collect::[List[i32]]()
        assert_equal(
            pairs.sorted(),
            [("jam", 2), ("milk", 1), ("tea", 3)],
            reason="every pair once",
        )
        for i in 0..3:
            assert_equal(pairs[i], (keys[i], values[i]), reason="the order of keys and values")
        let empty: Map[string, i32] = {}
        assert_equal(empty.entries(), [], reason="empty")
    it("entries is a snapshot"):
        let mut stock: Map[string, i32] = { "tea": 3 }
        pairs := stock.entries()
        stock["milk"] = 1
        assert_equal(pairs, [("tea", 3)], reason="unchanged")
    it("most_common orders by count, ties in the map's order"):
        tally := counts("the cat and the hat and the bat".split_whitespace())
        let mut expected: List[(string, usize)] = [("the", 3), ("and", 2)]
        for pair in tally.entries():
            if pair._1 == 1:
                expected.push(pair)
        assert_equal(expected.len(), 5, reason="three words tie at one")
        assert_equal(tally.most_common(5), expected, reason="count, then the map's order")
    it("most_common clamps n"):
        tally := counts(["x", "y", "x"])
        assert_equal(tally.most_common(10), [("x", 2), ("y", 1)], reason="every entry")
        assert_equal(tally.most_common(0), [], reason="none")
        let empty: Map[string, usize] = {}
        assert_equal(empty.most_common(2), [], reason="empty tally")
