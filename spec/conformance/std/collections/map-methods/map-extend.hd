# test: map-extend preserves values and copy independence
# expect: test
# Spec std/collections: std-collections.map.extend, std-collections.map.extend-last-wins.
use std.collections.UniqList

tests:
    use std.testing.{assert, assert_equal}

    it("map-extend"):
        let mut items = { "a": +1, "b": 2 }
        snapshot := items
        items.extend([("b", +20), ("c", +3), ("c", +30)])
        entries := items.entries()
        assert_equal(entries.len(), 3)
        assert_equal(
            entries.sorted(),
            [("a", +1), ("b", +20), ("c", +30)],
            reason="the last pair for a repeated key wins, compared sorted",
        )
        assert_equal(snapshot, { "a": +1, "b": 2 })
        items.extend(items)
        assert_equal(items.len(), 3)
        let mut unique = UniqList::[(string, i32)].new()
        unique.push(("d", +4))
        items.extend(unique)
        assert_equal(items["d"], +4)
