# test: a List copy is a value: a change through one copy, of scalars or strings, leaves the others unchanged, and every value is released once
# expect-stdout: 100 0 10 10|
# expect-stdout: 3 2 a b c|
# expect-stdout: a b|
# expect-stdout: z 1 a|
# expect-stdout: 45 3
# Spec 04 Type System: types.coll.value. The std list over one counted block (#2369) keeps the builtin List's value semantics.

fn grown(xs: List[string]) -> List[string]:
    let mut out = xs
    out.push("c")
    out

pub fn main() -> void $ Console:
    let mut xs: List[i64] = []
    for i in 0..10:
        xs.push(i64(i))
    ys := xs
    xs[0] = 100
    println("${xs[0]} ${ys[0]} ${xs.len()} ${ys.len()}|")
    let mut ss = List::[string].with_capacity(2)
    ss.push("a")
    ss.push("b")
    tt := grown(ss)
    println("${tt.len()} ${ss.len()} ${tt[0]} ${tt[1]} ${tt[2]}|")
    let mut uu = tt
    _ := uu.pop()
    uu.truncate(2)
    println("${uu[0]} ${uu[1]}|")
    let mut vv = uu
    vv.insert(0, "z")
    _ := vv.remove(1)
    vv.truncate(2)
    println("${vv[0]} ${uu.len() - 1} ${uu[0]}|")
    let mut sum: i64 = 0
    for x in ys.iter():
        sum += x
    let mut big: List[List[string]] = []
    big.push(ss)
    big.push(tt)
    big.push(uu)
    println("$sum ${big.len()}")
