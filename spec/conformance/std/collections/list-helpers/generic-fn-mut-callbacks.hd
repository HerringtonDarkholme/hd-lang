# test: collection and iterator consumers accept mutable generic callbacks and borrowed List elements
# Spec std/collections List Helpers: std-collections.helper.callback-generic-ref.
# Spec std/iter Iterator Adapters: std-iter.adapter.fold.fn-mut, std-iter.adapter.any.fn-mut, std-iter.adapter.all.fn-mut, std-iter.adapter.find.fn-mut.
# Spec std/iter List And Optional Map: std-iter.option.map.fn-mut.
# expect: test
use std.collections.{UniqList, UniqMap}
use std.function.FnMut

fn generic_any[F < ?Copy & FnMut(&i32) -> bool](values: &List[i32], predicate: F) -> bool:
    values.any(predicate)

fn positive(value: &i32) -> bool:
    *value > 0

fn optional_map[F < ?Copy & FnMut(i32) -> i32](value: i32?, transform: F) -> i32?:
    value.map(transform)

tests:
    it("mutating predicates and key/comparison functions stay generic"):
        let visits = 0
        values := [+3, 1, 2]
        assert(
            values.any(fn(value: &i32) -> bool:
                visits += 1
                value == 1
            )
        )
        assert_equal(visits, 2)
        let comparisons = 0
        sorted := values.sorted_by(fn(left: &i32, right: &i32) -> Ordering:
            comparisons += 1
            left.cmp(right)
        )
        assert_equal(sorted, [+1, 2, 3])
        assert(comparisons > 0)
        flattened := values.flat_map(fn(value: &i32) -> List[i32]: [*value, *value])
        assert_equal(flattened, [+3, 3, 1, 1, 2, 2])
        assert_equal(values.sum(), +6)
        assert_equal(values.take(2), [+3, 1])
        assert_equal(values.reversed(), [+2, 1, 3])
        let sum_calls = 0
        total := values.iter()
            .fold(+0, fn(total: i32, value: i32) -> i32:
                sum_calls += 1
                total + value
            )
        assert_equal(total, +6)
        assert_equal(sum_calls, 3)

    it("all List visitors retain callback state and borrow elements"):
        values := [+3, 1, 2]
        let calls = 0
        assert_equal(
            values.map(fn(value: &i32) -> i32:
                calls += 1
                *value * 2
            ),
            [+6, 2, 4],
        )
        assert_equal(
            values.filter(fn(value: &i32) -> bool:
                calls += 1
                *value != 1
            ),
            [+3, 2],
        )
        assert_equal(
            values.partition(fn(value: &i32) -> bool:
                calls += 1
                *value > 1
            ),
            ([+3, 2], [+1]),
        )
        assert_equal(
            values.min_by_key(fn(value: &i32) -> i32:
                calls += 1
                *value
            ),
            .Some(+1),
        )
        assert_equal(
            values.max_by_key(fn(value: &i32) -> i32:
                calls += 1
                *value
            ),
            .Some(+3),
        )
        groups := values.group_by(fn(value: &i32) -> i32:
            calls += 1
            *value % 2
        )
        assert_equal(groups[+1], [+3, 1])
        assert_equal(calls, 18)
        let key_calls = 0
        assert_equal(
            values.sorted_by_key(fn(value: &i32) -> i32:
                key_calls += 1
                *value
            ),
            [+1, 2, 3],
        )
        assert_equal(key_calls, 3)
        let mut retained = values
        retained.retain(fn(value: &i32) -> bool:
            calls += 1
            *value > 1
        )
        assert_equal(retained, [+3, 2])
        retained.sort_by_key(fn(value: &i32) -> i32:
            key_calls += 1
            *value
        )
        assert_equal(retained, [+2, 3])
        assert_equal(key_calls, 5)
        assert_equal(values, [+3, 1, 2])

    it("predicates short circuit through generic and erased cursors"):
        let calls = 0
        assert(
            ![+1, 2, 3].all(fn(value: &i32) -> bool:
                calls += 1
                *value < 2
            )
        )
        assert_equal(calls, 2)
        assert_equal(
            [+1, 2, 3].find(fn(value: &i32) -> bool:
                calls += 1
                *value == 2
            ),
            .Some(+2),
        )
        assert_equal(calls, 4)
        assert(
            [+1, 2, 3].iter()
                .any(fn(value: &i32) -> bool:
                    calls += 1
                    *value == 2
                )
        )
        assert_equal(calls, 6)
        assert(
            ![+1, 2, 3].iter()
                .all(fn(value: &i32) -> bool:
                    calls += 1
                    *value < 2
                )
        )
        assert_equal(calls, 8)
        let cursor: *mut dyn Iterator[i32] = box([+1, 2, 3, 4].iter())
        assert(
            cursor.any(fn(value: &i32) -> bool:
                calls += 1
                *value == 2
            )
        )
        assert_equal(
            cursor.find(fn(value: &i32) -> bool:
                calls += 1
                *value == 3
            ),
            .Some(+3),
        )
        assert(
            cursor.all(fn(value: &i32) -> bool:
                calls += 1
                *value == 4
            )
        )
        assert_equal(calls, 12)
        let tail: *mut dyn Iterator[i32] = box([+5, 6].iter())
        assert_equal(
            tail.fold(+0, fn(total: i32, value: i32) -> i32:
                calls += 1
                total + value
            ),
            +11,
        )
        assert_equal(calls, 14)

    it("unique collection visitors accept mutable captures"):
        let mut values = UniqList::[i32].from_list([+3, 1, 2])
        let calls = 0
        assert(
            values.any(fn(value: &i32) -> bool:
                calls += 1
                *value == 1
            )
        )
        assert(
            values.all(fn(value: &i32) -> bool:
                calls += 1
                *value > 0
            )
        )
        assert_equal(
            *values.find_ref(fn(value: &i32) -> bool:
                calls += 1
                *value == 2
            )
                .unwrap(),
            +2,
        )
        assert_equal(calls, 8)
        values.retain(fn(value: &i32) -> bool:
            calls += 1
            *value != 1
        )
        values.sort_by(fn(left: &i32, right: &i32) -> Ordering:
            calls += 1
            left.cmp(right)
        )
        let key_calls = 0
        values.sort_by_key(fn(value: &i32) -> i32:
            key_calls += 1
            -*value
        )
        assert_equal(key_calls, 2)
        assert_equal(values[0], +3)
        let mut owned = UniqMap::[string, i32].new()
        _ := owned.insert("a", +1)
        _ := owned.insert("b", +2)
        let visited = 0
        owned.retain(fn(key: &string, value: &mut i32) -> bool:
            visited += 1
            *value += 10
            *key == "a"
        )
        assert_equal(visited, 2)
        assert_equal(owned["a"], +11)
        let mut copied = { "a": +1, "b": +2 }
        copied.retain(fn(key: &string, value: &mut i32) -> bool:
            visited += 1
            *value += 10
            *key == "b"
        )
        assert_equal(visited, 4)
        assert_equal(copied["b"], +12)

    it("generic forwarding and function values preserve the borrowed shape"):
        values := [+1, 2, 3]
        assert(generic_any(&values, positive))
        let predicate: fn(&i32) -> bool = positive
        assert(values.iter().all(predicate))
        let head: fn(&List[i32], usize) -> List[i32] = List::[i32]::take
        let reverse: fn(&List[i32]) -> List[i32] = List::[i32]::reversed
        let paired: fn(&List[i32], List[string]) -> List[(i32, string)] = List::[i32]::zip
        let sum: fn(&List[i32]) -> i32 = List::[i32]::sum
        assert_equal(head(&values, 2), [+1, 2])
        assert_equal(reverse(&values), [+3, 2, 1])
        assert_equal(paired(&values, ["a"]), [(+1, "a")])
        assert_equal(sum(&values), +6)
        assert_equal(values.windows(2).len(), 2)
        assert_equal(values.unique(), values)
        let indexed: List[(usize, i32)] = values.enumerate().collect()
        assert_equal(indexed, [(0, +1), (1, +2), (2, +3)])

    it("Map cursor projection helper accepts a generic mutable callback"):
        let calls = 0
        assert_equal(
            optional_map(.Some(+3), fn(value: i32) -> i32:
                calls += 1
                value + 1
            ),
            .Some(+4),
        )
        assert_equal(
            optional_map(.None, fn(value: i32) -> i32:
                calls += 1
                value + 1
            ),
            .None,
        )
        assert_equal(calls, 1)

    it("generic optional mapping moves a noncopyable payload"):
        owner := UniqList::[i32].from_list([+1, 2, 3])
        let present: UniqList[i32]? = .Some(owner)
        assert_equal(present.map(fn(value: UniqList[i32]) -> usize: value.len()), .Some(3))
