# test: extending the map through a box alias while a value reference into the unique map behind it is live panics borrow-conflict, as the insert can rehash the map's buffer
use std.collections.UniqMap

struct Stock:
    counts: UniqMap[string, i32]

fn add(apples: &mut i32, alias: *mut Stock) -> void:
    let mut more = UniqMap::[string, i32].new()
    _ := more.insert("pear", 1)
    alias.counts.extend(more) # panic: borrow-conflict
    *apples += 1

tests:
    it("the value reference pins the unique map"):
        stock := box(Stock { counts: UniqMap::[string, i32].new() })
        _ := stock.counts.insert("apple", 3)
        alias := stock
        match stock.counts.get_mut("apple"):
            .Some(apples) => add(apples, alias)
            .None => pass
