# test: Debug for the public types of std.meta and std.meta whose members allow it
# Spec std/format Debug For Standard Types: std-format.debug.std-types (STD-DEBUG). std.meta's Facts, Member, VariantInfo, Field, Variant, Key, and Members hold a function or an Inspectable value, so std-format.debug.std-types.exempt-members leaves them out.
use std.meta.TypeId
use std.meta.SelfRef

fn shown[T < Debug](value: T) -> string:
    debug(value)

fn texts(id: TypeId, kind: SelfRef) -> List[string]:
    [shown(id), shown(kind)]
