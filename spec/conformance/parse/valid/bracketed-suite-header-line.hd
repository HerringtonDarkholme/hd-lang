# test: bracketed control flow and closures may end a header line in a colon
# Spec 01 Suites Inside Delimiters: lex.nested.suite, lex.nested.layout, lex.nested.resume, lex.header.resume.
# expect: parse

fn run(xs: List[i32], c: bool) -> void:
    doubled := [for x in xs:
        x * 2
    ]
    picked := [if c:
        1
    else:
        2]
    handlers := [fn(x: i32) -> i32:
        x + 1
    ]
