# test: a line that starts with ( begins a new statement, never a call of the name that ends the line before
# Spec 01 Leading-Dot Continuation: lex.continue.paren-line (owner decision LP1-one, batch 26, 2026-09-30).
fn pair() -> (i32, i32): (1, 2)

fn split(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32:
    f
    (a, b)
    let (first, second) = pair()
    a + b + first + second
