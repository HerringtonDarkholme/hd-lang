# test: a closing delimiter on the last body line of a nested suite other than a closure body ends that suite
# Spec 01 Suites Inside Delimiters: lex.nested.suite, lex.nested.layout, lex.nested.closer, lex.nested.resume, lex.header.resume.
# expect: parse

fn run(c: bool) -> i32:
    x := (match c:
        true => 40
        false => 0)
    y := (if c:
        1
    else:
        2)
    x + y
