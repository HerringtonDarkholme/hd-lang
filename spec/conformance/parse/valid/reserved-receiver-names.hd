trait Named:
    fn name(self) -> string
    fn clone_name(self) -> Self

data User:
    name: string

impl Named for User:
    fn name(self) -> string: self.name
    fn clone_name(self) -> Self: self

fn map_list() -> void: pass
fn test() -> void: pass
fn derive() -> void: pass
fn pack() -> void: pass
