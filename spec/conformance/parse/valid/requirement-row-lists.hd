# test: requirement rows are comma lists, bare at a header end and parenthesized inside types
# expect: parse

trait Clock

trait Logger

trait Store:
    fn load(self) -> i32 $ Clock + Logger
    fn save(mut self, value: i32) -> void $ Clock + Logger

data Hooks:
    on_tick: fn() -> i32 $ Clock + Logger
    handlers: Map[string, fn() -> i32 $ Clock + Logger]
    pair: (fn() -> i32 $ Clock + Logger, fn() -> i32 $ Clock)
    idle: fn() -> void $()

fn single() -> i32 $ Clock: 1

fn several(id: i32) -> i32 $ Clock + Logger + Store: id

fn grouped() -> i32 $ Clock + Logger: 2

fn empty() -> i32 $(): 3

fn wrap() -> (fn() -> i32 $ Clock + Logger) $ Clock:
    fn() -> i32 $ Clock + Logger: 4

fn provide[R](callback: fn() -> i32 $ R + Logger) -> i32 $ R:
    callback()

fn contexts(
    both: $.Context[$ Clock + Logger],
    one: $.Context[Clock],
    none: $.Context[$()],
) -> void: pass

tests:
    it("a closure header lists its keys bare"):
        run := fn() -> i32 $ Clock + Logger: 5
        pass
