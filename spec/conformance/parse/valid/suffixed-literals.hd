# test: decimal and floating-point literals take suffixes
# Spec 01 Literal Suffixes: the forms a suffixed literal takes.
use std.ops.num_suffix

@num_suffix
fn ticks(count: i64) -> i64: count

@num_suffix
fn secs(count: i64) -> i64: count * 1000

timeout := 5secs
delay := 1_500ticks
size := 1.5kb
scaled := 1e3ticks
indent := 5em
back := -5secs
plain := 1e3
