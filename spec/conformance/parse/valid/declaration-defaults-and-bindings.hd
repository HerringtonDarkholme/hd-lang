# test: parser accepts defaults, associated-type bindings and nested commas in declarations
# Spec 02 Grammar: grammar.generic.default, grammar.scope.syntax, grammar.data.default, grammar.generic.binding.positions-key.reference-values, grammar.stmt.let-pattern, grammar.fn.semantic.

# generic default.
pub trait Add[Rhs = Self]

# method parameter nested comma.
impl Eq for Value:
    fn eq(self, other: Result[i32, string]) -> bool:
        true

# public field default.
pub struct Request:
    pub timeout: Duration? = .None

# supertrait associated binding.
pub trait Numeric < Add[Out = Self]

# typed let nested comma.
fn typed_let_nested_comma() -> void:
    let entries: mut Map[string, string] = {}

# value parameter default.
pub fn value_parameter_default(width: usize = +0) -> usize:
    width
