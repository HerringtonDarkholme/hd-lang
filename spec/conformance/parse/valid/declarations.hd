type UserId(string)
type UserName = string

data PostId:
    value: string

pub data User:
    pub id: UserId
    name: UserName

enum Lookup:
    Found(user: User)
    Missing(id: UserId)

trait Describe:
    fn describe(self) -> string

impl Describe for User:
    fn describe(self) -> string:
        self.name

impl User:
    pub fn id_string(self) -> string:
        string(self.id)
