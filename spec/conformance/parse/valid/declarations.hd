type UserId(string)
type UserName = string

pub data User:
    pub id: UserId
    name: UserName

enum Lookup:
    Found(user: User)
    Missing(id: UserId)

trait Display:
    fn display(self) -> string

impl Display for User:
    fn display(self) -> string:
        self.name

impl User:
    pub fn id_string(self) -> string:
        string(self.id)
