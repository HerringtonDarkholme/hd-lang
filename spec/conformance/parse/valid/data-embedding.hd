data Timestamps:
    created_at: i64
    updated_at: i64

data Post:
    Timestamps
    id: string
    title: string

data Owner:
    friend: mut Timestamps
    Timestamps

post := Post {
    Timestamps: Timestamps {
        created_at: 1,
        updated_at: 1,
    },
    id: "post-1",
    title: "Hello",
}
