# test: a deeper line starting with '.name' continues the previous logical line
# expect: parse

enum Step:
    Add
    Double

fn chain(line: string, step: Step) -> i32:
    names := line
        .slice(0, 8)
        # a comment line does not end the chain

        .slice(2, 5)
    match step:
        .Add => names
            .len()
        .Double =>
            .Double
            0
    total := names.len()
    total
