# Spec 02 Test Blocks: grammar.tests.block, grammar.tests.registration.
use std.testing.{assert_equal}

fn add(a: i32, b: i32) -> i32: a + b

tests:
    it("adds two values"):
        result := add(2, 3)
        assert_equal(
            result,
            5,
            reason="add should return the sum",
        )
