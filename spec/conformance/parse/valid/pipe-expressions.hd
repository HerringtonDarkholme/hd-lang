# test: pipe steps, precedence, and leading |> lines parse
# Spec 05 Pipe Expressions and 01 Leading-Pipe Continuation, including lex.pipe.dot-before in chained (Pipe PL3-PL13 and PL15, Chaining Study CS2).

fn label(raw: string) -> string:
    raw |> clean |> tag(_, 2)

fn measure(raw: string, start: usize) -> usize:
    width := raw |> _.len()
    moved := start |> Point { x: _, y: 0 } |> shift(_, 3)
    width + moved |> _ * 2

fn compare(n: i32) -> bool:
    n + 1 |> twice == 4

fn lines(raw: string) -> string:
    raw
        |> _.slice(0, 8)

        # a comment line between steps
        |> _.slice(2, 5)
        |> clean

fn chained(values: List[i32]) -> i32:
    values
        .len()
        |> twice
