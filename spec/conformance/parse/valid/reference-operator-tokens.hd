# Spec 13 Operator Tokens: ref.token.and-and, ref.token.caret, ref.token.and-bound.
fn bounded[T < Display & Debug](value: T) -> void:
    pass

fn tokens(a: bool, b: bool, x: i32, y: i32) -> void:
    both := a && b
    bits := x & y
    flip := x ^ y
    mixed := x & y ^ x | y
    shifted := x & y << 1
    still_and := a && !b
    through := &x && &y
