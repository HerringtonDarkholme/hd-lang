# test: own writes an owned type before a named type, dyn, fn, a tuple, and a type argument
trait Socket:
    fn sent(self) -> usize

data File:
    fd: i32

data Pool:
    idle: own List[own File]

fn open(path: string) -> own File: File { fd: 3 }

fn archive(f: own File) -> void: pass

fn connect(host: string) -> own dyn Socket: dial(host)

fn on_close(f: own File) -> own fn() -> void:
    fn() -> void: archive(f)

fn both(a: string, b: string) -> (own File, own File): (open(a), open(b))

fn first(files: own List[own File]) -> own File?: files.pop()

fn later(job: own fn!() -> void) -> void: pass

fn local() -> void:
    let f: own File = open("app.log")
    archive(f)
