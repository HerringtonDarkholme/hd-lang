# test: own stays an ordinary identifier outside the mark positions
data own:
    owner: string

fn own(x: own) -> own: x

fn use_own(own: i32) -> i32:
    own := own + 1
    let own2 = own
    own2

fn list_of(xs: List[own]) -> own?: xs.at(0)

fn records() -> void:
    let own = 3
    let own: i32 = 4
    _ := own

fn unwrap(w: own) -> void:
    let own(v) = w
