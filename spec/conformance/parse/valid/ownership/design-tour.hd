# test: the borrow tour examples parse as written
trait Socket:
    fn send!(^self, bytes: List[u8]) -> void
    fn read!(^self) -> string
    fn sent(^self) -> usize

type Conn = dyn Socket

fn connect!(host: string) -> Conn: sys_connect!(host)

data File:
    fd: i32

fn open(path: string) -> File: File { fd: sys_open(path) }
fn size(f: ^File) -> usize: sys_size(f.fd)
fn archive(f: File) -> void: sys_copy(f.fd, "archive/")

fn adopt!(host: string, pool: ^mut Pool) -> void:
    c := connect!(host)
    check!(c)
    pool.give(c)

fn with_verbose!(job: fn!() -> void) -> void:
    set_verbose(true)
    defer: set_verbose(false)
    job()

fn copy_log(path: string) -> void:
    f := open(path)
    let view: ^File = f
    defer: report_size(view)
    append(f, "done")

fn upload!(w: Writer, bytes: List[u8]) -> Result[void, NetError]:
    w.write!(bytes)?
    w.finish!()

fn primary(pool: ^List[Conn]) -> Option[^Conn]:
    pool.at(0)

fn busier(a: ^Conn, b: ^Conn) -> usize:
    if a.sent() > b.sent(): a.sent() else: b.sent()

data Document:
    lines: List[string]

fn export(d: ^Document, path: string) -> void:
    f := open(path)
    write_lines(f, d)

data Pool:
    idle: List[Conn]

impl Pool:
    fn give(^mut self, c: Conn) -> void:
        self.idle.push(c)
    fn peek(^self) -> Option[^Conn]:
        self.idle.at(0)

fn warm!(hosts: List[string]) -> void:
    let pool = Pool { idle: [] }
    for h in hosts:
        pool.give(connect!(h))
    serve!(pool)

fn total(xs: ^List[i32]) -> i32:
    let sum = +0
    for x in xs:
        sum = sum + x
    sum

fn on_close(f: File) -> fn() -> void:
    fn() -> void: archive(f)

fn counter(c: ^Conn, report: ^fn(usize) -> void) -> void:
    report(c.sent())

fn first[T](items: ^List[T]) -> Option[^T]:
    items.at(0)

fn take_first[T](xs: List[T]) -> Option[T]:
    xs.into_iter().next()

fn mirror!(a: ^Conn, b: ^Conn) -> void:
    _ := all!(echo(a), echo(b))

fn both!(a: string, b: string) -> (Conn, Conn):
    all!(connect(a), connect(b))

fn emit!(sink: ^mut dyn Sink) -> void:
    sink.write!()

fn prune(pool: ^mut Pool) -> List[string]:
    pool.idle.retain(fn(c: ^Conn) -> bool: c.sent() > 0)
    pool.idle.iter().map(fn(c: ^Conn) -> string: c.peer()).collect()
