# test: let own binds an owned local, with or without a written type
data User:
    name: string

data Buffer:
    bytes: List[u8]

fn make() -> void:
    let own user = User { name: "ada" }
    let own buf: Buffer = Buffer { bytes: [] }
    let own (a, b) = (User { name: "a" }, User { name: "b" })
    let own _ = User { name: "gone" }
