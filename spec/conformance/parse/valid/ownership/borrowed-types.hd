# test: ^ and ^mut write shared and mutable borrows
trait Sink:
    fn write(self) -> void

data Conn:
    fd: i32

data Document:
    lines: List[string]

fn size(c: ^Conn) -> usize: 0

fn fill(buf: ^mut List[u8]) -> void: pass

fn busier(a: ^Conn, b: ^Conn) -> usize:
    if size(a) > size(b): size(a) else: size(b)

fn emit(sink: ^mut dyn Sink) -> void:
    sink.write()

fn count(c: ^Conn, run: ^fn(^Conn) -> usize) -> usize: run(c)

fn view(d: mut Document) -> void:
    let v: ^Document = d
    let w: ^mut Document = d
