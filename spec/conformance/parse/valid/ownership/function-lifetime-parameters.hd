# test: a function declares lifetime parameters after its type parameters
data Conn:
    fd: i32

data Key:
    id: i32

data Pair:
    n: i32

data S[A, B]:
    key: A
    conn: B

fn first[^c](x: ^List[^{c} Conn]) -> ^{c} Conn: x.at(0)

fn add[^c](dst: ^mut List[^{c} Conn], conn: ^{c} Conn) -> void: pass

fn pick[^a, ^b](s: ^S[^{a} Key, ^{b} Conn]) -> ^{a, b} Pair: Pair { n: 0 }

fn keyed[T, ^c](x: T, y: ^{c} Conn) -> ^{c} Conn: y
