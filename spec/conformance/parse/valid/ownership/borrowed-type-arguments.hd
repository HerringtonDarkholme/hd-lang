# test: in a type-argument list, ^ or ^{...} followed by a type is a borrowed type argument, not a lifetime argument
data Conn:
    fd: i32

data Suspend[T]:
    value: T

data Pair[A, ^a]:
    left: ^{a} A

fn borrows(xs: List[^Conn], ys: List[^{xs} mut Conn]) -> Option[^{xs, ys} Conn]: .None

fn frame(keep: ^Conn) -> Suspend[^{keep} Conn]: Suspend { value: keep }

fn both(c: ^Conn) -> Pair[^Conn, ^{c}]: Pair { left: c }
