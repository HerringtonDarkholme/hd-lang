# test: a lifetime set names variables, self, field paths, lifetime parameters, requirement keys, and static
trait Store:
    fn get(self) -> string

data Settings:
    name: string

let CONFIG: Settings = Settings { name: "app" }

fn settings() -> ^{static} Settings:
    let s: ^Settings = CONFIG
    s

fn pair(a: ^Settings, b: ^Settings) -> ^{a, b,} Settings: a

fn label(s: ^Settings) -> ^{s.name} string: s.name

fn first[^c](items: ^List[^{c} Settings]) -> ^{c} Settings: items.at(0)

fn keyed() -> ^{$Store} Settings $ Store: settings()

data Holder:
    s: Settings

impl Holder:
    fn name(^self) -> ^{self} Settings: self.s
