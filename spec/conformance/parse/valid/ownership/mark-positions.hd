# test: a mark may be written on the type of a parameter, result, local, field, enum payload, type argument, tuple element, and function type
data File:
    fd: i32

data Holder[^a]:
    view: ^{a} File
    files: List[^{a} File]

enum Outcome[^a]:
    Done(file: ^{a} mut File)
    Seen(^{a} File)

fn parameter(g: ^File, h: ^mut File) -> void: pass

fn result(f: ^File) -> ^File: f

fn tuple(f: ^File) -> (^File, i32): (f, 0)

fn callback(run: fn(^File) -> i32, done: ^fn() -> void) -> fn(^File) -> i32: run

fn local(f: File) -> void:
    let view: ^File = f
    let pair: (^File, i32) = (f, 0)
    let back: Option[^File] = .None
