# test: a use writes a lifetime argument ^{x}, or an elided ^, after its type arguments
data Document:
    lines: List[string]

data Conn:
    fd: i32

data Parser[^doc]:
    source: ^{doc} Document
    at: usize

data Pair[A, ^a]:
    left: ^{a} A

fn parser(d: ^Document) -> Parser[^]:
    Parser { source: d, at: 0 }

fn named(text: ^Document) -> Parser[^{text}]: parser(text)

fn paired(c: ^Conn) -> Pair[Conn, ^{c}]: Pair { left: c }

fn spaced(d: ^Document) -> Parser[ ^ ]: parser(d)
