# test: the trait of a trait-qualified call takes no binding
# Spec 02 Associated Type Bindings In Bounds: grammar.generic.binding.trait-type-only (owner decision AT2).

trait Supplier:
    type Item
    fn get(self) -> Self::Item

fn read(source: Supplier[Item = i32]) -> i32:
    Supplier[Item = i32]::get(source)  # diagnostic: syntax-error
