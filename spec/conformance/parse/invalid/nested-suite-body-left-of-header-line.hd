# test: a nested suite's body must also be deeper than its header's own continuation line
# Spec 01 Suites Inside Delimiters: lex.nested.body-left.

fn run(callback: fn(i32) -> i32) -> i32: callback(1)

fn main() -> void:
    if true:
        x := run(
            fn(v):
          v + 1  # diagnostic: unexpected-indentation
        )
        pass
