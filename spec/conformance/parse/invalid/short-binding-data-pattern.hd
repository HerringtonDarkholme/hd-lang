# test: := takes a name or a tuple of names, so a data pattern before it needs let
# Spec 02 Short Binding Lists: grammar.stmt.bind-pattern.let-only (owner decision LP1, batch 26, 2026-09-30).
data Point:
    x: i32
    y: i32

fn sum(p: Point) -> i32:
    Point { x, y } := p  # diagnostic: missing-let
    x + y
