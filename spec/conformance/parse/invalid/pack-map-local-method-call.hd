# test: pack.map( always forms the pack operation, so a one-argument call on a local named pack is a syntax error

data Packer:
    count: i32

impl Packer:
    fn map(self, value: i32) -> i32:
        value + self.count

fn main() -> i32:
    pack := Packer { count: 1 }
    pack.map(5)  # diagnostic: syntax-error
