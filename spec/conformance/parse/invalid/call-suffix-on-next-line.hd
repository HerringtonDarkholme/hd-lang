# test: inside brackets a line starting with '(' is not a call of the previous line's operand
# Spec 01 Implicit Continuation: lex.continue.no-suffix, lex.continue.suffix-line, lex.continue.missing-separator.

fn pair(first: i32, second: i32) -> (i32, i32):
    (
        first
        (second)  # diagnostic: syntax-error
    )
