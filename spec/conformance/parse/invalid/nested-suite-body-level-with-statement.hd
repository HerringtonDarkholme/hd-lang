# test: a nested suite's body must be deeper than the logical line that contains its header
# Spec 01 Suites Inside Delimiters: lex.nested.body-depth, lex.nested.reference.

fn run(callback: fn(i32) -> i32) -> i32: callback(1)

fn main() -> void:
    if true:
        x := run(
    fn(v):
        v  # diagnostic: unexpected-indentation
)
        pass
