# test: a comprehension for clause over several names puts them in parentheses, as a loop does
# Spec 02 Control-Flow Expressions: grammar.flow.for-list.bare (owner decision SSC Q4, batch 26, 2026-09-30).
fn labels(scores: Map[string, i32]) -> List[string]:
    [for name, score in scores => name]  # diagnostic: syntax-error
