# test: a bare list before := is a syntax error; the fix-it writes let (a, b) =
# Spec 02 Short Binding Lists: grammar.stmt.short-binding.bare-list (owner decision LP1-one, batch 26, 2026-09-30).
fn pair() -> (i32, i32): (1, 2)

fn invalid() -> i32:
    a, b := pair()  # diagnostic: syntax-error
    a + b
