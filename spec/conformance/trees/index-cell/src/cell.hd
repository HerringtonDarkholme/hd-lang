use std.ops.{Index, IndexSet}

pub data Cell:
    pub value: mut List[i32]

impl Index[usize] for Cell:
    type Out = i32

    fn index(self, key: usize) -> i32:
        self.value[0]

impl IndexSet[usize, i32] for Cell:
    fn index_set(mut self, key: usize, value: i32) -> void:
        self.value[0] = value
