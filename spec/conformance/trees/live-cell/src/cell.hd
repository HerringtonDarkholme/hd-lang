use std.ops.{Apply, Update}

pub struct Cell:
    pub value: i32

impl Apply for Cell:
    type Out = i32
    fn apply(self) -> i32:
        self.value

impl Update[i32] for Cell:
    fn update(&mut self, value: i32) -> void:
        self.value = value

pub fn live(value: i32) -> Cell:
    Cell { value: value }
