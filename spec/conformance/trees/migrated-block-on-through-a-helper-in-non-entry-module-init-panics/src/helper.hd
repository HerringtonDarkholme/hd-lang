use std.task.block_on

fn ready!() -> i32:
    42

fn wait_now() -> i32:
    let pending: mut Suspend[i32] = ready()
    match block_on(pending):
        .Completed(value) => value
        _ => 0

struct QuietConsole: pass

impl Console for QuietConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        .Ok(())

fn print_now() -> i32:
    console := box(QuietConsole {})
    $.with(Console=console):
        println("quiet")
    1

let value = wait_now()

pub fn get() -> i32:
    value
