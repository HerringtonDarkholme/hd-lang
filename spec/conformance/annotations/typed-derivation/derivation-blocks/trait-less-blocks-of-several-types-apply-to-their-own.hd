# test: each type's block with no trait applies to that type alone, whichever derivation reads its facts
# Spec 14 Derivation Blocks With No Trait: annot.no-trait.form, annot.no-trait.after-decorators.
use std.structure.{Structure, Field, Variant, Walker}
struct Tag:
    text: string

struct Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

trait Probe:
    fn probe(self) -> string

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(&self, &mut w)
        w.out

struct Point:
    @tag("a")
    x: i64
    y: i64

impl Point by Structure:
    y = [note("m")]

struct Pair:
    @tag("b")
    left: i64
    right: i64

impl Pair by Structure:
    left += [note("n")]
    right = [tag("c")]

@derive(Probe)
struct Plain:
    @tag("d")
    only: i64

@derive(Probe)
struct Lone:
    first: i64

impl Lone by Structure:
    first = [note("o")]

impl Probe for Point by Structure:
    x += [note("p")]

impl Probe for Pair by Structure:
    right += [note("q")]

tests:
    use std.testing.assert_equal

    it("reads each type's own block with no trait"):
        assert_equal(Point { x: 1, y: 2 }.probe(), "x=a/p;y=-/m;", reason="Point's block")
        assert_equal(Pair { left: 1, right: 2 }.probe(), "left=b/n;right=c/q;", reason="Pair's block")
        assert_equal(Plain { only: 1 }.probe(), "only=d/-;", reason="no block")
        assert_equal(Lone { first: 1 }.probe(), "first=-/o;", reason="a derived type's block")
