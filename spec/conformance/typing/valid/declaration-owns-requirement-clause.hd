# test: a requirement clause before a declaration's ':' belongs to the declaration, not its function-typed result
# expect: accept

trait Log

fn make() -> fn() -> i32 $ Console:
    _ := $.use(Console)
    fn() -> i32: 1

fn wrap() -> (fn() -> i32 $ Log) $ Console:
    _ := $.use(Console)
    fn() -> i32 $ Log:
        _ := $.use(Log)
        2

fn plain(f: fn() -> i32) -> i32: f()

fn run() -> i32 $ Console + Log:
    counter := fn() -> fn() -> i32 $ Console:
        _ := $.use(Console)
        make()
    logged := wrap()
    plain(make()) + plain(counter()) + logged()
