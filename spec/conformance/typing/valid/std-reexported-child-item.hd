# test: a std re-exported child item is usable through the parent
# Spec 10 Modules: r-module.path.no-std-child-import lets a std module expose
# a child module's items with `pub use`.
use std.testing.{Arbitrary, Choices, With, with}

fn cents(c: mut Choices) -> i32:
    c.int(0, 10)

fn make(c: mut Choices) -> With[i32]:
    with(cents)
