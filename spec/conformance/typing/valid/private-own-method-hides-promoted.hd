# test: a private own inherent method hides a promoted pub method of the same name, and the part's method stays reachable by its path
data Base:
    name: string

impl Base:
    pub fn describe(self) -> string:
        self.name

data Page:
    Base

impl Page:
    fn describe(self) -> string:
        "page"

fn valid(page: Page) -> string:
    page.describe() + page.Base.describe()
