# test: one type embedded through two paths at different depths resolves to the shallower copy, with no conflict
# Spec 03 Depths And Promoted Members: names.promote.embedded, names.hide.depth; the embedded field Base is promoted at both depths.
data Base:
    pub id: string

impl Base:
    pub fn label(self) -> string:
        self.id

data Middle:
    Base

data Outer:
    Base
    Middle

fn valid(outer: Outer) -> string:
    outer.id + outer.label() + outer.Base.id + outer.Middle.id
