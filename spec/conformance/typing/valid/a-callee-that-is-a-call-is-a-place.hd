# test: a callee that is a call is a place
# Spec 05 Callable Values: expr.call.apply.place.
use std.ops.{Apply, Update}

struct Cell:
    value: i32

impl Apply for Cell:
    type Out = i32
    fn apply(self) -> i32: self.value

impl Update[i32] for Cell:
    fn update(&mut self, value: i32) -> void:
        self.value = value

fn live(value: i32) -> Cell:
    Cell { value: value }

struct Panel:
    count: Cell
    frozen: Cell

fn pick(panel: &mut Panel) -> *mut Cell: &mut panel.count

fn run(panel: &mut Panel) -> void:
    pick(panel)() = 3
    pick(panel)() += 1
