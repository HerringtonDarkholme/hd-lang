# test: generic recursion that passes a parameter unchanged, or swaps it with another parameter of the cycle, never grows
# Spec 04 Generic Representation: types.generic.call-cycle.grows, types.generic.polymorphic-recursion.
fn count[T](value: T, n: i32) -> i32:
    if n == 0: 0 else: count(value, n - 1) + 1

fn swap[A, B](a: A, b: B, n: i32) -> i32:
    if n == 0: 0 else: swap(b, a, n - 1) + 1

fn ping[T, U](first: T, second: U, n: i32) -> i32:
    if n == 0: 0 else: pong(second, first, n - 1) + 1

fn pong[X, Y](first: X, second: Y, n: i32) -> i32:
    if n == 0: 0 else: ping(first, second, n - 1) + 1

# A larger type argument outside any cycle: `count` never calls `wrap_once`.
fn wrap_once[T](value: T, n: i32) -> i32:
    count([value], n)

pub fn main() -> void:
    _ := count(+1, +3)
    _ := swap(+1, "one", +3)
    _ := ping(+1, "one", +3)
    _ := wrap_once(+1, +3)
