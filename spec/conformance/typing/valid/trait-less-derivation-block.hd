# test: a trait-less block extends and replaces decorator metadata
use std.structure.Structure

data MinLen:
    value: i32

data MaxLen:
    value: i32

fn min_len(value: i32) -> MinLen: MinLen { value: value }

fn max_len(value: i32) -> MaxLen: MaxLen { value: value }

data User:
    @max_len(80)
    name: string
    email: string

impl User by Structure:
    name += [min_len(1)]
    email = [max_len(320)]
