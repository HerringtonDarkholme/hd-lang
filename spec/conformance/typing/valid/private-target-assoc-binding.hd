# test: an impl for a private target may bind a private type
# Spec 10 Public Signatures: module.vis.signature.coverage.
data Hidden:
    n: i32

pub trait Make:
    type Out
    fn make(self) -> Self::Out

data Inner:
    k: i32

impl Make for Inner:
    type Out = Hidden
    fn make(self) -> Hidden:
        Hidden { n: self.k }
