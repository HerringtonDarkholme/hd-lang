# test: counted references made by `box` are stored in fields and lists, returned, captured, used as type arguments, and lent to `&` parameters
# Spec 13 Reference Types: ref.type.counted-forms, ref.type.position; Boxes: ref.box.new, ref.box.weaken; Conversions: ref.convert.lend.
struct Point:
    x: i32

struct Holder:
    point: *mut Point
    seen: List[*Point]

impl Holder:
    fn keep(*self) -> *Holder:
        self

    fn add(*mut self, p: *Point) -> *mut Holder:
        self.seen.push(p)
        self

fn make() -> *mut Point:
    box(Point { x: 0 })

fn address() -> Holder:
    Holder { point: box(Point { x: 1 }), seen: [] }

fn unannotated() -> *Point:
    origin := Point { x: 2 }
    kept := box(origin)
    kept

fn generic[T](value: T) -> T:
    value

fn inferred() -> List[*Point]:
    a := Point { x: 3 }
    b := Point { x: 4 }
    one := generic(box(a))
    [one, box(b)]

fn store(points: &mut List[*Point], p: *Point) -> void:
    points.push(p)

fn reader(p: *Point) -> fn() -> i32:
    fn() -> i32: p.x

fn first(points: List[*Point]) -> *Point?:
    if points.len() == 0: .None else: .Some(points[0])

fn read(p: &Point) -> i32:
    p.x

fn nudge(p: &mut Point) -> void:
    p.x += 1

fn lend(h: Holder) -> i32:
    nudge(h.point)
    read(h.point)
