# test: a binding of an open literal class takes the type a later statement meets
# Spec 04 Local Literal Types: types.literal.local.class.open, types.literal.local.statement.

fn use_i32(n: i32) -> i32:
    n

fn take(n: i32) -> i32:
    n

fn run() -> i64:
    let a = 123
    let kept = use_i32(a)
    x := 5
    let y: i64 = x
    let count = 0
    let total = take(count)
    let xs = [1, 2]
    let small: u8 = xs[0]
    y + i64(kept) + i64(total) + i64(small)
