# test: embedding may be three levels deep, and promotion reaches the deepest part
# Spec 08 Embedding Limits: data.embed.depth; Member Promotion: data.promote.members.
struct Stamp:
    pub at: i32

struct Audit:
    Stamp
    by: string

struct Record:
    Audit
    id: string

struct Page:
    Record
    title: string

fn valid(page: Page) -> i32:
    page.at
