# test: the check rejects only a direct block_on in a defer suite; a call that reaches one through a helper type-checks
use std.task.block_on

fn ready!() -> i32:
    1

fn drive() -> i32:
    let pending: mut Suspend[i32] = ready()
    block_on(pending)

fn plain() -> i32:
    1

fn cleanup_indirect() -> void:
    defer:
        _ := drive()
    pass

fn cleanup_plain() -> void:
    defer:
        _ := plain()
    pass
