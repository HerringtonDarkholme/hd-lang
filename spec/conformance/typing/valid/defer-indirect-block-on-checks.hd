# test: a deferred callback may reach block_on indirectly, and the call type-checks
use std.ops.defer
use std.task.block_on

fn ready!() -> i32:
    1

fn drive() -> i32:
    let pending: mut Suspend[i32] = ready()
    match block_on(pending):
        .Completed(value) => value
        _ => 0

fn plain() -> i32:
    1

fn cleanup_indirect() -> void:
    defer(fn() -> void: _ := drive())
    pass

fn cleanup_plain() -> void:
    defer(fn() -> void: _ := plain())
    pass
