# test: a default may call a dynamic trait method whose row is empty

trait Counter:
    fn next(mut self) -> i32

data Steps:
    count: i32

impl Counter for Steps:
    fn next(mut self) -> i32:
        self.count = self.count + 1
        self.count

fn advance(counter: mut Counter, step: i32 = counter.next()) -> i32:
    step
