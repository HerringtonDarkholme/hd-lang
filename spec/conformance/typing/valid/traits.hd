trait Describe:
    fn describe(self) -> string

data User:
    name: string

impl Describe for User:
    fn describe(self) -> string:
        self.name

impl Display for User:
    fn to_string(self) -> string:
        self.name

impl User:
    fn domain(self) -> string:
        self.name.split("@")[1]

fn show[T: Describe](value: T) -> string:
    value.describe()

fn dynamic_show(value: Describe) -> string:
    value.describe()
