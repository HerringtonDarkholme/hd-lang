# Spec 09 Traits: trait.impl.explicit, trait.inherent.decl, trait.bound.static, trait.dyn.form, trait.dyn.no-dyn.
trait Describe:
    fn describe(self) -> string

data User:
    name: string

impl Describe for User:
    fn describe(self) -> string:
        self.name

impl Display for User:
    fn to_string(self) -> string:
        self.name

impl User:
    fn domain(self) -> string:
        self.name.slice(1, self.name.len())

fn show[T < Describe](value: T) -> string:
    value.describe()

fn dynamic_show(value: dyn Describe) -> string:
    value.describe()
