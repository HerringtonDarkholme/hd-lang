# test: a member line's typed fact gets the fact type at the field's declared type as its expected type, so a generic function value needs no type argument
# Spec 14 Member-Typed Facts: annot.typed-fact.check; Member Lines: annot.line.typed
# (owner decisions FACT-EXPECTED, batch 38, and ANNOTATE-TYPED, batch 39, 2026-10-01).
use std.annotation.annotate
use std.structure.Structure

@annotate::[F](.Field)
data Fallback[F]:
    make: fn() -> F?

fn fallback[F](make: fn() -> F?) -> Fallback[F]:
    Fallback::[F] { make: make }

fn missing[T]() -> T?:
    .None

data Profile:
    name: string
    age: i32

impl Profile by Structure:
    name = [fallback(missing)]
    age += [fallback(missing)]
