# test: a call's dependent result depends on its source argument, so a function may return it
# Spec 13 Dependent Results: ref.dep.call, ref.dep.call.local; Origins: ref.dep.origin.call.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

fn forward(u: &User) -> &string:
    u.name()

fn twice(u: &mut User) -> &string:
    first := u.name()
    if first.len() > 3:
        return first
    forward(u)
