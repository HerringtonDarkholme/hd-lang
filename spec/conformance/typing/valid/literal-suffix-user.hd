# test: a library declares a suffix by marking a function @num_suffix
# Spec 05 Literal Suffixes: `12px` calls px(12).
use std.ops.num_suffix

data Pixels:
    count: i32

@num_suffix
fn px(count: i32) -> Pixels:
    Pixels { count: count }

fn indent() -> Pixels:
    24px  # px(24)

fn margin() -> Pixels:
    12px
