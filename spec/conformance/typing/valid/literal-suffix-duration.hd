# test: std.time suffixes build Duration values
# Spec std/time Duration Suffixes: `250ms` is `ms(250)`, a Duration, and the suffixes mix.
use std.time.{Duration, ms, s}

fn delay() -> Duration:
    250ms  # ms(250): Duration

fn rewind() -> Duration:
    -5s

fn both() -> List[Duration]:
    [5s, 250ms]

enum Tier(limit: Duration):
    Fast -> Tier(limit=250ms)
    Slow -> Tier(limit=5s)
