# test: an earlier annotation determines the method trait
trait Left:
    fn choose(self) -> i32

trait Right:
    fn choose(self) -> i32

struct Holder[T]:
    item: T

impl Left for Holder[i32]:
    fn choose(self) -> i32:
        +1

impl Right for Holder[string]:
    fn choose(self) -> i32:
        +2

fn unknown[T]() -> Holder[T]:
    panic("unused")

fn probe() -> void:
    let value: Holder[i32] = unknown()
    _ := value.choose()
    let fixed: Holder[i32] = value
