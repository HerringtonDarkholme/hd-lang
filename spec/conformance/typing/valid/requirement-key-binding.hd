# test: a bound requirement key works in rows, row aliases, row subsumption, and provider scopes, and a type alias of its trait value is a type
# Spec 11 Bound Requirement Keys: req.key.binding, req.key.binding.rows, req.key.binding.value.reference-values; req.row.alias.bound-key, req.row.alias.named-key, req.row.alias.type-alias.reference-values; req.with.type.binding.reference-values (owner decision AT5).

trait Store:
    type Item
    fn load(self, id: string) -> Self::Item

trait Log:
    fn write(self, line: string) -> void

struct User:
    name: string

struct UserStore: pass

impl Store for UserStore:
    type Item = User
    fn load(self, id: string) -> User: User { name: id }

type Users = &dyn Store[Item = User]

type UserRow = $ Store[Item = User]

type AppRow = $ Store[Item = User] + Log

fn lookup(store: Users, id: string) -> User:
    store.load(id)

fn find(id: string) -> User $ Store[Item = User]:
    lookup($.use(Store[Item = User]), id)

fn greet(id: string) -> string $ UserRow:
    find(id).name

fn handlers() -> List[fn(string) -> string $ AppRow]:
    [greet]

fn serve(id: string) -> string:
    $.with(Store[Item = User]=UserStore {}):
        greet(id)
