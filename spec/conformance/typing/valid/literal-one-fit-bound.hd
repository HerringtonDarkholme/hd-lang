# test: a literal argument whose bound exactly one integer type satisfies takes that type
# Spec 04 One Fitting Candidate: types.literal.local.join, types.literal.local.join (ONE-FIT).

trait Scale:
    fn scale(self) -> Self

impl Scale for i64:
    fn scale(self) -> i64:
        self * 2

fn grow[T < Scale](x: T) -> T:
    x.scale()

fn run() -> i64:
    let n: i64 = grow(5)
    n
