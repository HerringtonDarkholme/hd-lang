# test: a suffixed literal has the result type of its suffix function
# Spec 04 Suffixed Literals: `250ticks` is `ticks(250)`, a Millis.
use std.ops.num_suffix

struct Millis:
    count: i64

@num_suffix
fn ticks(count: i64) -> Millis:
    Millis { count: count }

fn delay() -> Millis:
    250ticks # ticks(250): Millis

fn both() -> List[Millis]:
    [5ticks, 250ticks]
