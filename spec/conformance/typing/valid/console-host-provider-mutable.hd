# test: prelude / Console / the host Console provider is mutable because write_sync takes &mut self
# Spec 10 Console and Runtime Profiles: module.console.host-trait, module.profile.trait-access-ref.reference-values.

pub fn main!() -> void $ Console:
    let mut console = $.use(Console)
    _ := console.write_sync("host capability\n")
    _ := $.use(Console).write_sync("direct call\n")
