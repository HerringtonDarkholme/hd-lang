# test: prelude / Console / the host Console provider is mutable because write_line! takes mut self
# Spec 10 Console and Runtime Profiles: module.console.host-trait, module.profile.trait-access.

pub fn main!() -> void $ Console:
    let mut console = $.use(Console)
    _ := console.write_line!("host capability")
    _ := $.use(Console).write_line!("direct call")
