use std.task.block_on

fn ready!() -> i32:
    42

fn drive_inside!() -> i32:
    let stored: mut Suspend[i32] = ready()
    stored!()

fn drive_outside() -> i32:
    let stored: mut Suspend[i32] = ready()
    match block_on(stored):
        .Completed(value) => value
        _ => 0

pub fn main() -> void:
    _ := drive_outside()

tests:
    it("test blocks drive suspensions"):
        value := ready!()
        _ := value
