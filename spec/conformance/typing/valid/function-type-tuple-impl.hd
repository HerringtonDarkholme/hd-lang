# test: one implementation over Fn[Args, O, $ R] with Args < Tuple covers every plain function type
# Spec 09 Traits: trait.target.function-type, trait.target.row-argument.
use std.function.{Fn, Tuple}

trait Describe:
    fn describe(self) -> string

impl[Args < Tuple, O, $R] Describe for Fn[Args, O, $ R]:
    fn describe(self) -> string:
        "function"
