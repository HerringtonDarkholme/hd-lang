# test: `box` infers `T` from its argument or from the expected type, and its `*mut T` weakens to `*T`, to an optional, and to a counted trait value
# Spec 13 Boxes: ref.box.signature, ref.box.check, ref.box.weaken; Conversions: ref.convert.weaken; Spec 09 Trait Value References: trait.dyn.ref.counted.new.
struct Point:
    x: i32

struct Slot:
    failure: *mut Option[string]

fn demo(p: Point) -> i32:
    made := box(p)
    let view: *Point = made
    let maybe: *Point? = box(Point { x: 2 })
    slot := Slot { failure: box(.None) }
    let shown: *dyn Display = box(+3)
    let edit: *mut dyn Display = box("text")
    view.x
