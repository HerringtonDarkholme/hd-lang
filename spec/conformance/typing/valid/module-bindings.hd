# Spec 03 Module and Execution Scope: names.category.module, names.module.file,
# names.module.declarations, names.module.well-typed,
# names.exec.scope, names.exec.visible, names.exec.access, names.exec.declarations,
# names.exec.methods.
let count = +0
label := "requests"

fn increment() -> void:
    count = count + 1

fn describe() -> string:
    "${label}: ${count}"

increment()
