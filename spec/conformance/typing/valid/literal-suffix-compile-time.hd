# test: a suffixed literal is accepted in shared enum data
# Spec 05 Literal Suffixes: there the call follows the rules for any call in that position.
use std.ops.num_suffix

struct Millis:
    count: i64

@num_suffix
fn ticks(count: i64) -> Millis:
    Millis { count: count }

enum Tier(limit: Millis):
    Fast -> Tier(limit=250ticks)
    Slow -> Tier(limit=5_000ticks)
