# test: context values a spread generic key and an entry of the same type parameter do not collide
trait Repo[T]

struct User: pass
struct Post: pass

fn choose[T](first: *dyn Repo[T], second: *dyn Repo[T]) -> void:
    base := $.context(Repo[T]=first)
    $.with(base..., Repo[T]=second):
        pass
