# test: every trait can be a dyn type; members that work dynamically stay callable
# Spec 09 Dynamic Safety: trait.dyn.any-trait, trait.dyn.member.other; Spec 04 Dynamic Safety: types.trait.dyn.any-trait.

trait Shape:
    fn area(self) -> f64
    fn same(self, other: Self) -> bool
    fn unit() -> Self

data Square:
    side: f64

impl Shape for Square:
    fn area(self) -> f64: self.side * self.side
    fn same(self, other: Square) -> bool: self.side == other.side
    fn unit() -> Square: Square { side: 1.0 }

fn total(shapes: List[dyn Shape]) -> f64:
    let sum = 0.0
    for shape in shapes:
        sum = sum + shape.area()
    sum

fn demo() -> f64:
    total([Square { side: 2.0 }, Square::unit()])
