# test: a typed fact at the field's declared type is the decorator's expected type, so a generic function value needs no type argument
# Spec 14 Member-Typed Facts: annot.typed-fact.check (owner decisions FACT-EXPECTED, batch 38, and ANNOTATE-TYPED, batch 39, 2026-10-01).
use std.annotation.annotate

@annotate::[F](.Field)
data Fallback[F]:
    make: fn() -> F?

fn fallback[F](make: fn() -> F?) -> Fallback[F]:
    Fallback::[F] { make: make }

fn missing[T]() -> T?:
    .None

data Profile:
    @fallback(missing)
    name: string
    @fallback(missing)
    age: i32
