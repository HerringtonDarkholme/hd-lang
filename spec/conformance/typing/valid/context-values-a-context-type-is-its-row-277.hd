# test: context values a context type is its row
pub trait Tag:
    fn name(self) -> string

pub trait Log:
    fn tag(self) -> string

struct Named:
    label: string

impl Tag for Named:
    fn name(self) -> string:
        self.label

impl Log for Named:
    fn tag(self) -> string:
        "log:" + self.label

fn current() -> string $ Tag:
    $.use(Tag).name()

fn both() -> string $ Tag + Log:
    $.use(Tag).name() + "," + $.use(Log).tag()

fn make() -> $.Context[$ Tag] $ Tag:
    base := $.context(Tag=$.use(Tag))
    $.context(base..., Tag=$.use(Tag))
