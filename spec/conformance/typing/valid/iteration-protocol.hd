# test: for and comprehensions accept Iterable values, including a mutable iterator
# Spec 06 Iteration Protocols: flow.for.iterable-only, flow.for.iterable-impls, flow.for.iterator-self (Chaining Study CS7).

fn consume(source: mut Iterator[i32]) -> List[i32]:
    [for value in source => value]

fn labels(entries: Map[string, i32]) -> List[string]:
    [for key, count in entries => "$key=$count"]

fn total(values: List[i32]) -> i32:
    let sum: i32 = 0
    for value in values:
        sum = sum + value
    sum
