# test: for and comprehensions accept Iterable values and a mutable iterator
# Spec 06 Iteration Protocols: flow.for.accepts, flow.for.iterable-collections,
# flow.for.iterable, flow.for.iterator-direct, flow.for.iterator-position,
# flow.for.list, flow.for.map.entries, flow.for.map.value
# (Chaining Study CS7, batch 24 IT2).

fn consume(source: mut Iterator[i32]) -> List[i32]:
    [for value in source => value]

fn labels(entries: Map[string, i32]) -> List[string]:
    [for (key, count) in entries => "$key=$count"]

fn total(values: List[i32]) -> i32:
    let sum = +0
    for value in values:
        sum = sum + value
    sum
