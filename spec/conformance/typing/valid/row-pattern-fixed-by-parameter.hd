# test: a row parameter fixed by another parameter leaves one unknown per pattern

trait Db

trait Clock

fn both[$R1, $R2](first: fn() -> void $ R1, second: fn() -> void $ R1 + R2) -> void $ R1 + R2:
    first()
    second()

fn read() -> void $ Db: pass

fn read_and_time() -> void $ Db + Clock: pass

fn run() -> void $ Db + Clock:
    both(read, read_and_time)
