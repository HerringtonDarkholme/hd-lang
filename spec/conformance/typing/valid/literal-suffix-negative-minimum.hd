# test: a negated suffixed literal is range-checked as a unit
# Spec 04 Suffixed Literals: the negated literal is checked against the suffix function's parameter type.
use std.ops.num_suffix

data Offset:
    value: i32

@num_suffix
fn off(value: i32) -> Offset:
    Offset { value: value }

fn lowest() -> Offset:
    -2147483648off
