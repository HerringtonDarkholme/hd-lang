# test: a negated suffixed literal is range-checked as a unit
# Spec 04 Suffixed Literals: the negated literal is checked against In.
use std.ops.LiteralSuffix

data Offset:
    value: i32

type off(i32)

impl LiteralSuffix[i32, Offset] for off:
    fn from_literal(n: i32) -> Offset:
        Offset { value: n }

fn lowest() -> Offset:
    -2147483648off
