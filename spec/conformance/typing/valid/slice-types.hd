# test: slice methods return string and list values with explicit offsets
fn parts(text: string, items: List[i32]) -> (string, string, List[i32], List[i32]):
    (text.slice(0, 3), text.slice(2, text.len()), items.slice(0, 2), items.slice(1, 3))

fn wide(text: string, n: u64) -> string:
    text.slice(0, usize(n))

fn head(items: List[i32]) -> List[i32]:
    items.slice(0, 1)

fn both(text: string, items: List[i32]) -> (string, List[i32]):
    (text.slice(0, 1), head(items))
