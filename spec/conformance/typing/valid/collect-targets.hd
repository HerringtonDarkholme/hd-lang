# test: collect builds the target that the expected type or an explicit list names, and defaults to List
# std Iterators, What Collect Builds: std-iter.adapter.collect-defaulted, std-iter.collect.expected, std-iter.collect.default, std-iter.collect.list, std-iter.collect.map-last, std-iter.collect.result, std-iter.collect.option (Collect CO1, CO5).

fn parse_port(text: string) -> Result[usize, string]:
    .Ok(text.len())

fn find_port(name: string) -> usize?:
    .Some(name.len())

fn index(names: List[string]) -> Map[string, usize]:
    names.iter().map(fn(name): (name, name.len())).collect()

fn parse_all(lines: List[string]) -> Result[List[usize], string]:
    lines.iter().map(parse_port).collect()

fn find_all(names: List[string]) -> List[usize]?:
    names.iter().map(find_port).collect()

fn count(values: List[i32]) -> usize:
    copied := values.iter().collect()
    copied.len()

fn explicit(names: List[string]) -> usize:
    by_name := names.iter().map(fn(name): (name, +1)).collect::[Map[string, i32]]()
    by_name.len()

fn propagated(lines: List[string]) -> Result[usize, string]:
    let ports: List[usize] = lines.iter().map(parse_port).collect()?
    .Ok(ports.len())
