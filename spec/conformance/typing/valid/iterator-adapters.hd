# test: the prelude Iterator has filter, take, enumerate, map, fold, and collect as ordinary methods
# std Iterators, Iterator Adapters: std-iter.adapter.trait-defaults, std-iter.adapter.filter.generic, std-iter.adapter.take.value, std-iter.adapter.enumerate.value, std-iter.adapter.map.generic, std-iter.adapter.fold.value, std-iter.adapter.fold.row, std-iter.adapter.collect.value-defaulted (STDLIB question 14, Chaining Study CS7).

trait Logger

fn logged(total: i32, value: i32) -> i32 $ Logger:
    total + value

fn first_evens(values: List[i32]) -> List[(usize, i32)]:
    values.iter().filter(fn(value): value % 2 == 0).enumerate().take(2).collect()

fn head(source: *mut dyn Iterator[i32]) -> List[i32]:
    source.take(2).collect()

fn through_value(source: *mut dyn Iterator[string]) -> *mut dyn Iterator[(usize, string)]:
    box(source.filter(fn(name): name.len() > 0).enumerate())

fn lengths(names: List[string]) -> *mut dyn Iterator[usize]:
    box(names.iter().map(fn(name): name.len()))

fn logged_sum(values: List[i32]) -> i32 $ Logger:
    values.iter().fold(0, logged)

fn step_once(source: &mut dyn Iterator[i32]) -> i32?:
    source.next()
