# test: a trait-less derivation block attaches member metadata of any type, read through the shape
use std.structure.Structure

data MinLen:
    value: i32

data MaxLen:
    value: i32

data Contains:
    text: string

fn min_len(value: i32) -> MinLen: MinLen { value: value }

fn max_len(value: i32) -> MaxLen: MaxLen { value: value }

fn contains(text: string) -> Contains: Contains { text: text }

fn email_metadata() -> List[Any]:
    [min_len(3), max_len(320), contains("@")]

data User:
    name: string

impl User by Structure:
    name = [min_len(1), max_len(80)]

user_shape := shape::[User]()
limit := user_shape.fields.name.metadata::[MaxLen]()
