struct Validation: pass

type Dict[K, V] = map[K, V]

struct Validator: pass

struct FieldValidator: pass

struct MaxLen:
    value: i32

fn max_len(value: i32) -> MaxLen: MaxLen { value: value }

impl FieldMetadata[string] for MaxLen

impl Annotation for Validation:
    type Info = Validator

impl StructAnnotator for Validation:
    type FieldTarget = FieldValidator

    fn map_field(
        self,
        field: FieldShape,
        type_metadata: AnnotationRef[Validator],
    ) -> FieldValidator:
        FieldValidator {}

    fn build(
        self,
        shape: StructShape,
        fields: Dict[string, FieldValidator],
    ) -> Validator:
        Validator {}

annotate Validation for string:
    fn build(self, shape: TypeShape) -> Validator:
        Validator {}

struct User:
    name: string

annotate User:
    name = [max_len(80)]

annotate Validation for User: pass

validator := Validation::annotation(User)
user_shape := shape(User)
