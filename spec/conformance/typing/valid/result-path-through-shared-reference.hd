# test: a result path may cross a `*T` field, and the caller locks only that path
# Spec 13 Result Paths: ref.result.path.counted.
struct User:
    name: string

struct Team:
    lead: *User
    size: i32

fn lead_name(t: &Team) -> &'t.lead.name string:
    &t.lead.name

fn grow(t: &mut Team) -> void $ Console:
    n := lead_name(t)
    t.size += 1
    println(*n)
