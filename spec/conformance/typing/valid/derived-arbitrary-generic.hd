# test: derived Arbitrary on a generic type bounds each type parameter a member uses by Arbitrary
# Spec std/testing Derived Arbitrary: std-testing.arbitrary.derive.params-arbitrary (owner decisions AT-gen, batch 26, and O7-inspectable, batch 51).
use std.testing.Arbitrary

@derive(Arbitrary, Debug)
data Box[T]:
    value: T

fn needs[T < Arbitrary](value: T) -> T: value

fn check(item: Box[i32]) -> Box[i32]:
    needs(item)
