# test: let mut binds a `&mut` reference to a new object, a copy-update, or a call result
struct User:
    name: string

fn fresh() -> &mut User:
    &mut User { name: "Lin" }

fn edit(user: &User) -> string:
    let mut draft = &mut User { name: "Ada" }  # mut User
    draft.name = "Grace"
    let mut copy = &mut User { ...*user }       # a fresh copy
    copy.name = "Grace"
    let mut made = fresh()
    made.name = draft.name
    let mut redundant: &mut User = &mut User { name: "Kay" }
    redundant.name = made.name
    copy.name
