# test: the checker reads a projection through a trait value as its bound type
# Rules: trait.dyn.member.other-with-opaque, trait.dyn.binding.signatures, trait.dyn.bound.reference-dispatch.
trait Lookup:
    type Key
    type Value
    fn find(self, key: Self::Key) -> Self::Value?
    fn keys(self) -> List[Self::Key]

struct PhoneBook:
    names: List[string]
    numbers: List[i32]

impl Lookup for PhoneBook:
    type Key = string
    type Value = i32
    fn find(self, key: string) -> i32?:
        for index in 0..self.names.len():
            if self.names[index] == key:
                return .Some(self.numbers[index])
        .None
    fn keys(self) -> List[string]:
        self.names

struct Squares:
    size: i32

impl Lookup for Squares:
    type Key = i32
    type Value = string
    fn find(self, key: i32) -> string?:
        if key < self.size:
            return .Some("${key * key}")
        .None
    fn keys(self) -> List[i32]:
        let mut out: List[i32] = []
        for k in 0..self.size:
            out.push(k)
        out

fn number(book: &dyn Lookup[Key = string, Value = i32], name: string) -> i32:
    book.find(name).unwrap_or(0)

struct Pair[K]:
    key: K

impl[K] Lookup for Pair[K]:
    type Key = K
    type Value = K
    fn find(self, key: K) -> K?:
        .Some(self.key)
    fn keys(self) -> List[K]:
        [self.key]

fn numbers(book: &dyn Lookup[Key = string, Value = i32]) -> void:
    pass

fn same(pair: &dyn Lookup[Key = i32, Value = i32]) -> void:
    pass

pub fn main() -> void:
    _ := number(&PhoneBook { names: ["ada"], numbers: [1] }, "ada")
    numbers(&PhoneBook { names: [], numbers: [] })
    same(&Pair { key: 1 })
