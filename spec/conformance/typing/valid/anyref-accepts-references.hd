# test: `T < AnyRef` accepts `*T`, `*mut T` and trait value references; `T < AnyVal` accepts a struct
# Spec 04 AnyVal And AnyRef: types.sealed.anyref-members.counted, types.sealed.anyval-members. Spec 13 Reference Types: ref.type.any-ref, ref.type.dyn.
trait Shape:
    fn area(&self) -> f64

struct Point:
    x: f64

impl Shape for Point:
    fn area(&self) -> f64:
        self.x

fn keep[T < AnyRef](value: T) -> T:
    value

fn copy[T < AnyVal](value: T) -> T:
    value

fn same[T < AnyRef](a: T, b: T) -> bool:
    a is b

fn check() -> bool:
    p := box(Point { x: 1.0 })
    let shared: *Point = p
    _ := keep(shared)
    _ := keep(p)
    let shape: *dyn Shape = p
    _ := keep(shape)
    _ := copy(Point { x: 2.0 })
    same(shape, keep(shape))
