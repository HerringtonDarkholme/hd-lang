use std.structure.Structure

type UserId(string)
type PostId(string)

data RetentionRule: pass
data DeleteWhen: pass

fn retention_owner(target: DataShape) -> RetentionRule:
    RetentionRule {}

fn delete_when(target: FieldShape) -> DeleteWhen:
    DeleteWhen {}

data User:
    id: UserId
    deleted: bool

data Post:
    id: PostId
    userId: UserId

impl Post by Structure:
    userId = [retention_owner(shape::[User]()), delete_when(shape::[User]().fields.deleted)]
