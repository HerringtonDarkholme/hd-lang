use std.structure.Structure

type UserId(string)
type PostId(string)

data RetentionRule: pass
data DeleteWhen: pass

fn retention_owner(owner: string) -> RetentionRule:
    RetentionRule {}

fn delete_when(deleted: fn(User) -> bool) -> DeleteWhen:
    DeleteWhen {}

data User:
    id: UserId
    deleted: bool

data Post:
    id: PostId
    userId: UserId

fn user_deleted(user: User) -> bool:
    user.deleted

impl Post by Structure:
    userId = [retention_owner("User"), delete_when(user_deleted)]
