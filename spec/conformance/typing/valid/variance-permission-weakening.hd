# Spec 04 Variance: types.assign.variance, types.generic.sharing,
# types.variance.markers, types.polarity, types.polarity.positive,
# types.polarity.both, types.variance.unmarked,
# types.variance.readonly-only, types.variance.mut-invariant,
# types.variance.repr.covariant, types.variance.repr.contravariant,
# types.variance.repr.weakening, types.variance.no-insertion.
data User:
    name: string

data Producer[+T]:
    produce: fn() -> T

data Consumer[-T]:
    consume: fn(T) -> void

data Cell[T]:
    value: T

fn readonly(value: Producer[mut User]) -> Producer[User]:
    value

fn strengthen(value: Consumer[User]) -> fn(mut User) -> void:
    let converted: Consumer[mut User] = value
    converted.consume
