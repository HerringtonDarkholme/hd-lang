# test: member on a concrete walker stays silent
use std.structure.{Field, Variant, Walker}

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        .Ok(())

fn run(h: Field[i64, i64]) -> void:
    let mut w = Prober { out: "" }
    _ := w.member(h, 1)
