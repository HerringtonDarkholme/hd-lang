# test: a call through a function type nested in another type accepts an argument that outlives the lifetime it writes
# Spec 07 Function Types: fn.type.lifetime.call.written. The valid
# counterparts of each nested form: the argument is the caller's `p`, or
# the nested function type writes no lifetime.
struct Point:
    x: i32

fn nested['a, T](f: fn(&'a Point) -> fn(&'a Point) -> T, p: &'a Point) -> T:
    f(p)(p)

fn nested_unwritten['a, T](f: fn(&'a Point) -> fn(&Point) -> T, p: &'a Point) -> T:
    q := Point { x: 1 }
    f(p)(&q)

fn in_tuple['a, T](t: (fn(&'a Point) -> T, fn(&Point) -> T), p: &'a Point) -> T:
    q := Point { x: 1 }
    (t._0)(p)
    (t._1)(&q)

fn in_list['a, T](fs: &List[fn(&'a Point) -> T], p: &'a Point) -> T:
    fs[0](p)

fn in_option['a, T](o: (fn(&'a Point) -> T)?, p: &'a Point, d: T) -> T:
    match o:
        .Some(g) => g(p)
        .None => d
