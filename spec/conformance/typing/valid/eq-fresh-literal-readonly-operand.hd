# test: == between a Date value and a Date literal calls Eq.eq, on either side
# Spec Expressions, Equality: expr.eq.calls-eq.
struct Date:
    year: i32

impl Eq for Date:
    fn eq(self, other: Self) -> bool:
        self.year == other.year

fn is_launch(d: Date) -> bool:
    d == Date { year: 2026 }

fn not_launch(d: Date) -> bool:
    Date { year: 2026 } != d
