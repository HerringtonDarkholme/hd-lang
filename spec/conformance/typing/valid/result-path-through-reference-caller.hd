# test: a call whose result path crosses a `*mut` field leaves the rest of the argument writable
# Spec 13 Result Paths: ref.result.path.counted.
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User
    size: i32

fn lead_name(t: &Team) -> &'t.lead.name string:
    &t.lead.name

fn grow(t: &mut Team) -> void $ Console:
    n := lead_name(t)
    t.size += 1
    println(*n)
