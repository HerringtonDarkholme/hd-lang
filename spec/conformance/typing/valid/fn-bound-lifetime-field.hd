# test: a struct field of a type parameter bounded by the struct's lifetime holds a closure that captures a local reference
# Spec 13 Lifetime Bounds: ref.generic.outlives, ref.generic.outlives.field, ref.generic.outlives.position; Spec 07 Static Fn Bounds: fn.trait.bound-sugar.next-bound.
use std.function.Fn

struct Counter:
    n: i32

struct Button[F < Fn() -> void & 'a, 'a]:
    on_click: F

fn press[F < Fn() -> void & 'a, 'a](b: &Button[F, 'a]) -> void:
    (b.on_click)()

fn handler[F < Fn() -> void & 'a, 'a](b: Button[F, 'a]) -> F:
    b.on_click

fn run(c: &mut Counter) -> i32:
    b := Button { on_click: fn(): c.n += 1 }
    press(&b)
    f := handler(b)
    f()
    c.n
