# test: a callable value reads with v() and stores with v() = x through Apply and Update
# Spec 05 Callable Values: expr.call.apply.read, expr.call.apply.write, expr.call.apply.field, expr.assign.compound.call-read-write (Call Indexing D1, D2, D4).
use std.ops.{Apply, Update}

data Cell[T]:
    value: T

impl[T] Apply for Cell[T]:
    type Out = T
    fn apply(self) -> T: self.value

impl[T] Update[T] for Cell[T]:
    fn update(mut self, value: T) -> void:
        self.value = value

fn live[T](value: T) -> mut Cell[T]:
    Cell { value: value }

data Panel:
    count: mut Cell[i32]

fn read[C < Apply](source: C) -> C::Out:
    source()

fn parent(panel: mut Panel) -> string:
    let mut count = live(0)
    count() = 1
    count() += 1
    (panel.count)() += 1
    view := live(5)
    total := view() + read(count)
    badge(count) + " ${total}"

fn badge(count: Cell[i32]) -> string:
    "clicked ${count()}"
