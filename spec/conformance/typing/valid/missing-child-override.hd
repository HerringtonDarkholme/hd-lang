data Validation: pass
data Validator: pass
data FieldValidator: pass
data Opaque: pass

impl Annotation for Validation:
    type Info = Validator

impl TypeAnnotator for Validation:
    fn build(self, target: TypeShape) -> Validator:
        panic("exact annotation supplies build")

impl DataAnnotator for Validation:
    type FieldTarget = FieldValidator

    fn map_field(
        self,
        field: FieldShape,
        type_metadata: AnnotationRef[Validator],
    ) -> FieldValidator:
        FieldValidator {}

    fn build(
        self,
        target: DataShape,
        fields: list[(string, FieldValidator)],
    ) -> Validator:
        Validator {}

annotate Validation for i32:
    fn build(self, target: TypeShape) -> Validator: Validator {}

data Record:
    count: i32
    opaque: Opaque

annotate Validation for Record:
    opaque = FieldValidator {}

validator := Validation::annotation(Record)
