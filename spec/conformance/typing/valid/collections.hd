data User:
    id: string
    name: string
    active: bool

data Entry:
    name: string
    score: i32

data Link:
    id: string
    owner_id: string

fn collections(users: List[User]) -> Map[string, User] $ Console:
    empty := ()
    single := (1,)
    point := (10, 20)
    let (x, y) = point
    entry := Entry { name: "Ada", score: 10 }
    let (entry_name, score) = (entry.name, entry.score)
    scores := {"Ada": 10, "Grace": 12}
    names := [for user in users if user.active => user.name]
    sizes := [
        for user in users
        if (size := user.name.len()) > 0
        => size
    ]
    pairs := [for left in names for right in sizes => (left, right)]
    by_id := {for user in users if user.active => user.id: user}
    println("$x,$y")
    println("${entry_name}${score}")
    _ := empty
    _ := single
    by_id

fn apply_all(values: List[i32], transform: fn(i32) -> i32) -> List[i32]:
    [for value in values => transform(value)]

fn doubled_counts(counts: List[i32]) -> List[i32]:
    doubled := apply_all(counts, fn(count): count * 2)
    doubled

fn related(xs: List[Link], ys: List[Link]) -> List[(Link, Link)]:
    [for x in xs for y in ys if x.id == y.owner_id => (x, y)]
