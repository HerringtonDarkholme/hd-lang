# Spec 08 Data Literals and Copy-Update Literals: data.literal.form, data.update.spread.
data User:
    id: string
    display_name: string

fn rename(user: User, name: string) -> User:
    User {
        ...user,
        display_name: name,
    }

user := User {
    id: "user-1",
    display_name: "Ada",
}
