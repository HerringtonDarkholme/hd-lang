# test: an embedded type's trait method is ignored beside another embedded type's inherent method, which is promoted
trait Describe:
    fn describe(self) -> string

data Label:
    text: string

impl Describe for Label:
    fn describe(self) -> string:
        self.text

data Badge:
    code: string

impl Badge:
    pub fn describe(self) -> string:
        self.code

data Page:
    Label
    Badge

fn valid(page: Page) -> string:
    page.describe()
