# test: a bare ^ in a result takes a ^self receiver's lifetime or the one borrowed parameter's
data Conn:
    fd: i32

data Document:
    lines: List[string]

data Parser[^doc]:
    source: ^{doc} Document
    at: usize

data Pool:
    size: usize

impl Pool:
    fn peek(^self, other: ^Conn) -> ^Conn: panic("stub")

fn only(c: ^Conn, n: usize) -> ^Conn: panic("stub")

fn optional(c: ^Conn) -> Option[^Conn]: panic("stub")

fn through(p: Parser[^]) -> ^Document: panic("stub")

pub fn main() -> void:
    pass
