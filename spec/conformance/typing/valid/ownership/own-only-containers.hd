# test: lists, map values, optionals and tuples of borrowed values own nothing, and a container may be borrowed
data Conn:
    fd: i32

impl OwnOnly for Conn

fn pool(xs: ^List[^Conn]) -> void: pass

fn plain(xs: List[i32]) -> void: pass

fn by_name(m: ^mut Map[string, ^Conn]) -> void: pass

fn first(c: ^Conn?) -> void: pass

fn pair(p: (^Conn, i32)) -> void: pass

pub fn main() -> void:
    pass
