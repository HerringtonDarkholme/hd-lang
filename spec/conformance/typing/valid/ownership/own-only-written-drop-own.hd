# test: a written impl OwnOnly for every instance lets DropOwn cover every instance
data Tracked[T]:
    value: T

impl[T] OwnOnly for Tracked[T]

impl[T] DropOwn for Tracked[T]:
    fn drop(^mut self) -> void: pass

fn count(value: ^Tracked[i32]) -> void: pass

fn reset(value: ^mut Tracked[string]) -> void: pass

pub fn main() -> void:
    pass
