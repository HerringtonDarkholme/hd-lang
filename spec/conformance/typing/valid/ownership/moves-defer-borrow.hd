# test: a defer over a shared view keeps the owner usable
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

fn inspect(file: ^File) -> void:
    _ := size(file)

fn borrowed_cleanup() -> void:
    file := open("input")
    let view: ^File = file
    defer: inspect(view)
    inspect(file)

fn last_cleanup() -> void:
    file := open("input")
    inspect(file)
    defer: archive(file)

pub fn main() -> void:
    pass
