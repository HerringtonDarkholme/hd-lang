# test: every use of an OwnOnly type writes ^ or ^mut, and an OwnOnly holder may have ^mut fields
data File:
    fd: i32

impl OwnOnly for File

impl DropOwn for File:
    fn drop(^mut self) -> void: pass

impl File:
    fn peek(^self) -> usize: 0
    fn reset(^mut self) -> void: pass

data Pool[^a]:
    idle: List[^{a} File]
    first: ^{a} mut File?

impl[^a] OwnOnly for Pool[^{a}]

data Writer[^out]:
    out: ^{out} mut File

impl[^out] OwnOnly for Writer[^{out}]

fn size(f: ^File) -> usize: 0

fn adopt(pool: ^mut Pool[^], f: ^File) -> void: pass

fn writer(f: ^mut File) -> ^Writer[^]: panic("stub")

pub fn main() -> void:
    pass
