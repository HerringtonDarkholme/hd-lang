# test: an instance of a type that implements OwnOnly by structure owns only when a field's type owns
use std.structure.Structure

data Conn:
    fd: i32

impl OwnOnly for Conn

data Batch[T]:
    values: List[T]

impl[T] OwnOnly for Batch[T] by Structure

@derive(OwnOnly)
enum Outcome[A, B]:
    Good(value: A)
    Bad(error: B)

@derive(OwnOnly)
data Chain[T]:
    value: T
    next: Chain[T]?

fn sum(batch: Batch[i32]) -> i32: 0

fn settle(result: Outcome[i32, string]) -> void: pass

fn walk(chain: ^Chain[^Conn]) -> void: pass

fn count(chain: Chain[i32]) -> i32: 0

pub fn main() -> void:
    pass
