# test: a record with an owned and a borrowed field is built from an owned local and a borrowed parameter
data File:
    fd: i32

impl OwnOnly for File

data Document:
    lines: List[string]

data Export[^doc]:
    out: own File
    source: ^{doc} Document

impl[^doc] OwnOnly for Export[^{doc}]

fn open(path: string) -> own File: File { fd: 3 }

fn check(f: ^File) -> bool: f.fd > 0

fn prepare(d: ^Document) -> own Export[^{d}]:
    out := open("out")
    check(out)
    Export { out: out, source: d }

pub fn main() -> void:
    pass
