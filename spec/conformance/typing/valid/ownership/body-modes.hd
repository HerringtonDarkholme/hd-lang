# test: places are lent to borrowed positions, and a plain place with a mut view is lent mutably
data File:
    fd: i32

impl File:
    fn size(^self) -> i32: self.fd
    fn reset(^mut self) -> void:
        self.fd = 0

data Buffer:
    bytes: List[u8]
    label: string

fn open(path: string) -> mut File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn fill(b: ^mut Buffer) -> void:
    b.label = "full"

fn report() -> i32:
    let f: mut File = open("app.log")
    n := size(f)
    f.reset()
    n + f.size()

fn buffers() -> string:
    let plain: mut Buffer = Buffer { bytes: [1], label: "old" }
    fill(plain)
    let view: ^Buffer = plain
    view.label

pub fn main() -> void:
    pass
