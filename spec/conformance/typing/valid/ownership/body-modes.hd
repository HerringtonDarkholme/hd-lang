# test: owned values stay owned, places are lent to borrowed positions, and fresh values become owned
data File:
    fd: i32

impl OwnOnly for File

impl File:
    fn size(^self) -> i32: self.fd
    fn reset(^mut self) -> void:
        self.fd = 0

data Buffer:
    bytes: List[u8]
    label: string

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

fn fill(b: ^mut Buffer) -> void:
    b.label = "full"

fn report() -> i32:
    f := open("app.log")
    n := size(f)
    f.reset()
    archive(f)
    n

fn buffers() -> string:
    let own buf = Buffer { bytes: [], label: "new" }
    fill(buf)
    let plain: mut Buffer = Buffer { bytes: [1], label: "old" }
    fill(plain)
    let view: ^Buffer = plain
    view.label

pub fn main() -> void:
    pass
