# test: a shared borrow, an unused argument, and a function type own nothing by structure
data Conn:
    fd: i32

@derive(OwnOnly)
data View[T, ^a]:
    value: ^{a} T

@derive(OwnOnly)
data Token[T]:
    id: usize

@derive(OwnOnly)
data Factory[T]:
    make: fn() -> T

fn views(v: View[own Conn, ^]) -> void: pass

fn tokens(t: Token[own Conn]) -> void: pass

fn makers(f: Factory[own Conn]) -> void: pass

pub fn main() -> void:
    pass
