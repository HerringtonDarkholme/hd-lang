# test: lending an owned local and reading its fields do not move it
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

data Holder:
    file: own File
    count: i32

impl OwnOnly for Holder

impl File:
    fn peek(^self) -> i32: self.fd
    fn reset(^mut self) -> void:
        self.fd = 0
    fn close(own self) -> void: pass

fn total(h: own Holder) -> i32:
    n := size(h.file) + h.count
    h.count = n
    h.file.reset()
    size(h.file) + h.count

fn use_then_close() -> i32:
    f := open("app.log")
    n := size(f) + f.peek() + f.fd
    f.reset()
    f.close()
    n

pub fn main() -> void:
    pass
