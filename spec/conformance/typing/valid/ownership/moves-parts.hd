# test: an owned value moves into a plain field of a construction that becomes owned, and into a plain field of an owned value
data Buffer:
    bytes: List[u8]
    label: string

data Frame:
    buffer: Buffer
    seq: i32

fn read_bytes() -> own List[u8]: [1, 2]

fn load() -> own Buffer:
    xs := read_bytes()
    Buffer { bytes: xs, label: "owned" }

fn wrap() -> i32:
    xs := read_bytes()
    let own frame = Frame { buffer: Buffer { bytes: xs, label: "inner" }, seq: 1 }
    frame.seq

fn refill(b: own Buffer) -> void:
    xs := read_bytes()
    b.bytes = xs

pub fn main() -> void:
    pass
