# test: fields read through a borrow: a ^mut borrow gives mutable access to mut fields, a shared borrow readonly access
data File:
    fd: i32
    name: string

impl OwnOnly for File

data Buffer:
    bytes: List[u8]
    label: string

data Session:
    buffer: mut Buffer
    count: i32

fn size(f: ^File) -> i32: f.fd

fn rename(f: ^mut File) -> void:
    f.name = "renamed"

fn label(b: ^Buffer) -> string: b.label

fn read(s: ^Session) -> i32:
    b := s.buffer
    n := label(b).len()
    s.count

fn write(s: ^mut Session) -> void:
    s.count = 2
    s.buffer = Buffer { bytes: [], label: "fresh" }
    s.buffer.label = "again"

pub fn main() -> void:
    pass
