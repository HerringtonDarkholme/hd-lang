# test: recursive and mutually recursive types own only through an owning part
data Conn:
    fd: i32

@derive(OwnOnly)
data Tree[T]:
    kids: Forest[T]

@derive(OwnOnly)
data Forest[T]:
    trees: List[Tree[T]]
    leaf: T?

@derive(OwnOnly)
data Nest[T]:
    deeper: Nest[List[T]]?
    here: T

fn plain_tree(t: Tree[i32], f: Forest[string], n: Nest[i32]) -> void: pass

fn owned_tree(t: own Tree[own Conn], n: own Nest[own Conn]) -> void: pass

pub fn main() -> void:
    pass
