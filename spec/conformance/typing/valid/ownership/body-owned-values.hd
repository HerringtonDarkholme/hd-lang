# test: owned values come from fresh values, own results, parameters and locals, and receivers follow parameters
data File:
    fd: i32

impl OwnOnly for File

impl File:
    fn size(^self) -> i32: self.fd
    fn close(own self) -> void: pass

data Buffer:
    bytes: List[u8]
    label: string
    count: i32

fn open() -> own File: File { fd: 3 }

fn archive(f: own File) -> void: pass

fn keep(f: own File) -> own File: f

fn first(f: own File) -> own File?: f

fn pair(f: own File) -> (own File, i32): (f, 1)

fn fresh() -> own Buffer:
    Buffer { bytes: [1, 2], label: "fresh", count: 0 }

fn locals() -> void:
    f := keep(open())
    let g: own File = open()
    let own b: Buffer = Buffer { bytes: [], label: "b", count: 1 }
    let own c = fresh()
    b.count = c.count
    f.close()
    archive(g)
    File { fd: 4 }.close()

fn plain_stays_plain() -> Buffer:
    b := Buffer { bytes: [], label: "plain", count: 0 }
    b

pub fn main() -> void:
    pass
