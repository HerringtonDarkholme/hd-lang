# test: parameters and receivers take modes, and a function type's parameter takes one too
data File:
    fd: i32

trait Socket:
    fn send(^mut self, bytes: List[u8]) -> void
    fn peer(^self) -> string

impl File:
    fn peek(^self) -> usize: 0
    fn reset(^mut self) -> void: pass

fn size(f: ^File) -> usize: 0

fn fill(buf: ^mut List[u8]) -> void: pass

fn job(run: ^fn() -> void) -> void: pass

fn visit(files: List[File], each: fn(^File) -> void) -> void: pass

fn serve(s: ^mut dyn Socket) -> void: pass

pub fn main() -> void:
    pass
