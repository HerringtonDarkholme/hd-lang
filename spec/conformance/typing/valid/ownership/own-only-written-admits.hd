# test: a written impl OwnOnly for every instance admits owned arguments, and an owned field owns every instance by structure
data File:
    fd: i32

impl OwnOnly for File

data Tracked[T]:
    value: T

impl[T < own Any] OwnOnly for Tracked[T]

impl[T < own Any] DropOwn for Tracked[T]:
    fn drop(^mut self) -> void: pass

data OwnershipTag:
    id: i32

impl OwnOnly for OwnershipTag

@derive(OwnOnly)
data TaggedTracked[T]:
    value: T
    tag: own OwnershipTag

impl[T < own Any] DropOwn for TaggedTracked[T]:
    fn drop(^mut self) -> void: pass

fn receive(value: own Tracked[own File]) -> void: pass

fn count(value: ^Tracked[i32]) -> void: pass

fn wrap(value: own TaggedTracked[own File]) -> void: pass

fn tag(value: own TaggedTracked[i32]) -> void: pass

pub fn main() -> void:
    pass
