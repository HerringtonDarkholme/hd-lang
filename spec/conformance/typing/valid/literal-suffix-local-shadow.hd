# test: a literal suffix resolves in module scope only
# Spec 03 Literal Suffix Names: a parameter named `secs` does not change what `5secs` calls.
use std.ops.num_suffix

@num_suffix
fn secs(count: i64) -> i64:
    count * 1000

fn retry_after(secs: i32) -> i32:
    limit := 5secs # the module'secs suffix function secs, not the parameter
    secs
