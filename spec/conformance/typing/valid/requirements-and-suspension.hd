# Spec 11 Requirement Model And Syntax: req.model.one-shot,
# req.model.not-capability, req.model.errors, req.model.lookup-no-suspend,
# req.model.suspend-no-errors, req.model.no-provider-choice,
# req.model.never-reinterpreted, req.row.definition, req.row.parameter,
# req.row.syntax.signature, req.row.syntax.plus-list,
# req.row.syntax.single-bare, req.row.syntax.same-form, req.row.syntax.empty,
# req.row.callable.impl-agrees, req.use.context, req.use.value.ordinary,
# req.use.value.access, req.use.namespace, req.use.namespace.keys,
# req.context.row, req.context.create, req.context.spread,
# req.context.spread.suffix, req.suspend.marker, req.suspend.two-forms,
# req.suspend.type.equivalent, req.suspend.type.spellings,
# req.suspend.type.plain-call, req.suspend.type.bang, req.bang.suffix,
# req.bang.not-negation, req.bang.driver-contexts,
# req.bang.requirements-not-suspending.
trait Database:
    fn get_user!(self, id: string) -> Result[User?, DbError]

trait Logger:
    fn write(self, message: string) -> void

trait Cache
trait Metrics

fn keep_waker(waker: Waker) -> Waker:
    waker

data User:
    id: string

data UserId:
    value: string

data DbError:
    message: string

data MockDatabase: pass
data ConsoleLogger: pass

impl Database for MockDatabase:
    fn get_user!(self, id: string) -> Result[User?, DbError]:
        .Ok(.None)

impl Logger for ConsoleLogger:
    fn write(self, message: string) -> void: pass

fn load_user!(id: string) -> Result[User?, DbError] $ Database:
    db := $.use(Database)
    db.get_user!(id)

fn fetch_user!(id: UserId) -> Result[User, DbError]:
    panic("fixture has no user source")

fn demo!() -> Result[User?, DbError] $ Cache:
    $.with(Database=MockDatabase {}):
        load_user!(UserId { value: "user_123" }.value)

fn prod_context(metrics: dyn Metrics, cache: dyn Cache) -> $.Context[$ Metrics + Cache]:
    $.context(Metrics=metrics, Cache=cache)

fn consume!(loader: fn!(string) -> Result[User?, DbError] $ Database) -> void $ Database:
    _ := loader!("user-1")
    pass

fn provide_logger[$R](callback: fn(string) -> void $ R + Logger) -> void $ R:
    $.with(Logger=ConsoleLogger {}):
        callback("message")

fn log_message(message: string) -> void $ Logger:
    logger := $.use(Logger)
    logger.write(message)

fn transform[T, U, $R](items: List[T], f: fn(T) -> U $ R) -> List[U] $ R:
    [for item in items => f(item)]

loader := fn!(id: string) -> Result[User?, DbError] $ Database:
    load_user!(id)

pub fn main!() -> void:
    mock_database := MockDatabase {}
    context := $.context(Database=mock_database)
    $.with(context...):
        let pending: mut Suspend[Result[User?, DbError]] = loader("user-1")
        _ := pending!()
        _ := loader!("user-1")

    provide_logger(log_message)
