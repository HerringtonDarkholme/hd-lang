# test: reference types in every position, `&` of any binding, `&mut` of writable places, conversions from `&mut T` to `&T`, and reads through a read-only reference
# Spec 13 Reference Types: ref.type.position, ref.type.distinct. Places And New Objects: ref.place.forms, ref.expr.kind.counted. Writable Places Of References: ref.place.shared-any, ref.place.writable.
# Spec 13 Conversions: ref.convert.weaken. Reading Through A Reference: ref.read.shallow, ref.read.shallow, ref.read.shallow.
struct User:
    name: string

struct Inner:
    lead: *mut User

struct Outer:
    inner: Inner
    hook: fn() -> void

fn first(items: List[*User]) -> *User?:
    if items.len() > 0:
        .Some(items[0])
    else:
        .None

fn names(o: &Outer) -> string:
    (o.hook)()
    o.inner.lead.name

fn view(u: &User) -> string:
    u.name

fn shared(count: i32) -> i32:
    fixed := +1
    let total = +2
    a := &count
    b := &fixed
    c := &total
    *a + *b + *c

fn writable(mut p: User) -> string:
    let mut u = User { name: "ann" }
    let r: &mut User = &mut u
    let s: &User = r
    q := &mut p
    view(r) + view(s) + q.name
