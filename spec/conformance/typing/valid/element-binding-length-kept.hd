# test: element stores and reads, and a store of the referenced map key, keep an element reference valid, and a length change after its last use is valid
# Spec 13 Call-Scoped Access: ref.elem.access.length, ref.elem.access.mut.
fn scores() -> i32:
    let mut xs = [+1, 2]
    first := &mut xs[0]
    xs[1] = 5
    *first += xs[1]
    xs.push(3)
    xs[0]

fn stock() -> i32:
    let mut m: Map[string, i32] = { "apple": 3 }
    apples := &mut m["apple"]
    m["apple"] = 4
    *apples += 1
    m["pear"] = 1
    m["apple"]
