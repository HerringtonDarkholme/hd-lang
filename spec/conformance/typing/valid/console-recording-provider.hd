# test: prelude / Console / a provider records lines because write_sync takes &mut self
# Spec 10 Console: write_sync takes &mut self, so Console is a mutable requirement trait
# and printing code still writes $ Console.

struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

fn greet() -> void $ Console:
    println("hello")

pub fn main() -> void:
    console := box(MemoryConsole { lines: [] })
    $.with(Console=console):
        greet()
