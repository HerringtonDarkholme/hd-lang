# test: prelude / Console / a provider records lines because write! takes &mut self
# Spec 10 Console: write! takes &mut self, so Console is a mutable requirement trait
# and printing code still writes $ Console.

struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

fn greet() -> void $ Console:
    println("hello")

pub fn main() -> void:
    let mut console = MemoryConsole { lines: [] }
    $.with(Console=&mut console):
        greet()
