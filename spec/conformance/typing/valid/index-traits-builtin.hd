# test: generic code indexes List and string through Index and IndexSet bounds
# Spec 05 Built-In Implementations: expr.index.std.list.places, expr.index.std.string.usize (Strings STR8).
use std.ops.{Index, IndexSet}

fn first[T, C < Index[usize, Out = T]](items: C) -> T:
    items[0]

fn reset[C < IndexSet[usize, i32]](items: &mut C) -> void:
    items[0] = 0

fn lead(counts: &mut List[i32], text: string) -> u8:
    reset(counts)
    first(text)
