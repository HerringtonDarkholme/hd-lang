fn first_large(values: List[i32]) -> i32?:
    for value in values:
        if value > 100:
            break value
    else:
        .None

fn label(score: i32) -> string:
    if score >= 90:
        "excellent"
    else if score >= 70:
        "passing"
    else:
        "needs work"

fn first_prefix(names: List[string], prefix: string) -> string?:
    let index: i32 = 0
    while index < names.len():
        if names[index].starts_with(prefix):
            break names[index]
        index = index + 1
    else:
        .None
