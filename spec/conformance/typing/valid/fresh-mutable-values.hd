# Spec 13 Places And New Objects: ref.expr.allocate, ref.expr.allocate.writable.
struct User:
    name: string

fn rename(user: &mut User) -> void:
    user.name = "Grace"

fn new_mutable_user() -> *mut User:
    &mut User { name: "Ada" }

fn valid() -> void:
    rename(&mut User { name: "Ada" })
    rename(new_mutable_user())
