# test: Any? takes a bare .None, never erases to Any, and mut Any keeps mutable access to a composite value
# Spec 09 Any: trait.any.never, trait.any.none, trait.any.mut; Generic Bounds: trait.bound.mut-any.
data Settings:
    theme: string

fn missing_setting() -> Any?:
    let setting: Any? = .None
    setting

fn fail_setting() -> Any:
    panic("no settings file")

fn keep_mut[T < mut Any](value: T) -> void:
    pass

fn store(settings: mut Settings) -> void:
    let erased: mut Any = settings
    _ := erased
    keep_mut(settings)
