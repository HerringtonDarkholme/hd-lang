# test: a list of struct literals and a key closure parameter solve one type parameter
# Spec Type System, Generic Arguments: types.generic.infer; T is solved as Pet from both arguments.
struct Pet:
    name: string

fn sorted_by_key[T, K < Ord](items: List[T], key: fn(T) -> K) -> List[T]:
    items

fn by_name() -> List[Pet]:
    pets := [Pet { name: "Rex" }, Pet { name: "Ada" }]
    sorted_by_key(pets, fn(pet: Pet) -> string: pet.name)
