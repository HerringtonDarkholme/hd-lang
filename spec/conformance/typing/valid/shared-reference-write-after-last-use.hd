# test: a write after a shared reference's last use is valid, also on another arm of a branch
# Spec 13 Writes While Borrowed: ref.excl.live.
struct User:
    name: string
    age: i32

fn rename(u: &mut User, loud: bool) -> void $ Console:
    r := &u.name
    if loud:
        println(*r)
    else:
        u.name = "y"
    u.name = "x"
