# test: pack.map( is the pack operation even when a local named pack is in scope
# expect: accept

data Packer:
    count: i32

impl Packer:
    fn map(self, value: i32) -> i32:
        value + self.count

fn double(value: i32) -> i32:
    value * 2

fn main() -> i32:
    pack := Packer { count: 1 }
    let doubled: (i32, i32) = pack.map((1, 2), double)
    shifted := `pack`.map(doubled._1)
    shifted + pack.count
