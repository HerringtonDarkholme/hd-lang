# test: a data type may declare three embedded fields
# Spec 08 Embedding Limits: data.embed.width.
struct Created:
    created_at: i32

struct Updated:
    updated_at: i32

struct Owned:
    pub owner: string

struct Post:
    Created
    Updated
    Owned
    title: string

fn valid(post: Post) -> string:
    post.owner
