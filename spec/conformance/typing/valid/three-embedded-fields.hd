# test: a data type may declare three embedded fields
# Spec 08 Embedding Limits: data.embed.width.
data Created:
    created_at: i32

data Updated:
    updated_at: i32

data Owned:
    pub owner: string

data Post:
    Created
    Updated
    Owned
    title: string

fn valid(post: Post) -> string:
    post.owner
