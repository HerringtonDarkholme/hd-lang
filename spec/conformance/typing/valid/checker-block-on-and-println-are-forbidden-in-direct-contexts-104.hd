# test: checker block on and println are forbidden in direct contexts
use std.task.block_on

fn ready!() -> i32:
    42
struct Tag:
    name: string
fn tag_of[T](source: T) -> Tag:
    Tag { name: "t" }
fn done[T](end: T) -> i32:
    1
fn text!() -> string:
    "t"

fn wait() -> i32:
    let s: mut Suspend[i32] = ready()
    done(block_on(s))
fn f(v: i32 = wait()) -> i32:
    v

pub fn main() -> void:
    pass
