# test: a parameter decorator attaches parameter metadata visible through the parameter's shape
data User: pass
type UserId(i64)

data Description:
    text: string

fn description(text: string) -> Description:
    Description { text: text }

fn get_user(
    @description("User identifier")
    id: UserId,
) -> User:
    User {}

params := shape_of(get_user).params
