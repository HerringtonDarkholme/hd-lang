# Spec 10 Prelude: module.prelude.in-scope, module.prelude.panic, module.prelude.println, module.prelude.collections.
data Label:
    value: string

impl Display for Label:
    fn to_string(self) -> string: self.value

impl Hash for Label:
    fn hash(self, state: mut Hasher) -> void:
        self.value.hash(state)

fn normalize(values: mut List[string], entries: mut Map[string, i32]) -> i32:
    values.push(" Added ")
    clean := [for value in values => "[$value]"]
    removed := entries.remove("old")
    extra := if clean.len() > 1: +1 else: 0
    match removed:
        .Some(value) => value + extra
        .None => 0

fn report(label: Label) -> void $ Console:
    println(label)

fn fail[T](message: string) -> T:
    panic(message)
