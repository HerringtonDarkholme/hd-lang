# test: a signed literal anywhere in a literal group makes the whole group i32
# Spec 04 Open Literal Width: types.literal.local.signed, types.literal.local.group, types.literal.local.default.

fn negative():
    let x = -1
    x

fn plus():
    let d = +5
    d

fn signed():
    5 + -1

fn listed():
    let xs = [1, -2]
    xs[0]

fn run() -> i32:
    negative() + plus() + signed() + listed()
