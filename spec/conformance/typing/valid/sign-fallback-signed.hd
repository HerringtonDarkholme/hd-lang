# test: a signed literal anywhere in an integer group makes the whole group fall back to i32
# Spec 04 Open Literal Width: types.literal.open.signed, types.literal.open.group, types.literal.open.int-fallback (SIGN-FALLBACK, batch 83).

fn negative():
    let x = -1
    x

fn plus():
    let d = +5
    d

fn signed():
    let a = 5
    let b = -1
    a + b

fn run() -> i32:
    negative() + plus() + signed()
