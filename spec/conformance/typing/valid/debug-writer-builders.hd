# test: a hand-written Debug describes a value with DebugWriter builders, like Rust's Formatter
# Spec std/format Debug Builders: std-format.debug.builder.struct and the other builders (Testing T53).
use std.format.{DebugWriter, DebugList, DebugMap}

data Point:
    x: i32
    y: i32

enum Tag:
    Plain
    Pair(i32, i32)

data Bag:
    items: List[i32]
    names: List[string]

impl Debug for Point:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Point").field("x", self.x).field("y", self.y).finish()

impl Debug for Tag:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            Tag.Plain => out.write("Plain")
            Tag.Pair(a, b) => out.debug_tuple("Pair").field(a).field(b).finish()

impl Debug for Bag:
    fn debug(self, out: mut DebugWriter) -> void:
        let list: mut DebugList = out.debug_list()
        for item in self.items:
            _ := list.entry(item)
        list.finish()
        let map: mut DebugMap = out.debug_map()
        for name in self.names:
            _ := map.entry(name, name.len())
        map.finish()

fn show(point: Point, tag: Tag, bag: Bag) -> string:
    debug(point) + debug(tag) + debug(bag)
