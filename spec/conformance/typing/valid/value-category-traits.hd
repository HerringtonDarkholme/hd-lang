# test: AnyVal holds primitives, tuples, and newtypes of them; AnyRef holds data, enums, optionals, lists, maps, and newtypes of them
# Spec 10 Value-Category Traits: module.prelude.any-subtraits, module.prelude.anyref,
# module.prelude.anyval-types, module.prelude.newtype-category.
type Meters(f64)
type Tags(List[string])

data Parcel:
    weight: i32

enum Status:
    Queued
    Shipped(tracking: string)

fn by_value[T < AnyVal](value: T) -> T:
    value

fn by_ref[T < AnyRef](value: T) -> T:
    value

fn as_any[T < Any](value: T) -> T:
    value

fn categories() -> void:
    _ := by_value(+3)
    _ := by_value(true)
    _ := by_value((+1, "a"))
    _ := by_value(Meters(2.5))
    _ := by_ref(Parcel { weight: 3 })
    _ := by_ref(Status.Shipped("Z1"))
    let tracking: string? = "Z1"
    _ := by_ref(tracking)
    _ := by_ref([1, 2])
    _ := by_ref({"a": 1})
    _ := by_ref(Tags(["fragile"]))
    _ := as_any(Meters(1.0))
    _ := as_any(Parcel { weight: 1 })
