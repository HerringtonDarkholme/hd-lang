# test: AnyVal holds primitives, tuples, enums, optionals, functions, lists, maps, and newtypes of them; AnyRef holds data
# Spec 10 Value-Category Traits: module.prelude.any-subtraits, module.prelude.anyref-members,
# module.prelude.anyval-members, module.prelude.newtype-category.
type Meters(f64)
type Tags(List[string])

struct Parcel:
    weight: i32

enum Status:
    Queued
    Shipped(tracking: string)

fn by_value[T < AnyVal](value: T) -> T:
    value

fn by_ref[T < AnyRef](value: T) -> T:
    value

fn as_any[T < Any](value: T) -> T:
    value

fn categories() -> void:
    _ := by_value(+3)
    _ := by_value(true)
    _ := by_value((+1, "a"))
    _ := by_value(Meters(2.5))
    _ := by_ref(&mut Parcel { weight: 3 })
    _ := by_value(Status.Shipped("Z1"))
    _ := by_value(Status.Queued)
    let tracking: string? = "Z1"
    _ := by_value(tracking)
    let outcome: Result[i32, string] = .Ok(1)
    _ := by_value(outcome)
    _ := by_value(fn(weight: i32) -> i32: weight + 1)
    _ := by_value([1, 2])
    _ := by_value({"a": 1})
    _ := by_value(Tags(["fragile"]))
    _ := as_any(Meters(1.0))
    _ := as_any(&mut Parcel { weight: 1 })
