# test: a prefix function may be generic; its type arguments are inferred at the string
# Spec 05 Literal Suffixes: expr.literal-fn.ordinary-call (Literal Suffixes L20).
use std.ops.{Template, str_prefix}

@str_prefix
fn parts[T](t: Template[T]) -> List[string]:
    t.raw_parts

fn render(count: i32) -> List[string]:
    parts"a $count b"
