# test: a query builder's variant-local parameter is solved from the expected result type, so a literal payload adopts i64
# Spec 13 Construction: gadt.construct.syntax, gadt.construct.infer; Type-Checking Requirements: gadt.check.construct.
enum Query[T]:
    Count(table: string) -> Query[i64]
    Exists(table: string) -> Query[bool]
    Const[T](value: T) -> Query[T]
    Either[T](first: Query[T], fallback: Query[T]) -> Query[T]

fn limit() -> Query[i64]:
    Query.Const(100)

fn rows_or_default(table: string) -> Query[i64]:
    Query.Either(Query.Count(table), Query.Const(0))

let seen: Query[bool] = Query.Either(Query.Exists("users"), Query.Const(false))
let total: Query[i64] = Query.Either(limit(), rows_or_default("orders"))
