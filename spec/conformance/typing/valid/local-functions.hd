# Spec 07 Local Functions And Recursion: fn.local.declare, fn.local.scope,
# fn.local.capture-rules, fn.local.private, fn.recursion.named-cycle.
fn total_with_bonus(values: List[i32], bonus: i32) -> i32:
    fn add_bonus(value: i32) -> i32:
        value + bonus

    let total = +0
    for value in values:
        total = total + add_bonus(value)
    total

fn factorial(n: i32) -> i32:
    fn step(value: i32) -> i32:
        if value <= 1:
            1
        else:
            value * step(value - 1)

    step(n)
