# test: a closure argument may capture a local reference, and the callee may call and pass it to another function parameter
# Spec 07 Captures: fn.capture.local-parameter, fn.capture.local-uses.
struct Counter:
    value: i32

fn call(reader: fn() -> i32) -> i32:
    reader()

fn forward(reader: fn() -> i32, apply: fn(fn() -> i32) -> i32) -> i32:
    apply(reader)

fn indirect(apply: fn(fn() -> i32) -> i32, counter: &Counter) -> i32:
    apply(fn() -> i32: counter.value)

fn read(counter: &Counter) -> i32:
    a := call(fn() -> i32: counter.value)
    b := forward(fn() -> i32: counter.value, fn(reader: fn() -> i32) -> i32: reader())
    c := indirect(fn(reader: fn() -> i32) -> i32: reader(), counter)
    a + b + c
