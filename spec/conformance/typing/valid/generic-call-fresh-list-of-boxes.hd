# test: a list literal of Box literals fills a generic List[Box[T]] parameter
# Spec 04 Generic Arguments: types.generic.infer; each Box literal meets the Box[T] element.
struct Box[T]:
    item: T

fn first_item[T](boxes: List[Box[T]]) -> T?:
    match boxes.first():
        .Some(b) => .Some(b.item)
        .None => .None

fn sample() -> f64?:
    first_item([Box { item: 1.5 }, Box { item: 2.5 }])
