# test: a comparator lends tuple elements by reference, as it lends struct fields
# Spec 13 Places And New Objects: ref.place.tuple-element.
use std.cmp.Ordering

fn by_ref(a: &i32, b: &i32) -> Ordering:
    (*a).cmp(*b)

fn by_key(a: (i32, string), b: (i32, string)) -> Ordering:
    by_ref(&a._0, &b._0)

fn same_key(a: (i32, string), b: (i32, string)) -> bool:
    a._0.eq(&b._0)

fn sort(entries: List[(i32, string)]) -> List[(i32, string)]:
    entries.sorted_by(by_key)
