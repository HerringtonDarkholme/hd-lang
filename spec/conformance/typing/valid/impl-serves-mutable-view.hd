# test: one implementation serves the readonly and the mutable view
# Spec 09 Traits: trait.target.permission, trait.target.both-views, trait.target.mut-self.

trait Resettable:
    fn reset(mut self) -> void
    fn current(self) -> i32

data Counter:
    value: i32

impl Resettable for Counter:
    fn reset(mut self) -> void:
        self.value = 0

    fn current(self) -> i32:
        self.value

fn clear[T < mut Resettable](value: T) -> void:
    value.reset()

fn read(counter: Counter) -> i32:
    counter.current()

fn clear_and_read(counter: mut Counter) -> i32:
    clear(counter)
    counter.reset()
    read(counter)
