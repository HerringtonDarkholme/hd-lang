
data User:
    id: string

impl PartialEq for User:
    fn eq(self, other: Self) -> bool:
        self.id == other.id

fn same(left: User, right: User) -> bool:
    left == right

fn same_object(left: User, right: User) -> bool:
    left is right

fn same_map(left: Map[string, i32], right: Map[string, i32]) -> bool:
    left == right
