# Spec 08 Generalized Algebraic Data Types: data.gadt.declare, data.gadt.refine.
# Spec 13 Generalized Algebraic Data Types: gadt.intro.refine, gadt.intro.recover; Variant Result Types: gadt.result.declare, gadt.result.refine.
# Spec 13 Shared Constructor Data: gadt.result.shared-data, gadt.shared.assignable; Type-Checking Requirements: gadt.check.owner, gadt.check.payload.
# Spec 13 Pattern Refinement: gadt.refine.equalities, gadt.refine.scope, gadt.refine.match-type; Refinement Algorithm: gadt.unify.solvable.
enum Expr[T]:
    IntLit(value: i64) -> Expr[i64]
    BoolLit(value: bool) -> Expr[bool]
    Add(left: Expr[i64], right: Expr[i64]) -> Expr[i64]
    Sub(left: Expr[i64], right: Expr[i64]) -> Expr[i64]
    Scale(value: Expr[i64], factor: i64) -> Expr[i64]
    If[T](cond: Expr[bool], then_value: Expr[T], else_value: Expr[T]) -> Expr[T]

fn eval[T](expr: Expr[T]) -> T:
    match expr:
        Expr.IntLit(value) => value
        Expr.BoolLit(value) => value
        Expr.Add(left, right) => eval(left) + eval(right)
        Expr.Sub(left, right) => eval(left) - eval(right)
        Expr.Scale(value, factor) => eval(value) * factor
        Expr.If(cond, then_value, else_value) =>
            if eval(cond): eval(then_value) else: eval(else_value)

enum Box[T](contents: T):
    IntBox(n: i64) -> Box[i64](0)
    BoolBox(b: bool) -> Box[bool](false)
