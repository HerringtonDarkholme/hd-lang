# test: += means p = p + e on primitives, strings, fields, and newtypes
# Spec 05 Compound Assignment: expr.assign.compound.meaning, expr.assign.compound.primitive, expr.assign.compound.operator (Operator Traits OP13).
use std.ops.Add

type Meters(i64)

impl Add[Meters] for Meters:
    type Out = Meters
    fn add(self, rhs: Meters) -> Meters:
        Meters(i64(self) + i64(rhs))

data Tally:
    count: i64

fn record(tally: mut Tally, hits: List[i64]) -> Meters:
    let log = ""
    let walked = Meters(0)
    for hit in hits:
        tally.count += hit
        walked += Meters(hit)
        log += "."
    walked
