# test: an entry point's error type may implement std.process.ExitStatus
# Spec 10 Exit Status: std.process declares ExitStatus with fn status(self) -> i32; when
# main returns .Err(error) and E implements it, the process exits with error.status().
use std.process.ExitStatus

pub enum CliError:
    Usage
    Missing(path: string)

impl Display for CliError:
    fn to_string(self) -> string:
        match self:
            CliError.Usage => "usage: tool PATH"
            CliError.Missing(path) => "missing: " + path

impl ExitStatus for CliError:
    fn status(self) -> i32:
        match self:
            CliError.Usage => 2
            CliError.Missing(_) => 1

pub fn main() -> Result[void, CliError]:
    .Err(CliError.Usage)
