# test: a read through a shared or `&mut` reborrow of a field keeps that field's own lifetime positions
# Spec 13 Origins: ref.dep.origin.position.union; Lifetime Structs: ref.lifetime.struct.read.
struct Two['a, 'b]:
    x: &'a string
    y: &'b string

struct Outer['a, 'b]:
    inner: Two['b, 'a]

fn read_shared['a, 'b](t: &Two['a, 'b]) -> &'a string:
    r := &t.x
    *r

fn read_mut['a, 'b](t: &mut Two['a, 'b]) -> &'b string:
    r := &mut t.y
    *r

fn read_nested['a, 'b](t: &Outer['a, 'b]) -> &'b string:
    r := &t.inner
    r.x

fn read_nested_mut['a, 'b](t: &mut Outer['a, 'b]) -> &'a string:
    r := &mut t.inner
    r.y
