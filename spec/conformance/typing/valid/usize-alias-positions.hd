# test: usize and u32 are one type in an alias target, a newtype base, and trait and implementation heads
# Spec 04 The usize Alias: types.alias.usize, types.alias.identical.
type Size = usize
type Count(usize)

trait Marker[T]:
    fn mark(self) -> T

data Wrapper[T]:
    value: T

impl Marker[usize] for Wrapper[usize]:
    fn mark(self) -> usize:
        self.value

fn same(value: Size) -> u32:
    value

fn make(value: u32) -> Count:
    Count(value)

fn through(wrapper: Wrapper[u32]) -> u32:
    wrapper.mark()
