# test: one field moves out while a reference to another field of the same binding is used later
# Spec 13 Writes While Borrowed: ref.excl.move, ref.excl.place.
struct Bag:
    labels: List[string]

impl !Copy for Bag

struct Shelf:
    left: Bag
    right: Bag

fn consume(bag: Bag) -> usize:
    bag.labels.len()

pub fn main() -> void $ Console:
    shelf := Shelf { left: Bag { labels: ["a"] }, right: Bag { labels: ["b", "c"] } }
    r := &shelf.right
    n := consume(shelf.left)
    println("$n ${r.labels.len()}")
