# test: a call through a trait value of a local depends only on its lifetime argument, through a reborrow too
# Spec 13 Dependent Results: ref.dep.trait; Spec 13 Lifetime Variables: ref.lifetime.call.
struct Parser[T, 'src]:
    src: &'src T

trait Source[T, 'src]:
    fn source(&self) -> &'src T

impl[T, 'src] Source[T, 'src] for Parser[T, 'src]:
    fn source(&self) -> &'src T:
        self.src

fn as_dyn['p, 's](p: &'p Parser[string, 's]) -> &'p dyn Source[string, 's]:
    p

fn through_local['s](v: &'s string) -> &'s string:
    parser := Parser { src: v }
    d := as_dyn(&parser)
    d.source()

fn through_reborrow['s](d: &dyn Source[string, 's]) -> &'s string:
    e := &*d
    e.source()
