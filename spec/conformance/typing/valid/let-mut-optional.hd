# test: let mut binds an optional `&mut` reference, and a write through its payload changes the referenced value
# Spec 13 Writing Through A Reference: ref.write.field.
struct User:
    name: string

fn find() -> *mut User?:
    .Some(&mut User { name: "Lin" })

fn rename() -> string:
    let mut found = find()
    match found:
        .Some(user) =>
            user.name = "Kay"
            user.name
        .None => ""
