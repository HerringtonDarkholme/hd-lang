# test: a parameter named nowhere is reported once
fn make[T]() -> T:
    panic("no")

fn missing[T]() -> i32:
    1

fn dflt[T = i32]() -> i32:
    1

fn ident[T](v: T) -> T:
    v

fn once[A, B](f: fn(A) -> B) -> i32:
    1

struct Reader:
    id: i32

impl Reader:
    fn size[T](self) -> i32:
        self.id

fn solved_57() -> void:
    _ := missing::[i32]()

fn solved_58() -> void:
    _ := make::[i32]()

fn solved_59() -> void:
    r := Reader { id: 1 }
    _ := r.size::[i32]()

fn solved_60() -> void:
    _ := once::[i32, i32](ident)
