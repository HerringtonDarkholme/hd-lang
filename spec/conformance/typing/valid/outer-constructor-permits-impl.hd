# test: owning a trait argument's outer constructor permits a foreign impl
# Spec 09 Traits: an impl is allowed when it owns an outer constructor.
# Spec 09 Traits: trait.own.argument.
use std.iter.ListIter

struct Word:
    text: string

impl Iterable[Word] for string:
    type IntoIter = ListIter[Word]
    fn iter(self) -> ListIter[Word]:
        panic("not evaluated")
