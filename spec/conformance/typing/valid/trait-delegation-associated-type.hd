# test: a delegating implementation binds each associated type to the part's binding
# Spec 09 Traits: trait.by.assoc-types.
trait Supplier:
    type Item
    fn get(self) -> Self::Item

data Source:
    value: i32

impl Supplier for Source:
    type Item = i32
    fn get(self) -> i32:
        self.value

data Feed:
    Source

impl Supplier for Feed by Source

fn valid(feed: Feed) -> i32:
    feed.get() + 1
