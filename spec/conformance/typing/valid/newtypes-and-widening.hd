# Spec 04 Nominal Types, Newtypes, And Casts: types.nominal.distinct,
# types.nominal.shape, types.newtype.decl, types.newtype.distinct,
# types.newtype.construct, types.newtype.no-implicit,
# types.newtype.no-inherit, types.newtype.construct-value,
# types.cast.syntax, types.cast.precision, types.cast.nonnumeric.
type Mile(i32)

let small: i8 = 1

fn widen(value: i16) -> i64:
    i64(value)

fn unwrap(distance: Mile) -> i32:
    i32(distance)

distance := Mile(10)

let wide: i64 = 9000
narrow := i16(wide)
