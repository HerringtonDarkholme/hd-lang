# test: a pub own member hides same-depth promoted members of its name, so they do not conflict
data CreatedBySystem:
    pub id: string

impl CreatedBySystem:
    pub fn describe(self) -> string:
        "system"

data CreatedByUser:
    pub id: string

impl CreatedByUser:
    pub fn describe(self) -> string:
        "user"

data AuditEntry:
    CreatedBySystem
    CreatedByUser
    pub id: string

impl AuditEntry:
    pub fn describe(self) -> string:
        "entry"

fn valid(entry: AuditEntry) -> string:
    entry.id + entry.describe() + entry.CreatedByUser.id
