# test: an element reference may source a dependent call
# Spec 13 Dependent Results: ref.dep.call, ref.dep.origin.element.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

fn longest(people: &List[User]) -> usize:
    let best = 0usize
    for p in &people:
        n := p.name()
        if n.len() > best:
            best = n.len()
    best
