# test: a typed fact's literal argument takes the annotated field's type
# Spec 04 Type System: types.literal.local.form.fact.
use std.annotation.annotate

@annotate::[F](.Field)
struct Floor[F]:
    value: F

fn floor[F](value: F) -> Floor[F]:
    Floor::[F] { value: value }

struct Ledger:
    @floor(-5000000000)
    balance: i64
