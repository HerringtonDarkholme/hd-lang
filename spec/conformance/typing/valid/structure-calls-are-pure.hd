# test: walk, describe and build need no requirement and do not suspend, so a pure method may call them
# Spec 14 The Structure Trait: annot.structure.pure.
use std.structure.{Structure, Field, Variant, Describer}

trait Named:
    fn type_name() -> string

data Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

trait Counted:
    fn members() -> i32

impl[T] Counted for T by Structure:
    fn members() -> i32:
        let mut d = Count { n: 0 }
        _ := T::describe(d)
        d.n

@derive(Counted)
data Pair:
    a: i32
    b: i32

fn total() -> i32:
    Pair::members()
