# Spec 08 Field Access: data.access.syntax, data.access.writable-place; Fields: data.field.mut-type.
# Spec 13 Writing Through A Reference: ref.write.field; Conversions: ref.convert.weaken.
struct Profile:
    name: string

struct Account:
    profile: *mut Profile
    snapshot: *Profile

impl Profile:
    fn rename(&mut self, name: string) -> void:
        self.name = name

fn rename(account: &mut Account, name: string) -> void:
    account.snapshot = box(Profile { name: name })
    account.profile = box(Profile { name: name })
    account.profile.name = name
    account.profile.rename(name)

fn readonly_account(profile: *mut Profile) -> *Account:
    let account: *Account = box(Account {
        profile: profile,
        snapshot: box(Profile { name: "Ada" }),
    })
    account
