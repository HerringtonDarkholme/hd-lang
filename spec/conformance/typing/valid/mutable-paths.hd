# Spec 08 Field Access: data.access.syntax, data.access.mut-root, data.access.nested; Fields: data.field.mut-type.
# Spec 04 Mutable Paths: types.path.access-type, types.path.root,
# types.path.call, types.path.field, types.path.field.mutable-edge,
# types.path.field.readonly-edge, types.path.field.generic,
# types.path.field.substituted, types.path.access.mut-type,
# types.path.access.mut-self, types.path.mutation,
# types.path.mutation.needs-access, types.path.mutation.only,
# types.path.store-mut-edge, types.path.store-readonly,
# types.path.reassign, types.path.reassign.old-value.
struct Profile:
    name: string

struct Account:
    profile: &mut Profile
    snapshot: &Profile

impl Profile:
    fn rename(&mut self, name: string) -> void:
        self.name = name

fn rename(account: &mut Account, name: string) -> void:
    account.snapshot = &mut Profile { name: name }
    account.profile = &mut Profile { name: name }
    account.profile.name = name
    account.profile.rename(name)

fn readonly_account(profile: &mut Profile) -> &Account:
    let account: &Account = &mut Account {
        profile: profile,
        snapshot: &mut Profile { name: "Ada" },
    }
    account
