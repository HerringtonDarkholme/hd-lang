# test: the outer type's trait method is selected; an embedded type implementing the same trait is ignored
trait Describe:
    fn describe(self) -> string

data Label:
    text: string

impl Describe for Label:
    fn describe(self) -> string:
        self.text

data Page:
    Label

impl Describe for Page:
    fn describe(self) -> string:
        "page"

fn valid(page: Page) -> string:
    page.describe()
