# test: snapshot compares text with a literal expectation
# Spec 10 Snapshots: snapshot and snapshot_file are imported from std.testing.
use std.testing.{snapshot, snapshot_file}

fn greeting(name: string) -> string: "hello, " + name

tests:
    it("greets by name"):
        snapshot(greeting("Ada"), expect="hello, Ada")

    it("records an expectation on update"):
        snapshot(greeting("Grace"))

    it("stores larger output in a file"):
        snapshot_file(greeting("Hopper"))
