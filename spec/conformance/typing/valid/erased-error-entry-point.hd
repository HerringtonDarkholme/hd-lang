# test: a shared erased error satisfies Error, so main may return Result[void, &dyn Error]
# Spec 09 Erased Errors: trait.dyn.bound.reference.
use std.error.Error

enum StartError:
    MissingConfig

impl Display for StartError:
    fn to_string(self) -> string:
        "missing config"

impl Error for StartError

fn start(ready: bool) -> Result[void, *dyn Error]:
    if ready:
        return .Ok(())
    .Err(&StartError.MissingConfig)

pub fn main() -> Result[void, *dyn Error]:
    start(true)?
    .Ok(())
