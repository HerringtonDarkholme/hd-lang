# test: a module of the trait's package that re-exports the trait declares its template
# Spec 14 Templates: annot.template.module.
# fixture-package-tree: template-reexport/src/counting.hd
pub use pkg.size.{Size}
use std.structure.{Structure, Field, Variant, Describer}

struct Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

impl[T] Size for T by Structure:
    fn size(&self) -> i32:
        let mut d = Count { n: 0 }
        _ := T::describe(&mut d)
        d.n

@derive(Size)
struct Point:
    x: i32
    y: i32

pub fn members() -> i32:
    Point { x: 1, y: 2 }.size()
