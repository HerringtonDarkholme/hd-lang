# test: a lifetime parameter may precede a type parameter, and explicit type arguments still fill only the type parameters
# Spec 04 Lifetime Parameters: types.lifetime.free-order, types.lifetime.arguments.
fn first['a, T](x: &'a T, y: &'a T) -> &'a T:
    x

fn demo() -> i32:
    a := +1
    b := +2
    *first::[i32](&a, &b)
