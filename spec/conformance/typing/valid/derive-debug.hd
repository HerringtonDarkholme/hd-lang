# test: Debug derives through its template and debug renders a value
# Spec 09 Debug Trait: @derive(Debug) and the prelude function debug need no use.
@derive(Eq, Debug)
data Point:
    x: i32
    y: i32

@derive(Debug)
enum Shape:
    Dot(at: Point)
    Line(from: Point, to: Point)

fn describe(point: Point) -> string:
    debug(point)

fn describe_shape(value: Shape) -> string:
    debug(value)
