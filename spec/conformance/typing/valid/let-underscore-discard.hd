# test: let _ = expression discards a must-use value, as _ := expression does
# Spec 06 Unused Bindings: flow.unused.discard-forms (owner decision LP-discard, batch 30, 2026-09-30).
data SaveError:
    message: string

fn save() -> Result[i32, SaveError]:
    .Err(SaveError { message: "failed" })

fn save_twice() -> void:
    let _ = save()
    _ := save()
