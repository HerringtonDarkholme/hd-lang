# test: void and never satisfy Any
# Spec 04 Any: types.any.all for void, which is (), and types.any.never (TY-31, batch 51b; VOID-ALIAS, batch 52).

fn log() -> void:
    pass

fn keep[T < Any](value: T) -> i32:
    0

fn erase() -> void:
    let x: dyn Any = log()
    _ := keep(log())

fn stop() -> i32:
    keep(panic("stop"))
