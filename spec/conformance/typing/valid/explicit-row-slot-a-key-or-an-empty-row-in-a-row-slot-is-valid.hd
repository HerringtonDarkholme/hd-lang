# test: explicit row slot a key or an empty row in a row slot is valid
trait Log

fn provide_log[$ R](callback: fn() -> void $ R + Log) -> void $ R:
    pass

fn quiet() -> void:
    pass

fn with_key() -> void $ Log:
    provide_log::[$ Log](quiet)

fn with_empty_row() -> void $ Log:
    provide_log::[$ ()](quiet)
