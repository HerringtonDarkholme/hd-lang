# test: checker block on and println are forbidden in direct contexts
use std.ops.defer
use std.task.block_on

fn ready!() -> i32:
    42
struct Tag:
    name: string
fn tag_of[T](source: T) -> Tag:
    Tag { name: "t" }
fn done[T](end: T) -> i32:
    1
fn text!() -> string:
    "t"

fn f() -> void $ Console:
    defer(
        fn() -> void:
            let g = fn() -> void $ Console: println("x")
            g()
        ,
    )
    pass

pub fn main() -> void:
    pass
