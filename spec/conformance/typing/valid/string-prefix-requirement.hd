# test: a prefix function may need providers; the string's caller provides them
# Spec 05 Prefixed Strings: expr.prefix.ordinary-rules (Literal Suffixes L20).
use std.ops.{Template, str_prefix}

@str_prefix
fn logged(t: Template[string]) -> string $ Console:
    "logged"

fn render() -> string $ Console:
    logged"x"
