# test: requirements / generic provider keys / distinct

trait Repo[T]
data User: pass
data Post: pass
fn choose(first: dyn Repo[User], second: dyn Repo[Post]) -> void:
    $.with(Repo[User]=first, Repo[Post]=second):
        pass
fn consume[T](repo: dyn Repo[T]) -> i32 $ Repo[T]:
    _ := $.use(Repo[T])
    1
fn run(repo: dyn Repo[User]) -> i32:
    $.with(Repo[User]=repo):
        consume(repo)
