# test: checker power operands follow the exponent rules
fn case_65(b: i32, e: u32) -> i32: b ** e

fn case_66(b: i64, e: u8) -> i64: b ** e

fn case_67(b: u8, e: u16) -> u8: b ** e

fn case_68(b: i32, e: u64) -> i32: b ** e

fn case_69(b: i32, e: usize) -> i32: b ** e

fn case_70(b: i32) -> i32: b ** 3

fn case_71() -> i32: 2 ** 3 ** 2

fn case_72() -> i32: -2 ** 2

fn case_73(b: f64, e: f64) -> f64: b ** e

fn case_74(b: f32, e: f32) -> f32: b ** e

fn case_75(b: f32) -> f32: b ** 2.0

fn case_76() -> f64: 2.0 ** -1.0

fn case_77(b: i32) -> i64: i64(b ** 2)
