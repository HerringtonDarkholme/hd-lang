# Spec 04 Assignability, Views, And Bindings: types.static,
# types.local-inference, types.assign, types.assign.identical,
# types.assign.weaken, types.assign.binding-type, types.assign.let-declared,
# types.composite.kinds-shared, types.composite.shared, types.view.readonly,
# types.view.mutable, types.view.term, types.view.non-reassignable,
# types.mut.permission, types.mut.no-field-reassign, types.mut.weaken,
# types.bind.short, types.bind.let-mut, types.param.readonly,
# types.param.mut, types.return.readonly.
struct User:
    name: string

fn rename(user: &mut User, name: string) -> void:
    user.name = name

fn example() -> string:
    let mut user = &mut User { name: "Ada" }
    readonly := user
    rename(user, "Grace")
    short := &mut User { name: "Lin" }
    let mut names: List[string] = []
    names.push(short.name)
    readonly.name
