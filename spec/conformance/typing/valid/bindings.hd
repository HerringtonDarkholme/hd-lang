# Spec 04 Assignability And Coercion: types.static,
# types.local-inference, types.assign, types.assign.identical,
# types.assign.binding-type, types.assign.let-declared; Binding Forms:
# types.view.non-reassignable; Collection Values: types.coll.let-mut.
struct User:
    name: string

fn rename(user: &mut User, name: string) -> void:
    user.name = name

fn example() -> string:
    let mut user = &mut User { name: "Ada" }
    readonly := user
    rename(user, "Grace")
    short := &mut User { name: "Lin" }
    let mut names: List[string] = []
    names.push(short.name)
    readonly.name
