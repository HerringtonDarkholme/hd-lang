# test: an argument-position impl Trait may outlive a declared lifetime
use std.function.Fn

struct Counter:
    n: i32

fn first['a](counter: &'a Counter, action: impl Fn() -> i32&'a) -> &'a Counter:
    action()
    counter

fn pick(outer: &Counter, other: &Counter) -> i32:
    first(outer, fn() -> i32: other.n).n
