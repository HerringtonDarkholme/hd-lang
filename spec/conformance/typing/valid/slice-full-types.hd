# test: slice methods express whole values and prefixes with explicit offsets
fn parts(text: string, items: List[i32]) -> (string, List[i32], string, List[i32]):
    (text.slice(0, text.len()), items.slice(0, items.len()), text.slice(0, 2), items.slice(0, 2))

fn whole(items: List[i32]) -> List[i32]:
    items.slice(0, items.len())

fn both(text: string, items: List[i32]) -> (string, List[i32], string):
    (text.slice(0, text.len()), whole(items), text.slice(0, 3))
