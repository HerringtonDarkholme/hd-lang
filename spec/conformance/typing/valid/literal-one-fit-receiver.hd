# test: an implementation alone never names a literal receiver's width, so an annotation gives it
# Spec 04 Open Literal Width: types.literal.local.join, types.literal.local.form.receiver.
trait Halve:
    fn halve(self) -> Self

impl Halve for i64:
    fn halve(self) -> i64:
        self / 2

fn run() -> i64:
    let n: i64 = 10
    n.halve()
