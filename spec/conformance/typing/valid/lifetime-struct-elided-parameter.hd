# test: an elided lifetime argument in a parameter's type has a lifetime of its own
# Spec 13 Lifetime Structs: ref.lifetime.struct.elide, ref.lifetime.struct.elide.parameter.
struct Parser[T, 'src]:
    src: &'src T
    pos: usize

fn position(p: &Parser[string]) -> usize:
    p.pos

fn source(p: Parser[string]) -> &string:  # one lifetime: the result takes it
    p.src

fn demo(text: string) -> usize:
    p := Parser { src: &text, pos: 1 }
    position(&p) + source(p).len()
