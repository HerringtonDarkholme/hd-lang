# test: TestRunner is a host capability trait whose methods are plain calls
# Spec std Testing, Runner Capabilities: std-testing.runner.declares, std-testing.runner.plain, std-testing.runner.snapshot-check, and std-testing.runner.temp-dir.
use std.testing.TestRunner

data FirstRow:
    rows: usize
    snapshots: i32

impl TestRunner for FirstRow:
    fn row(mut self, count: usize) -> usize:
        self.rows = count
        0

    fn report_timeout(mut self, millis: i64) -> void:
        pass

    fn snapshot_check(mut self, text: string) -> string:
        self.snapshots = self.snapshots + 1
        ""

    fn temp_dir(mut self) -> string:
        "/tmp/first-row"

fn pick(rows: List[string]) -> string $ TestRunner:
    rows[$.use(TestRunner).row(rows.len())]

fn matches(text: string) -> bool $ TestRunner:
    $.use(TestRunner).snapshot_check(text) == ""

fn both() -> void:
    $.with(TestRunner=FirstRow { rows: 0, snapshots: 0 }):
        _ := pick(["a", "b"])
        _ := matches("a")
