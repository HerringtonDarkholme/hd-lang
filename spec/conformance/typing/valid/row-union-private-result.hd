# test: a non-public function's inferred result takes the union of its function values' rows
# Spec 11 Row Union In Literals: req.row.union.sites (Requirement Reuse RU15, Still Open 20).

trait Db

trait Clock

fn health() -> string $ Clock:
    "ok"

fn orders() -> string $ Db:
    "orders"

fn pick(admin: bool):
    if admin:
        return orders
    health

fn serve(admin: bool) -> string $ Db + Clock:
    handler := pick(admin)
    handler()
