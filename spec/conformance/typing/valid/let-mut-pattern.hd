# test: each name of a parenthesized multi-name let takes its own mut
struct User:
    name: string

fn pair() -> (User, User):
    (User { name: "Ada" }, User { name: "Grace" })

fn edit() -> string:
    let (mut first, second) = pair() # let mut User, User
    first.name = "Lin"
    let (third, mut fourth): (User, User) = pair()
    fourth.name = third.name
    second.name
