# Spec 03 Name Categories and Lexical Scopes: names.category.four, names.category.value,
# names.category.syntax, names.category.syntax.value, names.scope.lexical,
# names.scope.constructs, names.scope.start, names.local.short, names.local.let,
# names.local.same-scope, names.local.mutation, names.cond.child,
# names.cond.condition, names.loop.for-local, names.fn.value-params.visible,
# names.fn.params.scope.
fn normalize(value: string) -> string: "[$value]"

name := " outer "

fn normalize_again() -> string:
    name := normalize(name)
    name

fn example(input: string, items: List[string]) -> string $ Console:
    outer := "fallback"

    if (size := input.len()) > 0:
        println(size)

    for item in items:
        inner := normalize(item)
        println(inner)

    outer
