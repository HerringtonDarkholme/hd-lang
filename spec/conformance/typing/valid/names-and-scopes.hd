fn normalize(value: string) -> string: value.trim()

name := " outer "

fn normalize_again() -> string:
    name := normalize(name)
    name

fn example(input: string, items: list[string]) -> string $ Console:
    outer := "fallback"

    if (trimmed := input.trim()) != "":
        println(trimmed)

    for item in items:
        inner := normalize(item)
        println(inner)

    outer
