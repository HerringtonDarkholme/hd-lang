fn normalize(value: string) -> string: "[$value]"

name := " outer "

fn normalize_again() -> string:
    name := normalize(name)
    name

fn example(input: string, items: List[string]) -> string $ Console:
    outer := "fallback"

    if (size := input.len()) > 0:
        println(size)

    for item in items:
        inner := normalize(item)
        println(inner)

    outer
