# Spec 04 Option And Result Propagation: types.option.decl,
# types.option.sugar, types.option.distinct, types.option.propagate,
# types.option.propagate.one-layer, types.option.propagate.permission,
# types.option.ordinary, types.result.decl, types.result.propagate,
# types.result.propagate.enclosing, types.result.propagate.one-step,
# types.result.err-value, types.result.propagate.permission,
# types.result.no-effects.
data ParseError:
    message: string

fn label(value: string?) -> string?:
    actual := value?
    "value: " + actual

fn parse(input: string) -> Result[i32, ParseError]:
    if input == "":
        return .Err(ParseError { message: "empty" })
    .Ok(1)

fn parse_twice(input: string) -> Result[i32, ParseError]:
    first := parse(input)?
    second := parse(input)?
    .Ok(first + second)

let nested: string?? = .None
let callback: (fn(i32) -> string)? = .None
