# test: fn(i32) -> i32 is exact sugar for Fn[(i32,), i32, $()], so each spelling passes where the other is expected
# Spec 04 Function Type Identity: types.fn.constructor.
use std.function.Fn

fn spelled(f: Fn[(i32,), i32, $()]) -> fn(i32) -> i32:
    f

fn sugared(f: fn(i32) -> i32) -> Fn[(i32,), i32, $()]:
    spelled(f)
