use std.testing.assert_equal

data User:
    name: string

fn display_name(user: User?) -> string:
    match user:
        .None => "unknown"
        .Some(value) => value.name

test "plain values construct optionals and patterns extract them":
    let user: User? = .None
    assert_equal(display_name(user), "unknown", reason=".None case")
    user = User { name: "Ada" }
    assert_equal(display_name(user), "Ada", reason="present case")
