# test: data patterns label fields with ':'; payload patterns keep '='
# expect: accept

data Point:
    x: i32
    y: i32

enum Shape:
    Dot(point: Point)
    Line(start: Point, end: Point)

fn describe(value: Shape) -> i32:
    match value:
        Shape.Dot(Point { x: 0, y }) => y
        Shape.Dot(Point { x: px, y: _ }) => px
        Shape.Line(start=Point { x: 0 }, end=_) => 0
        Shape.Line(start=_, end=_) => 1
