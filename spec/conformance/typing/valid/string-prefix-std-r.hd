# test: the standard prefix r takes any displayable value
# std Text, Raw Text Prefix: r is an ordinary std.text prefix over Template[Display].
use std.text.r

fn digits(count: i32) -> string:
    r"\d{$count}"  # the text \d{ then count, then }

fn label(name: string, ok: bool) -> string:
    r"$name: ${ok}\n"
