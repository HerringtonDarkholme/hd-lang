trait Describe:
    fn describe(self) -> string

trait Add[T]:
    fn add(self, other: T) -> T

trait Named:
    fn name(self) -> string

    fn label(self) -> string:
        "name: " + self.name()

trait Formattable: Describe:
    fn format(self) -> string

trait Serializable

trait Clear:
    fn clear(mut self) -> void

data User:
    name: string

impl Describe for User:
    fn describe(self) -> string: self.name

impl Named for User:
    fn name(self) -> string: self.name

impl Formattable for User:
    fn format(self) -> string: self.describe()

impl Serializable for User

fn audit[T: Describe + Named](value: T) -> string:
    value.describe() + value.name()

fn clear_value[T: mut Clear](value: T) -> void:
    value.clear()

fn explicit_display(user: User) -> string:
    Describe::describe(user)

trait Factory:
    fn create() -> string

trait Supplier:
    type Item
    fn get(mut self) -> Self::Item?

data NameSupplier:
    next_name: string?

impl Supplier for NameSupplier:
    type Item = string

    fn get(mut self) -> string?:
        self.next_name

data UserFactory: pass

impl Factory for UserFactory:
    fn create() -> string: "guest"

trait Source:
    type Item
    fn get(self) -> Self::Item

data Box[T]:
    value: T

impl[T] Source for Box[T] where T: Any:
    type Item = T

    fn get(self) -> T: self.value

fn guest_name() -> string:
    UserFactory::create()
