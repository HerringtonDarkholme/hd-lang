trait Display:
    fn display(self) -> string

trait Named:
    fn name(self) -> string

    fn label(self) -> string:
        "name: " + self.name()

trait Formattable: Display:
    fn format(self) -> string

trait Serializable

struct User:
    name: string

impl Display for User:
    fn display(self) -> string: self.name

impl Named for User:
    fn name(self) -> string: self.name

impl Formattable for User:
    fn format(self) -> string: self.display()

impl Serializable for User

fn audit[T: Display + Named](value: T) -> string:
    value.display() + value.name()

fn explicit_display(user: User) -> string:
    Display::display(user)

trait Factory:
    fn create() -> string

struct UserFactory: pass

impl Factory for UserFactory:
    fn create() -> string: "guest"

trait Source:
    type Item
    fn get(self) -> Self::Item

struct Box[T]:
    value: T

impl[T] Source for Box[T] where T: Any:
    type Item = T

    fn get(self) -> T: self.value

fn guest_name() -> string:
    UserFactory::create()
