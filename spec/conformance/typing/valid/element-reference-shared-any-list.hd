# test: &xs[i] needs no writable place, so it may refer into a := list or a value parameter
# Spec 13 Element References: ref.elem.writable.shared.
fn read(value: &i32) -> i32:
    *value

fn first(items: List[i32]) -> i32:
    read(&items[0])

fn demo() -> i32:
    fixed := [+1, 2]
    read(&fixed[1]) + first(fixed)
