# fixture-package-role: library
# test: a library that declares a facet may annotate a primitive target

pub data Label: pass

pub data LabelInfo:
    pub text: string

impl Annotation for Label:
    type Info = LabelInfo

impl TypeAnnotator for Label:
    fn build(self, target: TypeShape) -> LabelInfo:
        LabelInfo { text: "value" }

annotate Label for string:
    fn build(self, target: TypeShape) -> LabelInfo:
        LabelInfo { text: "text" }
