# test: a store and a compound store check
# Spec 05 Callable Values: expr.call.apply.place.
use std.ops.{Apply, Update}

struct Cell:
    value: i32

impl Apply for Cell:
    type Out = i32
    fn apply(self) -> i32: self.value

impl Update[i32] for Cell:
    fn update(&mut self, value: i32) -> void:
        self.value = value

fn live(value: i32) -> Cell:
    Cell { value: value }

struct Panel:
    count: Cell
    frozen: Cell

fn run(panel: &mut Panel) -> i32:
    let mut count = live(+0)
    count() = 1
    count() += 2
    count() -= 1
    (panel.count)() = 5
    (panel.count)() *= 2
    count() + (panel.count)()
