# test: a call through a bound or a trait value reference takes its source from the trait's signature
# Spec 13 Dependent Results: ref.dep.trait.
trait Named:
    fn name(&self) -> &string

struct User:
    name: string
    age: i32

impl Named for User:
    fn name(&self) -> &string:
        &self.name

fn by_bound[T < Named](x: &T) -> &string:
    x.name()

fn by_trait_value(e: &dyn Named) -> &string:
    e.name()
