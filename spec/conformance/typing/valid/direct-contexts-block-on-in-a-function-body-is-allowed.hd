# test: direct contexts block on in a function body is allowed
use std.task.block_on

fn ready!() -> i32:
    42
struct Tag:
    name: string
fn tag_of[T](source: T) -> Tag:
    Tag { name: "t" }
fn done[T](end: T) -> i32:
    1
fn text!() -> string:
    "t"

fn f() -> void:
    let s: Suspend[i32] = ready()
    _ := block_on(s)

pub fn main() -> void:
    pass
