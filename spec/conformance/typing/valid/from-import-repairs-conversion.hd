# test: importing From makes the impl and its Result propagation valid
# trait.from.import, module.prelude.question-from.
use std.convert.From
data CliError:
    message: string

impl From[string] for CliError:
    fn from(message: string) -> CliError: CliError { message: message }

fn parse(text: string) -> Result[i32, string]: .Err(text)

fn run(text: string) -> Result[i32, CliError]:
    value := parse(text)?
    .Ok(value)
