
@derive(Eq, Hash)
data Revision:
    number: i32

@derive(Eq, Hash)
data Key:
    Revision
    name: string

@derive(Eq, Hash)
enum Status:
    Ready(code: i32)
    Failed(code: i32, reason: string)

fn lookup_key(items: Map[Key, i32], key: Key) -> i32?:
    items.get(key)

fn lookup_status(items: Map[Status, i32], status: Status) -> i32?:
    items.get(status)
