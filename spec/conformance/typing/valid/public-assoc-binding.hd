# test: an associated type bound to a public type is no leak
# Spec 10 Public Signatures: module.vis.signature.coverage.
pub struct Shown:
    n: i32

pub trait Make:
    type Out
    fn make(self) -> Self::Out

pub struct Maker:
    k: i32

impl Make for Maker:
    type Out = List[Shown]
    fn make(self) -> List[Shown]:
        []
