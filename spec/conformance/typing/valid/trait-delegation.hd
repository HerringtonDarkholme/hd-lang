# test: a delegating implementation forwards every trait method to the embedded field, and its body may replace some
# Spec 09 Traits: trait.by.form, trait.by.valid-part, trait.by.part-impl, trait.by.written, trait.by.ordinary.
trait Describe:
    fn describe(self) -> string
    fn headline(self) -> string:
        "* " + self.describe()

struct Logger:
    name: string

impl Describe for Logger:
    fn describe(self) -> string:
        self.name

struct Service:
    Logger
    port: i32

impl Describe for Service by Logger

struct Worker:
    Logger

impl Describe for Worker by Logger:
    fn headline(self) -> string:
        "worker " + self.Logger.headline()

fn show(value: dyn Describe) -> string:
    value.headline()

fn valid(service: Service, worker: Worker) -> string:
    service.describe() + service.headline() + worker.headline() + show(service) + show(worker)
