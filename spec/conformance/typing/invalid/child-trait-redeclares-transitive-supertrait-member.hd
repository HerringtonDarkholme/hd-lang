# test: the supertrait member-name check is transitive and covers defaults
# Spec 09 Traits: trait.super.no-redeclare, trait.super.no-default-override.

trait Greeter:
    fn greet(self) -> string

trait Polite < Greeter:
    fn thank(self) -> string

trait Loud < Polite:
    fn greet(self) -> string:  # diagnostic: duplicate-trait-member
        "HELLO"
