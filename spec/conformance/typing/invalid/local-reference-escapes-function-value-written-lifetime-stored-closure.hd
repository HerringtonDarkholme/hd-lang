# test: in a closure, a function value read from a field of a call's result passes its argument at the lifetime the closure parameter's annotation gives the call
# Spec 07 Function Types: fn.type.lifetime.call.written,
# fn.type.lifetime.call.written.closure. `x` is at `'a`, so `relay`'s
# result passes `y` at `'a`, which `y`'s elided lifetime is not.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn relay['a, T](h: Holder['a, T], p: &'a Point) -> Holder['a, T]:
    h

fn x_of(p: &Point) -> i32:
    p.x

fn outer['a](p: &'a Point, r: &Point) -> i32:
    g := fn(x: &'a Point, y: &Point):
        (relay(Holder { f: x_of }, x).f)(y) # diagnostic: local-reference-escapes
    g(p, r)
