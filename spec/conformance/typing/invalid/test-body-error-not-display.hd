# test: an explicit test body closure whose Result error lacks Display does not implement Termination
# Spec 05 Propagation In Test Blocks: an explicit closure body keeps its own result, which
# must satisfy the Termination bound on `it`.
data Hidden: pass

fn hidden() -> Result[void, Hidden]:
    .Err(Hidden {})

tests:
    it("an error without Display", body=fn!() -> Result[void, Hidden]: hidden())  # diagnostic: unsatisfied-trait-bound
