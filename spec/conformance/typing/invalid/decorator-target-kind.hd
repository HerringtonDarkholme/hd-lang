# test: a fact type marked @annotate(.Field) placed before a function
# Spec 14 Target Kinds: annot.target.limit.kind-error is reported on the decorator.
use std.annotation.annotate

@annotate(.Field)
struct MaxLen:
    value: i32

fn max_len(value: i32) -> MaxLen:
    MaxLen { value: value }

struct Profile:
    @max_len(80)
    name: string

@max_len(3) # diagnostic: decorator-target-kind
fn greet() -> string:
    "hi"
