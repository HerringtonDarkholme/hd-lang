# test: a function value that borrows from more inputs than the expected type permits is a type mismatch
# Spec 07 Lifetimes In Function Types: fn.type.lifetime.subtype.error.
struct User:
    name: string

fn either['a](a: &'a User, b: &'a User) -> &'a User:
    if a.name.len() >= b.name.len(): a else: b

fn use_left['a, 'b](f: fn(&'a User, &'b User) -> &'a User, a: &'a User, b: &'b User) -> usize:
    f(a, b).name.len()

fn demo(a: &User, b: &User) -> usize:
    use_left(either, a, b) # diagnostic: type-mismatch
