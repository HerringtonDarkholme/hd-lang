# fixture-test-layout: integration
# test: an integration test must bind a user capability that its profile does not provide
# Spec 10 Test Outcomes: module.testing.integration-row.unbound, module.testing.kind-decides.
trait Repo:
    fn count(self) -> i32

fn total() -> i32 $ Repo:
    $.use(Repo).count()

it("needs a repo"):
    _ := total()  # diagnostic: missing-requirement
