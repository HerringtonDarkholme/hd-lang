# test: the uniqueness rule applies to a tuple template: a second one for the trait is an error
# Spec 14 Tuple Templates: annot.template.tuple.rules.
use std.function.Tuple
use std.structure.{Structure, Field, Variant, Walker}

trait Encode:
    fn encode(self) -> string

impl Encode for i64:
    fn encode(self) -> string:
        "$self"

impl Encode for string:
    fn encode(self) -> string:
        "'$self'"

data Encoder:
    out: string

impl[S] Walker[S] for Encoder:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Encode](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.out = self.out + value.encode() + ";"
        .Ok(())

impl[T < Tuple] Encode for T by Structure:
    fn encode(self) -> string:
        let mut w = Encoder { out: "" }
        _ := Structure::walk(self, w)
        w.out

impl[T < Tuple] Encode for T by Structure:  # diagnostic: overlapping-impl
    fn encode(self) -> string:
        let mut w = Encoder { out: "again" }
        _ := Structure::walk(self, w)
        w.out
