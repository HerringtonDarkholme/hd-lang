# test: it_prop requires its input type to implement Debug
# Spec Modules, Registration Calls: module.testing.reg.prop-debug.
use std.testing.{Arbitrary, Choices, it_prop}

struct Reading:
    level: i64

impl Arbitrary for Reading:
    fn arbitrary(c: &mut Choices) -> Reading:
        Reading { level: c.int(0..=9) }

tests:
    it_prop( # diagnostic: unsatisfied-trait-bound
        "levels stay small",
        prop=fn!(reading: Reading): pass
        ,
    )
