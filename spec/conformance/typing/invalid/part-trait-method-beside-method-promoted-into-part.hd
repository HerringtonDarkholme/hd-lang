# test: lookup that starts at a part meets the part's Display method and a to_string promoted into the part, so the call is ambiguous
struct Base:
    pub name: string

impl Base:
    pub fn to_string(self) -> string:
        "base " + self.name

struct Label:
    Base

impl Display for Label:
    fn to_string(self) -> string:
        "label"

struct Page:
    Label

fn invalid(page: Page) -> string:
    page.Label.to_string()  # diagnostic: ambiguous-method
