# test: a bare literal defaults to usize, a primitive distinct from i32 and u32
# Spec 04 The usize Type: types.usize.primitive; Open Literal Width: types.literal.local.default, types.literal.local.method.
fn take_i32(x: i32) -> i32:
    x

fn run() -> i32:
    total := 0
    text := total.to_string()
    take_i32(total) # diagnostic: type-mismatch
