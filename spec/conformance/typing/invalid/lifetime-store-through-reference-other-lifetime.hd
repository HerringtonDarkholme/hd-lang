# test: a store through a `&mut` parameter of a value whose positions swap the place's lifetimes is an error
# Spec 13 Lifetime Stores: ref.lifetime.store.
struct Two['a, 'b]:
    x: &'a string
    y: &'b string

fn swap_all['a, 'b](t: &mut Two['a, 'b], a: &'a string, b: &'b string) -> void:
    *t = Two { x: b, y: a } # diagnostic: local-reference-escapes
