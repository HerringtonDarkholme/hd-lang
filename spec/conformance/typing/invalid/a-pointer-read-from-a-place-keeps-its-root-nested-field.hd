# test: a dependent local loan protects the pointer slot that keeps its pointee alive
struct P:
    name: string

fn name_of(p: &P) -> &string:
    &p.name

struct H:
    p: *P

pub fn main() -> void $ Console:
    let mut ps = [H { p: box(P { name: "a${1}" }) }]
    d := &ps[0].p.name
    ps[0] = H { p: box(P { name: "b${2}" }) } # diagnostic: conflicting-access
    junk := "cccccc${3}"
    println("${*d} $junk")
