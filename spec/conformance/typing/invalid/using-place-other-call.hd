# test: only the dispose changes a using binding that holds its value; another &mut self call on it is an error
# Spec lang/06 Using Bindings: flow.using.place.
use std.ops.Disposable

struct Lock:
    name: string

impl Lock:
    fn rename(&mut self, name: string) -> void:
        self.name = name

impl Disposable for Lock:
    fn dispose!(&mut self) -> void:
        pass

fn swap!() -> void:
    using lock = Lock { name: "a" }
    lock.rename("b") # diagnostic: not-writable
