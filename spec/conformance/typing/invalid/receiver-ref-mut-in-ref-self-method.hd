# Spec 07 Reference Receivers: fn.method.auto-address.shared-reference. In a `&self` method, `self` is a `&Self`, so a `&mut self` call through it is an error.
struct Point:
    x: i32
    y: i32

impl Point:
    fn shift(&mut self, dx: i32) -> void:
        self.x += dx

    fn peek(&self) -> i32:
        self.shift(1) # diagnostic: not-writable
        self.x
