# test: a returned closure cannot capture a dependent result outside a direct function-parameter call
# Spec 13 Dependent Results: ref.dep.call.local; Local References: ref.local.escape.capture-stored.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

fn later(u: &User) -> fn() -> usize:
    n := u.name()
    fn() -> usize: n.len() # diagnostic: local-reference-escapes
