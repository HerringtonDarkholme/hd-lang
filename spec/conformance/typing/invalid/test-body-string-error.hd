# test: ? in a trailing test body converts only errors that implement Error
# Spec 05 Propagation In Test Blocks: a body that uses ? has result Result[void, Error],
# and i64 does not implement std.error.Error.
fn lookup(key: i64) -> Result[i32, i64]:
    .Err(key)

tests:
    use std.testing.assert

    it("an error that is not an Error does not convert"):
        value := lookup(80)?  # diagnostic: invalid-result-propagation
        assert(value > 0, reason="a positive port")
        .Ok(())
