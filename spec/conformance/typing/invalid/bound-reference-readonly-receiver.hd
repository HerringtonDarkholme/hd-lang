# test: a bound reference to a &mut self method needs a writable receiver
# Spec 07 Method References: fn.ref.bound.address.writable (Method References MR1).

struct Counter:
    value: i32

impl Counter:
    fn bump(&mut self, by: i32) -> void:
        self.value = self.value + by

fn frozen(counter: Counter) -> fn(i32) -> void:
    counter::bump # diagnostic: not-writable
