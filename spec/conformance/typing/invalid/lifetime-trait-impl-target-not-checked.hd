# test: a lifetime written in a trait implementation's target is references-not-yet-checked
# Spec 13 Lifetime Variables: ref.lifetime.not-yet.trait-target.
struct Parser[T, 'src]:
    src: &'src T
    pos: usize

trait Source:
    fn text(&self) -> &string

impl['a] Source for Parser[string, 'a]: # diagnostic: references-not-yet-checked
    fn text(&self) -> &string:
        self.src
