# test: a suspending function does not match the pattern fn(T) -> R, as it could not be passed to a parameter of that type
# Spec 14 Member-Typed Facts: annot.typed-fact.infer.suspending, reported at the decorator (batch 50, 2026-10-02).
use std.annotation.annotate
use std.num.Num

@annotate::[fn(T) -> R](.Fn)
data FnFact[T < Num, R]: pass

fn fn_fact[T < Num, R]() -> FnFact[T, R]:
    FnFact::[T, R] {}

data Duration:
    millis: i32

@fn_fact
fn ms(n: i32) -> Duration:
    Duration { millis: n }

@fn_fact  # diagnostic: type-mismatch
fn later!(n: i32) -> Duration:
    Duration { millis: n }
