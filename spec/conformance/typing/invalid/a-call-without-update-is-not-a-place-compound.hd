# test: a call without update is not a place
# Spec 05 Callable Values: expr.call.apply.place.
use std.ops.Apply

struct Counter:
    hits: i32

impl Apply for Counter:
    type Out = i32
    fn apply(self) -> i32: self.hits

fn run(counter: &mut Counter) -> void:
    counter() += 2  # diagnostic: invalid-assignment-target
