# test: deriving Deserialize for a type with a member that has no Deserialize is an error at the opt-in
# Spec Annotations, Serialization: annot.serde.members, annot.serde.members.error.
use std.serde.Deserialize

struct Signature:
    digest: string

@derive(Deserialize)  # diagnostic: member-not-derivable
struct Release:
    version: string
    signature: Signature
