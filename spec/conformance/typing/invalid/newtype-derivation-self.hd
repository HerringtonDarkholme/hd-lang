# test: a derived newtype rejects tuple Self even when its base implements the trait
# Spec lang/09-traits.md: trait.derive.newtype.self-error.

trait Pairing:
    fn pair(self) -> (Self, i32)

impl Pairing for string:
    fn pair(self) -> (string, i32):
        (self, 0)

@derive(Pairing) # diagnostic: newtype-derivation-self
type Tag(string)
