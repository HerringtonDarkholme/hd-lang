# test: a type inside a boundary type needs both traits too: a pub field whose type has a private field and no implementation is an error at the signature
# Spec Modules, Private Fields At A Boundary: module.boundary.error, module.boundary.out.
# fixture-runtime-profile: consent-vault
pub data Badge:
    pub label: string
    code: i64

pub data Token:
    pub owner: string
    pub badge: Badge

pub trait Vault:
    fn keep(self, token: Token) -> Token  # diagnostic: boundary-private-field

pub fn main() -> void $ Vault:
    _ := $.use(Vault).keep(Token { owner: "ada", badge: Badge { label: "staff", code: 7 } })
