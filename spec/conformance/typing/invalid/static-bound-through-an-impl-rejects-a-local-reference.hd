# test: an impl static sub-obligation rejects a non-static reference
# Spec 13 Static Bound: ref.generic.static.impl and ref.generic.static.error.
trait Saved:
    fn number(&self) -> i32

struct Wrapped[T]:
    value: T

impl[T < 'static] Saved for Wrapped[T]:
    fn number(&self) -> i32:
        +7

fn saved[T < Saved](value: T) -> i32:
    value.number()

fn rejected['a](value: Wrapped[&'a i32]) -> i32:
    saved(value) # diagnostic: local-reference-escapes
