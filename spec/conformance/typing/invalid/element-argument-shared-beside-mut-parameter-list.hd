# test: a call that takes &mut of a list reached through a &mut parameter beside a shared reference to one of its elements conflicts
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.conflict.reference.
fn change(list: &mut List[i32], first: &i32) -> i32:
    list.extend([+3])
    *first

fn through(list: &mut List[i32]) -> i32:
    change(list, &list[0]) # diagnostic: conflicting-access
