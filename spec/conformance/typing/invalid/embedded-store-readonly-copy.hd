# test: storing a readonly part with a mut composite field into an embedded field is mutable-upgrade
# Spec 04 Field Stores: types.path.store-embedded.
data Ledger:
    entries: mut List[i32]

data Account:
    Ledger
    owner: string

fn restore(account: mut Account, saved: Ledger) -> void:
    account.Ledger ...= saved  # diagnostic: mutable-upgrade
