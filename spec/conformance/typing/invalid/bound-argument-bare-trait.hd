# test: a bare trait name in a bound's trait argument is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions.

trait Source[T]:
    fn read(self) -> T

trait Factory:
    fn create() -> Self

fn drain[S < Source[List[Factory]]](source: S) -> void:  # diagnostic: trait-used-as-type
    pass
