# test: a `&Counter` never converts to `&mut dyn Inspectable`
# Spec 09 Trait Value References: a shared reference never becomes a mutable trait value reference.
# Spec 09 Traits: trait.dyn.ref.no-upgrade.
use std.inspect.Inspectable

struct Counter:
    count: i32

fn keep(value: &mut dyn Inspectable) -> void:
    pass

fn erase(counter: &Counter) -> void:
    keep(counter)  # diagnostic: mutable-upgrade
