# test: erasing a readonly value to mut Inspectable is a mutable upgrade
# Spec 09 Erasure To Inspectable: erasing to mut Inspectable requires mutable access to the source.
# Spec 09 Traits: trait.erase.mut.source.
use std.inspect.Inspectable

data Counter:
    count: i32

fn keep(value: mut dyn Inspectable) -> void:
    pass

fn erase(counter: Counter) -> void:
    keep(counter)  # diagnostic: mutable-upgrade
