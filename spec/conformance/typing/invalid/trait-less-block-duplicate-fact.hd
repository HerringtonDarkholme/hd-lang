# test: the += of a block with no trait appends after the decorator values, so a second value of one type is a duplicate
use std.structure.Structure

struct MaxLen:
    value: i32

fn max_len(value: i32) -> MaxLen: MaxLen { value: value }

struct User:
    @max_len(80)
    name: string

impl User by Structure:
    name += [max_len(10)]  # diagnostic: duplicate-fact
