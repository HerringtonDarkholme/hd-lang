# test: a closure that captures a local reference, for a field of a type parameter with no lifetime bound, is local-reference-escapes
# Spec 13 Lifetime Bounds: ref.generic.outlives.field; Local References: ref.local.escape.capture-stored.
use std.function.Fn

struct Counter:
    n: i32

struct Plain[F < Fn() -> void]:
    on_click: F

fn keep(c: &mut Counter) -> void:
    p := Plain { on_click: fn(): c.n += 1 } # diagnostic: local-reference-escapes
    (p.on_click)()
