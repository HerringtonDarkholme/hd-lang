# test: generic call inference never widens a number to join two arguments
# Spec 04 Inference From Several Arguments: types.generic.infer.join.no-widen (INF-mut, owner
# decision 2026-09-30). An i32 and an i64 argument of one T are a type-mismatch.

fn max[T < Ord](left: T, right: T) -> T:
    match left.cmp(right):
        .Less => right
        _ => left

fn widest(small: i32, large: i64) -> i64:
    max(small, large)  # diagnostic: type-mismatch
