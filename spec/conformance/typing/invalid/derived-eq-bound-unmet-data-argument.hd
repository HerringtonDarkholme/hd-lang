# test: a derived Eq on a generic type is unusable at a type argument that lacks Eq
# Spec 09 Derived Implementations: trait.derive.bounds, trait.derive.bound-unmet.
@derive(Eq)
struct Labeled[T]:
    label: string
    value: T

struct Socket:
    port: i32

fn same(left: Labeled[Socket], right: Labeled[Socket]) -> bool:
    left == right  # diagnostic: missing-derived-bound
