# test: a trait-qualified call names only a member its trait declares, not a supertrait's
# Spec 09 Trait-Qualified Calls: trait.qualified.declaring (owner decision 2026-10-06).

trait Parent:
    fn id(self) -> i32

trait Child < Parent:
    fn label(self) -> string

data Item: pass

impl Parent for Item:
    fn id(self) -> i32: 1

impl Child for Item:
    fn label(self) -> string: "item"

fn show(item: Item) -> i32:
    first := Parent::id(item)
    Child::id(item)  # diagnostic: unknown-method
