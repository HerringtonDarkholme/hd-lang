# test: a place whose type does not implement AnyVal needs an assign implementation, even with Add
# Spec 05 Compound Assignment: expr.assign.compound.ref-no-impl (Operator Traits OP5, OP10).
use std.ops.Add

data Score:
    points: i64

impl Add[Score] for Score:
    type Out = Score
    fn add(self, rhs: Score) -> Score:
        Score { points: self.points + rhs.points }

fn invalid(score: mut Score, bonus: Score) -> void:
    score += bonus  # diagnostic: type-mismatch
