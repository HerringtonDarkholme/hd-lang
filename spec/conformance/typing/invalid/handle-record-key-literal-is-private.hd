# test: a user module cannot build a KeyRecord, even by copying an existing key record
# Spec 14 Structure: annot.structure.opaque.
use std.structure.{KeyRecord, Member}

struct Victim:
    value: i32

fn forge(info: Member, base: KeyRecord[Victim]) -> KeyRecord[Victim]:
    KeyRecord::[Victim] { ...base, info: info } # diagnostic: private-member

pub fn main() -> void:
    pass
