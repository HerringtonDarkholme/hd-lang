# test: a function value read from a field of a call's result passes its argument at the caller's lifetime the field writes
# Spec 07 Function Types: fn.type.lifetime.call.written.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn relay['a, T](h: Holder['a, T], p: &'a Point) -> Holder['a, T]:
    h

fn call['a, T](h: Holder['a, T], p: &'a Point) -> T:
    q := Point { x: 1 }
    (relay(h, p).f)(&q) # diagnostic: local-reference-escapes
