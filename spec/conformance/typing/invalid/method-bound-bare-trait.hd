# test: a bare trait name in a trait argument in a trait method's parameter bound, against a trait declared later is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions; Spec 03 Module Scope: names.module.order-free.

trait Consumer:
    fn consume[S < Source[Factory]](self, source: S) -> void  # diagnostic: trait-used-as-type

trait Source[T]:
    fn read(self) -> T

trait Factory:
    fn create() -> Self
