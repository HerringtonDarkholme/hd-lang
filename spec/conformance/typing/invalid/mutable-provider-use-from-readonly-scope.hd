# test: requirements / mutable providers / retrieve mut from readonly scope

pub fn main() -> void:
    let counter: mut MemoryCounter = MemoryCounter { value: 0 }
    $.with(Counter=counter):
        $.use(mut Counter).bump()  # diagnostic: mutable-upgrade

trait Counter:
    fn count(self) -> i32
    fn bump(mut self) -> void

data MemoryCounter:
    value: i32

impl Counter for MemoryCounter:
    fn count(self) -> i32:
        self.value

    fn bump(mut self) -> void:
        self.value = self.value + 1
