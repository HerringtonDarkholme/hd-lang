# test: a type has at most one block with no trait, so a second one overlaps the first
# Spec 14 Derivation Blocks With No Trait: annot.no-trait.unique (M28).
use std.structure.Structure

struct Tag:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

struct User:
    name: string
    email: string

impl User by Structure:
    name += [tag("n")]

impl User by Structure:  # diagnostic: overlapping-impl
    email += [tag("e")]
