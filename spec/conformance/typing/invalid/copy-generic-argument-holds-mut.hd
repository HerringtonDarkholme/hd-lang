# test: a value that holds a `&mut` is not an argument for a `Copy` type parameter
# Spec 13 Copy: ref.copy.generic.default, ref.copy.generic.argument.
struct Writer['a]:
    target: &'a mut List[i32]

fn dup[T < Copy](x: T) -> (T, T): (x, x)

pub fn main() -> void $ Console:
    let mut items: List[i32] = [+1, 2, 3]
    writer := Writer { target: &mut items }
    pair := dup(writer) # diagnostic: unsatisfied-trait-bound
    println("${pair._0.target.len()}")
