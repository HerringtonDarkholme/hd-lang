# test: an impl method declares exactly as many generic parameters as the trait method
# Spec 09 Traits: trait.impl.generics.count, trait.impl.generics.error.

trait Identity:
    fn select[T](self, value: T) -> T

data Picker: pass

impl Identity for Picker:
    fn select[T, U](self, value: T) -> T: value  # diagnostic: trait-method-signature
