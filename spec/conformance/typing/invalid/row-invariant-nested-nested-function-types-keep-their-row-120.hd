# test: nested function types keep their row
trait Db

trait Clock

fn narrow() -> void $ Db:
    pass

fn other() -> void $ Db:
    pass

struct Holder[T]:
    item: T

struct View[+T]:
    item: T

struct Slot:
    handler: fn() -> void $ Db + Clock

fn run(maker: fn() -> (fn() -> void $ Db + Clock)) -> void:
    pass

fn wire(maker: fn() -> (fn() -> void $ Db)) -> void:
    run(maker)  # diagnostic: type-mismatch
