# test: a trait-qualified call whose `Self` is a trait value reference reaches no opaque-result member
# Spec 09 Dynamic Safety: trait.dyn.member.unavailable.error; the
# by-value receiver makes `Self` the `&dyn Tr` argument, so the call goes
# through the trait value.
trait Tr:
    fn show(self) -> impl Display

fn f(v: &dyn Tr) -> void:
    let a = Tr::show(v) # diagnostic: dyn-member-unavailable
