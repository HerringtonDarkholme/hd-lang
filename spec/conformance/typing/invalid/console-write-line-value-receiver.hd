# test: prelude / Console / a provider whose write_sync takes mut self does not match the &mut self method
# Spec 10 Console: module.console.write-sync-ref.mutable.
struct Quiet:
    count: i32

impl Console for Quiet:
    fn write_sync(mut self, text: string) -> Result[void, ConsoleError]: # diagnostic: trait-method-signature
        .Ok(())
