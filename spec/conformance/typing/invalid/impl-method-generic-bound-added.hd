# test: an impl method may not add a bound to the trait method's generic parameter
# Spec 09 Traits: trait.impl.generics.fixed-bounds, trait.impl.generics.error.

trait Show:
    fn show(self) -> string

trait Tag:
    fn tag(self) -> string

trait Describe:
    fn describe[T](self, value: T) -> string

data Describer: pass

impl Describe for Describer:
    fn describe[T < Show](self, value: T) -> string: value.show()  # diagnostic: trait-method-signature
