# Spec 11 Providers Behind References: req.ref.install-ref. A struct value installed for a trait with a `&mut self` method; the provider is a trait value reference, so `&mut tally` is written.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> void:
    let mut tally = Tally { n: 0 }
    $.with(Counter=tally):  # diagnostic: type-mismatch
        pass
