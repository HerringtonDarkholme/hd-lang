# Spec 11 Keys Of Reference Receiver Traits: req.ref.install-value. A struct value installed for a trait with a `&mut self` method is an error; the provider is boxed up front.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> void:
    let mut tally = Tally { n: 0 }
    $.with(Counter=tally): # diagnostic: type-mismatch
        pass
