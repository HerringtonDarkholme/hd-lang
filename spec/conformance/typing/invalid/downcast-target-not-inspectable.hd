# test: a downcast target that fails the Inspectable bound is rejected
# Spec 09 Recovering A Concrete Type: A function type is not Inspectable, so it fails the bound.
# Spec 09 Traits: trait.downcast.bound, trait.downcast.concrete-target.
use std.inspect.Inspectable

fn shown(value: *dyn Inspectable) -> bool:
    match value.downcast_ref::[fn() -> i32](): # diagnostic: unsatisfied-trait-bound
        .Some(_) => true
        .None => false
