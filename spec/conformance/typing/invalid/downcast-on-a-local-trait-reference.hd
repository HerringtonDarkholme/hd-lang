# test: a downcast result cannot outlive the local concrete value behind its trait reference
# Spec 09 Recovering A Concrete Type: trait.downcast.local-receiver; Spec 13: ref.dep.scope.
use std.inspect.Inspectable

struct User:
    count: i32

struct Pair:
    a: User
    b: User

fn read_after_scope(use_inner: bool) -> i32:
    fallback := User { count: 0 }
    let found: &User = &fallback
    if use_inner:
        pair := Pair { a: User { count: 1 }, b: User { count: 2 } }
        let erased: &dyn Inspectable = &pair.b
        match erased.downcast_ref::[User]():
            .Some(user) => found = user
            .None => pass
    found.count # diagnostic: local-reference-outlives-local
