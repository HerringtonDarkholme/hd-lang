# test: a local trait value reference has no downcast
# Spec 09 Recovering A Concrete Type: trait.downcast.counted-receiver.
use std.inspect.Inspectable

struct User:
    count: i32

struct Pair:
    a: User
    b: User

fn leak(p: &Pair) -> *User:
    let erased: &dyn Inspectable = &p.b
    match erased.downcast_ref::[User](): # diagnostic: local-reference-escapes
        .Some(u) => u
        .None => box(User { count: 0 })
