# test: a public impl's associated type binding must not name a private type
# Spec 10 Public Signatures: module.vis.signature.coverage.
struct Hidden:
    n: i32

pub trait Make:
    type Out
    fn make(self) -> Self::Out

pub struct Maker:
    k: i32

impl Make for Maker:
    type Out = Hidden # diagnostic: private-type-leak
    fn make(self) -> Hidden:
        Hidden { n: self.k }
