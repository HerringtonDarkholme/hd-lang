# test: a suffix function whose required parameter is not numeric is an error at its definition
# Spec 05 Literal Suffixes: expr.literal-fn.definition; `@num_suffix` on `fn em(label: string)`.
use std.ops.num_suffix

data Pixels:
    count: i32

@num_suffix
fn em(label: string) -> Pixels:  # diagnostic: type-mismatch
    Pixels { count: 0 }
