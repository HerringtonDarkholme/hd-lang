# test: decoding into a type that has no Deserialize consent is an error
# Spec std/json Encode And Decode: std-json.decode.consent (task #241, #320).
use std.json.{decode, JsonError}

data Plain:
    id: i32

fn load(text: string) -> Result[Plain, JsonError]:
    decode::[Plain](text)  # diagnostic: unsatisfied-trait-bound
