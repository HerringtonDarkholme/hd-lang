# test: least common type functions with different results and rows have no common type
# Spec lang/04-type-system.md: types.lct.sites.

trait Db

trait Clock

fn health() -> string $ Clock:
    "ok"

fn orders() -> string $ Db:
    "orders"

fn count() -> i32 $ Clock:
    1

fn f() -> void:
    _v := [orders, count] # diagnostic: no-common-type
