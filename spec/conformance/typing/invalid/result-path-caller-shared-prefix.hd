# test: result references with paths of one parameter lock the fields those paths share, not each path
# Spec 13 Result Paths: ref.result.path.caller.whole.
struct Name:
    first: string
    last: string
    title: string

struct User:
    name: Name
    age: i32

impl User:
    fn parts(&self) -> (&'self.name.first string, &'self.name.last string):
        (&self.name.first, &self.name.last)

fn retitle(u: &mut User) -> void $ Console:
    p := u.parts()
    u.name.title = "Dr" # diagnostic: conflicting-access
    println(*p._0)
