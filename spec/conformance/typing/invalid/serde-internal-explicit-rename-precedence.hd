# test: a declaration Rename remains ahead of a per-trait RenameAll without a duplicate collision
# Rule: std-serde.enum-tagging.internal-name-conflict.
use std.serde.{RenameAll, RenameCase, Serialize, rename, tag}
use std.structure.Structure

@tag("kind")
enum Message:
    Text(
        @rename("kind")
        value: string, # diagnostic: enum-tag-name-conflict
    )

impl Serialize for Message by Structure:
    Self += [RenameAll { style: RenameCase.CamelCase }]

pub fn main() -> void:
    _ := Message.Text(value="hello")
