# test: inherent recovery needs an original reference payload, so a bare erased value cannot be addressed or auto-addressed
# Spec 09 Trait Value References: trait.dyn.ref.bare-reference-method; Ordinary Rules For Recovery: trait.downcast.reference-receivers.
use std.inspect.Inspectable
struct User:
    count: i32
fn address(value: dyn Inspectable) -> void:
    _ := &value  # diagnostic: dyn-member-unavailable
