# test: an arbitrary.with generator must draw the member's declared type
# std Testing, Derived Arbitrary: std-testing.arbitrary.with.checked, by annot.typed-fact.bind
# (owner decision O7, batch 36, 2026-10-01).
use std.testing.{Arbitrary, Choices}
use std.testing.arbitrary

fn label(c: mut Choices) -> string:
    c.string(max_chars=4)

@derive(Arbitrary, Debug)
data Item:
    @arbitrary.with(label)  # diagnostic: type-mismatch
    price: i32
