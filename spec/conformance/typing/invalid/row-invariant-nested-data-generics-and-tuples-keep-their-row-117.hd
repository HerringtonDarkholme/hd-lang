# test: data generics and tuples keep their row
trait Db

trait Clock

fn narrow() -> void $ Db:
    pass

fn other() -> void $ Db:
    pass

struct Holder[T]:
    item: T

struct View[+T]:
    item: T

struct Slot:
    handler: fn() -> void $ Db + Clock

fn show(v: View[fn() -> void $ Db + Clock]) -> void:
    pass

fn wire(v: View[fn() -> void $ Db]) -> void:
    show(v) # diagnostic: type-mismatch
