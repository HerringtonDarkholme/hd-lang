# test: a hand-written Display beside @error overlaps the generated one
# Spec 14 Error Types: annot.error.hand-written is reported on the hand-written implementation.
use std.error.Error

@error
enum ReadError:
    @error("closed")
    Closed

impl Display for ReadError:  # diagnostic: overlapping-impl
    fn to_string(self) -> string: "read error"
