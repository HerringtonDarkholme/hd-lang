# test: a read through a reborrow of a field returned as a reference of the other lifetime escapes
# Spec 13 Origins: ref.dep.origin.position.union; Lifetime Variables: ref.lifetime.return.
struct Two['a, 'b]:
    x: &'a string
    y: &'b string

fn read_other['a, 'b](t: &Two['a, 'b]) -> &'b string:
    r := &t.x
    *r # diagnostic: local-reference-escapes
