# test: a position a newtype cannot forward is an error at the derive
# Spec lang/09-traits.md: trait.derive.newtype.self-error.

trait Index < Eq & Hash:
    fn by(self) -> Map[Self, i32]

impl Index for string:
    fn by(self) -> Map[string, i32]:
        { self: 0 }

@derive(Eq, Hash, Index) # diagnostic: newtype-derivation-self
type Tag(string)
