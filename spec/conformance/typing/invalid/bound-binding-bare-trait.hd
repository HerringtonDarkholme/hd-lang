# test: a bare trait name in a bound's associated binding value is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions.

trait Store:
    type Item
    fn load(self) -> Self::Item

trait Factory:
    fn create() -> Self

fn open[S < Store[Item = Factory]](source: S) -> void:  # diagnostic: trait-used-as-type
    pass
