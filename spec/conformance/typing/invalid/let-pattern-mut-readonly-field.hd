# test: a mut name in a let data pattern never upgrades a readonly field
# Spec 04 Binding Forms: types.bind.let-pattern-mut.data-field, types.bind.let-mut-upgrade.view (owner decision LP1, batch 26, 2026-09-30).
data User:
    name: string

data Profile:
    name: string
    owner: mut User

fn rename(profile: mut Profile, readonly: Profile) -> void:
    let Profile { mut owner, name } = profile  # mut User, string
    owner.name = name
    let Profile { owner: mut other } = readonly  # diagnostic: mutable-upgrade
