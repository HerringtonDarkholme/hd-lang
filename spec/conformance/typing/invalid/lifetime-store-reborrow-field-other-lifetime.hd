# test: a store through a reborrow of a nested field takes only the lifetime of that field's position
# Spec 13 Lifetime Stores: ref.lifetime.store.field.
struct Two['a, 'b]:
    x: &'a string
    y: &'b string

struct Outer['a, 'b]:
    inner: Two['b, 'a]

fn bad_reborrow['a, 'b](t: &mut Outer['a, 'b], s: &'a string) -> void:
    r := &mut t.inner
    r.x = s # diagnostic: local-reference-escapes
