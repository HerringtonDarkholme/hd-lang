# test: requirements / mutable providers / $.use of a trait without mut self methods is readonly

fn label() -> string $ Tag:
    let tag: mut Tag = $.use(Tag)  # diagnostic: mutable-upgrade
    tag.name()

pub fn main() -> void:
    let tag: mut NameTag = NameTag { value: "a" }
    $.with(Tag=tag):
        _ := label()

trait Tag:
    fn name(self) -> string

data NameTag:
    value: string

impl Tag for NameTag:
    fn name(self) -> string:
        self.value
