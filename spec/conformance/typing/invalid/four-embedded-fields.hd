# test: a fourth embedded field is an error at the declaration
# Spec 08 Embedding Limits: data.embed.width.
struct Created:
    created_at: i32

struct Updated:
    updated_at: i32

struct Owned:
    owner: string

struct Tagged:
    tag: string

struct Post:
    Created
    Updated
    Owned
    Tagged  # diagnostic: too-many-embedded-fields
    title: string
