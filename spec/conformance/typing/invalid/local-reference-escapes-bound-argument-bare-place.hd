# test: a value of a bare type parameter stored into a `&mut T` place is checked at the call that builds it
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument; Lifetime
# Stores: ref.lifetime.store.call. `*d = s.make(&q)` would put a value
# built from `q` into the caller's `T` place, but `s.make(&q)` already
# passes `&q` at `'a`, which `q` does not outlive.
struct Point:
    x: i32

trait Mk['b, T]:
    fn make(&self, v: &'b Point) -> T

fn bad['a, T, S < Mk['a, T]](s: &S, d: &mut T, p: &'a Point) -> void:
    q := Point { x: 1 }
    *d = s.make(&q) # diagnostic: local-reference-escapes
