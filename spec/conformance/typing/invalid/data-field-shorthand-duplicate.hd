# test: a shorthand field counts as a field: value entry, so naming the field again is a duplicate
# Spec 08 Field Shorthand: data.literal.shorthand.rules.
data Coordinate:
    lat: i32
    lon: i32

fn pin(lat: i32, lon: i32) -> Coordinate:
    Coordinate { lat, lon, lat: 0 }  # diagnostic: duplicate-field
