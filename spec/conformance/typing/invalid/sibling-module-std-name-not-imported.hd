# test: a std name that another module of the same package imports is not in scope without a use here
# Spec 03 Module Scope: names.module.use-own-module. The tree's label module
# writes use std.cmp.max; this module does not.
# fixture-package-tree: module-names/src/receipt.hd
use pkg.label.{double}

fn quadruple(count: i32) -> i32:
    double(double(count))

fn larger(a: i32, b: i32) -> i32:
    max(a, b)  # diagnostic: unknown-name

tests:
    it("quadruples the count"):
        assert_equal(quadruple(+2), 8, reason="two four times")
