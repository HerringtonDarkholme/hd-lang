# test: a write late in a loop conflicts with a shared reference the next iteration reads
# Spec 13 Writes While Borrowed: ref.excl.shared, ref.excl.live.
struct User:
    name: string
    age: i32

fn repeat(u: &mut User) -> void $ Console:
    r := &u.name
    for i in 0..3:
        println(*r)
        u.name = "x" # diagnostic: conflicting-access
