# test: a provider for a bound key must bind the associated type to the stated type
# Spec 11 Provider Scopes: req.with.type.binding (owner decision AT5).

trait Store:
    type Item
    fn load(self, id: string) -> Self::Item

data User:
    name: string

data Post:
    title: string

data PostStore: pass

impl Store for PostStore:
    type Item = Post
    fn load(self, id: string) -> Post: Post { title: id }

fn find(id: string) -> User $ Store[Item = User]:
    $.use(Store[Item = User]).load(id)

fn serve(id: string) -> User:
    $.with(Store[Item = User]=PostStore {}):  # diagnostic: type-mismatch
        find(id)
