# test: a shared field is no place, so a collection in it cannot be changed in place
# Spec 08 Shared Fields: data.shared.no-place.
enum Plan(label: string, features: List[string]):
    Free -> Plan("free", ["export"])
    Team -> Plan("team", ["export", "sso"])

fn add_feature(plan: Plan) -> void:
    plan.features.push("audit-log") # diagnostic: not-writable
