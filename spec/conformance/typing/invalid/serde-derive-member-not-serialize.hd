# test: deriving Serialize for a type with a member that has no Serialize is an error at the opt-in
# Spec Annotations, Serialization: annot.serde.members, annot.serde.members.error (task #320).
use std.serde.Serialize

struct Secret:
    value: i32

@derive(Serialize)  # diagnostic: member-not-derivable
struct Account:
    id: i32
    secret: Secret
