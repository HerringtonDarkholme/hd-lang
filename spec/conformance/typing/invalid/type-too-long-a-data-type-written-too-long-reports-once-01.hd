# test: a data type written too long reports once
type Both[A, B] = (A, B)

trait Show:
    fn show(self) -> string

trait Conv[T]:
    fn conv(self) -> T

struct Pair[K, V]:
    key: K
    value: V

enum Choice[T]:
    Some(T)
    Empty

type Wrap[T](T)

fn f(p: Pair[i32, i32, i32]) -> i32: 0  # diagnostic: argument-count
