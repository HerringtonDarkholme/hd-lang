# test: a countdown counter that falls back to usize makes t >= 0 always true
# Spec 05 Unsigned Comparisons With Zero: expr.ord.unsigned-zero, expr.ord.unsigned-zero.end (SAFETY NET 1, batch 83).

fn countdown() -> void:
    let t = 10
    while t >= 0:  # diagnostic: unsigned-comparison-always
        t = t - 1
