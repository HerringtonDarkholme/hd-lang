# test: pointer loans, same root: passing a pointer as a `*T` and a `&mut` of its field to one call is a compile-time error in every variant
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn inspect(c: *Cell, f: &mut i32) -> void:
    *f += c.n

fn probe(view: *mut Cell) -> void:
    inspect(view, &mut view.n) # diagnostic: conflicting-access
