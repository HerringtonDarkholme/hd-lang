# test: pointer loans, same root: a `&mut self` call on the pointer while a call result that depends on it lives is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn borrow(b: &Cell) -> &i32:
    &b.n

fn probe(boxed: *mut Cell) -> i32:
    r := borrow(boxed)
    boxed.change() # diagnostic: conflicting-access
    *r
