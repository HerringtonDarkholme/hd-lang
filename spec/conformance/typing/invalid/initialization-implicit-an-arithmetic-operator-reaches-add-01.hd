# test: an arithmetic operator reaches add
# Spec lang/10-modules.md: module.init.definite.implicit.

struct Tag:
    n: i32
use std.ops.Add

first := Tag { n: 1 } + Tag { n: 2 } # diagnostic: top-level-read-before-initialization
later := +5

impl Add for Tag:
    type Out = i32
    fn add(self, rhs: Tag) -> i32: self.n + rhs.n + later

pub fn main() -> void $ Console:
    println(first)
