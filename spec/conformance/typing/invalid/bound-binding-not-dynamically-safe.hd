# test: a bound's associated binding value is a value type, so it must be dynamically safe
# Spec 09 Dynamic Safety: trait.dyn.safe.error.

trait Store:
    type Item
    fn load(self) -> Self::Item

trait Factory:
    fn create() -> Self

fn open[S < Store[Item = Factory]](source: S) -> void:  # diagnostic: trait-not-dynamically-safe
    pass
