# test: a &mut self call on a struct beside a reference to an element of a list field conflicts
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.conflict.reference.
struct Scores:
    all: List[i32]

impl Scores:
    fn add(&mut self, score: &i32) -> void:
        self.all.push(*score)

fn repeat_first(scores: &mut Scores) -> void:
    scores.add(&scores.all[0]) # diagnostic: conflicting-access
