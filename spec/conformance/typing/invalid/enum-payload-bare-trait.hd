# test: a bare trait name in an enum payload, against a trait declared later is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions; Spec 03 Module Scope: names.module.order-free.

enum Event:
    Created(Factory?)  # diagnostic: trait-used-as-type

trait Factory:
    fn create() -> Self
