# test: a fixed element without Default fails the bound and a rest list meets it
use std.ops.Default

struct Secret:
    value: i32

fn fresh[T < Default]() -> T:
    T::default()

fn hidden() -> (i32, List[Secret]...):
    fresh()

fn fixed() -> (Secret, List[i32]...):
    fresh() # diagnostic: unsatisfied-trait-bound
