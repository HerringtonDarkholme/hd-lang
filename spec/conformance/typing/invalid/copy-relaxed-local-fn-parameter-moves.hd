# test: a local function's `?Copy` type parameter moves, so a body that uses it twice is an error
# Spec 13 Copy: ref.copy.generic.relaxed.
pub fn main() -> void $ Console:
    fn twice[T < ?Copy](x: T) -> (T, T):
        (x, x) # diagnostic: use-of-moved-value
    pair := twice(+1)
    println("${pair._0}")
