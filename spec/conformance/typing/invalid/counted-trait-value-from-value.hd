# test: a value that is no reference does not convert to a counted trait value reference; a new object is written `box(e)`
# Spec 09 Trait Value References: trait.dyn.ref.counted.new.
trait Greet:
    fn greet(self) -> string

struct User:
    name: string

impl Greet for User:
    fn greet(self) -> string: "hi"

fn invalid(user: User) -> *dyn Greet:
    user # diagnostic: type-mismatch
