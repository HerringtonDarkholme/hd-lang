# test: a type parameter without an Inspectable bound is not inspectable
# Spec 09 Types That Are Not Inspectable: trait.inspectable.not.parameter; Limits Of Runtime Identity: trait.limit.signatures, trait.limit.signatures.branch.
use std.inspect.TypeId

fn kind_of[T](value: T) -> TypeId:
    TypeId::of::[T]()  # diagnostic: unsatisfied-trait-bound
