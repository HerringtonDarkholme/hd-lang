# test: a call's shared result locks its whole source, so writing another field while it is used later conflicts
# Spec 13 Writes While Borrowed: ref.excl.call.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &string:
        &self.name

fn birthday(u: &mut User) -> void $ Console:
    n := u.name()
    println(u.age)
    u.age += 1 # diagnostic: conflicting-access
    println(*n)
