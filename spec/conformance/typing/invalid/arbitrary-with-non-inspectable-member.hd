# test: a function-typed member that arbitrary.with tunes must still implement Arbitrary
# std Testing, Derived Arbitrary: std-testing.arbitrary.derive.member-bound and .derive.not-derivable
# (Testing Q5 and AT-with, 2026-09-30; O7-inspectable, batch 51); the derive reports it at the opt-in.
use std.testing.{Arbitrary, Choices}
use std.testing.arbitrary

fn digit_task(c: mut Choices) -> fn() -> i32:
    n := c.int(+0, 9)
    fn() -> i32: n

@derive(Arbitrary)  # diagnostic: member-not-derivable
data Task:
    @arbitrary.with(digit_task)
    run: fn() -> i32
