# test: a member that arbitrary.with tunes must have an inspectable type
# Spec 10 Derived Arbitrary: module.testing.arbitrary.with.inspectable (Testing Q5, owner decision 2026-09-30).
use std.testing.{Arbitrary, Choices}
use std.testing.arbitrary

fn digit(c: mut Choices) -> i32:
    c.int(0, 9)

@derive(Arbitrary)
data Task:
    @arbitrary.with(digit)  # diagnostic: unsatisfied-trait-bound
    run: fn() -> i32
