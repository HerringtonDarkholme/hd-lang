# test: a member that arbitrary.with tunes must have an inspectable type
# std Testing, Derived Arbitrary: std-testing.arbitrary.derive.member-bounds and .derive.not-derivable
# (Testing Q5 and AT-with, owner decisions 2026-09-30); the derive reports it at the opt-in.
use std.testing.{Arbitrary, Choices}
use std.testing.arbitrary

fn digit_task(c: mut Choices) -> fn() -> i32:
    n := c.int(0, 9)
    fn() -> i32: n

@derive(Arbitrary)  # diagnostic: unsatisfied-trait-bound
data Task:
    @arbitrary.with(digit_task)
    run: fn() -> i32
