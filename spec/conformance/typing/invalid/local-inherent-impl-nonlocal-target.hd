# test: a local inherent implementation must target a local nominal type
# Spec 09 Local Implementations: trait.impl.local.inherent (error-code proposal F4).

data Entry:
    name: string

fn describe(entry: Entry) -> string:
    impl Entry:  # diagnostic: local-impl-nonlocal-pair
        fn shout(self) -> string: self.name

    entry.name
