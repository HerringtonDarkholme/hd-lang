# test: value.method without an argument clause is a field read, so it never yields the method as a value
# Spec 05 Method Calls: expr.member.method-not-value.
struct Counter:
    start: i32

impl Counter:
    fn next(self) -> i32:
        self.start + 1

fn step(counter: Counter) -> fn() -> i32:
    counter.next # diagnostic: unknown-field
