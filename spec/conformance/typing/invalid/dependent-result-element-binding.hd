# test: an element result rooted in a by-value list cannot escape the function
# Spec 13 Dependent Results: ref.dep.origin.element, ref.dep.return.
struct User:
    name: string
    age: i32

fn pick(people: List[User], fallback: &User) -> &User:
    let mut best = fallback
    for p in &people:
        if p.name.len() > best.name.len():
            best = p
    best # diagnostic: local-reference-escapes
