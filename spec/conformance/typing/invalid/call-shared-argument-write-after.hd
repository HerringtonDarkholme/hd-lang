# test: an argument after a `&` of a place may not write that place
# Spec 13 Writes While Borrowed: ref.excl.args.shared.
fn referred(xs: &List[i32], last: Option[i32]) -> usize:
    xs.len()

fn drain() -> usize:
    let mut ys = [+1, 2]
    referred(&ys, ys.pop()) # diagnostic: conflicting-access
