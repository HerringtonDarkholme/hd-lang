# test: an explicit test body closure with an optional result does not implement Termination
# Spec 05 Propagation In Test Blocks: an explicit closure body keeps its own result, which
# must satisfy the Termination bound on `it`.
fn maybe() -> i32?:
    .None

tests:
    it("an optional result", body=fn!() -> i32?: maybe())  # diagnostic: unsatisfied-trait-bound
