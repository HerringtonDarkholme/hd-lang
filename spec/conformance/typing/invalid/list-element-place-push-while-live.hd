# test: a push to a list while an element reference is used later conflicts
# Spec 13 Writes While Borrowed: ref.excl.mut, ref.excl.call; Element References: ref.elem.list.
fn bump() -> void:
    let mut items = [+1, 2]
    first := &mut items[0]
    items.push(3) # diagnostic: conflicting-access
    *first += 1
