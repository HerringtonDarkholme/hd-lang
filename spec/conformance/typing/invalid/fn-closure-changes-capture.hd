# test: a closure that changes a captured local does not meet an Fn bound
# Spec Functions, Read-Only Fn Closures: fn.trait.read-only.
use std.function.Fn

fn read[F < Fn(i32) -> i32](f: F) -> i32:
    f(1)

fn invalid() -> i32:
    let total = +0
    read(
        fn(x): # diagnostic: not-writable
            total += x
            total
        ,
    )
