# Spec 09 Receivers Of Struct Implementations: trait.impl.receiver-bridge.other-uses. A default body calls the method through the trait's `mut self`, so a struct whose implementation does not write it cannot call it.
trait Counter:
    fn bump(mut self) -> void

    fn bump_twice(mut self) -> void:
        self.bump()
        self.bump()

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> i32:
    let mut tally = Tally { n: 0 }
    tally.bump_twice()  # diagnostic: unsatisfied-trait-bound
    tally.n
