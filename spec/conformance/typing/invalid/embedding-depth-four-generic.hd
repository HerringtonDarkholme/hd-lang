# test: the depth limit counts embedding through generic data types
# Spec 08 Embedding Limits: data.embed.depth.
struct Stamp:
    at: i32

struct Tag:
    Stamp
    label: string

struct Box[T]:
    Tag
    value: T

struct Shipment[T]:
    Box[T]
    id: string

struct Order:
    note: string
    Shipment[i32] # diagnostic: embedding-too-deep
