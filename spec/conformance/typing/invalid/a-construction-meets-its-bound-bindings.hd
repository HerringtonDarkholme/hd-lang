# test: a struct literal whose inferred argument's projection differs from its parameter's bound binding
# Spec 09 Associated Type Bindings: trait.binding.use-site.written.

trait Feed:
    type Item
    fn next(self) -> Self::Item

struct Words:
    w: string

impl Feed for Words:
    type Item = string
    fn next(self) -> string:
        self.w

struct Holder[F < Feed[Item = i32]]:
    f: F

fn make() -> void:
    let h = Holder { f: Words { w: "a" } } # diagnostic: unsatisfied-trait-bound
