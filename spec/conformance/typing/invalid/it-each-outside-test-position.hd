# test: it_each may be called only in test position
# Spec Modules, Registration Calls: module.testing.reg.calls; it_each takes only test registration calls, so a call inside a function is misplaced-test-case.
use std.testing.it_each

fn helper() -> void:
    it_each("doubles", [1, 2], body=fn!(value: i32): pass)  # diagnostic: misplaced-test-case
