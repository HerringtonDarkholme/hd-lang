# test: an existential parameter does not escape its arm as a concrete type
# Spec 13 Existential Parameters: gadt.existential.no-escape (error-code proposal F2).

enum Job:
    Apply[S < Display](input: S) -> Job

fn input(job: Job) -> i32:
    match job:
        Job.Apply(value) =>
            let n: i32 = value  # diagnostic: type-mismatch
            n
