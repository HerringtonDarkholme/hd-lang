# test: on a readonly receiver a promoted mut self method is found and rejected, never skipped for a deeper readonly method
data Resetter:
    count: i32

impl Resetter:
    pub fn reset(self) -> i32:
        0

data Wrapper:
    Resetter

data Counter:
    value: i32

impl Counter:
    pub fn reset(mut self) -> void:
        self.value = 0

data Page:
    Counter
    Wrapper

fn invalid(page: Page) -> void:
    page.reset()  # diagnostic: mutable-receiver-required
