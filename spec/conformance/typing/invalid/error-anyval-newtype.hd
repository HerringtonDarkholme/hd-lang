# test: Error has AnyRef as a supertrait, so a newtype over string cannot implement it
# Spec 09 Error Trait: trait.error.supertraits-anyref and trait.error.not-anyref are missing-supertrait-implementation (ERR-HELPERS; task #223).
use std.error.Error

type Message(string)

impl Display for Message:
    fn to_string(self) -> string: string(self)

impl Error for Message  # diagnostic: missing-supertrait-implementation
