# test: a trait reference satisfies only the matching generic trait instantiation
# Spec 09 Trait Values As Bounds: trait.dyn.bound.reference-binding.
trait Repository[T]:
    fn size(&self) -> i32
fn needs_text[T < Repository[string]](_value: T) -> void:
    pass
fn rejected(value: &dyn Repository[i32]) -> void:
    needs_text(value) # diagnostic: unsatisfied-trait-bound
