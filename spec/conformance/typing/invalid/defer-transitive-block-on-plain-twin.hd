# test: a defer suite may not reach block_on transitively; a plain helper is fine
use std.task.block_on

fn ready!() -> i32:
    1

fn drive() -> i32:
    let pending: mut Suspend[i32] = ready()
    block_on(pending)

fn plain() -> i32:
    1

fn cleanup_transitive() -> void:
    defer:
        _ := drive()  # diagnostic: suspension-forbidden-context
    pass

fn cleanup_plain() -> void:
    defer:
        _ := plain()
    pass
