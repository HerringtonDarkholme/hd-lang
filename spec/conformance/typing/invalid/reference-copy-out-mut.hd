# test: copying a whole value that holds a `&mut` out of a `&T` is mutable-upgrade, while a field read through it is valid
# Spec 13 Reading Through A Reference: ref.read.copy-out.
struct User:
    name: string

struct Team:
    lead: &mut User

fn lead_name(t: &Team) -> string:
    t.lead.name

fn invalid(t: &Team) -> Team:
    *t  # diagnostic: mutable-upgrade
