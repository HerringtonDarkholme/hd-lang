# test: a := binding never changes, so a store through it is an error
# Spec 05 Callable Values: expr.call.apply.readonly-ref (Call Indexing D4).
use std.ops.{Apply, Update}

struct Cell[T]:
    value: T

impl[T] Apply for Cell[T]:
    type Out = T
    fn apply(self) -> T: self.value

impl[T] Update[T] for Cell[T]:
    fn update(&mut self, value: T) -> void:
        self.value = value

fn live[T](value: T) -> Cell[T]:
    Cell { value: value }

fn invalid() -> i32:
    view := live(+0)
    view() = 1  # diagnostic: mutable-receiver-required
    view()
