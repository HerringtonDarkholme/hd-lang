# Spec 09 Trait Value References: trait.dyn.ref.written, trait.dyn.ref.written.reference-fix.reference-values. A struct value where `&mut dyn Counter` is expected; the fix-it writes `&mut tally`, so the callee's change reaches `tally`.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn count(counter: &mut dyn Counter) -> void:
    counter.bump()

fn demo() -> i32:
    let mut tally = Tally { n: 0 }
    count(tally)  # diagnostic: type-mismatch
    tally.n
