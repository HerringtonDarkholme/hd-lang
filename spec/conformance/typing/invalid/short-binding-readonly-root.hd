# test: a := binding exposes a readonly view even of a fresh value; the unannotated let twin keeps mut
data Child:
    name: string

fn short_binding_is_readonly() -> string:
    child := Child { name: "a" }
    child.name = "b"  # diagnostic: readonly-root
    child.name

fn unannotated_let_keeps_fresh_mut() -> string:
    let child = Child { name: "a" }
    child.name = "b"
    child.name
