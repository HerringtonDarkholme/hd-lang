# test: a := binding exposes a readonly view even of a fresh value; the let mut twin keeps mut
data Child:
    name: string

fn short_binding_is_readonly() -> string:
    child := Child { name: "a" }
    child.name = "b"  # diagnostic: readonly-root
    child.name

fn let_mut_keeps_fresh_mut() -> string:
    let mut child = Child { name: "a" }
    child.name = "b"
    child.name
