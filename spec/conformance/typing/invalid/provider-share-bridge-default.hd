# Spec 11 Providers Behind References: req.ref.share.bridge.default. A struct whose bridged `&mut self` method leaves a default method of the trait unwritten is no provider by reference.
trait Counter:
    fn bump(mut self) -> void
    fn bump_twice(mut self) -> void:
        self.bump()
        self.bump()

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> void:
    let mut tally = Tally { n: 0 }
    $.with(Counter=&mut tally):  # diagnostic: unsatisfied-trait-bound
        pass
