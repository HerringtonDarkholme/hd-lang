# test: a requirement key's binding must name an associated type its trait declares or reaches
# Spec 11 Bound Requirement Keys: req.key.binding.names; Spec 09 Binding Names: trait.binding.name-reach (owner decision AT5).

trait Store:
    type Item
    fn load(self, id: string) -> Self::Item

fn count() -> i32 $ Store[Element = i32]:  # diagnostic: unknown-associated-type
    0
