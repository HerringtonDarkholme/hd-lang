# test: an embedded field read through a readonly value is readonly-root, not readonly-edge
data Timestamps:
    created_at: i32
    updated_at: i32

impl Timestamps:
    fn touch(mut self, at: i32) -> void:
        self.updated_at = at

data Post:
    Timestamps
    id: string
    title: string

fn invalid(post: Post) -> void:
    post.updated_at = 5  # diagnostic: readonly-root
