# test: an embedded field read through a readonly reference is readonly-root
struct Timestamps:
    created_at: i32
    pub updated_at: i32

impl Timestamps:
    fn touch(&mut self, at: i32) -> void:
        self.updated_at = at

struct Post:
    Timestamps
    id: string
    title: string

fn invalid(post: &Post) -> void:
    post.updated_at = 5  # diagnostic: readonly-root
