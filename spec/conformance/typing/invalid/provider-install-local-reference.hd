# test: `$.with` takes no local reference, so installing `&mut tally` is an error; the provider is boxed up front
# Spec 11 Installing: req.mut.install-no-local; Spec 13 Places And New Objects: ref.expr.kind.no-counted.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> void:
    let mut tally = Tally { n: 0 }
    $.with(Counter=&mut tally): # diagnostic: local-reference-escapes
        pass
