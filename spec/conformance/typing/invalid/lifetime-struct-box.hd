# test: a box of a struct value that holds a local reference is local, so a stored closure cannot capture it
# Spec 13 Lifetime Structs: ref.lifetime.struct.holds; Boxes: ref.box.local.
struct Parser[T, 'src]:
    src: &'src T
    pos: usize

fn keep(text: string) -> fn() -> usize:
    b := box(Parser { src: &text, pos: 0 })
    fn() -> usize: b.pos # diagnostic: local-reference-escapes
