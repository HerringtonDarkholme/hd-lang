# test: a promoted method never fills a required trait method
# Spec 09 Traits: trait.impl.fill, trait.impl.fill.never, trait.embed.no-conformance.
trait Describe:
    fn describe(self) -> string

data Label:
    text: string

impl Label:
    pub fn describe(self) -> string: self.text

data Page:
    Label

impl Describe for Page  # diagnostic: missing-trait-method
