# test: a field read through a `&T` that copies out a struct holding a `&mut` at depth is mutable-upgrade
# Spec 13 Reading Through A Reference: ref.read.copy-out, ref.read.copy-out.projection.
struct User:
    name: string

struct Inner:
    lead: &mut User

struct Outer:
    inner: Inner

fn invalid(o: &Outer) -> string:
    inner := o.inner  # diagnostic: mutable-upgrade
    o.inner.lead.name
