# test: Deserializer.member borrows Member metadata instead of taking its value
# Spec std/serde Reading: std-serde.read.member.local-ref.
use std.serde.{Deserializer, ValueKind}
use std.structure.{Facts, VariantInfo, Member}

struct Reader: pass

impl Deserializer for Reader:
    type Error = string

    fn peek(&mut self) -> Result[ValueKind, string]: .Err("unused")
    fn is_null(&mut self) -> Result[bool, string]: .Err("unused")
    fn bool(&mut self, expected: string) -> Result[bool, string]: .Err("unused")
    fn int(&mut self, expected: string) -> Result[i64, string]: .Err("unused")
    fn uint(&mut self, expected: string) -> Result[u64, string]: .Err("unused")
    fn float(&mut self, expected: string) -> Result[f64, string]: .Err("unused")
    fn text(&mut self, expected: string) -> Result[string, string]: .Err("unused")
    fn begin_list(&mut self) -> Result[void, string]: .Err("unused")
    fn next_item(&mut self) -> Result[bool, string]: .Err("unused")
    fn begin_map(&mut self) -> Result[void, string]: .Err("unused")
    fn next_key(&mut self) -> Result[string?, string]: .Err("unused")
    fn begin_variant(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, string]:
        .Err("unused")
    fn member(&mut self, m: Member) -> Result[void, string]:  # diagnostic: trait-method-signature
        .Err("unused")
    fn end_variant(&mut self) -> Result[void, string]: .Err("unused")
    fn invalid(&mut self, expected: string) -> string: expected
