trait Number:
    fn number(self) -> i32
impl Number for i32:
    fn number(self) -> i32:
        self
impl Number for i32?:
    fn number(self) -> i32:
        match self:
            .Some(value) => value
            .None => +0
fn mixed(flag: bool) -> Result[impl Number, string]:
    if flag:
        return .Ok(.Some(+1))
    .Ok(+2) # diagnostic: type-mismatch
