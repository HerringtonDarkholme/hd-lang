# Spec 09 Trait Value References: trait.dyn.ref.no-upgrade. A `&S` reference does not convert to `&mut dyn`.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo(tally: &Tally) -> void:
    let counter: &mut dyn Counter = tally  # diagnostic: mutable-upgrade
    counter.bump()
