# test: requirements / mutable providers / a readonly binding of a provider cannot call mut self
# Spec 11 Retrieving: $.use(Counter) yields mut Counter, but a := binding exposes a readonly view.

fn tick() -> void $ Counter:
    counter := $.use(Counter)
    counter.bump()  # diagnostic: mutable-receiver-required

trait Counter:
    fn count(self) -> i32
    fn bump(mut self) -> void
