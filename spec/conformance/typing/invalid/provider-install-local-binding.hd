# test: a binding of local reference type installed with `$.with` is an error
# Spec 11 Installing: req.mut.install-no-local.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo(tally: &mut Tally) -> void:
    $.with(Counter=tally): # diagnostic: local-reference-escapes
        pass
