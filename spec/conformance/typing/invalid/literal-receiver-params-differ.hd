# test: a binding takes its literal's default type, so a method only i64 and i32 provide is missing on it
# Spec 04 Open Literal Width: types.literal.local.statement, types.literal.local.class.meet.
trait ScaleBy:
    fn scale(self, by: i64) -> Self

impl ScaleBy for i64:
    fn scale(self, by: i64) -> i64:
        self * by

trait Markup:
    fn scale(self) -> Self

impl Markup for i32:
    fn scale(self) -> i32:
        self * 2

fn quote() -> i64:
    let cents = 250
    let total = cents.scale(4)  # diagnostic: unknown-method
    total
