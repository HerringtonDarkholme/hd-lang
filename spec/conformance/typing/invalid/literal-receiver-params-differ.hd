# test: two integer types provide scale with different parameters, so the arguments pick neither for a literal receiver
# Spec 04 One Fitting Candidate: types.literal.open.one-fit.receiver-width, types.literal.open.one-fit.params-differ (ONE-FIT).

trait ScaleBy:
    fn scale(self, by: i64) -> Self

impl ScaleBy for i64:
    fn scale(self, by: i64) -> i64:
        self * by

trait Markup:
    fn scale(self) -> Self

impl Markup for i32:
    fn scale(self) -> i32:
        self * 2

fn quote() -> void:
    let cents = 250
    let total = cents.scale(4)  # diagnostic: ambiguous-method
