# test: a generic function that calls itself with a pair of its parameter is a growing generic call cycle
# Spec 04 Generic Representation: types.generic.polymorphic-recursion, types.generic.call-cycle.grows.
fn nest[T](value: T, depth: i32) -> i32:
    if depth == 0: return depth
    nest((value, value), depth - 1)  # diagnostic: instantiation-too-deep

pub fn main() -> void:
    _ := nest(+1, +3)
