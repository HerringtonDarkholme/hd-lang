# test: deriving a trait beside a hand-written implementation of it is an overlapping implementation
# Spec 09 Derived Implementations: trait.derive.beside-written (owner decision TY-18, batch 51b, 2026-10-02).

@derive(Eq)  # diagnostic: overlapping-impl
data Badge:
    text: string

impl Eq for Badge:
    fn eq(self, other: Badge) -> bool:
        self.text == other.text
