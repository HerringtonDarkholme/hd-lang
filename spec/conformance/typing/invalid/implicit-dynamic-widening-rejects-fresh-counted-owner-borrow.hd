# test: a widened mutable trait reference excludes a fresh borrow from its original counted owner
# Spec 09 Trait Value References: trait.dyn.ref.widen, trait.dyn.ref.weaken.
trait Named:
    fn name(&self) -> string

trait Shape < Named:
    fn area(&self) -> f64

struct Square:
    side: f64

impl Named for Square:
    fn name(&self) -> string:
        "sq"

impl Shape for Square:
    fn area(&self) -> f64:
        self.side * self.side

fn label(named: &dyn Named) -> string:
    named.name()

pub fn main() -> void $ Console:
    sq := box(Square { side: 2.0 })
    let shape: &mut dyn Shape = sq
    println("${label(shape)} ${shape.area()}")
    let named: &dyn Named = shape
    let again: &dyn Named = sq # diagnostic: conflicting-access
    println("${named.name()} ${named is again}")
    let maybe: *dyn Shape? = sq
    sq.side = 3.0
    match maybe:
        .Some(s) => println("${s.area()}")
        .None => println("none")
