# test: reading a part out of a readonly value yields a readonly alias
data Timestamps:
    created_at: i32
    updated_at: i32

impl Timestamps:
    fn touch(mut self, at: i32) -> void:
        self.updated_at = at

data Post:
    Timestamps
    id: string
    title: string

fn invalid(post: Post) -> void:
    let stamps: mut Timestamps = post.Timestamps  # diagnostic: mutable-upgrade
