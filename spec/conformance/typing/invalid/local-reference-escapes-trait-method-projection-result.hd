# test: a generic caller's projection result from a trait method holds the argument at the trait's lifetime
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument. `make`'s
# `Self::Item` result is at `Shelf`'s `'b`, which `S < Shelf['a]` makes
# `'a`, and `&q` is passed at it, so `mk` returns a reference to its local.
# The error is at `&q`: the call passes it at the lifetime the bound
# writes, which `q` does not outlive, and what holds `q` later is not
# reported again.
struct Point:
    x: i32

trait Shelf['b]:
    type Item
    fn make(&self, v: &'b Point) -> Self::Item

fn mk['a, S < Shelf['a]](s: &S, p: &'a Point) -> S::Item:
    q := Point { x: 1 }
    s.make(&q) # diagnostic: local-reference-escapes
