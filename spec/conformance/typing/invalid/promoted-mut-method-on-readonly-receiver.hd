# test: a promoted &mut self call needs a writable receiver, so a call on a value parameter is rejected
# Spec 07 Reference Receivers: fn.method.auto-address.place-writable.
struct Timestamps:
    created_at: i32
    updated_at: i32

impl Timestamps:
    pub fn touch(&mut self, at: i32) -> void:
        self.updated_at = at

struct Post:
    Timestamps
    id: string
    title: string

fn invalid(post: Post) -> void:
    post.touch(5) # diagnostic: not-writable
