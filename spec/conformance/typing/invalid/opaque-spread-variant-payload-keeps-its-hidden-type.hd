# test: constructor payloads preserve one hidden type for each opaque occurrence
# Rule: fn.opaque.occurrence-no-join.
trait Number:
    fn number(self) -> i32
impl Number for i32:
    fn number(self) -> i32:
        self
impl Number for i32?:
    fn number(self) -> i32:
        match self:
            .Some(value) => value
            .None => +0
enum Holder[T]:
    Value(value: T)
fn mixed(flag: bool) -> Holder[impl Number]:
    if flag:
        return .Value(.Some(+1))
    .Value((+2,)...) # diagnostic: type-mismatch
