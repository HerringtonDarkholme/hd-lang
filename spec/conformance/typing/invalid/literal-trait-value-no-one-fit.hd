# test: converting a literal to a trait value is no one-fit site, so 0 falls back to usize, which is no Gauge
# Spec 04 One Fitting Candidate: types.literal.local.erased (ONE-FIT).

trait Gauge:
    fn level(self) -> f64

impl Gauge for f64:
    fn level(self) -> f64:
        self

fn idle_sensor() -> f64:
    let reading: Gauge = 0  # diagnostic: type-mismatch
    reading.level()
