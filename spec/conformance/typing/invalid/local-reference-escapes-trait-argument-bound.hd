# test: a reference that writes no lifetime in a type parameter's bound is an error at the `&`
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-unnamed,
# ref.local.escape.trait-argument.
struct Point:
    x: i32

trait Store[T]:
    fn put(&mut self, value: T) -> void

fn count[S < Store[&Point]](s: &mut S) -> i32: # diagnostic: local-reference-escapes
    0
