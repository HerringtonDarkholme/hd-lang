# test: an element reference is local, so storing it in a counted-reference field is an error
# Spec 13 Local References: ref.local.escape.field; Element References: ref.elem.local-value.
struct Holder:
    slot: *mut i32

fn demo() -> i32:
    let mut xs = [+1, 2]
    saved := Holder { slot: &mut xs[0] } # diagnostic: local-reference-escapes
    *saved.slot
