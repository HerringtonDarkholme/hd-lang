# test: storing an element reference in a field is an error, since an element reference lives for one call
# Spec 13 Call-Scoped Access: ref.elem.kept.
struct Holder:
    slot: *mut i32

fn demo() -> i32:
    let mut xs = [+1, 2]
    saved := Holder { slot: &mut xs[0] } # diagnostic: element-reference-outlives-call
    *saved.slot
