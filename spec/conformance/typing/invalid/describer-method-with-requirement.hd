# test: a Describer method that declares a requirement is an error
# Spec 14 The Structure Trait: annot.structure.pure.impl.
use std.structure.{Field, Variant, Describer}

trait Log:
    fn line(self, text: string) -> void

struct Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never] $ Log:  # diagnostic: trait-method-signature
        self.n = self.n + 1
        .Ok(())
