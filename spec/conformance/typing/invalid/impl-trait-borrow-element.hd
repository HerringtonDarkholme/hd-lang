# test: an opaque value that borrows is no list element
# Spec 04 Opaque Results That Borrow: types.opaque.borrows.holds; 13 ref.local.escape.type-argument.
struct User:
    name: string

fn label(u: &User) -> impl Display:
    &u.name

fn labels(u: &User) -> usize:
    all := [label(u)] # diagnostic: local-reference-escapes
    all.len()
