# Spec 09 Receivers Of Struct Implementations: trait.impl.receiver-bridge. Only a struct's `&mut self` fills a trait method declared `mut self`; a data type keeps `mut self`.
trait Counter:
    fn bump(mut self) -> void

data Box:
    n: i32

impl Counter for Box:
    fn bump(&mut self) -> void:  # diagnostic: trait-method-signature
        self.n += 1
