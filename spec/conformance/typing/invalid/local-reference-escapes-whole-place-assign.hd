# test: an assignment through a `&mut` place with no slot of its own keeps the stored value's origins
# Spec 13 Lifetime Stores: ref.lifetime.store; Lifetime Traits:
# ref.lifetime.trait.bound-argument. `*d` is the caller's `S::Item` place
# at `'a`, and `s.make(&q)` holds `q`.
struct Point:
    x: i32

trait Shelf['b]:
    type Item
    fn make(&self, v: &'b Point) -> Self::Item

fn bad['a, S < Shelf['a]](s: &S, d: &mut S::Item, p: &'a Point) -> void:
    q := Point { x: 1 }
    *d = s.make(&q) # diagnostic: local-reference-escapes
