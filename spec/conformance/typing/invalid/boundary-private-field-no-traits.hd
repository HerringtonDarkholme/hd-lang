# test: a type with a private field and neither trait cannot cross a host call, even when it implements the other direction's trait
# Spec Modules, Private Fields At A Boundary: module.boundary.out, module.boundary.error (task #320).
# fixture-runtime-profile: serde-vault
use std.serde.Deserialize

@derive(Deserialize)
pub data Token:
    pub owner: string
    secret: i64

pub trait Vault:
    fn keep(self, token: Token) -> Token  # diagnostic: boundary-private-field

pub fn main() -> void $ Vault:
    _ := $.use(Vault).keep(Token { owner: "ada", secret: 42 })
