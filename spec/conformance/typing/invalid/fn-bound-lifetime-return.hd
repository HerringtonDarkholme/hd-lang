# test: returning a closure read from a lifetime-bounded field, when the result has no source for its captures, is local-reference-escapes
# Spec 13 Lifetime Bounds: ref.generic.outlives.read.
use std.function.FnMut

struct Counter:
    n: i32

struct Button[F < FnMut() -> void & 'a, 'a]:
    on_click: F

fn make() -> fn() -> void:
    let mut x = Counter { n: +0 }
    r := &mut x
    b := Button { on_click: fn(): r.n += 1 }
    b.on_click # diagnostic: local-reference-escapes
