# test: reading the list's length in a later argument of a call that takes `&mut` of an element of it is a conflicting access
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.access.mut.
fn add_all(target: &mut i32, other: i32, count: usize) -> void:
    *target += other
    if count == 2:
        *target += 2

fn invalid() -> void:
    let mut scores = [+1, 2]
    add_all(&mut scores[0], scores[1], scores.len()) # diagnostic: conflicting-access
