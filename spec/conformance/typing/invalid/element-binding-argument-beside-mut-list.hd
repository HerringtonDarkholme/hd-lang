# test: a call that takes &mut of a list beside a binding that holds a reference to one of its elements conflicts
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.conflict.reference.
fn grow(xs: &mut List[i32], first: &i32) -> i32:
    xs.push(0)
    *first

fn demo() -> i32:
    let mut xs = [+1, 2]
    first := &xs[0]
    grow(&mut xs, first) # diagnostic: conflicting-access
