# test: a bare trait name in a data field, against a trait declared later is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions; Spec 03 Module Scope: names.module.order-free.

data Registry:
    factories: List[Factory]  # diagnostic: trait-used-as-type

trait Factory:
    fn create() -> Self
