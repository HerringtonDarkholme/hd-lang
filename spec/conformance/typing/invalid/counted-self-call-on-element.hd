# test: a `*mut self` call on a list element is an error, as on any place
# Spec 07 Reference Receivers: fn.method.counted-self.place.
struct Counter:
    hits: i32

impl Counter:
    fn handle(*mut self) -> *mut Counter:
        self

fn invalid() -> void:
    let mut counters = [Counter { hits: 0 }]
    h := counters[0].handle() # diagnostic: local-reference-escapes
