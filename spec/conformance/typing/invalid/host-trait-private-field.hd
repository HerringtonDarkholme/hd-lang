# test: a host capability result wrapped in ResourceError crosses into hd, so a private field in the error type needs Deserialize
# Spec Modules, Private Fields At A Boundary: module.boundary.in, module.boundary.direction, module.boundary.error.
# fixture-runtime-profile: disposed-file
use std.resource.ResourceError

pub data IoError:
    message: string

pub trait FileHandle:
    fn read!(mut self) -> Result[string, ResourceError[IoError]]  # diagnostic: boundary-private-field

pub trait Files:
    fn open!(self) -> mut dyn FileHandle

pub fn main!() -> void $ Files:
    let handle: mut dyn FileHandle = $.use(Files).open!()
    match handle.read!():
        .Ok(_) => pass
        .Err(_) => panic("fixture host failed to read")
