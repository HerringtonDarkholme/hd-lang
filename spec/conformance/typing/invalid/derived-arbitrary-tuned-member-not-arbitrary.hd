# test: a member that arbitrary.with tunes must still implement Arbitrary
# std Testing, Derived Arbitrary: std-testing.arbitrary.derive.member-bound and .derive.not-derivable
# (Testing AT-with, owner decision 2026-09-30). Port has no Arbitrary, so the
# generator does not make Server derivable.
use std.testing.{Arbitrary, Choices}
use std.testing.arbitrary

data Port:
    number: i32

fn port(c: mut Choices) -> Port:
    Port { number: c.int(1024, 65535) }

@derive(Arbitrary)  # diagnostic: member-not-derivable
data Server:
    @arbitrary.with(port)
    port: Port
