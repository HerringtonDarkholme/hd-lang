# Spec 09 Trait Value References: trait.dyn.ref.written, trait.dyn.ref.written.reference-fix.reference-values. A struct literal in a `List[&dyn Shape]`; the fix-it writes `&Square { ... }`, a new object.
trait Shape:
    fn area(&self) -> f64

struct Square:
    side: f64

impl Shape for Square:
    fn area(&self) -> f64:
        self.side * self.side

fn shapes() -> List[&dyn Shape]:
    [Square { side: 1.0 }]  # diagnostic: type-mismatch
