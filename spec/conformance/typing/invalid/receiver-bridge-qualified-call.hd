# Spec 09 Receivers Of Struct Implementations: trait.impl.receiver-bridge.other-uses. A trait-qualified call passes the receiver as the trait declares it.
trait Counter:
    fn bump(mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> i32:
    let mut tally = Tally { n: 0 }
    Counter::bump(tally)  # diagnostic: unsatisfied-trait-bound
    tally.n
