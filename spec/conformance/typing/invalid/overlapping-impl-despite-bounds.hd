# test: bounds do not make overlapping implementation heads disjoint
# Spec 09 Traits: trait.overlap.heads-only, trait.overlap.no-bounds, trait.overlap.error.

struct Box[T]:
    value: T

struct Plain:
    value: i32

trait Marker

impl[T < Display] Marker for Box[T]
impl Marker for Box[Plain]  # diagnostic: overlapping-impl
