# Spec 11 Installing: req.mut.install-writable-counted; Spec 11 References To Other Providers: req.ref.share.counted-values. A `*Shelf` does not install a provider for a trait with a `&mut self` method.
trait Inventory:
    fn reserve(&mut self, qty: i32) -> void

struct Shelf:
    apples: i32

impl Inventory for Shelf:
    fn reserve(&mut self, qty: i32) -> void:
        self.apples -= qty

fn shared(shelf: *Shelf) -> void:
    $.with(Inventory=shelf): # diagnostic: mutable-upgrade
        pass
