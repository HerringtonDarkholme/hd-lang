# test: a `&mut` of a place that a binding keeps while a shared reference to it is used later conflicts
# Spec 13 Writes While Borrowed: ref.excl.write, ref.excl.shared.
fn bump() -> void $ Console:
    let mut x = +0
    s := &x
    r := &mut x # diagnostic: conflicting-access
    println(*s)
    *r += 1
