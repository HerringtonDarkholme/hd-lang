# test: an argument of a push on a list element that takes &mut of the list is a conflicting access, since the receiver's access begins first
# Spec 13 Call-Scoped Access: ref.elem.conflict.reference; Spec 07 Method Calls: fn.method.eval-order.
fn open_round(rounds: &mut List[List[i32]]) -> i32:
    rounds.push([])
    return i32(rounds.len())

fn demo() -> void:
    let mut rounds = [[+3, 5]]
    rounds[0].push(open_round(&mut rounds))  # diagnostic: conflicting-access
