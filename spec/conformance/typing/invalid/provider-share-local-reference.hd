# test: a provider for a trait without reference receivers takes no local reference either
# Spec 11 Installing: req.mut.install-no-local; References To Other Providers: req.ref.share.counted-values.
trait Inventory:
    fn stock(self, sku: string) -> i32

struct Shelf:
    apples: i32

impl Inventory for Shelf:
    fn stock(self, sku: string) -> i32:
        self.apples

fn demo() -> void:
    shelf := Shelf { apples: 10 }
    $.with(Inventory=&shelf): # diagnostic: local-reference-escapes
        pass
