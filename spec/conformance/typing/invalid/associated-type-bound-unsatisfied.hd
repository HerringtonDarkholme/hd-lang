# test: an implementation binds a bounded associated type to a type that does not implement the bound
# Spec 09 Associated Types: trait.assoc.bound-decl, trait.assoc.bound-impl.

trait Bag[T]:
    type Cursor < Iterator[T]
    fn cursor(self) -> Self::Cursor

struct Words:
    text: string

impl Bag[i32] for Words:  # diagnostic: unsatisfied-trait-bound
    type Cursor = string
    fn cursor(self) -> string:
        self.text
