# test: a result with an elided lifetime argument used after its source's block outlives the source
# Spec 13 Lifetime Structs: ref.lifetime.struct.elide.result; Local Scope: ref.dep.scope.
struct Parser[T, 'src]:
    src: &'src T
    pos: usize

fn make(s: &string) -> Parser[string]:
    Parser { src: s, pos: 0 }

fn demo(outer: string) -> usize:
    let mut p = make(&outer)
    if outer.len() > 0:
        inner := "hello"
        p = make(&inner)
    p.pos # diagnostic: local-reference-outlives-local
