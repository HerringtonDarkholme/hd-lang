# test: a readonly iterator does not satisfy an Iterable bound
# Spec 06 Iteration Protocols: flow.for.iterator-not-iterable, flow.for.iterator-no-bound (batch 24 IT2).

fn count[I < Iterable[i32]](source: I) -> i32:
    let total = +0
    for item in source:
        total = total + item
    total

fn from_iterator(source: Iterator[i32]) -> i32:
    count(source)  # diagnostic: unsatisfied-trait-bound
