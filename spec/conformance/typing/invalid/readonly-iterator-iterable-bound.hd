# test: a readonly iterator does not satisfy an Iterable bound
# Spec 06 Iteration Protocols: flow.for.iterator.iterable-not-implied, flow.for.iterator.iterable-bound (batch 24 IT2).

use std.iter.{FromFn}
fn count[I < Iterable[i32]](source: I) -> i32:
    let total = +0
    for item in source:
        total = total + item
    total

fn from_iterator(source: FromFn[i32]) -> i32:
    count(source) # diagnostic: unsatisfied-trait-bound
