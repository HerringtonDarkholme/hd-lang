# test: an implementation's parameter bound is checked even when the implementation has no methods
# Spec 09 Dynamic Safety: trait.dyn.safe.error.

trait Source[T]:
    fn read(self) -> T

trait Marker

data Wrap[T]:
    value: T

impl[T < Source[Factory]] Marker for Wrap[T]  # diagnostic: trait-not-dynamically-safe

trait Factory:
    fn create() -> Self
