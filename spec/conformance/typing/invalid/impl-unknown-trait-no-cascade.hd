# test: an unresolved From impl reports no conversion follow-on
# trait.from.import, module.prelude.question-from.
struct CliError:
    message: string

impl From[string] for CliError: # diagnostic: unknown-trait
    fn from(message: string) -> CliError:
        CliError { message: message }

fn parse(text: string) -> Result[i32, string]:
    .Err(text)

fn run(text: string) -> Result[i32, CliError]:
    value := parse(text)?
    .Ok(value)
