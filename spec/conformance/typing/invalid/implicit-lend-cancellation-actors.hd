# test: a parent whose cleanup folds a child's waiting cleanup ends .Abandoned when that child is abandoned directly, though its own part ran to its end
# Spec lang/11 Abandoning: req.abandon.carry, req.abandon.result.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.{join, race}
use std.time.{Clock, s, sleep}

struct Conn:
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing")
        let mut wait = self.closing
        wait!()
        self.log.push("closed")

fn child!(log: *mut List[string]) -> string $ Clock:
    using! conn = &mut Conn { log: log, closing: sleep(s(60)) }
    sleep!(s(60))
    "child"

fn parent!(kid: Suspend[string], log: &mut List[string]) -> string:
    defer(fn() -> void: log.push("parent defer"))
    kid!()

fn ready!() -> string:
    "won"

fn ended!(job: Suspend[string]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn stop!(kid: Suspend[string], log: &mut List[string]) -> string:
    log.push("abandon child")
    kid.abandon()
    "stopped"

pub fn main!() -> void $ Console + Clock:
    log := box::[List[string]]([])
    let kid: Suspend[string] = child(log)
    let top: Suspend[string] = parent(kid, log)
    let (winner, stopped) = join!(race(top, ready()), stop(kid, log)) # diagnostic: conflicting-access
    println("${winner} ${stopped}")
    println("parent ${ended!(top)}")
    println("child ${ended!(kid)}")
