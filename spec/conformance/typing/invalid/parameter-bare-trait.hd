# test: a bare trait name as a parameter type is an error whose fix-it inserts dyn
# Spec 04 Trait Value Types: types.trait.value.dyn-required; Spec 09 Dynamic Trait Values: trait.dyn.keyword.

trait Greet:
    fn greet(self) -> string

fn demo(g: Greet) -> string:  # diagnostic: trait-used-as-type
    g.greet()
