# test: a defer takes the owned values its suite reads when it registers
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

fn inspect(file: ^File) -> void:
    _ := size(file)

fn moved_into_cleanup() -> void:
    file := open("input")
    defer: inspect(file)
    inspect(file)  # diagnostic: use-after-move
