# test: a use after a call takes the owned value is use-after-move
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

pub fn main() -> void:
    f := open("app.log")
    n := size(f)
    archive(f)
    m := size(f)  # diagnostic: use-after-move
    _ := n + m
