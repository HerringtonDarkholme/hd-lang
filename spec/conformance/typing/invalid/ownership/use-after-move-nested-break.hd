# test: a break out of an inner loop after a move reaches the outer loop's next pass
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

fn retry(more: bool) -> void:
    f := open("app.log")
    while more:
        while more:
            archive(f)  # diagnostic: use-after-move
            break
