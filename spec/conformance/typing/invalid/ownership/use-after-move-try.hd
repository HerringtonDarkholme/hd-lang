# test: the success path of ? continues the loop body to the next pass
data File:
    fd: i32

impl OwnOnly for File

fn open(path: string) -> own File: File { fd: 3 }

fn size(f: ^File) -> i32: f.fd

fn archive(f: own File) -> void: pass

fn step() -> Result[i32, string]: .Ok(1)

fn batch(more: bool) -> Result[i32, string]:
    f := open("app.log")
    while more:
        _ := step()?
        archive(f)  # diagnostic: use-after-move
    .Ok(0)
