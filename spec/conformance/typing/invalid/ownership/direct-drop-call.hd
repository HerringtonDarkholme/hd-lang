# test: a type's drop runs only when a value drops; calling it is an error
data File:
    fd: i32

impl OwnOnly for File

impl DropOwn for File:
    fn drop(^mut self) -> void: pass

fn open() -> own File: File { fd: 3 }

fn close_twice() -> void:
    f := open()
    f.drop()  # diagnostic: direct-drop-call
