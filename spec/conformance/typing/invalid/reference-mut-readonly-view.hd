# test: `&mut` of a writable place that holds a readonly view would grant writes the view lacks: mutable-upgrade
# Spec 13 Writable Places Of References: ref.place.writable.view-data.
data User:
    name: string

struct Team:
    lead: User

fn invalid(user: User) -> void:
    let mut team = Team { lead: user }
    _ := &mut team.lead  # diagnostic: mutable-upgrade
