# test: a requirement key whose supertrait has an associated function is not dynamically safe
# Spec 11 Requirement Keys: req.key.dynamically-safe; Spec 09 Dynamic Safety: trait.dyn.safe.one-copy covers supertraits.

trait Factory:
    fn create() -> Self

trait WidgetFactory < Factory:
    fn label(self) -> string

fn build() -> void $ WidgetFactory:  # diagnostic: trait-not-dynamically-safe
    pass
