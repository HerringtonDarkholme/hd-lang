# test: an argument that takes &mut of the list during a &mut self call on one of its elements is a conflicting access
# Spec 13 Call-Scoped Access: ref.elem.conflict; Spec 07 Reference Receivers: fn.method.auto-address.collection-element.
struct Item:
    n: i32

impl Item:
    fn grow(&mut self, all: &mut List[Item]) -> void:
        self.n += 1
        all.push(Item { n: 0 })

fn demo() -> void:
    let mut items = [Item { n: 0 }]
    items[0].grow(&mut items) # diagnostic: conflicting-access
