# test: a shared trait reference cannot satisfy a trait bound requiring a mutable member
# Spec 09 Trait Values As Bounds: trait.dyn.bound.reference-shared.
trait Write:
    fn bump(&mut self) -> void
struct Counter:
    value: i32
impl Write for Counter:
    fn bump(&mut self) -> void: self.value += 1
fn needs_write[T < Write](value: T) -> void: pass
fn rejected(value: &dyn Write) -> void:
    needs_write(value)  # diagnostic: unsatisfied-trait-bound
