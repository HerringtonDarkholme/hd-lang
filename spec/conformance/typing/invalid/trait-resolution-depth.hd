# test: a bound proof deeper than 64 nested bounds is an error

trait Marker

data Box[T]:
    value: T

impl Marker for i32

impl[T < Marker] Marker for Box[T]

fn need[T < Marker](value: T) -> void:
    pass

fn deep(value: Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[Box[i32]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]) -> void:
    need(value)  # diagnostic: trait-resolution-depth
