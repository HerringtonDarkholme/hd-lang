# test: a prefix function's requirement row joins the caller's row, as any call's does
# Spec 05 Prefixed Strings: expr.prefix.ordinary-rules; `logged"x"` needs Console where the row is empty.
use std.ops.{Template, str_prefix}

@str_prefix
fn logged(t: Template[string]) -> string $ Console:
    "logged"

pub fn render() -> string:
    logged"x"  # diagnostic: missing-requirement
