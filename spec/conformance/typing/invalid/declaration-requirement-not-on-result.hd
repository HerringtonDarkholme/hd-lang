# test: the trailing requirement clause makes the declaration, not its result, require the key
# Spec 02 Header Requirement Clauses: grammar.type.header.owner, grammar.type.header.applies.

fn make() -> fn() -> i32 $ Console:
    _ := $.use(Console)
    fn() -> i32: 1

pub fn caller() -> i32:
    f := make()  # diagnostic: missing-requirement
    f()
