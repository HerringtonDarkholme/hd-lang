# test: a cast of a pointer bound from an enum payload names the pointer and suggests `*`
# Spec 04 Numeric Casts: types.cast.nonnumeric. Spec 13 Values And References: ref.read.auto.explicit.
enum Slot:
    Empty
    Held(at: *i32)

fn widen(s: &Slot) -> usize:
    match s:
        .Held(at) => usize(at) # diagnostic: not-callable
        .Empty => 0
