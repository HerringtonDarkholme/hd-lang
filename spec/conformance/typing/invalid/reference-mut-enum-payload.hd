# test: an enum payload is not a place, so `&mut` of a payload binding is readonly-root
# Spec 13 Writable Places Of References: ref.place.writable.enum.
enum Slot:
    Empty
    Full(i32)

fn invalid() -> void:
    let mut s = Slot.Full(+1)
    match s:
        .Full(n) =>
            r := &mut n  # diagnostic: readonly-root
            *r = n
        .Empty => ()
