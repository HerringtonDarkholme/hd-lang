# Spec 09 Traits: trait.impl.local, trait.impl.local.trait, trait.impl.local.nonlocal.

trait Label:
    fn label(self) -> string

data Entry:
    name: string

fn describe(entry: Entry) -> string:
    impl Label for Entry:  # diagnostic: local-impl-nonlocal-pair
        fn label(self) -> string: self.name

    entry.label()
