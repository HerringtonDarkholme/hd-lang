# test: returning a generic struct that holds a closure argument's captured local reference in a written function type is local-reference-escapes
# Spec 13 Lifetime Bounds: ref.generic.outlives.instance, ref.generic.outlives.read.
use std.function.FnMut

struct Counter:
    n: i32

struct Plain[F < FnMut() -> void]:
    on_click: F

fn wrap[F < FnMut() -> void](f: F) -> Plain[F]:
    Plain { on_click: f }

fn nested(c: &mut Counter) -> Plain[fn() -> void]:
    wrap(fn(): c.n += 1) # diagnostic: local-reference-escapes
