# Spec 09 Trait Value References: trait.dyn.ref.written, trait.dyn.ref.written.fix. A struct value where `&dyn Shape` is expected; the fix-it writes `&square`.
trait Shape:
    fn area(&self) -> f64

struct Square:
    side: f64

impl Shape for Square:
    fn area(&self) -> f64:
        self.side * self.side

fn show(shape: &dyn Shape) -> f64:
    shape.area()

fn demo() -> f64:
    square := Square { side: 2.0 }
    show(square)  # diagnostic: type-mismatch
