# test: one type embedded through two paths at the same depth conflicts at the outer declaration, starting with its embedded field name
# Spec 03 Depths And Promoted Members: names.promote.embedded, names.conflict.definition; the embedded field Base is promoted through both paths.
struct Base:
    id: string

struct Left:
    Base

struct Right:
    Base

struct Both:
    Left
    Right  # diagnostic: ambiguous-promoted-member
