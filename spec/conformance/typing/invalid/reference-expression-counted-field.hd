# test: `&mut` on a new object is a local reference too, so storing it in a `*mut Point` field is an error
# Spec 13 Places And New Objects: ref.expr.kind.always-local, ref.expr.kind.no-counted, ref.expr.allocate.
struct Point:
    x: i32

struct Holder:
    point: *mut Point

fn invalid() -> Holder:
    Holder { point: &mut Point { x: 1 } } # diagnostic: local-reference-escapes
