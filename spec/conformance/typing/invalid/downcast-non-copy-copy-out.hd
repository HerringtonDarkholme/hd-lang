# test: recovering a non-Copy type works, but copying it out with `*found` moves out of the reference
# Spec 09 Traits: trait.downcast.non-copy-copy-out; Spec 13 Values And References: ref.move.out-of-place.
use std.inspect.Inspectable

struct Photo:
    width: u32

impl !Copy for Photo

fn take(value: &dyn Inspectable) -> Photo?:
    match value.downcast_ref::[Photo]():
        .Some(found) => .Some(*found) # diagnostic: move-out-of-place
        .None => .None
