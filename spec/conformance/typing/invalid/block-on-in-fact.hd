# test: a type-level fact expression may not call block_on directly
use std.task.block_on

data Style:
    prefix: string

fn ready!() -> string:
    "p_"

fn style_of(prefix: string) -> Style:
    Style { prefix: prefix }

@style_of(block_on(ready()))  # diagnostic: suspension-forbidden-context
data User:
    id: i32
