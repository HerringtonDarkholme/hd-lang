# test: a local reference as a trait value's type argument is an error
# Spec 13 Local References: ref.local.escape.trait-argument.
struct Point:
    x: i32

trait Store[T]:
    fn put(&mut self, value: T) -> void

struct Keep:
    n: i32

impl[T] Store[T] for Keep:
    fn put(&mut self, value: T) -> void:
        pass

fn keep(p: &Point) -> void:
    let store: *mut dyn Store[&Point] = box(Keep { n: 0 }) # diagnostic: local-reference-escapes
    store.put(p)
