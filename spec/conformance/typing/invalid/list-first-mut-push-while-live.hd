# test: a push to a list while its first_mut result is used later conflicts
# Spec 13 Writes While Borrowed: ref.excl.mut, ref.excl.call; std Collections: std-collections.access.first-mut.
fn bump() -> void:
    let mut items = [+1, 2]
    match items.first_mut():
        .Some(first) =>
            items.push(3) # diagnostic: conflicting-access
            *first += 1
        .None => pass
