# test: an Iterator.any callback with a requirement row does not fit its empty-row parameter
# Spec std/iter More Adapters: std-iter.adapter.callback-row.more.

trait Logger

fn noisy(value: i32) -> bool $ Logger:
    value > 0

fn some_positive(values: List[i32]) -> bool $ Logger:
    values.iter().any(noisy)  # diagnostic: type-mismatch
