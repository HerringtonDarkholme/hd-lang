# test: a bare trait name in a function type's input is an error; the type is written dyn Factory, as the result already is
# Spec 09 Dynamic Trait Values: trait.dyn.reference-keyword, trait.dyn.keyword.positions.

trait Factory:
    fn create() -> Self

fn register(build: fn(Factory) -> Result[i32, &dyn Factory]) -> void:  # diagnostic: trait-used-as-type
    pass
