# test: a bare trait name in a function type's input and result is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions.

trait Factory:
    fn create() -> Self

fn register(build: fn(Factory) -> Result[i32, Factory]) -> void:  # diagnostic: trait-used-as-type
    pass
