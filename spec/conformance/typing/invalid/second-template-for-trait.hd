# test: a second template for one trait is an error
# Spec 14 Templates: annot.template.unique.
use std.structure.{Structure, Field, Variant, Describer}

trait Named:
    fn type_name() -> string

data Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

impl[T] Named for T by Structure:
    fn type_name() -> string:
        let mut d = Count { n: 0 }
        _ := T::describe(d)
        T::name()

impl[T] Named for T by Structure:  # diagnostic: overlapping-impl
    fn type_name() -> string:
        let mut d = Count { n: 0 }
        _ := T::describe(d)
        "again"
