# test: traits / diagnostics / ambiguous method

trait Left:
    fn label(self) -> i32
trait Right:
    fn label(self) -> i32
data User:
    value: i32
impl Left for User:
    fn label(self) -> i32: self.value
impl Right for User:
    fn label(self) -> i32: self.value
fn main() -> i32: User { value: 42 }.label()  # diagnostic: ambiguous-method
