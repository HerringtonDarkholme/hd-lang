# test: two embedded types with an inherent method of one name conflict at the outer declaration
struct Logger:
    name: string

impl Logger:
    pub fn describe(self) -> string:
        self.name

struct Metrics:
    count: i32

impl Metrics:
    pub fn describe(self) -> string:
        "metrics"

struct Service:
    Logger
    Metrics  # diagnostic: ambiguous-promoted-member
