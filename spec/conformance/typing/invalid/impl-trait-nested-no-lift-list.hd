trait Number:
    fn number(self) -> i32
impl Number for i32:
    fn number(self) -> i32:
        self
impl Number for i32?:
    fn number(self) -> i32:
        match self:
            .Some(value) => value
            .None => +0
fn mixed(flag: bool) -> List[impl Number]:
    if flag:
        return [.Some(+1)]
    [+2] # diagnostic: type-mismatch
