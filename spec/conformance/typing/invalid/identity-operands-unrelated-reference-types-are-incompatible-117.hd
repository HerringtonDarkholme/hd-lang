# test: unrelated reference types are incompatible
struct User:
    name: string

struct Order:
    total: i32

struct Box[T]:
    item: T

enum Color:
    Red
    Green

trait Named:
    fn label(self) -> string

trait Entity < Named

trait Handle < AnyRef

impl Named for User:
    fn label(self) -> string: self.name

impl Entity for User:
    pass

fn f(a: &Box[i32], b: &Box[string]) -> bool:
    a is b  # diagnostic: incompatible-identity-operands
