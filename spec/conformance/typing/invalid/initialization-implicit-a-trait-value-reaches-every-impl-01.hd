# test: a trait value reaches every impl
# Spec lang/10-modules.md: module.init.definite.implicit.

struct Tag:
    n: i32
trait Name:
    fn name(self) -> string

struct Other:
    n: i32

impl Name for Tag:
    fn name(self) -> string: "a"

fn pick() -> *dyn Name:
    &Tag { n: 1 }

first := pick().name() # diagnostic: top-level-read-before-initialization
later := +5

impl Name for Other:
    fn name(self) -> string: "b${later}"

pub fn main() -> void $ Console:
    println(first)
