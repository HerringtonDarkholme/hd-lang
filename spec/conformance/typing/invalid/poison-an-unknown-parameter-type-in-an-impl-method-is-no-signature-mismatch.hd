# test: an unknown parameter type in a trait method implementation is no signature mismatch
# Spec README.md: Diagnostics (one failure, one diagnostic).

trait Scale:
    fn scale(self, by: i32) -> i32

struct Meter:
    value: i32

impl Scale for Meter:
    fn scale(self, by: Bogus) -> i32: # diagnostic: unknown-type
        self.value
