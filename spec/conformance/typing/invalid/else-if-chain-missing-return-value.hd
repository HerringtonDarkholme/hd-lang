# Spec 06 Conditional Expressions: flow.if.else-if, flow.if.statement. Spec 07
# Function Bodies: fn.body.paths. A chain without a final `else` is one
# conditional, so as a function-body tail it falls through like a plain `if`.
fn invalid(a: bool, b: bool) -> i32:
    if a:  # diagnostic: missing-return-value
        return 1
    else if b:
        return 2
