# test: a suffix function declares exactly one parameter, even when the others have defaults
# Spec 05 Literal Suffixes: expr.literal-fn.shape, checked at the definition (Literal Suffixes L22).
use std.ops.num_suffix

@num_suffix
fn kb(count: i64, unit: i64 = 1024) -> i64:  # diagnostic: type-mismatch
    count * unit
