# test: a trait-qualified call whose `Self` is a trait value reference reaches neither an opaque-result member nor a generic one
# Spec 09 Dynamic Safety: trait.dyn.member.unavailable.error; the
# by-value receiver makes `Self` the `&dyn Tr` argument, so both calls go
# through the trait value.
trait Tr:
    fn show(self) -> impl Display
    fn pick[U](self, u: U) -> U

fn f(v: &dyn Tr) -> void:
    let a = Tr::show(v) # diagnostic: dyn-member-unavailable
    let b = Tr::pick(v, 1) # diagnostic: dyn-member-unavailable
