# test: passing a struct whose field's function type writes a lifetime makes that lifetime the callee's, which another argument at it must outlive
# Spec 07 Function Types: fn.type.lifetime.call.written.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn relay['a, T](h: Holder['a, T], p: &'a Point) -> T:
    (h.f)(p)

fn call['a, T](h: Holder['a, T]) -> T:
    q := Point { x: 1 }
    relay(h, &q) # diagnostic: local-reference-escapes
