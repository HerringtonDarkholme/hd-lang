# test: index_set takes &mut self, so r[k] = v needs a writable place or a &mut reference
# Spec 05 Index Traits: expr.index.trait.mut-ref.
use std.ops.IndexSet

struct Cell:
    value: List[i32]

impl IndexSet[usize, i32] for Cell:
    fn index_set(&mut self, key: usize, value: i32) -> void:
        self.value[0] = value

fn store(cell: Cell) -> void:
    cell[0] = +4  # diagnostic: not-writable
