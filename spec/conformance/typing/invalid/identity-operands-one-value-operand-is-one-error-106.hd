# test: one value operand is one error
struct User:
    name: string

struct Order:
    total: i32

struct Box[T]:
    item: T

enum Color:
    Red
    Green

trait Named:
    fn label(self) -> string

trait Entity < Named

trait Handle < AnyRef

impl Named for User:
    fn label(self) -> string: self.name

impl Entity for User:
    pass

fn f(a: i32, b: Order) -> bool:
    a is b  # diagnostic: identity-requires-references
