# test: a member-typed fact attaches only to a field, even when its target kinds allow more
# Spec 14 Member-Typed Facts: annot.typed-fact.field-only (owner decision O7, batch 36, 2026-10-01).
use std.annotation.{annotate, member_typed}

@annotate(.Field, .Fn)
@member_typed
data Example[F]:
    value: F

fn example[F](value: F) -> Example[F]:
    Example::[F] { value: value }

@example(1)  # diagnostic: decorator-target-kind
fn answer() -> i32:
    42
