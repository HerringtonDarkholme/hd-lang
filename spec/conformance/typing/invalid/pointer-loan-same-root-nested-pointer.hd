# test: pointer loans, same root: replacing the inner pointer a reference crossed, through the same root is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn probe(a: *mut Outer) -> i32:
    c := &a.next.n
    a.next = box(Cell { n: +1 }) # diagnostic: conflicting-access
    *c
