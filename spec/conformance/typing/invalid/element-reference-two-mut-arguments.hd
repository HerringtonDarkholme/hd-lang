# test: two `&mut` element references into one list in one call are a conflicting access, as Rust needs `split_at_mut` for them
# Spec 13 Call-Scoped Access: ref.elem.access.length, ref.elem.access.mut.
fn swap(left: &mut i32, right: &mut i32) -> void:
    held := *left
    *left = *right
    *right = held

fn invalid() -> void:
    let mut scores = [+1, 2]
    swap(&mut scores[0], &mut scores[1]) # diagnostic: conflicting-access
