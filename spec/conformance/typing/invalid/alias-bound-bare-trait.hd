# test: a bare trait name in a trait argument in a transparent alias's parameter bound is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions.

trait Source[T]:
    fn read(self) -> T

type Checked[S < Source[Factory]] = S  # diagnostic: trait-used-as-type

trait Factory:
    fn create() -> Self
