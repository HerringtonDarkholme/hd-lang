# test: a using binding needs mutable access to its value, since dispose takes mut self
# Spec lang/06 Using Bindings: flow.using.access.readonly.
use std.ops.Disposable

data Lock:
    name: string

impl Disposable for Lock:
    fn dispose!(&mut self) -> void:
        pass

fn shared!(lock: Lock) -> void:
    using held = lock  # diagnostic: mutable-upgrade
