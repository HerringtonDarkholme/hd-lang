# test: a let-else pattern's names are not visible in its else block
# Spec 03 Let-Else Scope: names.let-else.not-in-else (owner decision LP1, batch 26, 2026-09-30).
fn find(id: i32) -> i32?:
    if id == 0: .Some(7) else: .None

fn read(id: i32) -> i32:
    let .Some(value) = find(id) else:
        return value  # diagnostic: unknown-name
    value + 1
