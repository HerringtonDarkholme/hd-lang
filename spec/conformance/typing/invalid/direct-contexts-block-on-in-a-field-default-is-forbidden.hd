# test: direct contexts block on in a field default is forbidden
use std.task.block_on

fn ready!() -> i32:
    42
struct Tag:
    name: string
fn tag_of[T](source: T) -> Tag:
    Tag { name: "t" }
fn done[T](end: T) -> i32:
    1
fn text!() -> string:
    "t"

struct D:
    id: i32 = done(block_on(ready())) # diagnostic: suspension-forbidden-context

pub fn main() -> void:
    pass
