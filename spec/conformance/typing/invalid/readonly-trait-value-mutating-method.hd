# test: traits / mutable errors / readonly dynamic
# Spec 09 Traits: trait.decl.mut-receiver, trait.dyn.ref.member.mut.

trait Add:
    fn add(&mut self) -> void
struct Counter:
    value: i32
impl Add for Counter:
    fn add(&mut self) -> void: pass
fn invalid(value: &dyn Add) -> void: value.add()  # diagnostic: not-writable
