# test: an iterator does not satisfy an Iterable bound

data Counter:
    current: i32
    end: i32

impl Iterator[i32] for Counter:
    fn next(mut self) -> i32?:
        if self.current >= self.end:
            return .None
        value := self.current
        self.current = self.current + 1
        value

fn count[I < Iterable[i32]](source: I) -> i32:
    let total: i32 = 0
    for item in source:
        total = total + item
    total

fn invalid(counter: mut Counter) -> i32:
    count(counter)  # diagnostic: unsatisfied-trait-bound
