# test: an entry module with main cannot install a local provider during initialization
# Spec 10: module.init.requirement-free.operations.
trait Source:
    fn read(&self) -> i32

struct Fixed: pass

impl Source for Fixed:
    fn read(&self) -> i32:
        +1

if true:
    $.with(Source=box(Fixed {})): # diagnostic: missing-requirement
        _ := $.use(Source).read()

pub fn main() -> void:
    pass
