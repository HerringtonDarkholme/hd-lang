# test: a bare trait name in a list element type in a local annotation is an error; the type is written dyn Factory
# Spec 09 Dynamic Trait Values: trait.dyn.keyword, trait.dyn.keyword.positions.

trait Factory:
    fn create() -> Self

fn collect() -> void:
    let factories: List[Factory] = []  # diagnostic: trait-used-as-type
    _ := factories
