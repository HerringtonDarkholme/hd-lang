# test: pointer loans, same root: a listener loop over a list behind a pointer that passes the same pointer to each listener is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

struct Bus:
    listeners: List[i32]
    total: i32

fn notify(bus: *mut Bus, weight: i32) -> void:
    bus.total += weight

fn publish(bus: *mut Bus) -> void:
    for weight in &bus.listeners:
        notify(bus, *weight) # diagnostic: conflicting-access
