# test: a retry! call requires its attempt's row, so a caller without Console is missing-requirement
# Spec std/task Retry: std-task.combinator.retry (owner decision RETRY-row, batch 33, 2026-10-01).
use std.task.retry

fn ask!() -> Result[string, string] $ Console:
    println("asking")
    .Ok("ready")

fn connect!() -> Result[string, string]:
    retry!(2):  # diagnostic: missing-requirement
        ask!()
