# test: generic call inference never converts an argument to a trait value
# Spec 04 Inference From Several Arguments: types.generic.infer.join.no-trait-value (INF-mut,
# owner decision 2026-09-30). A User and a Display argument of one T have no common type.

data User:
    name: string

impl Display for User:
    fn to_string(self) -> string:
        self.name

fn cmp[T < Display](left: T, right: T) -> bool:
    "$left" == "$right"

fn same(user: User, label: dyn Display) -> bool:
    cmp(user, label)  # diagnostic: no-common-type
