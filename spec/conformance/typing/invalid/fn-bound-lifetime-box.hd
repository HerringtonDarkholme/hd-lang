# test: boxing a closure read from a lifetime-bounded field is local-reference-escapes
# Spec 13 Lifetime Bounds: ref.generic.outlives.box.
use std.function.FnMut

struct Counter:
    n: i32

struct Button[F < FnMut() -> void & 'a, 'a]:
    on_click: F

fn keep(c: &mut Counter) -> void:
    b := Button { on_click: fn(): c.n += 1 }
    kept := box(b.on_click) # diagnostic: local-reference-escapes
