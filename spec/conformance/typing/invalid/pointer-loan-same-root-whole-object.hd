# test: pointer loans, same root: a `&mut` and a `&` of one boxed object is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn probe(a: *mut Cell) -> i32:
    b := &mut *a
    c := &*a # diagnostic: conflicting-access
    b.change()
    c.read()
