# test: a suffix function's requirement row joins the caller's row, as any call's does
# Spec 05 Literal Suffixes: expr.suffix.ordinary-rules; `12px` needs Console where the row is empty.
use std.ops.num_suffix

pub data Pixels:
    count: i32

@num_suffix
fn px(count: i32) -> Pixels $ Console:
    Pixels { count: count }

pub fn layout() -> Pixels:
    12px  # diagnostic: missing-requirement
