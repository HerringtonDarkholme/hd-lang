# test: a suffix function needs no providers, checked at the literal
# Spec 05 Literal Suffixes: expr.suffix.fn-shape.reader reports a provider-needing suffix at `12px`.
use std.ops.num_suffix

data Pixels:
    count: i32

@num_suffix
fn px(count: i32) -> Pixels $ Console:
    Pixels { count: count }

fn layout() -> Pixels $ Console:
    12px  # diagnostic: invalid-literal-suffix
