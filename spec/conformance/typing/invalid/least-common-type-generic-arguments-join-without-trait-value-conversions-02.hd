# test: generic arguments join without trait value conversions
# Spec lang/04-type-system.md: types.lct.sites.

struct User:
    name: string

impl Display for User:
    fn to_string(self) -> string:
        self.name

trait Named:
    fn name(self) -> string

trait Shown < Named:
    fn show(self) -> string

trait Tagged < Named:
    fn tag(self) -> string

fn same[T](left: T, right: T) -> bool:
    true

fn f(u: User, d: &dyn Display) -> bool:
    same(d, u) # diagnostic: no-common-type
