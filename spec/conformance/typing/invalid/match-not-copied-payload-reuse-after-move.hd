# test: a payload that is not copied moves out of the matched value, so matching the value again is an error
# Spec 06 Payload Bindings: flow.match.no-ownership-copied. Spec 13 Moves: ref.move.pattern.
struct Ticket:
    id: i32

impl !Copy for Ticket

enum Slot:
    Full(ticket: Ticket)
    Empty

fn spend(t: Ticket) -> i32:
    t.id

fn twice(s: Slot) -> i32:
    match s:
        .Full(ticket) => spend(ticket)
        .Empty => 0
    match s: # diagnostic: use-of-moved-value
        .Full(ticket) => spend(ticket)
        .Empty => 0
