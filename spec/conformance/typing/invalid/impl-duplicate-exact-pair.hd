# test: a second implementation of one trait for one target is an overlap
# Spec 09 Implementation Declarations: trait.impl.unique; Overlap: trait.overlap.definition, trait.overlap.error.
trait Billable:
    fn amount(self) -> i32

data Invoice:
    total: i32

impl Billable for Invoice:
    fn amount(self) -> i32:
        self.total

impl Billable for Invoice:  # diagnostic: overlapping-impl
    fn amount(self) -> i32:
        +0
