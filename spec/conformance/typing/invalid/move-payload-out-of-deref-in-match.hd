# test: a match arm on `*r` that binds a non-copyable payload by value moves it out of the reference
# Spec 13 Values And References: ref.move.pattern, ref.move.out-of-place.
struct Photo:
    width: u32

impl !Copy for Photo

enum Slot:
    Empty
    Full(Photo)

fn take(p: Photo) -> void:
    pass

fn use_slot(r: &Slot) -> void:
    match *r:
        .Full(p) => take(p) # diagnostic: move-out-of-place
        .Empty => pass
