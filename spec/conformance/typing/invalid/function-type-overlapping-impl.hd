# test: an implementation over Fn[Args, O, $ R] overlaps one for a concrete function type
# Spec 09 Traits: trait.target.function-type, trait.overlap.unify, trait.overlap.error.
use std.function.{Fn, Tuple}

trait Marker

impl[Args < Tuple, O, $R] Marker for Fn[Args, O, $ R]
impl Marker for fn(i32) -> i32  # diagnostic: overlapping-impl
