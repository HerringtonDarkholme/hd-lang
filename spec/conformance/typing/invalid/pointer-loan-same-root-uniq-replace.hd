use std.collections.UniqList

struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

struct Bag:
    items: UniqList[i32]

fn probe(a: *mut Bag) -> i32:
    c := a.items.get_ref(0).expect("slot")
    a.items = UniqList::[i32].new() # diagnostic: conflicting-access
    *c
