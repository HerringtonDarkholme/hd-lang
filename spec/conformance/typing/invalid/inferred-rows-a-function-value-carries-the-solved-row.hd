# test: a function value carries the solved row
# Spec lang/11-requirements-and-suspension.md: req.row.omitted.inferred-private.

pub trait Tag:
    fn name(self) -> string

pub trait Log:
    fn tag(self) -> string

struct Named:
    label: string

impl Tag for Named:
    fn name(self) -> string: self.label

impl Log for Named:
    fn tag(self) -> string: self.label

job := outer

fn outer() -> string:
    inner()

fn inner() -> string:
    $.use(Tag).name()

pub fn bound() -> string $ Tag:
    job()

pub fn free() -> string:
    job() # diagnostic: missing-requirement
