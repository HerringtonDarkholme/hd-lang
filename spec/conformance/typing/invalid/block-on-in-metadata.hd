# test: a member metadata expression may not call block_on directly
use std.task.block_on

data Rename:
    name: string

fn ready!() -> string:
    "mail"

fn rename_to[T](source: T) -> Rename:
    Rename { name: "mail" }

data User:
    @rename_to(block_on(ready()))  # diagnostic: suspension-forbidden-context
    email: string
