# test: a trait-qualified call whose `Self` is a trait value reference reaches no generic member
# Spec 09 Dynamic Safety: trait.dyn.member.unavailable.error; the
# by-value receiver makes `Self` the `&dyn Tr` argument, so the call goes
# through the trait value.
trait Tr:
    fn pick[U](self, u: U) -> U

fn f(v: &dyn Tr) -> void:
    let b = Tr::pick(v, 1) # diagnostic: dyn-member-unavailable
