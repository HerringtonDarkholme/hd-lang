# test: a kept `&mut` of a tuple while a reference to its element is live is conflicting-access
# Spec 13 Writes While Borrowed: ref.place.tuple-element, ref.excl.write.
fn demo() -> i32:
    let mut pair = (+1, +2)
    left := &pair._0
    whole := &mut pair # diagnostic: conflicting-access
    *left
