# test: a skipped positional payload needs its type's Default implementation under derived Deserialize
# Spec std/serde Skipped Members: std-serde.skip.positional-no-default.
use std.serde.{Deserialize, skip}

struct Cached:
    hits: i32

@derive(Deserialize) # diagnostic: omitted-member-without-default
enum Record:
    CachedValue(
        @skip()
        Cached,
    )
