# test: a List helper callback with a requirement row does not fit its empty-row parameter
# Spec std/collections List Helpers: std-collections.helper.callback-row.

trait Logger

fn noisy(value: i32) -> bool $ Logger:
    value > 0

fn some_positive(values: List[i32]) -> bool $ Logger:
    values.any(noisy)  # diagnostic: type-mismatch
