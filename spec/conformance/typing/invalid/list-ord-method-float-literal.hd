# test: `sorted` from `impl[T < Ord] List[T]` on float literals is an unmet bound at the call, once the literals settle to f64
# Spec 03 Method Lookup: names.method-lookup.inherent.bounds; Spec 09 Traits: trait.cmp.float-ord.
pub fn sorted_copy() -> List[f64]:
    [1.5, 0.5].sorted() # diagnostic: unsatisfied-trait-bound
