# test: read-only is transitive: a `&mut` field read through a `&T` is a `&`, so a write through it is readonly-root
# Spec 13 Reading Through A Reference: ref.read.weaken. Writing Through A Reference: ref.write.field.
struct User:
    name: string

struct Team:
    lead: &mut User

fn invalid(t: &Team) -> void:
    t.lead.name = "x"  # diagnostic: readonly-root
