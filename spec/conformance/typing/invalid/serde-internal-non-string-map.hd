# test: internal tagging accepts only a string-key map as a newtype payload
# Spec std/serde Enum Names And Tagging: std-serde.enum-tagging.internal-shapes.
use std.serde.{Serialize, tag}

@derive(Serialize)
@tag("type")
enum Invalid:
    Values(Map[bool, i32]) # diagnostic: invalid-internal-tagged-variant
