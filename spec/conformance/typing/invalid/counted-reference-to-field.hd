# test: no expression makes a counted reference to a field; `&mut h.inner` is local
# Spec 13 Boxes: ref.box.object; Places And New Objects: ref.expr.kind.no-counted.
struct Point:
    x: i32

struct Holder:
    inner: Point

fn keep(p: *mut Point) -> void: pass

fn invalid() -> void:
    let mut h = Holder { inner: Point { x: 0 } }
    keep(&mut h.inner) # diagnostic: local-reference-escapes
