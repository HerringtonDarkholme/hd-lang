# test: a trait's own method stores a local reference through `Self::Item`'s bound at the trait's lifetime
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument. `Self` is
# bounded by `Shelf['b]`, so `Self::Item`'s bound is `Store[&'b Point]`.
struct Point:
    x: i32

trait Store[T]:
    fn put(&mut self, value: T) -> void

trait Shelf['b]:
    type Item < Store[&'b Point]
    fn go(&self, s: &mut Self::Item, p: &'b Point) -> void:
        q := Point { x: 7 }
        s.put(&q) # diagnostic: local-reference-escapes
