# test: calling a value reaches apply
# Spec lang/10-modules.md: module.init.definite.implicit.

struct Tag:
    n: i32
use std.ops.Apply

first := Tag { n: 1 }() # diagnostic: top-level-read-before-initialization
later := +5

impl Apply for Tag:
    type Out = i32
    fn apply(self) -> i32: self.n + later

pub fn main() -> void $ Console:
    println(first)
