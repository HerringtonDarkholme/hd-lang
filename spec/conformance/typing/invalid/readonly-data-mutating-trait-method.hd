# test: traits / mutable errors / readonly static
# Spec 09 Traits: trait.decl.mut-receiver.

trait Add:
    fn add(&mut self) -> void
struct Counter:
    value: i32
impl Add for Counter:
    fn add(&mut self) -> void:
        pass
fn invalid(value: Counter) -> void:
    value.add() # diagnostic: not-writable
