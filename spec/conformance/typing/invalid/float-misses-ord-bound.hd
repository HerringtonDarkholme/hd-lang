# test: a float argument does not satisfy an Ord bound
# Spec 09 Traits: a candidate whose argument misses the bound is rejected.
# Spec 09 Traits: trait.cmp.float-ord, trait.bound.unsatisfied.
fn smallest[T < Ord](value: T) -> T: value

fn main() -> f64: smallest(1.5)  # diagnostic: unsatisfied-trait-bound
