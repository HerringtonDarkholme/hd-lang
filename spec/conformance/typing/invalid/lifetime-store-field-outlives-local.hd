# test: a struct used after the block of the local a call stored into its field outlives that local
# Spec 13 Lifetime Stores: ref.lifetime.store.field.call; Local Scope: ref.dep.scope.
struct Two['a, 'b]:
    x: &'a string
    y: &'b string

fn set_x['a, 'b](t: &mut Two['a, 'b], s: &'a string) -> void:
    t.x = s

fn demo(outer: string) -> usize:
    let mut t = Two { x: &outer, y: &outer }
    if outer.len() > 0:
        inner := "hello"
        set_x(&mut t, &inner)
    t.x.len() # diagnostic: local-reference-outlives-local
