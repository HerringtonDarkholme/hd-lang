# test: passing a value whose closure captures a local reference for a parameter with a function type written inside another type is local-reference-escapes
# Spec 13 Lifetime Bounds: ref.generic.outlives.written.
use std.function.FnMut

struct Counter:
    n: i32

struct Plain[F < FnMut() -> void]:
    on_click: F

fn wrap[F < FnMut() -> void](f: F) -> Plain[F]:
    Plain { on_click: f }

fn take(p: Plain[fn() -> void]) -> void:
    pass

fn give(c: &mut Counter) -> void:
    take(wrap(fn(): c.n += 1)) # diagnostic: local-reference-escapes
