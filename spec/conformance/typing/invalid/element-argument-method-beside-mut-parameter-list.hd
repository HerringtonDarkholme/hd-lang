# test: a later argument that calls a &mut self method on a list reached through a &mut parameter during an element reference's call conflicts
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.conflict.method.
fn place(target: &mut i32, value: i32) -> void:
    *target = value

fn through(scores: &mut List[i32]) -> void:
    place(&mut scores[0], scores.remove_at(1)) # diagnostic: conflicting-access
