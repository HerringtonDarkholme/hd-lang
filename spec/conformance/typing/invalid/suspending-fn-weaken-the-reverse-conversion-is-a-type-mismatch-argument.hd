# test: the reverse conversion is a type mismatch
trait Clock:
    fn instant(self) -> usize
use std.function.{Fn, SuspendFn}

fn plus!(by: i32) -> i32:
    by + 1

fn tick!(by: i32) -> i32 $ Clock:
    by + 1

fn ticker(by: i32) -> Suspend[i32] $ Clock:
    tick(by + 10)

fn drive!(constructor: fn(i32) -> Suspend[i32] $ Clock) -> i32 $ Clock:
    let pending: Suspend[i32] = constructor(41)
    pending!()

fn takes(op: fn!(i32) -> i32 $ Clock) -> void:
    _ := op

pub fn main() -> void:
    takes(ticker) # diagnostic: type-mismatch
