# Spec 11 Mutable Providers: req.mut.install-writable-ref; Spec 11 Providers Behind References: req.ref.install-ref. A `&Tally` does not install a provider for a trait with a `&mut self` method.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn shared(tally: &Tally) -> void:
    $.with(Counter=tally):  # diagnostic: mutable-upgrade
        pass
