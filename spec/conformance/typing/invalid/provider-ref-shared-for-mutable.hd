# Spec 11 Installing: req.mut.install-writable-counted; Spec 11 Keys Of Reference Receiver Traits: req.ref.install-counted. A `*Tally` does not install a provider for a trait with a `&mut self` method.
trait Counter:
    fn bump(&mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn shared(tally: *Tally) -> void:
    $.with(Counter=tally): # diagnostic: mutable-upgrade
        pass
