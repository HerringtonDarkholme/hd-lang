# test: a vararg function's value takes its collected list as one parameter, so it does not fit a two-input function type

fn sum(values...: List[i32]) -> i32: values.len()
fn apply_callback(callback: fn(i32, i32) -> i32) -> i32: callback(1, 2)
fn main() -> i32: apply_callback(sum)  # diagnostic: type-mismatch
