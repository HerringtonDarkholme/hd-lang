# test: replacing the `*mut` a live result path crosses
# Spec 13 Result Paths: ref.result.path.counted.
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User
    size: i32

fn lead_name(t: &Team) -> &'t.lead.name string:
    &t.lead.name

fn swap(t: &mut Team) -> void $ Console:
    n := lead_name(t)
    t.lead = box(User { name: "Kay", age: 1 }) # diagnostic: conflicting-access
    println(*n)
