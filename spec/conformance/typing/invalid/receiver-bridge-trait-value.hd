# Spec 09 Receivers Of Struct Implementations: trait.impl.receiver-bridge.serves, trait.impl.receiver-bridge.other-uses. A bare trait value calls the method through the trait's `mut self`.
trait Counter:
    fn bump(mut self) -> void

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1

fn demo() -> void:
    tally := Tally { n: 0 }
    let erased: mut dyn Counter = tally  # diagnostic: unsatisfied-trait-bound
    erased.bump()
