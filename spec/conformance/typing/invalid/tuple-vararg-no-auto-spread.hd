# test: a tuple argument is never spread automatically; call(add2, (1, 2)) makes Args a one-element tuple
use std.function.{Fn, Tuple}

fn add2(a: i32, b: i32) -> i32: a + b

fn call[Args < Tuple, O, R](f: Fn[Args, O, R], args...: Args) -> O $ R:
    f(args...)

fn nested() -> i32: call(add2, (1, 2))  # diagnostic: type-mismatch
