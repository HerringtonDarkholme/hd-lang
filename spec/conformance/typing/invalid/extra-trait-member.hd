# test: an implementation method that the trait does not declare is an error
# Spec 09 Implementation Declarations: trait.impl.extra-methods (error-code proposal F4).

trait Named:
    fn name(self) -> string

struct Admin: pass

impl Named for Admin:
    fn name(self) -> string:
        "admin"
    fn shout(self) -> string: # diagnostic: extra-trait-member
        "ADMIN"
