# test: a trait's parameter bound is checked against traits declared later
# Spec 09 Dynamic Safety: trait.dyn.safe.error; Spec 03 Module Scope: names.module.order-free.

trait Consumer[S < Source[Factory]]:  # diagnostic: trait-not-dynamically-safe
    fn consume(self, source: S) -> void

trait Source[T]:
    fn read(self) -> T

trait Factory:
    fn create() -> Self
