# test: FromIterator is not a prelude name
# std Iterators, What Collect Builds: std-iter.prelude.from-iterator (Collect CO6).

struct Bag:
    items: List[i32]

impl FromIterator[i32] for Bag: # diagnostic: unknown-trait
    fn from_iter[I < Iterator[i32]](items: I) -> Bag:
        let mut cursor = items
        Bag { items: items.collect() }
