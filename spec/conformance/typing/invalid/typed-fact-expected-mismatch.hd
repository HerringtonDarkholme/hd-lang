# test: a generic function value that no type argument fits to the field's declared type is still a type mismatch
# Spec 14 Member-Typed Facts: annot.typed-fact.check
# (owner decisions FACT-EXPECTED, batch 38, and ANNOTATE-TYPED, batch 39, 2026-10-01).
use std.annotation.annotate

@annotate::[F](.Field)
data Fallback[F]:
    make: fn() -> F?

fn fallback[F](make: fn() -> F?) -> Fallback[F]:
    Fallback::[F] { make: make }

fn missing_list[T]() -> List[T]?:
    .None

data Profile:
    @fallback(missing_list)
    tags: List[string]
    @fallback(missing_list)  # diagnostic: type-mismatch
    name: string
