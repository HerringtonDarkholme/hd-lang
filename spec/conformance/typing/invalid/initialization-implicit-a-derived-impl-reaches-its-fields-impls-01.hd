# test: a derived impl reaches its fields impls
# Spec lang/10-modules.md: module.init.definite.implicit.

struct Tag:
    n: i32
@derive(Eq)
struct Wrap:
    t: Tag

first := Wrap { t: Tag { n: 1 } } == Wrap { t: Tag { n: 6 } } # diagnostic: top-level-read-before-initialization
later := +5

impl Eq for Tag:
    fn eq(self, other: Tag) -> bool:
        self.n + later == other.n

pub fn main() -> void $ Console:
    println(first)
