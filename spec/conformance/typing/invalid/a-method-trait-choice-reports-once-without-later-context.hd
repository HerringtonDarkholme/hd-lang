# test: an unresolved method trait reports at the call only
trait Left:
    fn choose(self) -> i32

trait Right:
    fn choose(self) -> i32

struct Holder[T]:
    item: T

impl Left for Holder[i32]:
    fn choose(self) -> i32:
        +1

impl Right for Holder[string]:
    fn choose(self) -> i32:
        +2

fn unknown[T]() -> Holder[T]:
    panic("unused")

fn probe() -> void:
    let known: Holder[i32] = unknown()
    value := unknown()
    _ := value.choose() # diagnostic: cannot-infer-type
