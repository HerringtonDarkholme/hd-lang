# test: a bare row alias in the slot of a function's row parameter is a kind mismatch
# Spec 07 Explicit Type Arguments: fn.generic.explicit.row-dollar.
trait Log

type AppRow = $ Log

fn run[$ R]() -> void $ R:
    pass

fn caller() -> void $ Log:
    run::[AppRow]() # diagnostic: generic-kind-mismatch
