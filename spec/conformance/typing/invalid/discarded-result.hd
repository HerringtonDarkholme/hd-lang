# Spec 06 Must-Use Values: flow.must-use.statement,
# flow.unused.must-use.
data SaveError:
    message: string

fn save() -> Result[i32, SaveError]:
    .Err(SaveError { message: "failed" })

fn save_all(values: List[i32]) -> void:
    for value in values:
        save()  # diagnostic: discarded-must-use-value
