# test: a call through the union needs every key
# Spec lang/11-requirements-and-suspension.md: req.row.union.literal.type.

trait Db:
    fn name(self) -> string

trait Clock:
    fn now(self) -> string

trait Log:
    fn tag(self) -> string

struct MemoryDb: pass

impl Db for MemoryDb:
    fn name(self) -> string:
        "db"

struct FixedClock: pass

impl Clock for FixedClock:
    fn now(self) -> string:
        "noon"

struct Tagged: pass

impl Log for Tagged:
    fn tag(self) -> string:
        "log"

fn health() -> string $ Clock:
    $.use(Clock).now()

fn orders() -> string $ Db:
    $.use(Db).name()

fn audit() -> string $ Log:
    $.use(Log).tag()

fn serve(admin: bool) -> string $ Clock:
    handler := if admin: health else: orders
    handler() # diagnostic: missing-requirement

pub fn main() -> void $ Console:
    println(1)
