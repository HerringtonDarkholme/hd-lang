# test: a function value read from a field of the result of a function a struct field holds passes its argument at the lifetime that result writes
# Spec 07 Function Types: fn.type.lifetime.call.written. `m.g`'s result
# is a `Holder['a, T]` at `Maker`'s `'a`, the caller's `'a`.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

struct Maker['a, T]:
    g: fn(&'a Point) -> Holder['a, T]

fn in_field['a, T](m: Maker['a, T], p: &'a Point) -> T:
    q := Point { x: 1 }
    ((m.g)(p).f)(&q) # diagnostic: local-reference-escapes
