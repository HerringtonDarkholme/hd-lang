# expect-error: ambiguous-method

trait LeftLabel:
    fn label(self) -> string

trait RightLabel:
    fn label(self) -> string

struct User:
    name: string

impl LeftLabel for User:
    fn label(self) -> string: self.name

impl RightLabel for User:
    fn label(self) -> string: self.name

fn invalid(user: User) -> string:
    user.label()
