# test: names bound in a comprehension are not visible after it
# Spec 03 Comprehensions: "A comprehension introduces one scope that does not leak into the enclosing
# scope." and "The names `user` and `label` are not visible after the comprehension."
fn doubled(values: list[i32]) -> i32:
    results := [for value in values => value * 2]
    value  # diagnostic: unknown-name
