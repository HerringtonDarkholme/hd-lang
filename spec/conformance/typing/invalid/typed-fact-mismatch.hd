# test: a typed fact's value checks like `let f: Fact[i32] = fact(...)` on `a: i32`, so a string value is a type mismatch at its decorator
# Spec 14 Member-Typed Facts: annot.typed-fact.check and
# annot.typed-fact.check.reported (owner decision ANNOTATE-TYPED, batch 39, 2026-10-01).
use std.annotation.annotate

@annotate::[T](.Field)
struct Fact[T]:
    value: T

fn fact[T](value: T) -> Fact[T]:
    Fact::[T] { value: value }

struct Account:
    @fact(5)
    a: i32
    @fact("x") # diagnostic: type-mismatch
    b: i32
