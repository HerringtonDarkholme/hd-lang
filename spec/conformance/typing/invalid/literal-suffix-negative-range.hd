# test: a negated suffixed literal below the minimum of the parameter type
# Spec 04 Suffixed Literals: the negated literal is checked against the parameter type as a unit.
use std.ops.num_suffix

data Offset:
    value: i32

@num_suffix
fn off(value: i32) -> Offset:
    Offset { value: value }

fn too_low() -> Offset:
    -2147483649off  # diagnostic: integer-literal-range
