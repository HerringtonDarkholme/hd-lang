# test: a minus before a suffixed literal is not part of the literal
# Spec 04 Suffixed Literals: `-2147483648off` is -(off(2147483648)), and 2147483648 does not fit i32.
use std.ops.num_suffix

@num_suffix
fn off(value: i32) -> i32:
    value

fn lowest() -> i32:
    -2147483648off  # diagnostic: integer-literal-range
