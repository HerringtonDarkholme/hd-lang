# test: a derived Hash beside a hand-written Eq mixes related traits
# Spec 09 Traits: trait.derive.related.hash, trait.derive.related.error.

@derive(Hash)  # diagnostic: mixed-derived-law
data Session:
    token: string
    cache: string

impl Eq for Session:
    fn eq(self, other: Session) -> bool:
        self.token == other.token
