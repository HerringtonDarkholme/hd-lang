# test: a user trait that extends AnyRef cannot be implemented for a newtype over string
# Spec 09 Sealed Traits: trait.sealed.extend.missing; Spec 04 Trait Values And Any: types.sealed.newtype.

trait Entity < AnyRef:
    fn key(self) -> string

type Message(string)

impl Entity for Message:  # diagnostic: missing-supertrait-implementation
    fn key(self) -> string:
        string(self)
