# test: with an expected element type, each element is checked against its row
# Spec 11 Row Union In Literals: req.row.union.literal.expected.
trait Db

trait Clock

fn health() -> string $ Clock:
    "ok"

fn orders() -> string $ Db:
    "orders"

fn table() -> List[fn() -> string $ Clock]:
    let handlers: List[fn() -> string $ Clock] = [health, orders] # diagnostic: type-mismatch
    handlers
