# test: self in a list is unavailable on a dyn value
# Rules: trait.dyn.member.self, trait.dyn.member.unavailable.error, trait.dyn.member.other-with-opaque.
trait Shape:
    fn area(self) -> i32
    fn same_as(self, other: Self) -> bool
    fn twin(self) -> Self
    fn pair(self) -> List[Self]
    fn each(self, f: fn(Self) -> void) -> void
    fn pick[T](self, x: T) -> T
    fn many[T](self, xs: List[T]) -> List[T]

struct Sq:
    n: i32

impl Shape for Sq:
    fn area(self) -> i32:
        self.n * self.n
    fn same_as(self, other: Sq) -> bool:
        self.n == other.n
    fn twin(self) -> Sq:
        self
    fn pair(self) -> List[Sq]:
        [self]
    fn each(self, f: fn(Sq) -> void) -> void:
        f(self)
    fn pick[T](self, x: T) -> T:
        x
    fn many[T](self, xs: List[T]) -> List[T]:
        xs

fn use_it(s: &dyn Shape) -> void:
    s.pair() # diagnostic: dyn-member-unavailable

pub fn main() -> void:
    pass
