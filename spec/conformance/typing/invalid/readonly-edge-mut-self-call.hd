# test: a &mut self call through a `&` field is not-writable
# Spec 04 Writable Places: types.path.store.not-writable.

struct Child:
    name: string

impl Child:
    fn rename(&mut self, name: string) -> void:
        self.name = name

struct Parent:
    child: *Child

fn invalid(parent: &mut Parent) -> void:
    parent.child.rename("new")  # diagnostic: not-writable
