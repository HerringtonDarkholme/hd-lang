# test: pointer loans, same root: a `&mut` and a `&` of one field behind a pointer is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn probe(a: *mut Cell) -> i32:
    b := &mut a.n
    c := &a.n # diagnostic: conflicting-access
    *b += 1
    *c
