# test: a function value read through a reference a function value returns passes its argument at the lifetime the referent writes
# Spec 07 Function Types: fn.type.lifetime.call.written. `g` returns a
# `&Holder['a, T]`, whose field `f` passes `&q` at the caller's `'a`.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn by_ref['a, T](g: fn(&'a Point) -> &Holder['a, T], p: &'a Point) -> T:
    q := Point { x: 1 }
    (g(p).f)(&q) # diagnostic: local-reference-escapes
