# test: `&mut` of a value that is a readonly view is mutable-upgrade, though the new object is writable
# Spec 13 Places And New Objects: ref.expr.allocate.view.
data User:
    name: string

fn lookup() -> User:
    User { name: "a" }

fn invalid() -> void:
    _ := &mut lookup()  # diagnostic: mutable-upgrade
