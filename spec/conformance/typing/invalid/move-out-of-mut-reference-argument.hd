# test: `*r` through a `&mut` cannot move a value that holds a `&mut` into a generic argument
# Spec 13 Moves: ref.move.out-of-place.
struct Holder['a]:
    target: &'a mut i32
    count: i32

fn keep[T](x: T) -> void:
    pass

fn whole(r: &mut Holder) -> void:
    keep(*r) # diagnostic: move-out-of-place
