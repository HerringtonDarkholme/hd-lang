# test: pointer loans, same root: passing a `*mut` and a `&` of its field to one call is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn mutate(c: *mut Cell, f: &i32) -> i32:
    c.n + *f

fn probe(boxed: *mut Cell) -> i32:
    mutate(boxed, &boxed.n) # diagnostic: conflicting-access
