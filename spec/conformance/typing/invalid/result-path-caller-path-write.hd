# test: a write to a result path's place while the call's result is live
# Spec 13 Result Paths: ref.result.path.caller.
struct User:
    name: string
    age: i32

impl User:
    fn name(&self) -> &'self.name string:
        &self.name

fn rename(u: &mut User) -> void $ Console:
    n := u.name()
    u.name = "x" # diagnostic: conflicting-access
    println(*n)
