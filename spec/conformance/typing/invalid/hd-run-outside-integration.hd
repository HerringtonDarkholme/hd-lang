# test: hd_run! in a tests block, outside an integration test module, is test-only-use
# Spec std Testing, Running Executables: std-testing.hd-run.integration-only (batch 55).
use std.process.Command
tests:
    use std.testing.hd_run

    it("runs the binary"):
        _ := hd_run!(*Command::new("hello")) # diagnostic: test-only-use
