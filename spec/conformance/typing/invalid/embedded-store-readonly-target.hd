# test: storing into an embedded field through a `&` reference is not-writable, as for any store
# Spec 04 Writable Places: types.path.store.not-writable.
struct Stamp:
    at: i32

struct Post:
    Stamp
    title: string

fn touch(post: &Post, stamp: Stamp) -> void:
    post.Stamp = stamp  # diagnostic: not-writable
