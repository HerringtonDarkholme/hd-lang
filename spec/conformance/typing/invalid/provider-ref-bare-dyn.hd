# Spec 11 Providers Behind References: req.ref.install-ref; Spec 09 Trait Value References: trait.dyn.ref.bare-reference-method. A bare trait value holds no reference, so `&` on it is no provider for a trait with a `&self` method.
trait Shown:
    fn shown(&self) -> string

fn demo(shown: dyn Shown) -> void:
    $.with(Shown=&shown):  # diagnostic: dyn-member-unavailable
        pass
