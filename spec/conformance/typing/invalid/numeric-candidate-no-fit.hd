# test: a bare literal applies to no numeric candidate, so selection fails
# Spec 09 Traits: trait.resolve.literal-arg.no-apply (no candidate takes usize).
trait Build[T]:
    fn build(value: T) -> Item

data Item:
    value: i32

impl Build[i64] for Item:
    fn build(value: i64) -> Item: Item { value: 0 }

impl Build[i32] for Item:
    fn build(value: i32) -> Item: Item { value: value }

fn probe() -> i32:
    Item::build(value=42).value  # diagnostic: type-mismatch
