# expect-error: annotation-build-signature
data Validation: pass
data Validator: pass
data FieldValidator: pass

impl Annotation for Validation:
    type Info = Validator

impl DataAnnotator for Validation:
    type FieldTarget = FieldValidator

    fn map_field(
        self,
        field: FieldShape,
        type_metadata: AnnotationRef[Validator],
    ) -> FieldValidator:
        FieldValidator {}

    fn build(
        self,
        target: DataShape,
        fields: map[string, FieldValidator],
    ) -> Validator:
        Validator {}
