# test: a nested pattern whose equalities contradict the outer ones is statically impossible
# Spec 13 Exhaustiveness And Nesting: gadt.unify.nested, gadt.unify.contradiction; Pattern Refinement: gadt.refine.impossible.
enum Expr[T]:
    IntLit(value: i64) -> Expr[i64]
    BoolLit(value: bool) -> Expr[bool]
    If[T](cond: Expr[bool], then_value: Expr[T], else_value: Expr[T]) -> Expr[T]

fn constant_branch[T](expr: Expr[T]) -> bool:
    match expr:
        Expr.If(Expr.BoolLit(_), _, _) => true
        Expr.If(Expr.IntLit(_), _, _) => false  # diagnostic: impossible-gadt-pattern
        _ => false
