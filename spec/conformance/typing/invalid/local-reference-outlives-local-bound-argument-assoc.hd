# test: a call whose parameter is a projection with a bound that writes a lifetime relates its slots to that lifetime
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument. `S::Item`'s
# slots are at `fill`'s `'a`, which `&q` is too, so `k` holds `&q` past
# `q`'s block.
struct Point:
    x: i32

trait Store[T]:
    fn put(&mut self, value: T) -> void

trait Shelf['b]:
    type Item < Store[&'b Point]

struct Keep['a]:
    last: &'a Point

impl['a] Store[&'a Point] for Keep['a]:
    fn put(&mut self, value: &'a Point) -> void:
        self.last = value

struct Sh:
    n: i32

impl['b] Shelf['b] for Sh:
    type Item = Keep['b]

fn fill['a, S < Shelf['a]](s: &mut S::Item, p: &'a Point) -> void:
    s.put(p)

pub fn main() -> void $ Console:
    p := Point { x: 3 }
    let mut k = Keep { last: &p }
    if true:
        q := Point { x: 4 }
        fill::[Sh](&mut k, &q)
    println(k.last.x) # diagnostic: local-reference-outlives-local
