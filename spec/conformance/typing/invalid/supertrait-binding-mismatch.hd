# test: an implementation whose supertrait binds another Out is rejected
# Spec 09 Supertrait Bindings: trait.binding.super.mismatch (Operator Traits OP8).
use std.ops.Add

trait Summable < Add[Out = Self]

data Money:
    cents: i64

impl Add for Money:
    type Out = i64
    fn add(self, rhs: Money) -> i64:
        self.cents + rhs.cents

impl Summable for Money  # diagnostic: missing-supertrait-implementation
