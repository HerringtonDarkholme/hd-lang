trait Number:
    fn number(self) -> i32
impl Number for i32:
    fn number(self) -> i32:
        self
impl Number for i32?:
    fn number(self) -> i32:
        match self:
            .Some(value) => value
            .None => +0
fn mixed(flag: bool) -> impl Number:
    if flag: .Some(+1) else: +2 # diagnostic: type-mismatch
