# test: a newtype has the .Newtype kind, so a value limited to data types and enums is rejected before it
# Spec 14 Target Kinds: annot.target.kind.newtype-kind and annot.target.limit.kind-error (Decorators D10).
use std.annotation.annotate

@annotate(.Data, .Enum)
struct Wire:
    tag: string

fn wire(tag: string) -> Wire:
    Wire { tag: tag }

@wire("user")
struct User:
    id: i64

@wire("id")  # diagnostic: decorator-target-kind
type UserId(i64)
