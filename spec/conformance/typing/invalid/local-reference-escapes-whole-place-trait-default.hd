# test: a trait's default body stores into a `&mut Self::Item` place at the trait's lifetimes
# Spec 13 Lifetime Stores: ref.lifetime.store.call; Lifetime Traits:
# ref.lifetime.trait.bound-argument. In `Shelf['b]`'s own bodies
# `Self::Item` is at `'b`, so `*d` is the caller's place at `'b`, and
# `self.make(&q)` holds `q`.
struct Point:
    x: i32

trait Shelf['b]:
    type Item
    fn make(&self, v: &'b Point) -> Self::Item
    fn fill(&self, d: &mut Self::Item, p: &'b Point) -> void:
        q := Point { x: 1 }
        *d = self.make(&q) # diagnostic: local-reference-escapes
