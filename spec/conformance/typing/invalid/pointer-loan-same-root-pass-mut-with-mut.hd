# test: pointer loans, same root: passing a `*mut` and a `&mut` of its field to one call is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn mutate(c: *mut Cell, f: &mut i32) -> void:
    *f += c.n

fn probe(boxed: *mut Cell) -> void:
    mutate(boxed, &mut boxed.n) # diagnostic: conflicting-access
