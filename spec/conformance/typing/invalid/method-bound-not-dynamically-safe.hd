# test: a trait method's parameter bound is checked against traits declared later
# Spec 09 Dynamic Safety: trait.dyn.safe.error; Spec 03 Module Scope: names.module.order-free.

trait Consumer:
    fn consume[S < Source[dyn Factory]](self, source: S) -> void  # diagnostic: trait-not-dynamically-safe

trait Source[T]:
    fn read(self) -> T

trait Factory:
    fn create() -> Self
