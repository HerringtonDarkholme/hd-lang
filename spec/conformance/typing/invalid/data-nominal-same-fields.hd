# test: two structs with the same fields are different types
# Spec 08 Struct Declarations: data.decl.nominal.
struct CustomerId:
    value: i64

struct OrderId:
    value: i64

fn find_order(id: OrderId) -> i64:
    id.value

fn lookup(customer: CustomerId) -> i64:
    find_order(customer)  # diagnostic: type-mismatch
