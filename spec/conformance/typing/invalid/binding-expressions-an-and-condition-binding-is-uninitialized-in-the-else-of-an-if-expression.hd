# test: an and condition binding is uninitialized in the else of an if expression
fn f(flag: bool, found: i32?) -> i32?:
    r := if flag && (n := 3) > 0:
        n
    else:
        if n > 0: # diagnostic: possibly-uninitialized-binding
            found
        else:
            found
    r
pub fn main() -> void:
    pass
