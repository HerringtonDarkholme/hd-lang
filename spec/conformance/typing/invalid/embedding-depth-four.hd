# test: a part at depth four is an error at the declaration of the type that reaches it
# Spec 08 Embedding Limits: data.embed.depth.
struct Stamp:
    at: i32

struct Audit:
    Stamp
    by: string

struct Record:
    Audit
    id: string

struct Page:
    Record
    title: string

struct Site:
    Page  # diagnostic: embedding-too-deep
    host: string
