# test: a call that takes &mut of a map reached through a &mut parameter beside a reference to one of its values conflicts
# Spec 13 Call-Scoped Access: ref.elem.conflict, ref.elem.conflict.reference.
fn change(stock: &mut Map[string, i32], apples: &mut i32) -> void:
    stock["pear"] = 1
    *apples += 1

fn through(stock: &mut Map[string, i32]) -> void:
    change(stock, &mut stock["apple"]) # diagnostic: conflicting-access
