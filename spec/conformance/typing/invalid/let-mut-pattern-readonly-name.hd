# test: a name without mut in a multi-name let cannot be changed in place
struct User:
    name: string

fn pair() -> (User, User):
    (User { name: "Ada" }, User { name: "Grace" })

fn invalid() -> void:
    let (mut first, second) = pair()
    first.name = "Lin"
    second.name = "Kay"  # diagnostic: not-writable
