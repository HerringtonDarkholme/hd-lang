# test: std implements Default only for tuples of at most 12 elements, so a 13-element tuple has none
# Spec std/ops Standard Implementations: std-ops.default.std.missing (owner decision Q6-default, batch 35, 2026-10-01).
use std.ops.Default

fn fresh[T < Default]() -> T:
    T::default()

fn start() -> (i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32):
    fresh()  # diagnostic: unsatisfied-trait-bound
