# test: block_on written directly in the top-level code of a non-entry module is an error
# Spec 11 Driving A Stored Suspension: req.drive.block-on.forbidden-contexts, req.drive.block-on.direct.
# The primary file is an ordinary module of the tree's package.
# fixture-package-tree: lib-root/src/catalog.hd
use std.task.block_on

fn ready!() -> i32:
    42

let pending: mut Suspend[i32] = ready()
total := block_on(pending) # diagnostic: suspension-forbidden-context

pub fn item_count() -> i32:
    match total:
        .Completed(value) => value
        _ => 0
