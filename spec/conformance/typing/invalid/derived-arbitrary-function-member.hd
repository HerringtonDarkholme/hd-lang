# test: a type with a member that does not implement Arbitrary is not derivable
# std Testing, Derived Arbitrary: std-testing.arbitrary.derive.member-bound, .derive.not-derivable, and
# .derive.manual (Testing AT-with, owner decision 2026-09-30). Job writes its impl Arbitrary by hand.
use std.testing.{Arbitrary, Choices}

@derive(Arbitrary)  # diagnostic: unsatisfied-trait-bound
data Task:
    label: string
    run: fn() -> i32

data Job:
    run: fn() -> i32

impl Arbitrary for Job:
    fn arbitrary(c: mut Choices) -> Job:
        n := c.int(0, 9)
        Job { run: fn() -> i32: n }
