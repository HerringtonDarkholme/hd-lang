# test: `@auto_closing` with an argument is the wrong spelling
# Spec 14 Auto-Closing: annot.auto-closing.target; the line is bare. The
# misspelled line still marks the function, so its AutoClosing result and
# its statement call add no second error.
use std.ops.{AutoClosing, Disposable}

struct Guard:
    pass

impl Disposable for Guard:
    fn dispose(&mut self) -> void:
        pass

impl AutoClosing for Guard:
    pass

@auto_closing(1) # diagnostic: decorator-target-kind
fn open() -> Guard: Guard {}

fn main() -> void:
    open()
    pass
