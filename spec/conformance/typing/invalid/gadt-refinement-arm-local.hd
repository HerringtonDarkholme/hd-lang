# test: one arm's refinement does not reach another arm, so a catch-all arm still sees the abstract T
# Spec 13 Pattern Refinement: gadt.refine.arm-local, gadt.refine.scope.
enum Key[T]:
    Port -> Key[i32]
    Host -> Key[string]
    Verbose -> Key[bool]

fn as_port[T](key: Key[T], value: T) -> i32:
    match key:
        Key.Port =>
            let port: i32 = value
            port
        _ =>
            let port: i32 = value  # diagnostic: type-mismatch
            port
