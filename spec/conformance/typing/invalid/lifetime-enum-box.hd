# test: boxing an enum value that holds a local reference is local-reference-escapes
# Spec 13 Lifetime Enums: ref.lifetime.enum.holds; Boxes: ref.box.no-local.
enum Token['a]:
    Word(&'a string)
    End

fn keep(text: string) -> void:
    t := Token.Word(&text)
    b := box(t)  # diagnostic: local-reference-escapes
