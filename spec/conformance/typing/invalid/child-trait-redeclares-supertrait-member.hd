# test: a child trait cannot declare a supertrait member name
# Spec 09 Traits: trait.super.no-redeclare, trait.super.no-redeclare.when, trait.super.no-redeclare.report, trait.super.no-redeclare.example.

trait Greeter:
    fn greet(self) -> string

trait Loud < Greeter:
    fn greet(self) -> string  # diagnostic: duplicate-trait-member
