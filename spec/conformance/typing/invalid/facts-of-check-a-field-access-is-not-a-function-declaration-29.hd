# test: a field access is not a function declaration
use std.annotation.facts_of

@"label"
fn tagged() -> void:
    pass

fn plain() -> void:
    pass

struct Holder:
    action: fn() -> void

fn read(holder: Holder) -> void:
    _ := facts_of(holder.action)  # diagnostic: invalid-facts-of-target
pub fn main() -> void:
    pass
