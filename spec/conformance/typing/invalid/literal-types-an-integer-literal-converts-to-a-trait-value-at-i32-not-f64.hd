# test: literal types an integer literal converts to a trait value at i32 not f64
trait Gauge:
    fn level(self) -> f64

impl Gauge for f64:
    fn level(self) -> f64:
        self

fn f() -> f64:
    let g: &dyn Gauge = &0 # diagnostic: type-mismatch
    g.level()

pub fn main() -> void:
    pass
