# test: a let-else block that may complete normally is an error
# Spec 06 Let Patterns: flow.let.else.falls-through (owner decision LP1, batch 26, 2026-09-30).
fn find(id: i32) -> i32?:
    if id == 0: .Some(7) else: .None

fn falls_through(id: i32) -> i32:
    let .Some(value) = find(id) else:  # diagnostic: let-else-falls-through
        println("missing")
    value
