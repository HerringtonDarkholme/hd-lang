# test: a dependent local loan protects the pointer slot that keeps its pointee alive
struct P:
    name: string

fn name_of(p: &P) -> &string:
    &p.name

pub fn main() -> void $ Console:
    let mut ps = { "k": box(P { name: "a${1}" }) }
    d := name_of(ps["k"])
    ps["k"] = box(P { name: "b${2}" }) # diagnostic: conflicting-access
    junk := "cccccc${3}"
    println("${*d} $junk")
