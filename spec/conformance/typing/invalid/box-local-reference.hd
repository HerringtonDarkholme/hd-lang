# test: a box that holds a reference to a local is local, so the function cannot return it
# Spec 13 Boxes: ref.box.local; Local References: ref.local.holding.counted.
struct Point:
    x: i32

fn wrap(q: &Point) -> *(&Point):
    p := Point { x: 1 }
    box(&p) # diagnostic: local-reference-escapes
