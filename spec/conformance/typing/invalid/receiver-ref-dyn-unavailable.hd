# Spec 09 Dynamic Safety: trait.dyn.member.ref-receiver-bare, trait.dyn.member.unavailable.error. A bare trait value holds no reference, so a `&self` method is unavailable on it.
trait Shape:
    fn area(&self) -> f64
    fn name(self) -> string

struct Square:
    side: f64

impl Shape for Square:
    fn area(&self) -> f64:
        self.side * self.side
    fn name(self) -> string:
        "square"

fn demo(s: dyn Shape) -> f64:
    s.area()  # diagnostic: dyn-member-unavailable
