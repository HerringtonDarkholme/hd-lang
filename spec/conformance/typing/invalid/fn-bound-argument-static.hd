# test: a closure for a type parameter bounded by 'static captures no local reference
# Spec 13 Lifetime Bounds: ref.generic.outlives.argument.
use std.function.FnMut

struct Counter:
    n: i32

fn keep[F < FnMut() -> void & 'static](f: F) -> void:
    pass

fn demo(c: &mut Counter) -> void:
    keep(fn(): c.n += 1) # diagnostic: local-reference-escapes
