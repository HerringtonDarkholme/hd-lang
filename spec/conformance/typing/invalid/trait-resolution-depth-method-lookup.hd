# test: a method lookup whose proof needs more than 64 nested bounds is an error
# Spec 09 Traits: trait.bound.depth.limit.
# 33 map/filter pairs nest the receiver 66 adapters deep.
fn run(values: List[i32]) -> usize:
    values.iter() # diagnostic: trait-resolution-depth
        .map(fn(x: i32) -> i32: x + 0)
        .filter(fn(x: &i32) -> bool: x % 3 != 0)
        .map(fn(x: i32) -> i32: x + 0)
        .filter(fn(x: &i32) -> bool: x % 3 != 0)
