# test: pointer loans, same root: a call result that depends on a local pointer, used after the local's block is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

fn borrow(b: &Cell) -> &i32:
    &b.n

fn probe(fallback: &i32, pick: bool) -> i32:
    let r: &i32 = fallback
    if pick:
        boxed := box(Cell { n: +1 })
        r = borrow(boxed)
    *r # diagnostic: local-reference-outlives-local
