# test: a value parameter is the function's own copy, so the child reads but cannot store
# Spec 05 Callable Values: expr.call.apply.readonly-ref (Call Indexing D4).
use std.ops.{Apply, Update}

struct Cell[T]:
    value: T

impl[T] Apply for Cell[T]:
    type Out = T
    fn apply(self) -> T: self.value

impl[T] Update[T] for Cell[T]:
    fn update(&mut self, value: T) -> void:
        self.value = value

fn live[T](value: T) -> &mut Cell[T]:
    &mut Cell { value: value }

fn badge(count: Cell[i32]) -> i32:
    count() = 2  # diagnostic: not-writable
    count()
