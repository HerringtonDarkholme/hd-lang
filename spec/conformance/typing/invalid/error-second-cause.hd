# test: a variant with two source members
# Spec 14 Error Sources: annot.error.cause.one is reported on the second source member.

@error("disk full")
struct DiskError:
    free: i64

@error
enum SaveError:
    @error("two sources")
    Both(@source first: DiskError, @source second: DiskError)  # diagnostic: invalid-error-marker
