# test: a test build runs no entry behavior, so a script's top level is module initialization and a call that needs a requirement there is missing-requirement
# Spec Modules, Entry Behavior: module.init.tests.no-entry, module.init.tests.initialization-empty-row (task #321).
# A direct `println` here is also suspension-forbidden-context, so the call is of a function with a Clock row.
trait Clock

fn rows() -> List[string]:
    ["apple", "pear"]

fn stamp() -> i32 $ Clock:
    1

seeded := stamp() # diagnostic: missing-requirement

tests:
    use std.testing.assert_equal

    it("seeds two rows"):
        assert_equal(rows().len(), 2, reason="the seed rows")
