# test: a std function bound reaches the impls it is given
# Spec std/cmp.md: std-cmp.min-max.result.

struct Tag:
    n: i32
use std.cmp.min

first := min(Tag { n: 1 }, Tag { n: 2 }).n # diagnostic: top-level-read-before-initialization
later := +5

impl Eq for Tag:
    fn eq(self, other: Tag) -> bool:
        self.n + later == other.n

impl PartialOrd for Tag:
    fn partial_cmp(self, other: Tag) -> Ordering?:
        (self.n + later).partial_cmp(other.n)

impl Ord for Tag:
    fn cmp(self, other: Tag) -> Ordering:
        (self.n + later).cmp(other.n)

pub fn main() -> void $ Console:
    println(first)
