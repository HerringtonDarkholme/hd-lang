# test: a countdown counter that defaults to usize makes t >= 0 always true, accepted without ordinary-check advice
# Spec 05 Unsigned Comparisons With Zero: expr.ord.unsigned-zero.lint, expr.ord.unsigned-zero.binding-type (SAFETY NET 1, batch 83).

fn countdown() -> void:
    let t = 10
    while t >= 0:
        t = t - 1
