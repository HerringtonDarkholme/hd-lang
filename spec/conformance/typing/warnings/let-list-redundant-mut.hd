# test: a list name written mut whose annotated element is already mut warns
# Spec 04 Binding Forms: types.bind.let-mut-pattern.redundant (owner decision LM-a, batch 15, 2026-09-30).
data User:
    name: string

fn pair() -> (mut User, mut User):
    (User { name: "Ada" }, User { name: "Grace" })

fn edit() -> string:
    let (mut first, second): (mut User, User) = pair()  # warning: redundant-let-mut
    first.name = "Lin"
    second.name
