# test: ordinary checks accept an unread decorator before a derivation block; lint supplies advice
# Spec 14 Facts: annot.fact.unused-block-decorator.lint (stress test decision 5).
use std.structure.Structure

struct Style:
    prefix: string = ""

fn style(prefix: string = "") -> Style:
    Style { prefix: prefix }

struct Loud:
    id: i64

@style(prefix="l_")
impl Loud by Structure:
    id += ["key"]
