trait Logger:
    fn write(self, message: string) -> void
trait Clock

data SilentLogger: pass

impl Logger for SilentLogger:
    fn write(self, message: string) -> void: pass

fn redundant[R](callback: fn() -> void $ R) -> void $ (R - Logger):
    $.with(Logger=SilentLogger {}):
        callback()

fn tick() -> void $ Clock: pass

fn run() -> void $ Clock:
    redundant(tick)  # warning: requirement-subtract-absent