# test: requirements / row subtraction / absent subtraction warning

fn redundant[r](callback: fn() -> i32 $ r) -> i32 $ (r - Logger) + Backup:
    $.with(Logger=$.use(Backup)):
        callback()
fn tick() -> i32 $ Clock: 42
fn main() -> i32 $ Clock + Backup: redundant(tick)  # warning: requirement-subtract-absent

trait Clock

trait Logger

trait Backup < Logger:
    fn label(self) -> i32
