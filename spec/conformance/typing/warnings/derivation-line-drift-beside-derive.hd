# test: a derivation block with a member line beside a @derive of another trait of the same package gets a warning
# Spec 14 Line Drift: annot.line.drift.derive.
use std.structure.{Structure, Field, Variant, Walker}
data Tag:
    text: string

data Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

trait Echo:
    fn echo(self) -> string

impl[T] Echo for T by Structure:
    fn echo(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

@derive(Echo)
data Session:
    id: i64
    cache: i64 = 0

impl Probe for Session by Structure:  # warning: derivation-line-drift
    cache = pass
