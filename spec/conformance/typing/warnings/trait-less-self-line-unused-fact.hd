# test: a type-level fact written in a trait-less block's Self line warns, on the line, when its package derives nothing on the type
# Spec 14 Facts: annot.fact.unused-self-line (M28).
use std.structure.{Structure, Field, Variant, Walker}

trait Show:
    fn show(self) -> string

impl Show for i64:
    fn show(self) -> string:
        "$self"

data Shower:
    out: string

impl[S] Walker[S] for Shower:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok()

    fn member[F < Show](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.out = self.out + value.show() + ";"
        .Ok()

impl[T] Show for T by Structure:
    fn show(self) -> string:
        let w: mut Shower = Shower { out: "" }
        _ := Structure::walk(self, w)
        w.out

data Style:
    prefix: string = ""

fn style(prefix: string = "") -> Style:
    Style { prefix: prefix }

data Quiet:
    id: i64

impl Quiet by Structure:
    Self += [style(prefix="q_")]  # warning: unused-derivation-fact
