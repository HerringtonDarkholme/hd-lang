# test: a positional binding named after a different payload field of the variant warns
# Spec 06 Payload Patterns: flow.match.payload.name-mismatch, flow.match.payload.name-mismatch.example.
enum Branch:
    Pick(then_value: i32, else_value: i32)

fn chosen(branch: Branch) -> i32:
    match branch:
        .Pick(else_value, then_value) => else_value - then_value  # warning: variant-binding-name-mismatch
