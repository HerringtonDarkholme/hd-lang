# test: a local unused by the winning candidate is accepted without lint
# Spec 06 Control Flow: flow.unused.lint (ordinary checking does not report optional advice).
trait Parse[T]:
    fn parse(raw: T) -> i32

struct Item: pass

impl Parse[i32] for Item:
    fn parse(raw: i32) -> i32: raw

impl Parse[string] for Item:
    fn parse(raw: string) -> i32: 0

pub fn main() -> void:
    text := "7"
    extra := +99
    _ := Item::parse(text)
