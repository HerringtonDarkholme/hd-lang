# test: a function value read from a field of a function value's result passes its argument at the lifetime the value's type elides the result to, whatever function the value holds
# Spec 07 Function Types: fn.type.lifetime.call.written; Spec 13:
# ref.dep.elide. `g`'s type elides its result's `'a` to its input's
# lifetime, so `g(p).f` passes `&q` at `p`'s lifetime.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn x_of(p: &Point) -> i32:
    p.x

fn make(p: &Point) -> Holder[i32]:
    Holder { f: x_of }

fn in_value_result(p: &Point) -> i32:
    q := Point { x: 1 }
    g := make
    (g(p).f)(&q) # diagnostic: local-reference-escapes
