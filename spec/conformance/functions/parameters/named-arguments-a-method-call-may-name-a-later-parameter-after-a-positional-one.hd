# test: named arguments a method call may name a later parameter after a positional one
enum Pair:
    Value(first: i32, second: i32)

struct Size:
    width: i32

impl Size:
    fn resize(self, width: i32, height: i32) -> i32:
        width * height

fn resize(width: i32, height: i32) -> i32:
    width * height

fn f(s: Size) -> i32:
    s.resize(640, height=480)
