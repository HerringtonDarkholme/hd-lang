# test: partition, any, all, find, contains, and index_of, including an empty list
# Spec std/collections List Helpers: std-collections.helper.partition, .any-all, .find, .short-circuit, and .contains.
use std.testing.{assert, assert_equal}

tests:
    it("partitions in list order"):
        let (big, small) = [3, 1, 2].partition(fn(n: i32) -> bool: n > 1)
        assert_equal(big, [3, 2], reason="kept")
        assert_equal(small, [1], reason="rest")
    it("any, all, and find"):
        assert([1, 5].any(fn(n: i32) -> bool: n > 4), reason="any")
        assert(![1, 5].all(fn(n: i32) -> bool: n > 4), reason="all")
        assert_equal([1, 5, 6].find(fn(n: i32) -> bool: n > 4), .Some(5), reason="the first match")
        assert_equal([1].find(fn(n: i32) -> bool: n > 4), .None, reason="no match")
    it("stops at the deciding element"):
        let calls = 0
        _ := [1, 2, 3].any(fn(n: i32) -> bool:
            calls = calls + 1
            n == 1
        )
        assert_equal(calls, 1, reason="any stops at the first true")
    it("an empty list"):
        let empty: List[i32] = []
        assert(!empty.any(fn(n: i32) -> bool: true), reason="any is false")
        assert(empty.all(fn(n: i32) -> bool: false), reason="all is true")
        assert_equal(empty.index_of(1), .None, reason="index_of")
    it("contains and index_of"):
        assert([5, 7].contains(7) && ![5, 7].contains(6), reason="contains")
        assert_equal([5, 7, 5].index_of(5), .Some(0), reason="the first index")
