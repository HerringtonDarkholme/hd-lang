# test: user code reads a function's decorator value through facts_of
# Spec 14 Function Facts: annot.decorator.facts-of, annot.facts-of.target,
# annot.facts-of.result.compiler-decorators. The returned value follows annot.structure.reference-facts
# and annot.structure.find-exact.
use std.annotation.facts_of
struct Route:
    path: string

fn route(path: string) -> Route:
    Route { path: path }

@route("/users")
fn list_users() -> string:
    "[]"

fn users_path() -> string:
    match facts_of(list_users).find::[Route]():
        .Some(found) => found.path
        .None => ""

tests:
    use std.testing.assert_equal

    it("reads the attached route"):
        assert_equal(
            users_path(),
            "/users",
            reason="the decorator value is one of the function's facts",
        )
