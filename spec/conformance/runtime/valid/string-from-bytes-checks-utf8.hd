# test: converting bytes to a string checks that they are UTF-8, and fails when they are not
# Spec 04 Strings: types.string.from-bytes, through std-text.utf8.from-utf8.
fn valid(bytes: List[u8]) -> bool:
    match string::from_utf8(bytes):
        .Ok(_) => true
        .Err(_) => false

tests:
    use std.testing.assert

    it("accepts UTF-8 and rejects other bytes"):
        assert(valid([195, 169]), reason="the encoding of é")
        assert(!valid([195]), reason="a cut sequence")
