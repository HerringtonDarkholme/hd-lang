# test: a bare type parameter's value built through a bound returns and stores at the bound's lifetime
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument. `make` and
# `fill` build a `Keep['c]` from the caller's `p` through `S < Mk['a, T]`
# and `S < Shelf['a, Item = T]`; `pick` takes two points of `'a`.
# expect-stdout: 3
# expect-stdout: 4
# expect-stdout: 7
struct Point:
    x: i32

struct Keep['a]:
    last: &'a Point

trait Mk['b, T]:
    fn make(&self, v: &'b Point) -> T

trait Shelf['b]:
    type Item
    fn build(&self, v: &'b Point) -> Self::Item

trait Pick['b]:
    fn pick(&self, a: &'b Point, b: &'b Point) -> i32

struct Sh:
    n: i32

impl['b] Mk['b, Keep['b]] for Sh:
    fn make(&self, v: &'b Point) -> Keep['b]:
        Keep { last: v }

impl['b] Shelf['b] for Sh:
    type Item = Keep['b]
    fn build(&self, v: &'b Point) -> Keep['b]:
        Keep { last: v }

impl['b] Pick['b] for Sh:
    fn pick(&self, a: &'b Point, b: &'b Point) -> i32:
        a.x + b.x

fn make['a, T, S < Mk['a, T]](s: &S, p: &'a Point) -> T:
    s.make(p)

fn fill['a, T, S < Shelf['a, Item = T]](s: &S, d: &mut T, p: &'a Point) -> void:
    *d = s.build(p)

fn both['a, S < Pick['a]](s: &S, p: &'a Point, x: &'a Point) -> i32:
    s.pick(p, x)

fn outlive['c](p: &'c Point) -> Keep['c]:
    s := Sh { n: 1 }
    make(&s, p)

pub fn main() -> void $ Console:
    p := Point { x: 3 }
    r := Point { x: 4 }
    k := outlive(&p)
    println(k.last.x)
    let mut d = Keep { last: &p }
    s := Sh { n: 1 }
    fill(&s, &mut d, &r)
    println(d.last.x)
    println(both(&s, &p, &r))
