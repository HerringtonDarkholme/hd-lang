# test: a direct reference argument through a counted object permits a disjoint write through an alias hidden in another object
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
# expect-stdout: a 2
struct User:
    name: string
    age: i32

struct Writer:
    user: *mut User

fn older(writer: &Writer, name: &string) -> string:
    writer.user.age += 1
    "${*name} ${writer.user.age}"

fn disjoint(view: *mut User, writer: &Writer) -> string:
    older(writer, &view.name)

pub fn main() -> void $ Console:
    user := box(User { name: "a", age: 1 })
    writer := Writer { user: user }
    println(disjoint(user, &writer))
