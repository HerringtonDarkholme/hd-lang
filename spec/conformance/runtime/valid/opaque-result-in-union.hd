# test: an opaque result under a union member reveals its concrete type
# expect-stdout: 7
# expect-stdout: 9
# expect-stdout: 1 one
# expect-stdout: nested 11
# fn.opaque.nested and types.opaque.occurrence: the opaque occurrence is
# inside the named function's return annotation, under a union member.
fn choose(flag: bool) -> (impl Display) | u32:
    if flag: ._0(+7) else: ._1(9u32)

fn wrap[T < Display](value: T) -> (impl Display) | u32:
    ._0(value)

fn nested[T < Display](value: T) -> ((impl Display) | u32) | bool:
    ._0(._0(value))

fn nested_text[T < Display](value: T) -> string:
    match nested(value):
        ._0(inner) =>
            match inner:
                ._0(hidden) => hidden.to_string()
                ._1(number) => number.to_string()
        ._1(flag) => flag.to_string()

pub fn main() -> void $ Console:
    match choose(true):
        ._0(value) => println(value)
        ._1(value) => println(value)
    match choose(false):
        ._0(value) => println(value)
        ._1(value) => println(value)
    first := match wrap(+1):
        ._0(value) => value.to_string()
        ._1(number) => number.to_string()
    second := match wrap("one"):
        ._0(value) => value.to_string()
        ._1(number) => number.to_string()
    println("$first $second")
    println("${nested_text("nested")} ${nested_text(+11)}")
