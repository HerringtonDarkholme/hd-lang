# test: root_cause returns the last error of the chain, and an error without a cause is its own root cause
# Spec std/error Root Cause And Find: std-error.root-cause (ERR-HELPERS; task #223).
use std.error.Error
@error("disk full")
data DiskError:
    free: i64

@error
enum SaveError:
    @error("cannot save $path")
    Write(path: string, @source error: DiskError)

@error
enum SyncError:
    @error("sync failed")
    Save(@from error: SaveError)

tests:
    use std.testing.assert_equal

    it("the last error of a two-level chain"):
        let failure: dyn Error = SyncError.Save(SaveError.Write("notes.txt", DiskError { free: 0 }))
        assert_equal(failure.root_cause().to_string(), "disk full", reason="the innermost cause")

    it("an error without a cause"):
        let failure: dyn Error = DiskError { free: 0 }
        assert_equal(failure.root_cause().to_string(), "disk full", reason="its own root cause")

    it("through an erased Error"):
        let failure: dyn Error = SaveError.Write("notes.txt", DiskError { free: 0 })
        assert_equal(failure.root_cause().to_string(), "disk full", reason="a dynamic call")
