# test: cancellation runs deferred callbacks registered inside a provider scope
# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait
use std.ops.defer

let trace: string = ""

trait Tag:
    fn name(self) -> string

struct FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn wait!() -> void:
    pass

fn tagged!() -> void $ Tag:
    label := $.use(Tag).name()
    defer(fn() -> void: trace = trace + label + ";")
    wait!()

fn run!() -> void:
    defer(fn() -> void: trace = trace + "fn;")
    $.with(Tag=FixedTag { value: "tag" }):
        defer(fn() -> void: trace = trace + "with;")
        tagged!()
        trace = trace + "with-after;"

pub fn main!() -> void:
    run!()

pub fn cleanup_ran() -> bool:
    trace == "tag;with;fn;"
