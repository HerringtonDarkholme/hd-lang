# Spec 04 Trait Values And Sealed Markers: types.trait.explicit,
# types.trait.static, types.trait.value.reference-values, types.trait.value.contents.reference-values,
# types.trait.value.bound.reference-values, types.trait.value.bound.available.reference-values,
# types.any,
# types.any.erase.reference-values, types.any.one-way, types.sealed.decl,
# types.sealed.markers, types.sealed.anyref-members.counted,
# types.sealed.type-parameter, types.sealed.bounds.
struct User:
    name: string

impl Display for User:
    fn to_string(&self) -> string:
        self.name

trait Visitor:
    fn visit[T < AnyRef](self, value: T) -> string

trait Labeler:
    fn label[T < AnyRef & Display](self, value: T) -> string

struct Tagger:
    tag: string

impl Visitor for Tagger:
    fn visit[T < AnyRef](self, value: T) -> string:
        self.tag

impl Labeler for Tagger:
    fn label[T < AnyRef & Display](self, value: T) -> string:
        self.tag + value.to_string()

fn through_visitor[V < Visitor](visitor: &V, user: &User) -> string:
    visitor.visit(user)

fn through_labeler[L < Labeler](labeler: &L, user: &User) -> string:
    labeler.label(user)

tests:
    use std.testing.assert_equal

    it("an AnyRef-bounded method generic is callable through a bound"):
        tagger := Tagger { tag: "tag:" }
        user := User { name: "Ada" }
        assert_equal(
            through_visitor(&tagger, &user),
            "tag:",
            reason="the bound reaches the Tagger method",
        )

    it("further bounds on an AnyRef-bounded method generic are supplied per call"):
        tagger := Tagger { tag: "tag:" }
        user := User { name: "Ada" }
        assert_equal(
            through_labeler(&tagger, &user),
            "tag:Ada",
            reason="the Display bound reaches the call",
        )
