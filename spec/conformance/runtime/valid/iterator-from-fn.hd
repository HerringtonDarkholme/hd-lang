# test: Iterator::from_fn builds an iterator from a closure, and calls step again after .None
# Spec 06 Iteration Protocols: flow.for.iterator-from-fn, flow.for.iterator-from-fn.no-fuse (Chaining Study CS9, CS11).

fn countdown(start: i32) -> mut Iterator[i32]:
    let left: i32 = start
    Iterator::from_fn(fn() -> i32?:
        left = left - 1
        if left < 0: .None else: left + 1
    )

fn gappy() -> mut Iterator[i32]:
    let calls = +0
    Iterator::from_fn(fn() -> i32?:
        calls = calls + 1
        if calls == 2: .None else: calls
    )

tests:
    use std.testing.{assert, assert_equal}

    it("from_fn yields the items of its closure"):
        items := [for item in countdown(3) => item]
        assert_equal(items, [3, 2, 1], reason="the iterator yields until step returns .None")

    it("from_fn does not fuse"):
        let source: mut Iterator[i32] = gappy()
        let first: i32? = 1
        let gap: i32? = .None
        let third: i32? = 3
        assert(source.next() == first, reason="the first call yields the first item")
        assert(source.next() == gap, reason="step returns .None on its second call")
        assert(source.next() == third, reason="next calls step again after .None")
