# test: mutable data paths share identity
# Spec 08 Reference Semantics: data.kind.data, data.ref.shared.

struct Child:
    name: string

struct Parent:
    child: &mut Child
    snapshot: &Child

fn rename(parent: &mut Parent) -> void:
    parent.child.name = "Grace"
    parent.snapshot = &mut Child { name: "updated" }

fn main() -> i32:
    let mut child = &mut Child { name: "Ada" }
    let mut parent = &mut Parent { child: child, snapshot: &mut Child { name: "old" } }
    readonly := parent
    rename(parent)
    if readonly.child.name == "Grace" && readonly.snapshot.name == "updated":
        42
    else:
        0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="mutable data paths share identity")
