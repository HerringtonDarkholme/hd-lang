# test: copies of a &mut reference refer to one place and see each other's writes
# Spec 13 Places And New Objects: ref.place.alias.

struct Child:
    name: string

struct Parent:
    child: *mut Child
    snapshot: *Child

fn rename(parent: &mut Parent) -> void:
    parent.child.name = "Grace"
    parent.snapshot = box(Child { name: "updated" })

fn main() -> i32:
    child := box(Child { name: "Ada" })
    parent := box(Parent { child: child, snapshot: box(Child { name: "old" }) })
    readonly := parent
    rename(parent)
    if readonly.child.name == "Grace" && readonly.snapshot.name == "updated": 42 else: 0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="mutable data paths share identity")
