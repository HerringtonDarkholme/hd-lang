# test: user indexing reads through index and stores through index_set
# Spec 05 Index Traits: expr.index.trait.read-other, expr.index.trait.write, expr.assign.compound.index-read-write (Operator Traits OP7, OP13).
use std.ops.{Index, IndexSet}
data Ring:
    items: mut List[i32]

impl Index[usize] for Ring:
    type Out = i32
    fn index(self, key: usize) -> i32:
        self.items[key % self.items.len()]

impl IndexSet[usize, i32] for Ring:
    fn index_set(mut self, key: usize, value: i32) -> void:
        self.items[key % self.items.len()] = value

fn exercise() -> i32:
    let mut ring = Ring { items: [1, 2, 3] }
    ring[4] = ring[0] + 10
    ring[4] += 5
    ring[1]

tests:
    use std.testing.assert_equal

    it("wraps the index"):
        assert_equal(exercise(), 16, reason="index 4 is element 1")
