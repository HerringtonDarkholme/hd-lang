# test: user indexing reads through index and stores through index_set
# Spec 05 Index Traits: expr.index.trait.shared-place, expr.index.trait.write-ref, expr.assign.compound.index-place (Operator Traits OP7, OP13).
use std.ops.{Index, IndexMut, IndexSet}
struct Ring:
    items: *mut List[i32]

impl Index[usize] for Ring:
    type Out = i32
    fn index(&self, key: usize) -> &i32:
        &self.items[key % self.items.len()]

impl IndexMut[usize] for Ring:
    fn index_mut(&mut self, key: usize) -> &mut i32:
        &mut self.items[key % self.items.len()]

impl IndexSet[usize, i32] for Ring:
    fn index_set(&mut self, key: usize, value: i32) -> void:
        self.items[key % self.items.len()] = value

fn exercise() -> i32:
    let mut ring = Ring { items: box([1, 2, 3]) }
    ring[4] = ring[0] + 10
    ring[4] += 5
    ring[1]

tests:
    use std.testing.assert_equal

    it("wraps the index"):
        assert_equal(exercise(), 16, reason="index 4 is element 1")
