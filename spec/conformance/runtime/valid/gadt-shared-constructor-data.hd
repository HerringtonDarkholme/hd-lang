# test: a typed column's shared default takes the type its variant result refines
# Spec 13 Variant Result Types: gadt.result.shared-data; Shared Constructor Data: gadt.shared.assignable.
# Spec 13 Type-Checking Requirements: gadt.check.payload.
use std.testing.assert_equal

enum Column[T](blank: T):
    Count(name: string) -> Column[i64](0)
    Flag(name: string) -> Column[bool](false)
    Label(name: string) -> Column[string]("-")

fn cell[T](column: Column[T], value: T?) -> T:
    match value:
        .Some(found) => found
        .None => column.blank

tests:
    it("each variant's shared data has the refined type"):
        let visits: i64 = Column.Count("visits").blank
        assert_equal(visits, 0, reason="Column[i64] blank")
        assert_equal(Column.Flag("active").blank, false, reason="Column[bool] blank")
        assert_equal(Column.Label("city").blank, "-", reason="Column[string] blank")

    it("a missing cell reads the column's blank"):
        assert_equal(cell(Column.Count("visits"), .None), 0, reason="blank count")
        assert_equal(cell(Column.Label("city"), .Some("Oslo")), "Oslo", reason="present label")
