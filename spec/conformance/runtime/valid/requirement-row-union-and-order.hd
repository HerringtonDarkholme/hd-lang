# test: requirement rows union, reorder, and re-add keys as unordered sets
# Spec 11 Row Sets And Entailment: req.row.set.union, req.row.set.parameter,
# req.row.set.duplicate, req.row.set.call, req.row.entail.sets,
# req.row.entail.available, req.row.entail.member, req.row.entail.membership,
# req.row.entail.concrete, req.row.entail.concrete.parameter,
# req.row.entail.parameter, req.row.entail.parameter.concrete,
# req.row.least.solution, req.row.least.examples, req.row.least.removal,
# req.row.least.one-unknown.
# Spec 02 Requirements And Provider Contexts: grammar.row.sets, grammar.type.row.plus-keys.
# expect: test
trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

trait Clock:
    fn now(self) -> i32

data FixedClock:
    value: i32

impl Clock for FixedClock:
    fn now(self) -> i32:
        self.value

fn both() -> string $ Tag + Clock:
    let (tag, clock) = $.use(Tag, Clock)
    tag.name() + "@" + "${clock.now()}"

fn reordered() -> string $ Clock + Tag:
    both()

fn provide_clock[$R](callback: fn() -> string $ R + Clock) -> string $ R:
    $.with(Clock=FixedClock { value: 7 }):
        callback()

fn with_tag[$R](callback: fn() -> string $ R + Tag) -> string $ R:
    $.with(Tag=FixedTag { value: "local" }):
        callback()

fn relay[$R](callback: fn() -> string $ R + Tag) -> string $ R + Tag:
    callback()

tests:
    use std.testing.assert_equal

    it("union row satisfied by an outer and a local provider"):
        $.with(Tag=FixedTag { value: "t" }):
            assert_equal(provide_clock(both), "t@7", reason="Tag from outside, Clock from the callee")

    it("row order does not matter"):
        $.with(Clock=FixedClock { value: 3 }, Tag=FixedTag { value: "u" }):
            assert_equal(reordered(), "u@3", reason="Clock + Tag equals Tag + Clock")

    it("least solution for R + Tag is the empty row"):
        assert_equal(with_tag(current), "local", reason="R is inferred empty")

    it("removing a key by extension and re-adding it entails the callback row"):
        $.with(Tag=FixedTag { value: "outer" }):
            assert_equal(relay(current), "outer", reason="R, Tag entails the pattern R, Tag")
