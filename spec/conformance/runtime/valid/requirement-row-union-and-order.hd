# test: requirement rows union, reorder, and re-add keys as unordered sets
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

trait Clock:
    fn now(self) -> i32

data FixedClock:
    value: i32

impl Clock for FixedClock:
    fn now(self) -> i32:
        self.value

fn both() -> string $ Tag + Clock:
    tag, clock := $.use(Tag, Clock)
    tag.name() + "@" + "${clock.now()}"

fn reordered() -> string $ Clock + Tag:
    both()

fn provide_clock[r](callback: fn() -> string $ r) -> string $ (r - Clock):
    $.with(Clock=FixedClock { value: 7 }):
        callback()

fn with_tag[r](callback: fn() -> string $ r + Tag) -> string $ r:
    $.with(Tag=FixedTag { value: "local" }):
        callback()

fn relay[r](callback: fn() -> string $ r) -> string $ (r - Tag) + Tag:
    callback()

test "union row satisfied by an outer and a local provider":
    $.with(Tag=FixedTag { value: "t" }):
        assert_equal(provide_clock(both), "t@7", reason="Tag from outside, Clock from the callee")

test "row order does not matter":
    $.with(Clock=FixedClock { value: 3 }, Tag=FixedTag { value: "u" }):
        assert_equal(reordered(), "u@3", reason="Clock + Tag equals Tag + Clock")

test "least solution for r + Tag is the empty row":
    assert_equal(with_tag(current), "local", reason="r is inferred empty")

test "subtracting then re-adding a key entails the original row":
    $.with(Tag=FixedTag { value: "outer" }):
        assert_equal(relay(current), "outer", reason="(r - Tag) + Tag entails r")
