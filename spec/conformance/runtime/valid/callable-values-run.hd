# test: a live cell reads through apply and stores through update, and a child reads a copy
# Spec 05 Callable Values: expr.call.apply.read, expr.call.apply.write-ref, expr.assign.compound.call-once (Call Indexing D1, D2, D4).
use std.ops.{Apply, Update}
struct Cell[T]:
    value: T

impl[T] Apply for Cell[T]:
    type Out = T
    fn apply(self) -> T: self.value

impl[T] Update[T] for Cell[T]:
    fn update(&mut self, value: T) -> void:
        self.value = value

fn live[T](value: T) -> Cell[T]:
    Cell { value: value }

struct Panel:
    count: Cell[i32]

fn badge(count: Cell[i32]) -> string:
    "clicked ${count()}"

fn parent() -> string:
    let mut count = live(+0)
    count() = 1
    count() += 2
    badge(count)

fn bump(panel: &mut Panel) -> i32:
    (panel.count)() += 10
    (panel.count)()

tests:
    use std.testing.assert_equal

    it("stores through the cell"):
        assert_equal(parent(), "clicked 3", reason="1 then += 2")
    it("reaches a cell in a field"):
        let mut panel = Panel { count: live(+5) }
        assert_equal(bump(&mut panel), 15, reason="5 then += 10")
