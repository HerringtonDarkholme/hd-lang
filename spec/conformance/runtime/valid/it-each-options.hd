# test: it_each takes the options of it
# Spec Modules, Registration Calls: module.testing.reg.options; an ignored it_each call runs none of its rows.
tests:
    use std.testing.it_each

    it_each("never runs", [1, 2], ignore="demonstrates ignore", body=fn!(value: i32):
        panic("an ignored row must not run")
    )
