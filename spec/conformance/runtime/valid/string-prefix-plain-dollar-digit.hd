# test: in a prefixed string, a $ before a character that cannot start an identifier is text
# Spec 01 Prefixed Strings: lex.prefix.plain-dollar-start (Small Follow-Ups 2026-09-29).
use std.text.r
use std.testing.assert_equal

tests:
    it("keeps a dollar before a digit as text"):
        name := "Ada"
        assert_equal(r"costs $5", "costs \$5", reason="5 cannot start an identifier")
        assert_equal(r"$5 for $name", "\$5 for Ada", reason="an identifier start interpolates")
