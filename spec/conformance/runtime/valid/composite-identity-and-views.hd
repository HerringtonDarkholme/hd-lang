# test: composite identity ignores permission and survives trait-value conversion
# expect: test
use std.testing.assert

data User:
    name: string

impl Display for User:
    fn to_string(self) -> string:
        self.name

fn same_ref[T: Reference](left: T, right: T) -> bool:
    left is right

test "mut and readonly views of one object are identical":
    let mutable: mut User = User { name: "Ada" }
    let readonly: User = mutable
    twin := User { name: "Ada" }
    assert(mutable is readonly, reason="permission does not change identity")
    assert(not (readonly is twin), reason="equal fields are different allocations")
    assert(same_ref(readonly, mutable), reason="Reference-bounded generic agrees")

test "trait and Any conversions of a composite preserve its identity":
    user := User { name: "Ada" }
    let first: Display = user
    let second: Display = user
    let erased: Any = user
    let erased_again: Any = user
    assert(first is second, reason="direct conversion does not wrap")
    assert(erased is erased_again, reason="Any conversion does not wrap")

test "collections have allocation identity":
    values := [1, 2]
    alias := values
    other := [1, 2]
    assert(values is alias, reason="alias")
    assert(not (values is other), reason="equal lists are distinct")
    entries := {"a": 1}
    assert(not (entries is {"a": 1}), reason="equal maps are distinct")
