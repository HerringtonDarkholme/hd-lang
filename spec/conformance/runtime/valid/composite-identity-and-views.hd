# test: composite identity ignores permission and survives trait-value conversion
# expect: test
data User:
    name: string

impl Display for User:
    fn to_string(self) -> string:
        self.name

fn same_ref[T < AnyRef](left: T, right: T) -> bool:
    left is right

tests:
    use std.testing.assert

    it("mut and readonly views of one object are identical"):
        let mut mutable = User { name: "Ada" }
        let readonly: User = mutable
        twin := User { name: "Ada" }
        assert(mutable is readonly, reason="permission does not change identity")
        assert(!(readonly is twin), reason="equal fields are different allocations")
        assert(same_ref(readonly, mutable), reason="AnyRef-bounded generic agrees")

    it("trait and Any conversions of a composite preserve its identity"):
        user := User { name: "Ada" }
        let first: dyn Display = user
        let second: dyn Display = user
        let erased: dyn Any = user
        let erased_again: dyn Any = user
        assert(first is second, reason="direct conversion does not wrap")
        assert(erased is erased_again, reason="Any conversion does not wrap")

    it("collections have allocation identity"):
        values := [1, 2]
        alias := values
        other := [1, 2]
        assert(values is alias, reason="alias")
        assert(!(values is other), reason="equal lists are distinct")
        entries := {"a": 1}
        assert(!(entries is {"a": 1}), reason="equal maps are distinct")
