# test: collections / maps / lookup replacement

use std.testing.assert_equal

fn lookup[T](values: Map[string, T], key: string) -> T?:
    values.get(key)

fn unwrap(value: i32?) -> i32:
    match value:
        .Some(actual) => actual
        .None => 0

tests:
    it("a later duplicate key replaces the value"):
        scores := {"answer": 20, "other": 2, "answer": 40}
        assert_equal(unwrap(lookup(scores, "answer")), 40, reason="the later value wins")
        assert_equal(scores.len(), 2, reason="the duplicate key adds no entry")

    it("scalar keys replace the same way"):
        values := {1: 20, 2: 2, 1: 40}
        assert_equal(unwrap(values.get(1)), 40, reason="the later value wins")
        assert_equal(values.len(), 2, reason="the duplicate key adds no entry")

    it("an empty map has no entry"):
        let values: Map[string, i32] = {}
        assert_equal(values.len(), 0, reason="empty")
