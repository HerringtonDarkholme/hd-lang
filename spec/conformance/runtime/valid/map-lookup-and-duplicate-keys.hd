# test: collections / maps / lookup replacement

use std.testing.assert_equal

fn lookup[T](values: Map[string, T], key: string) -> T?:
    values.get(key)

fn unwrap(value: i32?) -> i32:
    match value:
        .Some(actual) => actual
        .None => 0

fn main() -> i32:
    scores := {"answer": 20, "other": 2, "answer": 40}
    unwrap(lookup(scores, "answer")) + scores.len()

fn scalar_keys() -> i32:
    values := {1: 20, 2: 2, 1: 40}
    unwrap(values.get(1)) + values.len()

fn empty() -> i32:
    let values: Map[string, i32] = {}
    values.len()

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="collections / maps / lookup replacement")

    it("scalar_keys returns 42"):
        assert_equal(scalar_keys(), 42, reason="collections / maps / lookup replacement")

    it("empty returns 0"):
        assert_equal(empty(), 0, reason="collections / maps / lookup replacement")
