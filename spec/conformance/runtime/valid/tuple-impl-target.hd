# test: tuple types are implementation targets, one constructor per arity
# Spec 09 Traits: trait.target.tuple, trait.target.tuple.valid, trait.target.tuple.arity.
trait Describe:
    fn describe(self) -> string

impl Describe for (i32, string):
    fn describe(self) -> string:
        "pair " + self._1

impl Describe for (i32, i32, i32):
    fn describe(self) -> string:
        "triple"

tests:
    use std.testing.assert_equal

    it("tuple targets dispatch by arity and element types"):
        assert_equal((+1, "a").describe(), "pair a", reason="two-element tuple")
        assert_equal((+1, +2, +3).describe(), "triple", reason="three-element tuple")
