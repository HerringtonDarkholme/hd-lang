# expect-stdout: run body, target defer, target cancelled, runner defer
# expect-stdout: abandoned
# test: when another task cancels the job that timeout!'s work awaits, the timeout! is cancelled at once and never returns .Err(TimedOut)
# Spec std/task: std-task.policy.time-limit.work-cancelled.
# Also covers lang/11 Standard Combinators: req.combinator.race-child-cancelled; Cancellation: req.cancel.await.propagate, req.cancel.await.dispose.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.{TimedOut, join, timeout, apply}
use std.time.{Clock, ms, s, sleep}

struct Runner['a]:
    log: *mut List[string]
    timed: Suspend[Result[string, TimedOut], 'a]
    stop: Suspend[void, 'a]

impl['a] AsyncDisposable for Runner['a]:
    fn dispose!(&mut self) -> void:
        defer(fn() -> void: self.log.push("runner defer"))
        let (result, _) = join!(self.timed, self.stop)
        match result:
            .Ok(value) => self.log.push("work gave ${value}")
            .Err(_) => self.log.push("timed out")

fn target!(log: &mut List[string]) -> string $ Clock:
    defer(fn() -> void: log.push("target defer"))
    sleep!(s(60))
    "late"

fn stop_later!(target: Suspend[string], log: &mut List[string]) -> void $ Clock:
    sleep!(ms(1))
    _ := target.cancel!()
    log.push("target cancelled")

fn run!(
    log: *mut List[string],
    timed: Suspend[Result[string, TimedOut]],
    stop: Suspend[void],
) -> void:
    using! runner = &mut Runner { log: log, timed: timed, stop: stop }
    log.push("run body")

pub fn main!() -> void $ Console + Clock:
    log := box::[List[string]]([])
    target_log := log
    let job: Suspend[string] = target(target_log)
    let timed: Suspend[Result[string, TimedOut]] = apply(
        timeout(s(60)),
        work=fn!() -> Result[string, TimedOut]: .Ok(job!())
    )
    stopper_log := log
    let runner: Suspend[void] = run(log, timed, stop_later(job, stopper_log))
    runner!()
    println(log.join(", "))
    match runner.cancel!():
        .Finished => println("finished")
        .Abandoned => println("abandoned")
