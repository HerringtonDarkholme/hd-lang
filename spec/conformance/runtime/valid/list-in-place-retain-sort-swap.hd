# test: retain, sort, sort_by, sort_by_key and swap change the list in place; the sorts are stable
# Spec std collections: std-collections.helper.retain, std-collections.helper.sort, std-collections.helper.sort-by, std-collections.helper.sort-by-key, std-collections.helper.sort.stable, std-collections.helper.swap.
# expect-stdout: [2, 4, 6]
# expect-stdout: [1, 2, 3, 5, 8]
# expect-stdout: [8, 5, 3, 2, 1]
# expect-stdout: ["b1", "b2", "a1", "a2"]
# expect-stdout: [8, 1, 3, 2, 5]
use std.cmp.Ordering

struct Item:
    name: string
    rank: i32

pub fn main() -> void $ Console:
    let mut evens = [+1, +2, +3, +4, +5, +6]
    evens.retain(fn(n: &i32) -> bool: n % 2 == 0)
    println(debug(evens))
    let mut numbers = [+5, +3, +8, +1, +2]
    numbers.sort()
    println(debug(numbers))
    numbers.sort_by(fn(a: &i32, b: &i32) -> Ordering: b.cmp(a))
    println(debug(numbers))
    let mut items = [
        Item { name: "a1", rank: 2 },
        Item { name: "b1", rank: 1 },
        Item { name: "a2", rank: 2 },
        Item { name: "b2", rank: 1 },
    ]
    items.sort_by_key(fn(item: &Item) -> i32: item.rank)
    println(debug(items.map(fn(item: &Item) -> string: item.name)))
    numbers.swap(1, 4)
    println(debug(numbers))
