# test: or keeps a present optional, and takes the other for a None
# Spec std/option Optional Methods: std-option.or, std-option.or.layers (issue #485).
fn port(flag: string?, variable: string?) -> string:
    flag.or(variable).unwrap_or("8080")

tests:
    use std.testing.assert_equal

    it("Some or Some keeps the first"):
        let first: i32? = .Some(1)
        let second: i32? = .Some(2)
        assert_equal(first.or(second), .Some(1), reason="the receiver wins")

    it("None or Some takes the other"):
        let first: i32? = .None
        let second: i32? = .Some(2)
        assert_equal(first.or(second), .Some(2), reason="the fallback")

    it("None or None is None"):
        let first: i32? = .None
        let second: i32? = .None
        assert_equal(first.or(second), .None, reason="nothing present")

    it("or layers fallbacks"):
        assert_equal(port(.Some("80"), .Some("90")), "80", reason="flag first")
        assert_equal(port(.None, .Some("90")), "90", reason="then the variable")
        assert_equal(port(.None, .None), "8080", reason="then the default")
        let none: string? = .None
        assert_equal(none.or(none).or(.Some("x")), .Some("x"), reason="chained")
