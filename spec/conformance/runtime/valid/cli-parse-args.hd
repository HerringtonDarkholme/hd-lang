# test: parse_args reads the arguments of the Args provider, and builder methods update their receiver in place
# Spec std/cli Declaring Arguments and Parsing: std-cli.parser.decl, std-cli.parser.new, std-cli.parser.arg, std-cli.parser.arg, std-cli.parser.arg, std-cli.parser.arg, std-cli.parse.parser, std-cli.parse-args.parser, std-cli.parsed.private (task #242).
use std.cli.{Arg, ArgParser, CliError, Parsed}
use std.host.{Args, ScriptedArgs}
fn tool() -> &mut ArgParser:
    ArgParser::new("count").arg(Arg { name: "verbose", kind: .Flag, short: 'v', help: "print each file" }).arg(Arg { name: "out", kind: .Option, short: 'o', help: "write the total here" }).arg(Arg { name: "pattern", kind: .Positional, required: true, help: "the files to count" })

fn target() -> string $ Args:
    match tool().parse_args():
        .Ok(parsed) => parsed.value("out").unwrap_or("stdout")
        .Err(error) => "$error"

tests:
    use std.testing.assert_equal

    it("parse_args reads the provider's arguments"):
        given := ScriptedArgs::new("count", ["-o", "total.txt", "*.txt"])
        $.with(Args=given):
            assert_equal(target(), "total.txt", reason="the option's value")
        empty := ScriptedArgs::new("count", [])
        $.with(Args=empty):
            assert_equal(target(), "missing argument <pattern>", reason="the error's text")

    it("a builder method returns the same mutable parser"):
        base := ArgParser::new("count")
        more := base.arg(Arg { name: "verbose", kind: .Flag, short: 'v', help: "print each file" })
        assert_equal(base is more, true, reason="the receiver is updated in place")
        match more.parse(["-v"]):
            .Ok(parsed) => assert_equal(parsed.flag("verbose"), true, reason="the new ArgParser has the flag")
            .Err(error) => panic("parse failed: $error")
