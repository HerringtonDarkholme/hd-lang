# test: parse_args reads the arguments of the Args provider, and builder methods leave their receiver unchanged
# Spec std/cli Declaring Arguments and Parsing: std-cli.cli.decl, std-cli.cli.new, std-cli.cli.flag, std-cli.cli.option, std-cli.cli.positional, std-cli.cli.builder, std-cli.parse.decl, std-cli.parse-args, std-cli.parsed.decl (task #242).
use std.cli.{Cli, CliError, Parsed}
use std.host.{Args, MapArgs}
use std.testing.assert_equal

fn tool() -> Cli:
    Cli::new("count").flag("verbose", 'v', "print each file").option("out", 'o', "write the total here").positional("pattern", "the files to count")

fn target() -> string $ Args:
    match tool().parse_args():
        .Ok(parsed) => parsed.value("out").unwrap_or("stdout")
        .Err(error) => "$error"

tests:
    it("parse_args reads the provider's arguments"):
        given := MapArgs::new("count", ["-o", "total.txt", "*.txt"])
        $.with(Args=given):
            assert_equal(target(), "total.txt", reason="the option's value")
        empty := MapArgs::new("count", [])
        $.with(Args=empty):
            assert_equal(target(), "missing argument <pattern>", reason="the error's text")

    it("a builder method returns a new Cli"):
        base := Cli::new("count")
        more := base.flag("verbose", 'v', "print each file")
        assert_equal(base.parse(["-v"]), .Err(CliError.UnknownOption("-v")), reason="the receiver is unchanged")
        match more.parse(["-v"]):
            .Ok(parsed) => assert_equal(parsed.flags, ["verbose"], reason="the new Cli has the flag")
            .Err(error) => panic("parse failed: $error")
