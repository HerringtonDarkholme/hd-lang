# test: a field write through a `&mut` tuple element changes the value it refers to
# Spec 13 Writing Through A Reference: ref.write.field, ref.write.seen.
struct User:
    name: string

fn rename(pair: (&mut User, i32)) -> void:
    pair._0.name = "Grace"  # valid: the element has mutable access

tests:
    use std.testing.assert_equal

    it("a mut element of a tuple can be mutated"):
        let mut user = &mut User { name: "Ada" }
        rename((user, 1))
        assert_equal(user.name, "Grace", reason="the element shares the user")
