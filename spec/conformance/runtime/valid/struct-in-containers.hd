# test: a struct value stored in a list, a map, a data field or an enum payload is a copy, and reading it out yields a copy
# Spec 04 Value Types: types.value.stored, types.value.writable-forms.
# expect-stdout: 1 100
# expect-stdout: 1 2
# expect-stdout: 1 42
# expect-stdout: 42 1
# expect-stdout: 1 8
struct Point:
    x: i32
    y: i32

data Marker:
    at: Point

enum Shape:
    Dot(at: Point)
    Empty

pub fn main() -> void $ Console:
    let mut p = Point { x: 1, y: 2 }
    let points: mut List[Point] = [p]
    let mut first = points[0]
    first.x = 100
    println("${points[0].x} ${first.x}")
    let table: mut Map[string, Point] = {}
    table["a"] = p
    p.x = 9
    match table.get("a"):
        .Some(found) => println("${found.x} ${found.y}")
        .None => println("missing")
    p.x = 1
    let mut marker = Marker { at: p }
    marker.at.y = 42
    println("${p.x} ${marker.at.y}")
    let mut copied = marker.at
    copied.x = 7
    println("${marker.at.y} ${marker.at.x}")
    shape := Shape.Dot(p)
    p.y = 8
    match shape:
        Shape.Dot(at) => println("${at.y - 1} ${p.y}")
        Shape.Empty => println("empty")
