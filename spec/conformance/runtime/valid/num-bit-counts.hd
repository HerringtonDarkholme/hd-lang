# test: count_ones and leading_zeros read the two's-complement bits of every integer width and return u32
# Spec std/num Bit Counts: std-num.bits.count-ones-u32, std-num.bits.leading-zeros-u32, std-num.bits.signed (batch 68, STD-HELPERS-KEEP and INT-WIDTHS; BIT-COUNT-U32, task #220).
use std.testing.assert_equal

fn flags_set(flags: u8) -> u32:
    flags.count_ones()

fn bit_length(value: u32) -> u32:
    32 - value.leading_zeros()

fn drop_flagged(value: u64, flags: u8) -> u64:
    value >> flags.count_ones()

tests:
    it("count_ones"):
        assert_equal(flags_set(0), 0, reason="no bits")
        assert_equal(flags_set(255), 8, reason="every u8 bit")
        assert_equal(7.count_ones(), 3, reason="i32")
        let minus_one: i8 = -1
        assert_equal(minus_one.count_ones(), 8, reason="every i8 bit of -1")
        let low: i64 = -9223372036854775807 - 1
        assert_equal(low.count_ones(), 1, reason="the i64 minimum is the sign bit alone")

    it("leading_zeros"):
        assert_equal(bit_length(0), 0, reason="zero has no bits")
        assert_equal(bit_length(1024), 11, reason="2 to the tenth")
        assert_equal(1.leading_zeros(), 31, reason="i32")
        assert_equal((-1).leading_zeros(), 0, reason="a negative value")
        let zero: u16 = 0
        assert_equal(zero.leading_zeros(), 16, reason="zero gives the bit width")
        let one: u64 = 1
        assert_equal(one.leading_zeros(), 63, reason="u64")

    it("both return u32 on every width"):
        let small: i8 = 3
        let ones: u32 = small.count_ones()
        let zeros: u32 = small.leading_zeros()
        assert_equal(ones + zeros, 8, reason="an i8 has 8 bits")
        assert_equal(drop_flagged(64, 7), 8, reason="a bit count is a shift count")
