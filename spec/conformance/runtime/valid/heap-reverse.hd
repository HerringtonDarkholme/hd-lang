# test: a Heap of Reverse values pops the smallest value first
# Spec std/collections Heap: std-collections.heap.min; std/cmp Reverse: std-cmp.reverse.order (COLLECTIONS-DATES-SURFACE; task #225).
use std.cmp.Reverse
use std.collections.Heap
use std.testing.assert_equal

tests:
    it("smallest first"):
        let heap: mut Heap[Reverse[i32]] = Heap::new()
        for value in [5, 1, 8, 3]:
            heap.push(Reverse { value: value })
        assert_equal(heap.peek(), .Some(Reverse { value: 1 }), reason="peek")
        let popped: mut List[i32] = []
        while !heap.is_empty():
            match heap.pop():
                .Some(top) => popped.push(top.value)
                .None => pass
        assert_equal(popped, [1, 3, 5, 8], reason="ascending")
