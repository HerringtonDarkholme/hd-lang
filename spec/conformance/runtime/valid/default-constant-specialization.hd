# test: omitted constant defaults may remove branches without changing explicit calls or default effects
# expect: test

fn choose(enabled: bool = false) -> i32:
    if enabled: +91 else: +7

fn optional(value: i32? = .None) -> i32:
    match value:
        .None => +7
        .Some(found) => found

fn modified(mut enabled: bool = false) -> i32:
    enabled = true
    if enabled: +91 else: +7

fn captured(enabled: bool = false) -> fn() -> i32:
    fn() -> i32:
        if enabled: +91 else: +7

fn record(log: &mut List[i32]) -> i32?:
    log.push(+1)
    .None

fn effectful(log: &mut List[i32], value: i32? = record(log)) -> i32:
    match value:
        .None => +7
        .Some(found) => found

fn twice(first: bool = false, second: bool = true) -> i32:
    if first:
        +91
    else if second:
        +7
    else:
        +3

fn changes_later(mut enabled: bool = false, outer: bool = false) -> i32:
    before := if enabled: +90 else: +6
    enabled = true
    after := if enabled: +1 else: +100
    if outer: +1000 else: before + after

fn nested_parameter(outer: bool = false) -> i32:
    inner := fn(mut enabled: bool) -> i32:
        before := if enabled: +90 else: +6
        enabled = true
        after := if enabled: +1 else: +100
        if outer: +1000 else: before + after
    inner(false)

tests:
    use std.testing.assert_equal

    it("keeps omitted and explicit argument shapes distinct"):
        assert_equal(choose(), 7, reason="the omitted false default")
        assert_equal(choose(true), 91, reason="an explicit true")
        assert_equal(choose(false), 7, reason="an explicit false")
        assert_equal(optional(), 7, reason="the omitted None default")
        assert_equal(optional(.Some(+23)), 23, reason="the explicit Some payload")
        assert_equal(optional(.None), 7, reason="an explicit None")
        assert_equal(twice(), 7, reason="two omitted defaults")
        assert_equal(twice(second=false), 3, reason="only the first default is omitted")
        assert_equal(twice(first=true), 91, reason="only the second default is omitted")

    it("respects writes to a defaulted parameter"):
        assert_equal(modified(), 91, reason="the parameter changes before its branch")

    it("carries a constant default into a captured function"):
        plain := captured()
        explicit := captured(true)
        assert_equal(plain(), 7, reason="the captured default")
        assert_equal(explicit(), 91, reason="an explicit captured value")

    it("evaluates a constant-valued effectful default on every call"):
        let mut log: List[i32] = []
        assert_equal(effectful(&mut log), 7, reason="first default result")
        assert_equal(effectful(&mut log), 7, reason="second default result")
        assert_equal(log, [+1, +1], reason="each omitted argument evaluates its default")
        assert_equal(effectful(&mut log, value=.Some(+23)), 23, reason="an explicit argument bypasses the default")
        assert_equal(log, [+1, +1], reason="the explicit call adds no effect")

    it("does not use a later parameter assignment for an earlier read"):
        assert_equal(changes_later(), 7, reason="the read before assignment sees the default")
        assert_equal(nested_parameter(), 7, reason="a nested function parameter stays dynamic")
