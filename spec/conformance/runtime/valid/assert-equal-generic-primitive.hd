use std.testing.assert_equal

fn expect_same[T < Eq + Debug](actual: T, expected: T) -> void:
    assert_equal(actual, expected, reason="the bounds supply Eq and Debug")

tests:
    it("a generic Eq value instantiated with i32 passes"):
        expect_same(40 + 2, 42)

    it("a generic Eq value instantiated with string passes"):
        expect_same("ada", "ada")
