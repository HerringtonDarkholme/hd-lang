use std.testing.assert_equal

fn expect_same[T < PartialEq](actual: T, expected: T) -> void:
    assert_equal(actual, expected, reason="the bound supplies PartialEq")

test "a generic PartialEq value instantiated with i32 passes":
    expect_same(40 + 2, 42)

test "a generic PartialEq value instantiated with string passes":
    expect_same("ada", "ada")
