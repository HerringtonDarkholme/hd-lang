# test: map_all! of an empty list returns an empty list
# Spec std/task Map All: std-task.map-all.empty.
use std.task.map_all
fn none!() -> List[string]:
    let tasks: List[string] = []
    map_all!(tasks, tasks.len(), fn!(value: string) -> string: value)

tests:
    use std.testing.assert_equal

    it("no task gives no result"):
        assert_equal(none!(), [], reason="an empty list in, an empty list out")
