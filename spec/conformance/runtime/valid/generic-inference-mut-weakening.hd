# test: a mut argument and a readonly argument of one type parameter meet at the readonly type
# Spec 04 Inference From Several Arguments: types.generic.infer.join (INF-mut, owner decision
# 2026-09-30). T is User in both argument orders.
use std.testing.assert_equal

data User:
    name: string

fn pick[T](left: T, right: T) -> T:
    left

fn first(owned: mut User, shared: User) -> User:
    pick(owned, shared)

fn second(owned: mut User, shared: User) -> User:
    pick(shared, owned)

tests:
    it("mut User and User meet at User"):
        let owned: mut User = User { name: "ada" }
        shared := User { name: "grace" }
        assert_equal(first(owned, shared).name, "ada", reason="the mut argument comes first")
        assert_equal(second(owned, shared).name, "grace", reason="the readonly argument comes first")
