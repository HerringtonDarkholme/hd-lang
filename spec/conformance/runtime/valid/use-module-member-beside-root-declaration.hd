# test: a grouped use through a module path is not ambiguous, even when the package root declares a name like the module
# Spec 10 Use Forms: module.use.grouped, module.use.ambiguous. The tree's
# src/lib.hd declares words, and src/words.hd is the module words.
# fixture-package-tree: ambiguous-words/src/report.hd
use pkg.words.{first_word}
use pkg.{words}
tests:
    use std.testing.assert_equal

    it("reaches the module's function and the root's function"):
        assert_equal(first_word("ship it now"), "ship", reason="pkg.words.first_word is in src/words.hd")
        assert_equal(words("ship"), 1, reason="pkg.{words} is the root declaration")
