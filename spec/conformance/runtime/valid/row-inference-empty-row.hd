# test: requirements / row inference / inferred empty row

use std.testing.assert_equal

fn invoke[r](callback: fn() -> i32 $ r) -> i32 $ r: callback()
fn pure() -> i32: 42
fn main() -> i32: invoke(pure)

test "main returns 42":
    assert_equal(main(), 42, reason="requirements / row inference / inferred empty row")
