# test: string length, index, iteration, and slice use byte offsets
# Spec 04 Strings, 05 String Indexing, 10 String Methods (Strings STR1-STR6).
# expect: test
use std.testing.{assert, assert_equal}

fn first_word(text: string) -> string:
    for (offset, letter) in text.char_indices():
        if letter == ' ':
            return text.slice(0, offset)
    text

tests:
    it("len and index count bytes"):
        let lead: u8 = 195
        let second: u8 = 169
        assert_equal("héllo".len(), 6, reason="é is two bytes")
        assert_equal("héllo"[1], lead, reason="first byte of é")
        assert_equal("héllo"[2], second, reason="second byte of é")

    it("chars yields scalar values"):
        let found: mut List[char] = []
        for letter in "aé😀".chars():
            found.push(letter)
        assert_equal(found, ['a', 'é', '😀'], reason="one char per scalar")

    it("char_indices yields byte offsets"):
        let offsets: mut List[i32] = []
        for (offset, letter) in "aé!".char_indices():
            offsets.push(offset)
        assert_equal(offsets, [0, 1, 3], reason="é starts at 1 and takes two bytes")

    it("bytes yields the UTF-8 encoding"):
        let found: mut List[u8] = []
        for byte in "é".bytes():
            found.push(byte)
        let expected: List[u8] = [195, 169]
        assert_equal(found, expected, reason="two bytes")

    it("slice takes byte offsets"):
        assert_equal("héllo".slice(0, 3), "hé", reason="h and é")
        assert_equal("héllo".slice(3, 6), "llo", reason="the rest")
        assert_equal(first_word("héllo world"), "héllo", reason="offset from char_indices")

    it("ordering compares bytes"):
        assert("a" < "é", reason="0x61 before 0xC3")
        assert("\u{FFFF}" < "\u{1F600}", reason="byte order is scalar order")
