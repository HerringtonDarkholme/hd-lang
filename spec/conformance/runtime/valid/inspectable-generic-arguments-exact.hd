# test: runtime identity includes type arguments and matches them exactly
# Spec 09 Inspectable And TypeId: identity is the declaration applied to its type arguments,
# and no optional unwrapping takes place.
# Spec 09 Traits: trait.identity.arguments, trait.downcast.exact.reference-values, trait.downcast.no-conversion, trait.downcast.optional-local-reference.
use std.inspect.{Inspectable}
struct Box[T]:
    value: T

struct User:
    name: string

fn is_int_box(value: *dyn Inspectable) -> bool:
    match value.downcast_ref::[Box[i32]]().map(fn(found): *found):
        .Some(_) => true
        .None => false

fn is_string_list(value: *dyn Inspectable) -> bool:
    match value.downcast_ref::[List[string]]().map(fn(found): *found):
        .Some(_) => true
        .None => false

fn is_user(value: *dyn Inspectable) -> bool:
    match value.downcast_ref::[User]().map(fn(found): *found):
        .Some(_) => true
        .None => false

fn is_optional_user(value: *dyn Inspectable) -> bool:
    match value.downcast_ref::[User?]().map(fn(found): *found):
        .Some(_) => true
        .None => false

tests:
    use std.testing.assert

    it("generic arguments must match"):
        ints := box::[Box[i32]](Box { value: 1 })
        texts := box::[Box[string]](Box { value: "one" })
        assert(is_int_box(ints), reason="Box[i32] matches Box[i32]")
        assert(!is_int_box(texts), reason="Box[string] does not match Box[i32]")
        words := box::[List[string]](["a"])
        numbers := box::[List[i32]]([1])
        assert(is_string_list(words), reason="List[string] matches")
        assert(!is_string_list(numbers), reason="List[i32] does not match List[string]")

    it("an optional is not unwrapped"):
        maybe := box::[User?](User { name: "Ada" })
        assert(!is_user(maybe), reason="User? is not User")
        assert(is_optional_user(maybe), reason="User? matches User?")
