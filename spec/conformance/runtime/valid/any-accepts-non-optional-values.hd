# test: primitive, string, data, enum, tuple, and list values convert to Any
# Spec 09 Any: "`Any` is the universal empty trait. Every value type, including an optional
# type, implements it automatically." runtime/valid/optional-erased-to-any.hd covers optionals.
# Spec 09 Traits: trait.any.universal, trait.any.all.
struct User:
    name: string

enum Status:
    Active
    Blocked

tests:
    use std.testing.assert_equal

    it("primitive, string, data, enum, tuple, and list values convert to Any"):
        let values: List[*dyn Any] = [
            box(1),
            box("text"),
            box(User { name: "Ada" }),
            box(Status.Active),
            box((1, 2)),
            box([true]),
        ]
        assert_equal(values.len(), 6, reason="six erased values")
