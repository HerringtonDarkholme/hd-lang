# test: and, or, if chains, and match guards evaluate only what is needed
# expect: test
use std.testing.assert_equal

data Log:
    text: string

fn flag(log: mut Log, tag: string, value: bool) -> bool:
    log.text = log.text + tag
    value

test "and skips its right operand when the left is false":
    let log: mut Log = Log { text: "" }
    result := flag(log, "a", false) and flag(log, "b", true)
    assert_equal(result, false, reason="false and anything is false")
    assert_equal(log.text, "a", reason="right operand must not run")

test "or skips its right operand when the left is true":
    let log: mut Log = Log { text: "" }
    result := flag(log, "a", true) or flag(log, "b", false)
    assert_equal(result, true, reason="true or anything is true")
    assert_equal(log.text, "a", reason="right operand must not run")

test "and evaluates both operands left to right when needed":
    let log: mut Log = Log { text: "" }
    result := flag(log, "a", true) and flag(log, "b", false)
    assert_equal(result, false, reason="second operand decides")
    assert_equal(log.text, "ab", reason="left before right")

test "and binds tighter than or":
    let log: mut Log = Log { text: "" }
    result := flag(log, "a", true) or flag(log, "b", false) and flag(log, "c", false)
    assert_equal(result, true, reason="a or (b and c)")
    assert_equal(log.text, "a", reason="the whole and-group is skipped")

test "if chain stops at the first true condition":
    let log: mut Log = Log { text: "" }
    chosen := if flag(log, "1", false):
        1
    else if flag(log, "2", true):
        2
    else if flag(log, "3", true):
        3
    else:
        4
    assert_equal(chosen, 2, reason="second branch selected")
    assert_equal(log.text, "12", reason="later conditions are not evaluated")

test "a guard is not evaluated when its pattern fails":
    let log: mut Log = Log { text: "" }
    let value: i32? = nil
    label := match value:
        present? if flag(log, "g", true) => "present $present"
        nil => "absent"
        _ => "other"
    assert_equal(label, "absent", reason="nil arm selected")
    assert_equal(log.text, "", reason="guard of a failed pattern never runs")

test "a false guard falls through to the next arm":
    let log: mut Log = Log { text: "" }
    let value: i32? = 5
    label := match value:
        present? if flag(log, "g", false) => "guarded $present"
        present? => "plain $present"
        nil => "absent"
    assert_equal(label, "plain 5", reason="false guard continues matching")
    assert_equal(log.text, "g", reason="guard ran exactly once")
