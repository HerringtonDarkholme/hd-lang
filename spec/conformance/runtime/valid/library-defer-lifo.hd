# test: library defer shares one LIFO cleanup stack with using guards
# expect-stdout: library defer
# expect-stdout: using guard
# expect-stdout: first deferred callback
use std.ops.{defer, on_exit}

fn run(log: &mut List[string]) -> void:
    defer(fn() -> void: log.push("first deferred callback"))
    using guard = on_exit(fn() -> void: log.push("using guard"))
    defer(fn() -> void: log.push("library defer"))
    return

pub fn main() -> void $ Console:
    let mut log: List[string] = []
    run(&mut log)
    for line in log:
        println(line)
