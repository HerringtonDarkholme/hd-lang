# expect-stdout: 5 items, peak 2
# test: map_all! returns results in item order and keeps at most limit calls in flight
# Spec std/task Map All: std-task.map-all.decl, .order, .start-order, .limit, .window, .limit-zero, and .empty (issue #369).
use std.task.map_all
use std.time.{Clock, ManualClock, Timestamp, ms, sleep}

fn fetch!(id: i32) -> string $ Clock:
    sleep!(ms(100))
    "item ${id}"

fn fetch_all!() -> List[string] $ Clock:
    map_all!([1, 2, 3, 4, 5], 2, fn!(id: i32) -> string $ Clock: fetch!(id))

struct Gauge:
    live: i32
    peak: i32
    started: *mut List[i32]

fn measured!(gauge: &mut Gauge, id: i32) -> i32 $ Clock:
    gauge.started.push(id)
    gauge.live = gauge.live + 1
    if gauge.live > gauge.peak:
        gauge.peak = gauge.live
    sleep!(ms(30))
    gauge.live = gauge.live - 1
    id * 10

pub fn main!() -> void $ Console + Clock:
    let gauge: *mut Gauge = &mut Gauge { live: 0, peak: 0, started: &mut [] }
    values := map_all!([1, 2, 3, 4, 5], 2, fn!(id: i32) -> i32 $ Clock: measured!(gauge, id))
    println("${values.len()} items, peak ${gauge.peak}")

tests:
    use std.testing.assert_equal

    it("returns the results in item order"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            assert_equal(
                fetch_all!(),
                ["item 1", "item 2", "item 3", "item 4", "item 5"],
                reason="one result for each item, in order",
            )

    it("calls work once for each item, in item order"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let gauge: *mut Gauge = &mut Gauge { live: 0, peak: 0, started: &mut [] }
        $.with(Clock=clock):
            values := map_all!([4, 3, 2, 1], 3, fn!(id: i32) -> i32 $ Clock: measured!(gauge, id))
            assert_equal(values, [40, 30, 20, 10], reason="results at the item's index")
        assert_equal(gauge.started, &mut [4, 3, 2, 1], reason="calls start in item order")
        assert_equal(gauge.live, 0, reason="every call completed")

    it("keeps at most limit calls in flight"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let gauge: *mut Gauge = &mut Gauge { live: 0, peak: 0, started: &mut [] }
        $.with(Clock=clock):
            _ := map_all!([1, 2, 3, 4, 5], 2, fn!(id: i32) -> i32 $ Clock: measured!(gauge, id))
        assert_equal(gauge.peak <= 2, true, reason="never above the limit")

    it("counts a limit of 0 as 1"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let gauge: *mut Gauge = &mut Gauge { live: 0, peak: 0, started: &mut [] }
        $.with(Clock=clock):
            values := map_all!([1, 2, 3], 0, fn!(id: i32) -> i32 $ Clock: measured!(gauge, id))
            assert_equal(values, [10, 20, 30], reason="every item ran")
        assert_equal(gauge.peak, 1, reason="one at a time")

    it("gives an empty list for no items and never calls work"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let gauge: *mut Gauge = &mut Gauge { live: 0, peak: 0, started: &mut [] }
        let items: List[i32] = []
        $.with(Clock=clock):
            values := map_all!(items, 4, fn!(id: i32) -> i32 $ Clock: measured!(gauge, id))
            assert_equal(values, [], reason="nothing to map")
        assert_equal(gauge.started, &mut [], reason="work never called")
