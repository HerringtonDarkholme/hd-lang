# test: a `*mut self` call on a non-place temporary refers to a new object holding the temporary's value
# Spec 07 Reference Receivers: fn.method.counted-self.temporary.
# expect-stdout: 3
struct Counter:
    hits: i32

impl Counter:
    fn handle(*mut self) -> *mut Counter:
        self

fn fresh() -> Counter:
    Counter { hits: 2 }

pub fn main() -> void $ Console:
    h := fresh().handle()
    h.hits += 1
    println(h.hits)
