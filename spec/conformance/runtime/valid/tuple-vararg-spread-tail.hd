# test: a tuple vararg's arguments may end in a list spread, collected as the tuple expression of them would be
# expect: test
# Spec 07 Varargs: fn.vararg.collect.tuple-expr (owner decision Q4, batch 34, 2026-10-01).
use std.function.{Fn, Tuple}
fn g(a: usize, b: usize, xs...: List[i32]) -> usize: a + b + xs.len()

fn call[Args < Tuple, O, $R](f: Fn[Args, O, $ R], args...: Args) -> O $ R:
    f(args...)

fn label(parts...: (string, List[i32]...)) -> string: "${parts._0}${parts._1.len()}"

tests:
    use std.testing.assert_equal

    it("separate arguments then a list spread fill a Tuple-bounded vararg"):
        xs := [+3, 4, 5]
        assert_equal(call(g, 1, 2, xs...), 6, reason="the spread list is the rest element")

    it("separate arguments then a list spread fill a tuple-typed vararg"):
        xs := [+7, 8]
        assert_equal(label("a", xs...), "a2", reason="collected as the tuple expression of the arguments")
