# test: mutable map loops update real value slots and preserve other map copies
# Spec 06 Element Reference Loops and Built-In Collection Iteration.
use std.testing.assert_equal

struct Stock:
    qty: usize
    note: string

fn restock(items: &mut Map[string, Stock]) -> void:
    for (key, value) in &mut items:
        let borrowed_key: &string = key
        let borrowed_value: &mut Stock = value
        borrowed_value.qty += borrowed_key.len()
        borrowed_value.note = "${borrowed_value.note}!"

pub fn main() -> void:
    let mut items = { "a": Stock { qty: 1, note: "first" }, "bb": Stock { qty: 2, note: "second" } }
    before := items
    restock(&mut items)
    assert_equal(items["a"].qty, 2)
    assert_equal(items["bb"].qty, 4)
    assert_equal(items["a"].note, "first!")
    assert_equal(before["a"].qty, 1)
    assert_equal(before["bb"].qty, 2)
    assert_equal(before["a"].note, "first")
    let mut empty: Map[string, Stock] = {}
    restock(&mut empty)
    assert_equal(empty.len(), 0)
    for (_, value) in &mut { "one": 1 }:
        *value += 1
    boxed := box({ "one": 1, "two": 2 })
    alias := boxed
    for (_, value) in &mut boxed:
        *value += 1
    assert_equal(alias["one"], 2)
    assert_equal(alias["two"], 3)
    for (_, value) in &mut boxed:
        if *value == 2:
            continue
        *value += 1
        break
    assert_equal(alias["two"], 4)
