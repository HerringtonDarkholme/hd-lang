# test: public policy builders are reusable values and preserve typed results
# Spec std/task: std-task.policy.timeout.builder, std-task.policy.retry.builder, std-task.policy.with-timeout.builder, std-task.policy.retry.when.
use std.convert.From
use std.task.{Backoff, TimedOut, apply, retry, timeout, with_timeout}
use std.time.{Clock, ManualClock, Timestamp}

@derive(Eq, Debug)
enum Failure:
    Deadline(value: TimedOut)

impl From[TimedOut] for Failure:
    fn from(value: TimedOut) -> Failure:
        .Deadline(value)

fn number!() -> Result[usize, TimedOut]:
    .Ok(7)
fn word!() -> Result[string, Failure]:
    .Ok("kept")

struct Calls:
    number: usize
    word: usize

fn eventually_number!(calls: *mut Calls) -> Result[usize, TimedOut]:
    calls.number += 1
    if calls.number == 1: .Err(TimedOut { limit: 1ms, cleanup: .Finished }) else: .Ok(9)

fn eventually_word!(calls: *mut Calls) -> Result[string, Failure]:
    calls.word += 1
    if calls.word == 1:
        .Err(.Deadline(TimedOut { limit: 1ms, cleanup: .Finished }))
    else:
        .Ok("again")

tests:
    use std.testing.assert_equal

    it("one timeout and one retry value accept different result and error types"):
        limit := timeout(0ms)
        again := retry(Backoff { attempts: 2, initial: 0ms })
        calls := &mut Calls { number: 0, word: 0 }
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            numeric := apply!(limit):
                number!()
            textual := apply!(limit):
                word!()
            retried_number := apply!(again):
                eventually_number!(calls)
            retried_word := apply!(again):
                eventually_word!(calls)
            assert_equal(
                numeric,
                .Ok(7),
                reason="a zero deadline still lets ready numeric work win",
            )
            assert_equal(
                textual,
                .Ok("kept"),
                reason="the same deadline value accepts another typed result",
            )
            assert_equal(
                retried_number,
                .Ok(9),
                reason="the retry value accepts TimedOut as its error",
            )
            assert_equal(
                retried_word,
                .Ok("again"),
                reason="the same retry value accepts another error type",
            )
        assert_equal(calls.number, 2, reason="numeric work is repeated rather than memoized")
        assert_equal(calls.word, 2, reason="text work is independently repeated")

    it("with_timeout wraps an inner configuration and a selected predicate stays typed"):
        policy := retry(Backoff { attempts: 2, initial: 0ms }) |> with_timeout(0ms, _)
        selected := retry(Backoff { attempts: 2, initial: 0ms }).when(fn(error: Failure): false)
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            result := apply!(policy):
                word!()
            stopped := apply!(selected):
                let failed: Result[string, Failure] = .Err(
                    .Deadline(TimedOut { limit: 2ms, cleanup: .Abandoned }),
                )
                failed
            assert_equal(result, .Ok("kept"), reason="with_timeout makes the supplied policy inner")
            assert_equal(
                stopped,
                .Err(Failure.Deadline(TimedOut { limit: 2ms, cleanup: .Abandoned })),
                reason="the selected predicate returns the unchanged typed error",
            )
        assert_equal(
            clock.now().unix_milliseconds(),
            0i64,
            reason="ready work and rejected retry perform no delay",
        )
