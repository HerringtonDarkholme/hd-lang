# test: a writer's first .Err ends the write: every standard and derived serialize returns it unchanged and calls nothing after it
# Spec std/serde Data Model: std-serde.model.errors, std-serde.model.one-value.
use std.serde.{Serialize, Serializer}
use std.structure.{Facts, VariantInfo, Member}
# A log sink with room for a fixed number of calls; the call past it fails.
data Sink:
    pub room: i32
    pub log: string

impl Sink:
    fn add(mut self, word: string) -> Result[void, string]:
        if self.room == 0:
            return .Err("full at $word")
        self.room = self.room - 1
        if self.log == "":
            self.log = word
        else:
            self.log = self.log + " " + word
        .Ok(())

impl Serializer for Sink:
    type Error = string

    fn null(mut self) -> Result[void, string]:
        self.add("null")

    fn bool(mut self, value: bool) -> Result[void, string]:
        self.add("bool:$value")

    fn int(mut self, value: i64) -> Result[void, string]:
        self.add("int:$value")

    fn uint(mut self, value: u64) -> Result[void, string]:
        self.add("uint:$value")

    fn float(mut self, value: f64) -> Result[void, string]:
        self.add("float:$value")

    fn text(mut self, value: string) -> Result[void, string]:
        self.add("text:$value")

    fn begin_list(mut self, len: usize) -> Result[void, string]:
        self.add("list:$len")

    fn end_list(mut self) -> Result[void, string]:
        self.add("end-list")

    fn begin_map(mut self, len: usize) -> Result[void, string]:
        self.add("map:$len")

    fn key(mut self, key: string) -> Result[void, string]:
        self.add("key:$key")

    fn end_map(mut self) -> Result[void, string]:
        self.add("end-map")

    fn begin_variant(mut self, facts: Facts, v: VariantInfo) -> Result[void, string]:
        self.add("variant:${v.name}")

    fn member(mut self, m: Member) -> Result[void, string]:
        self.add("member:${m.name}")

    fn end_variant(mut self) -> Result[void, string]:
        self.add("end-variant")

# Writes value into a sink with room calls, and gives the result and the log.
fn write[T < Serialize](value: T, room: i32) -> (Result[void, string], string):
    let out: mut Sink = Sink { room: room, log: "" }
    result := value.serialize(out)
    (result, out.log)

@derive(Serialize)
data Line:
    sku: string
    qty: u32

@derive(Serialize)
enum Event:
    Opened
    Added(line: Line)

tests:
    use std.testing.assert_equal

    it("a write with room for every call succeeds"):
        assert_equal(write(["pen", "ink"], +4), (.Ok(()), "list:2 text:pen text:ink end-list"), reason="four calls")

    it("a list stops at the first failed item"):
        assert_equal(write(["pen", "ink", "pad"], +2), (.Err("full at text:ink"), "list:3 text:pen"), reason="no later item, no end_list")

    it("a map stops at a failed key"):
        let stock: Map[string, u32] = { "pen": 4, "ink": 0 }
        assert_equal(write(stock, +3), (.Err("full at key:ink"), "map:2 key:pen uint:4"), reason="no value after the key")

    it("an optional passes its payload's error on"):
        let note: string? = .Some("gift")
        assert_equal(write(note, +0), (.Err("full at text:gift"), ""), reason="payload error")
        let none: string? = .None
        assert_equal(write(none, +0), (.Err("full at null"), ""), reason="null error")

    it("a derived serialize stops inside a nested member"):
        event := Event.Added(Line { sku: "PEN-01", qty: 3 })
        assert_equal(write(event, +4), (.Err("full at text:PEN-01"), "variant:Added member:line variant:Line member:sku"), reason="no end_variant")
        assert_equal(write(event, +7), (.Err("full at end-variant"), "variant:Added member:line variant:Line member:sku text:PEN-01 member:qty uint:3"), reason="the outer end_variant is not called")
