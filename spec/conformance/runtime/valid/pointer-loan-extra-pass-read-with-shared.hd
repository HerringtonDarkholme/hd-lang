# test: pointer loans, adversarial: passing a pointer as a `*T` and a `&` of its field to one call: two reads; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision elided; call-scoped fallback allowed; Go model runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn look(c: *Cell, f: &string) -> string:
    _ := c.other.len()
    *f

pub fn main() -> void $ Console:
    view := box(Cell { value: orig(), other: fresh() })
    seen := look(view, &view.value)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
