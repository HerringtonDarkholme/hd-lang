# test: collect finds its target from the expected type that ? gives its operand
# std Iterators, What Collect Builds: std-iter.collect.expected, std-iter.collect.result, std-iter.collect.option, with Spec 05 expr.try.expected (owner decision Q-?, batch 15, 2026-09-30).
fn parse_port(text: string) -> Result[usize, string]:
    if text == "x":
        return .Err("bad")
    .Ok(text.len())

fn find(text: string) -> usize?:
    if text == "x":
        return .None
    .Some(text.len())

fn all_ports(lines: List[string]) -> Result[List[usize], string]:
    let ports: List[usize] = lines.iter().map(parse_port).collect()?
    .Ok(ports)

fn all_found(lines: List[string]) -> List[usize]?:
    let found: List[usize] = lines.iter().map(find).collect()?
    .Some(found)

tests:
    use std.testing.assert_equal

    it("a Result hint collects every Ok payload"):
        assert_equal(all_ports(["a", "bb"]), .Ok([1, 2]), reason="all payloads")

    it("a Result hint propagates the first error"):
        assert_equal(all_ports(["a", "x"]), .Err("bad"), reason="first error")

    it("an optional hint collects every value"):
        assert_equal(all_found(["a", "bb"]), .Some([1, 2]), reason="all values")
        assert_equal(all_found(["x"]), .None, reason="first None")
