# test: a closure over a value parameter holds the collection as passed
# Spec 07 Copied And Shared Captures: fn.capture.copy, fn.capture.copy.value.
# Known failure: a value argument carries no copy-on-write mark (#549), so the callee's closure
# sees later changes to the caller's list.
# expect: test
struct Bag:
    items: List[i32]

fn counter_of(items: List[i32]) -> fn() -> usize:
    fn() -> usize: items.len()

fn bag_counter_of(bag: Bag) -> fn() -> usize:
    fn() -> usize: bag.items.len()

fn kept[T](value: T) -> fn() -> T:
    fn() -> T: value

tests:
    use std.testing.assert_equal

    it("a closure over a list parameter is unaffected by a later push by the caller"):
        let items: mut List[i32] = [1]
        count := counter_of(items)
        items.push(2)
        assert_equal(count(), 1, reason="the closure holds the list as passed")

    it("a closure over a struct parameter holding a list is unaffected by a later push"):
        let mut bag = Bag { items: [1] }
        count := bag_counter_of(bag)
        bag.items.push(2)
        assert_equal(count(), 1, reason="the closure holds the struct as passed")

    it("a closure over a generic parameter holding a list is unaffected by a later push"):
        let items: mut List[i32] = [1]
        read := kept(items)
        items.push(2)
        assert_equal(read().len(), 1, reason="the closure holds the value as passed")
