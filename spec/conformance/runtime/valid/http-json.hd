# test: JSON response reads return BodyError, while send errors remain HttpError
# expect: test
use std.convert.From
use std.http.{BodyError, Http, HttpError, Request, Response, ScriptedHttp, Url}
use std.json.JsonError
use std.serde.{Deserialize, Serialize}

@derive(Serialize)
struct NewUser:
    name: string

@derive(Deserialize)
struct Created:
    id: i64
    name: string

@error
@derive(Debug, Eq)
enum CreateError:
    @error("$error")
    Http(error: HttpError)
    @error("invalid response body: $error")
    Body(error: BodyError)

impl From[HttpError] for CreateError:
    fn from(error: HttpError) -> CreateError:
        .Http(error)

impl From[BodyError] for CreateError:
    fn from(error: BodyError) -> CreateError:
        .Body(error)

fn create!(name: string) -> Result[Created, CreateError] $ Http:
    response := Request::post(Url::parse("https://example.com/users").expect("fixture URL"))
        .set_json(NewUser { name: name })
        .send!()?
    .Ok(response.ok()?.json::[Created]()?)

tests:
    use std.testing.assert_equal

    it("decodes a created user and sends the JSON request"):
        http := ScriptedHttp::new()
        http.reply(
            "https://example.com/users",
            .Ok(Response::status(.Created).set_text("{\"id\":7,\"name\":\"Ada\"}")),
        )
        $.with(Http=http):
            match create!("Ada"):
                .Ok(created) =>
                    assert_equal((created.id, created.name), (7, "Ada"), reason="decoded")
                .Err(_) => assert_equal(true, false, reason="a 201 with JSON decodes")
        sent := http.received()[0]
        assert_equal(sent.method, .Post, reason="POST method")
        assert_equal(sent.header(.ContentType), .Some("application/json"), reason="JSON header")
        assert_equal(
            sent.text(),
            .Ok("{\"name\":\"Ada\"}"),
            reason="the recorded request has its own body",
        )

    it("a body that is not JSON retains the typed decoder error"):
        http := ScriptedHttp::new()
        http.reply("https://example.com/users", .Ok(Response::status(.Ok).set_text("oops")))
        $.with(Http=http):
            match create!("Ada"):
                .Err(.Body(.Json(error))) =>
                    assert_equal(
                        error,
                        JsonError.UnexpectedCharacter(0),
                        reason="typed decode cause",
                    )
                _ => assert_equal(true, false, reason="a body JSON error")

    it("a body of the wrong shape names the path"):
        http := ScriptedHttp::new()
        http.reply(
            "https://example.com/users",
            .Ok(Response::status(.Ok).set_text("{\"id\":\"x\",\"name\":\"Ada\"}")),
        )
        $.with(Http=http):
            match create!("Ada"):
                .Err(.Body(.Json(error))) =>
                    assert_equal(error.to_string(), "expected i64 at $.id", reason="the path")
                _ => assert_equal(true, false, reason="a body JSON error")

    it("a bad status stops before decoding and retains the complete response"):
        http := ScriptedHttp::new()
        http.reply(
            "https://example.com/users",
            .Ok(Response::status(.InternalServerError).set_text("oops")),
        )
        $.with(Http=http):
            match create!("Ada"):
                .Err(.Http(.Status(response))) =>
                    assert_equal(response.status, .InternalServerError, reason="status retained")
                    assert_equal(
                        response.url.map(fn(value): value.to_string()),
                        .Some("https://example.com/users"),
                        reason="URL retained",
                    )
                    assert_equal(
                        response.text(),
                        .Ok("oops"),
                        reason="status check did not read the body",
                    )
                _ => assert_equal(true, false, reason="a Status error")

    it("json alone ignores the status"):
        response := Response::status(.NotFound).set_text("{\"id\":1,\"name\":\"B\"}")
        match response.json::[Created]():
            .Ok(created) => assert_equal(created.id, 1, reason="decoded")
            .Err(_) => assert_equal(true, false, reason="json does not check the status")

    it("a failed decode consumes the body shared by copies"):
        response := Response::status(.Ok).set_text("oops")
        copy := response
        assert_equal(
            response.json::[Created]().err(),
            .Some(BodyError.Json(JsonError.UnexpectedCharacter(0))),
            reason="typed decoder cause",
        )
        assert_equal(
            copy.json::[Created]().err(),
            .Some(BodyError.Used),
            reason="copy observes the failed read",
        )
