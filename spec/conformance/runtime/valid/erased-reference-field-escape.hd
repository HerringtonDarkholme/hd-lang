# test: an erased generic method stores an open reference in a returned struct
# Spec 13 Reference lifetime: ref.box.lifetime; Spec 09 Dynamic Safety: trait.dyn.safe.method-type-param.
# expect-stdout: 10 stored 11 field
struct Holder[T]:
    item: *mut T

trait Factory:
    fn hold[T < 'static](self, value: T) -> Holder[T]:
        Holder { item: box(value) }

struct Maker: pass
impl Factory for Maker

pub fn main() -> void $ Console:
    let factory: &dyn Factory = &Maker {}
    number := factory.hold(+1)
    text := factory.hold("initial")
    pair := factory.hold((+2, "initial"))
    *number.item = +10
    *text.item = "stored"
    *pair.item = (+11, "field")
    println("${*number.item} ${*text.item} ${pair.item._0} ${pair.item._1}")
