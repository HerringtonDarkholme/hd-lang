# test: find_all returns non-overlapping leftmost-first matches and steps one character past an empty match
# Spec std/regex All Matches: std-regex.find-all, std-regex.find-all.next, std-regex.find-all.empty, std-regex.find-all.drop, std-regex.find-all.anchors (task #244).
use std.regex.Regex
use std.text.r

fn all(pattern: string, text: string) -> List[string]:
    let shown: mut List[string] = []
    for m in Regex::new(pattern).expect("compiles").find_all(text):
        shown.push("${m.start}-${m.end}:${m.text}")
    shown

tests:
    use std.testing.assert_equal

    it("matches do not overlap"):
        assert_equal(all(r"\d+", "a1 22 333"), ["1-2:1", "3-5:22", "6-9:333"], reason="three numbers")
        assert_equal(all("aa", "aaaaa"), ["0-2:aa", "2-4:aa"], reason="no overlap")
        assert_equal(all("x", "abc"), [], reason="no match")
        assert_equal(all("a|ab", "abab"), ["0-1:a", "2-3:a"], reason="leftmost-first each time")

    it("an empty match moves the search one character on"):
        assert_equal(all("a*", "baaac"), ["0-0:", "1-4:aaa", "5-5:"], reason="the empty match at 4 is dropped")
        assert_equal(all("", "abc"), ["0-0:", "1-1:", "2-2:", "3-3:"], reason="the empty pattern")
        assert_equal(all("", "é!"), ["0-0:", "2-2:", "3-3:"], reason="a character, not a byte")
        assert_equal(all("", ""), ["0-0:"], reason="the empty text")

    it("^ and $ still see only the ends of the whole text"):
        assert_equal(all("^a", "aaa"), ["0-1:a"], reason="only at the start")
        assert_equal(all("a\$", "aaa"), ["2-3:a"], reason="only at the end")
