# test: retry! with a times below 1 calls its attempt once and returns that result
# Spec std/task Retry: std-task.combinator.retry.at-least-once (owner decision RETRY-zero, batch 33, 2026-10-01).
use std.task.retry
use std.testing.assert_equal

data Server:
    busy_for: i32
    calls: i32

fn ask!(server: mut Server) -> Result[string, string]:
    server.calls = server.calls + 1
    if server.busy_for > 0:
        server.busy_for = server.busy_for - 1
        return .Err("busy ${server.calls}")
    .Ok("ready")

fn connect!(server: mut Server, times: i32) -> Result[string, string]:
    retry!(times):
        ask!(server)

tests:
    it("zero tries makes one call"):
        let mut server = Server { busy_for: 5, calls: 0 }
        assert_equal(connect!(server, 0), .Err("busy 1"), reason="the one error is returned")
        assert_equal(server.calls, 1, reason="exactly one call")

    it("a negative count makes one call"):
        let mut server = Server { busy_for: 0, calls: 0 }
        assert_equal(connect!(server, -2), .Ok("ready"), reason="the one call succeeds")
        assert_equal(server.calls, 1, reason="exactly one call")
