# test: else if chains preserve value typing and selection order

use std.testing.assert_equal

fn label(score: i32) -> i32:
    if score >= 90:
        40
    else if score >= 70:
        2
    else:
        0

fn main() -> i32: label(95) + label(75)

test "main returns 42":
    assert_equal(main(), 42, reason="else if chains preserve value typing and selection order")
