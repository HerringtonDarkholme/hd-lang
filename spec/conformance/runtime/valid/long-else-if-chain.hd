tests:
    use std.testing.assert_equal

    it("the first branch is selected"):
        assert_equal(pick(+0), +1, reason="the `if` condition holds")

    it("a middle branch is selected"):
        assert_equal(pick(+500), +501, reason="branch 500 holds")

    it("the last branch is selected"):
        assert_equal(pick(+999), +1000, reason="branch 999 holds")

    it("the else suite runs when no condition holds"):
        assert_equal(pick(+1000), +0, reason="no condition holds")
