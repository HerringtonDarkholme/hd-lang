# test: a defer statement not yet reached is not registered, so cancellation does not run it
# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait
use std.ops.defer

let log: string = ""

fn wait!() -> void:
    pass

fn inner!() -> void:
    defer(fn() -> void: log = log + "i")
    wait!()
    defer(fn() -> void: log = log + "X")
fn outer!() -> void:
    defer(fn() -> void: log = log + "o")
    inner!()
    defer(fn() -> void: log = log + "Y")
pub fn main!() -> void:
    outer!()

pub fn cleanup_ran() -> bool:
    log == "io"
