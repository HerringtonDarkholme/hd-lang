# test: a block suite may declare an inherent implementation of its own type and a trait implementation for it
# Spec 09 Local Implementations: trait.impl.local, trait.impl.local.trait, trait.impl.local.inherent.
use std.testing.assert_equal

trait Priced:
    fn price(self) -> i32

fn receipt(quantity: i32) -> string:
    data Line:
        quantity: i32
        unit: i32

    impl Line:
        fn total(self) -> i32:
            self.quantity * self.unit

    impl Priced for Line:
        fn price(self) -> i32:
            self.total() + 5

    line := Line { quantity: quantity, unit: 20 }
    "${line.total()} + fee = ${line.price()}"

tests:
    it("local implementations are found inside their suite"):
        assert_equal(receipt(3), "60 + fee = 65", reason="inherent and trait methods of a local type")
