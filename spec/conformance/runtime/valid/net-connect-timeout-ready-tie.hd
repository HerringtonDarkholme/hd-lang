# expect-stdout: ready connect
# test: an already ready connect wins a zero-limit tie without advancing ManualClock
# Spec std/task Result Timeouts: std-task.policy.time-limit.completed.
use std.net.{Net, ScriptedNet, ScriptedStream, TcpStream, NetError, connect}
use std.task.{timeout, apply}
use std.testing.assert_equal
use std.time.{Clock, ManualClock, Timestamp}

pub fn main!() -> void $ Console:
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    net := ScriptedNet::new()
    stream := ScriptedStream::new([])
    net.add_connection("ready.local:25", stream)
    $.with(Net=net, Clock=clock):
        let result: Result[*mut dyn TcpStream, NetError] = apply!(timeout(0ms)):
            connect!("ready.local", 25)
        assert_equal(result.is_ok(), true, reason="ready work wins the zero-limit tie")
        _ := result.expect("connected stream").close()
    assert_equal(
        clock.now().unix_milliseconds(),
        0i64,
        reason="the losing deadline never advances time",
    )
    assert_equal(net.received(), ["ready.local:25"], reason="the connection starts once")
    println("ready connect")
