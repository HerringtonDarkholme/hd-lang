# test: strings compare by UTF-8 value order

use std.testing.assert_equal

fn main() -> i32:
    if "same" == "same" && "a" < "é" && "é" < "界" && "abc" < "abcd" && "界面".starts_with("界") && "abc".starts_with("") && !"a".starts_with("ab"):
        42
    else:
        0

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="strings compare by UTF-8 value order")
