# test: ListView.to_list returns a mut List, so the copy may grow
# expect: test
use std.collections.ListView
use std.testing.assert_equal

tests:
    it("grows the copy"):
        items := [1, 2, 3, 4]
        let mut copy = items.view(1, 3).to_list()
        copy.append(9)
        assert_equal(copy, [2, 3, 9], reason="the copy grows")
        assert_equal(items, [1, 2, 3, 4], reason="the list is unchanged")
