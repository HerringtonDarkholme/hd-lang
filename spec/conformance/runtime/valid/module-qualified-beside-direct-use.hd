# test: cmp.max and cmp.min select their declarations while the same functions are also used directly or under an alias
# Spec 05 Names: expr.name.qualified; a direct use of a member does not change what the module path selects.
use std.cmp
use std.cmp.max
use std.cmp.min as cheapest
fn pick_price(choose: fn(i32, i32) -> i32) -> i32:
    choose(42, 50)

tests:
    use std.testing.assert_equal

    it("the module path beside a direct use"):
        assert_equal(pick_price(cmp.max), 50, reason="cmp.max is max")
        assert_equal(pick_price(max), 50, reason="the direct use is the same function")

    it("the module path beside an aliased use"):
        assert_equal(pick_price(cmp.min), 42, reason="cmp.min is min")
        assert_equal(pick_price(cheapest), 42, reason="the alias is the same function")
