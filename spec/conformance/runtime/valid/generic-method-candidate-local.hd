# test: generic method substitutions stay local to the winning candidate
# Spec 09 Traits: trait.resolve.one-applies (exactly one applicable candidate is selected).
trait Apply[T]:
    fn apply[U](self, run: fn(T) -> U) -> U

data Item:
    value: i32

impl Apply[bool] for Item:
    fn apply[U](self, run: fn(bool) -> U) -> U: run(true)

impl Apply[i32] for Item:
    fn apply[U](self, run: fn(i32) -> U) -> U: run(self.value)

fn main() -> i32:
    Item { value: 40 }.apply(fn(value): value + 2)

tests:
    use std.testing.assert_equal

    it("the generic candidate infers the closure result"):
        assert_equal(main(), 42, reason="the i32 candidate fits the closure")
