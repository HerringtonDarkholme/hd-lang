# test: chain and report_of follow the sources of derived errors: an absent optional source ends the chain, and a transparent variant is not listed twice
# Spec std/error Cause Chain: std-error.chain.source-order, std-error.chain.source-end, std-error.report.source-texts, std-error.report.display-sources;
# 14 Error Derivation: annot.error.cause.optional, annot.error.form.variant-transparent.
use std.error.{Error, ErrorReport, report_of}
@error("disk full")
struct DiskError:
    free: i64

@error
enum RepoError:
    @error("cannot write $path")
    Write(
        path: string,
        @source
        error: DiskError?,
    )
    @error(transparent)
    Disk(
        @from
        error: DiskError,
    )

@error("sync failed")
struct SyncError:
    @source
    repo: RepoError

fn load() -> Result[i32, *dyn Error]:
    let failed: Result[i32, RepoError] = .Err(
        RepoError.Write("a.txt", .Some(DiskError { free: 0 })),
    )
    value := failed?
    .Ok(value)

fn texts(error: *dyn Error) -> List[string]:
    error.chain().map(fn(item: &dyn Error) -> string: item.to_string())

tests:
    use std.testing.assert_equal

    it("an absent optional source ends the chain"):
        assert_equal(
            texts(box(RepoError.Write("a.txt", .None))),
            ["cannot write a.txt"],
            reason="no source",
        )

    it("a transparent variant skips its member"):
        failure := box(SyncError { repo: RepoError.Disk(DiskError { free: 0 }) })
        assert_equal(
            texts(failure),
            ["sync failed", "disk full"],
            reason="the member is not listed twice",
        )

    it("an erased error reports its sources"):
        match load():
            .Ok(_) => assert_equal(0, 1, reason="load fails")
            .Err(error) =>
                report := report_of(error)
                assert_equal(report.message, "cannot write a.txt", reason="message")
                assert_equal(report.sources, ["disk full"], reason="sources")

    it("an empty report displays its message alone"):
        assert_equal(
            ErrorReport { message: "m", sources: [] }.to_string(),
            "m",
            reason="no source line",
        )
