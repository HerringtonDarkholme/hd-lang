# fixture-package-role: root-application
# test: another module reaches a promoted member hidden by a private own member through the explicit path
use std.testing.assert_equal
use dep.members.{make_draft}

tests:
    it("hidden promoted members are reached by their path"):
        draft := make_draft()
        assert_equal(draft.CreatedBySystem.id, "system", reason="the part's field, by its path")
        assert_equal(draft.CreatedBySystem.label(), "created by system", reason="the part's method, by its path")
