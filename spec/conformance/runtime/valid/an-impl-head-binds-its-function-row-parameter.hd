# test: an impl head binds its function row parameter
# Spec 07 Function Types: fn.type.ctor.inputs.
# expect-stdout: function
# expect-stdout: 42
# expect-stdout: function
# expect-stdout: 9
# expect-stdout: 10
use std.function.Fn

trait Describe:
    fn describe(self) -> string

impl[O, $R] Describe for Fn[(i32,), O, $ R]:
    fn describe(self) -> string:
        "function"

fn bump(x: i32) -> i32 $ Console:
    println(x)
    x + 1

pub fn main() -> void $ Console:
    f := fn(x: i32) -> i32: x + 1
    println(f.describe())
    println(f(41))
    println(bump.describe())
    println(bump(9))
