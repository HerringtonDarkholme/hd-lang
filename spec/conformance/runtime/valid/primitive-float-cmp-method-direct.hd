# test: .eq and .partial_cmp call the standard Eq and PartialOrd implementations of floats directly, with IEEE 754 NaN semantics
# expect: test
# Spec 05 Equality and Ordering: expr.eq.float, expr.ord.std, expr.ord.total; 09 trait.cmp.float-eq, trait.cmp.float-ord.
pub fn main() -> void:
    if !(1.5).eq(1.5) || (1.5).eq(2.0):
        panic("f64 eq")
    match (1.5).partial_cmp(2.0):
        .Some(.Less) => pass
        _ => panic("f64 partial_cmp")
    let nan = 0.0 / 0.0
    if nan.eq(nan):
        panic("NaN equals itself")
    match nan.partial_cmp(1.0):
        .None => pass
        _ => panic("NaN is ordered")
    match (1.0).partial_cmp(nan):
        .None => pass
        _ => panic("NaN is ordered on the right")
    let zero = 0.0
    match zero.partial_cmp(-0.0):
        .Some(.Equal) => pass
        _ => panic("signed zeros")
    let single: f32 = 2.5
    match single.partial_cmp(0.5):
        .Some(.Greater) => pass
        _ => panic("f32 partial_cmp")
    let single_nan: f32 = 0.0 / 0.0
    if single_nan.eq(single_nan):
        panic("f32 NaN equals itself")
    match single_nan.partial_cmp(single):
        .None => pass
        _ => panic("f32 NaN is ordered")
