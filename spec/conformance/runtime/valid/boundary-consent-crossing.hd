# test: a type with a private field crosses a host call out of hd and back in when it consents both ways, private field included
# Spec Modules, Private Fields At A Boundary: module.boundary.consent.out, module.boundary.consent.in, module.boundary.consent.direction, module.boundary.consent.tree (task #320).
# fixture-runtime-profile: consent-vault
use std.serde.{Serialize, Deserialize}
use std.testing.assert_equal

@derive(Serialize, Deserialize)
pub data Token:
    pub owner: string
    secret: i64

pub trait Vault:
    fn keep(self, token: Token) -> Token

pub fn main() -> void $ Vault:
    kept := $.use(Vault).keep(Token { owner: "ada", secret: 42 })
    assert_equal(kept.owner, "ada", reason="the public field crosses")
    assert_equal(kept.secret, 42, reason="the private field crosses with the consent")
