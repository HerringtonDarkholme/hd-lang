# test: a chain of single-name bindings may end in an expression that owns a suite
# Spec 02 Suite Statements: grammar.stmt.chain, grammar.stmt.suite.right-side.
# expect-stdout: 1 1
# expect-stdout: 7 7
pub fn main() -> void $ Console:
    sum := +6
    a := b := if sum > 5: 1 else: 2
    println("$a $b")
    c := d := +7
    println("$c $d")
