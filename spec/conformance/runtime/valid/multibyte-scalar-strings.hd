# test: length counts bytes; ordering, split, and replace keep Unicode scalars whole
# expect: test
use std.testing.{assert, assert_equal}

tests:
    it("len counts bytes"):
        assert_equal("\u{4F60}\u{597D}".len(), 6, reason="two BMP scalars of three bytes")
        assert_equal("\u{1F600}".len(), 4, reason="one astral scalar of four bytes")
        assert_equal("a\u{1F600}b".len(), 6, reason="mixed ASCII and astral")
        assert_equal("e\u{301}".len(), 3, reason="combining mark is its own two-byte scalar")

    it("no normalization in equality"):
        assert("\u{E9}" != "e\u{301}", reason="canonically equivalent but distinct")
        assert_equal("\u{E9}", "\u{E9}", reason="the same precomposed scalar")

    it("ordering compares bytes, which is scalar order, not UTF-16 code units"):
        assert("\u{FF61}" < "\u{1F600}", reason="U+FF61 < U+1F600 by scalar value")
        assert("\u{1F600}" > "\u{FFFF}", reason="astral sorts after every BMP scalar")
        assert("a\u{1F600}" < "a\u{1F601}", reason="later scalar decides")

    it("split with an empty separator yields one-scalar strings"):
        assert_equal("a\u{1F600}b".split(""), ["a", "\u{1F600}", "b"], reason="astral scalar stays whole")
        assert_equal("e\u{301}".split(""), ["e", "\u{301}"], reason="scalars, not graphemes")

    it("multibyte separators and replacements"):
        assert_equal("a\u{1F600}b\u{1F600}".split("\u{1F600}"), ["a", "b", ""], reason="astral separator")
        assert_equal("a\u{1F600}a".replace("a", "\u{E9}"), "\u{E9}\u{1F600}\u{E9}", reason="replace keeps the astral scalar")
        assert("\u{1F600}x".starts_with("\u{1F600}"), reason="astral prefix")
        assert_equal("\u{C0}B".lower(), "\u{E0}b", reason="lowercasing non-ASCII")
        assert_equal("\u{130}".lower(), "i\u{307}", reason="full mapping for capital I with dot above")
