# test: data field initializers preserve source evaluation order

use std.testing.assert_equal

data Pair[T]:
    first: T
    second: T

fn first!() -> i32: 1
fn second!() -> i32: 2
fn main!() -> i32:
    pair := Pair { second: first!(), first: second!() }
    pair.first * 10 + pair.second

test "main returns 21":
    assert_equal(main!(), 21, reason="data field initializers preserve source evaluation order")
