# test: pretty writes two-space indentation, one item per line, and keeps empty containers on one line
# Spec std/json Writing: std-json.value.pretty, std-json.pretty.layout, std-json.pretty.empty, std-json.pretty.scalar (JSON-SURFACE; task #226).
use std.json.{parse, Json}
fn read(text: string) -> Json:
    match parse(text):
        .Ok(value) => value
        .Err(_) => panic("parse failed for $text")

tests:
    use std.testing.{assert_equal}

    it("a scalar is its compact text"):
        assert_equal(read("null").pretty(), "null", reason="null")
        assert_equal(read("-5").pretty(), "-5", reason="number")
        assert_equal(read("\"a\\n\"").pretty(), "\"a\\n\"", reason="text")

    it("empty containers stay on one line"):
        assert_equal(read("[]").pretty(), "[]", reason="array")
        assert_equal(read("{}").pretty(), "{}", reason="object")
        assert_equal(read("[[],{}]").pretty(), "[\n  [],\n  {}\n]", reason="nested")

    it("each item and each member gets its own line, two spaces deeper"):
        assert_equal(read("[1,2]").pretty(), "[\n  1,\n  2\n]", reason="array")
        assert_equal(read("{\"a\":1,\"b\":[true]}").pretty(), "{\n  \"a\": 1,\n  \"b\": [\n    true\n  ]\n}", reason="object")

    it("pretty text parses back to an equal value"):
        value := read("{\"a\":[1,{\"b\":null}],\"c\":\"d\",\"e\":{}}")
        assert_equal(read(value.pretty()), value, reason="round trip")

    it("pretty has no trailing space or final newline"):
        assert_equal(read("{\"a\":[]}").pretty().ends_with("}"), true, reason="ends at the brace")
        assert_equal(read("{\"a\":[1]}").pretty().contains(" \n"), false, reason="no trailing space")
