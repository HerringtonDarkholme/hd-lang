# test: a bare decorator name of a function with no parameters is called
# Spec 14 Prefix Decorators: `@hidden` means `@hidden()`, read through facts_of.
use std.annotation.facts_of
use std.testing.assert_equal

data Hidden: pass

fn hidden() -> Hidden:
    Hidden {}

@hidden
fn internal_check() -> bool:
    true

fn plain() -> bool:
    false

marked := facts_of(internal_check).find::[Hidden]()

tests:
    it("attaches the marker's result"):
        assert_equal(marked.is_some(), true, reason="the marker was called")
        assert_equal(facts_of(plain).find::[Hidden]().is_some(), false, reason="an undecorated function holds none")
