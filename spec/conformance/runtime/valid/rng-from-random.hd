# test: rng() seeds an Rng from one next_u64 draw of the Random provider that covers the call
# Spec std/random Rng: std-random.rng.decl-struct, std-random.rng.new-ref, std-random.rng.from-random-ref, std-random.rng.plain (task #242).
use std.random.{Random, Rng, SeededRandom, rng}
fn roll() -> i64 $ Random:
    dice := rng()
    dice.int(1..=6)

fn deal(seed: u64) -> List[string]:
    deck := Rng::new(seed)
    let mut cards: List[string] = ["A", "K", "Q", "J"]
    deck.shuffle(&mut cards)
    cards

tests:
    use std.testing.assert_equal

    it("rng draws its seed from the provider"):
        source := SeededRandom::new(5)
        copy := SeededRandom::new(5)
        expected := Rng::new(copy.next_u64())
        let made = Rng::new(0)
        $.with(Random=source):
            made = rng()
        assert_equal(made.next_u64(), expected.next_u64(), reason="the same seed")
        assert_equal(source.next_u64(), copy.next_u64(), reason="rng spent one draw of the provider")

    it("a seed deals one order"):
        assert_equal(deal(3), deal(3), reason="the same seed, the same order")
        source := SeededRandom::new(8)
        again := SeededRandom::new(8)
        let mut first: List[i64] = []
        $.with(Random=source):
            first.push(roll())
        $.with(Random=again):
            assert_equal(roll(), first[0], reason="the same provider seed rolls the same")
