# test: requirements / row forwarding
# Spec 11 Row Polymorphism: req.row.parameter, req.row.set.parameter,
# req.row.entail.parameter, req.row.entail.parameter.concrete,
# req.poly.extension.form, req.poly.kind.marked, req.poly.naming,
# req.poly.least, req.poly.least.example, req.poly.body, req.poly.one-body,
# req.poly.no-subtraction, req.poly.rows-only.

use std.testing.assert_equal

fn invoke[$R](callback: fn() -> i32 $ R) -> i32 $ R:
    callback()

fn forward[$S](callback: fn() -> i32 $ S + Clock) -> i32 $ S + Clock:
    invoke(callback)

fn read() -> i32 $ Clock + Logger:
    _ := $.use(Clock)
    _ := $.use(Logger)
    42

fn run() -> i32 $ Clock + Logger:
    forward(read)

trait Clock

data FixedClock: pass

impl Clock for FixedClock

trait Logger

data FixedLogger: pass

impl Logger for FixedLogger

tests:
    it("run returns 42 with its providers"):
        $.with(Clock=FixedClock {}, Logger=FixedLogger {}):
            assert_equal(run(), 42, reason="requirements / row forwarding")
