# test: describe reaches every member of an opted-in type, private ones included
# Spec 14 The Structure Trait: annot.structure.private.
use std.structure.{Structure, Field, Variant, Describer}

trait Named:
    fn type_name() -> string

struct Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

trait Counted:
    fn members() -> i32

impl[T] Counted for T by Structure:
    fn members() -> i32:
        let mut d = Count { n: 0 }
        _ := T::describe(&mut d)
        d.n

@derive(Counted)
data Secret:
    pub shown: i32
    hidden: string

tests:
    use std.testing.assert_equal

    it("the private member is counted"):
        assert_equal(Secret::members(), 2, reason="describe includes the private field")
