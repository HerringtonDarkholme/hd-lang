# fixture-runtime-profile: pending-tick
# test: block_on keeps polling a stored suspension through a pending host call, and returns its result
# Spec 11 Driving And Entry: req.drive.bang, req.drive.once,
# req.host-wait.wait,
# req.host-wait.source, req.poll-context.construction,
# req.poll-context.waker, req.waker.arrange.
# Spec 11 Suspension: req.drive.block-on.signature.
# The stored tick! call is pending on its first poll and completes on the next.
use std.task.block_on
use std.testing.assert

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn echo!(text: string) -> string $ Tick:
    $.use(Tick).tick!(text)
    text

fn completed(text: string) -> bool $ Tick:
    let pending: mut Suspend[string] = echo(text)
    match block_on(pending):
        .Completed(value) => value == text
        _ => false

pub fn main() -> void $ Console + Tick:
    assert(completed("first"), reason="block_on returns the completed call's result")
    assert(completed("second"), reason="a second stored call completes too")
