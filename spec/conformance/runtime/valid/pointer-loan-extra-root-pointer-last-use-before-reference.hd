# test: pointer loans, adversarial: the local holding a reference's root pointer stays alive until the reference's last use; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
use std.collections.UniqList

struct Outer:
    items: UniqList[string]

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq() -> UniqList[string]:
    let mut items = UniqList::[string].new()
    items.push(orig())
    items

fn probe() -> string:
    p := box(Outer { items: uniq() })
    r := p.items.get_ref(0).expect("slot")
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    seen := probe()
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
