# test: with `&T` roots, disjoint pointer slots may be replaced beside live path loans at one and two levels, and guarded slots after the loans' last use
# Spec 13 Conflicts Through Aliases: ref.excl.alias.path-pointer, ref.excl.place.
struct User:
    name: string

struct Mid:
    leaf: *mut User
    spare: *mut User

struct Team:
    lead: *mut User
    spare: *mut User
    mid: *mut Mid

fn replace(t: &Team, alias: *mut Team) -> string:
    name := &t.lead.name
    alias.spare = box(User { name: "new spare" })
    leaf := &t.mid.leaf.name
    alias.mid.spare = box(User { name: "new mid spare" })
    old := *name + " " + *leaf
    alias.lead = box(User { name: "new lead" })
    alias.mid.leaf = box(User { name: "new leaf" })
    old

pub fn main() -> void:
    t := box(
        Team {
            lead: box(User { name: "old" }),
            spare: box(User { name: "spare" }),
            mid: box(Mid { leaf: box(User { name: "leaf" }), spare: box(User { name: "s" }) }),
        },
    )
    alias := t
    if (
        replace(t, alias) != "old leaf"
        || t.lead.name != "new lead"
        || t.mid.leaf.name != "new leaf"
    ):
        panic("wrong replacement result")
