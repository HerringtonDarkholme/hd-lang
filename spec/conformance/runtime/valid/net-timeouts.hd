# test: connect_timeout! and set_timeout bound the waits for the peer, a timed-out read is Timeout, and ScriptedNet records both timeouts
# Spec std/net Timeouts: std-net.connect-timeout, std-net.timeout.set, std-net.timeout.error, std-net.error.timeout, std-net.error.timeout.text, std-net.scripted.timeout, std-net.scripted.connect-timeout.
# Also covers std-net.timeout.host-time, std-net.scripted.received,
# std-net.scripted.failing, std-net.scripted.queue, and
# std-net.scripted.closed-error.
# expect: test
use std.net.{Net, NetError, ScriptedListener, ScriptedNet, ScriptedStream, ScriptedUdp, TcpListener, UdpSocket}
use std.time.s

fn banner!(host: string, port: u16) -> Result[string, NetError] $ Net:
    net := $.use(Net)
    stream := net.connect_timeout!(host, port, 3s)?
    match stream.set_timeout(.Some(5s)):
        .Ok(_) => pass
        .Err(_) => return .Err(.Other("set timeout failed"))
    reply := match stream.read!(128):
        .Ok(bytes) => bytes
        .Err(.Timeout) => return .Err(.Timeout)
        .Err(_) => return .Err(.Other("read failed"))
    _ := stream.close()
    .Ok(string::from_utf8(reply).unwrap_or(""))

tests:
    use std.testing.assert_equal

    it("sets both timeouts and reads the banner"):
        stream := ScriptedStream::new(["220 ready\n".to_utf8()])
        net := ScriptedNet::new()
        net.add_connection("mail.local:25", stream)
        $.with(Net=net):
            assert_equal(banner!("mail.local", 25), .Ok("220 ready\n"), reason="banner")
        assert_equal(net.connect_timeouts(), [3s], reason="connect timeout")
        assert_equal(net.received(), ["mail.local:25"], reason="the connect is recorded")
        assert_equal(stream.timeout(), .Some(5s), reason="read timeout")

    it("reports a read that times out"):
        stream := ScriptedStream::failing([], NetError.Timeout)
        net := ScriptedNet::new()
        net.add_connection("mail.local:25", stream)
        $.with(Net=net):
            assert_equal(banner!("mail.local", 25), .Err(.Timeout), reason="timeout")

    it("reports a connect that times out"):
        net := ScriptedNet::new()
        net.fail_connection("mail.local:25", NetError.Timeout)
        $.with(Net=net):
            assert_equal(banner!("mail.local", 25), .Err(.Timeout), reason="connect timeout")

    it("a scripted handle starts with no timeout and records the last one set"):
        listener := ScriptedListener::new([])
        socket := ScriptedUdp::new([])
        assert_equal(listener.timeout(), .None, reason="no bound at first")
        _ := listener.set_timeout(.Some(2s))
        _ := socket.set_timeout(.Some(1s))
        _ := socket.set_timeout(.None)
        assert_equal(listener.timeout(), .Some(2s), reason="the listener's bound")
        assert_equal(socket.timeout(), .None, reason="the bound removed")

    it("Timeout has its own text"):
        assert_equal(NetError.Timeout.to_string(), "the net operation timed out", reason="the Display text")
