# test: a closure created in a for-loop body captures that iteration's binding
# Spec 03 Loops: "Each iteration creates the body bindings for that iteration; a closure that escapes
# an iteration captures that iteration's binding rather than one shared loop variable."
use std.testing.assert_equal

fn make_readers(values: list[i32]) -> list[fn() -> i32]:
    let readers: mut list[fn() -> i32] = []
    for value in values:
        doubled := value * 2
        readers.append(fn() -> i32: value + doubled)
    readers

test "each closure observes its own iteration":
    readers := make_readers([1, 2, 3])
    first := readers[0]
    second := readers[1]
    third := readers[2]
    assert_equal(first(), 3, reason="first iteration binding")
    assert_equal(second(), 6, reason="second iteration binding")
    assert_equal(third(), 9, reason="third iteration binding")
