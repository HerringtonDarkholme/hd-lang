# test: Timestamp.unix_millis returns the milliseconds that from_unix_millis took, for any i64
# Spec std/time Timestamps And Instants: std-time.timestamp.unix-millis, std-time.timestamp.public-api (TIMESTAMP-MILLIS, batch 72; task #229).
use std.testing.{assert, assert_equal}
use std.time.{Timestamp, s}

tests:
    it("round trip"):
        let values: List[i64] = [0, 1, -1, 1700000000500, -86400000, 9223372036854775807, -9223372036854775807]
        for millis in values:
            assert_equal(Timestamp::from_unix_millis(millis).unix_millis(), millis, reason="the same milliseconds")

    it("follows arithmetic and parsing"):
        later := Timestamp::from_unix_millis(1000) + s(2)
        assert_equal(later.unix_millis(), 3000, reason="1000 ms plus two seconds")
        match Timestamp::parse_rfc3339("1970-01-01T00:00:01.250Z"):
            .Ok(stamp) => assert_equal(stamp.unix_millis(), 1250, reason="the parsed instant")
            .Err(_) => assert(false, reason="the text is valid RFC 3339")
