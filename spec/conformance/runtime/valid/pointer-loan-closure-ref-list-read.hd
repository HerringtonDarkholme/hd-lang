# test: pointer loans: a `&` to a `List` element behind a `*T`, captured by a closure; an alias reads the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
struct Outer:
    items: List[string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { items: [second(), orig()], other: second() })

fn apply(alias: *Outer, read: fn() -> string) -> string:
    seen_alias := alias.items[1]
    junk := churn()
    _ := seen_alias.len()
    seen := read()
    _ := junk.len()
    seen

fn probe(p: *mut Outer, alias: *Outer) -> string:
    r := &p.items[1]
    apply(alias, fn() -> string: *r)

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
