# test: a `*mut self` call on a box passes the counted reference on, so a handle the method returns refers to the same object
# Spec 07 Reference Receivers: fn.method.counted-self.reference, fn.method.counted-self; Spec 13 Boxes: ref.box.new.
# expect-stdout: 5
# expect-stdout: true
struct Counter:
    hits: i32

impl Counter:
    fn handle(*mut self) -> *mut Counter:
        self

pub fn main() -> void $ Console:
    counter := box(Counter { hits: 0 })
    h := counter.handle()
    h.hits = 5
    println(counter.hits)
    println(h is counter)
