# test: handlers with narrower rows run through a wider function type with their own providers
# expect: test
use std.testing.assert_equal

trait Db:
    fn name(self) -> string

trait Clock:
    fn now(self) -> i32

data MemoryDb: pass

impl Db for MemoryDb:
    fn name(self) -> string: "db"

data FixedClock: pass

impl Clock for FixedClock:
    fn now(self) -> i32: 7

fn health() -> string $ Clock:
    "ok ${$.use(Clock).now()}"

fn orders() -> string $ Db + Clock:
    "${$.use(Db).name()} ${$.use(Clock).now()}"

fn plain() -> string:
    "plain"

fn serve(handler: fn() -> string $ Db + Clock) -> string $ Db + Clock:
    handler()

fn serve_all(handlers: List[fn() -> string $ Db + Clock]) -> string $ Db + Clock:
    let text = ""
    for handler in handlers:
        text = text + handler() + ";"
    text

tests:
    it("each handler sees the providers of its own row"):
        $.with(Db=MemoryDb {}, Clock=FixedClock {}):
            assert_equal(serve(health), "ok 7", reason="Clock only")
            assert_equal(serve(orders), "db 7", reason="Db and Clock")
            assert_equal(serve(plain), "plain", reason="the empty row")
            assert_equal(serve_all([health, orders, plain]), "ok 7;db 7;plain;", reason="a list of handlers")
