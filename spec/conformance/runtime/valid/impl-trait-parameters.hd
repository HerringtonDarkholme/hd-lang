# test: argument-position impl Trait is an anonymous generic, each occurrence is distinct, and written generics remain explicit
# expect-stdout: 6

trait Number:
    fn number(&self) -> i32

struct First:
    value: i32

struct Second:
    value: i32

struct Third:
    value: i32

impl Number for First:
    fn number(&self) -> i32:
        self.value

impl Number for Second:
    fn number(&self) -> i32:
        self.value

impl Number for Third:
    fn number(&self) -> i32:
        self.value

fn sum[T < Number](first: T, second: impl Number, third: impl Number) -> i32:
    first.number() + second.number() + third.number()

pub fn main() -> void $ Console:
    total := sum::[First](First { value: +1 }, Second { value: +2 }, Third { value: +3 })
    println(total.to_string())
