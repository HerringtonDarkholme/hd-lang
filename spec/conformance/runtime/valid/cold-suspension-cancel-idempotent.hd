# test: cold suspension cancellation is synchronous and idempotent

use std.testing.assert_equal

fn ready!() -> i32: 42
fn main() -> i32:
    let pending: mut Suspend[i32] = ready()
    pending.cancel()
    pending.cancel()
    42

test "main returns 42":
    assert_equal(main(), 42, reason="cold suspension cancellation is synchronous and idempotent")
