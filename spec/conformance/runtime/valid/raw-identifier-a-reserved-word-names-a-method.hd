# test: a reserved word names a method
# Spec lang/01-lexical-structure.md: lex.raw.not-reserved.
# expect-stdout: true
# expect-stdout: false

struct Token:
    text: string

impl Token:
    fn `match`(self, other: string) -> bool: self.text == other

pub fn main() -> void $ Console:
    token := Token { text: "a" }
    println(token.`match`("a"))
    println(token.`match`("b"))
