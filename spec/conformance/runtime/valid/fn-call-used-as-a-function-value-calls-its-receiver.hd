# test: Fn.call used as a function value calls its receiver
# expect-stdout: 7 8
# expect-stdout: 11
use std.function.{Fn, FnMut}

fn inc(x: i32) -> i32: x + 1

pub fn main() -> void $ Console:
    let call: fn(&(fn(i32) -> i32), (i32,)) -> i32 = Fn::call
    f := inc
    let mut g = fn(x: i32) -> i32: x + 2
    let call_mut: fn(&mut (fn(i32) -> i32), (i32,)) -> i32 = FnMut::call_mut
    println("${call(&f, (+6,))} ${call_mut(&mut g, (+6,))}")
    calls := [call]
    println(calls[0](&f, (+10,)))
