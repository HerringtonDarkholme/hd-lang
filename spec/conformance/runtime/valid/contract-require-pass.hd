# test: require returns for a true condition that reads a capture, and evaluates it exactly once
# expect: test
use std.contract.require

struct Calls:
    n: i32

pub fn main() -> void:
    let limit = +3
    let calls: *mut Calls = box(Calls { n: +0 })
    require(
        condition=fn():
            calls.n = calls.n + 1
            limit == 3
        ,
    )
    if calls.n != 1:
        panic("require evaluated its condition more than once")
