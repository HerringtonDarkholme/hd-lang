# test: a list passed by value is the callee's own copy, so a change through a &mut reference sharing the caller's list is not seen by the callee
# Spec 04 Collection Values: types.coll.value.
# expect: test
fn len_after(items: List[i32], change: fn() -> void) -> usize:
    change()
    items.len()

fn view_len_after(view: &mut List[i32], change: fn() -> void) -> usize:
    len_after(*view, change)

tests:
    use std.testing.assert_equal

    it("a push through a reference to the argument's list is not seen by the callee"):
        let mut items = [+1]
        alias := &mut items
        assert_equal(
            len_after(items, fn(): alias.push(2)),
            1,
            reason="the parameter is the list as passed",
        )
        assert_equal(items.len(), 2, reason="the reference shares the caller's list")

    it("a list read through a reference and passed by value is copied"):
        view := &mut [+1]
        assert_equal(
            len_after(*view, fn(): view.push(2)),
            1,
            reason="the parameter is the list as passed",
        )
        assert_equal(view.len(), 2, reason="the referenced list grew")

    it("a &mut parameter passed on by value is copied"):
        let mut items = [+1]
        assert_equal(
            view_len_after(&mut items, fn(): items.push(2)),
            1,
            reason="the parameter is the list as passed",
        )
