# test: closures / nested captures

use std.testing.assert_equal

fn main() -> i32:
    base := 40
    make := fn(delta: i32) -> fn(i32) -> i32:
        fn(value: i32) -> i32: base + delta + value
    add := make(1)
    add(1)

test "main returns 42":
    assert_equal(main(), 42, reason="closures / nested captures")
