# test: dbg needs no requirement and prints any value
# Spec 10 Debug Printing: module.dbg.no-requirement, module.dbg.value.no-bound.
# Account implements no Debug, and dbg shows its private field; what dbg
# prints is not judged.
use std.testing.assert_equal

data Account:
    owner: string
    balance: i32

fn total(prices: List[i32]) -> i32:
    let sum = +0
    for price in prices:
        sum = sum + price
        dbg(sum)
    sum

fn audit(account: Account) -> string:
    dbg(account)
    account.owner

fn first[T](items: List[T]) -> T:
    dbg(items[0])
    items[0]

tests:
    it("dbg works in a pure function, generic code, and a unit test"):
        assert_equal(total([1, 2, 3]), 6, reason="dbg changes no sum")
        assert_equal(audit(Account { owner: "Ada", balance: 120 }), "Ada", reason="dbg changes no account")
        assert_equal(first(["a", "b"]), "a", reason="dbg prints a T")
        dbg(1, "two", [3])
