# test: a disjoint pointer slot may be replaced beside a live path loan, and a guarded slot may be replaced after the loan's last use
# Spec 13 Conflicts Through Aliases: ref.excl.alias.path-pointer, ref.excl.place.
struct User:
    name: string

struct Team:
    lead: *mut User
    spare: *mut User

fn replace(t: *mut Team, alias: *mut Team) -> string:
    name := &t.lead.name
    alias.spare = box(User { name: "new spare" })
    old := *name
    alias.lead = box(User { name: "new lead" })
    old

pub fn main() -> void:
    t := box(Team {
        lead: box(User { name: "old" }),
        spare: box(User { name: "spare" }),
    })
    if replace(t, t) != "old" || t.lead.name != "new lead":
        panic("wrong replacement result")
