# test: deep_equal compares lists, maps, optionals and tuples member by member, and references through them
# Spec std/cmp Deep Equality: std-cmp.deep-equal.leaves, std-cmp.deep-equal.containers.
# expect-stdout: true false
# expect-stdout: true false
use std.cmp.{DeepEq, deep_equal}

@derive(DeepEq)
enum Tree:
    Leaf(value: i32)
    Pair(left: *Tree, right: *Tree)

pub fn main() -> void $ Console:
    a := [Tree.Leaf(+1), Tree.Pair(box(Tree.Leaf(+2)), box(Tree.Leaf(+3)))]
    b := [Tree.Leaf(+1), Tree.Pair(box(Tree.Leaf(+2)), box(Tree.Leaf(+3)))]
    c := [Tree.Leaf(+1), Tree.Pair(box(Tree.Leaf(+2)), box(Tree.Leaf(+4)))]
    println("${deep_equal(a, b)} ${deep_equal(a, c)}")
    m := { "x": (+1, "one"), "y": (+2, "two") }
    n := { "y": (+2, "two"), "x": (+1, "one") }
    let o: (i32, string)? = .None
    println("${deep_equal(m, n)} ${deep_equal(o, .Some((+1, "one")))}")
