# test: a trait borrow loads both words from a field
# Spec lang/13-values-and-references.md: ref.match.borrow; ref.expr.place.
# expect-stdout: 42
trait Reader:
    fn read(&self) -> i32

struct Value:
    number: i32

impl Reader for Value:
    fn read(&self) -> i32:
        self.number

struct Holder:
    value: *dyn Reader

fn read(holder: &mut Holder) -> i32:
    let borrowed: &dyn Reader = &*holder.value
    borrowed.read()

pub fn main() -> void $ Console:
    let mut holder = Holder { value: box(Value { number: +42 }) }
    println(read(&mut holder))
