# test: every range form slices a string
# expect-stdout: el
# expect-stdout: ell
# expect-stdout: llo
# expect-stdout: he
# expect-stdout: hel
# expect-stdout: hello
# expect-stdout: 0
pub fn main() -> void $ Console:
    text := "hello"
    println(text[1..3])
    println(text[1..=3])
    println(text[2..])
    println(text[..2])
    println(text[..=2])
    println(text[..])
    println(text[2..2].len())
