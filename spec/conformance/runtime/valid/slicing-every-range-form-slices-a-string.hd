# test: every range form slices a string
# expect-stdout: el
# expect-stdout: ell
# expect-stdout: llo
# expect-stdout: he
# expect-stdout: hel
# expect-stdout: hello
# expect-stdout: 0
pub fn main() -> void $ Console:
    text := "hello"
    println(text.slice(1, 3))
    println(text.slice(1, 4))
    println(text.slice(2, text.len()))
    println(text.slice(0, 2))
    println(text.slice(0, 3))
    println(text.slice(0, text.len()))
    println(text.slice(2, 2).len())
