# test: map grow and remove
# Spec 04 Map Semantics: types.map.order.deterministic,
# types.map.replace.in-place, types.map.semantics, types.map.key-view,
# types.map.no-reindex, types.map.stale, types.map.no-repair.

fn main() -> i32:
    let values: mut Map[string, i32] = {}
    values["a"] = 1
    values["b"] = 2
    values["c"] = 3
    values["d"] = 4
    values["e"] = 5
    values["f"] = 27
    removed := match values.remove(key="c"):
        .Some(value) => value
        .None => 0
    missing := match values.get("c"):
        .Some(value) => value
        .None => 0
    let remaining = +0
    for (key, value) in values:
        _ := key
        remaining = remaining + value
    removed + missing + remaining

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="map grow and remove")
