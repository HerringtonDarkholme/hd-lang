# test: heterogeneous tuples

fn load!() -> i32: 36
fn pair[T](left: T, right: i32) -> (T, i32): (left, right)

fn main!() -> i32:
    let (loaded, text) = (load!(), "a")
    nested := ((+1, 2),)
    single := (+1,)
    generic := pair("value", 1)
    let (first, second): (i32, i32) = (1, 2)
    first = 2
    if text != "a":
        return 0
    loaded + 1 + nested._0._0 + single._0 + generic._1 + first + second - second

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main!(), 42, reason="heterogeneous tuples")
