# test: an index read reaches index
# Spec lang/10-modules.md: module.init.definite.implicit.
# expect-stdout: 8

struct Tag:
    n: i32
use std.ops.Index

later := +5

impl Index[i32] for Tag:
    type Out = i32
    fn index(self, key: i32) -> i32:
        self.n + key + later

first := Tag { n: 1 }[2]

pub fn main() -> void $ Console:
    println(first)
