# test: read-only closures run through Fn bounds while FnMut closures change their captures
# expect: test
use std.function.{Fn, FnMut}

fn count_where[F < Fn(i32) -> bool](items: List[i32], keep: F) -> usize:
    let n: usize = 0
    for item in items:
        if keep(item):
            n += 1
    n

fn each[F < FnMut(i32) -> void](items: List[i32], mut f: F) -> void:
    for item in items:
        f(item)

fn positive(x: i32) -> bool:
    x > 0

tests:
    use std.testing.assert_equal

    it("reads captures through Fn and changes them through FnMut"):
        let limit = +2
        items := [+1, +2, +3, -4]
        assert_equal(count_where(items, fn(x): x > limit), 1)
        assert_equal(count_where(items, positive), 3)
        let sum = +0
        each(items, fn(x): sum += x)
        assert_equal(sum, 2)
        limit = sum - 1
        assert_equal(count_where(items, fn(x): x > limit), 2)
