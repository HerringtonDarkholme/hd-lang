# expect-stdout: run body, stopper finished, supervise defer, runner defer
# expect-stdout: abandoned
# expect-stdout: run body, stopper finished, waiter defer, supervise defer, runner defer
# expect-stdout: abandoned
# test: awaiting a pending host call that another task cancelled cancels the awaiter, as an all! child and through a bang call of the stored call
# Spec lang/11 Cancellation: req.cancel.await, req.cancel.await.kinds, req.cancel.await.dispose.
use std.ops.Disposable
use std.task.all
use std.time.{Clock, ms, s, sleep}

struct Runner:
    log: *mut List[string]
    job: mut Suspend[string]

impl Disposable for Runner:
    fn dispose!(&mut self) -> void:
        defer: self.log.push("runner defer")
        let mut job = self.job
        value := job!()
        self.log.push("runner got ${value}")

fn run!(log: *mut List[string], job: mut Suspend[string]) -> void:
    using runner = &mut Runner { log: log, job: job }
    log.push("run body")

fn ended!(job: mut Suspend[void]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn stop_later!(call: mut Suspend[void], log: &mut List[string]) -> void $ Clock:
    sleep!(ms(1))
    match call.cancel!():
        .Finished => log.push("stopper finished")
        .Abandoned => log.push("stopper abandoned")

fn waiter!(call: mut Suspend[void], log: &mut List[string]) -> void:
    defer: log.push("waiter defer")
    call!()
    log.push("waiter never")

fn supervise!(call: mut Suspend[void], log: &mut List[string]) -> string $ Clock:
    defer: log.push("supervise defer")
    _ := all!(call, stop_later(call, log))
    "supervise never"

fn supervise_waiter!(call: mut Suspend[void], log: &mut List[string]) -> string $ Clock:
    defer: log.push("supervise defer")
    _ := all!(waiter(call, log), stop_later(call, log))
    "supervise never"

pub fn main!() -> void $ Console + Clock:
    let mut clock = $.use(Clock)
    let mut log: List[string] = []
    let runner: mut Suspend[void] = run(&mut log, supervise(clock.sleep(s(60)), &mut log))
    runner!()
    println(log.join(", "))
    println(ended!(runner))
    let mut other: List[string] = []
    let second: mut Suspend[void] = run(&mut other, supervise_waiter(clock.sleep(s(60)), &mut other))
    second!()
    println(other.join(", "))
    println(ended!(second))
