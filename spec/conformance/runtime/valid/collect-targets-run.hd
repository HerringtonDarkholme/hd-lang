# test: a Map target keeps the last value of an equal key at its first position; Result and optional targets stop at the first failure
# Spec 06 Collect Targets: flow.collect.map, flow.collect.result, flow.collect.option, flow.collect.drain, flow.collect.stop (Collect CO1, CO2).
use std.testing.assert_equal

fn parse_digit(text: string) -> Result[i32, string]:
    if text == "x":
        return .Err("bad")
    .Ok(text.len())

fn find(text: string) -> i32?:
    if text == "x":
        return .None
    .Some(text.len())

tests:
    it("the last value of an equal key wins, at the key's first position"):
        let entries: Map[string, i32] = [("a", 1), ("b", 2), ("a", 3)].iter().collect()
        assert_equal([for key, value in entries => "$key=$value"], ["a=3", "b=2"], reason="last value, first position")

    it("a Result target stops at the first error"):
        let mut source = ["1", "x", "22", "333"].iter()
        let parsed: Result[List[i32], string] = source.map(parse_digit).collect()
        assert_equal(parsed, .Err("bad"), reason="first error")
        assert_equal(source.collect().len(), 2, reason="the rest is unread")

    it("a Result target collects every Ok payload"):
        let parsed: Result[List[i32], string] = ["1", "22"].iter().map(parse_digit).collect()
        assert_equal(parsed, .Ok([1, 2]), reason="all payloads")

    it("an optional target stops at the first None"):
        let found: List[i32]? = ["a", "x", "b"].iter().map(find).collect()
        assert_equal(found, .None, reason="first None")
        let all: List[i32]? = ["a", "bb"].iter().map(find).collect()
        assert_equal(all, .Some([1, 2]), reason="all values")

    it("a List target drains the source"):
        let mut source = [1, 2, 3].iter()
        copied := source.collect()
        assert_equal(copied, [1, 2, 3], reason="in order")
        assert_equal(source.collect().len(), 0, reason="exhausted")
