# test: pointer loans: a `&` to a field of a struct field behind a `*T`, held across a statement; an alias drops the last other pointer to the object; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Inner:
    value: string

struct Outer:
    inner: Inner
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { inner: Inner { value: orig() }, other: second() })

struct Holder:
    child: *mut Outer

fn probe(p: *mut Outer, holder: *mut Holder) -> string:
    r := &p.inner.value
    holder.child = make()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    holder := box(Holder { child: make() })
    seen := probe(holder.child, holder)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
