tests:
    use std.testing.assert_equal

    it("equal present optionals pass assert_equal"):
        let left: i32? = 42
        let right: i32? = 42
        assert_equal(left, right, reason="present payloads are equal")

    it("absent optionals pass assert_equal"):
        let left: string? = .None
        let right: string? = .None
        assert_equal(left, right, reason=".None equals .None")
