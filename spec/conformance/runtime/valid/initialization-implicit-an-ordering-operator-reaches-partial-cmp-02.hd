# test: an ordering operator reaches partial cmp
# Spec lang/10-modules.md: module.init.definite.implicit.
# expect-stdout: false

struct Tag:
    n: i32

later := +5

impl Eq for Tag:
    fn eq(self, other: Tag) -> bool: true

impl PartialOrd for Tag:
    fn partial_cmp(self, other: Tag) -> Ordering?: (self.n + later).partial_cmp(other.n)

first := Tag { n: 1 } < Tag { n: 2 }

pub fn main() -> void $ Console:
    println(first)
