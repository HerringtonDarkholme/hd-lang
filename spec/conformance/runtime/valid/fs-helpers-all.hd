# test: every FsRead and FsWrite method has a free bang helper over the covering provider
# Spec std/fs File Helpers: std-fs.helper.read-bytes, std-fs.helper.list-dir,
# std-fs.helper.stat, std-fs.helper.write-bytes,
# std-fs.helper.append-text, std-fs.helper.create-dir-all,
# std-fs.helper.remove, std-fs.helper.rename, and std-fs.helper.row.
# expect: test
use std.fs.{Entry, EntryKind, FsError, FsRead, FsWrite, MemoryFs}
use std.fs.{
    append_text,
    create_dir_all,
    list_dir,
    read_bytes,
    read_text,
    remove,
    rename,
    stat,
    write_bytes,
    write_text,
}
use std.path.Path

fn log_twice!(path: Path) -> Result[string, FsError] $ FsRead + FsWrite:
    append_text!(path, "a\n")?
    append_text!(path, "b\n")?
    read_text!(path)

fn probe!(path: Path) -> Result[bool, FsError] $ FsRead:
    .Ok(stat!(path)?.is_some())

tests:
    use std.testing.assert_equal

    it("append_text! creates the file, then adds to it"):
        let mut files = MemoryFs::new()
        $.with(FsRead=files, FsWrite=files):
            assert_equal(log_twice!(Path("log.txt")), .Ok("a\nb\n"), reason="two appends")

    it("write_bytes! and read_bytes! round-trip"):
        let mut files = MemoryFs::new()
        $.with(FsRead=files, FsWrite=files):
            assert_equal(write_bytes!(Path("blob"), [1, 2, 3]), .Ok(()), reason="written")
            assert_equal(read_bytes!(Path("blob")), .Ok([1, 2, 3]), reason="read back")

    it("stat! tells a file from nothing"):
        let mut files = MemoryFs::new()
        $.with(FsRead=files, FsWrite=files):
            assert_equal(write_text!(Path("a.txt"), "tea"), .Ok(()), reason="seeded")
            assert_equal(stat!(Path("b.txt")), .Ok(.None), reason="missing is not an error")
            assert_equal(
                stat!(Path("a.txt")),
                .Ok(.Some(Entry { path: Path("a.txt"), kind: EntryKind.File, size: 3 })),
                reason="a file of 3 bytes",
            )
            assert_equal(probe!(Path("a.txt")), .Ok(true), reason="a row of FsRead alone")

    it("stat! is .None below a file"):
        let mut files = MemoryFs::new()
        $.with(FsRead=files, FsWrite=files):
            assert_equal(write_text!(Path("f"), "x"), .Ok(()), reason="seeded")
            assert_equal(stat!(Path("f/g")), .Ok(.None), reason="below a file is just missing")

    it("create_dir_all!, list_dir!, rename! and remove! change and show the tree"):
        let mut files = MemoryFs::new()
        $.with(FsRead=files, FsWrite=files):
            assert_equal(create_dir_all!(Path("d/sub")), .Ok(()), reason="made")
            assert_equal(write_text!(Path("d/b.txt"), "b"), .Ok(()), reason="seeded")
            assert_equal(write_text!(Path("d/a.txt"), "a"), .Ok(()), reason="seeded")
            names := list_dir!(Path("d"))
                .unwrap_or([])
                .map(fn(entry: Entry) -> string: "${entry.path}")
            assert_equal(names, ["d/a.txt", "d/b.txt", "d/sub"], reason="ordered by path text")
            assert_equal(rename!(Path("d/a.txt"), Path("d/c.txt")), .Ok(()), reason="renamed")
            assert_equal(stat!(Path("d/a.txt")), .Ok(.None), reason="old name gone")
            assert_equal(remove!(Path("d/c.txt")), .Ok(()), reason="removed")
            assert_equal(stat!(Path("d/c.txt")), .Ok(.None), reason="file gone")
            assert_equal(
                remove!(Path("nothing")),
                .Err(FsError.NotFound(path=Path("nothing"))),
                reason="a missing path",
            )
