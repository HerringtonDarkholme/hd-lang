# expect-stdout: won won
# expect-stdout: closing, closed, stopper defer
# test: cancelling a task that waits in cancel!() stops only its wait: the cleanup goes on inside that task's own cleanup, which ends after it
# Spec lang/11 Cancellation: req.cancel.nested.
use std.ops.Disposable
use std.task.{all, race}
use std.time.{Clock, ms, s, sleep}

data Conn:
    log: mut List[string]
    closing: mut Suspend[void]

impl Disposable for Conn:
    fn dispose!(mut self) -> void:
        self.log.push("closing")
        let mut wait = self.closing
        wait!()
        self.log.push("closed")

fn session!(log: mut List[string]) -> string $ Clock:
    using conn = Conn { log: log, closing: sleep(ms(2)) }
    sleep!(s(60))
    "late"

fn ready!() -> string:
    "won"

fn stopper!(job: mut Suspend[string], log: mut List[string]) -> string:
    defer: log.push("stopper defer")
    _ := job.cancel!()
    log.push("stopper resumed")
    "stopper"

pub fn main!() -> void $ Console + Clock:
    let log: mut List[string] = []
    let job: mut Suspend[string] = session(log)
    let (first, second) = all!(race(job, ready()), race(stopper(job, log), ready()))
    println("${first} ${second}")
    println(log.join(", "))
