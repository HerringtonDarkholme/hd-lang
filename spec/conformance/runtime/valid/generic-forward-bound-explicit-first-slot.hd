# test: an explicit list of one argument binds S, and the later U is then inferred through S's bound
# Spec Type System, Bound Order: types.generic.bound.any-order; Inference Through A Bound: types.generic.infer.bound.one.
use std.testing.assert_equal

trait Source[T]:
    fn take(self) -> T

data Fixed:
    text: string

impl Source[string] for Fixed:
    fn take(self) -> string:
        self.text

fn read[S < Source[U], U = string](s: S) -> U:
    s.take()

tests:
    it("read::[Fixed] binds S"):
        x := Fixed { text: "fixed" }
        assert_equal(read::[Fixed](x), "fixed", reason="U comes from Fixed's one Source")
