# test: message(text) explicitly turns text into an Error value
# Spec std/error Standard Error Types: std-error.std-types.string-message.
use std.error.{Error, message, report_of}

fn describe[E < Error](error: E) -> string:
    error.to_string()

fn fail(text: string) -> Result[void, &dyn Error]:
    .Err(message(text))

tests:
    use std.testing.assert_equal

    it("an explicit message satisfies an Error bound"):
        assert_equal(describe(message("disk full")), "disk full", reason="the text is the message")

    it("a dyn Error holds an explicit message"):
        match fail("disk full"):
            .Ok(_) => assert_equal(true, false, reason="expected an error")
            .Err(error) =>
                assert_equal(error.to_string(), "disk full", reason="displays as the text")
                assert_equal(report_of(error).causes.len(), 0, reason="no cause")

    it("context accepts an explicit message error"):
        let failed: Result[i32, &dyn Error] = .Err(message("disk full"))
        match failed.context("saving"):
            .Ok(_) => assert_equal(true, false, reason="expected an error")
            .Err(error) =>
                assert_equal(report_of(error).to_string(), "saving\ncaused by: disk full", reason="the explicit message is the cause")

    it("ordinary string-valued Result errors remain values"):
        let failed: Result[i32, string] = .Err("plain text")
        assert_equal(failed, .Err("plain text"), reason="Result imposes no Error bound")
