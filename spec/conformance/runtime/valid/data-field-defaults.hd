# test: data field defaults run per construction after explicit fields

use std.testing.assert_equal

fn default_name() -> string: "anonymous"

data User:
    id: i32
    name: string = default_name()
    active: bool = true

fn main() -> i32:
    first := User { id: 1 }
    second := User { active: false, name: "Ada", id: 2 }
    if first.name == "anonymous" and first.active and second.name == "Ada" and not second.active:
        first.id * 10 + second.id
    else:
        0

test "main returns 12":
    assert_equal(main(), 12, reason="data field defaults run per construction after explicit fields")
