# test: mutable list and map roots support indexed replacement

fn main() -> i32:
    let values: mut List[i32] = [1, 2]
    let scores: mut Map[string, i32] = {"x": 1}
    values[0] = 40
    scores["x"] = 2
    score := match scores.get("x"):
        .Some(found) => found
        .None => 0
    values[0] + score

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="mutable list and map roots support indexed replacement")
