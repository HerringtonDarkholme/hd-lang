# test: copy update skips defaults
# Spec 08 Copy-Update Literals: data.update.supplies-all, data.update.no-defaults.

data Counter:
    value: i32 = panic("copy-update evaluated a default")

fn main() -> i32:
    original := Counter { value: 42 }
    copied := Counter { ...original }
    copied.value

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="copy update skips defaults")
