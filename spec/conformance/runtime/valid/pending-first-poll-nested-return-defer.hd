# fixture-runtime-profile: tick
# fixture-runtime-scenario: pending-first-poll
# test: a nested return after a pending host call completes the frame and runs defer once
use std.testing.assert_equal

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct State:
    count: i32

fn child!() -> i32 $ Console + Tick:
    let mut console = $.use(Console)
    $.use(Tick).tick!("child\n")
    _ := console.write_sync("child\n")
    40

fn run!(state: &mut State) -> i32 $ Console + Tick:
    defer:
        state.count = state.count + 1
    value := child!()
    if value == 40:
        return value + 2
    0

pub fn main!() -> void $ Console + Tick:
    let mut state = State { count: 0 }
    result := run!(&mut state)
    assert_equal(result, 42, reason="the nested return gives the result")
    assert_equal(state.count, 1, reason="defer ran once")
