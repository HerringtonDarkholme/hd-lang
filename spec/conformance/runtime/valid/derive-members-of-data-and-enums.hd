# test: derivation members are the fields in order with embedded fields, unnamed payloads as _0 and _1, no shared data, and a newtype through its base
# Spec 08 Typed Derivation Of Data And Enums: data.derive.members, data.derive.payload-names, data.derive.shared, data.derive.newtype.
use std.serde.{Serialize, Serializer}
use std.structure.{Facts, VariantInfo, Member}
use std.testing.assert_equal

# Records every serializer call so a test can read the member sequence.
data Log:
    pub text: string

impl Log:
    fn add(mut self, word: string) -> Result[void, never]:
        if self.text == "":
            self.text = word
        else:
            self.text = self.text + " " + word
        .Ok(())

impl Serializer for Log:
    type Error = never

    fn null(mut self) -> Result[void, never]:
        self.add("null")

    fn bool(mut self, value: bool) -> Result[void, never]:
        self.add("$value")

    fn int(mut self, value: i64) -> Result[void, never]:
        self.add("$value")

    fn uint(mut self, value: u64) -> Result[void, never]:
        self.add("$value")

    fn float(mut self, value: f64) -> Result[void, never]:
        self.add("$value")

    fn text(mut self, value: string) -> Result[void, never]:
        self.add(value)

    fn begin_list(mut self, len: usize) -> Result[void, never]:
        self.add("[")

    fn end_list(mut self) -> Result[void, never]:
        self.add("]")

    fn begin_map(mut self, len: usize) -> Result[void, never]:
        self.add("{")

    fn key(mut self, key: string) -> Result[void, never]:
        self.add("$key=")

    fn end_map(mut self) -> Result[void, never]:
        self.add("}")

    fn begin_variant(mut self, facts: Facts, v: VariantInfo) -> Result[void, never]:
        self.add("<${v.name}>")

    fn member(mut self, m: Member) -> Result[void, never]:
        self.add("${m.name}@${m.position}:")

    fn end_variant(mut self) -> Result[void, never]:
        self.add("</>")

fn send[T < Serialize](value: T) -> string:
    let out: mut Log = Log { text: "" }
    _ := value.serialize(out)
    out.text

@derive(Serialize)
data Stamp:
    at: i32

@derive(Serialize)
data Post:
    Stamp
    id: string
    views: i32

@derive(Serialize)
enum Shipment(days: i32):
    Packed -> Shipment(1)
    Sent(string, tracking: string) -> Shipment(3)
    Lost(string, string) -> Shipment(0)

@derive(Serialize)
type Mile(i32)

tests:
    it("a data type's members are its fields in declaration order, an embedded field first"):
        post := Post { Stamp: ...Stamp { at: 7 }, id: "p1", views: 3 }
        assert_equal(send(post), "<Post> Stamp@0: <Stamp> at@0: 7 </> id@1: p1 views@2: 3 </>", reason="embedded field is member 0")

    it("an unnamed payload parameter is _0, _1 by position, beside a named one"):
        assert_equal(send(Shipment.Sent("DHL", tracking="JD01")), "<Sent> _0@0: DHL tracking@1: JD01 </>", reason="_0 then tracking")
        assert_equal(send(Shipment.Lost("DHL", "JD02")), "<Lost> _0@0: DHL _1@1: JD02 </>", reason="_0 then _1")

    it("shared constructor data is not a member"):
        assert_equal(send(Shipment.Packed), "<Packed> </>", reason="no days member")
        assert_equal(Shipment.Packed.days, 1, reason="the data is still readable on the value")

    it("a newtype serializes as its base type"):
        assert_equal(send(Mile(5)), "5", reason="the base value, with no variant")
