# test: erased call matrix closure-ref-ref-string
# expect: test
# Generated by spec/tools/generate-erased-call-matrix.ts; edit the generator.
# Rules: trait.dyn.safe.method-type-param, ref.generic.local.
impl Item for string:
    fn value(&self) -> usize:
        self.len()
    fn bump(&mut self) -> void:
        *self = *self + "!"

fn make(round: usize) -> string:
    "word_$round"

trait Item < ?Copy:
    fn value(&self) -> usize
    fn bump(&mut self) -> void

trait Driver:
    fn run[T < ?Copy & Item](&self, value: &T) -> usize

struct Worker:
    calls: usize

impl Driver for Worker:
    fn run[T < ?Copy & Item](&self, value: &T) -> usize:
        apply := fn(value: &T) -> usize: value.value()
        apply(value)

tests:
    it("closure-ref-ref-string preserves its argument and receiver"):
        for round in 0..8:
            let mut worker = Worker { calls: 0 }
            let mut item: string = make(round)
            before := item.value()
            let driver: &dyn Driver = &worker
            result := driver.run(&item)
            assert_equal(result, before, reason="the erased call returns the value")
            assert_equal(item.value(), before, reason="the caller observes the borrow")
            assert_equal(worker.calls, 0, reason="receiver effects reach the caller")
