# test: a value of a mut-bounded type parameter has mutable access, so it may be passed on to another mut bound, and the caller sees the mutation
# Spec 04 Mutation Checks: types.path.access.mut-bound; Spec 09 Generic Bounds: trait.bound.mut, trait.bound.mut-any.
use std.testing.assert_equal

trait Clear:
    fn clear(mut self) -> void

data Counter:
    value: i32

impl Clear for Counter:
    fn clear(mut self) -> void:
        self.value = 0

fn clear_inner[U < mut Clear](inner: U) -> void:
    inner.clear()

fn clear_outer[T < mut Clear](outer: T) -> void:
    clear_inner(outer)

fn keep_inner[U < mut Any](inner: U) -> void:
    pass

fn clear_any[T < mut Clear & Any](value: T) -> void:
    keep_inner(value)
    value.clear()

tests:
    it("a mut Clear value is cleared two levels down"):
        let mut counter = Counter { value: 42 }
        clear_outer(counter)
        assert_equal(counter.value, 0, reason="clear_inner mutates the caller's counter")

    it("a mut Any bound gives mutable access to a Clear value"):
        let mut counter = Counter { value: 7 }
        clear_any(counter)
        assert_equal(counter.value, 0, reason="clear_any mutates the caller's counter")
