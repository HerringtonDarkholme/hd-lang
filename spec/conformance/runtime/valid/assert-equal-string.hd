use std.testing.assert_equal

tests:
    it("equal string values pass assert_equal"):
        assert_equal("ada", "ada", reason="identical literals are equal")
        assert_equal("", "", reason="empty strings are equal")

    it("equal strings from different sources pass assert_equal"):
        assert_equal("  ada  ".slice(2, 5), "ada", reason="sliced text equals the literal")
        assert_equal("ad" + "a", "ada", reason="concatenated text equals the literal")
