# test: && and || combine bools, prefix ! negates, and != stays one token
fn fetch!(id: i32) -> bool: id > 0

fn missing!(id: i32) -> bool:
    !fetch!(id)

fn pick(a: bool, b: bool, c: bool) -> bool:
    a && !b || c

tests:
    use std.testing.assert

    it("prefix ! negates a bool"):
        ready := false
        assert(!ready, reason="!false is true")
        assert(!(1 > 2), reason="! applies to a grouped comparison")

    it("prefix ! binds tighter than &&, and && binds tighter than ||"):
        assert(pick(true, false, false), reason="true && !false")
        assert(!pick(true, true, false), reason="(true && !true) || false is false")
        assert(pick(false, true, true), reason="(false && !true) || true is true")

    it("prefix ! applies to a bang call"):
        assert(missing!(0), reason="!fetch!(0) is true")
        assert(!missing!(3), reason="!fetch!(3) is false")

    it("!= is one token after a name"):
        f := 1
        g := 2
        assert(f!=g, reason="f!=g lexes as f != g")
