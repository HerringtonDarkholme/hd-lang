# test: a literal right operand selects the fitting instantiation
# Spec lang/05-expressions.md: expr.op.primitive.types.
# expect-stdout: 17
# expect-stdout: 15

use std.ops.Add

struct Money:
    cents: i64

impl Add[Money] for Money:
    type Out = Money
    fn add(self, rhs: Money) -> Money:
        Money { cents: self.cents + rhs.cents }

impl Add[i64] for Money:
    type Out = Money
    fn add(self, rhs: i64) -> Money:
        Money { cents: self.cents + rhs }

pub fn main() -> void $ Console:
    let a = Money { cents: 10 }
    println((a + 7).cents)
    println((a + Money { cents: 5 }).cents)
