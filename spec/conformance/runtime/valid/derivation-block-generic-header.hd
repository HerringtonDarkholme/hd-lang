# test: a derivation block may state generic parameters and bounds, and the derived implementation has those bounds
# Spec 14 Derivation Blocks: annot.block.header; the bound T < Shown meets the walker's bound on the member.
use std.structure.{Structure, Field, Variant, Walker}
trait Shown:
    fn shown(self) -> string

impl Shown for i64:
    fn shown(self) -> string:
        "$self"

trait Show:
    fn show(self) -> string

data Shower:
    out: string

impl[S] Walker[S] for Shower:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Shown](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.out = self.out + value.shown() + ";"
        .Ok(())

impl[T] Show for T by Structure:
    fn show(self) -> string:
        let mut w = Shower { out: "" }
        _ := Structure::walk(self, w)
        w.out

data Bag[T]:
    item: T

impl[T < Shown] Show for Bag[T] by Structure

tests:
    use std.testing.assert_equal

    it("derives Show for a Bag of a Shown type"):
        assert_equal(Bag::[i64] { item: 5 }.show(), "5;", reason="the item is walked through its Shown bound")
