# test: find matches recorded concrete types exactly, without choosing a different error type
# Spec std/error Root Cause And Find: std-error.find.concrete-exact (ERR-HELPERS; task #223).
use std.error.Error
@error("disk full")
struct DiskError:
    free: i64

@error
enum SaveError:
    @error("cannot save $path")
    Write(path: string, @source error: DiskError)

@error("other")
struct OtherError:
    code: i64

tests:
    use std.testing.assert

    it("no supertrait search"):
        let failure: *dyn Error = & SaveError.Write("notes.txt", DiskError { free: 0 })
        assert(failure.find::[OtherError]().is_none(), reason="a different concrete error is not in the chain")
