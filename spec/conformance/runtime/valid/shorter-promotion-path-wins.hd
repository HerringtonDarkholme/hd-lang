# test: the shortest embedding path wins over a deeper match
use std.testing.assert_equal

data Near:
    pub name: string

data Far:
    pub name: string

data FarBox:
    Far

data Record:
    Near
    FarBox

tests:
    it("depth one wins over depth two"):
        record := Record { Near: ...Near { name: "near" }, FarBox: ...FarBox { Far: ...Far { name: "far" } } }
        assert_equal(record.name, "near", reason="shorter path wins")
        assert_equal(record.FarBox.name, "far", reason="qualified access reaches the deeper field")
