trait Number:
    fn number(self) -> i32
impl Number for i32:
    fn number(self) -> i32:
        self
impl Number for i32?:
    fn number(self) -> i32:
        match self:
            .Some(value) => value
            .None => +0
# expect-stdout: 3 4
fn mixed(flag: bool) -> (impl Number, i32?):
    if flag:
        return (.Some(+1), .Some(+2))
    (.Some(+3), +4)
pub fn main() -> void $ Console:
    pair := mixed(false)
    value := match pair._1:
        .Some(value) => value
        .None => +0
    println("${pair._0.number()} $value")
