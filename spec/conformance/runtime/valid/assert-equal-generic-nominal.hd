use std.testing.assert_equal

@derive(Debug)
data Point:
    x: i32
    y: i32

impl Eq for Point:
    fn eq(self, other: Self) -> bool:
        self.x == other.x && self.y == other.y

fn expect_same[T < Eq + Debug](actual: T, expected: T) -> void:
    assert_equal(actual, expected, reason="the bounds supply Eq and Debug")

tests:
    it("a generic Eq value instantiated with a nominal type passes"):
        expect_same(Point { x: 1, y: 2 }, Point { x: 1, y: 2 })
