# test: a function with a final vararg, and a value of its rest function type, implement Fn and FnMut for an inputs tuple with a rest element
# expect-stdout: 6 6
# Spec 07: fn.trait.function-values-read-only, fn.trait.mut.function-values, fn.trait.bound-tuple, fn.vararg.type.
use std.function.{Fn, FnMut}

fn total(head: i32, tail...: List[i32]) -> i32:
    let sum = head
    for x in tail:
        sum = sum + x
    sum

fn apply[F < Fn[(i32, List[i32]...), i32, $ ()]](f: F) -> i32:
    f(1, 2, 3)

fn apply_mut[F < FnMut[(i32, List[i32]...), i32, $ ()]](mut f: F) -> i32:
    f(1, 2, 3)

pub fn main() -> void $ Console:
    let typed: fn(i32, List[i32]...) -> i32 = total
    println("${apply(total)} ${apply_mut(typed)}")
