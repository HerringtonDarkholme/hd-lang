# test: a store through v() changes v in place, so a store through a &mut parameter reaches the caller's value
# Spec 05 Callable Values: expr.call.apply.mut-ref, expr.call.apply.write-ref.
use std.ops.{Apply, Update}

struct Cell:
    value: i32

impl Apply for Cell:
    type Out = i32
    fn apply(self) -> i32:
        self.value

impl Update[i32] for Cell:
    fn update(&mut self, value: i32) -> void:
        self.value = value

fn store(cell: &mut Cell, value: i32) -> void:
    cell() = value

tests:
    use std.testing.assert_equal

    it("the caller's cell holds the store"):
        let mut cell = Cell { value: +1 }
        store(&mut cell, +9)
        assert_equal(cell(), +9, reason="the store went through the reference")
