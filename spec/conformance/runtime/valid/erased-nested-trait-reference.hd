# test: an open trait reference preserves its value across a thunk
# expect: test
trait Read < ?Copy:
    fn number(&self) -> usize

impl Read for i32:
    fn number(&self) -> usize:
        usize(*self)

trait Inner[T < ?Copy & Read]:
    fn apply(&self, value: &T) -> usize

struct Hop: pass

impl[T < ?Copy & Read] Inner[T] for Hop:
    fn apply(&self, value: &T) -> usize:
        value.number()

fn forward[T < ?Copy & Read](inner: &dyn Inner[T], value: &T) -> usize:
    inner.apply(value)

trait Outer:
    fn run[T < ?Copy & Read](&self, value: &T) -> usize

struct Worker: pass

impl Outer for Worker:
    fn run[T < ?Copy & Read](&self, value: &T) -> usize:
        hop := Hop {}
        let inner: &dyn Inner[T] = &hop
        direct := inner.apply(value)
        direct + forward(inner, value)

tests:
    it("nested calls preserve the trait reference's payload and table"):
        worker := Worker {}
        let outer: &dyn Outer = &worker
        assert_equal(outer.run(&+7), 14)
        assert_equal(outer.run(&+11), 22)
