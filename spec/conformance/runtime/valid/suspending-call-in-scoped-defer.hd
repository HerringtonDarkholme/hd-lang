# test: suspending call in scoped defer

fn child!() -> i32: 2

fn main!() -> i32:
    if true:
        defer:
            pass
        child!() + 40
    else:
        0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main!(), 42, reason="suspending call in scoped defer")
