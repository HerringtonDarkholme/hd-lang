use std.annotation.cold
use std.collections.UniqList
use std.testing.assert_equal

struct Named:
    text: string

@cold
fn word(i: i32) -> string:
    "held$i"

@cold
fn same[T](value: T) -> T:
    value

@cold
fn keep[T < 'static](value: T) -> fn() -> T:
    fn() -> T: value

@cold
fn make() -> fn(string) -> string:
    fn(value: string) -> string: value

@cold
fn read(value: &string) -> usize:
    value.len()

@cold
fn unique(value: UniqList[i32]) -> UniqList[i32]:
    value

pub fn main() -> void:
    original := word(7)
    assert_equal(same(original), "held7")
    assert_equal(same(+7), 7)
    saved := keep(original)
    assert_equal(saved(), "held7")
    call := make()
    assert_equal(call(original), "held7")
    assert_equal(read(&original), 5)
    shared := box(Named { text: original })
    assert_equal(same(shared).text, "held7")
    assert_equal(keep(shared)().text, "held7")
    assert_equal(keep(+7)(), 7)
    assert_equal(shared.text, "held7")
    let mut items = UniqList::[i32].new()
    items.push(7)
    moved := unique(items)
    assert_equal(moved.len(), 1)
    assert_equal(moved[0], 7)
    assert_equal(original, "held7")
