# test: generic erasure of an existing trait reference preserves its concrete referent
# Spec 09 Erasure To Inspectable: trait.erase.keeps; Trait Value References: trait.dyn.ref.identity.
# expect-stdout: true
# expect-stdout: 3
use std.error.Error
use std.inspect.{Inspectable, TypeId}

@error("inner")
struct UserError:
    count: i32

fn erase[T < Inspectable](value: *T) -> *dyn Inspectable:
    value

pub fn main() -> void $ Console:
    let original: *dyn Error = box(UserError { count: 3 })
    erased := erase(original)
    println(erased.runtime_type() == TypeId::of::[UserError]())
    match erased.downcast_ref::[UserError]():
        .Some(found) => println(found.count)
        .None => println("none")
