# test: elements of a writable list and fields of a writable struct change in place, and a copy taken before is unchanged
# Spec 04 Collection Values: types.coll.element-place, types.coll.nested; Writable Places: types.value.writable-places.
struct Member:
    name: string
    tags: List[string]

struct Team:
    title: string
    members: List[Member]

struct Point:
    x: i32
    y: i32

struct Line:
    from: Point
    label: string

tests:
    use std.testing.assert_equal

    it("a struct field of an element changes in place"):
        let mut team = Team { title: "core", members: [Member { name: "ada", tags: [] }] }
        before := team
        team.members[0].name = "grace"
        team.members[0].tags.push("lead")
        team.members.push(Member { name: "lin", tags: [] })
        assert_equal(team.members[0].name, "grace", reason="the element's field changed")
        assert_equal(team.members[0].tags, ["lead"], reason="the element's list changed")
        assert_equal(team.members.len(), 2, reason="the field's list changed")
        assert_equal(before.members[0].name, "ada", reason="the earlier copy is unchanged")
        assert_equal(before.members[0].tags.len(), 0, reason="its inner list too")

    it("a field of an element's struct field changes in place"):
        let mut lines = [Line { from: Point { x: +1, y: 2 }, label: "a" }, Line { from: Point { x: 3, y: 4 }, label: "b" }]
        before := lines
        lines[1].from.y = 40
        lines[1].label = "c"
        assert_equal(lines[1].from.y, 40, reason="the nested field changed")
        assert_equal(lines[1].from.x, 3, reason="its sibling field is unchanged")
        assert_equal(lines[1].label, "c", reason="the string field changed")
        assert_equal(lines[0].from.y, 2, reason="the other element is unchanged")
        assert_equal(before[1].from.y, 4, reason="the earlier copy is unchanged")
        assert_equal(before[1].label, "b", reason="its string too")

    it("an element of a list of lists changes in place"):
        let mut grid = [[+1, 2], [3]]
        grid[1].push(4)
        grid[0][1] = 20
        assert_equal(grid, [[+1, 20], [3, 4]], reason="each element changed where it is stored")
