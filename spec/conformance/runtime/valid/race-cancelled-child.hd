# expect-stdout: run body, victim defer, victim cancelled, other defer, runner defer
# expect-stdout: abandoned
# test: a race! child that another task cancelled cancels the race! at once, even while another child could still win, and the race! cleans up its other children
# Spec lang/11 Standard Combinators: req.combinator.race-child-cancelled, req.combinator.cancel-order; Cancellation: req.cancel.await.dispose.
use std.ops.Disposable
use std.task.race
use std.time.{Clock, ms, s, sleep}

struct Runner:
    log: &mut List[string]
    job: mut Suspend[string]

impl Disposable for Runner:
    fn dispose!(&mut self) -> void:
        defer: self.log.push("runner defer")
        let mut job = self.job
        value := job!()
        self.log.push("runner got ${value}")

fn run!(log: &mut List[string], job: mut Suspend[string]) -> void:
    using runner = &mut Runner { log: log, job: job }
    log.push("run body")

fn ended!(job: mut Suspend[void]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn slow!(log: &mut List[string]) -> string $ Clock:
    defer: log.push("victim defer")
    sleep!(s(60))
    "victim never"

fn winner_later!(victim: mut Suspend[string], log: &mut List[string]) -> string $ Clock:
    defer: log.push("other defer")
    sleep!(ms(1))
    _ := victim.cancel!()
    log.push("victim cancelled")
    sleep!(ms(2))
    "other would win"

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    let victim: mut Suspend[string] = slow(&mut log)
    let runner: mut Suspend[void] = run(&mut log, race(victim, winner_later(victim, &mut log)))
    runner!()
    println(log.join(", "))
    println(ended!(runner))
