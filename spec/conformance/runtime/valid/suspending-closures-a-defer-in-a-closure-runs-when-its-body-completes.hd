# test: a defer in a closure runs when its body completes
# expect-stdout: 1
# expect-stdout: start 1
# expect-stdout: done 1
# expect-stdout: cleanup 1
use std.ops.defer
use std.time.{Clock, Duration, sleep}
use std.task.{all, race}

fn nap!(ms: i64) -> void $ Clock:
    sleep!(Duration::milliseconds(ms))

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    guarded := fn!(n: i32) -> i32 $ Clock:
        log.push("start $n")
        defer(fn() -> void: log.push("cleanup $n"))
        nap!(1)
        log.push("done $n")
        n
    println(guarded!(1))
    for line in log:
        println(line)
