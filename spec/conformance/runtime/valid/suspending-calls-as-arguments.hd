# test: suspending calls as arguments

use std.testing.assert_equal

fn value!(input: i32) -> i32: input
fn add!(left: i32, right: i32) -> i32: left + right

fn main!() -> i32:
    add!(value!(20), value!(22))

test "main returns 42":
    assert_equal(main!(), 42, reason="suspending calls as arguments")
