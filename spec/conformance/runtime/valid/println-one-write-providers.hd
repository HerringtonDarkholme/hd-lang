# test: println converts Display once and delivers each line in one raw chunk.
# Spec 10 Console: module.console.println-one-write-sync.

use std.text.StringBuilder

let conversions: usize = 0
let streamed: usize = 0

struct Label:
    text: string

impl Display for Label:
    fn to_string(&self) -> string:
        conversions = conversions + 1
        self.text

    fn write(&self, out: &mut StringBuilder) -> void:
        streamed = streamed + 1
        out.push(self.text)

struct RecordingConsole:
    chunks: List[string]

impl Console for RecordingConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.chunks.push(text)
        .Ok(())

tests:
    use std.testing.assert_equal

    it("Display runs once before the single raw write"):
        conversions = 0
        streamed = 0
        console := box(RecordingConsole { chunks: [] })
        $.with(Console=console):
            println(Label { text: "hello" })
        assert_equal(conversions, 1, reason="the value is converted once")
        assert_equal(streamed, 0, reason="println uses to_string rather than Display.write")
        assert_equal(console.chunks, ["hello\n"], reason="text and newline share one raw write")

    it("empty values and existing newlines keep one write per call"):
        console := box(RecordingConsole { chunks: [] })
        $.with(Console=console):
            println("")
            println("line\n")
        assert_equal(console.chunks, ["\n", "line\n\n"], reason="raw text is unchanged")
