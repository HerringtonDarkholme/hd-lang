# test: a method reference is a bare pipe step
# Spec 05 Bare Steps: expr.pipe.bare.method-reference (Method References MR4).
use std.testing.assert_equal

data Config:
    size: i32

impl Config:
    fn parse(text: string) -> Config:
        Config { size: text.len() }

    fn doubled(self) -> i32:
        self.size * 2

fn load(raw: string) -> i32:
    raw |> Config::parse |> Config::doubled

tests:
    it("each reference is called with the piped value"):
        assert_equal(load("8080"), 8, reason="parse then doubled")
