# test: requirement row forwarded through calls

use std.testing.assert_equal

fn read() -> i32 $ Clock: 40
fn middle() -> i32 $ Clock: read() + 1
fn run() -> i32 $ Clock: middle() + 1

test "run returns 42 with its providers":
    $.with(Clock=FixedClock {}):
        assert_equal(run(), 42, reason="requirement row forwarded through calls")

trait Clock

data FixedClock: pass

impl Clock for FixedClock
