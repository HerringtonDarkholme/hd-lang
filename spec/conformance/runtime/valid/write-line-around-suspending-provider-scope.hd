# expect-stdout: before
# expect-stdout: 2
# expect-stdout: after

trait Clock

data FixedClock: pass

impl Clock for FixedClock

fn two!() -> i32 $ Clock:
    _ := $.use(Clock)
    2

pub fn main!() -> Result[void, ConsoleError] $ Console:
    let console: mut Console = $.use(Console)
    console.write_line!("before")?
    $.with(Clock=FixedClock {}):
        x := two!()
        console.write_line!("${x}")?
    console.write_line!("after")
