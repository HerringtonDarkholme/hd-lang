# expect-stdout: before
# expect-stdout: 2
# expect-stdout: after

trait Clock

struct FixedClock: pass

impl Clock for FixedClock

fn two!() -> i32 $ Clock:
    _ := $.use(Clock)
    2

pub fn main!() -> Result[void, ConsoleError] $ Console:
    let mut console = $.use(Console)
    console.write!("before\n")?
    $.with(Clock=FixedClock {}):
        x := two!()
        console.write!("${x}\n")?
    console.write!("after\n")
