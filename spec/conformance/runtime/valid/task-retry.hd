# test: retry! calls its attempt until the first .Ok, or returns the last .Err
# Spec std/task Retry: std-task.policy.retry.builder, std-task.policy.retry.loop, and std-task.policy.retry.last-error (owner decision RETRY, batch 29, 2026-09-30).
use std.task.{Backoff, retry, apply}
use std.time.{Clock, ManualClock, Timestamp}
struct Server:
    busy_for: i32
    calls: i32

fn ask!(server: &mut Server) -> Result[string, string]:
    server.calls = server.calls + 1
    if server.busy_for > 0:
        server.busy_for = server.busy_for - 1
        return .Err("busy ${server.calls}")
    .Ok("ready")

fn connect!(server: *mut Server) -> Result[string, string] $ Clock:
    apply!(retry(Backoff { attempts: 3, initial: 0ms })):
        ask!(server)

tests:
    use std.testing.assert_equal

    it("returns the first .Ok without another call"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            let mut server = &mut Server { busy_for: 1, calls: 0 }
            assert_equal(connect!(server), .Ok("ready"), reason="the second call succeeds")
            assert_equal(server.calls, 2, reason="no call after the first .Ok")

    it("returns the last .Err after times calls"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            let mut server = &mut Server { busy_for: 5, calls: 0 }
            assert_equal(connect!(server), .Err("busy 3"), reason="the third error is returned")
            assert_equal(server.calls, 3, reason="three calls in all")
