# test: derived serde and JSON round trips agree with independent bounded text models
# Spec std/json: std-json.derive.from-json.inverse, std-json.display.text,
# std-json.display.escapes, std-json.derive.to-json.data-included-members,
# std-json.derive.to-json.included-enum-form, std-json.decode.direct.
# Spec std/serde: std-serde.std.optional, std-serde.std.list, std-serde.std.map-entries,
# std-serde.std.tuple, std-serde.std.set, std-serde.member-name.precedence,
# std-serde.skip.named-read-default, std-serde.skip.write, std-serde.skip-none.named-omit.
use std.collections.Set
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize, rename, rename_all, skip, skip_none}
use std.testing.{Arbitrary, Choices, assert_equal, it_each, it_prop}
use std.testing.arbitrary

# This oracle visits Unicode scalars and appends strings. It neither calls
# a JSON renderer nor uses the implementation's UTF-8 byte writer.
fn quoted(text: string) -> string:
    digits := "0123456789abcdef"
    let out = "\""
    for character in text.chars():
        if character == '"':
            out += "\\\""
        else if character == '\\':
            out += "\\\\"
        else if character == '\u{8}':
            out += "\\b"
        else if character == '\u{C}':
            out += "\\f"
        else if character == '\n':
            out += "\\n"
        else if character == '\r':
            out += "\\r"
        else if character == '\t':
            out += "\\t"
        else if character < ' ':
            byte := usize(character.to_string()[0])
            out += (
                "\\u00"
                + digits.slice(byte / 16, byte / 16 + 1)
                + digits.slice(byte % 16, byte % 16 + 1)
            )
        else:
            out += character.to_string()
    out + "\""

fn integer(value: i64) -> string:
    digits := "0123456789"
    let rest = value
    let out = ""
    while true:
        remainder := rest % 10
        digit := usize(if remainder < 0: -remainder else: remainder)
        out = digits.slice(digit, digit + 1) + out
        rest /= 10
        if rest == 0:
            return if value < 0: "-" + out else: out

fn boolean(value: bool) -> string:
    if value: "true" else: "false"

fn optional_text(value: string?) -> string:
    match value:
        .None => "null"
        .Some(text) => quoted(text)

fn field(name: string, value: string) -> string:
    quoted(name) + ":" + value

fn list_i16(values: List[i16]) -> string:
    "[" + [for value in values => integer(i64(value))].join(",") + "]"

fn list_bool(values: List[bool]) -> string:
    "[" + [for value in values => boolean(value)].join(",") + "]"

@derive(Serialize, Deserialize, Arbitrary, Debug, Eq)
struct Record:
    id: i32
    name: string
    active: bool
    note: string?
    values: List[i16]
    labels: Map[string, i64]
    pair: (i32, bool)

fn record_text(value: Record) -> string:
    let mut labels: List[string] = []
    for (key, number) in value.labels:
        labels.push(field(key, integer(number)))
    fields := [
        field("id", integer(i64(value.id))),
        field("name", quoted(value.name)),
        field("active", boolean(value.active)),
        field("note", optional_text(value.note)),
        field("values", list_i16(value.values)),
        field("labels", "{" + labels.join(",") + "}"),
        field("pair", "[" + integer(i64(value.pair._0)) + "," + boolean(value.pair._1) + "]"),
    ]
    "{" + fields.join(",") + "}"

@derive(Serialize, Deserialize, Arbitrary, Debug, Eq)
enum Event:
    Empty
    Count(value: i32)
    Pair(i32, string)
    Flags(flags: List[bool], label: string?)

fn event_text(value: Event) -> string:
    match value:
        .Empty => quoted("Empty")
        .Count(count) => "{" + field("Count", "{" + field("value", integer(i64(count))) + "}") + "}"
        .Pair(count, text) =>
            "{" + field("Pair", "[" + integer(i64(count)) + "," + quoted(text) + "]") + "}"
        .Flags(flags, label) =>
            (
                "{"
                + field(
                    "Flags",
                    (
                        "{"
                        + field("flags", list_bool(flags))
                        + ","
                        + field("label", optional_text(label))
                        + "}"
                    ),
                )
                + "}"
            )

@derive(Arbitrary, Debug)
struct OptionalInput:
    value: Record?

@derive(Arbitrary, Debug)
struct ListInput:
    value: List[Record]

@derive(Arbitrary, Debug)
struct MapInput:
    value: Map[string, Record]

@derive(Arbitrary, Debug)
struct TupleInput:
    value: (i32, string, List[bool])

@derive(Arbitrary, Debug)
struct SetInput:
    values: List[i32]

fn cache_default(c: &mut Choices) -> i32:
    7

@derive(Serialize, Deserialize, Arbitrary, Debug, Eq)
@rename_all(.CamelCase)
struct Renamed:
    order_id: i32
    @rename("wire/title~λ")
    user_name: string
    @skip_none()
    optional_label: string?
    @skip()
    @arbitrary.with(cache_default)
    cached: i32 = 7

fn renamed_text(value: Renamed) -> string:
    let mut fields = [
        field("orderId", integer(i64(value.order_id))),
        field("wire/title~λ", quoted(value.user_name)),
    ]
    match value.optional_label:
        .Some(text) => fields.push(field("optionalLabel", quoted(text)))
        .None => pass
    "{" + fields.join(",") + "}"

fn check[T < Serialize & Deserialize & Eq & Debug](value: T, expected: string) -> void:
    text := encode(value)
    assert_equal(text, expected, reason="encoding agrees with the independent text model")
    assert_equal(
        decode::[T](text),
        .Ok(value),
        reason="decoding the encoded value returns the same typed value",
    )
    assert_equal(
        decode::[T](expected),
        .Ok(value),
        reason="decoding the independent text returns the same typed value",
    )

tests:
    it_prop(
        "derived records round trip against a text model",
        cases=100,
        examples=[
            Record {
                id: 0,
                name: "\"\\\u{8}\u{C}\n\r\t\u{0}\u{1F}éλ😀/",
                active: false,
                note: .Some("\"\\\u{0}"),
                values: [i16(-7)],
                labels: { "\"\\\n": -7 },
                pair: (0, true),
            },
        ],
        prop=fn!(value: Record): check(value, record_text(value))
        ,
    )

    it_prop(
        "derived enum variants round trip against an external-tag model",
        cases=100,
        prop=fn!(value: Event): check(value, event_text(value))
        ,
    )

    it_prop(
        "optional derived records round trip",
        cases=100,
        prop=fn!(input: OptionalInput):
            expected := match input.value:
                .None => "null"
                .Some(record) => record_text(record)
            check(input.value, expected)
        ,
    )

    it_prop(
        "lists of derived records round trip",
        cases=100,
        prop=fn!(input: ListInput):
            expected := "[" + [for record in input.value => record_text(record)].join(",") + "]"
            check(input.value, expected)
        ,
    )

    it_prop(
        "maps of derived records round trip in the map's own order",
        cases=100,
        prop=fn!(input: MapInput):
            let mut fields: List[string] = []
            for (key, value) in input.value:
                fields.push(field(key, record_text(value)))
            check(input.value, "{" + fields.join(",") + "}")
        ,
    )

    it_prop(
        "tuples round trip as ordered lists",
        cases=100,
        prop=fn!(input: TupleInput):
            expected := (
                "["
                + integer(i64(input.value._0))
                + ","
                + quoted(input.value._1)
                + ","
                + list_bool(input.value._2)
                + "]"
            )
            check(input.value, expected)
        ,
    )

    it_prop(
        "Sets round trip as distinct list elements",
        cases=100,
        prop=fn!(input: SetInput):
            let mut unique: List[i32] = []
            let mut value: Set[i32] = Set::new()
            for item in input.values:
                _ := value.insert(item)
                if !unique.contains(item):
                    unique.push(item)
            expected := "[" + [for item in unique => integer(i64(item))].join(",") + "]"
            check(value, expected)
        ,
    )

    it_prop(
        "renamed skipped and omitted optional members round trip",
        cases=100,
        prop=fn!(value: Renamed):
            assert_equal(
                value.cached,
                7,
                reason="the arbitrary fact generates the skipped member's declared default",
            )
            check(value, renamed_text(value))
        ,
    )

    it_each(
        "skipped nondefault values normalize to the declared default",
        [
            Renamed {
                order_id: 42,
                user_name: "quote \" slash \\",
                optional_label: .None,
                cached: 99,
            },
            Renamed {
                order_id: -1,
                user_name: "éλ😀",
                optional_label: .Some("\u{0}\n"),
                cached: -1,
            },
        ],
        body=fn!(raw: Renamed):
            expected := Renamed {
                order_id: raw.order_id,
                user_name: raw.user_name,
                optional_label: raw.optional_label,
                cached: 7,
            }
            text := encode(raw)
            assert_equal(
                text,
                renamed_text(raw),
                reason="a skipped value is absent regardless of its in-memory value",
            )
            assert_equal(
                decode::[Renamed](text),
                .Ok(expected),
                reason="only the skipped field normalizes to its declared default",
            )
        ,
    )
