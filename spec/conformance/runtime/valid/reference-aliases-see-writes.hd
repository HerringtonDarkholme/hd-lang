# test: two references to one object, and copies of one reference, see each other's writes; there is no exclusivity check
# Spec 13 Places And New Objects: ref.place.alias. Writing Through A Reference: ref.write.seen, ref.write.no-exclusivity.
# expect-stdout: 7 7
struct Point:
    x: i32
    y: i32

pub fn main() -> void $ Console:
    r := &mut Point { x: 1, y: 2 }
    s := &mut *r
    s.x = 7
    seen := s.x
    println("${r.x} ${seen}")
