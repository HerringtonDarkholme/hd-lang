# test: a copy of a pinned list is its own list, so changing the copy leaves the referenced slot alone
# Spec 13 Element References: ref.elem.copy.
struct Bag:
    items: List[i32]

tests:
    use std.testing.assert_equal

    it("a copied list changes on its own"):
        let mut xs = [+1, 2, 3]
        r := &mut xs[0]
        let mut copy = xs
        copy[0] = 100
        copy.push(4)
        assert_equal(*r, 1, reason="the reference sees its own list")
        *r = 7
        assert_equal(copy[0], 100, reason="a write through the reference does not reach the copy")
        assert_equal(xs[0], 7, reason="it reaches the list it was taken from")

    it("a struct holding a pinned list copies the list too"):
        let mut bag = Bag { items: [+1, 2] }
        r := &mut bag.items[0]
        before := bag
        *r = 11
        assert_equal(bag.items[0], 11, reason="the bag's list changed")
        assert_equal(before.items[0], 1, reason="the copy taken before is unchanged")
