# test: reference identity

use std.testing.assert_equal

data Box:
    value: i32

trait Value:
    fn get(self) -> i32

impl Value for Box:
    fn get(self) -> i32: self.value

enum Status:
    Ready
    Code(value: i32)

fn same[T < Reference](left: T, right: T) -> bool: left is right
fn as_value(value: Value) -> Value: value
fn pending!() -> i32: 1

fn main() -> i32:
    box := Box { value: 1 }
    alias := box
    other := Box { value: 1 }
    callback := fn() -> i32: 1
    callback_alias := callback
    other_callback := fn() -> i32: 1
    values := [1]
    values_alias := values
    first_trait := as_value(box)
    second_trait := as_value(box)
    suspension := pending()
    suspension_alias := suspension
    if same(box, alias) && !(box is other) && callback is callback_alias && !(callback is other_callback) && values is values_alias && first_trait is second_trait && suspension is suspension_alias && Status.Ready is Status.Ready && !(Status.Code(1) is Status.Code(1)):
        42
    else:
        0

test "main returns 42":
    assert_equal(main(), 42, reason="reference identity")
