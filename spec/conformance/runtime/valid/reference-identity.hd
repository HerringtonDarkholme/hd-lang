# test: reference identity
# Spec 05 Identity: expr.is.no-user-code, expr.is.heap-values,
# expr.is.conversion, expr.is.no-wrapper, expr.is.canonical-data,
# expr.is.canonical.same, expr.is.compatible, expr.is.permissions.

use std.testing.assert_equal

data Box:
    value: i32

trait Value:
    fn get(self) -> i32

impl Value for Box:
    fn get(self) -> i32: self.value

fn same[T < AnyRef](left: T, right: T) -> bool: left is right
fn as_value(value: dyn Value) -> dyn Value: value
fn pending!() -> i32: 1

fn main() -> i32:
    box := Box { value: 1 }
    alias := box
    other := Box { value: 1 }
    values := [1]
    values_alias := values
    first_trait := as_value(box)
    second_trait := as_value(box)
    suspension := pending()
    suspension_alias := suspension
    if same(box, alias) && !(box is other) && values is values_alias && first_trait is second_trait && suspension is suspension_alias:
        42
    else:
        0

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="reference identity")
