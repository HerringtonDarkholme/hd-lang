# test: reference identity
# Spec 05 Identity: expr.is.no-user-code, expr.is.references,
# expr.is.conversion, expr.is.no-wrapper, expr.is.compatible.referent;
# Spec 09 Trait Value References: trait.dyn.ref.identity.

struct Box:
    value: i32

trait Value:
    fn get(&self) -> i32

impl Value for Box:
    fn get(&self) -> i32:
        self.value

fn same[T < AnyRef](left: T, right: T) -> bool:
    left is right
fn as_value(value: *dyn Value) -> *dyn Value:
    value
fn pending!() -> i32:
    1

fn main() -> i32:
    boxed := box(Box { value: 1 })
    alias := boxed
    other := &Box { value: 1 }
    first_trait := as_value(boxed)
    second_trait := as_value(boxed)
    suspension := pending()
    suspension_alias := suspension
    if (
        same(boxed, alias)
        && !(boxed is other)
        && first_trait is second_trait
        && suspension is suspension_alias
    ):
        42
    else:
        0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="reference identity")
