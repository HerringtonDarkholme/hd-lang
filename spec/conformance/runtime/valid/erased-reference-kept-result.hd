# test: kept generic suspensions return live references after polling
# Spec 13 References: ref.place.lifetime; Spec 11 Suspension Values: req.suspend.cold.
# expect: test
use std.time.{Clock, ManualClock, Timestamp, ms, sleep}

trait Factory:
    fn make![T](self, value: T) -> *mut T $ Clock:
        sleep!(ms(1))
        let mut local = value
        &mut local

    fn share![T](self, source: *mut T) -> *mut T $ Clock:
        sleep!(ms(1))
        source

struct Maker: pass
impl Factory for Maker

tests:
    use std.testing.{assert, assert_equal}

    it("keeps local references returned by an erased suspension"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            let factory: &dyn Factory = &Maker {}
            let mut first = factory.make(+1)
            let mut second = factory.make("initial")
            let mut third = factory.make((+2, "initial"))
            number := first!()
            text := second!()
            pair := third!()
            *number = +10
            *text = "changed"
            *pair = (+20, "pair")
            assert_equal(*number, +10, reason="a returned integer reference survives its frame")
            assert_equal(*text, "changed", reason="a returned string reference survives its frame")
            assert_equal(
                *pair,
                (+20, "pair"),
                reason="a returned tuple reference survives its frame",
            )

    it("preserves aliases and identity through a kept reference result"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            let factory: &dyn Factory = &Maker {}
            let mut source = "first"
            let mut kept = factory.share(&mut source)
            source = "before polling"
            shared := kept!()
            assert(
                shared is &mut source,
                reason="a kept reference result has the caller's identity",
            )
            assert_equal(
                *shared,
                "before polling",
                reason="a cold argument retains its original storage",
            )
            source = "after polling"
            assert_equal(
                *shared,
                "after polling",
                reason="the returned reference follows later writes",
            )
            *shared = "through result"
            assert_equal(
                source,
                "through result",
                reason="a returned reference still writes the caller",
            )

    it("cancels a kept reference result without changing its caller"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            let factory: &dyn Factory = &Maker {}
            let mut source = "unchanged"
            let mut kept = factory.share(&mut source)
            _ := kept.cancel!()
            source = "still writable"
            assert_equal(
                source,
                "still writable",
                reason="cancel releases the cold reference argument and wrapper",
            )
