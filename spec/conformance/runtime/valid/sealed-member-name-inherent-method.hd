# test: an inherent method may take a sealed trait member's name, and the supplied implementation still reports the type
# Spec 09 Compiler-Supplied Implementations: trait.sealed.inherent-ok, trait.sealed.inherent-lookup, trait.sealed.no-replace.
use std.inspect.{Inspectable, TypeId}
data Shipment:
    carrier: string

impl Shipment:
    fn runtime_type(self) -> string:
        "shipment by " + self.carrier

fn recorded(value: dyn Inspectable) -> TypeId:
    value.runtime_type()

tests:
    use std.testing.{assert, assert_equal}

    it("the inherent method answers a dot call on the concrete type"):
        shipment := Shipment { carrier: "ups" }
        assert_equal(shipment.runtime_type(), "shipment by ups", reason="ordinary lookup finds the inherent method")

    it("the compiler-supplied runtime_type is unchanged"):
        shipment := Shipment { carrier: "dhl" }
        assert(recorded(shipment) == TypeId::of::[Shipment](), reason="the erased value reports Shipment")
