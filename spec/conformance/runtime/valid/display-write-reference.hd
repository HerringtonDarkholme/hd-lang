# test: a reference's Display write calls the write of the value it refers to, so that value's override runs
# Spec std/format References: std-format.display.reference.write (owner decision 2026-10-17, #436).
use std.text.StringBuilder

struct Calls:
    writes: usize

struct Name:
    text: string
    calls: &mut Calls

impl Display for Name:
    fn to_string(self) -> string:
        self.text

    fn write(self, out: &mut StringBuilder) -> void:
        self.calls.writes += 1
        _ := out.push(self.text)

tests:
    use std.testing.assert_equal

    it("a reference forwards write"):
        calls := &mut Calls { writes: 0 }
        let mut name = Name { text: "Ada", calls: calls }
        shared := &name
        assert_equal("hi $shared", "hi Ada", reason="a reference displays as its referent")
        assert_equal(calls.writes, 1, reason="&T forwards write to the referent's override")
        writable := &mut name
        assert_equal("hi $writable", "hi Ada", reason="a writable reference displays as its referent")
        assert_equal(calls.writes, 2, reason="&mut T forwards write too")
        let shown: &dyn Display = &name
        assert_equal("hi $shown", "hi Ada", reason="a trait value calls the referent's write")
        assert_equal(calls.writes, 3, reason="the trait value's write is the override")
