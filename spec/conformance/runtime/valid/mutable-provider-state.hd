# test: requirements / mutable providers / state change through mut self
# Spec 11 Mutable Providers: a requirement trait with a mut self method is always provided
# with mutable access, so $.use(Counter) yields mut Counter.

use std.testing.assert_equal

fn tick() -> i32 $ Counter:
    $.use(Counter).bump()
    $.use(Counter).count()

fn keep() -> i32 $ Counter:
    let counter: mut Counter = $.use(Counter)
    counter.bump()
    counter.count()

trait Counter:
    fn count(self) -> i32
    fn bump(mut self) -> void

data MemoryCounter:
    value: i32

impl Counter for MemoryCounter:
    fn count(self) -> i32:
        self.value

    fn bump(mut self) -> void:
        self.value = self.value + 1

tests:
    it("a mutable provider changes its own state"):
        let counter: mut MemoryCounter = MemoryCounter { value: 0 }
        $.with(Counter=counter):
            _ := tick()
            assert_equal(keep(), 2, reason="both calls bump the installed provider")
        assert_equal(counter.value, 2, reason="the provider is the caller's value")
