# test: string slices select byte offsets, and a list slice is a new list
# Spec 05 Slicing: expr.index.slice.half-open, expr.index.slice.from, expr.index.slice.to, expr.index.slice.inclusive, expr.index.slice.string, expr.index.slice.list (batch 48).
use std.testing.assert_equal

fn parts(text: string, items: List[i32]) -> (string, string, List[i32], List[i32]):
    (text[0..3], text[2..], items[..2], items[1..=2])

tests:
    it("slices a string by byte offsets"):
        assert_equal(parts("hello", [1, 2, 3])._0, "hel", reason="a..b")
        assert_equal(parts("hello", [1, 2, 3])._1, "llo", reason="a..")
        assert_equal("héllo"[0..3], "hé", reason="é takes two bytes")
        assert_equal("hello"[1..=2], "el", reason="a..=b")
        assert_equal("hello"[2..2], "", reason="an empty slice")

    it("slices a list into a new list"):
        items := [1, 2, 3]
        assert_equal(parts("hello", items)._2, [1, 2], reason="..b")
        assert_equal(parts("hello", items)._3, [2, 3], reason="a..=b")
        let mut copy = items[0..2]
        copy.push(9)
        copy[0] = 7
        assert_equal(items, [1, 2, 3], reason="the slice is not a view")
        assert_equal(copy, [7, 2, 9], reason="the slice is its own list")
