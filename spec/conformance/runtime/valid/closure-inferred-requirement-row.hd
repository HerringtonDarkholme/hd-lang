# test: closures / requirement inference / inferred row

fn run() -> i32 $ Clock:
    reader := fn() -> i32:
        _ := $.use(Clock)
        42
    reader()

trait Clock

data FixedClock: pass

impl Clock for FixedClock

tests:
    use std.testing.assert_equal

    it("run returns 42 with its providers"):
        $.with(Clock=FixedClock {}):
            assert_equal(run(), 42, reason="closures / requirement inference / inferred row")
