# test: postfix ? inside a closure returns from that closure, not from the enclosing function
# Spec 05 Propagation: "Postfix `?` is invalid when there is no enclosing named function or closure
# with the required optional or `Result` return type." and "for `T?`, `.Some(value)` produces
# `value` as `T`; `.None` immediately returns `.None` from the nearest function".
use std.testing.assert_equal

fn outer(input: i32?) -> i32:
    inner := fn(value: i32?) -> i32?:
        present := value?
        present + 1
    result := inner(input)
    match result:
        .Some(found) => found
        .None => -1

test ".None propagates out of the closure only":
    assert_equal(outer(.None), -1, reason="the enclosing function continues after the closure returns .None")

test "a present value continues inside the closure":
    assert_equal(outer(41), 42, reason="present value is unwrapped")
