# test: postfix ? inside a closure returns from that closure, not from the enclosing function
# Spec 05 Propagation: "Postfix `?` is invalid when there is no enclosing named function or closure
# with the required optional or `Result` return type." and "for `T?`, a present value produces `T`;
# `nil` immediately returns `nil` from the nearest function".
use std.testing.assert_equal

fn outer(input: i32?) -> i32:
    inner := fn(value: i32?) -> i32?:
        present := value?
        present + 1
    result := inner(input)
    match result:
        found? => found
        nil => -1

test "nil propagates out of the closure only":
    assert_equal(outer(nil), -1, reason="the enclosing function continues after the closure returns nil")

test "a present value continues inside the closure":
    assert_equal(outer(41), 42, reason="present value is unwrapped")
