# test: a scope guard retains its callback row and runs the callback inside a matching requirement scope
# Spec lang/06 Using Bindings: flow.using.cleanup-row.check.
# Spec std/ops Scope Guards: std-ops.scope-guard.type, std-ops.scope-guard.on-exit, std-ops.scope-guard.dispose.
use std.console.MemoryConsole
use std.ops.on_exit

fn work() -> void $ Console:
    using guard = on_exit(fn() -> void $ Console: println("cleanup"))
    println("body")

tests:
    it("runs row-polymorphic cleanup"):
        console := MemoryConsole::new()
        $.with(Console=console):
            work()
        assert_equal(console.output(), ["body", "\n", "cleanup", "\n"])
