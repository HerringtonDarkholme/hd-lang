# test: reading a part out of a mut value yields a mut alias; mutation through it is seen in the container
# Spec 08 Access Through Parts: data.part.access; Part Ownership: data.part.aliases-untracked.
use std.testing.assert_equal

data Timestamps:
    created_at: i32
    pub updated_at: i32

impl Timestamps:
    fn touch(mut self, at: i32) -> void:
        self.updated_at = at

data Post:
    Timestamps
    id: string
    title: string

tests:
    it("mut alias"):
        let mut post = Post { Timestamps: ...Timestamps { created_at: 1, updated_at: 1 }, id: "p", title: "t" }
        let mut stamps = post.Timestamps
        stamps.touch(5)
        assert_equal(post.updated_at, 5, reason="the alias is the part")
        let explicit: mut Timestamps = post.Timestamps
        explicit.updated_at = 6
        assert_equal(post.updated_at, 6, reason="an annotated mut alias")
