# test: std.json keeps the RFC 8259 number grammar, so float text that parse_f64 accepts is still a JSON error
# Spec std/json Number Syntax: std-json.parse.number.grammar and std-json.parse.strict (owner decision PARSE-F64-GRAMMAR, 2026-10-03).
use std.json.{parse, JsonError}
fn failure(text: string) -> JsonError?:
    match parse(text):
        .Ok(_) => .None
        .Err(error) => .Some(error)

tests:
    use std.testing.assert_equal

    it("a character outside the JSON number grammar is UnexpectedCharacter"):
        cases := [
            ("NaN", JsonError.UnexpectedCharacter(0)),
            ("Infinity", JsonError.UnexpectedCharacter(0)),
            ("-inf", JsonError.UnexpectedCharacter(1)),
            ("+1", JsonError.UnexpectedCharacter(0)),
            (".5", JsonError.UnexpectedCharacter(0)),
            ("007", JsonError.UnexpectedCharacter(1)),
        ]
        for case in cases:
            assert_equal(failure(case._0), .Some(case._1), reason=case._0)
    it("a number that ends where a digit must follow is UnexpectedEnd"):
        cases := [
            ("5.", JsonError.UnexpectedEnd(2)),
            ("1e", JsonError.UnexpectedEnd(2)),
        ]
        for case in cases:
            assert_equal(failure(case._0), .Some(case._1), reason=case._0)
