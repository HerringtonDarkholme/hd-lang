# test: during an element reference's call, other arguments may read the list's other elements
# Spec 13 Call-Scoped Access: ref.elem.access.live-length, ref.elem.access.mut.
fn add_all(target: &mut i32, other: i32, count: usize) -> void:
    *target += other
    if count == 2:
        *target += 2

tests:
    use std.testing.assert_equal

    it("reads of other elements beside an element reference"):
        let mut scores = [+1, 2]
        add_all(&mut scores[0], scores[1], 2)
        assert_equal(scores, [+5, 2], reason="the reads keep the length")
