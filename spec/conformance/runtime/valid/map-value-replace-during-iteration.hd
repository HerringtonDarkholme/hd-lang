# test: replacing each map value during a loop over the map changes the map, and the loop visits each entry once
# Spec 06 Snapshot Iteration: flow.for.snapshot.change.
fn double(entries: &mut Map[string, i32]) -> void:
    for (key, value) in entries:
        entries[key] = value * 2

tests:
    use std.testing.assert_equal

    it("every value replaced in place"):
        let mut entries: Map[string, i32] = {"a": +1, "b": +2}
        double(&mut entries)
        assert_equal(entries["a"], +2, reason="a doubled")
        assert_equal(entries["b"], +4, reason="b doubled")
