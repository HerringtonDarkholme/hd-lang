# test: a @track_caller function reads its call's location and argument texts
# Spec lang/07 Call-Site Locations: fn.caller.site-argument, fn.caller.location,
# fn.caller.chain, fn.caller.value, fn.caller.accessor.args,
# fn.caller.accessor.args.name, fn.caller.accessor.args.complete.
# expect-stdout: 45:5 root
# expect-stdout: 46:5 root
# expect-stdout: [a + 1 @47:11-47:16][b @47:18-47:19]
# expect-stdout: [a * 2 @48:13-48:18]
# expect-stdout: 49:13 root
# expect-stdout: [a @51:11-51:12][y=b @51:16-51:17]
# expect-stdout: 0 texts
use std.debug.Location

@track_caller
fn here() -> void:
    at := Location::caller()
    println("${at.line}:${at.column} ${if at.in_root_package(): "root" else: "fetched"}")

@track_caller
fn outer() -> void:
    here()

@track_caller
fn texts(x: i32, y: i32) -> void:
    let shown = ""
    for arg in Location::caller_args():
        name := match arg.name:
            .Some(n) => n + "="
            .None => ""
        shown = shown + "[$name${arg.text} @${arg.start.line}:${arg.start.column}-${arg.end.line}:${arg.end.column}]"
    println(shown)

@track_caller
fn forward(x: i32) -> void:
    texts(x, x)

@track_caller
fn count(x: i32, body: fn() -> void) -> void:
    body()
    println("${Location::caller_args().len()} texts")

pub fn main() -> void $ Console:
    a := +2
    b := +3
    here()
    outer()
    texts(a + 1, b)
    forward(a * 2)
    show := here
    show()
    texts(a, y=b)
    count(a):
        pass
