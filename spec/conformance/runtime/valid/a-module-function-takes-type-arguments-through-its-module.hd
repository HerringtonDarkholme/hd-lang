# test: a module function takes type arguments through its module
# Rules: req.combinator.race-signature; Spec 07 Generic Functions: fn.generic.call-list.
# expect-stdout: 1
use std.task

struct Identity: pass

impl Identity:
    fn echo![Value](value: Value) -> Value:
        value

    fn make[Value](value: Value) -> List[Value]:
        [value]

    fn say![Value](self, value: Value) -> Value:
        value

struct Box[T]:
    item: T

impl[T] Box[T]:
    fn wrap[U](item: T, other: U) -> (T, U):
        (item, other)

fn convert![T](value: T) -> T:
    value

fn ready!() -> i32:
    1

pub fn main!() -> void $ Console:
    println(task.race!::[i32](ready(), ready()))
