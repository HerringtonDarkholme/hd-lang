# test: an i32 crosses an erased method whole
# Rules: trait.dyn.member.other-with-opaque, trait.dyn.binding.signatures, trait.dyn.bound.reference-dispatch.
# expect-stdout: -500
# expect-stdout: 2000000000
# expect-stdout: -2000000000
trait Echo:
    fn echo[T](self, x: T) -> T

struct Same:
    n: i32

impl Echo for Same:
    fn echo[T](self, x: T) -> T:
        x

fn run(e: &dyn Echo) -> void $ Console:
    let i: i32 = 0
    let s: i32 = 0
    while i < 1000:
        s = s + e.echo(i - 500)
        i = i + 1
    println(s)
    println(e.echo(+2000000000))
    println(e.echo(-2000000000))

pub fn main() -> void $ Console:
    run(&Same { n: 1 })
