# test: a variant's self_ref counts a member that the derivation block omits
# Spec 14 Self References: annot.self-ref.variant.omitted (owner decision SR-omit, batch 51, 2026-10-02).
use std.structure.{Structure, Field, Variant, Describer, SelfRef}
trait Shape:
    fn shape() -> string

fn ref_name(r: SelfRef) -> string:
    match r:
        .Absent => "absent"
        .Optional => "optional"
        .Required => "required"

data ShapeLister:
    out: string

impl[S] Describer[S] for ShapeLister:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        self.out = self.out + v.info.name + "=" + ref_name(v.info.self_ref) + ";"
        .Ok(())

    fn member[F](mut self, h: Field[S, F]) -> Result[void, never]:
        self.out = self.out + h.info.name + "=" + ref_name(h.info.self_ref) + ";"
        .Ok(())

impl[T] Shape for T by Structure:
    fn shape() -> string:
        let mut d = ShapeLister { out: "" }
        _ := T::describe(d)
        d.out

data Node:
    label: string
    parent: Node? = .None

impl Shape for Node by Structure:
    parent = pass

tests:
    use std.testing.assert_equal

    it("the omitted parent still makes the variant optional"):
        assert_equal(Node::shape(), "Node=optional;label=absent;", reason="parent is omitted but counted")
