# test: a value with no slot of its own returns through a type parameter at its own lifetimes
# Spec 13 Generic Calls: ref.generic.call. `id(s.make(p))` returns the
# `Keep['a]` built from `p`, past the shelf's scope.
# expect-stdout: 3
struct Point:
    x: i32

trait Shelf['b]:
    type Item
    fn make(&self, v: &'b Point) -> Self::Item

fn id[T](x: T) -> T:
    x

fn ok['a, S < Shelf['a]](s: &S, p: &'a Point) -> S::Item:
    id(s.make(p))

struct Keep['a]:
    last: &'a Point

struct Sh:
    n: i32

impl['b] Shelf['b] for Sh:
    type Item = Keep['b]
    fn make(&self, v: &'b Point) -> Keep['b]:
        Keep { last: v }

fn outlive['c](p: &'c Point) -> Keep['c]:
    s := Sh { n: 1 }
    ok::[Sh](&s, p)

pub fn main() -> void $ Console:
    p := Point { x: 3 }
    k := outlive(&p)
    println(k.last.x)
