# test: ScriptedHttp queues raw results per encoded URL and repeats the last reply
# Rules: std-http.scripted.new-empty, std-http.scripted.reply, std-http.scripted.key-text, std-http.scripted.queue-order, std-http.scripted.repeat-last, std-http.scripted.transport-errors, std-http.scripted.raw-status, std-http.scripted.received-ref.
use std.http.{Http, HttpError, Request, Response, ScriptedHttp, get}
use std.task.{Backoff, retry}
use std.time.{Clock, ManualClock, Timestamp}

tests:
    use std.testing.{assert, assert_equal}

    it("real retry checks a raw 503 then sees 200 and the repeated last reply"):
        url := "https://example.test/status"
        http := ScriptedHttp::new()
        http.reply(url, .Ok(Response { status: 503 }))
        http.reply(url, .Ok(Response { status: 200, body: "ready".to_utf8() }))
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Http=http, Clock=clock):
            result := retry!(Backoff { attempts: 3, initial: 0ms }, when=fn(error: HttpError): error.is_transient()):
                get!(url)
            assert_equal(result.expect("retry succeeds").text(), "ready", reason="the real status check caused a retry")
            assert_equal(get!(url).expect("last reply repeats").status, 200, reason="third request")
        assert_equal(http.received().len(), 3, reason="503 then 200 then the repeated 200")
        assert_equal(http.received().map(fn(request): request.url), [url, url, url], reason="all attempts are recorded")

    it("queues and transport errors are independent for each URL"):
        a := "https://example.test/a"
        b := "https://example.test/b"
        http := ScriptedHttp::new()
        http.reply(a, .Err(HttpError.Timeout))
        http.reply(a, .Ok(Response { status: 201 }))
        http.reply(b, .Ok(Response { status: 503 }))
        $.with(Http=http):
            assert_equal(Request::get(a).send!(), .Err(HttpError.Timeout), reason="queued transport error unchanged")
            assert_equal(Request::get(b).send!().expect("raw response").status, 503, reason="fake does not check status")
            assert_equal(get!(a).expect("second reply").status, 201, reason="only a advanced")
            assert_equal(get!(a).expect("last repeats").status, 201, reason="success repeats")
        assert_equal(http.received().map(fn(request): request.url), [a, b, a, a], reason="interleaved requests")

    it("appending after repetition supplies the next result and logs stay snapshots"):
        url := "https://example.test/append"
        http := ScriptedHttp::new()
        http.reply(url, .Ok(Response { status: 200 }))
        $.with(Http=http):
            assert_equal(get!(url).expect("first").status, 200, reason="first result")
            assert_equal(get!(url).expect("repeat").status, 200, reason="last result repeats")
        before := http.received()
        http.reply(url, .Ok(Response { status: 201 }))
        $.with(Http=http):
            assert_equal(get!(url).expect("appended").status, 201, reason="fresh queued result is next")
        assert_equal(before.len(), 2, reason="received returns a value snapshot")
        assert_equal(http.received().len(), 3, reason="new log includes the request")

    it("a permanent status stops the real retry without consuming the next reply"):
        url := "https://example.test/permanent"
        http := ScriptedHttp::new()
        http.reply(url, .Ok(Response { status: 404 }))
        http.reply(url, .Ok(Response { status: 200 }))
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Http=http, Clock=clock):
            result := retry!(Backoff { attempts: 3, initial: 0ms }, when=fn(error: HttpError): error.is_transient()):
                get!(url)
            match result:
                .Err(.Status(response)) => assert_equal(response.status, 404, reason="real status error")
                _ => assert(false, reason="404 must stop retry")
            assert_equal(http.received().len(), 1, reason="only one attempt")
            assert_equal(get!(url).expect("next reply remains").status, 200, reason="the queue was not drained")

    it("full encoded query keys match exactly and returned responses are values"):
        url := "https://example.test/search?term=a%20b"
        http := ScriptedHttp::new()
        http.reply(url, .Ok(Response { status: 200, body: [1, 2] }))
        $.with(Http=http):
            let mut changed = Request::get("https://example.test/search").query("term", "a b").send!().expect("encoded key")
            changed.body.push(3)
            assert_equal(changed.body, [1, 2, 3], reason="mutate the returned value")
            assert_equal(get!(url).expect("repeat").body, [1, 2], reason="stored reply stays unchanged")
            assert(get!("https://example.test/search?term=a+b").is_err(), reason="query spellings do not alias")
        assert_equal(http.received()[0].url, url, reason="query was encoded before lookup")
        assert_equal(http.received().len(), 3, reason="unanswered query is recorded too")
