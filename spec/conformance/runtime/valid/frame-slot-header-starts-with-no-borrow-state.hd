# test: a frame slot zeroes its whole header, so a derived `Deserialize` that reaches a `&mut` local through its `*mut` parameter reads no borrow state, though an earlier frame left all-ones bytes there
# Spec 13 Conflicts Through Aliases: ref.excl.alias.counted-access, ref.excl.alias.conflict.
# expect-stdout: 7 b
# expect-stdout: ok
use std.serde.{Deserialize, Deserializer, ValueKind}
use std.structure.{Facts, VariantInfo, Member}

# One scripted value or step of a sensor feed.
enum Tok:
    Absent
    Null
    Bool(value: bool)
    Int(value: i64)
    Uint(value: u64)
    Float(value: f64)
    Text(value: string)
    Item
    Key(name: string)
    Done
    Pick(index: usize)

# A reader over a fixed list of tokens. It records each call as a word.
struct Feed:
    pub toks: List[Tok]
    pub at: usize
    pub log: string

impl Feed:
    fn add(&mut self, word: string) -> void:
        if self.log == "":
            self.log = word
        else:
            self.log = self.log + " " + word

    fn take(&mut self) -> Tok:
        if self.at >= self.toks.len():
            return Tok.Done
        found := self.toks[self.at]
        self.at = self.at + 1
        found

impl Deserializer for Feed:
    type Error = string

    fn peek(&mut self) -> Result[ValueKind, string]:
        self.add("peek")
        if self.at >= self.toks.len():
            return .Ok(ValueKind.Null)
        match self.toks[self.at]:
            Tok.Absent => .Ok(ValueKind.Null)
            Tok.Null => .Ok(ValueKind.Null)
            Tok.Bool(_) => .Ok(ValueKind.Bool)
            Tok.Int(_) => .Ok(ValueKind.Int)
            Tok.Uint(_) => .Ok(ValueKind.Uint)
            Tok.Float(_) => .Ok(ValueKind.Float)
            Tok.Text(_) => .Ok(ValueKind.Text)
            _ => .Err("not a value")

    fn is_null(&mut self) -> Result[bool, string]:
        self.add("is-null")
        if self.at < self.toks.len():
            match self.toks[self.at]:
                Tok.Absent =>
                    self.at = self.at + 1
                    return .Ok(true)
                Tok.Null =>
                    self.at = self.at + 1
                    return .Ok(true)
                _ => pass
        .Ok(false)

    fn bool(&mut self, expected: string) -> Result[bool, string]:
        self.add("bool:$expected")
        match self.take():
            Tok.Bool(value) => .Ok(value)
            _ => .Err(self.invalid(expected))

    fn int(&mut self, expected: string) -> Result[i64, string]:
        self.add("int:$expected")
        match self.take():
            Tok.Int(value) => .Ok(value)
            _ => .Err(self.invalid(expected))

    fn uint(&mut self, expected: string) -> Result[u64, string]:
        self.add("uint:$expected")
        match self.take():
            Tok.Uint(value) => .Ok(value)
            _ => .Err(self.invalid(expected))

    fn float(&mut self, expected: string) -> Result[f64, string]:
        self.add("float:$expected")
        match self.take():
            Tok.Float(value) => .Ok(value)
            _ => .Err(self.invalid(expected))

    fn text(&mut self, expected: string) -> Result[string, string]:
        self.add("text:$expected")
        match self.take():
            Tok.Text(value) => .Ok(value)
            _ => .Err(self.invalid(expected))

    fn begin_list(&mut self) -> Result[void, string]:
        self.add("list")
        .Ok(())

    fn next_item(&mut self) -> Result[bool, string]:
        match self.take():
            Tok.Item => .Ok(true)
            _ => .Ok(false)

    fn begin_map(&mut self) -> Result[void, string]:
        self.add("map")
        .Ok(())

    fn next_key(&mut self) -> Result[string?, string]:
        match self.take():
            Tok.Key(name) => .Ok(.Some(name))
            _ => .Ok(.None)

    fn begin_data(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, string]:
        self.add("data:${choices[0].name}")
        match self.take():
            Tok.Pick(index) => .Ok(index)
            _ => .Err("no data")

    fn begin_variant(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, string]:
        let mut names: List[string] = []
        for choice in choices:
            names.push(choice.name)
        self.add("variant:${names.join("|")}")
        match self.take():
            Tok.Pick(index) => .Ok(index)
            _ => .Err("no variant")

    fn begin_newtype_variant(&mut self) -> Result[void, string]:
        self.add("newtype")
        .Ok(())

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, string]:
        self.add("tuple:$len")
        .Ok(())

    fn member(&mut self, m: &Member) -> Result[void, string]:
        self.add("member:${m.name}")
        .Ok(())

    fn end_data(&mut self) -> Result[void, string]:
        self.add("end-data")
        .Ok(())

    fn end_variant(&mut self) -> Result[void, string]:
        self.add("end-variant")
        .Ok(())

    fn invalid(&mut self, expected: string) -> string:
        "invalid $expected"

struct Big:
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
    f: i64
    g: i64
    h: i64
    i: i64
    j: i64
    k: i64
    l: i64
    m: i64
    n: i64
    o: i64
    p: i64

fn fill(big: &mut Big) -> i64:
    big.a + big.p

# Leaves all-ones bytes in the local stack where the next frame's slots go.
fn dirty() -> i64:
    let mut big = Big {
        a: -1,
        b: -1,
        c: -1,
        d: -1,
        e: -1,
        f: -1,
        g: -1,
        h: -1,
        i: -1,
        j: -1,
        k: -1,
        l: -1,
        m: -1,
        n: -1,
        o: -1,
        p: -1,
    }
    fill(&mut big)

@derive(Deserialize)
struct Order:
    id: u32

fn read(toks: List[Tok]) -> Result[Order, string]:
    let mut input = Feed { toks: toks, at: 0, log: "" }
    Order::deserialize(&mut input)

pub fn main() -> void $ Console:
    # A reference through a `*mut Feed` lends the type, so accesses through
    # a `*mut Feed` check the borrow state.
    boxed := box(Feed { toks: [], at: 0, log: "b" })
    held := &boxed.log
    _ := dirty()
    match read([Tok.Pick(0), Tok.Uint(7)]):
        .Ok(order) => println("${order.id} ${*held}")
        .Err(e) => println(e)
    println("ok")
