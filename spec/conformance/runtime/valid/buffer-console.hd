# test: MemoryConsole records each write_sync text in call order
# Spec std/console Buffer Console: std-console.buffer.install-ref, std-console.buffer.output-text-sync (spec pass 89, audit item 6).
use std.console.MemoryConsole
fn greet(name: string) -> void $ Console:
    println("hello, ${name}")

tests:
    use std.testing.assert_equal

    it("records the line"):
        let mut console = MemoryConsole::new()
        $.with(Console=console):
            greet("Ada")
        assert_equal(console.output(), ["hello, Ada", "\n"], reason="one line")

    it("keeps call order"):
        let mut console = MemoryConsole::new()
        assert_equal(console.output().len(), 0, reason="nothing yet")
        $.with(Console=console):
            println("one")
            println(2)
        assert_equal(console.output(), ["one", "\n", "2", "\n"], reason="in order")
