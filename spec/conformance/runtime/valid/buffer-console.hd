# test: BufferConsole records each write_line! text in call order
# Spec std/console Buffer Console: std-console.buffer.new, std-console.buffer.output (spec pass 89, audit item 6).
use std.console.BufferConsole
use std.testing.assert_equal

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")

tests:
    it("records the line"):
        let mut console = BufferConsole::new()
        $.with(Console=console):
            greet("Ada")
        assert_equal(console.output(), ["hello, Ada"], reason="one line")

    it("keeps call order"):
        let mut console = BufferConsole::new()
        assert_equal(console.output().len(), 0, reason="nothing yet")
        $.with(Console=console):
            println("one")
            println(2)
        assert_equal(console.output(), ["one", "2"], reason="in order")
