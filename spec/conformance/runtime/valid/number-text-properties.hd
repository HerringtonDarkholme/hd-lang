# test: number text follows independent digit models and preserves numeric values
# Spec lang/04-type-system types.display.int, types.display.float; std/num
# std-num.parse.grammar, std-num.parse.unsigned-type-grammar, std-num.parse.out-of-range,
# std-num.radix.round-trip, std-num.radix.parse.errors, std-num.parse.float64-round-trip,
# std-num.parse-f64.range, std-num.parse-f64.special-value.
use std.num.{Integer, ParseNumberError}
use std.text.Parse
use std.testing.{Arbitrary, Choices, assert, assert_equal, it_each, it_prop}

# This small reference prepends one digit per division; it does not call
# number formatting, parsing, or any implementation helper.
fn reference_unsigned(value: u64, radix: u32) -> string:
    digits := "0123456789abcdefghijklmnopqrstuvwxyz"
    base := u64(radix)
    let rest = value
    let out = ""
    while true:
        digit := usize(rest % base)
        out = digits.slice(digit, digit + 1) + out
        rest = rest / base
        if rest == 0:
            return out

fn reference_integer[N < Integer](value: N, radix: u32) -> string:
    zero := N::zero()
    negative := value < zero
    # -(MIN + 1) + 1 obtains the unsigned magnitude without negating MIN.
    magnitude := if negative: (zero - (value + N::one())).to_u64() + 1 else: value.to_u64()
    digits := reference_unsigned(magnitude, radix)
    if negative: "-" + digits else: digits

fn check_integer[N < Integer & Parse[Error = ParseNumberError] & Debug](value: N, reader: fn(string, u32) -> Result[N, ParseNumberError]) -> void:
    decimal := reference_integer(value, 10)
    assert_equal(value.to_string(), decimal, reason="decimal formatting agrees with digit division")
    assert_equal(decimal.parse::[N](), .Ok(value), reason="decimal parsing returns the original width")
    if value >= N::zero():
        assert_equal(("+" + decimal).parse::[N](), .Ok(value), reason="an explicit plus is accepted")
    for radix in u32(2)..u32(37):
        expected := reference_integer(value, radix)
        assert_equal(value.to_radix(radix), expected, reason="radix formatting agrees with digit division")
        assert_equal(reader(expected, radix), .Ok(value), reason="radix text returns the original width")
        assert_equal(reader(expected.upper(), radix), .Ok(value), reason="uppercase letters have the same digit values")

@derive(Debug)
enum Width:
    I8
    I16
    I32
    I64
    U8
    U16
    U32
    U64
    Usize

fn decimal[N < Parse[Error = ParseNumberError] & Display](text: string) -> Result[string, ParseNumberError]:
    match text.parse::[N]():
        .Ok(value) => .Ok(value.to_string())
        .Err(error) => .Err(error)

fn parse_width(width: Width, text: string) -> Result[string, ParseNumberError]:
    match width:
        .I8 => decimal::[i8](text)
        .I16 => decimal::[i16](text)
        .I32 => decimal::[i32](text)
        .I64 => decimal::[i64](text)
        .U8 => decimal::[u8](text)
        .U16 => decimal::[u16](text)
        .U32 => decimal::[u32](text)
        .U64 => decimal::[u64](text)
        .Usize => decimal::[usize](text)

fn number_text[N < Display](result: Result[N, ParseNumberError]) -> Result[string, ParseNumberError]:
    match result:
        .Ok(value) => .Ok(value.to_string())
        .Err(error) => .Err(error)

fn parse_radix_width(width: Width, text: string, radix: u32) -> Result[string, ParseNumberError]:
    match width:
        .I8 => number_text(i8::parse_radix(text, radix))
        .I16 => number_text(i16::parse_radix(text, radix))
        .I32 => number_text(i32::parse_radix(text, radix))
        .I64 => number_text(i64::parse_radix(text, radix))
        .U8 => number_text(u8::parse_radix(text, radix))
        .U16 => number_text(u16::parse_radix(text, radix))
        .U32 => number_text(u32::parse_radix(text, radix))
        .U64 => number_text(u64::parse_radix(text, radix))
        .Usize => number_text(usize::parse_radix(text, radix))

fn integer_edges() -> List[(Width, string, Result[string, ParseNumberError])]:
    [
        (Width.I8, "-128", .Ok("-128")),
        (Width.I8, "127", .Ok("127")),
        (Width.I8, "128", .Err(.OutOfRange)),
        (Width.I8, "+17", .Ok("17")),
        (Width.I8, "-129", .Err(.OutOfRange)),
        (Width.I16, "-32768", .Ok("-32768")),
        (Width.I16, "32767", .Ok("32767")),
        (Width.I16, "32768", .Err(.OutOfRange)),
        (Width.I16, "+17", .Ok("17")),
        (Width.I16, "-32769", .Err(.OutOfRange)),
        (Width.I32, "-2147483648", .Ok("-2147483648")),
        (Width.I32, "2147483647", .Ok("2147483647")),
        (Width.I32, "2147483648", .Err(.OutOfRange)),
        (Width.I32, "+17", .Ok("17")),
        (Width.I32, "-2147483649", .Err(.OutOfRange)),
        (Width.I64, "-9223372036854775808", .Ok("-9223372036854775808")),
        (Width.I64, "9223372036854775807", .Ok("9223372036854775807")),
        (Width.I64, "9223372036854775808", .Err(.OutOfRange)),
        (Width.I64, "+17", .Ok("17")),
        (Width.I64, "-9223372036854775809", .Err(.OutOfRange)),
        (Width.U8, "0", .Ok("0")),
        (Width.U8, "255", .Ok("255")),
        (Width.U8, "256", .Err(.OutOfRange)),
        (Width.U8, "+17", .Ok("17")),
        (Width.U8, "-0", .Err(.InvalidDigit(0))),
        (Width.U8, "-1", .Err(.InvalidDigit(0))),
        (Width.U16, "0", .Ok("0")),
        (Width.U16, "65535", .Ok("65535")),
        (Width.U16, "65536", .Err(.OutOfRange)),
        (Width.U16, "+17", .Ok("17")),
        (Width.U16, "-0", .Err(.InvalidDigit(0))),
        (Width.U16, "-1", .Err(.InvalidDigit(0))),
        (Width.U32, "0", .Ok("0")),
        (Width.U32, "4294967295", .Ok("4294967295")),
        (Width.U32, "4294967296", .Err(.OutOfRange)),
        (Width.U32, "+17", .Ok("17")),
        (Width.U32, "-0", .Err(.InvalidDigit(0))),
        (Width.U32, "-1", .Err(.InvalidDigit(0))),
        (Width.U64, "0", .Ok("0")),
        (Width.U64, "18446744073709551615", .Ok("18446744073709551615")),
        (Width.U64, "18446744073709551616", .Err(.OutOfRange)),
        (Width.U64, "+17", .Ok("17")),
        (Width.U64, "-0", .Err(.InvalidDigit(0))),
        (Width.U64, "-1", .Err(.InvalidDigit(0))),
        (Width.Usize, "0", .Ok("0")),
        (Width.Usize, "4294967295", .Ok("4294967295")),
        (Width.Usize, "4294967296", .Err(.OutOfRange)),
        (Width.Usize, "+17", .Ok("17")),
        (Width.Usize, "-0", .Err(.InvalidDigit(0))),
        (Width.Usize, "-1", .Err(.InvalidDigit(0))),
    ]

# Draw exponent, fraction and sign independently, so every generated
# value is finite and the property never discards NaN or infinity draws.
@derive(Debug)
struct Finite:
    bits: u64

impl Arbitrary for Finite:
    fn arbitrary(c: &mut Choices) -> Finite:
        sign := if c.bool(): u64(1) << 63 else: u64(0)
        exponent := c.int(u64(0)..=u64(2046))
        fraction := c.int(u64(0)..=u64(0x000fffffffffffff))
        Finite { bits: sign | (exponent << 52) | fraction }

@derive(Debug)
enum FloatExpected:
    Bits(bits: u64)
    Nan
    Error(error: ParseNumberError)

fn check_float(text: string, expected: FloatExpected) -> void:
    match expected:
        .Bits(bits) =>
            value := text.parse::[f64]().expect("valid float text")
            assert_equal(value.to_bits(), bits, reason="the exact IEEE value, including zero's sign")
        .Nan => assert(text.parse::[f64]().expect("NaN text").is_nan(), reason="special NaN word")
        .Error(error) =>
            match text.parse::[f64]():
                .Err(found) => assert_equal(found, error, reason="the first invalid position")
                .Ok(_) => panic("expected a float grammar error")

fn radix_edges() -> List[(Width, string, u32, Result[string, ParseNumberError])]:
    [
        (Width.I32, "+FF", u32(16), Result::[string, ParseNumberError].Ok("255")),
        (Width.I32, "0xff", 16, .Err(.InvalidDigit(1))),
        (Width.U32, "-0", 16, .Err(.InvalidDigit(0))),
        (Width.U8, "100", 16, .Err(.OutOfRange)),
        (Width.I8, "-80", 16, .Ok("-128")),
        (Width.I8, "-81", 16, .Err(.OutOfRange)),
        (Width.U64, "3w5e11264sgsf", 36, .Ok("18446744073709551615")),
        (Width.U64, "3w5e11264sgsg", 36, .Err(.OutOfRange)),
        (Width.U32, "g", 16, .Err(.InvalidDigit(0))),
        (Width.I32, "2", 2, .Err(.InvalidDigit(0))),
        (Width.I32, "1_0", 10, .Err(.InvalidDigit(1))),
        (Width.I32, "1 ", 10, .Err(.InvalidDigit(1))),
        (Width.I32, "é", 36, .Err(.InvalidDigit(0))),
        (Width.I32, "+", 16, .Err(.InvalidDigit(1))),
        (Width.I32, "", 36, .Err(.Empty)),
    ]

fn float_edges() -> List[(string, FloatExpected)]:
    [
        ("+1.5", FloatExpected.Bits(0x3ff8000000000000)),
        ("-0", .Bits(0x8000000000000000)),
        ("1e400", .Bits(0x7ff0000000000000)),
        ("-1e400", .Bits(0xfff0000000000000)),
        ("1e-4000", .Bits(0)),
        ("-1e-4000", .Bits(0x8000000000000000)),
        ("NaN", .Nan),
        ("-nAn", .Nan),
        ("+NAN", .Nan),
        ("inf", .Bits(0x7ff0000000000000)),
        ("INFINITY", .Bits(0x7ff0000000000000)),
        ("", .Error(.Empty)),
        (" ", .Error(.InvalidDigit(0))),
        (" 1", .Error(.InvalidDigit(0))),
        ("1 ", .Error(.InvalidDigit(1))),
        ("1_0", .Error(.InvalidDigit(1))),
        ("0x1", .Error(.InvalidDigit(1))),
        ("1,5", .Error(.InvalidDigit(1))),
        (".", .Error(.InvalidDigit(1))),
        ("1e", .Error(.InvalidDigit(2))),
        ("1e+", .Error(.InvalidDigit(3))),
        ("nana", .Error(.InvalidDigit(3))),
        ("+nan5", .Error(.InvalidDigit(4))),
    ]

tests:
    it_prop("decimal and all radices i8", cases=100, examples=[i8(-128), i8(127), i8(0)], prop=fn!(value: i8):
        check_integer(value, fn(text: string, radix: u32) -> Result[i8, ParseNumberError]: i8::parse_radix(text, radix))
    )

    it_prop("decimal and all radices i16", cases=100, examples=[i16(-32768), i16(32767), i16(0)], prop=fn!(value: i16):
        check_integer(value, fn(text: string, radix: u32) -> Result[i16, ParseNumberError]: i16::parse_radix(text, radix))
    )

    it_prop("decimal and all radices i32", cases=100, examples=[i32(-2147483648), i32(2147483647), i32(0)], prop=fn!(value: i32):
        check_integer(value, fn(text: string, radix: u32) -> Result[i32, ParseNumberError]: i32::parse_radix(text, radix))
    )

    it_prop("decimal and all radices i64", cases=100, examples=[i64(-9223372036854775807) - 1, i64(9223372036854775807), i64(0)], prop=fn!(value: i64):
        check_integer(value, fn(text: string, radix: u32) -> Result[i64, ParseNumberError]: i64::parse_radix(text, radix))
    )

    it_prop("decimal and all radices u8", cases=100, examples=[u8(0), u8(255), u8(0)], prop=fn!(value: u8):
        check_integer(value, fn(text: string, radix: u32) -> Result[u8, ParseNumberError]: u8::parse_radix(text, radix))
    )

    it_prop("decimal and all radices u16", cases=100, examples=[u16(0), u16(65535), u16(0)], prop=fn!(value: u16):
        check_integer(value, fn(text: string, radix: u32) -> Result[u16, ParseNumberError]: u16::parse_radix(text, radix))
    )

    it_prop("decimal and all radices u32", cases=100, examples=[u32(0), u32(4294967295), u32(0)], prop=fn!(value: u32):
        check_integer(value, fn(text: string, radix: u32) -> Result[u32, ParseNumberError]: u32::parse_radix(text, radix))
    )

    it_prop("decimal and all radices u64", cases=100, examples=[u64(0), u64(18446744073709551615), u64(0)], prop=fn!(value: u64):
        check_integer(value, fn(text: string, radix: u32) -> Result[u64, ParseNumberError]: u64::parse_radix(text, radix))
    )

    it_prop("decimal and all radices usize", cases=100, examples=[usize(0), usize(4294967295), usize(0)], prop=fn!(value: usize):
        check_integer(value, fn(text: string, radix: u32) -> Result[usize, ParseNumberError]: usize::parse_radix(text, radix))
    )

    it_each("integer range and sign adversaries", integer_edges(), body=fn!(row: (Width, string, Result[string, ParseNumberError])):
        assert_equal(parse_width(row._0, row._1), row._2, reason="the exact width and input text")
    )

    it_each("integer grammar adversaries", [
        ("", ParseNumberError.Empty),
        ("+", ParseNumberError.InvalidDigit(1)),
        (" 1", ParseNumberError.InvalidDigit(0)),
        ("1 ", ParseNumberError.InvalidDigit(1)),
        ("1_0", ParseNumberError.InvalidDigit(1)),
        ("0x1", ParseNumberError.InvalidDigit(1)),
        ("1u8", ParseNumberError.InvalidDigit(1)),
        ("é1", ParseNumberError.InvalidDigit(0)),
        ("1é", ParseNumberError.InvalidDigit(1)),
    ], body=fn!(row: (string, ParseNumberError)):
        for width in [Width.I8, Width.I16, Width.I32, Width.I64, Width.U8, Width.U16, Width.U32, Width.U64, Width.Usize]:
            assert_equal(parse_width(width, row._0), .Err(row._1), reason="every width rejects this grammar")
    )

    it_each("radix grammar and range adversaries", radix_edges(), body=fn!(row: (Width, string, u32, Result[string, ParseNumberError])):
        assert_equal(parse_radix_width(row._0, row._1, row._2), row._3, reason="the radix reader's exact result")
    )

    it_prop("finite f64 shortest text preserves all bits", cases=100, examples=[
        Finite { bits: 0 },
        Finite { bits: 0x8000000000000000 },
        Finite { bits: 1 },
        Finite { bits: 0x8000000000000001 },
        Finite { bits: 0x000fffffffffffff },
        Finite { bits: 0x0010000000000000 },
        Finite { bits: 0x3fb999999999999a },
        Finite { bits: 0x3ff0000000000001 },
        Finite { bits: 0x7fefffffffffffff },
        Finite { bits: 0xffefffffffffffff },
    ], prop=fn!(sample: Finite):
        value := f64::from_bits(sample.bits)
        assert(value.is_finite(), reason="the generator always supplies a finite value")
        found := value.to_string().parse::[f64]().expect("finite display parses")
        assert_equal(found.to_bits(), sample.bits, reason="IEEE bits are an independent exact-value oracle")
    )

    it_each("float grammar and IEEE adversaries", float_edges(), body=fn!(row: (string, FloatExpected)):
        check_float(row._0, row._1)
    )
