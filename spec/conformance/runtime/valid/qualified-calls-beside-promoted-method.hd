# test: a trait method of the outer type and a promoted method of the same name are reached by qualified calls
use std.testing.assert_equal

trait Describe:
    fn describe(self) -> string

data Base:
    name: string

impl Base:
    fn describe(self) -> string:
        "base " + self.name

data Page:
    Base

impl Describe for Page:
    fn describe(self) -> string:
        "page " + self.Base.name

test "trait-qualified and path-qualified calls":
    page := Page { Base: ...Base { name: "home" } }
    assert_equal(Describe::describe(page), "page home", reason="trait-qualified call")
    assert_equal(page.Base.describe(), "base home", reason="qualified call reaches Base")
