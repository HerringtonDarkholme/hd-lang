# test: an erased error reference keeps its recovery payload through a generic context
# Spec 09 Trait Values As Bounds: trait.dyn.bound.reference; Error Trait: trait.error.inherent-recovery.reference-values.
# expect-stdout: 3
use std.error.Error
@error("inner")
struct UserError:
    count: i32
fn wrapped[E < Error & 'static](error: E) -> *dyn Error:
    let result: Result[void, E] = .Err(error)
    match result.context("outer"):
        .Err(failure) => failure
        .Ok(_) => panic("expected an error")
pub fn main() -> void $ Console:
    let original: *dyn Error = box(UserError { count: 3 })
    failure := wrapped(original)
    match failure.find::[UserError]():
        .Some(found) => println(found.count)
        .None => println("none")
