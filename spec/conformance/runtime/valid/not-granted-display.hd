# test: the NotGranted variants of FsError and ProcessError describe the refused resource without host-specific advice
# Spec std/fs File System Errors: std-fs.error.not-granted.plain, std-process.error.display.not-granted.plain.
# expect: test
use std.fs.FsError
use std.path.Path
use std.process.ProcessError
tests:
    use std.testing.assert_equal

    it("a refused path names the path"):
        assert_equal(
            FsError.NotGranted(Path("data/x.csv")).to_string(),
            "access to data/x.csv is not granted",
            reason="plain denial without host-specific advice",
        )

    it("a refused program describes the denial"):
        assert_equal(
            ProcessError.NotGranted.to_string(),
            "program not granted",
            reason="plain program denial",
        )
