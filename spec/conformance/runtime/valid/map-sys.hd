# test: ScriptedSys answers each Sys method from its key, reads cpu_count as a count, and reports a missing key as Unsupported
# Spec std/host Map Sys: std-host.sys.map.new, std-host.sys.map.cpu-count, std-host.sys.map.missing, std-host.error.not-granted-display.
# Also covers std-host.sys.decl, std-host.sys.os, std-host.sys.arch,
# std-host.sys.hostname, std-host.sys.cpu-count, std-host.sys.plain,
# std-host.sys.unsupported, std-host.error.traits, std-host.sys.map.decl,
# and std-host.sys.map.no-host.
# expect: test
use std.host.{ScriptedSys, Sys, HostError}
fn platform() -> string $ Sys:
    match $.use(Sys).os():
        .Ok(name) => name
        .Err(_) => "unknown"

tests:
    use std.testing.assert_equal

    it("reads the mapped system"):
        $.with(Sys=ScriptedSys::new({ "os": "linux", "cpu_count": "8" })):
            assert_equal(platform(), "linux", reason="the mapped os")
            assert_equal($.use(Sys).cpu_count(), .Ok(8), reason="parsed as a count")
            assert_equal(
                $.use(Sys).hostname(),
                .Err(HostError.Unsupported("hostname")),
                reason="not in the map",
            )

    it("a value that is no count is Unsupported"):
        $.with(Sys=ScriptedSys::new({ "cpu_count": "many" })):
            assert_equal(
                $.use(Sys).cpu_count(),
                .Err(HostError.Unsupported("cpu_count")),
                reason="not a decimal u32",
            )
            assert_equal($.use(Sys).arch(), .Err(HostError.Unsupported("arch")), reason="no key")

    it("a refused read names the method"):
        assert_equal(
            HostError.NotGranted("hostname").to_string(),
            "sys access to hostname is not granted",
            reason="plain denial without host-specific advice",
        )
