# test: an object keeps its keys in insertion order, and a duplicate key keeps its first position with the last value
# Spec std/json Parsing, Writing: std-json.parse.object.order, std-json.parse.object.duplicate, std-json.display.compact (JSON-SURFACE; task #226).
use std.json.{parse, Json}
use std.testing.{assert_equal}

fn read(text: string) -> Json:
    match parse(text):
        .Ok(value) => value
        .Err(_) => panic("parse failed for $text")

fn keys(value: Json) -> List[string]:
    match value:
        .Object(fields) =>
            let names: mut List[string] = []
            for entry in fields:
                names.push(entry._0)
            names
        _ => panic("not an object")

tests:
    it("keys come back in the order the text wrote them"):
        assert_equal(keys(read("{\"b\":1,\"a\":2,\"c\":3}")), ["b", "a", "c"], reason="parse order")
        assert_equal("${read("{\"b\":1,\"a\":2,\"c\":3}")}", "{\"b\":1,\"a\":2,\"c\":3}", reason="Display order")

    it("a duplicate key keeps its first position and takes the last value"):
        value := read("{\"b\":1,\"a\":2,\"b\":3}")
        assert_equal(keys(value), ["b", "a"], reason="first position")
        assert_equal("${value}", "{\"b\":3,\"a\":2}", reason="last value")
        assert_equal(value.get("b"), .Some(read("3")), reason="get")

    it("an object built from a map prints in the map's order"):
        let fields: mut Map[string, Json] = {}
        fields["z"] = Json.Bool(true)
        fields["a"] = Json.Null
        fields["m"] = Json.Array([])
        assert_equal("${Json.Object(fields)}", "{\"z\":true,\"a\":null,\"m\":[]}", reason="insertion order")

    it("nested objects keep their order at every level"):
        text := "{\"y\":{\"q\":1,\"p\":2},\"x\":[{\"b\":0,\"a\":0}]}"
        assert_equal("${read(text)}", text, reason="nested")
        assert_equal(read(text).pretty(), "{\n  \"y\": {\n    \"q\": 1,\n    \"p\": 2\n  },\n  \"x\": [\n    {\n      \"b\": 0,\n      \"a\": 0\n    }\n  ]\n}", reason="pretty")
