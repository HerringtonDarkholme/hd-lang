# test: an object's keys follow its map's deterministic order, and a duplicate key keeps one entry with the last value
# Spec std/json Values, Parsing, Writing: std-json.value.object-map-order, std-json.parse.object.duplicate-last, std-json.display.compact (JSON-SURFACE; task #226).
use std.json.{parse, Json}
use std.testing.{assert, assert_equal}

fn read(text: string) -> Json:
    match parse(text):
        .Ok(value) => value
        .Err(_) => panic("parse failed for $text")

fn keys(value: Json) -> List[string]:
    match value:
        .Object(fields) =>
            let names: mut List[string] = []
            for entry in fields:
                names.push(entry._0)
            names
        _ => panic("not an object")

tests:
    it("a parsed object has each key once, in the same order every time"):
        value := read("{\"b\":1,\"a\":2,\"c\":3}")
        assert_equal(keys(value).sorted(), ["a", "b", "c"], reason="each key once")
        assert_equal("${value}", "${value}", reason="the same text every time")
        assert(read("${value}") == value, reason="the text round-trips")

    it("a duplicate key keeps one entry and takes the last value"):
        value := read("{\"b\":1,\"a\":2,\"b\":3}")
        assert_equal(keys(value).sorted(), ["a", "b"], reason="one entry per key")
        assert_equal(value.get("b"), .Some(read("3")), reason="last value")

    it("an object built from a map prints in the map's order"):
        let fields: mut Map[string, Json] = {}
        fields["z"] = Json.Bool(true)
        fields["a"] = Json.Null
        object := Json.Object(fields)
        text := "${object}"
        assert(text == "{\"z\":true,\"a\":null}" || text == "{\"a\":null,\"z\":true}", reason="both keys, in the map's order")

    it("one-key objects keep their text at every level"):
        text := "{\"y\":[{\"b\":{\"q\":1}}]}"
        assert_equal("${read(text)}", text, reason="nested")
        assert_equal(read(text).pretty(), "{\n  \"y\": [\n    {\n      \"b\": {\n        \"q\": 1\n      }\n    }\n  ]\n}", reason="pretty")
