use std.testing.assert

tests:
    it("map iterator yields each entry once"):
        let values: mut Map[string, i32] = {"first": 1, "second": 2}
        let iterator: mut Iterator[(string, i32)] = values.iter()
        let first: (string, i32)? = ("first", 1)
        let second: (string, i32)? = ("second", 2)
        let exhausted: (string, i32)? = .None
        one := iterator.next()
        two := iterator.next()
        assert((one == first && two == second) || (one == second && two == first), reason="both entries, in the map's order")
        assert(iterator.next() == exhausted, reason="the exhausted map iterator returns .None")

    it("map value replacement preserves an iterator and changes a later yield"):
        let values: mut Map[string, i32] = {"first": 1, "second": 2}
        let iterator: mut Iterator[(string, i32)] = values.iter()
        let first: (string, i32)? = ("first", 1)
        let later = "first"
        if iterator.next() == first:
            later = "second"
        values[later] = 42
        let replacement: (string, i32)? = (later, 42)
        assert(iterator.next() == replacement, reason="replacement does not invalidate the iterator")
