# test: an optional value may be erased to Any like any other enum value
# expect: test
# Spec 09 Traits: trait.any.all, trait.any.optional.

use std.testing.assert_equal

tests:
    it("optionals convert to Any"):
        let present: i32? = 1
        let absent: i32? = .None
        let values: List[dyn Any] = [present, absent, 3]
        assert_equal(values.len(), 3, reason="three erased values")
