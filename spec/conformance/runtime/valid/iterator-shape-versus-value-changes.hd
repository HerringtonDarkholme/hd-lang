# test: a map loop does not see a value replaced during it; an iterator taken after removal and reinsertion sees the new shape
# expect: test
tests:
    use std.testing.{assert, assert_equal}

    it("replacing a later map value during for is not seen by the loop"):
        let mut values: Map[string, i32] = { "a": 1, "b": 2, "c": 3 }
        let mut seen: List[i32] = []
        let first = true
        for (name, value) in values:
            if first:
                first = false
                for other in ["a", "b", "c"]:
                    if other != name:
                        values[*other] = 30
            seen.push(value)
        assert_equal(seen, [1, 2, 3], reason="the loop reads the values it began with")
        assert_equal(values["c"], 30, reason="the replacement reached the map")

    it("an iterator created after removal and reinsertion sees both keys"):
        let mut values: Map[string, i32] = { "a": 1, "b": 2 }
        _ := values.remove("a")
        values["a"] = 3
        let mut names: List[string] = []
        let total = +0
        for (name, value) in values:
            names.push(name)
            total = total + value
        assert_equal(names.sorted(), ["a", "b"], reason="each key once")
        assert_equal(total, 5, reason="the reinserted value replaced the old one")

    it("an iterator created after removal is valid"):
        let mut values: Map[string, i32] = { "a": 1, "b": 2 }
        _ := values.remove("a")
        let mut iterator = values.iter()
        let expected: (string, i32)? = ("b", 2)
        assert(iterator.next() == expected, reason="fresh iterator sees the new shape")

    it("an iterator created after growth sees the new element"):
        let mut values: List[i32] = [1]
        values.push(2)
        let mut iterator = values.iter()
        _ := iterator.next()
        let second: i32? = 2
        assert(iterator.next() == second, reason="fresh iterator sees the appended element")
