# test: a generic suffix takes N from the literal or from the expected type
# Spec 14 Member-Typed Facts: annot.typed-fact.monomorphic; spec 09 Numeric Traits: trait.num.from-i64-checked (Operator Traits OP9, OP10).
use std.num.Num
use std.ops.num_suffix
@num_suffix
fn k[N < Num](n: N) -> N:
    n * N::from_i64(1000)

fn wide() -> i64:
    let limit: i64 = 5k
    limit

tests:
    use std.testing.assert_equal

    it("scales the literal"):
        assert_equal(wide(), 5000, reason="N is i64 from the expected type")
        assert_equal(2k, 2000, reason="N is usize, the literal's fallback type")
        assert_equal(1.5k, 1500.0, reason="N is f64 from the literal")
