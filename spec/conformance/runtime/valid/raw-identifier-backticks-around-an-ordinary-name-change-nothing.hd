# test: backticks around an ordinary name change nothing
# Spec lang/01-lexical-structure.md: lex.raw.not-reserved.
# expect-stdout: 4
# expect-stdout: 5
# expect-stdout: 6
# expect-stdout: 10
# expect-stdout: 2

struct Point:
    x: i32

fn twice(value: i32) -> i32: value * 2

pub fn main() -> void $ Console:
    name := +4
    println(`name`)
    `other` := +5
    println(other)
    println(`twice`(`value` = 3))
    println(twice(value = `other`))
    p := Point { `x`: +1 }
    println(p.x + p.`x`)
