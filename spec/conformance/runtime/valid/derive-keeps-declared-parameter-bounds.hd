# test: a derived implementation keeps every bound the type declares on its parameters
# Spec 14 Derived Bounds: annot.bound.declared.
@derive(Eq, Debug)
struct Pair[T < Eq & Debug]:
    left: T
    right: T

fn same[T < Eq & Debug](a: Pair[T], b: Pair[T]) -> bool:
    a == b && debug(a) == debug(b)

tests:
    use std.testing.assert

    it("both derived implementations hold under the declared two-trait bound"):
        assert(same(Pair { left: 1, right: 2 }, Pair { left: 1, right: 2 }), reason="equal pairs")
        assert(
            !same(Pair { left: 1, right: 2 }, Pair { left: 2, right: 1 }),
            reason="different pairs",
        )
