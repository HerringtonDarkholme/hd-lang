# test: defer runs after a return value is evaluated
# Spec 06 Return and std Operations, Library Defer:
# flow.return.value, flow.return.type, std-ops.defer.cleanup.

use std.ops.defer

fn main() -> i32:
    let value = +1
    defer(fn() -> void: value = value + 10)
    return value

tests:
    use std.testing.assert_equal

    it("main returns 1"):
        assert_equal(main(), 1, reason="defer runs after a return value is evaluated")
