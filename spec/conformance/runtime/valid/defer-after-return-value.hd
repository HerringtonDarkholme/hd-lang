# test: defer runs after a return value is evaluated
# Spec 06 Return And Defer: flow.return.value, flow.return.type,
# flow.defer.register, flow.defer.run, flow.defer.result-saved,
# flow.defer.operands.

use std.testing.assert_equal

fn main() -> i32:
    let value = +1
    defer:
        value = value + 10
    return value

tests:
    it("main returns 1"):
        assert_equal(main(), 1, reason="defer runs after a return value is evaluated")
