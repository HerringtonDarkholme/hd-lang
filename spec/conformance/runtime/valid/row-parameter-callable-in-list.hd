# test: a callable stored in a list keeps its requirement row through a row-polymorphic function
# Spec 11 Requirement Polymorphism: req.poly.row-parameter; R is the stored callback's row, and the caller's provider reaches it.
trait Inventory:
    fn stock(self) -> i32

data Warehouse: pass

impl Inventory for Warehouse:
    fn stock(self) -> i32: 42

fn count_stock() -> i32 $ Inventory:
    $.use(Inventory).stock()

fn run_first[T, $R](jobs: List[fn() -> T $ R]) -> T $ R:
    job := jobs[0]
    job()

tests:
    use std.testing.assert_equal

    it("the stored callback reads the caller's provider"):
        $.with(Inventory=Warehouse {}):
            assert_equal(run_first([count_stock]), 42, reason="R is Inventory")
