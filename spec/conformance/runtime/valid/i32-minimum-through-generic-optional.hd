# test: i32 minimum returned through a generic and an optional unwrap
# expect: test
use std.testing.assert_equal

fn pass_through[T](value: T) -> T:
    value

fn through_generic() -> i32:
    let minimum: i32 = -2147483648
    boxed := pass_through(minimum)
    let maybe: i32? = boxed
    match maybe:
        value? => pass_through(value)
        nil => 0

test "i32 minimum survives a generic and an optional":
    assert_equal(through_generic(), -2147483648, reason="minimum survives a generic round trip and an optional unwrap")
