# test: a break in a nested loop targets that loop, so the outer infinite loop still has type never
# Spec 06 Infinite Loops: flow.while.infinite.exit, flow.break.
# expect: test
use std.testing.assert_equal

fn first_row_total(rows: List[List[i32]], limit: i32) -> i32:
    let row = 0
    while true:
        let total = +0
        for value in rows[row]:
            if value < 0:
                break
            total = total + value
        if total >= limit:
            return total
        row = row + 1

fn countdown(start: i32) -> i32:
    let steps = +0
    while true:
        let left = start
        while true:
            if left == 0:
                break
            left = left - 1
            steps = steps + 1
        return steps

tests:
    it("an inner break leaves the outer loop running"):
        assert_equal(first_row_total([[1, -1, 9], [5, 6]], 10), 11, reason="the second row reaches the limit")

    it("an inner infinite loop's break does not exit the outer one"):
        assert_equal(countdown(3), 3, reason="the outer loop returns")
