# test: an explicit type argument or an expected type picks among several instantiations of the bound's trait
# Spec 04 Inference Through A Bound: types.generic.infer.bound.precedence and .placeholder (owner decision BOUND-INFERENCE, batch 77, 2026-10-03).
trait Source[T]:
    fn take(self) -> T

data Both:
    count: i32

impl Source[i32] for Both:
    fn take(self) -> i32:
        self.count

impl Source[string] for Both:
    fn take(self) -> string:
        "both"

fn read[U, S < Source[U]](source: S) -> U:
    source.take()

fn label(both: Both) -> string:
    text := read::[string, _](both)
    text

fn count(both: Both) -> i32:
    let total: i32 = read(both)
    total

tests:
    use std.testing.assert_equal

    it("the explicit argument and the expected type each choose one instantiation"):
        assert_equal(label(Both { count: 3 }), "both", reason="U is string, written")
        assert_equal(count(Both { count: 3 }), 3, reason="U is i32, from the expected type")
