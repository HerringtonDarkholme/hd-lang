# test: generic inference scalars and data

use std.testing.assert_equal

data Box:
    value: i32

fn identity[T](value: T) -> T: value

fn choose[T](left: T, right: T) -> T: left

fn float_value() -> f64: identity(3.5)

fn main() -> i32:
    number := identity(+40)
    text := identity("hd")
    box := identity(Box { value: +2 })
    if text == "hd": choose(number + box.value, 42) else: 0

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="generic inference scalars and data")

    it("float_value returns 3.5"):
        assert_equal(float_value(), 3.5, reason="generic inference scalars and data")
