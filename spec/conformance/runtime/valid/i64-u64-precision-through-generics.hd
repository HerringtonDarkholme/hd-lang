# test: i64 and u64 values beyond 2^53 survive erasure exactly
# expect: test
use std.testing.{assert, assert_equal}

fn pass_through[T](value: T) -> T:
    value

test "large 64-bit integers keep every digit":
    let largest: i64 = 9223372036854775807
    let smallest: i64 = -9223372036854775808
    let odd: i64 = 9007199254740993
    let unsigned: u64 = 18446744073709551615
    kept := pass_through(largest)
    assert_equal("$kept", "9223372036854775807", reason="i64 max through a generic")
    assert(kept - 1 != kept, reason="no precision loss")
    assert_equal("${[smallest][0]}", "-9223372036854775808", reason="i64 min through a list")
    assert_equal("${pass_through(odd)}", "9007199254740993", reason="2^53 + 1 is exact")
    assert(pass_through(odd) != 9007199254740992, reason="2^53 + 1 differs from 2^53")
    assert_equal("${pass_through(unsigned)}", "18446744073709551615", reason="u64 max through a generic")
    let maybe: u64? = unsigned
    match maybe:
        value? => assert_equal(value, unsigned, reason="optional payload keeps u64 max")
        nil => panic("optional lost its payload")
