# test: pointer loans, adversarial: seventy objects each over 31 shared loans at once, which a `&mut` elsewhere keeps; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Cell:
    value: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn hold(ps: &List[*Cell], w: *mut Cell, k: usize, n: usize) -> usize:
    if k == ps.len():
        return 0
    p := ps[k]
    r := &p.value
    below := if n == 0: hold(ps, w, k + 1, 32) else: hold(ps, w, k, n - 1)
    if k > 100000:
        m := &mut w.value
        *m = fresh()
    r.len() + below

pub fn main() -> void $ Console:
    let mut ps: List[*Cell] = []
    for _ in 0..70:
        ps.push(box(Cell { value: orig() }))
    w := box(Cell { value: fresh() })
    if hold(&ps, w, 0, 32) != 70 * 33 * orig().len():
        panic("the nested reads disagree")
    w.value = orig()
    println("ok")
