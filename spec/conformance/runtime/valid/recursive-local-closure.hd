# test: explicitly typed local closures recurse through their current environment
# Spec 07 Recursive Closures: fn.recursion.closure.no-self-name,
# fn.recursion.closure.binding, fn.recursion.closure.result,
# fn.recursion.closure.parameters, fn.recursion.closure.check,
# fn.recursion.closure.outer, fn.recursion.closure.ordinary-binding,
# fn.recursion.closure.initialized.

use std.testing.assert_equal

fn main() -> i32:
    sum := fn(value: i32) -> i32:
        if value == 0:
            0
        else:
            value + sum(value - 1)
    sum(9) - 3

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="explicitly typed local closures recurse through their current environment")
