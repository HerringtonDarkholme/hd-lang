# fixture-runtime-profile: tick
# fixture-runtime-scenario: pending-first-poll
# test: dynamic suspending trait methods resume after a pending host call
use std.testing.assert_equal

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

trait Reader:
    fn read!(self, value: i32) -> i32 $ Console + Tick

struct FixedReader:
    offset: i32

impl Reader for FixedReader:
    fn read!(self, value: i32) -> i32 $ Console + Tick:
        let mut console = $.use(Console)
        $.use(Tick).tick!("read ${value}\n")
        _ := console.write_sync("read ${value}\n")
        self.offset + value

fn combine!(reader: &dyn Reader) -> i32 $ Console + Tick:
    reader.read!(20) + reader.read!(22)

pub fn main!() -> void $ Console + Tick:
    assert_equal(combine!(&FixedReader { offset: 0 }), 42, reason="both dynamic reads complete")
    assert_equal(combine!(&FixedReader { offset: 1 }), 44, reason="the offset applies to each read")
