# test: an integer cast keeps the low bits, so 300 as u8 is 44 and 200 as i8 is -56
# Spec 04 Numeric Conversions: types.cast.wrap.example.
fn byte(value: i32) -> u8: u8(value)
fn signed_byte(value: i32) -> i8: i8(value)

tests:
    use std.testing.assert_equal

    it("wraps to the target width"):
        assert_equal(byte(+300), u8(44), reason="300 keeps its low byte, 44")
        assert_equal(signed_byte(+200), i8(-56), reason="200 read as an i8 is -56")
