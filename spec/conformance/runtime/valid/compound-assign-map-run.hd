# test: += on a present map entry reads it as V, then stores the sum
# Spec 05 Compound Assignment and Map Indexing: expr.assign.compound.index-place, expr.index.map.read-value (evening follow-up 5, 2026-09-29; SSC Q8, batch 26).
fn count(words: List[string]) -> Map[string, i32]:
    let mut counts: Map[string, i32] = { "a": 0, "b": 0 }
    for word in words:
        counts[word] += 1
    counts

fn grow(counts: &mut Map[string, i64]) -> i64:
    for i in 0..16:
        counts["new_$i"] = i64(i)
    counts["target"] = 100
    2

tests:
    use std.testing.assert_equal

    it("adds to present entries"):
        counts := count(["a", "b", "a"])
        assert_equal(counts["a"], 2, reason="two a")
        assert_equal(counts["b"], 1, reason="one b")

    it("replaces a counted value and preserves a shared map"):
        for round in 0..3:
            key := "key_$round"
            let mut words = { key: "old_$round" }
            before := words
            words[key] += "_new"
            assert_equal(words[key], "old_${round}_new")
            assert_equal(before[key], "old_$round")
            assert_equal(words.len(), 1)

    it("looks up again after the right side grows the map"):
        let mut counts = { "target": 3i64 }
        counts["target"] += grow(&mut counts)
        assert_equal(counts["target"], 5i64)
        assert_equal(counts.len(), 17)
