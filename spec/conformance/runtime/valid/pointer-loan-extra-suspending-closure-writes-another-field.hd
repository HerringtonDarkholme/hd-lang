# test: pointer loans, adversarial: a suspending closure writes another field through its creator's pointer, across a suspension, while the creator's reference lives; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.time.{Clock, ms, sleep}

struct Cell:
    value: string
    other: string

fn run!(f: fn!() -> void $ Clock) -> void $ Clock:
    f!()

fn run_plain(f: fn() -> void) -> void:
    f()

pub fn main!() -> void $ Console + Clock:
    p := box(Cell { value: "a", other: "o" })
    r := &p.other
    run_plain(fn() -> void: p.value = "b")
    run!(fn!() -> void $ Clock:
        sleep!(ms(1))
        p.value = "c"
    )
    if *r != "o" || p.value != "c":
        panic("the writes disagree")
    println("ok")
