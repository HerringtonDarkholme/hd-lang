# test: closures mutate captured storage and captured mutable objects; readers observe later writes
# expect: test
use std.testing.assert_equal

data User:
    name: string

fn rename(user: mut User) -> void:
    user.name = "renamed"

test "a closure updates captured let storage shared with its scope":
    let count: i32 = 0
    let next: fn() -> i32 = fn() -> i32:
        count = count + 1
        count
    _ := next()
    second := next()
    assert_equal(second, 2, reason="closure state persists between calls")
    assert_equal(count, 2, reason="the defining scope sees the captured writes")

test "a closure reads through a readonly view and sees later writes":
    let user: mut User = User { name: "Ada" }
    read := fn() -> string: user.name
    user.name = "Grace"
    assert_equal(read(), "Grace", reason="readonly view is not a snapshot")

test "a closure mutates a captured mutable object":
    let user: mut User = User { name: "Ada" }
    rename_it := fn() -> void: rename(user)
    rename_it()
    assert_equal(user.name, "renamed", reason="mutation through the capture is visible")
