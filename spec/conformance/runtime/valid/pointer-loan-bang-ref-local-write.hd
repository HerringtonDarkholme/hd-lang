# test: pointer loans: a `&` to a field of a local struct, held across a bang call that suspends and acts; an alias writes the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: no *T; keep-alive (B): runs.
use std.time.{Clock, sleep}

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

fn act!(alias: *mut Cell) -> string $ Clock:
    sleep!(1ms)
    alias.value = fresh()
    junk := churn()
    _ := junk.len()
    "acted"

fn probe!(alias: *mut Cell) -> string $ Clock:
    let mut own = Cell { value: orig(), other: second() }
    r := &own.value
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Clock:
    other := make()
    seen := probe!(other)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
