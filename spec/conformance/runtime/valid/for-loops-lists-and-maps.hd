# test: for loops iterate lists and maps with continue, destructuring, and else values
# Spec 06 For Loops: flow.for.iterable-once, flow.for.fresh-iterator,
# flow.for.binding, flow.for.iterator-next, flow.for.iterator-exhausted,
# flow.for.iterable, flow.for.list, flow.for.map.entries,
# flow.for.map.value, flow.continue, flow.break.boundary,
# flow.loop.else.value, flow.loop.else.break-value,
# flow.loop.else.exhaustion, flow.loop.else.plain-break,
# flow.loop.else.continue.

use std.testing.assert_equal

fn load!() -> List[i32]: [1, 2, 3]

fn first_or(values: List[i32]) -> i32:
    for value in values:
        break value
    else:
        1

fn main!() -> i32:
    let total = +0
    for value in load!():
        if value == 2:
            continue
        total = total + value
    scores := {"a": +10, "b": 20}
    for (key, score) in scores:
        if key.len() == 1:
            total = total + score
    for entry in {"c": +7}:
        total = total + entry._1
    let cleanup = +0
    for value in [+1, 2]:
        defer:
            cleanup = cleanup + 10
        if value == 1:
            continue
        break
    if total + first_or([]) == 42 && cleanup == 20:
        42
    else:
        0

tests:
    it("main returns 42"):
        assert_equal(main!(), 42, reason="for loops iterate lists and maps with continue, destructuring, and else values")
