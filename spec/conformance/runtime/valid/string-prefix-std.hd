# test: the standard prefix r joins raw text with the values' Display text
# Spec 05 Prefixed Strings: r keeps every backslash and processes no escape.
# expect: test
use std.text.r
use std.testing.assert_equal

tests:
    it("r keeps backslashes and interpolates Display text"):
        name := "Ada"
        count := 3
        assert_equal(r"\d+ $name ${count + 1}", "\\d+ Ada 4", reason="raw text and values")
        assert_equal(r"say \"hi\"", "say \\\"hi\\\"", reason="the backslash stays")
        assert_equal(r"^\d+$", "^\\d+\$", reason="a final dollar is text")
        assert_equal(r"\$name", "\\\$name", reason="an escaped dollar is text")
