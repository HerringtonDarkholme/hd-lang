# test: pointer loans, adversarial: passing the pointer to a callee that only reads is no access; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn peek(alias: *mut Cell) -> usize:
    alias.other.len()

fn probe(p: *mut Cell, alias: *mut Cell) -> string:
    r := &p.value
    _ := peek(alias)
    *r

pub fn main() -> void $ Console:
    p := box(Cell { value: orig(), other: fresh() })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
