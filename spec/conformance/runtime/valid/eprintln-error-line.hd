# test: eprintln writes through write_error_sync of the covering Console provider
# Spec std/console Standard Error: std-console.eprintln.one-write-sync (batch 64, STD-4).
use std.console.eprintln
struct SplitConsole:
    out: List[string]
    err: List[string]

impl Console for SplitConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.out.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.err.push(text)
        .Ok(())

fn warn(message: string) -> void $ Console:
    eprintln("warning: ${message}")

fn report(count: i32) -> void $ Console:
    println("done")
    warn("${count} skipped")

tests:
    use std.testing.assert_equal

    it("eprintln and println reach different methods"):
        console := box(SplitConsole { out: [], err: [] })
        $.with(Console=console):
            report(2)
        assert_equal(console.out, ["done", "\n"], reason="println uses write_sync")
        assert_equal(console.err, ["warning: 2 skipped\n"], reason="eprintln uses write_error_sync")
