# test: eprintln writes through write_error! of the covering Console provider
# Spec std/console Standard Error: std-console.eprintln.one-write (batch 64, STD-4).
use std.console.eprintln
struct SplitConsole:
    out: List[string]
    err: List[string]

impl Console for SplitConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.out.push(text)
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.err.push(text)
        .Ok(())

fn warn(message: string) -> void $ Console:
    eprintln("warning: ${message}")

fn report(count: i32) -> void $ Console:
    println("done")
    warn("${count} skipped")

tests:
    use std.testing.assert_equal

    it("eprintln and println reach different methods"):
        let mut console = SplitConsole { out: [], err: [] }
        $.with(Console=&mut console):
            report(2)
        assert_equal(console.out, ["done\n"], reason="println uses write!")
        assert_equal(console.err, ["warning: 2 skipped\n"], reason="eprintln uses write_error!")
