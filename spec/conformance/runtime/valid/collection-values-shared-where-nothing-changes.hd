# test: a list a binding shares with a source no change reaches is still a value of its own wherever a result keeps it
# Spec 04 Collection Values: types.coll.value, types.coll.let-mut, fn.param.mut.copy.
fn passthrough(items: List[i32], replace: bool) -> List[i32]:
    let mut out = items
    if replace:
        out = [+9]
    out

fn made() -> List[i32]:
    xs := [+1, 2]
    xs

fn entry(m: Map[string, List[i32]]) -> List[i32]:
    found := m["k"]
    found

fn replaced(mut xs: List[i32]) -> usize:
    xs = [+7]
    xs.len()

fn doubled(xs: List[i32]) -> List[i32]:
    out := [for x in xs => x * 2]
    out

fn counted(mut xs: List[i32]) -> i32:
    before := xs
    n := before.len()
    first := before[0]
    xs.push(9)
    first + i32(n) + xs[2]

tests:
    use std.testing.assert_equal

    it("a let mut binding that is only replaced still returns a value of its own"):
        let mut a = [+1]
        b := passthrough(a, false)
        a.push(2)
        assert_equal(b, [+1], reason="the result is its own list")
        assert_equal(a, [+1, 2], reason="the source changed")
        assert_equal(passthrough(a, true), [+9], reason="the replacement")

    it("a result that only ever held a new list changes on its own"):
        let mut b = made()
        b.push(3)
        assert_equal(b, [+1, 2, 3], reason="the result changed")
        assert_equal(made(), [+1, 2], reason="a new call makes a new list")

    it("a map value bound and returned is a value of its own"):
        let mut m: Map[string, List[i32]] = {"k": [+1]}
        y := entry(m)
        m["k"].push(2)
        assert_equal(y, [+1], reason="the result is its own list")
        assert_equal(m["k"], [+1, 2], reason="the map's list changed")

    it("a mut parameter that is only replaced leaves the caller's list alone"):
        xs := [+1, 2]
        assert_equal(replaced(xs), 1, reason="the parameter was replaced")
        assert_equal(xs, [+1, 2], reason="the caller's list is unchanged")

    it("a list a comprehension built moves into its binding and out as the result"):
        let mut source = [+1, 2]
        let mut result = doubled(source)
        result.push(9)
        source.push(3)
        assert_equal(result, [+2, 4, 9], reason="the result changed alone")
        assert_equal(source, [+1, 2, 3], reason="the source changed alone")

    it("a binding read only before its source changes sees the value it took"):
        assert_equal(counted([+1, 2]), 12, reason="both reads came before the push")
