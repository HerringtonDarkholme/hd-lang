# test: recursion through an annotated function is valid
# Spec lang/07-functions.md: fn.decl.omitted-cycle.resolve.
# expect-stdout: true false

fn is_even(n: i32) -> bool:
    if n == 0: true
    else: is_odd(n - 1)

fn is_odd(n: i32):
    if n == 0: false
    else: is_even(n - 1)

pub fn main() -> void $ Console:
    println("${is_odd(3)} ${is_odd(4)}")
