# test: the checked, wrapping, saturating, and abs_diff methods exist on every integer width
# Spec std/num Checked Arithmetic: std-num.methods.every-width, with std-num.abs-diff.i8 to std-num.abs-diff.u64 (batch 68, INT-WIDTHS; task #219).
tests:
    use std.testing.assert_equal

    it("i8"):
        let low: i8 = -128
        assert_equal(low.checked_sub(1), .None, reason="checked_sub overflows")
        assert_equal(low.checked_div(-1), .None, reason="the minimum divided by -1")
        assert_equal(low.wrapping_sub(1), 127, reason="wraps to the maximum")
        assert_equal(low.saturating_sub(1), -128, reason="saturates at the minimum")
        let gap: u8 = low.abs_diff(127)
        assert_equal(gap, 255, reason="abs_diff is u8")

    it("i16"):
        let high: i16 = 32767
        assert_equal(high.checked_add(1), .None, reason="checked_add overflows")
        assert_equal(high.checked_mul(2), .None, reason="checked_mul overflows")
        assert_equal(high.wrapping_add(1), -32768, reason="wraps to the minimum")
        let gap: u16 = high.abs_diff(-32768)
        assert_equal(gap, 65535, reason="abs_diff is u16")

    it("i64"):
        let high: i64 = 9223372036854775807
        assert_equal(high.saturating_add(1), 9223372036854775807, reason="saturates at the maximum")
        assert_equal(high.wrapping_add(1).checked_sub(1), .None, reason="wraps to the minimum")

    it("u8"):
        let byte: u8 = 250
        assert_equal(byte.checked_add(5), .Some(255), reason="the sum fits")
        assert_equal(byte.checked_add(10), .None, reason="the sum overflows")
        assert_equal(byte.wrapping_add(10), 4, reason="wraps past 255")
        assert_equal(byte.checked_div(255), .Some(0), reason="no unsigned division overflows")
        assert_equal(byte.abs_diff(255), 5, reason="abs_diff is u8")

    it("u16"):
        let zero: u16 = 0
        assert_equal(zero.checked_sub(1), .None, reason="below zero")
        assert_equal(zero.wrapping_sub(1), 65535, reason="wraps to the maximum")
        assert_equal(zero.abs_diff(65535), 65535, reason="abs_diff is u16")

    it("u32"):
        let zero: u32 = 0
        assert_equal(zero.checked_sub(1), .None, reason="below zero")
        assert_equal(zero.wrapping_sub(1), 4294967295, reason="wraps to the maximum")
        assert_equal(zero.abs_diff(4294967295), 4294967295, reason="abs_diff is u32")

    it("u64"):
        let three: u64 = 3
        assert_equal(three.checked_mul(6148914691236517205), .Some(18446744073709551615), reason="the product fits")
        assert_equal(three.checked_mul(6148914691236517206), .None, reason="the product overflows")
        assert_equal(three.saturating_sub(4), 0, reason="saturates at zero")
        assert_equal(three.abs_diff(18446744073709551615), 18446744073709551612, reason="abs_diff is u64")
