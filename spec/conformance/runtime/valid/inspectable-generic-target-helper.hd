# test: a generic helper passes its bounded target on to downcast through its own bound
# Spec 09 Recovering A Concrete Type: the Inspectable evidence for T carries its runtime
# identity, so a generic function passes a target on through its own bound.
use std.inspect.Inspectable
use std.testing.assert_equal

data User:
    name: string

data Post:
    title: string

fn first_of[T < AnyRef & Inspectable](items: List[Inspectable]) -> T?:
    for item in items:
        match item.downcast::[T]():
            .Some(found) => return .Some(found)
            .None => pass
    .None

fn first_user_name(items: List[Inspectable]) -> string:
    match first_of::[User](items):
        .Some(user) => user.name
        .None => "none"

fn first_post_title(items: List[Inspectable]) -> string:
    match first_of::[Post](items):
        .Some(post) => post.title
        .None => "none"

tests:
    it("the helper finds the first value of the requested type"):
        let items: List[Inspectable] = [Post { title: "Intro" }, User { name: "Ada" }, User { name: "Grace" }]
        assert_equal(first_user_name(items), "Ada", reason="the first User is found")
        assert_equal(first_post_title(items), "Intro", reason="the first Post is found")

    it("an absent type yields .None"):
        let items: List[Inspectable] = [1, "two"]
        assert_equal(first_user_name(items), "none", reason="no User is present")
