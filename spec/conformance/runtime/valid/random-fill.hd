# test: the free fill returns the covering provider's fill bytes, and hex_encode of it is the token
# Spec std/random Random Source: std-random.fill-free (stdlib redesign #474).
use std.encoding.hex_encode
use std.random.{Random, SeededRandom, fill}

data FixedBytes:
    bytes: List[u8]

impl Random for FixedBytes:
    fn next_u64(mut self) -> u64:
        0
    fn fill(mut self, count: usize) -> List[u8]:
        let out: mut List[u8] = []
        for index in 0..count:
            out.push(self.bytes[index])
        out

fn session() -> string $ Random:
    hex_encode(fill(4))

tests:
    use std.testing.assert_equal

    it("fill is the covering provider's bytes"):
        let mut source = FixedBytes { bytes: [0, 15, 171, 255] }
        let made = ""
        $.with(Random=source):
            made = session()
        assert_equal(made, "000fabff", reason="two lowercase digits per byte")

    it("the count is the number of bytes"):
        let mut source = SeededRandom::new(7)
        let eight = 0
        let none = 1
        $.with(Random=source):
            eight = fill(8).len()
            none = fill(0).len()
        assert_equal(eight, 8, reason="eight bytes")
        assert_equal(none, 0, reason="no bytes")
