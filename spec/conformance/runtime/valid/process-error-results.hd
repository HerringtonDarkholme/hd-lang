# test: run! reports a refused start as .Err, and a non-zero exit status as an ordinary .Ok
# Spec Modules, Processes: module.process.nonzero-ok, module.process.denied, module.process.other, module.process.error-traits.
# expect: test
use std.process.{Command, Process, ProcessError, ProcessOutput}
struct RefusingProcess: pass

impl Process for RefusingProcess:
    fn run!(&mut self, command: Command) -> Result[ProcessOutput, ProcessError]:
        program := command.program
        match program:
            "locked" => .Err(.PermissionDenied(program))
            "broken" => .Err(.Other(message="exec format error"))
            _ => .Ok(ProcessOutput { stdout: "", stderr: "failed", status: 2 })

fn start!(program: string) -> Result[ProcessOutput, ProcessError] $ Process:
    $.use(Process).run!(Command { program: program })

tests:
    use std.testing.assert_equal

    it("a non-zero exit status is .Ok"):
        let mut refusing = RefusingProcess {}
        $.with(Process=&mut refusing):
            match start!("tool"):
                .Ok(output) => assert_equal(output.status, 2, reason="the status is output")
                .Err(_) => assert_equal(true, false, reason="a program that ran is .Ok")

    it("a refused start is .Err"):
        let mut refusing = RefusingProcess {}
        $.with(Process=&mut refusing):
            match start!("locked"):
                .Err(error) =>
                    assert_equal(
                        error == ProcessError.PermissionDenied(program="locked"),
                        true,
                        reason="the variant is PermissionDenied",
                    )
                .Ok(_) => assert_equal(true, false, reason="locked never starts")
            match start!("broken"):
                .Err(error) =>
                    assert_equal(
                        error == ProcessError.Other(message="exec format error"),
                        true,
                        reason="Other keeps its message",
                    )
                .Ok(_) => assert_equal(true, false, reason="broken never starts")
