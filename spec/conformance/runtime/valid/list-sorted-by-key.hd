# test: sorted_by_key and sorted sort stably and leave the list unchanged
# Spec std/collections List Helpers: std-collections.helper.sorted-by-key, .sorted, .stable, and .unchanged.
data Task:
    name: string
    hours: i32

fn names(tasks: List[Task]) -> List[string]:
    tasks.map(fn(task: Task) -> string: task.name)

tests:
    use std.testing.assert_equal

    it("sorts by key, keeping equal keys in order"):
        let tasks: List[Task] = [Task { name: "b", hours: 3 }, Task { name: "a", hours: 1 }, Task { name: "c", hours: 3 }]
        plan := tasks.sorted_by_key(fn(task: Task) -> i32: task.hours)
        assert_equal(names(plan), ["a", "b", "c"], reason="stable")
        assert_equal(names(tasks), ["b", "a", "c"], reason="the receiver is unchanged")
    it("sorts in ascending order"):
        assert_equal([3, 1, 2].sorted(), [1, 2, 3], reason="sorted")
        assert_equal(["b", "a"].sorted(), ["a", "b"], reason="strings")
        let empty: List[i32] = []
        assert_equal(empty.sorted().len(), 0, reason="an empty list")
