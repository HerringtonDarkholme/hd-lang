# test: Any conversion keeps the identity of canonical variants, with or without shared data
# expect: test
use std.testing.assert

enum Color:
    Red
    Green

enum StatusCode(i32):
    Ok -> StatusCode(200)
    NotFound -> StatusCode(404)

test "Any conversion of a canonical variant keeps its identity":
    let first: Any = Color.Red
    let second: Any = Color.Red
    let other: Any = Color.Green
    assert(first is second, reason="a payload-free variant is canonical and is not boxed per conversion")
    assert(!(first is other), reason="different variants differ")

test "a shared-data variant without a payload is canonical":
    first := StatusCode.NotFound
    second := StatusCode.NotFound
    assert(first is second, reason="shared constructor data is not stored in the value")
    assert(first._0 == 404, reason="shared data readable")
    let erased: Any = first
    let erased_other: Any = second
    assert(erased is erased_other, reason="Any conversion keeps the canonical identity")
