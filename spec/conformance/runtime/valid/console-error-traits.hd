# test: ConsoleError implements Eq, Debug, and Display
# Spec std/console Console Errors: std-console.error.traits, std-console.error.debug-coded-payloads.
fn closed(error: ConsoleError) -> bool:
    error == ConsoleError.Closed

tests:
    use std.testing.{assert, assert_equal}

    it("compares, shows, and displays"):
        assert(closed(ConsoleError.Closed), reason="one case")
        assert_equal(
            ConsoleError.Closed,
            ConsoleError.Closed,
            reason="assert_equal needs Eq and Debug",
        )
        assert_equal(
            debug(ConsoleError.Closed),
            "ConsoleError.Closed",
            reason="the qualified case name",
        )
        assert_equal("${ConsoleError.Closed}", "console closed", reason="the Display text")

    it("compares and renders error payloads"):
        denied := ConsoleError.NotGranted(.Stdout)
        other := ConsoleError.Other(1)
        assert_equal(denied, ConsoleError.NotGranted(.Stdout), reason="equal payload")
        assert(denied != ConsoleError.NotGranted(.Stderr), reason="different streams")
        assert(other != ConsoleError.Other(2), reason="different codes")
        assert(denied != other, reason="different variants")
        assert_equal("$denied", "console access to stdout is not granted", reason="denial display")
        assert_equal("$other", "console error 1", reason="other display")
        assert_equal(
            debug(denied),
            "ConsoleError.NotGranted(stream=ConsoleStream.Stdout)",
            reason="named stream",
        )
        assert_equal(debug(other), "ConsoleError.Other(code=1)", reason="named code")
