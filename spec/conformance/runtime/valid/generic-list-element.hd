# test: generic list element

fn first[T](items: List[T]) -> T:
    items[0]

fn main() -> i32:
    numbers := [+40, 2]
    first(numbers) + numbers[numbers.len() - 1]

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="generic list element")
