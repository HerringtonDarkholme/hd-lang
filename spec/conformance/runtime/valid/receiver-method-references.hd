# test: a bound reference to a `&mut self` method takes the receiver's address when it is made, so calling it changes the binding; an unbound one takes `&mut Self` first, and a bound `&self` reference reads the place
# Spec 07 Method References: fn.ref.bound.address, fn.ref.unbound.ref-self, fn.ref.unbound.receiver.
# expect-stdout: 3.0
# expect-stdout: 5.0
# expect-stdout: 5.0
struct Vec2:
    x: f64

impl Vec2:
    fn get_x(&self) -> f64:
        self.x

    fn shift(&mut self, d: f64) -> void:
        self.x += d

pub fn main() -> void $ Console:
    let mut p = Vec2 { x: 1.0 }
    move := Vec2::shift
    move(&mut p, 2.0)
    println("${p.x}")
    step := p::shift
    step(1.0)
    step(1.0)
    println("${p.x}")
    read := p::get_x
    println("${read()}")
