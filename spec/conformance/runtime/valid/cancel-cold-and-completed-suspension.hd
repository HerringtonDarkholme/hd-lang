# test: cancelling a cold or completed suspension performs no cleanup
# expect: test
struct Log:
    text: string

fn work!(log: &mut Log) -> i32:
    defer:
        log.text = log.text + "cleanup;"
    log.text = log.text + "body;"
    7

tests:
    use std.testing.{assert, assert_equal}

    it("cancelling a cold suspension runs neither body nor cleanup"):
        let mut log = &mut Log { text: "" }
        let pending: mut Suspend[i32] = work(log)
        first := pending.cancel!()
        second := pending.cancel!()
        assert_equal(log.text, "", reason="no registered suites exist before the first poll")
        assert(
            first == .Finished && second == .Finished,
            reason="a cold suspension has no cleanup left",
        )

    it("cancelling a completed suspension has no further effect"):
        let mut log = &mut Log { text: "" }
        let pending: mut Suspend[i32] = work(log)
        result := pending!()
        first := pending.cancel!()
        second := pending.cancel!()
        assert(
            first == .Finished && second == .Finished,
            reason="a completed suspension has no cleanup left",
        )
        assert_equal(result, 7, reason="completion value")
        assert_equal(log.text, "body;cleanup;", reason="cleanup ran once, at completion")
