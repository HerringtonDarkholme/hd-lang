# test: homogeneous varargs

use std.testing.assert_equal

fn count(values...: List[i32]) -> i32:
    let total = 0
    for _ in values:
        total = total + 1
    total
fn first_or(values...: List[i32]) -> i32:
    if values.len() == 0:
        9
    else:
        values[0]
fn generic_first[T](values...: List[T]) -> T: values[0]
fn tagged(tag: i32, values...: List[i32]) -> i32: tag * 10 + values[0]
fn main() -> i32:
    items := [4, 5, 6]
    count() + count(1, 2, 3) + first_or() + first_or(items...) + generic_first(6) + tagged([2]..., tag=1)

tests:
    it("main returns 34"):
        assert_equal(main(), 34, reason="homogeneous varargs")
