# test: a literal column's values and ranges are split once, and each arm still matches in order
# Spec 06 Match: flow.match.subject, flow.match.range.inclusive, flow.match.range.half-open,
# flow.match.range.from, flow.match.range.to.
# expect-stdout: very negative|negative|negative|zero|other|even digit|three|even digit
# expect-stdout: five to fifteen|five to fifteen|ten|five to fifteen|twelve|five to fifteen|other
# expect-stdout: big even|twenties|other|big even
# expect-stdout: three three loud nine high low loud
# expect-stdout: origin low|five|five|small|origin|else
# expect-stdout: row one|two three|three or four|three or four|else
# expect-stdout: 1 3 2 4 1 2 3
# expect-stdout: 1 2 3
# expect-stdout: 1 2 3 3
fn kind(a: i32) -> string:
    match a:
        ..-5 => "very negative"
        -5..0 => "negative"
        0 => "zero"
        1..=9 if a % 2 == 0 => "even digit"
        3 => "three"
        10 => "ten"
        12 => "twelve"
        5..=15 => "five to fifteen"
        20.. if a % 2 == 0 => "big even"
        20..=30 => "twenties"
        _ => "other"

fn bucket(a: u8, loud: bool) -> string:
    match a:
        3 => "three"
        7 => "seven"
        0..=200 if loud => "loud"
        9 => "nine"
        201.. => "high"
        _ => "low"

fn pair(a: i32, b: i32) -> string:
    match (a, b):
        (0, 0..=4) => "origin low"
        (_, 5) => "five"
        (1..=3, _) => "small"
        (0, _) => "origin"
        _ => "else"

fn grid(a: i32, b: i32) -> string:
    match (a, b):
        (_, 1) => "row one"
        (2, 3) => "two three"
        (_, 3..=4) => "three or four"
        _ => "else"

fn word(s: string, g: bool) -> i32:
    match s:
        "a" if g => 1
        "b" => 2
        "a" => 3
        _ => 4

fn tag(a: string, b: string) -> i32:
    match (a, b):
        (_, "x") => 1
        ("y", "z") => 2
        _ => 3

fn sign(x: f64) -> i32:
    match x:
        -1.5 => 1
        2.5 => 2
        _ => 3

fn split(a: u8, g: bool) -> i32:
    match a:
        0..=200 if g => 1
        0..=100 => 2
        101..=255 => 3

fn kinds(values: List[i32]) -> string:
    let out = ""
    for v in values:
        if out != "":
            out = out + "|"
        out = out + kind(v)
    out

pub fn main() -> void $ Console:
    println(kinds([-7, -5, -1, 0, 1, 2, 3, 4]))
    println(kinds([5, 9, 10, 11, 12, 15, 16]))
    println(kinds([20, 21, 31, 32]))
    println(
        "${bucket(3, false)} ${bucket(3, true)} ${bucket(9, true)} ${bucket(9, false)} ${bucket(250, true)} ${bucket(100, false)} ${bucket(100, true)}",
    )
    println(
        "${pair(0, 2)}|${pair(0, 5)}|${pair(2, 5)}|${pair(2, 9)}|${pair(0, 9)}|${pair(7, 1)}",
    )
    println("${grid(5, 1)}|${grid(2, 3)}|${grid(5, 3)}|${grid(2, 4)}|${grid(2, 9)}")
    println(
        "${word("a", true)} ${word("a", false)} ${word("b", true)} ${word("c", true)} ${tag("q", "x")} ${tag("y", "z")} ${tag("y", "w")}",
    )
    println("${sign(-1.5)} ${sign(2.5)} ${sign(0.0)}")
    println("${split(50, true)} ${split(50, false)} ${split(150, false)} ${split(250, true)}")
