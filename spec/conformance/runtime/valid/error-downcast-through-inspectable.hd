# test: an erased Error recovers its concrete domain error
# Spec 09 Error Trait: Error extends Inspectable, so downcast_val recovers an enum error from an
# Error value; the inherited downcast takes a trait value target, which never matches.
# Spec 09 Traits: trait.error.defaults, trait.error.complete, trait.error.import, trait.error.no-inspect-import, trait.error.erased, trait.error.downcast, trait.downcast.ordinary.
use std.error.Error
use std.inspect.downcast_val
enum FsError:
    NotFound(path: string)

impl Display for FsError:
    fn to_string(self) -> string:
        match self:
            FsError.NotFound(path) => "not found: " + path

impl Error for FsError

enum HttpError:
    Status(code: i32)

impl Display for HttpError:
    fn to_string(self) -> string:
        match self:
            HttpError.Status(code) => "status ${code}"

impl Error for HttpError

fn missing_path(error: dyn Error) -> string:
    match downcast_val::[FsError](error):
        .Some(found) =>
            match found:
                FsError.NotFound(path) => path
        .None => "other: " + error.to_string()

fn is_error_target(error: dyn Error) -> bool:
    match error.downcast::[dyn Error]():
        .Some(_) => true
        .None => false

tests:
    use std.testing.assert_equal

    it("an erased FsError is recovered"):
        let error: dyn Error = FsError.NotFound("a.txt")
        assert_equal(missing_path(error), "a.txt", reason="the concrete error type matches")

    it("another domain error is not"):
        let error: dyn Error = HttpError.Status(503)
        assert_equal(missing_path(error), "other: status 503", reason="HttpError is not FsError")

    it("a trait value target satisfies the bound and never matches"):
        let error: dyn Error = FsError.NotFound("b.txt")
        assert_equal(is_error_target(error), false, reason="a recorded type is never a trait value type")
