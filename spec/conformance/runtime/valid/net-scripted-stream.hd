# test: ScriptedNet hands a scripted stream to connect!, which returns its chunks, records its writes, and fails at once past its script
# Spec std/net Scripted Net: std-net.scripted.new, std-net.scripted.setup, std-net.scripted.read, std-net.scripted.read-max, std-net.scripted.eof, std-net.scripted.exhausted, std-net.scripted.write, std-net.scripted.failing.
# Also covers std-net.scripted.decl, std-net.scripted.queue,
# std-net.scripted.lookup-unknown, std-net.scripted.refused,
# std-net.scripted.requested, std-net.scripted.closed-error,
# std-net.scripted.no-host, std-net.provider.scripted, and
# std-net.handles.closed.
# expect: test
use std.net.{Net, NetError, ScriptedNet, ScriptedStream, TcpStream}

fn text_of(bytes: List[u8]) -> string:
    match string::from_utf8(bytes):
        .Ok(text) => text
        .Err(_) => ""

fn lookup_value!(key: string) -> Result[string, NetError] $ Net:
    let mut net = $.use(Net)
    let mut stream = net.connect!("cache.local", 6379)?
    match stream.write!("GET ${key}\n".to_utf8()):
        .Ok(_) => pass
        .Err(_) => return .Err(.Other("write failed"))
    reply := match stream.read!(64):
        .Ok(bytes) => text_of(bytes)
        .Err(_) => return .Err(.Other("read failed"))
    _ := stream.close()
    .Ok(reply.trim())

fn bytes_of(result: Result[List[u8], NetError]) -> List[u8]:
    match result:
        .Ok(bytes) => bytes
        .Err(_) => panic("a scripted read")

fn outcome[T](result: Result[T, NetError]) -> string:
    match result:
        .Ok(_) => "ok"
        .Err(.Closed) => "closed"
        .Err(.Other(message)) => "other: ${message}"
        .Err(error) => "error: ${error}"

fn open_stream!(address: string, port: u16) -> mut dyn TcpStream $ Net:
    let mut net = $.use(Net)
    match net.connect!(address, port):
        .Ok(stream) => stream
        .Err(_) => panic("a scripted connection")

tests:
    use std.testing.assert_equal

    it("sends the command and returns the reply"):
        let mut stream = ScriptedStream::new(["VALUE 42\n".to_utf8()])
        let mut net = ScriptedNet::new()
        net.add_connection("cache.local:6379", stream)
        $.with(Net=net):
            assert_equal(lookup_value!("answer"), .Ok("VALUE 42"), reason="reply")
        assert_equal(stream.written(), "GET answer\n".to_utf8(), reason="the command")
        assert_equal(stream.is_closed(), true, reason="closed")
        assert_equal(net.requested(), ["cache.local:6379"], reason="one connect")

    it("reports a failed read"):
        let mut stream = ScriptedStream::failing([], NetError.Other("connection reset"))
        let mut net = ScriptedNet::new()
        net.add_connection("cache.local:6379", stream)
        $.with(Net=net):
            assert_equal(lookup_value!("answer"), .Err(.Other("read failed")), reason="reset")

    it("splits a chunk at max, ends at an empty chunk, and stays ended"):
        let mut net = ScriptedNet::new()
        net.add_connection("feed.local:9000", ScriptedStream::new(["hello".to_utf8(), "!".to_utf8(), [], "late".to_utf8()]))
        $.with(Net=net):
            let mut stream = open_stream!("feed.local", 9000)
            assert_equal(bytes_of(stream.read!(2)), "he".to_utf8(), reason="the first two bytes")
            assert_equal(bytes_of(stream.read!(10)), "llo".to_utf8(), reason="the rest of the front chunk")
            assert_equal(bytes_of(stream.read!(10)), "!".to_utf8(), reason="the next chunk")
            assert_equal(bytes_of(stream.read!(10)), [], reason="the empty chunk is the close")
            assert_equal(bytes_of(stream.read!(10)), [], reason="and stays closed")

    it("fails at once past the last chunk"):
        let mut net = ScriptedNet::new()
        net.add_connection("feed.local:9000", ScriptedStream::new(["x".to_utf8()]))
        $.with(Net=net):
            let mut stream = open_stream!("feed.local", 9000)
            assert_equal(bytes_of(stream.read!(10)), "x".to_utf8(), reason="the chunk")
            assert_equal(outcome(stream.read!(10)), "other: ScriptedStream has no more reads", reason="nothing more scripted")

    it("a failing stream fails reads and writes after its chunks"):
        let mut peer = ScriptedStream::failing(["ok".to_utf8()], NetError.Other("reset"))
        let mut net = ScriptedNet::new()
        net.add_connection("feed.local:9000", peer)
        $.with(Net=net):
            let mut stream = open_stream!("feed.local", 9000)
            assert_equal(outcome(stream.write!([1])), "ok", reason="a write before the failure")
            assert_equal(bytes_of(stream.read!(10)), "ok".to_utf8(), reason="the chunk")
            assert_equal(outcome(stream.read!(10)), "other: reset", reason="then the error")
            assert_equal(outcome(stream.write!([2])), "other: reset", reason="writes fail too")
            assert_equal(outcome(stream.read!(10)), "other: reset", reason="and every later read")
        assert_equal(peer.written(), [1], reason="only the first write")

    it("every operation after close is Closed"):
        let mut peer = ScriptedStream::new(["x".to_utf8()])
        let mut net = ScriptedNet::new()
        net.add_connection("feed.local:9000", peer)
        $.with(Net=net):
            let mut stream = open_stream!("feed.local", 9000)
            assert_equal(outcome(stream.close()), "ok", reason="the first close")
            assert_equal(outcome(stream.close()), "closed", reason="a second close")
            assert_equal(outcome(stream.read!(1)), "closed", reason="a read")
            assert_equal(outcome(stream.write!([1])), "closed", reason="a write")
        assert_equal(peer.is_closed(), true, reason="the test sees it")

    it("serves one address's queue in order, then refuses"):
        let mut net = ScriptedNet::new()
        net.fail_connection("db.local:5432", NetError.Refused("db.local:5432"))
        net.add_connection("db.local:5432", ScriptedStream::new([]))
        $.with(Net=net):
            let mut client = $.use(Net)
            assert_equal(client.connect!("db.local", 5432).is_err(), true, reason="the scripted failure first")
            assert_equal(client.connect!("db.local", 5432).is_ok(), true, reason="then the stream")
            match client.connect!("db.local", 5432):
                .Ok(_) => panic("the queue is empty")
                .Err(error) => assert_equal(error, NetError.Refused("db.local:5432"), reason="an emptied queue")
            match client.connect!("other.local", 1):
                .Ok(_) => panic("nothing scripted")
                .Err(error) => assert_equal(error, NetError.Refused("other.local:1"), reason="no entry")
        assert_equal(net.requested().len(), 4, reason="the failed calls are recorded too")

    it("answers a scripted lookup and fails an unknown host with Dns"):
        let mut net = ScriptedNet::new()
        net.add_host("cache.local", ["10.0.0.5", "10.0.0.6"])
        $.with(Net=net):
            let mut client = $.use(Net)
            assert_equal(client.lookup!("cache.local"), .Ok(["10.0.0.5", "10.0.0.6"]), reason="the scripted addresses")
            assert_equal(client.lookup!("nowhere.local"), .Err(NetError.Dns("nowhere.local")), reason="an unknown host")
            assert_equal(client.connect!("cache.local", 80).is_err(), true, reason="a socket call")
        assert_equal(net.requested(), ["cache.local", "nowhere.local", "cache.local:80"], reason="a lookup records the host alone")
