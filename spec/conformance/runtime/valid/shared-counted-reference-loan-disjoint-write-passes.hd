# test: a reference held through a read-only counted reference permits a write to a disjoint field through a writable alias
# Spec 13 Conflicts Through Aliases: ref.excl.alias.shared-counted-loan, ref.excl.alias.conflict.
# expect-stdout: a 2
struct User:
    name: string
    age: i32

fn disjoint(view: *User, alias: *mut User) -> string:
    held := &view.name
    alias.age += 1
    "${*held} ${alias.age}"

pub fn main() -> void $ Console:
    alias := box(User { name: "a", age: 1 })
    let view: *User = alias
    println(disjoint(view, alias))
