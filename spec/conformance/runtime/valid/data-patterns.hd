# test: data patterns destructure nested fields and test literals
# Spec 06 Data Patterns: flow.match.data, flow.match.data.bind,
# flow.match.data.literal, flow.match.data.unlisted, flow.match.data.label,
# flow.match.data.fields, flow.match.data.public,
# flow.match.data.nominal, flow.match.data.bind-primitive,
# flow.match.data.bind-composite, flow.match.nested.
# Spec 08 Data Patterns: data.pattern.form, data.pattern.subset, data.pattern.fields.

use std.testing.assert_equal

data User:
    age: i32
    active: bool

data Envelope:
    user: User

fn label(user: User) -> i32:
    match user:
        User { age, active: true } => age
        User { age: alias } => alias

fn nested(envelope: Envelope) -> i32:
    match envelope:
        Envelope { user: User { age } } => age

fn main() -> i32:
    label(User { age: 40, active: true }) + label(User { age: 1, active: false }) + nested(Envelope { user: User { age: 1, active: false } })

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="data patterns destructure nested fields and test literals")
