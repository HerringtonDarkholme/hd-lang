# test: the lines of a block with no trait apply after the decorators, and a derivation block's lines after both
# Spec 14 Derivation Blocks With No Trait: += appends after decorator values, = replaces them.
use std.structure.{Structure, Field, Variant, Walker}
data Tag:
    text: string

data Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

trait Probe:
    fn probe(self) -> string

data Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, w)
        w.out

data Point:
    @tag("a")
    x: i64
    @tag("b")
    y: i64
    z: i64

impl Point by Structure:
    x += [note("n")]
    y = [note("m")]
    z = [tag("c")]

impl Probe for Point by Structure:
    z += [note("p")]

tests:
    use std.testing.assert_equal

    it("combines decorator, trait-less, and derivation block facts in order"):
        assert_equal(Point { x: 1, y: 2, z: 3 }.probe(), "x=a/n;y=-/m;z=c/p;", reason="decorators, then the trait-less block, then the derivation block")
