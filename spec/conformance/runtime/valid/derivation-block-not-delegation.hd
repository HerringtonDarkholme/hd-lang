# test: by Structure derives from the members and never forwards to an embedded part that implements the trait
# Spec 14 Derivation Blocks: annot.block.not-delegation.
use std.structure.{Structure, Field, Variant, Walker}
struct Tag:
    text: string

struct Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

struct Inner:
    code: i64

impl Probe for Inner:
    fn probe(self) -> string:
        "inner"

struct Outer:
    Inner
    id: i64

impl Probe for Outer by Structure

tests:
    use std.testing.assert_equal

    it("walks the members rather than calling the part's probe"):
        assert_equal(Outer { Inner: Inner { code: 1 }, id: 2 }.probe(), "Inner=-/-;id=-/-;", reason="the part is one walked member")
        assert_equal(Inner { code: 1 }.probe(), "inner", reason="the part keeps its own implementation")
