# test: a newtype derives Eq, Hash, and ordering from its base type

use std.testing.assert_equal

@derive(Eq, Hash)
type Mile(i32)

@derive(Eq, PartialOrd, Ord)
type Rank(i32)

fn same(left: Mile, right: Mile) -> bool:
    left == right

tests:
    it("derived newtype equality compares base values"):
        assert_equal(same(Mile(1), Mile(1)), true, reason="equal base values")
        assert_equal(same(Mile(1), Mile(2)), false, reason="different base values")

    it("a derived newtype can be a map key"):
        distances := {Mile(5): "short"}
        assert_equal(distances[Mile(5)], .Some("short"), reason="lookup by an equal key")

    it("derived newtype ordering follows the base type"):
        assert_equal(Rank(1) < Rank(2), true, reason="ordered by base value")
