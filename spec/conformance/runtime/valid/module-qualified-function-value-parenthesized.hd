# test: a parenthesized module-qualified function, (time.s), is the same function value
# Spec Expressions, Names: expr.name.qualified; parentheses around the qualified name do not change what it selects.
use std.time

fn durations(counts: List[i64], make: fn(i64) -> time.Duration) -> List[time.Duration]:
    let mut result: List[time.Duration] = []
    for count in counts:
        result.push(make(count))
    result

tests:
    use std.testing.assert_equal

    it("makes a duration per count"):
        found := durations([3, 4], (time.s))
        assert_equal(found, [time.ms(3000), time.ms(4000)], reason="each count is in seconds")
