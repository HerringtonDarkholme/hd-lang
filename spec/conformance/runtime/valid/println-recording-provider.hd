# expect-stdout: recorded: hello, Ada
# expect-stdout:
# test: prelude / Console / println writes its line through a program-defined provider
# Spec 10 Console: module.console.println-non-suspending.
# Spec 10 Console: println calls write! with the value's text on the Console
# provider that covers the call, and drives the call to completion. The entry
# is a non-suspending main.

struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write!(text)

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")

pub fn main() -> void $ Console:
    console := box(MemoryConsole { lines: [] })
    $.with(Console=console):
        greet("Ada")
    println("recorded: ${console.lines[0]}${console.lines[1]}")
