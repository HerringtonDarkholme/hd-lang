# test: a default method body calls its trait's and supertraits' members

use std.testing.assert_equal

trait Named:
    fn name(self) -> string

trait Greeter < Named:
    fn greeting(self) -> string

    fn greet(self) -> string:
        self.greeting() + " " + self.name()

data User:
    value: string

impl Named for User:
    fn name(self) -> string: self.value

impl Greeter for User:
    fn greeting(self) -> string: "hi"

tests:
    it("a default body reaches the supertrait method"):
        assert_equal(User { value: "Ada" }.greet(), "hi Ada", reason="default uses trait members")
