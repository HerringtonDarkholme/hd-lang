# test: callbacks / trailing
# Spec 07 Trailing Blocks: fn.trailing.form, fn.trailing.arguments,
# fn.trailing.empty-parentheses, fn.trailing.closure, fn.trailing.position,
# fn.trailing.parameterized.

use std.testing.assert_equal

fn apply(callback: fn() -> i32) -> i32: callback()
fn add(base: i32, callback: fn() -> i32) -> i32: base + callback()
fn main() -> i32:
    left := apply:
        40
    add(left):
        2

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="callbacks / trailing")
