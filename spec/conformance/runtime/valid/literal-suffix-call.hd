# test: a suffixed literal runs from_literal with the literal
# Spec 05 Literal Suffixes: `12px` and `-12px` call px::from_literal.
use std.ops.LiteralSuffix
use std.testing.assert_equal

data Pixels:
    count: i32

type px(i32)

impl LiteralSuffix[i32, Pixels] for px:
    fn from_literal(n: i32) -> Pixels:
        Pixels { count: n * 2 }

fn indent() -> Pixels:
    -12px

tests:
    it("calls from_literal"):
        assert_equal(12px.count, 24, reason="from_literal doubles the literal")
        assert_equal(indent().count, -24, reason="the minus folds into the literal")
