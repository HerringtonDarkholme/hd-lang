# test: ScriptedProcess::new has no replies, replies are served in order with the last repeating, and an unscripted program is NotFound
# Spec std/process Scripted Process: std-process.scripted.empty-ref, std-process.scripted.reply-ref,
# std-process.scripted.answer, and std-process.scripted.unqueued.
# expect: test
use std.process.{Command, Process, ProcessError, ProcessOutput, ScriptedProcess}

fn version!() -> string $ Process:
    match Command::new("git").arg("--version").run!():
        .Ok(output) => output.stdout
        .Err(_) => "no git"

fn missing!() -> bool $ Process:
    match Command::new("make").arg("all").stdin("input").run!():
        .Err(error) => error == ProcessError.NotFound(program="make")
        .Ok(_) => false

tests:
    use std.testing.assert_equal

    it("answers the scripted program"):
        let mut process = ScriptedProcess::new()
        process.reply("git", .Ok(ProcessOutput { stdout: "git 2.0" }))
        $.with(Process=process):
            assert_equal(version!(), "git 2.0", reason="git is scripted")

    it("an unscripted program is NotFound"):
        let mut process = ScriptedProcess::new()
        $.with(Process=process):
            assert_equal(missing!(), true, reason="make is not scripted")

    it("replies are served in order and the last one repeats"):
        let mut process = ScriptedProcess::new()
        process.reply("git", .Ok(ProcessOutput { stdout: "one" }))
        process.reply("git", .Err(ProcessError.Other(message="gone")))
        process.reply("git", .Ok(ProcessOutput { stdout: "three" }))
        $.with(Process=process):
            assert_equal(version!(), "one", reason="the first reply")
            assert_equal(version!(), "no git", reason="the second reply is an error")
            assert_equal(version!(), "three", reason="the third reply")
            assert_equal(version!(), "three", reason="the last reply repeats")
            assert_equal(version!(), "three", reason="and repeats again")

    it("each program has its own queue"):
        let mut process = ScriptedProcess::new()
        process.reply("git", .Ok(ProcessOutput { stdout: "git 2.0" }))
        process.reply("git", .Ok(ProcessOutput { stdout: "git 3.0" }))
        process.reply("make", .Ok(ProcessOutput { status: 2 }))
        $.with(Process=process):
            assert_equal(missing!(), false, reason="make is scripted")
            assert_equal(version!(), "git 2.0", reason="make did not take git's reply")
            assert_equal(missing!(), false, reason="make's only reply repeats")
            assert_equal(version!(), "git 3.0", reason="git's second reply")
