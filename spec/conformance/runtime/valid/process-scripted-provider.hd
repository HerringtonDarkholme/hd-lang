# test: a scripted Process provider answers each program, and run! returns .Err(.NotFound) for an unknown one
# Spec 10 Processes: module.process.declares, module.process.ok-output, module.process.mut, module.process.import.names.
# expect: test
use std.process.{Process, ProcessError, ProcessOutput}
use std.testing.assert_equal

data ScriptedProcess:
    outputs: Map[string, ProcessOutput]

impl Process for ScriptedProcess:
    fn run!(mut self, program: string, args: List[string], stdin: string) -> Result[ProcessOutput, ProcessError]:
        match self.outputs.get(program):
            .Some(output) => .Ok(output)
            .None => .Err(.NotFound)

fn version!() -> string $ Process:
    match $.use(Process).run!("git", ["--version"], ""):
        .Ok(output) => output.stdout
        .Err(.NotFound) => "no git"
        .Err(error) => "git did not start: ${error}"

tests:
    it("answers a scripted program"):
        let mut scripted = ScriptedProcess { outputs: {"git": ProcessOutput { stdout: "git 2.0", stderr: "", status: 0 }} }
        $.with(Process=scripted):
            assert_equal(version!(), "git 2.0", reason="git is scripted")

    it("returns .Err(.NotFound) for an unknown program"):
        let mut empty = ScriptedProcess { outputs: {} }
        $.with(Process=empty):
            assert_equal(version!(), "no git", reason="nothing is scripted")
