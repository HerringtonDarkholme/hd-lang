# test: a scripted Process provider answers each program, and run! returns .Err(.NotFound(program)) for an unknown one
# Spec 10 Processes: module.process.decl-struct, module.process.not-found-program, module.process.named-output, module.process.mut-ref, module.process.names.
# expect: test
use std.process.{Command, Process, ProcessError, ProcessOutput}
struct ScriptedProcess:
    outputs: Map[string, ProcessOutput]

impl Process for ScriptedProcess:
    fn run!(&mut self, command: Command) -> Result[ProcessOutput, ProcessError]:
        program := command.program
        match self.outputs.get(program):
            .Some(output) => .Ok(output)
            .None => .Err(.NotFound(program))

fn version!() -> string $ Process:
    match $.use(Process).run!(Command { program: "git", args: ["--version"] }):
        .Ok(output) => output.stdout
        .Err(.NotFound(_)) => "no git"
        .Err(error) => "git did not start: ${error}"

tests:
    use std.testing.assert_equal

    it("answers a scripted program"):
        let mut scripted = ScriptedProcess {
            outputs: { "git": ProcessOutput { stdout: "git 2.0" } },
        }
        $.with(Process=&mut scripted):
            assert_equal(version!(), "git 2.0", reason="git is scripted")

    it("returns .Err(.NotFound(program)) for an unknown program"):
        let mut empty = ScriptedProcess { outputs: {} }
        $.with(Process=&mut empty):
            assert_equal(version!(), "no git", reason="nothing is scripted")
