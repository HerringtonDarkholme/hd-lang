use std.testing.assert_equal

fn scaled(factor: i32, values...: List[i32]) -> i32:
    let total: i32 = 0
    for value in values:
        total = total + value * factor
    total

fn apply(callback: fn(i32, List[i32]...) -> i32) -> i32:
    callback(2, 1, 2, 3)

tests:
    it("a final vararg collects the remaining positional arguments"):
        assert_equal(scaled(3), 0, reason="an empty vararg is an empty list")
        assert_equal(scaled(2, 1, 2), 6, reason="each element is scaled")

    it("a function value keeps the vararg"):
        assert_equal(apply(scaled), 12, reason="the value has type fn(i32, List[i32]...) -> i32")
