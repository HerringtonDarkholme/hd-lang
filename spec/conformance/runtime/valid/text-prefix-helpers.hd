# test: interpolate joins pieces and values, and process_escapes reports the byte position of a bad escape
# Spec std/text Prefix Helpers: std-text.prefix-helper.interpolate, .escapes, .escape-error, .final-backslash (spec pass 89, audit item 6).
use std.ops.{Template, str_prefix}
use std.text.{EscapeError, interpolate, process_escapes}
use std.testing.assert_equal

@str_prefix
fn cooked(t: Template[i32]) -> string:
    let pieces: mut List[string] = []
    for piece in t.raw_parts:
        match process_escapes(piece):
            .Ok(text) => pieces.push(text)
            .Err(error) => pieces.push("?${error.position}")
    interpolate(Template { raw_parts: pieces, values: t.values })

fn position(text: string) -> i32:
    match process_escapes(text):
        .Ok(_) => -1
        .Err(error) => error.position

tests:
    it("joins and processes"):
        assert_equal(interpolate(Template { raw_parts: ["a", "b", "c"], values: [1, 2] }), "a1b2c", reason="alternating")
        n := 7
        assert_equal(cooked"n=$n\n", "n=7\n", reason="through a prefix")
        assert_equal(process_escapes("a\\tb"), .Ok("a\tb"), reason="a tab")

    it("reports the backslash"):
        assert_equal(position("é\\q"), 2, reason="a byte offset")
        assert_equal(position("end\\"), 3, reason="a lone final backslash")
        assert_equal(process_escapes("\\q"), .Err(EscapeError { position: 0 }), reason="Eq and Debug")
