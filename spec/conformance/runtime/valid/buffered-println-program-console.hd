# expect-stdout: one
# expect-stdout:  2
# expect-stdout:
# test: println writes through a program-defined Console provider
# Spec 10 Modules: println calls write_sync on the Console covering the call.
struct Buffer:
    lines: List[string]

impl Console for Buffer:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write_sync(text)

pub fn main() -> void $ Console:
    buffer := box(Buffer { lines: [] })
    $.with(Console=buffer):
        println("one")
        println(2)
    println("${buffer.lines[0]}${buffer.lines[1]} ${buffer.lines[2]}${buffer.lines[3]}")
