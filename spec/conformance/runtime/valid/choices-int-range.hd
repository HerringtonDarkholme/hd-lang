# test: Choices.int and Choices.float take a range and stay inside it for every integer type, the empty forms return start
# Spec std/testing Choices: std-testing.choices.int-range, std-testing.choices.int-range.empty, std-testing.choices.int-range.convert, std-testing.choices.float-range, std-testing.choices.float-range.end.
use std.testing.{assert, assert_equal, Choices, it_prop_with}

fn die(c: mut Choices) -> i64:
    c.int(1..=6)

fn below_three(c: mut Choices) -> i32:
    c.int(0..3)

fn negative(c: mut Choices) -> i16:
    c.int(-5..=-2)

fn mixed(c: mut Choices) -> i8:
    c.int(-128..=127)

fn byte(c: mut Choices) -> u8:
    c.int(0..=255)

fn index(c: mut Choices) -> usize:
    items := ["a", "b", "c", "d"]
    c.int(0..items.len())

fn whole_u64(c: mut Choices) -> u64:
    c.int(0..=18446744073709551615)

fn high_u64(c: mut Choices) -> u64:
    c.int(9223372036854775808..=18446744073709551615)

fn whole_i64(c: mut Choices) -> i64:
    c.int(-9223372036854775807 - 1..=9223372036854775807)

fn half_open(c: mut Choices) -> f64:
    c.float(0.0..1.0)

fn closed(c: mut Choices) -> f32:
    c.float(-2.0..=2.0)

@derive(Debug)
data Ends:
    half_open: i64
    closed: i64
    reversed: i64
    float: f64

fn empty(c: mut Choices) -> Ends:
    Ends { half_open: c.int(5..5), closed: c.int(5..=5), reversed: c.int(6..=5), float: c.float(1.5..1.5) }

tests:
    it_prop_with("a die stays from 1 to 6", gen=die, cases=200, prop=fn!(n: i64):
        assert(n >= 1 && n <= 6, reason="in 1..=6")
    )

    it_prop_with("the .. form never returns its end", gen=below_three, cases=200, prop=fn!(n: i32):
        assert(n >= 0 && n < 3, reason="in 0..3")
    )

    it_prop_with("a negative range stays negative", gen=negative, cases=200, prop=fn!(n: i16):
        assert(n >= -5 && n <= -2, reason="in -5..=-2")
    )

    it_prop_with("a range may span the whole i8", gen=mixed, cases=200, prop=fn!(n: i8):
        assert(n >= -128 && n <= 127, reason="any i8")
    )

    it_prop_with("a range may span the whole u8", gen=byte, cases=200, prop=fn!(n: u8):
        assert(u32(n) <= 255, reason="any u8")
    )

    it_prop_with("a usize range from a length", gen=index, cases=200, prop=fn!(n: usize):
        assert(n < 4, reason="a valid index")
    )

    it_prop_with("a range may span the whole u64", gen=whole_u64, cases=200, prop=fn!(n: u64):
        assert(n <= 18446744073709551615, reason="any u64")
    )

    it_prop_with("a u64 range above the largest i64", gen=high_u64, cases=200, prop=fn!(n: u64):
        assert(n >= 9223372036854775808, reason="in the upper half")
    )

    it_prop_with("a range may span the whole i64", gen=whole_i64, cases=200, prop=fn!(n: i64):
        assert(n == n, reason="any i64, no panic")
    )

    it_prop_with("a float range ends before its end", gen=half_open, cases=200, prop=fn!(x: f64):
        assert(x >= 0.0 && x < 1.0, reason="in 0.0..1.0")
    )

    it_prop_with("a closed float range", gen=closed, cases=200, prop=fn!(x: f32):
        assert(x >= -2.0 && x <= 2.0, reason="in -2.0..=2.0")
    )

    it_prop_with("a range of at most one value returns start", gen=empty, cases=20, prop=fn!(t: Ends):
        assert_equal(t.half_open, 5, reason="5..5")
        assert_equal(t.closed, 5, reason="5..=5")
        assert_equal(t.reversed, 6, reason="6..=5")
        assert_equal(t.float, 1.5, reason="1.5..1.5")
    )
