fn paused!(value: Wide) -> i64 $ Clock:
    carry := value
    sleep!(ms(1))
    carry.n0 + carry.n64

fn drive!(value: Wide) -> i64 $ Clock:
    loader := fn!(extra: i64) -> i64 $ Clock: paused!(value) + extra
    let pending: mut Suspend[i64] = loader(1)
    pending!()

