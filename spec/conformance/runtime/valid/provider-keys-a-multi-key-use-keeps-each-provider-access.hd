# test: a multi key use keeps each provider access
# Spec lang/11-requirements-and-suspension.md: req.mut.use-writable.reference-values.
# expect-stdout: 42

trait Counter:
    fn bump(&mut self) -> void
    fn count(&self) -> i32

trait Base:
    fn value(self) -> i32

struct Cell:
    n: i32

impl Counter for Cell:
    fn bump(&mut self) -> void:
        self.n = self.n + 1
    fn count(&self) -> i32:
        self.n

struct Fixed: pass

impl Base for Fixed:
    fn value(self) -> i32:
        40

fn tick() -> i32 $ Base + Counter:
    let (base, counter) = $.use(Base, Counter)
    counter.bump()
    counter.bump()
    base.value() + $.use(Counter).count()

pub fn main() -> void $ Console:
    $.with(Counter=box(Cell { n: 0 }), Base=Fixed {}):
        println(tick())
