# test: a value that is not copied, moved in a branch after the last use of a reference into it, reaches its new owner whole
# Spec 13 Writes While Borrowed: ref.excl.move, ref.excl.live.
# expect-stdout: a
# expect-stdout: 2
# expect-stdout: kept 2
# expect-stdout: eaten 2
struct Bag:
    labels: List[string]

impl !Copy for Bag

impl Bag:
    fn first(&self) -> &string?:
        if self.labels.is_empty():
            .None
        else:
            .Some(&self.labels[0])

fn consume(bag: Bag) -> usize:
    bag.labels.len()

fn report(bag: Bag, eat: bool) -> string:
    r := &bag
    k := r.labels.len()
    if eat:
        "eaten ${consume(bag)}"
    else:
        "kept $k"

pub fn main() -> void $ Console:
    bag := Bag { labels: ["a", "b"] }
    match bag.first():
        .Some(r) =>
            println(*r)
            println(consume(bag))
        .None => pass
    println(report(Bag { labels: ["c", "d"] }, false))
    println(report(Bag { labels: ["e", "f"] }, true))
