# test: when two shortest strings are equally close to a float, Display writes the one with an even last digit
# expect: test
# Spec 04 Display: types.display.float.
tests:
    use std.testing.assert_equal

    it("a tie takes the even last digit"):
        let tie: f64 = 2.9802322387695312e-8
        assert_equal(
            "$tie",
            "2.9802322387695312e-8",
            reason="2 to the -25 sits halfway between two 17-digit strings",
        )
