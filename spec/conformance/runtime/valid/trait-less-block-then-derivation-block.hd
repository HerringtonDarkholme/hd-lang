# test: a derivation block's lines edit the facts of the block with no trait, for that block only
# Spec 14 Derivation Blocks With No Trait: annot.no-trait.then-blocks.
use std.structure.{Structure, Field, Variant, Walker}
data Tag:
    text: string

data Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

trait Echo:
    fn echo(self) -> string

impl[T] Echo for T by Structure:
    fn echo(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

@derive(Echo)
data Point:
    x: i64

impl Point by Structure:
    x += [tag("a")]

impl Probe for Point by Structure:
    x += [note("n")]

tests:
    use std.testing.assert_equal

    it("the derivation block adds to the shared facts for Probe alone"):
        assert_equal(Point { x: 1 }.probe(), "x=a/n;", reason="shared tag, then the block's note")
        assert_equal(Point { x: 1 }.echo(), "x=a/-;", reason="Echo sees only the shared tag")
