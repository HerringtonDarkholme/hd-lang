# test: it_prop and it_prop_with run generated scalar cases whose draws obey the bounds of int and the default generators
# Spec std/testing Choices And Arbitrary: std-testing.choices.int-generic, std-testing.arbitrary.std, std-testing.arbitrary.float, std-testing.prop.discard.
use std.testing.{assert, Choices, it_prop, it_prop_with}

fn small(c: mut Choices) -> i64:
    c.int(0, 9)

fn even(c: mut Choices) -> i64:
    let value: i64 = c.int(0, 100)
    c.assume(value % 2 == 0)
    value

fn byte(c: mut Choices) -> u8:
    c.int(250, 255)

tests:
    it_prop("addition commutes", prop=fn!(value: i64):
        assert(value + 1 == 1 + value, reason="commutes")
    )

    it_prop_with("draws stay in range", gen=small, cases=50, prop=fn!(n: i64):
        assert(n >= 0 && n <= 9, reason="in range")
    )

    it_prop_with("assume discards odd values", gen=even, prop=fn!(n: i64):
        assert(n % 2 == 0, reason="only even values reach the property")
    )

    it_prop_with("int takes its type from the context", gen=byte, prop=fn!(b: u8):
        assert(b >= 250, reason="from 250 to 255")
    )

    it_prop("an f64 may be any value", prop=fn!(x: f64):
        assert(x == x || x != x, reason="NaN is not equal to itself")
    )
