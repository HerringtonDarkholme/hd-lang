# test: a data type whose fields are all pub crosses a host call both ways without Serialize or Deserialize, and an enum payload needs no consent
# Spec Modules, Private Fields At A Boundary: module.boundary.consent.public, module.boundary.consent.direction.
# fixture-runtime-profile: consent-vault
use std.testing.assert_equal

pub enum Scope:
    Read
    Write(paths: List[string])

pub data Token:
    pub owner: string
    pub scope: Scope

pub trait Vault:
    fn keep(self, token: Token) -> Token

pub fn main() -> void $ Vault:
    kept := $.use(Vault).keep(Token { owner: "ada", scope: Scope.Write(["/orders"]) })
    assert_equal(kept.owner, "ada", reason="a pub field crosses without consent")
    match kept.scope:
        Scope.Write(paths) => assert_equal(paths, ["/orders"], reason="an enum payload crosses without consent")
        Scope.Read => panic("the scope changed")
