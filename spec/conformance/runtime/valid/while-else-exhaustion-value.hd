# test: while else exhaustion value

fn main() -> i32:
    let index = +0
    value := while index < 2:
        index = index + 1
        continue
    else:
        +40
    value + index

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="while else exhaustion value")
