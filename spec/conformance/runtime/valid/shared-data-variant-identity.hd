use std.testing.assert

enum Status(code: i32):
    Ok -> Status(200)
    Missing -> Status(404)

enum Color:
    Red
    Green

test "a payload-free variant with shared data is canonical":
    first := Status.Ok
    second := Status.Ok
    assert(first is second, reason="shared data is not stored in the value")
    assert(!(first is Status.Missing), reason="different variants are distinct")

test "a variant that stores no data is canonical":
    first := Color.Red
    second := Color.Red
    assert(first is second, reason="a payload-free variant without shared data has one identity")
