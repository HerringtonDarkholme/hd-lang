# test: a provider removed by row extension is visible to the callback only, then the outer one returns
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

fn provide_inner[R](callback: fn() -> string $(R, Tag)) -> string $ R:
    $.with(Tag=FixedTag { value: "inner" }):
        callback()

tests:
    it("callback sees the local provider, caller sees its own afterwards"):
        $.with(Tag=FixedTag { value: "outer" }):
            seen := provide_inner(current)
            after := current()
            assert_equal(seen, "inner", reason="removed key is supplied inside the callee")
            assert_equal(after, "outer", reason="outer provider is restored lexically")

    it("the removed key needs no provider at the call site"):
        assert_equal(provide_inner(current), "inner", reason="R is inferred as the empty row")

    it("a closure that captured a provider keeps it inside the removing callee"):
        reader := $.with(Tag=FixedTag { value: "captured" }):
            fn() -> string: current()
        seen := provide_inner(fn() -> string $ Tag: reader())
        assert_equal(seen, "captured", reason="closure providers bind at creation")
