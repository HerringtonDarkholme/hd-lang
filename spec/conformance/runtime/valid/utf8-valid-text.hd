# test: to_utf8 copies a string's bytes, and string::from_utf8 turns well-formed bytes back into the same string
# Spec std/text UTF-8 Conversion: std-text.utf8.to-utf8, std-text.utf8.from-utf8, std-text.utf8.round-trip (UTF8-API, batch 72; task #229).
use std.text.Utf8Error

fn decode(bytes: List[u8]) -> string:
    match string::from_utf8(bytes):
        .Ok(text) => text
        .Err(Utf8Error.InvalidSequence(position)) => "bad byte at $position"
        .Err(Utf8Error.Truncated) => "cut short"

tests:
    use std.testing.{assert, assert_equal}

    it("to_utf8 gives the bytes in order"):
        assert_equal("hé".to_utf8(), [104, 195, 169], reason="h, then the two bytes of é")
        assert_equal("".to_utf8(), [], reason="no bytes")
        assert_equal("中".to_utf8(), [228, 184, 173], reason="three bytes")
        assert_equal("😀".to_utf8(), [240, 159, 152, 128], reason="four bytes")

    it("from_utf8 accepts each encoding length"):
        assert_equal(decode([104, 195, 169]), "hé", reason="one and two bytes")
        assert_equal(decode([228, 184, 173]), "中", reason="three bytes")
        assert_equal(decode([240, 159, 152, 128]), "😀", reason="four bytes")
        assert_equal(decode([]), "", reason="the empty list")
        assert_equal(decode([0]), "\0", reason="U+0000 is well formed")

    it("the limits are well formed"):
        assert_equal(decode([127]), "\u{7f}", reason="the last one-byte scalar")
        assert_equal(decode([239, 191, 191]), "\u{ffff}", reason="the last three-byte scalar")
        assert_equal(decode([244, 143, 191, 191]), "\u{10ffff}", reason="the last scalar value")
        assert_equal(decode([238, 128, 128]), "\u{e000}", reason="the first scalar after the surrogates")

    it("round trip"):
        for text in ["", "ascii", "héllo, 世界 😀", "\u{10ffff}\0"]:
            match string::from_utf8(text.to_utf8()):
                .Ok(back) => assert_equal(back, text, reason="the same string")
                .Err(_) => assert(false, reason="the bytes of a string are well formed")
