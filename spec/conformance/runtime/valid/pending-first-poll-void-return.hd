# fixture-runtime-profile: tick
# fixture-runtime-scenario: pending-first-poll
# test: a void return after a pending host call completes the frame and runs defer once
# Spec 11 Entry Driver: req.entry.driver, req.entry.waker-driven,
# req.entry.pending, req.entry.busy-poll, req.host-wait.wait,
# req.host-wait.source, req.poll-context.construction,
# req.poll-context.waker, req.waker.arrange.
use std.ops.defer
use std.testing.assert_equal

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct State:
    count: i32

fn child!() -> i32 $ Console + Tick:
    let mut console = $.use(Console)
    $.use(Tick).tick!("child\n")
    _ := console.write_sync("child\n")
    1

fn run!(state: &mut State) -> void $ Console + Tick:
    defer(fn() -> void: state.count = state.count + 1)
    value := child!()
    if value == 1:
        return
    state.count = 100

pub fn main!() -> void $ Console + Tick:
    let mut state = State { count: 0 }
    run!(&mut state)
    assert_equal(
        state.count,
        1,
        reason="the early return skipped the assignment and defer ran once",
    )
