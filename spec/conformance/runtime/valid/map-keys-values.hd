# test: contains_key, keys, and values; keys and values are snapshots in one deterministic order
# Spec std/collections Map Methods: std-collections.map.contains-key, .keys.order, .values, and .snapshot
# (STDLIB question 16, 2026-09-29; batch 64, STD-1).
fn summary(stock: Map[string, i32]) -> string:
    if stock.contains_key("tea"):
        return "${stock.keys().len()} items"
    "no tea"

tests:
    use std.testing.{assert, assert_equal}

    it("contains_key finds an entry by key"):
        stock := {"tea": +3, "milk": 1}
        assert(stock.contains_key("tea"), reason="present key")
        assert(!stock.contains_key("sugar"), reason="absent key")
        assert_equal(summary(stock), "2 items", reason="through a helper")

    it("keys and values come in one deterministic order"):
        stock := {"tea": 3, "milk": 1}
        names := stock.keys()
        amounts := stock.values()
        assert_equal(names.sorted(), ["milk", "tea"], reason="every key once")
        assert_equal(stock.get(names[0]), .Some(amounts[0]), reason="values in the keys' order")
        assert_equal(stock.get(names[1]), .Some(amounts[1]), reason="values in the keys' order")
        assert_equal(stock.keys(), names, reason="the same order every time")

    it("the returned lists do not follow later changes"):
        let stock: mut Map[string, i32] = {"tea": 3}
        names := stock.keys()
        stock["milk"] = 1
        assert_equal(names, ["tea"], reason="a snapshot")
