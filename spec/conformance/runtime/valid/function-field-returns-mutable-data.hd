# test: callbacks / readonly result

use std.testing.assert_equal

data Child:
    value: i32
data Holder:
    get: fn() -> mut Child
fn make() -> mut Child: Child { value: 42 }
fn main() -> i32:
    holder := Holder { get: make }
    let child: mut Child = holder.get()
    child.value

test "main returns 42":
    assert_equal(main(), 42, reason="callbacks / readonly result")
