# test: callbacks / readonly result

struct Child:
    value: i32
struct Holder:
    get: fn() -> *mut Child
fn make() -> *mut Child:
    box(Child { value: 42 })
fn main() -> i32:
    holder := &mut Holder { get: make }
    let child: &mut Child = (holder.get)()
    child.value

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="callbacks / readonly result")
