# expect-stdout: a
# test: passing a `*mut` alias to a bang call is no access, and the callee only reads the object a live shared loan holds, so it runs
# Spec 13 Conflicts Through Aliases: ref.excl.alias.counted-access, ref.excl.alias.conflict.
use std.time.{Clock, sleep}

struct User:
    name: string

struct Team:
    lead: *mut User

fn wait!(user: *mut User) -> void $ Clock:
    sleep!(1ms)
    _ := user.name

fn conflict!(t: &Team, alias: *mut User) -> string $ Clock:
    held := &t.lead.name
    wait!(alias)
    *held

pub fn main!() -> void $ Console + Clock:
    t := Team { lead: box(User { name: "a" }) }
    alias := t.lead
    println(conflict!(&t, alias))
