# fixture-runtime-profile: pending-write
# test: unreachable cycles through cold suspension frames are reclaimed
# Spec 08 Representation: data.repr.gc.
use std.testing.assert_equal

struct Ring:
    name: string
    task: mut Suspend[string]?

fn read!(ring: &mut Ring) -> string:
    ring.name

fn cold_ring(n: i32) -> string:
    ring := &mut Ring { name: "ring $n", task: .None }
    ring.task = .Some(read(ring))
    ring.name

fn closure_ring(n: i32) -> string:
    ring := &mut Ring { name: "closure $n", task: .None }
    run := fn!() -> string: ring.name
    ring.task = .Some(run())
    ring.name

fn nested!(ring: &mut Ring) -> string $ Console:
    resumed!(ring)

fn resumed!(ring: &mut Ring) -> string $ Console:
    let text = "old ${ring.name}"
    console := $.use(Console)
    _ := console.write_line!("pause $text")
    assert_equal(text, "old ${ring.name}", reason="the first resume kept the saved local")
    text = "new ${ring.name}"
    let n = +0
    while n < 20000:
        _ := cold_ring(n)
        n += 1
    _ := console.write_line!("resume $text")
    text


pub fn main!() -> void $ Console:
    let n = +0
    while n < 20000:
        assert_equal(cold_ring(n), "ring $n", reason="the frame keeps the argument")
        assert_equal(closure_ring(n), "closure $n", reason="the frame keeps the capture")
        n += 1
    ring := &mut Ring { name: "live", task: .None }
    let job: mut Suspend[string] = nested(ring)
    ring.task = .Some(job)
    assert_equal(job!(), "new live", reason="the resumed frame owns its current locals")
