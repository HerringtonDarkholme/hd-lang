# test: pointer loans, adversarial: a task that `race!` abandons while it holds an exclusive loan across a suspension ends that loan, so a later write to the object runs; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.task.race
use std.time.{Clock, ms, s, sleep}

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn hold!(p: *mut Cell) -> string $ Clock:
    r := &mut p.value
    sleep!(s(60))
    *r

fn quick!() -> string $ Clock:
    sleep!(ms(1))
    orig()

pub fn main!() -> void $ Console + Clock:
    p := box(Cell { value: orig(), other: orig() })
    winner := race!(hold(p), quick())
    p.value = fresh()
    seen := if p.value == fresh(): winner else: "lost"
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
