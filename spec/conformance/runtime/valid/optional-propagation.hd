# test: optionals inject plain values, match both cases, and propagate nil

use std.testing.assert_equal

fn maybe(flag: bool) -> i32?:
    if flag:
        40
    else:
        nil

fn lifted(flag: bool) -> i32?:
    value := maybe(flag)?
    value + 2

fn inspect(value: i32?) -> i32:
    match value:
        nil => -1
        actual? => actual

fn main() -> i32: inspect(lifted(true)) + inspect(lifted(false))

test "main returns 41":
    assert_equal(main(), 41, reason="optionals inject plain values, match both cases, and propagate nil")
