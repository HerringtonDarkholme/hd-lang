# test: closures fix a provider only by capturing its value; other closures keep the key in their row
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

fn later!() -> string $ Tag:
    current()

tests:
    it("closure that captured a provider value keeps that provider"):
        let reader: fn() -> string = $.with(Tag=FixedTag { value: "created" }):
            tag := $.use(Tag)
            fn() -> string: tag.name()
        seen := $.with(Tag=FixedTag { value: "caller" }):
            reader()
        assert_equal(seen, "created", reason="captured provider value outlives its scope")

    it("closure created in a provider scope without a capture keeps the key in its row"):
        let reader: fn() -> string $ Tag = $.with(Tag=FixedTag { value: "created" }):
            fn() -> string: current()
        seen := $.with(Tag=FixedTag { value: "caller" }):
            reader()
        assert_equal(seen, "caller", reason="the enclosing scope does not satisfy the closure's row")

    it("closure without a provider in scope uses the caller's provider"):
        reader := fn() -> string: current()
        seen := $.with(Tag=FixedTag { value: "caller" }):
            reader()
        assert_equal(seen, "caller", reason="inferred row Tag is satisfied at the call")

    it("suspension constructed in one scope and driven in another"):
        let pending: mut Suspend[string] = $.with(Tag=FixedTag { value: "built" }):
            later()
        seen := $.with(Tag=FixedTag { value: "driver" }):
            pending!()
        assert_equal(seen, "built", reason="construction-time provider binding")
