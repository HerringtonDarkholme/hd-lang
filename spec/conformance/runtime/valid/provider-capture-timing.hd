# test: closures capture lexical providers at creation; uncovered closures keep the row
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

test "closure created in a provider scope keeps that provider":
    let reader: fn() -> string = $.with(Tag=FixedTag { value: "created" }):
        fn() -> string: current()
    seen := $.with(Tag=FixedTag { value: "caller" }):
        reader()
    assert_equal(seen, "created", reason="captured provider outlives its scope")

test "closure without a provider in scope uses the caller's provider":
    reader := fn() -> string: current()
    seen := $.with(Tag=FixedTag { value: "caller" }):
        reader()
    assert_equal(seen, "caller", reason="inferred row Tag is satisfied at the call")

test "suspension constructed in one scope and driven in another":
    let pending: mut Suspend[string] = $.with(Tag=FixedTag { value: "built" }):
        later()
    seen := $.with(Tag=FixedTag { value: "driver" }):
        pending!()
    assert_equal(seen, "built", reason="construction-time provider binding")

fn later!() -> string $ Tag:
    current()
