# test: loop values join a value and an optional
# Spec lang/04-type-system.md: types.lct.optional.
# expect-stdout: some 2
# expect-stdout: none
# expect-stdout: none
# expect-stdout: some 7

fn break_first(stop: i32, found: i32?):
    let i = +0
    while i < 3:
        i = i + 1
        if i == stop:
            break i
    else:
        found

fn optional_break(items: List[i32], found: i32?):
    for v in items:
        if v > 2:
            break found
    else:
        +7

fn show(v: i32?) -> string:
    match v:
        .Some(n) => "some ${n}"
        .None => "none"

pub fn main() -> void $ Console:
    let none: i32? = .None
    println(show(break_first(2, none)))
    println(show(break_first(9, none)))
    println(show(optional_break([5], none)))
    println(show(optional_break([1], none)))
