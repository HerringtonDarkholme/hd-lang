# test: pad_start and pad_end fill to a width counted in scalar values, and a short width changes nothing
# Spec std/text Splitting And Padding: std-text.pad.length, .start, .end, and .width-at-most-length.
use std.testing.assert_equal

tests:
    it("pads to the width"):
        assert_equal("42".pad_start(5, '0'), "00042", reason="pad_start")
        assert_equal("ab".pad_end(4, '.'), "ab..", reason="pad_end")
        assert_equal("".pad_start(2, '-'), "--", reason="the empty string")
    it("counts the width in scalar values"):
        assert_equal("é".pad_start(3, '.'), "..é", reason="é is one scalar value")
        assert_equal("x".pad_end(3, 'é'), "xéé", reason="a multibyte fill")
    it("leaves a string at or past the width unchanged"):
        assert_equal("abc".pad_start(3, '*'), "abc", reason="equal width")
        assert_equal("abc".pad_end(2, '*'), "abc", reason="width below the length")
        assert_equal("abc".pad_start(0, '*'), "abc", reason="a zero width")
