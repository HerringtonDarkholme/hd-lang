# test: permission weakening applies inside tuple elements at a join
# expect: test
# Spec 04 Least Common Type: types.lct.conversions.
data User:
    name: string

fn pick(fresh: (mut User, i32), stored: (User, i32), take_fresh: bool) -> (User, i32):
    chosen := if take_fresh: fresh else: stored
    chosen

tests:
    use std.testing.assert_equal

    it("(mut User, i32) and (User, i32) join to (User, i32)"):
        let ada: mut User = User { name: "Ada" }
        result := pick((ada, +1), (User { name: "Grace" }, +2), true)
        assert_equal(result._0.name, "Ada", reason="the fresh tuple weakens to (User, i32)")
