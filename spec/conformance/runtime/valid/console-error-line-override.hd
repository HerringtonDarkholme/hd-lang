# test: a Console provider that overrides write_error_sync keeps error lines apart from ordinary lines
# Spec 10 Console: module.console.write-error-sync.raw, module.console.write-sync-ref.mutable.
struct SplitConsole:
    lines: List[string]
    errors: List[string]

impl Console for SplitConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.errors.push(text)
        .Ok(())

fn report!(failed: i32) -> void $ Console:
    let mut console = $.use(Console)
    _ := console.write_sync("checked 3 orders")
    if failed > 0:
        _ := console.write_error_sync("${failed} orders failed")

tests:
    use std.testing.assert_equal

    it("records error lines separately"):
        console := box(SplitConsole { lines: [], errors: [] })
        $.with(Console=console):
            report!(1)
        assert_equal(console.lines, ["checked 3 orders"], reason="one ordinary line")
        assert_equal(console.errors, ["1 orders failed"], reason="one error line")
