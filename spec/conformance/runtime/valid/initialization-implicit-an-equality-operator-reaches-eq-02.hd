# test: an equality operator reaches eq
# Spec lang/10-modules.md: module.init.definite.implicit.
# expect-stdout: true

struct Tag:
    n: i32

later := +5

impl Eq for Tag:
    fn eq(self, other: Tag) -> bool: self.n + later == other.n

first := Tag { n: 1 } == Tag { n: 6 }

pub fn main() -> void $ Console:
    println(first)
