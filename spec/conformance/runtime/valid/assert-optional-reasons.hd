# Spec 10 Standard Testing: module.testing.assertions.reason-optional.
tests:
    use std.testing.{assert, assert_equal}

    it("assertions accept an omitted reason"):
        assert(true)
        assert_equal(1, 1)

    it("assertions still accept a reason"):
        assert(true, reason="the condition holds")
        assert_equal(1, 1, reason="the values match")
