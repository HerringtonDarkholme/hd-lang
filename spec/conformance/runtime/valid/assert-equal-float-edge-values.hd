use std.testing.{assert, assert_equal}

test "NaN is unequal to itself":
    let nan: f64 = 0.0 / 0.0
    assert(nan != nan, reason="IEEE 754 equality makes NaN unequal to itself")
    assert(not (nan == nan), reason="== on NaN is false")

test "negative zero equals positive zero":
    let negative_zero: f64 = -0.0
    let positive_zero: f64 = 0.0
    assert(negative_zero == positive_zero, reason="IEEE 754 equality treats the zeros as equal")
    assert_equal(negative_zero, positive_zero, reason="PartialEq treats the zeros as equal")
