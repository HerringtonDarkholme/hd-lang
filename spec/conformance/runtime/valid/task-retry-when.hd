# test: retry! stops at an error that when rejects, and retries every error without when
# Spec std/task Retry: std-task.policy.retry.predicate, std-task.policy.retry.all-errors, and std-task.policy.retry.when-plain; Retry With Backoff: std-task.policy.retry.when-sleep (issue #369).
use std.task.{Backoff, retry, apply}
use std.time.{Clock, ManualClock, Timestamp}
use std.time.{Duration, Instant, ms}

fn is_busy(error: string) -> bool:
    error == "busy"

fn connect!(replies: *mut List[Result[string, string]]) -> Result[string, string] $ Clock:
    apply!(retry(Backoff { attempts: 5, initial: 0ms }).when(is_busy)):
        replies.remove_at(0)

struct RecordingClock:
    slept: List[i64]

impl Clock for RecordingClock:
    fn now(self) -> Timestamp:
        Timestamp::from_unix_milliseconds(0)

    fn monotonic(self) -> Instant:
        Instant::from_milliseconds(0)

    fn sleep!(&mut self, duration: Duration) -> void:
        self.slept.push(duration.as_milliseconds())

struct Server:
    errors: List[string]
    calls: usize
    asked: List[string]

fn ask!(server: &mut Server) -> Result[string, string]:
    index := server.calls
    server.calls = server.calls + 1
    if index < server.errors.len():
        return .Err(server.errors[index])
    .Ok("ready")

fn judge(server: &mut Server, error: string) -> bool:
    server.asked.push(error)
    error == "busy"

tests:
    use std.testing.assert_equal

    it("retries while when is true and returns the first .Ok"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            let mut replies: List[Result[string, string]] = [.Err("busy"), .Err("busy"), .Ok("ready")]
            assert_equal(connect!(&mut replies), .Ok("ready"), reason="two busy errors, then ready")

    it("returns an error that when rejects without another call"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            let mut replies: List[Result[string, string]] = [.Err("busy"), .Err("refused"), .Ok("ready")]
            assert_equal(connect!(&mut replies), .Err("refused"), reason="the second error is rejected")
            assert_equal(replies.len(), 1, reason="no third call")

    it("asks when once for each error, and not for an .Ok"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            server := &mut Server { errors: ["busy", "busy"], calls: 0, asked: [] }
            result := apply!(retry(Backoff { attempts: 5, initial: 0ms }).when(fn(error: string): judge(server, error))):
                ask!(server)
            assert_equal(result, .Ok("ready"), reason="the third call succeeds")
            assert_equal(server.asked, ["busy", "busy"], reason="one question for each .Err")

    it("retries every error when when is omitted"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            server := &mut Server { errors: ["a", "b", "c"], calls: 0, asked: [] }
            result := apply!(retry(Backoff { attempts: 3, initial: 0ms })):
                ask!(server)
            assert_equal(result, .Err("c"), reason="three calls, the last error")
            assert_equal(server.calls, 3, reason="every error was retried")

    it("retry! does not sleep before a call that when rejects"):
        manual := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=manual):
            let mut clock = RecordingClock { slept: [] }
            server := &mut Server { errors: ["busy", "refused", "busy"], calls: 0, asked: [] }
            policy := Backoff { attempts: 5, initial: 100ms, factor: 2, max: 1000ms }
            $.with(Clock=&mut clock):
                result := apply!(retry(policy).when(is_busy)):
                    ask!(server)
                assert_equal(result, .Err("refused"), reason="the second error is rejected")
            assert_equal(server.calls, 2, reason="no third call")
            assert_equal(clock.slept, [100], reason="one delay, before the second call only")
