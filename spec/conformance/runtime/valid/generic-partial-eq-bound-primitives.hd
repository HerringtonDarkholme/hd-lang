# test: primitives satisfy a user-declared Eq bound; == dispatches to their standard implementations
use std.testing.assert

fn same[T < Eq](left: T, right: T) -> bool:
    left == right

tests:
    it("primitive equality through a generic bound"):
        assert(same(1, 1), reason="equal i32")
        assert(!same(1, 2), reason="unequal i32")
        assert(same("ada", "ada"), reason="equal string")
        assert(!same("ada", "grace"), reason="unequal string")
        assert(same(true, true), reason="equal bool")
        assert(same('x', 'x'), reason="equal char")
        assert(same(2.5, 2.5), reason="equal f64")

    it("NaN stays unequal through a generic bound"):
        let nan: f64 = 0.0 / 0.0
        assert(!same(nan, nan), reason="IEEE 754 equality survives generic dispatch")
