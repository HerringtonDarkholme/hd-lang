# test: a unit test binds its own Net provider, and NetError names a refused address
# Spec std/net Net Providers: std-net.trait.decl-composed, std-net.lookup, std-net.error.not-granted.plain.
# Also covers std-net.error.decl, std-net.error.traits,
# std-net.error.address, std-net.error.not-granted, std-net.error.dns,
# std-net.error.refused, std-net.connect, std-net.listen,
# std-net.bind-udp, std-net.mut-ref.reference-values, and std-net.handles.decl-ref.
# expect: test
use std.net.{Net, NetError, TcpListener, TcpStream, UdpSocket}
struct NoNetwork: pass

impl Net for NoNetwork:
    fn lookup!(&mut self, host: string) -> Result[List[string], NetError]:
        .Err(.Dns(host))
    fn connect!(&mut self, host: string, port: u16) -> Result[*mut dyn TcpStream, NetError]:
        .Err(.Refused("${host}:${port}"))
    fn listen!(&mut self, host: string, port: u16) -> Result[*mut dyn TcpListener, NetError]:
        .Err(.Refused("${host}:${port}"))
    fn bind_udp!(&mut self, host: string, port: u16) -> Result[*mut dyn UdpSocket, NetError]:
        .Err(.Refused("${host}:${port}"))

fn addresses!(host: string) -> List[string] $ Net:
    match $.use(Net).lookup!(host):
        .Ok(found) => found
        .Err(_) => []

fn reach!(host: string, port: u16) -> bool $ Net:
    match $.use(Net).connect!(host, port):
        .Ok(_) => true
        .Err(error) => error != NetError.Refused("${host}:${port}")

tests:
    use std.testing.assert_equal

    it("finds no address without a network"):
        let mut net = NoNetwork {}
        $.with(Net=&mut net):
            assert_equal(addresses!("example.com").len(), 0, reason="no lookup answers")
            assert_equal(reach!("example.com", 80), false, reason="the connection is refused")

    it("a refused address names the address"):
        assert_equal(
            NetError.NotGranted("db.internal:5432").to_string(),
            "net access to db.internal:5432 is not granted",
            reason="plain denial without host-specific advice",
        )
