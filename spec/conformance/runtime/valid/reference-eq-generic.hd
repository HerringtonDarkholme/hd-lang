# test: generic code compares and hashes references by the values they refer to
# Spec std/cmp Reference Equality: std-cmp.ref.eq; std/hash Reference Hashing: std-hash.reference.impl.
# expect-stdout: true false
# expect-stdout: true false
use std.hash.hash_of

fn has_value(items: List[*i32], value: *i32) -> bool:
    items.contains(value)

fn same_hash(a: &string, b: &string) -> bool:
    hash_of(a) == hash_of(b)

pub fn main() -> void $ Console:
    a := box(+1)
    b := box(+2)
    refs := [a, b]
    println("${has_value(refs, box(+2))} ${has_value(refs, box(+3))}")
    tea := "tea"
    println("${same_hash(&tea, &"tea")} ${same_hash(&tea, &"cake")}")
