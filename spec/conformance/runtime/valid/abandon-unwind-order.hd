# expect-stdout: stopped
# expect-stdout: tail, dispose start, dispose defer, outer
# test: abandon() unwinds a job at once as one LIFO list: the tail defer, the dispose that had not started up to its first wait with its own defer, then the outer defer
# Spec lang/11 Abandoning: req.abandon.method, req.abandon.unwind, req.abandon.order.using-split, req.abandon.defer, req.abandon.dispose.unstarted.
use std.ops.AsyncDisposable
use std.task.race
use std.time.{Clock, ms, s, sleep}

struct Release:
    log: *mut List[string]
    closing: mut Suspend[void]

impl AsyncDisposable for Release:
    fn dispose!(&mut self) -> void:
        defer:
            self.log.push("dispose defer")
        self.log.push("dispose start")
        let mut wait = self.closing
        wait!()
        self.log.push("dispose end")

fn ordered!(res: &mut Release, log: &mut List[string]) -> string $ Clock:
    defer:
        log.push("outer")
    using! r = res
    defer:
        log.push("tail")
    sleep!(s(60))
    "late"

fn stop!(job: mut Suspend[string]) -> string:
    job.abandon()
    "stopped"

pub fn main!() -> void $ Console + Clock:
    let log: *mut List[string] = box([])
    let job: mut Suspend[string] = ordered(
        &mut Release { log: log, closing: sleep(ms(5)) },
        log,
    )
    println(race!(job, stop(job)))
    println(log.join(", "))
