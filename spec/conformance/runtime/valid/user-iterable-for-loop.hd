# test: a user type implements Iterable and drives a for loop

struct Bag:
    items: List[i32]

use std.iter.ListIter

impl Iterable[i32] for Bag:
    type IntoIter = ListIter[i32]
    fn iter(self) -> ListIter[i32]:
        self.items.iter()

fn sum(bag: Bag) -> i32:
    let total = +0
    for value in bag:
        total = total + value
    total

fn doubled(bag: Bag) -> List[i32]:
    [for value in bag => value * 2]

tests:
    use std.testing.assert_equal

    it("a user Iterable drives loops and comprehensions"):
        bag := Bag { items: [1, 2, 3] }
        assert_equal(sum(bag), 6, reason="each loop obtains a fresh iterator")
        assert_equal(sum(bag), 6, reason="each loop obtains a fresh iterator")
        assert_equal(doubled(bag).len(), 3, reason="a comprehension accepts an Iterable")
