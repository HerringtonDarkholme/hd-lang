# test: an embedded type's trait method is reached from its part; through the outer value it is ignored
use std.testing.assert_equal

data Base:
    pub name: string

impl Base:
    pub fn to_string(self) -> string:
        "base " + self.name

data Label:
    Base

impl Display for Label:
    fn to_string(self) -> string:
        "label"

data Page:
    Label

tests:
    it("the part reaches the trait method and the deeper inherent method"):
        page := Page { Label: ...Label { Base: ...Base { name: "home" } } }
        assert_equal(Display::to_string(page.Label), "label", reason="Label's own Display method, trait-qualified because Base's to_string is promoted into Label")
        assert_equal(page.Label.Base.to_string(), "base home", reason="Base's inherent method")
        assert_equal(page.name, "home", reason="fields are still promoted")
        assert_equal(page.to_string(), "base home", reason="Label's trait method is ignored, so Base's method is promoted")
