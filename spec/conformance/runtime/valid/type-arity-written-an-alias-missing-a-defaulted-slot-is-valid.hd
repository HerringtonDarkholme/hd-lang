# test: an alias missing a defaulted slot is valid
# expect-stdout: 7
# expect-stdout: (2, s)
type Twin[A, B = A] = (A, B)

type Both[A, B] = (A, B)

fn twin(x: i32) -> Twin[i32]:
    (x, x + 1)

fn both(x: i32) -> Both[i32, string]:
    (x, "s")

pub fn main() -> void $ Console:
    t := twin(1)
    let b: Twin[i32] = (3, 4)
    println(t._0 + t._1 + b._1)
    println(both(2))
