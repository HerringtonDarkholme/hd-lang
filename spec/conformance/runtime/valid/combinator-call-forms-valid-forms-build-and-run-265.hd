# test: combinator call forms valid forms build and run
# expect-stdout: 1
# expect-stdout: 1
# expect-stdout: 1
# expect-stdout: 2
# expect-stdout: 1 2
use std.task.{all, race}

fn one!() -> i32:
    1

fn two!() -> i32:
    2

pub fn main!() -> void $ Console:
    println(race!(one(), two()))
    println(race!::[i32](one()))
    println(race!(tasks=[one(), two()]))
    let list: List[mut Suspend[i32]] = [two(), one()]
    println(race!(list...))
    let (a, b) = all!(one(), two())
    println("${a} ${b}")
