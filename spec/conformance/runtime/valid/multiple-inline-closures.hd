# test: several multiline closures are passed by parenthesizing each and separating them with commas
# Spec 07 Multiple Inline Closures: "Multiple multiline closures may be passed by parenthesizing each
# closure expression and separating the arguments with commas".
use std.testing.assert_equal

fn choice(flag: bool, on_true: fn(i32) -> i32, on_false: fn(i32) -> i32) -> i32:
    if flag:
        on_true(10)
    else:
        on_false(10)

fn pick(flag: bool) -> i32:
    choice(
        flag,
        (
            fn(a):
                doubled := a * 2
                doubled + 22
        ),
        (
            fn(b):
                halved := b / 2
                halved - 5
        ),
    )

test "the first closure runs when the flag is true":
    assert_equal(pick(true), 42, reason="first multiline closure")

test "the second closure runs when the flag is false":
    assert_equal(pick(false), 0, reason="second multiline closure")
