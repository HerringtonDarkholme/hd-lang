# test: counts tallies each distinct element, one key per distinct element
# Spec std/collections Counts: std-collections.counts.decl, std-collections.counts.value, and .empty.
use std.collections.counts
use std.testing.assert_equal

fn tally(words: List[string]) -> Map[string, usize]:
    counts(words)

tests:
    it("tallies elements"):
        found := tally(["a", "b", "a"])
        assert_equal(found.get("a"), .Some(2), reason="a twice")
        assert_equal(found.get("b"), .Some(1), reason="b once")
        assert_equal(found.keys().sorted(), ["a", "b"], reason="one key per distinct element")
    it("gives an empty map for an empty list"):
        assert_equal(tally([]).len(), 0, reason="empty")
