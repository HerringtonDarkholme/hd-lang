# test: removing an absent key returns .None and leaves the map's entries unchanged
# Spec 10 Built-In Methods: module.method.normative.
# expect: test
use std.testing.assert_equal

tests:
    it("absent removal yields .None"):
        let values: mut Map[string, i32] = {"a": 1, "b": 2}
        let absent: i32? = .None
        assert_equal(values.remove("missing"), absent, reason="absent key yields .None")
        assert_equal(values, {"a": 1, "b": 2}, reason="no entry was removed")
        let one: i32? = 1
        assert_equal(values.remove("a"), one, reason="a present key yields its value")
        assert_equal(values.len(), 1, reason="the present key was removed")
