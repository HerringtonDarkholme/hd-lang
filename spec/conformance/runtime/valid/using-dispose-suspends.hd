# expect-stdout: open a, open b, body, closing b, closed b, defer, closing a, closed a
# expect-stdout: open a, open b, closing b, closed b, defer, closing a, closed a
# expect-stdout: 2 1
# test: a dispose! that suspends finishes before the scope exit goes on, in order with defer suites
# Spec lang/06 Using Bindings: flow.using.disposable-ref, flow.using.dispose, flow.using.order, flow.using.suspend.
use std.ops.Disposable
use std.time.{Clock, ms, sleep}

data Conn:
    name: string
    log: mut List[string]
    closing: mut Suspend[void]

impl Disposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing ${self.name}")
        let mut wait = self.closing
        wait!()
        self.log.push("closed ${self.name}")

fn connect!(name: string, log: mut List[string]) -> mut Conn $ Clock:
    log.push("open ${name}")
    Conn { name: name, log: log, closing: sleep(ms(1)) }

fn work!(log: mut List[string], stop: bool) -> i32 $ Clock:
    using a = connect!("a", log)
    defer: log.push("defer")
    using b = connect!("b", log)
    if stop:
        return 1
    sleep!(ms(1))
    log.push("body")
    2

pub fn main!() -> void $ Console + Clock:
    let log: mut List[string] = []
    n := work!(log, false)
    println(log.join(", "))
    log.clear()
    m := work!(log, true)
    println(log.join(", "))
    println("${n} ${m}")
