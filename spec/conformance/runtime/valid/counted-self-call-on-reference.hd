# test: a `*mut self` call through a `*mut` parameter passes the reference on to the method
# Spec 07 Reference Receivers: fn.method.counted-self.reference.
# expect-stdout: 5
struct Counter:
    hits: i32

impl Counter:
    fn handle(*mut self) -> *mut Counter:
        self

fn bump(counter: *mut Counter) -> void:
    h := counter.handle()
    h.hits = 5

pub fn main() -> void $ Console:
    counter := box(Counter { hits: 0 })
    bump(counter)
    println(counter.hits)
