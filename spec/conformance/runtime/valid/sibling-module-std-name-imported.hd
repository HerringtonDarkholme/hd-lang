# test: two modules of one package that each import the same std name both have it in scope
# Spec 03 Module Scope: names.module.use-own-module (task P1a3). The tree's
# label module also writes use std.testing.assert_equal.
# fixture-package-tree: module-names/src/receipt.hd
use pkg.label.{double}
fn quadruple(count: i32) -> i32:
    double(double(count))

tests:
    use std.testing.assert_equal

    it("quadruples the count"):
        assert_equal(quadruple(+2), 8, reason="two four times")
