# test: shared and mutable reference-valued referents have different identities and cannot recover as each other
# Spec 09 Runtime Type Identity: trait.identity.reference-permission, trait.typeid.name.reference; Recovering A Concrete Type: trait.downcast.exact.reference-values.
# expect-stdout: false
# expect-stdout: false
use std.inspect.{Inspectable, TypeId}
struct User:
    count: i32
fn kind[T < Inspectable](_value: T) -> TypeId:
    TypeId::of::[T]()
fn forwarded_kind[T < Inspectable](value: T) -> TypeId:
    kind(value)
fn copied[T < Inspectable](value: T) -> T: value
pub fn main() -> void $ Console:
    let user = &User { count: 1 }
    let original = &user
    let erased: &dyn Inspectable = original
    println(TypeId::of::[*User]() == TypeId::of::[*mut User]())
    println(erased.downcast_ref::[*mut User]().is_some())
tests:
    use std.testing.{assert, assert_equal}
    it("mutable recovery preserves the original mutable reference"):
        let mut user = User { count: 1 }
        original := &mut user
        let erased: &mut dyn Inspectable = original
        match erased.downcast_mut::[User]():
            .Some(found) =>
                assert(found is original, reason="the original place")
                found.count += 1
            .None => assert(false, reason="User matches")
        assert_equal(user.count, 2, reason="the original value changed")
    it("an outer mutable reference does not upgrade its shared referent"):
        let mut user = &User { count: 3 }
        original := &mut user
        let erased: &mut dyn Inspectable = original
        assert(erased.downcast_mut::[*mut User]().is_none(), reason="the referent is a shared reference")
        match erased.downcast_mut::[*User]():
            .Some(found) =>
                assert(found is original, reason="the mutable reference to the shared reference")
                *found = &User { count: 7 }
            .None => assert(false, reason="&User matches")
        assert_equal(user.count, 7, reason="the shared reference value was replaced")
    it("generic identity stays permission sensitive through forwarding"):
        let mut user = User { count: 4 }
        assert(kind(&user) != kind(&mut user), reason="TypeId observes the actual reference permission")
        assert(forwarded_kind(&user) != forwarded_kind(&mut user), reason="the generic caller must retain the distinction too")
    it("sharing generic code preserves the actual mutable reference"):
        let mut user = User { count: 8 }
        original := &mut user
        found := copied(original)
        found.count += 1
        assert(found is original, reason="sharing code does not replace the reference")
        assert_equal(user.count, 9, reason="the returned reference keeps its actual setter")
    it("reference names retain permission"):
        assert_equal(TypeId::of::[*i32]().to_string(), "&i32", reason="shared reference spelling")
        assert_equal(TypeId::of::[*mut i32]().to_string(), "&mut i32", reason="mutable reference spelling")
