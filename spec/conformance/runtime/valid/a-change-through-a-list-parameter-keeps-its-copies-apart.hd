# test: a change through a `&mut List` parameter leaves the copies its argument shares unchanged
# Spec 04 Collection Values: types.coll.value.
# expect-stdout: 1 5 3 7; log 4 2

struct Holder:
    items: List[i32]

struct Log:
    lines: List[i32]

fn set_first(xs: &mut List[i32], v: i32) -> void:
    xs[0] = v

fn bump_first(xs: &mut List[i32]) -> void:
    xs[0] = xs[0] + 3

pub fn main() -> void $ Console:
    let mut h = Holder { items: [+1, +2] }
    copy := h.items
    set_first(&mut h.items, 5)
    let mut local = [+3]
    saved := local
    set_first(&mut local, 7)
    let mut log = Log { lines: [] }
    log.lines.push(1)
    log.lines.push(2)
    bump_first(&mut log.lines)
    println("${copy[0]} ${h.items[0]} ${saved[0]} ${local[0]}; log ${log.lines[0]} ${log.lines[1]}")
