# expect-stdout: the request timed out
# expect-stdout: closing, closed
# expect-stdout: clock 5000
# test: with cleanup=0s, timeout! cancels the work at the limit and abandons its cleanup at the first wait, after the synchronous part ran
# Spec std/task Result Timeouts: std-task.policy.time-limit.cleanup-deadline.
use std.ops.Disposable
use std.http.HttpError
use std.task.{timeout, apply}
use std.time.{Clock, ManualClock, Timestamp, s, sleep}

struct Close:
    log: *mut List[string]
    ack: mut Suspend[void]

impl Disposable for Close:
    fn dispose!(&mut self) -> void:
        defer:
            self.log.push("closed")
        self.log.push("closing")
        let mut ack = self.ack
        ack!()
        self.log.push("acknowledged")

# Waits on the host's clock, so it is still pending at the manual limit.
fn silent!() -> void $ Clock:
    sleep!(60s)

fn close!(
    log: *mut List[string],
    reply: mut Suspend[void],
    ack: mut Suspend[void],
) -> Result[void, HttpError] $ Clock:
    apply!(timeout(5s, cleanup=0s)):
        using close = &mut Close { log: log, ack: ack }
        reply!()
        let done: Result[void, HttpError] = .Ok(())
        done

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    let reply: mut Suspend[void] = silent()
    let ack: mut Suspend[void] = silent()
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Clock=clock):
        match close!(&mut log, reply, ack):
            .Ok(_) => println("closed in time")
            .Err(error) => println(error.to_string())
    println(log.join(", "))
    println("clock ${clock.now().unix_milliseconds()}")
