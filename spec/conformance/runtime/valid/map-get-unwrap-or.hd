# test: get followed by unwrap_or returns a map entry or an explicit fallback
# Spec 05 Map Indexing: expr.index.map.get; std/option Methods: std-option.unwrap-or.
fn stock_of(stock: Map[string, i32], item: string) -> i32:
    stock.get(item).unwrap_or(0)

tests:
    use std.testing.assert_equal

    it("returns the value or the fallback"):
        stock := { "tea": +3 }
        assert_equal(stock_of(stock, "tea"), 3, reason="present")
        assert_equal(stock_of(stock, "milk"), 0, reason="absent")
