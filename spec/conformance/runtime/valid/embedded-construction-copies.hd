# test: construction stores a copy of the part; ordinary fields of the part are copied shallowly
data Owner:
    name: string

data Stamp:
    pub at: i32
    pub owner: Owner

data Tagged:
    Stamp
    label: string

data Note:
    Tagged
    text: string

impl Stamp:
    pub fn bump(mut self) -> void:
        self.at = self.at + 1

tests:
    use std.testing.{assert, assert_equal}

    it("construction copies the part"):
        let mut stamp = Stamp { at: 1, owner: Owner { name: "ada" } }
        let mut note = Note { Tagged: ...Tagged { Stamp: ...stamp, label: "l" }, text: "t" }
        note.bump()
        assert_equal(note.at, 2, reason="the note's part changed")
        assert_equal(stamp.at, 1, reason="the source is not the part")
        stamp.bump()
        assert_equal(note.at, 2, reason="a change to the source is not seen in the note")
        assert(note.owner is stamp.owner, reason="an ordinary composite field is copied shallowly")

    it("nested parts are copied recursively"):
        let mut tagged = Tagged { Stamp: ...Stamp { at: 1, owner: Owner { name: "ada" } }, label: "l" }
        let mut note = Note { Tagged: ...tagged, text: "t" }
        note.bump()
        assert_equal(tagged.at, 1, reason="the nested part was copied too")
