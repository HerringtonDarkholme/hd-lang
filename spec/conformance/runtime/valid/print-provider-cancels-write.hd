# expect-stdout: before
# expect-stdout: after, 1 recorded
# test: println ignores a write that its provider's write! cancels: the line is lost, nothing panics, and the next println writes as usual
# Spec std/console: std-console.print.cancelled.
use std.console.print
use std.time.{Clock, s, sleep}

struct FlakyConsole:
    lines: List[string]
    gate: mut Suspend[void]

impl Console for FlakyConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        if text == "lost":
            let mut gate = self.gate
            gate!() # the gate was abandoned: this write is cancelled
        self.lines.push(text)
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write!(text)

pub fn main() -> void $ Console + Clock:
    let gate: mut Suspend[void] = sleep(s(60))
    gate.abandon()
    let mut flaky = FlakyConsole { lines: [], gate: gate }
    $.with(Console=&mut flaky):
        print("lost")
        print("kept")
    println("before")
    println("after, ${flaky.lines.len()} recorded")
