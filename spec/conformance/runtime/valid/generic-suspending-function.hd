# test: generic suspending function

use std.testing.assert_equal

fn echo![T](value: T) -> T: value

fn main!() -> i32:
    let pending: mut Suspend[i32] = echo(20)
    left := pending!()
    right := echo!(22)
    left + right

test "main returns 42":
    assert_equal(main!(), 42, reason="generic suspending function")
