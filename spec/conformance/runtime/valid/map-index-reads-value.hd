# test: m[k] reads V for a present key; m.get(k) reads V?
# Spec 05 Map Indexing: expr.index.map.read-value, expr.index.map.get (owner decision SSC Q8, batch 26, 2026-09-30).
fn score(scores: Map[string, i32], name: string) -> i32:
    match scores.get(name):
        .Some(value) => value
        .None => 0

fn strict(scores: Map[string, i32], name: string) -> i32:
    scores[name]

tests:
    use std.testing.assert_equal

    it("reads present and missing keys"):
        scores := {"ada": +36}
        assert_equal(strict(scores, "ada"), 36, reason="m[k] reads V")
        assert_equal(score(scores, "ada"), 36, reason="get finds a present key")
        assert_equal(score(scores, "grace"), 0, reason="get reads .None for a missing key")
