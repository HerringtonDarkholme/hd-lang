# test: literal-call elimination preserves capture snapshots and target lifetime
# Spec functions: fn.capture.copy.using-split and fn.capture.cell.writes.
use std.annotation.cold
use std.testing.assert

fn copied_window() -> bool:
    value := box(+7)
    f := fn() -> bool:
        if false:
            _ := value
        true
    f()

fn copied_live() -> bool:
    value := box(+7)
    f := fn() -> bool:
        if false:
            _ := value
        true
    during := f()
    during && *value == 7

# A function-valued capture also keeps that function's capture owners alive.
fn nested_window() -> bool:
    value := box(+7)
    f := fn() -> bool:
        if false:
            _ := value
        true
    g := fn() -> bool: f()
    g()

fn aliases() -> usize:
    let n: usize = 0
    f := fn() -> void: n += 1
    alias := f
    f()
    alias()
    n

struct Number:
    value: i32

impl Number:
    fn get(self) -> i32:
        self.value

fn bound_snapshot() -> bool:
    let mut value = Number { value: +7 }
    f := value::get
    value = Number { value: +9 }
    f() == 7 && value.value == 9

@cold
fn escaping() -> fn() -> bool:
    value := box(+7)
    fn() -> bool:
        if false:
            _ := value
        true

pub fn main() -> void:
    assert(copied_window())
    assert(copied_live())
    assert(nested_window())
    assert(aliases() == 2)
    assert(bound_snapshot())
    f := escaping()
    assert(f())
