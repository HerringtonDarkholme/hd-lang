# test: list draining borrows its receiver and preserves the unselected elements
# expect: test
# Spec std/collections: std-collections.list.drain, std-collections.list.drain-bounds.

fn first(items: &mut List[string]) -> string:
    for value in items.drain(1..3):
        return value
    "none"

tests:
    use std.testing.{assert, assert_equal}

    it("restores the tail after an early return and leaves snapshots unchanged"):
        let mut items = ["a", "b", "c", "d"]
        snapshot := items
        assert_equal(first(&mut items), "b")
        assert_equal(items, ["a", "d"])
        assert_equal(snapshot, ["a", "b", "c", "d"])

    it("handles full, empty and inclusive ranges"):
        let mut items = ["a", "b", "c", "d"]
        let mut found: List[string] = []
        for value in items.drain(1..=2):
            found.push(value)
        assert_equal(found, ["b", "c"])
        assert_equal(items, ["a", "d"])
        for value in items.drain(1..1):
            assert(false)
        assert_equal(items, ["a", "d"])
        for value in items.drain(2..2):
            assert(false)
        for value in items.drain(0..2):
            pass
        assert(items.is_empty())
        for value in items.drain(0..0):
            assert(false)

    it("drops a drain without reading it and drains nested fields"):
        let mut items = [["a"], ["b"], ["c"]]
        snapshot := items
        _ := items.drain(0..2)
        assert_equal(items, [["c"]])
        assert_equal(snapshot, [["a"], ["b"], ["c"]])

    it("drains a nested field and preserves unrelated fields"):
        let mut groups = [["a", "b", "c"], ["other"]]
        snapshot := groups
        _ := groups[0].drain(1..2)
        assert_equal(groups, [["a", "c"], ["other"]])
        assert_equal(snapshot, [["a", "b", "c"], ["other"]])
