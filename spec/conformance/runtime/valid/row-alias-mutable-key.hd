# test: a key reached through an alias keeps its trait's mutable access
# expect: test
trait Counter:
    fn count(self) -> i32
    fn bump(&mut self) -> void

struct MemoryCounter:
    value: i32

impl Counter for MemoryCounter:
    fn count(self) -> i32:
        self.value

    fn bump(&mut self) -> void:
        self.value = self.value + 1

type CounterRow = $ Counter

type Tally = $ CounterRow + Counter

fn tick() -> i32 $ Tally:
    $.use(Counter).bump()
    $.use(Counter).count()

tests:
    use std.testing.assert_equal

    it("the key reached through the alias is the mutable Counter"):
        let mut counter = &mut MemoryCounter { value: 0 }
        $.with(Counter=counter):
            _ := tick()
            assert_equal(tick(), 2, reason="both bumps reach one provider")
