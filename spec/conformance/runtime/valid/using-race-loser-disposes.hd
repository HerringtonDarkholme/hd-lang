# expect-stdout: won
# expect-stdout: open b, open a, defer inner, closing a, closed a, defer outer, closing b, closed b
# expect-stdout: done
# test: a race! loser holding using bindings whose dispose! suspends still disposes each, innermost frame first, and the race result is the winner's
# Spec lang/06 Using Bindings: flow.using.cancel, flow.using.cancel.shielded, flow.using.cancel.wait; lang/11 req.combinator.race-losers-disposed.
use std.ops.Disposable
use std.task.race
use std.time.{Clock, ms, s, sleep}

struct Conn:
    name: string
    log: *mut List[string]
    closing: mut Suspend[void]

impl Disposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing ${self.name}")
        let mut wait = self.closing
        wait!()
        self.log.push("closed ${self.name}")

fn connect(name: string, log: *mut List[string]) -> *mut Conn $ Clock:
    log.push("open ${name}")
    &mut Conn { name: name, log: log, closing: sleep(ms(2)) }

fn fetch!(log: *mut List[string]) -> string $ Clock:
    defer: log.push("defer outer")
    using a = connect("a", log)
    defer: log.push("defer inner")
    sleep!(s(60))
    log.push("fetched")
    "late"

fn session!(log: *mut List[string]) -> string $ Clock:
    using b = connect("b", log)
    fetch!(log)

fn ready!() -> string:
    "won"

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    winner := race!(session(&mut log), ready())
    println(winner)
    println(log.join(", "))
    println("done")
