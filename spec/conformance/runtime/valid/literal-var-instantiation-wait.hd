# test: among several instantiations, a literal argument keeps its default type
# Spec 04 Open Literal Width: types.literal.local.instantiation.
use std.testing.assert_equal

trait Combine[T]:
    fn combine(self, other: T) -> string

data Money:
    cents: i32

impl Combine[i32] for Money:
    fn combine(self, other: i32) -> string:
        "i32"

impl Combine[i64] for Money:
    fn combine(self, other: i64) -> string:
        "i64"

impl Combine[usize] for Money:
    fn combine(self, other: usize) -> string:
        "usize"

tests:
    it("a bare literal argument chooses the usize instantiation"):
        price := Money { cents: 10 }
        assert_equal(price.combine(5), "usize", reason="5 has no sign, so it is a usize")

    it("a signed literal argument chooses the i32 instantiation"):
        price := Money { cents: 10 }
        assert_equal(price.combine(+5), "i32", reason="+5 is an i32")

    it("an annotated binding chooses its own instantiation"):
        price := Money { cents: 10 }
        let n: i64 = 5
        assert_equal(price.combine(n), "i64", reason="n is an i64")
