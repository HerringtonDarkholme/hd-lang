# test: pointer loans: a `&` to a `UniqMap` value behind a `*T`, passed as a call argument; an alias reads the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
use std.collections.UniqMap

struct Outer:
    map: UniqMap[string, string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq_map(a: string, b: string) -> UniqMap[string, string]:
    let mut map = UniqMap::[string, string].new()
    _ := map.insert("a", a)
    _ := map.insert("b", b)
    map

fn make() -> *mut Outer:
    box(Outer { map: uniq_map(orig(), second()), other: second() })

fn observe(r: &string, alias: *Outer) -> string:
    seen_alias := alias.map.get("a").unwrap_or("")
    junk := churn()
    _ := seen_alias.len()
    seen := *r
    _ := junk.len()
    seen

fn probe(p: *mut Outer, alias: *Outer) -> string:
    observe(p.map.get_ref("a").expect("slot"), alias)

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
