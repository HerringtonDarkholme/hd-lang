# test: string length counts bytes

use std.testing.assert_equal

data User:
    name: string

fn name_length(user: User) -> i32: user.name.len()

fn main() -> i32: name_length(User { name: "A界😀" })

tests:
    it("main returns 8"):
        assert_equal(main(), 8, reason="string length counts bytes: 1 + 3 + 4")
