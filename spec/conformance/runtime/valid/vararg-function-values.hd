# test: a vararg function's value keeps the vararg, so it fits a function type whose inputs end in a rest element

use std.testing.assert_equal

fn count(values...: List[i32]) -> usize: values.len()
fn invoke(callback: fn(List[i32]...) -> usize, items: List[i32]) -> usize:
    callback(1, 2) * 10 + callback(items...)
fn main() -> usize:
    f := count
    invoke(f, [3, 4, 5])

tests:
    it("main returns 23"):
        assert_equal(main(), 23, reason="vararg function values")
