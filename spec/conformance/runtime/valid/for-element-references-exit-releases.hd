# test: leaving an element reference loop by break, continue or return releases its pin
# Spec 06 Element Reference Loops: flow.for.ref.access.
fn first_over(xs: &mut List[i32], limit: i32) -> i32:
    for x in &mut *xs:
        if *x > limit:
            return *x
    0

tests:
    use std.testing.assert_equal

    it("each way out of the loop unpins the list"):
        let mut xs = [+1, 2, 3]
        for x in &mut xs:
            if *x == 2:
                break
        xs.push(4)
        for x in &mut xs:
            if *x == 1:
                continue
            *x += 1
        xs.push(5)
        assert_equal(first_over(&mut xs, 2), 3, reason="the loop returned early")
        xs.push(6)
        assert_equal(xs, [+1, 3, 4, 5, 5, 6], reason="every push ran unpinned")
