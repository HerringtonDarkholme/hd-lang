# test: `==` on tuples holding a non-copyable struct and an open literal class borrows both operands, whichever side decides the class
# Spec 05 Expressions: expr.eq.trait.ref. Spec 04: types.literal.local.class.open.
# expect-stdout: true
# expect-stdout: true
struct Conn:
    id: usize

impl !Copy for Conn

impl Eq for Conn:
    fn eq(&self, other: &Self) -> bool: self.id == other.id

pub fn main() -> void $ Console:
    a := (Conn { id: 1 }, 3i64)
    b := (Conn { id: 1 }, +3)
    println(a == b)
    println(b == a)
