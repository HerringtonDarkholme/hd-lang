# test: pointer loans: a `&` to a `List` element behind a `*T`, used within one expression; an alias grows the collection; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
struct Outer:
    items: List[string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { items: [second(), orig()], other: second() })

fn length(slot: &string) -> string:
    *slot

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    seen := length(&p.items[1])
    for round in 0..16:
        alias.items.push(fresh())
    junk := churn()
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
