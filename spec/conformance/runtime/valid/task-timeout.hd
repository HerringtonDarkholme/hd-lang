# expect-stdout: timed out after 20ms
# expect-stdout: cleanup
# expect-stdout: gave up
# expect-stdout: done
# test: timeout! returns .Ok when the work finishes first and .Err(TimedOut) when the limit passes first
# Spec std/task: std-task.timeout.fields-value, std-task.timeout.display, std-task.policy.timeout.builder, std-task.policy.time-limit.race, std-task.policy.time-limit.completed, std-task.policy.time-limit.expired, std-task.timeout.tie, std-task.policy.time-limit.cancel-loser.
use std.task.{TimedOut, timeout, apply}
use std.time.{Clock, ManualClock, Timestamp, ms, s, sleep}

fn lookup!() -> string $ Clock:
    sleep!(5s)
    "value"

fn lookup_in_time!() -> Result[string, TimedOut] $ Clock:
    apply!(timeout(1s)):
        let done: Result[string, TimedOut] = .Ok(lookup!())
        done

struct Trace:
    lines: *mut List[string]

fn guarded!(trace: &mut Trace) -> string $ Clock:
    defer:
        trace.lines.push("cleanup")
    sleep!(5s)
    trace.lines.push("finished")
    "late"

pub fn main!() -> void $ Console + Clock:
    result := apply!(timeout(ms(20))):
        let done: Result[string, TimedOut] = .Ok(lookup!())
        done
    match result:
        .Ok(value) => println(value)
        .Err(error) => println(error.to_string())
    let trace: *mut Trace = box(Trace { lines: box::[List[string]]([]) })
    late := apply!(timeout(ms(20))):
        let done: Result[string, TimedOut] = .Ok(guarded!(trace))
        done
    println(trace.lines.join(","))
    println(if late.is_ok(): "ok" else: "gave up")
    println("done")

tests:
    use std.testing.{assert, assert_equal}

    it("returns .Ok when the work finishes first"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            assert_equal(lookup_in_time!(), .Ok("value"), reason="a manual clock never waits")
        assert_equal(clock.now().unix_milliseconds(), 5000, reason="the work's sleep ran")

    it("a zero limit still lets work that never suspends win"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            result := apply!(timeout(0ms)):
                let done: Result[usize, TimedOut] = .Ok(7)
                done
            assert_equal(result, .Ok(7), reason="the work is polled first")

    it("TimedOut has an Eq and a Display text"):
        error := TimedOut { limit: 1500ms, cleanup: .Finished }
        assert_equal(error, TimedOut { limit: 1500ms, cleanup: .Finished }, reason="equal fields")
        assert(
            error != TimedOut { limit: 1500ms, cleanup: .Abandoned },
            reason="the cleanup ends differ",
        )
        assert_equal(error.to_string(), "timed out after 1.5s", reason="the limit is shown")
        cut := TimedOut { limit: 1500ms, cleanup: .Abandoned }
        assert_equal(
            cut.to_string(),
            "timed out after 1.5s, cleanup abandoned",
            reason="an abandoned cleanup is shown",
        )
