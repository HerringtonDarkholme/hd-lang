# test: parse_f64 rejects text outside its grammar, at the first position no continuation allows, or at the text's end
# Spec std/num Float Parsing: std-num.parse-f64.excluded, .empty, .invalid-digit, and .text-end (owner decisions FLOAT-PARSE, batch 71, PARSE-EARLY-END, batch 73, and PARSE-F64-GRAMMAR, 2026-10-03).
use std.num.{parse_f64, ParseNumberError}
fn failure(text: string) -> ParseNumberError?:
    match parse_f64(text):
        .Ok(_) => .None
        .Err(error) => .Some(error)

fn ratio(text: string) -> f64:
    match parse_f64(text):
        .Ok(value) => value
        .Err(_) => 0.0


tests:
    use std.testing.assert_equal

    it("empty text is Empty"):
        assert_equal(ratio(""), 0.0, reason="an error falls back")
        assert_equal(failure(""), .Some(ParseNumberError.Empty), reason="no text")
    it("a character that breaks the grammar is InvalidDigit at its index"):
        cases := [
            (" 1.5", ParseNumberError.InvalidDigit(0)),
            ("1.5 ", ParseNumberError.InvalidDigit(3)),
            ("1_000.5", ParseNumberError.InvalidDigit(1)),
            ("0x1p-3", ParseNumberError.InvalidDigit(1)),
            ("1.5f", ParseNumberError.InvalidDigit(3)),
            ("1,5", ParseNumberError.InvalidDigit(1)),
            ("e5", ParseNumberError.InvalidDigit(0)),
            ("--1", ParseNumberError.InvalidDigit(1)),
            ("nana", ParseNumberError.InvalidDigit(3)),
            ("+nan5", ParseNumberError.InvalidDigit(4)),
        ]
        for case in cases:
            assert_equal(failure(case._0), .Some(case._1), reason=case._0)
    it("text that ends before the grammar is complete is InvalidDigit at its length"):
        cases := [
            (".", ParseNumberError.InvalidDigit(1)),
            ("+", ParseNumberError.InvalidDigit(1)),
            ("-", ParseNumberError.InvalidDigit(1)),
            ("1e", ParseNumberError.InvalidDigit(2)),
            ("1e+", ParseNumberError.InvalidDigit(3)),
            ("in", ParseNumberError.InvalidDigit(2)),
            ("infinit", ParseNumberError.InvalidDigit(7)),
        ]
        for case in cases:
            assert_equal(failure(case._0), .Some(case._1), reason=case._0)
