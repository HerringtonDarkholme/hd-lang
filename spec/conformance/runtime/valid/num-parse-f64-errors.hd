# test: parse_f64 rejects text outside the JSON number grammar, at the first position no continuation allows
# Spec std/num Float Parsing: std-num.parse-f64.grammar, .empty, and .invalid-digit (owner decision FLOAT-PARSE, batch 71, 2026-10-03), and .end-of-text (owner decision PARSE-EARLY-END, batch 73, 2026-10-03).
use std.num.{parse_f64, ParseNumberError}
use std.testing.assert_equal

fn failure(text: string) -> ParseNumberError?:
    match parse_f64(text):
        .Ok(_) => .None
        .Err(error) => .Some(error)

fn ratio(text: string) -> f64:
    match parse_f64(text):
        .Ok(value) => value
        .Err(_) => 0.0

fn at(position: i32) -> ParseNumberError?:
    .Some(ParseNumberError.InvalidDigit(position))

tests:
    it("empty text is Empty"):
        assert_equal(ratio(""), 0.0, reason="an error falls back")
        assert_equal(failure(""), .Some(ParseNumberError.Empty), reason="no text")
    it("a character that breaks the grammar is InvalidDigit at its index"):
        assert_equal(failure("+1"), at(0), reason="no leading plus")
        assert_equal(failure(" 1"), at(0), reason="no whitespace")
        assert_equal(failure(".5"), at(0), reason="a digit comes first")
        assert_equal(failure("01"), at(1), reason="no digit after a leading zero")
        assert_equal(failure("1.x"), at(2), reason="a fraction needs a digit")
        assert_equal(failure("1_0"), at(1), reason="no separator")
        assert_equal(failure("inf"), at(0), reason="no infinity")
        assert_equal(failure("NaN"), at(0), reason="no NaN")
        assert_equal(failure("1.5 "), at(3), reason="nothing after the number")
    it("text that ends where a digit must follow is InvalidDigit at its length"):
        assert_equal(failure("-"), at(1), reason="a lone minus")
        assert_equal(failure("1."), at(2), reason="a point with no digit")
        assert_equal(failure("1e"), at(2), reason="an exponent with no digit")
        assert_equal(failure("1e+"), at(3), reason="an exponent sign with no digit")
        assert_equal(failure("-1.5e-"), at(6), reason="the length, not the last index")
