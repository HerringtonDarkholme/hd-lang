# expect-stdout: 5 4
# A trait's mut self impl updates a struct's own copy, not its caller.
# Spec 07: fn.method.receiver.mut-self. Spec 09: trait.impl.signature.
trait Bump:
    fn bump(mut self) -> usize

struct Counter:
    n: usize

impl Bump for Counter:
    fn bump(mut self) -> usize:
        self.n += 1
        self.n

pub fn main() -> void $ Console:
    original := Counter { n: 4 }
    println("${original.bump()} ${original.n}")
