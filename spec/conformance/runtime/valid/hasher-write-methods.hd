# test: typed Hasher defaults and overrides preserve their byte streams and existing hash values
# Spec std Hash, Bytes Written and Hasher methods: trait.hash.typed-methods,
# trait.hash.typed-bytes, trait.hash.string-bytes, trait.hash.override-equivalent,
# std-hash.default.typed-writes, std-hash.bytes.sequence.
use std.hash.Hasher

use std.hash.{DefaultHasher, hash_of}

struct Recorder:
    bytes: List[u8]

impl Hasher for Recorder:
    fn write(&mut self, bytes: List[u8]) -> void:
        for byte in bytes:
            self.bytes.push(byte)

fn digest(bytes: List[u8]) -> u64:
    let mut hasher = DefaultHasher::new()
    hasher.write(bytes)
    hasher.finish()

# Distinct bytes expose width and order; negative values expose sign extension.
fn write_typed(state: &mut dyn Hasher) -> void:
    state.write([91])
    state.write_u8(171)
    state.write_u16(4660)
    state.write_u32(305419896)
    state.write_u64(72623859790382856)
    state.write_usize(2309737967)
    state.write_i8(-2)
    state.write_i16(-2)
    state.write_i32(-2)
    state.write_i64(-2)
    state.write_str("h\u{E9}")
    state.write_str("")
    state.write([92, 93])

fn typed_bytes() -> List[u8]:
    [91, 171, 52, 18, 120, 86, 52, 18, 8, 7, 6, 5, 4, 3, 2, 1, 239, 205, 171, 137, 254, 254, 255, 254, 255, 255, 255, 254, 255, 255, 255, 255, 255, 255, 255, 104, 195, 169, 92, 93]

fn write_edges(state: &mut dyn Hasher) -> void:
    state.write_i8(-128)
    state.write_i16(-32768)
    state.write_i32(-2147483648)
    state.write_i64(-9223372036854775808)
    state.write_u64(18446744073709551615)
    state.write_usize(4294967295)

fn edge_bytes() -> List[u8]:
    [128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0, 128, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255]

# Equal keys use different write methods for the same byte stream. Map lookups
# therefore check its private hasher without depending on its hash algorithm.
struct ByteKey:
    padding: usize
    typed: bool

impl Eq for ByteKey:
    fn eq(self, other: ByteKey) -> bool:
        self.padding == other.padding

impl Hash for ByteKey:
    fn hash(self, state: &mut dyn Hasher) -> void:
        for _index in 0..self.padding:
            state.write([23])
        if self.typed:
            write_typed(state)
            write_edges(state)
        else:
            state.write(typed_bytes())
            state.write(edge_bytes())

tests:
    use std.testing.assert_equal

    it("a hasher with only write gets the eight little-endian bytes of write_u64"):
        let mut recorder = Recorder { bytes: [] }
        recorder.write_u64(258)
        assert_equal(recorder.bytes, [2, 1, 0, 0, 0, 0, 0, 0], reason="least significant first")

    it("write_u64 writes the top byte of a large value last"):
        let mut recorder = Recorder { bytes: [] }
        let big: u64 = 18446744073709551615
        recorder.write_u64(big)
        assert_equal(recorder.bytes, [255, 255, 255, 255, 255, 255, 255, 255], reason="all ones")

    it("a hasher with only write gets the UTF-8 bytes of write_str, with no length"):
        let mut recorder = Recorder { bytes: [] }
        recorder.write_str("h\u{E9}")
        assert_equal(recorder.bytes, [104, 195, 169], reason="UTF-8 bytes only")

    it("DefaultHasher write_u64 matches write of the same eight bytes"):
        let mut hasher = DefaultHasher::new()
        hasher.write_u64(258)
        assert_equal(hasher.finish(), digest([2, 1, 0, 0, 0, 0, 0, 0]), reason="one u64")

    it("DefaultHasher write_str matches write of the UTF-8 bytes"):
        let mut hasher = DefaultHasher::new()
        hasher.write_str("h\u{E9}")
        assert_equal(hasher.finish(), digest([104, 195, 169]), reason="one string")
        let mut empty = DefaultHasher::new()
        empty.write_str("")
        assert_equal(empty.finish(), digest([]), reason="no bytes")

    it("the calls mix with write in any order"):
        let mut hasher = DefaultHasher::new()
        hasher.write([7])
        hasher.write_u64(1)
        hasher.write_str("a")
        assert_equal(hasher.finish(), digest([7, 1, 0, 0, 0, 0, 0, 0, 0, 97]), reason="same byte stream")

    it("hash_of values for integers and strings are unchanged"):
        let key: (u8, string) = (7, "a")
        let expected: u64 = 12920292002639229810
        assert_equal(hash_of(key), expected, reason="the spec's digest of (7, \"a\")")
        let wide: u64 = 258
        assert_equal(hash_of(wide), digest([2, 1, 0, 0, 0, 0, 0, 0]), reason="a u64 writes eight bytes")
        let negative: i64 = -2
        assert_equal(hash_of(negative), digest([254, 255, 255, 255, 255, 255, 255, 255]), reason="an i64 writes its two's complement")
        let narrow: i32 = -2
        assert_equal(hash_of(narrow), digest([254, 255, 255, 255]), reason="an i32 writes four bytes")
        assert_equal(hash_of("hd"), digest([2, 0, 0, 0, 0, 0, 0, 0, 104, 100]), reason="length, then bytes")

    it("all typed defaults preserve their widths and little-endian byte order"):
        let mut recorder = Recorder { bytes: [] }
        write_typed(&mut recorder)
        assert_equal(recorder.bytes, typed_bytes(), reason="unsigned widths, signed bytes, usize and UTF-8")

    it("signed minima and unsigned maxima keep every bit"):
        let mut recorder = Recorder { bytes: [] }
        write_edges(&mut recorder)
        assert_equal(recorder.bytes, edge_bytes(), reason="two's complement at each width and 32-bit usize")

    it("DefaultHasher typed writes match bytes across mixed call boundaries"):
        for padding in 0..4:
            typed := DefaultHasher::new()
            raw := DefaultHasher::new()
            for _index in 0..padding:
                typed.write([23])
                raw.write([23])
            write_typed(typed)
            write_edges(typed)
            raw.write(typed_bytes())
            raw.write(edge_bytes())
            assert_equal(typed.finish(), raw.finish(), reason="same bytes with zero to three leading bytes")

    it("Map keys hash equally through typed and raw writes at every word offset"):
        let mut values: Map[ByteKey, usize] = {}
        for padding in 0..4:
            values[ByteKey { padding: padding, typed: false }] = padding + 7
            assert_equal(values.get(ByteKey { padding: padding, typed: true }), .Some(padding + 7), reason="typed lookup finds a raw-written key")
            values[ByteKey { padding: padding, typed: true }] = padding + 9
            assert_equal(values.get(ByteKey { padding: padding, typed: false }), .Some(padding + 9), reason="raw lookup finds the updated typed-written key")
        assert_equal(values.len(), 4, reason="typed and raw modes are the same keys")
