# test: pointer loans: a `&` to a `UniqList` element behind a `*T`, stored in a lifetime struct; an alias reads the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision elided; call-scoped fallback rejected; Go model runs.
use std.collections.UniqList

struct Outer:
    items: UniqList[string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq(first: string, last: string) -> UniqList[string]:
    let mut items = UniqList::[string].new()
    items.push(first)
    items.push(last)
    items

fn make() -> *mut Outer:
    box(Outer { items: uniq(second(), orig()), other: second() })

struct View['a]:
    r: &'a string

fn probe(p: *mut Outer, alias: *Outer) -> string:
    view := View { r: p.items.get_ref(1).expect("slot") }
    seen_alias := alias.items.get(1).unwrap_or("")
    junk := churn()
    _ := seen_alias.len()
    seen := *view.r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
