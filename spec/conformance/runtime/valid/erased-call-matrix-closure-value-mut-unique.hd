# test: erased call matrix closure-value-mut-unique
# expect: test
# Generated by spec/tools/generate-erased-call-matrix.ts; edit the generator.
# Rules: trait.dyn.safe.method-type-param, ref.generic.local.
use std.collections.UniqList

struct Parcel:
    words: UniqList[string]

impl !Copy for Parcel

impl Item for Parcel:
    fn value(&self) -> usize:
        self.words.len()
    fn bump(&mut self) -> void:
        self.words.push("extra")

fn make(round: usize) -> Parcel:
    let mut words = UniqList::[string].new()
    words.push("word_$round")
    words.push("tail_$round")
    Parcel { words: words }

trait Item < ?Copy:
    fn value(&self) -> usize
    fn bump(&mut self) -> void

trait Driver:
    fn run[T < ?Copy & Item](&mut self, value: T) -> T

struct Worker:
    calls: usize

impl Driver for Worker:
    fn run[T < ?Copy & Item](&mut self, value: T) -> T:
        self.calls += 1
        apply := fn(value: T) -> T: value
        apply(value)

tests:
    it("closure-value-mut-unique preserves its argument and receiver"):
        for round in 0..8:
            let mut worker = Worker { calls: 0 }
            let mut item: Parcel = make(round)
            before := item.value()
            let driver: &mut dyn Driver = &mut worker
            back := driver.run(item)
            assert_equal(back.value(), before, reason="the moved result remains usable")
            assert_equal(
                back.words.get_ref(0).expect("first word"),
                &"word_$round",
                reason="the nested buffer keeps its original element",
            )
            assert_equal(worker.calls, 1, reason="receiver effects reach the caller")
