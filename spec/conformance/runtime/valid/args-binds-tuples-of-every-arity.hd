# test: args binds tuples of every arity
# Spec 07 Function Types: fn.type.ctor.inputs.
# expect-stdout: 7
# expect-stdout: -5
# expect-stdout: abc
# expect-stdout: t3
# expect-stdout: u0
use std.function.{Fn, SuspendFn, Tuple}

fn call[Args < Tuple, O, $ R](f: Fn[Args, O, $ R], args...: Args) -> O $ R:
    f(args...)

fn through[Args < Tuple, O](f: Fn[Args, O, $ ()], args: Args) -> O:
    f(args...)

fn retry![Args < Tuple, O](f: SuspendFn[Args, O, $ ()], args: Args) -> O:
    f!(args...)

fn zero() -> i32:
    7
fn neg(a: i32) -> i32:
    0 - a
fn join(a: string, b: string, c: string) -> string:
    a + b + c
fn tail(tag: string, xs...: List[i32]) -> string:
    "${tag}${xs.len()}"

pub fn main() -> void $ Console:
    println(call(zero))
    println(call(neg, 5))
    println(call(join, "a", "b", "c"))
    println(call(tail, "t", 1, 2, 3))
    println(call(tail, "u"))
