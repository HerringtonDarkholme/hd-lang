# expect-stdout: won stopped
# expect-stdout: close sent, channel defer
# expect-stdout: closed false
# expect-stdout: Result.Ok(())
# expect-stdout: Result.Ok([7])
# expect-stdout: [1, 2]
# test: abandon() aborts the wait of a dispose! that borrows a socket and closes nothing, so the socket stays open and usable
# Spec lang/11 Abandoning: req.abandon.host, req.abandon.dispose.
use std.net.{ScriptedStream, TcpStream}
use std.ops.AsyncDisposable
use std.task.{all, race}
use std.time.{Clock, s, sleep}

struct Channel:
    socket: *mut ScriptedStream
    acked: mut Suspend[void]
    log: *mut List[string]

impl AsyncDisposable for Channel:
    fn dispose!(&mut self) -> void:
        defer:
            self.log.push("channel defer")
        _ := self.socket.write!([1])
        self.log.push("close sent")
        let mut wait = self.acked
        wait!()
        self.log.push("ack received")

fn serve!(socket: *mut ScriptedStream, log: *mut List[string]) -> string $ Clock:
    using! channel = &mut Channel { socket: socket, acked: sleep(s(60)), log: log }
    sleep!(s(60))
    "late"

fn ready!() -> string:
    "won"

fn stop!(job: mut Suspend[string]) -> string:
    job.abandon()
    "stopped"

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    socket := ScriptedStream::new([[7]])
    let job: mut Suspend[string] = serve(socket, &mut log)
    let (winner, stopped) = all!(race(job, ready()), stop(job))
    println("${winner} ${stopped}")
    println(log.join(", "))
    println("closed ${socket.is_closed()}")
    println(debug(socket.write!([2])))
    println(debug(socket.read!(4)))
    println(debug(socket.written()))
