# test: literal patterns

use std.testing.assert_equal

fn integer(value: i32) -> i32:
    match value:
        -1 => 10
        42 => 20
        other => other

fn floating(value: f64) -> i32:
    match value:
        -1.5 => 3
        _ => 0

fn character(value: char) -> i32:
    match value:
        '😀' => 4
        _ => 0

fn text(value: string) -> i32:
    match value:
        "hd" => 5
        _ => 0

fn main() -> i32: integer(42) + floating(-1.5) + character('😀') + text("hd") + integer(0)

test "main returns 32":
    assert_equal(main(), 32, reason="literal patterns")
