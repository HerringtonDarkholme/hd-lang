# test: a supertrait with a self member stays usable through the subtrait
# Rules: trait.dyn.member.self, trait.dyn.member.unavailable.error, trait.dyn.member.other-with-opaque.
# expect-stdout: 5
trait Base:
    fn id(self) -> i32
    fn merge(self, other: Self) -> Self

trait Sub < Base:
    fn extra(self) -> i32

struct D:
    n: i32

impl Base for D:
    fn id(self) -> i32: self.n
    fn merge(self, other: D) -> D: self

impl Sub for D:
    fn extra(self) -> i32: 4

fn show(s: &dyn Sub) -> i32:
    s.id() + s.extra()

pub fn main() -> void $ Console:
    println(show(&D { n: 1 }))
