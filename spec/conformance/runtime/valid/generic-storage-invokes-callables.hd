# test: a callable stored in a generic list, tuple, map, or data field runs the same as a direct call
# Spec 04 Generic Representation: types.generic.unobservable; how generic code stores a function value is not observable.
data Queue[T]:
    jobs: T

fn first_job[T](jobs: List[fn() -> T]) -> T:
    job := jobs[0]
    job()

fn pending_scores[T](job: fn() -> T) -> List[fn() -> T]:
    [job]

fn score_first[T](scorers: List[fn(T) -> i32], value: T) -> i32:
    scorer := scorers[0]
    scorer(value)

fn run_queued[T](queue: Queue[List[fn() -> T]]) -> T:
    job := queue.jobs[0]
    job()

fn run_paired[T](entry: (fn() -> T, string)) -> T:
    let (job, _) = entry
    job()

fn run_named[T](jobs: Map[string, fn() -> T], name: string, fallback: T) -> T:
    match jobs.get(name):
        .Some(job) => job()
        .None => fallback

fn nightly_backup() -> i32: 42

fn queued_backup() -> i32:
    run_queued(Queue { jobs: [fn() -> i32: 42] })

tests:
    use std.testing.assert_equal

    it("a generic list invokes a stored closure"):
        assert_equal(first_job([fn() -> i32: 42]), 42, reason="the element is called through List[fn() -> T]")

    it("a generic list result keeps the stored function"):
        jobs := pending_scores(nightly_backup)
        job := jobs[0]
        assert_equal(job(), 42, reason="List[fn() -> T] returned with T = i32")

    it("a generic list invokes a callable with a generic input"):
        assert_equal(score_first([fn(points: i32) -> i32: points + 1], 41), 42, reason="the input crosses as T")

    it("nested generic storage invokes a stored callable"):
        assert_equal(queued_backup(), 42, reason="Queue[List[fn() -> T]]")

    it("a generic tuple invokes a stored callable"):
        assert_equal(run_paired((fn() -> i32: 42, "backup")), 42, reason="(fn() -> T, string)")

    it("a generic map invokes a stored callable"):
        assert_equal(run_named({"backup": fn() -> i32: 42}, "backup", 0), 42, reason="Map[string, fn() -> T]")
