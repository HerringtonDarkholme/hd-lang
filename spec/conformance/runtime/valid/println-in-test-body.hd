# test: a test body runs under a driver, and println called from it writes through the covering provider
# Spec 10 Console: module.console.println-non-suspending (batch 44).
struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write_sync(text)

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")

tests:
    use std.testing.assert_equal

    it("println writes under the test driver"):
        console := box(MemoryConsole { lines: [] })
        $.with(Console=console):
            greet("Ada")
        assert_equal(console.lines.len(), 2, reason="text and newline are separate writes")
        assert_equal(
            console.lines,
            ["hello, Ada", "\n"],
            reason="the provider received both chunks",
        )
