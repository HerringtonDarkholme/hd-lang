# test: a test body runs under a driver, and println called from it writes through the covering provider
# Spec 10 Console: module.console.println-block-on.under-driver (batch 44).
struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write!(text)

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")

tests:
    use std.testing.assert_equal

    it("println writes under the test driver"):
        let mut console = MemoryConsole { lines: [] }
        $.with(Console=&mut console):
            greet("Ada")
        assert_equal(console.lines.len(), 2, reason="text and newline are separate writes")
        assert_equal(
            console.lines,
            ["hello, Ada", "\n"],
            reason="the provider received both chunks",
        )
