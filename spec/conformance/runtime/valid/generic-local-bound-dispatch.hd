# test: a bound supplies a method
# Rules: fn.local.declare, fn.generic.call-list.
# expect-stdout: 19
trait Shape:
    fn area(self) -> i32

struct Square:
    side: i32

impl Shape for Square:
    fn area(self) -> i32:
        self.side * self.side

struct Rect:
    width: i32
    height: i32

impl Shape for Rect:
    fn area(self) -> i32:
        self.width * self.height

fn floor_area() -> i32:
    fn area_of[S < Shape](shape: S) -> i32:
        shape.area()
    area_of(Square { side: 3 }) + area_of(Rect { width: 2, height: 5 })

pub fn main() -> void $ Console:
    println(floor_area())
