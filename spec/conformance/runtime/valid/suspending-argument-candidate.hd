# test: a suspending argument is checked per candidate without ambiguity
# Spec 09 Traits: trait.resolve.one-fit (exactly one fitting candidate is selected).
use std.testing.assert_equal

trait Pick[T]:
    fn pick(self, value: T) -> i32

data Item: pass

impl Pick[bool] for Item:
    fn pick(self, value: bool) -> i32: 0

impl Pick[i32] for Item:
    fn pick(self, value: i32) -> i32: value

fn child!() -> i32: 42

pub fn main!() -> void:
    assert_equal(Item {}.pick(child!()), 42, reason="the i32 candidate fits the suspending call")
