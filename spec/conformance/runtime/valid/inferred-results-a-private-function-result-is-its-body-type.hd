# test: a private function result is its body type
# Spec lang/07-functions.md: fn.decl.result-inferred.
# expect-stdout: 42 x

fn first(): second() + 1

fn second(): answer() - 1

fn answer(): +42

fn head[T](items: List[T]): items[0]

pub fn main() -> void $ Console:
    let n: i32 = first()
    let s: string = head(["x", "y"])
    println("${n} ${s}")
