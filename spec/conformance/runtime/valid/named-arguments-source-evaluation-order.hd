# test: named arguments source evaluation order
# Spec 07 Arguments: fn.arg.mix, fn.arg.labels, fn.arg.once.
# Spec 05 Calls: expr.call.order, expr.call.callable,
# expr.call.positional-first, expr.call.named, expr.call.exactly-once,
# expr.call.source-order.

fn first!() -> i32: 1
fn second!() -> i32: 2
fn combine(first: i32, second: i32) -> i32: first * 10 + second
fn main!() -> i32:
    combine(second=first!(), first=second!())

tests:
    use std.testing.assert_equal

    it("main returns 21"):
        assert_equal(main!(), 21, reason="named arguments source evaluation order")
