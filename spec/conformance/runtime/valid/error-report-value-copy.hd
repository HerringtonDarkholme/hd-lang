# test: ErrorReport is a value: changing a copy's fields leaves the report it was copied from as it was
# Spec std/error Error Reports: std-error.report.sources-struct, std-error.report.of.reference-values, std-error.report.message.
# expect-stdout: disk full 0 changed 1
use std.error.{message, report_of}

pub fn main() -> void $ Console:
    let mut report = report_of(message("disk full"))
    kept := report
    report.message = "changed"
    report.sources.push("more")
    println("${kept.message} ${kept.sources.len()} ${report.message} ${report.sources.len()}")
