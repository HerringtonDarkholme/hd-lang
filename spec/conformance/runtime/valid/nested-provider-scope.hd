# test: requirements / provider scopes
# Spec 11 Provider Scopes: req.with.block, req.with.evaluated,
# req.with.type, req.with.nested, req.with.nearest, req.with.nearest.which,
# req.with.nearest.not-error, req.use.value.flow,
# req.use.value.row-meaning.

fn run() -> i32 $ Clock + Backup:
    _ := $.use(Clock)
    $.with(Clock=$.use(Backup)):
        _ := $.use(Clock)
        42

trait Clock

data FixedClock: pass

impl Clock for FixedClock

trait Backup < Clock:
    fn label(self) -> i32

data FixedBackup: pass

impl Clock for FixedBackup

impl Backup for FixedBackup:
    fn label(self) -> i32: 0

tests:
    use std.testing.assert_equal

    it("run returns 42 with its providers"):
        $.with(Clock=FixedClock {}, Backup=FixedBackup {}):
            assert_equal(run(), 42, reason="requirements / provider scopes")
