# test: an associated type projection of self keeps a method available
# Rules: trait.dyn.member.other-with-opaque, trait.dyn.binding.signatures, trait.dyn.bound.reference-dispatch.
# expect-stdout: 8
trait Bag:
    type Item
    fn first(self) -> Self::Item

struct D:
    n: i32

impl Bag for D:
    type Item = i32
    fn first(self) -> i32: self.n

fn show(b: &dyn Bag[Item = i32]) -> i32:
    b.first()

pub fn main() -> void $ Console:
    println(show(&D { n: 8 }))
