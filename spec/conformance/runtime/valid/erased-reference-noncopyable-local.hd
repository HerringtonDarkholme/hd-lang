# test: an erased generic method lends its own non-copyable local to a thunk without copying it
# expect: test
# Spec std/collections UniqList: std-collections.uniq-list.type.
use std.collections.UniqList

trait Sink:
    fn hold[T < ?Copy](&self, x: T) -> usize

struct Bin:
    n: usize

impl Sink for Bin:
    fn hold[T < ?Copy](&self, x: T) -> usize:
        let mut l = UniqList::[T].new()
        l.push(x)
        l.len()

fn names(n: usize) -> UniqList[string]:
    let mut out = UniqList::[string].new()
    for i in 0..n:
        out.push("name {i}")
    out

tests:
    use std.testing.assert_equal

    it("holds a non-copyable list in a list the erased body owns"):
        b := Bin { n: 7 }
        let s: &dyn Sink = &b
        assert_equal(s.hold(names(5)), 1, reason="the erased list holds the one moved list")
        assert_equal(b.n, 7, reason="the receiver is unchanged")
