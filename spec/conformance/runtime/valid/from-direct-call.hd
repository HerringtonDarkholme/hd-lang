# test: Target::from(value) calls a conversion directly and selects the instantiation by argument
# Spec 09 Conversion Trait: code may call a conversion directly as `X::from(value)`; with
# several instantiations, the one whose parameter the argument fits is selected.
# Spec 09 Traits: trait.from.meaning, trait.from.import, trait.from.direct, trait.from.no-overlap, trait.from.instantiations, trait.from.candidates.
use std.convert.From
use std.testing.assert_equal

enum FsError:
    NotFound(path: string)

enum HttpError:
    Timeout(url: string)

enum SyncError:
    Fs(error: FsError)
    Http(error: HttpError)

impl From[FsError] for SyncError:
    fn from(value: FsError) -> SyncError: SyncError.Fs(value)

impl From[HttpError] for SyncError:
    fn from(value: HttpError) -> SyncError: SyncError.Http(value)

fn fs_path(error: FsError) -> string:
    match error:
        FsError.NotFound(path) => path

fn http_url(error: HttpError) -> string:
    match error:
        HttpError.Timeout(url) => url

fn label(error: SyncError) -> string:
    match error:
        SyncError.Fs(inner) => "fs: " + fs_path(inner)
        SyncError.Http(inner) => "http: " + http_url(inner)

tests:
    it("a file error selects From[FsError]"):
        assert_equal(label(SyncError::from(FsError.NotFound("a.txt"))), "fs: a.txt", reason="argument type FsError")

    it("a network error selects From[HttpError]"):
        assert_equal(label(SyncError::from(HttpError.Timeout("x.test"))), "http: x.test", reason="argument type HttpError")
