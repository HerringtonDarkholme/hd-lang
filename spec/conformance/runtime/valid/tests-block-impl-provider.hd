# test: a data type and its impl declared inside a tests block serve as a provider, a generic argument, and a trait value
# Spec 03 Tests Blocks: names.tests.module-items; the block's items are module items,
# so it may hold implementations, and test code reaches them through $.with.
# Spec 02 Test Blocks: grammar.tests.item-forms.
trait Mailer:
    fn send(self, to: string) -> string

fn register(email: string) -> string $ Mailer:
    $.use(Mailer).send(email)

fn notify[M < Mailer](mailer: M, to: string) -> string:
    mailer.send(to)

fn through(mailer: dyn Mailer, to: string) -> string:
    mailer.send(to)

tests:
    use std.testing.assert_equal

    @derive(Eq, Debug)
    struct OutboxMailer:
        label: string

    impl Mailer for OutboxMailer:
        fn send(self, to: string) -> string: "outbox:${self.label}:$to"

    it("installs the test-only mailer as the provider"):
        $.with(Mailer=OutboxMailer { label: "case" }):
            assert_equal(register("ada@example.com"), "outbox:case:ada@example.com", reason="the installed fake")

    it("passes the test-only mailer to generic and trait-value parameters"):
        mailer := OutboxMailer { label: "direct" }
        assert_equal(notify(mailer, "bo"), "outbox:direct:bo", reason="a generic instance")
        assert_equal(through(mailer, "cy"), "outbox:direct:cy", reason="a trait value")
        assert_equal(mailer, OutboxMailer { label: "direct" }, reason="a derived Eq")
