# test: List element places and Map.get_or_insert update stored elements in place
# Spec 13 Element References: ref.elem.list; std Collections: std-collections.map.get-or-insert.
fn adjust(items: &mut List[i32], stock: &mut Map[string, i32]) -> void:
    items[1] += 10
    *stock.get_or_insert("tea", 0) += 1

tests:
    use std.testing.assert_equal

    it("updates list and map elements in place"):
        let mut items = [+1, 2, 3]
        let mut stock: Map[string, i32] = { "tea": +4 }
        adjust(&mut items, &mut stock)
        assert_equal(items, [1, 12, 3])
        assert_equal(stock["tea"], 5)

    it("updates the first and last elements"):
        let mut items = [+1, 2, 3]
        items[0] += 10
        items[items.len() - 1] += 20
        assert_equal(items, [11, 2, 23])

    it("inserts a missing map element"):
        let mut stock: Map[string, i32] = {}
        *stock.get_or_insert("tea", +4) += 1
        assert_equal(stock["tea"], +5)
