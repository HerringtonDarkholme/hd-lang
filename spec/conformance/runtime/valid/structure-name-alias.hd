# test: a derivation through a transparent alias sees its base type's Structure, so its name
# Spec 14 The Structure Trait: annot.structure.name.alias.
use std.structure.{Structure, Field, Variant, Describer}

trait Named:
    fn type_name() -> string

data Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

impl[T] Named for T by Structure:
    fn type_name() -> string:
        let mut d = Count { n: 0 }
        _ := T::describe(d)
        T::name()

@derive(Named)
data Point:
    x: i32

type Spot = Point

tests:
    use std.testing.assert_equal

    it("the alias reports its base type's name"):
        assert_equal(Spot::type_name(), "Point", reason="an alias has no Structure of its own")
