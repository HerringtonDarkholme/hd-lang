# test: the name before { in a data literal resolves as a type, even beside a local value of that name
# Spec 03 Lookup Categories: names.category.syntax.type.
data Point:
    x: i32

fn make() -> Point:
    Point := +4
    Point { x: Point }

tests:
    use std.testing.assert_equal

    it("the type and the value are found apart"):
        assert_equal(make().x, +4, reason="Point { ... } is the type, x: Point the value")
