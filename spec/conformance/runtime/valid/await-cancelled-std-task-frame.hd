# expect-stdout: run body, a defer, b defer, stopper finished, supervise defer, runner defer
# expect-stdout: abandoned
# expect-stdout: run body, c defer, d defer, stopper finished, waiter defer, supervise defer, runner defer
# expect-stdout: abandoned
# test: awaiting a stored std.task race that another task cancelled cancels the awaiter, as an all! child and through a bang call
# Spec lang/11 Cancellation: req.cancel.await, req.cancel.await.kinds, req.cancel.await.dispose.
use std.ops.Disposable
use std.task.{all, race}
use std.time.{Clock, ms, s, sleep}

data Runner:
    log: mut List[string]
    job: mut Suspend[string]

impl Disposable for Runner:
    fn dispose!(mut self) -> void:
        defer: self.log.push("runner defer")
        let mut job = self.job
        value := job!()
        self.log.push("runner got ${value}")

fn run!(log: mut List[string], job: mut Suspend[string]) -> void:
    using runner = Runner { log: log, job: job }
    log.push("run body")

fn ended!(job: mut Suspend[void]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn slow!(name: string, log: mut List[string]) -> void $ Clock:
    defer: log.push("${name} defer")
    sleep!(s(60))

fn stop_later!(job: mut Suspend[void], log: mut List[string]) -> void $ Clock:
    sleep!(ms(1))
    match job.cancel!():
        .Finished => log.push("stopper finished")
        .Abandoned => log.push("stopper abandoned")

fn waiter!(job: mut Suspend[void], log: mut List[string]) -> void:
    defer: log.push("waiter defer")
    job!()
    log.push("waiter never")

fn supervise!(job: mut Suspend[void], log: mut List[string]) -> string $ Clock:
    defer: log.push("supervise defer")
    _ := all!(job, stop_later(job, log))
    "supervise never"

fn supervise_waiter!(job: mut Suspend[void], log: mut List[string]) -> string $ Clock:
    defer: log.push("supervise defer")
    _ := all!(waiter(job, log), stop_later(job, log))
    "supervise never"

pub fn main!() -> void $ Console + Clock:
    let log: mut List[string] = []
    let runner: mut Suspend[void] = run(log, supervise(race(slow("a", log), slow("b", log)), log))
    runner!()
    println(log.join(", "))
    println(ended!(runner))
    let other: mut List[string] = []
    let pair: mut Suspend[void] = race(slow("c", other), slow("d", other))
    let second: mut Suspend[void] = run(other, supervise_waiter(pair, other))
    second!()
    println(other.join(", "))
    println(ended!(second))
