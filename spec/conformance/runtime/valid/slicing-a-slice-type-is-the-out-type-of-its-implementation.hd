# test: slice methods return new values of the receiver's collection type
# expect-stdout: a
# expect-stdout: 1
# expect-stdout: 9
fn texts(text: string) -> string:
    text.slice(0, 1)

fn lists(items: List[i32]) -> List[i32]:
    items.slice(0, 1)

fn grown(items: List[i32]) -> List[i32]:
    let mut part = items.slice(0, 2)
    part.push(9)
    part

pub fn main() -> void $ Console:
    println(texts("abc"))
    println(lists([4, 5]).len())
    println(grown([1, 2, 3])[2])
