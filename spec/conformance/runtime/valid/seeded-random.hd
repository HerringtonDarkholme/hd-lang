# test: SeededRandom gives the same draws for the same seed, directly and through $.with
# Spec std/random Seeded Random: std-random.seeded.decl, std-random.seeded.new, and std-random.seeded.same-seed (STDLIB decision 4, PROVIDER-SHAPES; task #220).
use std.random.{Random, SeededRandom}
fn roll() -> u64 $ Random:
    $.use(Random).next_u64() % 6 + 1

tests:
    use std.testing.{assert, assert_equal}

    it("one seed, one sequence"):
        let mut first = SeededRandom::new(7)
        let mut again = SeededRandom::new(7)
        let rolled: u64 = 0
        $.with(Random=first):
            rolled = roll()
        $.with(Random=again):
            assert_equal(roll(), rolled, reason="the same seed rolls the same")

    it("next_u64 and fill repeat for a seed"):
        let mut a = SeededRandom::new(42)
        let mut b = SeededRandom::new(42)
        let index = 0
        while index < 5:
            assert_equal(a.next_u64(), b.next_u64(), reason="the same draw")
            index = index + 1
        bytes := a.fill(16)
        assert_equal(bytes, b.fill(16), reason="the same bytes")
        assert_equal(bytes.len(), 16, reason="fill returns count bytes")
        assert_equal(a.next_u64(), b.next_u64(), reason="fill advances both alike")
