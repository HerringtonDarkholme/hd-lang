# test: independent statements of one initialization group run by module identity, then by source position
# Spec 10 Order Inside A Group: module.init.group.earliest, module.init.group.step. The tree's
# src/ring/one.hd and src/ring/two.hd use each other, so they form one group, and each
# records lines at top level through src/log/mod.hd.
# fixture-package-tree: init-order/src/ring_report.hd
use pkg.ring.two.{two}
use pkg.log.{recorded}
use std.testing.assert_equal

tests:
    it("ring.one's statements run before ring.two's"):
        assert_equal(recorded(), ["one first", "one second", "two"], reason="ring.one orders before ring.two")
        assert_equal(two(), "2", reason="the group is in use")
