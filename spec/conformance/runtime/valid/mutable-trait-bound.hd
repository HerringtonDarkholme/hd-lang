# test: mutable trait bound

use std.testing.assert_equal

trait Clear:
    fn clear(mut self) -> void

data Counter:
    value: i32

impl Clear for Counter:
    fn clear(mut self) -> void:
        self.value = 0

fn clear_value[T < mut Clear](value: T) -> void:
    value.clear()

fn cleared_value() -> i32:
    let counter: mut Counter = Counter { value: 42 }
    clear_value(counter)
    counter.value

test "cleared_value returns 0":
    assert_equal(cleared_value(), 0, reason="mutable trait bound")
