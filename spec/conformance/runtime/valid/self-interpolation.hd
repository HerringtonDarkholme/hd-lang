# test: "$self" interpolates the receiver
# Spec 01 Interpolation: lex.interp.self.
# Spec 05 Interpolation: expr.interp.self, expr.interp.user.
# expect: test

data Money:
    cents: i32

impl Display for Money:
    fn to_string(self) -> string:
        "${self.cents}c"

impl Money:
    fn label(self) -> string:
        "value: $self"

tests:
    use std.testing.assert_equal

    it("self interpolates through Display"):
        assert_equal(Money { cents: 5 }.label(), "value: 5c", reason="the receiver's Display")
