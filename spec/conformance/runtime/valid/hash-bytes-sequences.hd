# test: strings and lists write a u64 length first, tuples write only their elements, optionals a tag byte
# Spec std Hash, Bytes Written: std-hash.bytes.string, std-hash.bytes.list,
# std-hash.bytes.tuple, std-hash.bytes.optional (batch 65, HASH-BYTES).
use std.testing.{assert, assert_equal}

data Recorder:
    bytes: mut List[u8]

impl Hasher for Recorder:
    fn write(mut self, bytes: List[u8]) -> void:
        for byte in bytes:
            self.bytes.append(byte)

fn bytes_of[T < Hash](value: T) -> List[u8]:
    let mut recorder = Recorder { bytes: [] }
    value.hash(recorder)
    recorder.bytes

tests:
    it("a string writes its UTF-8 length as a u64, then its UTF-8 bytes"):
        assert_equal(bytes_of("hd"), [2, 0, 0, 0, 0, 0, 0, 0, 104, 100], reason="two bytes")
        assert_equal(bytes_of("\u{E9}"), [2, 0, 0, 0, 0, 0, 0, 0, 195, 169], reason="the length counts bytes, not chars")
        assert_equal(bytes_of(""), [0, 0, 0, 0, 0, 0, 0, 0], reason="only the length")

    it("a list writes its length as a u64, then each item"):
        let items: List[u8] = [1, 2]
        let empty: List[i32] = []
        assert_equal(bytes_of(items), [2, 0, 0, 0, 0, 0, 0, 0, 1, 2], reason="two u8 items")
        assert_equal(bytes_of(empty), [0, 0, 0, 0, 0, 0, 0, 0], reason="only the length")

    it("a tuple writes each element in order, with no length"):
        let pair: (u8, string) = (7, "a")
        assert_equal(bytes_of(pair), [7, 1, 0, 0, 0, 0, 0, 0, 0, 97], reason="the u8, then the string")

    it("strings in a tuple keep their boundaries"):
        assert(bytes_of(("ab", "c")) != bytes_of(("a", "bc")), reason="each string writes its length")

    it("an optional writes a tag byte, then a present payload"):
        let present: i32? = .Some(5)
        let absent: i32? = .None
        assert_equal(bytes_of(present), [1, 5, 0, 0, 0], reason=".Some is 1, then the i32")
        assert_equal(bytes_of(absent), [0], reason=".None is 0")
