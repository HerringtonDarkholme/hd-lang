# test: StatusCode::new rejects 0 and accepts 1 to 255
use std.process.StatusCode
use std.testing.assert_equal

fn held(code: u8) -> bool:
    match StatusCode::new(code):
        .Some(_) => true
        .None => false

test "StatusCode::new rejects 0":
    assert_equal(held(0), false, reason="0 is never a failure status")
    assert_equal(held(1), true, reason="1 is a status")
    assert_equal(held(255), true, reason="255 is a status")
