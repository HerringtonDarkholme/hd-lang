# test: `box(p)` copies the value of the place `p`: later writes to `p` are not seen through the box, and writes through the box leave `p` unchanged
# Spec 13 Boxes: ref.box.copy, ref.box.new.
# expect-stdout: 1 9
# expect-stdout: 4 9
struct Point:
    x: i32

pub fn main() -> void $ Console:
    let mut p = Point { x: 1 }
    copy := box(p)
    p.x = 9
    println("${copy.x} ${p.x}")
    copy.x = 4
    println("${copy.x} ${p.x}")
