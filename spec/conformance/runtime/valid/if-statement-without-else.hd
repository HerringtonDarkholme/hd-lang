# test: in statement position an if may omit else, and it runs its suite or nothing
# Spec 06 Conditional Values: flow.if.statement.
fn record(log: mut List[i32], flag: bool) -> void:
    if flag:
        log.push(+1)
    log.push(+2)

tests:
    use std.testing.assert_equal

    it("the suite runs only when the condition holds"):
        let log: mut List[i32] = []
        record(log, true)
        record(log, false)
        assert_equal(log, [+1, +2, +2], reason="one push from the if")
