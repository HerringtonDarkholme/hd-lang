# test: a Console provider that does not override write_error! records error lines with write!
# Spec 10 Console: module.console.write-error.forwarding (batch 64, STD-4).
struct MemoryConsole:
    lines: List[string]

impl Console for MemoryConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

fn warn!() -> Result[void, ConsoleError] $ Console:
    console := $.use(Console)
    console.write!("out")?
    console.write_error!("err")

tests:
    use std.testing.{assert, assert_equal}

    it("the default body calls write!"):
        let mut console = MemoryConsole { lines: [] }
        $.with(Console=&mut console):
            match warn!():
                .Ok(()) => pass
                .Err(_) => assert(false, reason="both writes succeed")
        assert_equal(console.lines, ["out", "err"], reason="one list holds both lines")
