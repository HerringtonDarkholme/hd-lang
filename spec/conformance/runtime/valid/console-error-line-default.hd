# test: a Console provider that does not override write_error_line! records error lines with write_line!
# Spec 10 Console: module.console.write-error-line.default (batch 64, STD-4).
use std.testing.{assert, assert_equal}

data BufferConsole:
    lines: mut List[string]

impl Console for BufferConsole:
    fn write_line!(mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.append(text)
        .Ok(())

fn warn!() -> Result[void, ConsoleError] $ Console:
    let mut console = $.use(Console)
    console.write_line!("out")?
    console.write_error_line!("err")

tests:
    it("the default body calls write_line!"):
        let mut console = BufferConsole { lines: [] }
        $.with(Console=console):
            match warn!():
                .Ok(()) => pass
                .Err(_) => assert(false, reason="both writes succeed")
        assert_equal(console.lines, ["out", "err"], reason="one list holds both lines")
