# test: messages copy fields and share bodies, while providers use local borrowed requests
# expect: test
use std.http.{BodyError, Http, HttpError, Request, Response, ScriptedHttp, Url, get}

struct Counting:
    seen: i32

impl Http for Counting:
    fn send!(&mut self, request: &Request, _redirects: usize) -> Result[Response, HttpError]:
        _ := request.bytes()?
        self.seen += 1
        .Ok(Response { url: .Some(request.url) }.set_text("${self.seen}"))

fn body!(url: string) -> string $ Http:
    match get!(url):
        .Ok(response) => response.text().expect("body")
        .Err(_) => "error"

fn url(text: string) -> Url:
    Url::parse(text).expect("fixture URL")

tests:
    use std.testing.assert_equal

    it("records copy fields but share the read-once body"):
        request := Request::get(url("https://example.com/")).set_text("shared")
        let mut changed = request
        changed.url = url("https://example.org/")
        assert_equal(
            request.url.to_string(),
            "https://example.com/",
            reason="the original keeps its URL",
        )
        assert_equal(changed.text(), .Ok("shared"), reason="copy reads the body")
        assert_equal(request.text(), .Err(BodyError.Used), reason="original observes the read")
        response := Response::status(.Ok)
        let mut other = response
        other.status = .InternalServerError
        assert_equal(response.status, .Ok, reason="the original keeps its status")

    it("the scripted provider is one object across binding scopes"):
        http := ScriptedHttp::new()
        http.reply("https://example.com/", .Ok(Response::status(.NoContent)))
        $.with(Http=http):
            _ := get!("https://example.com/")
        $.with(Http=http):
            _ := Request::get(url("https://example.com/missing")).send!()
        assert_equal(http.received().len(), 2, reason="both scopes recorded on one object")
        assert_equal(
            http.received()[1].url.to_string(),
            "https://example.com/missing",
            reason="unanswered request retained",
        )

    it("a struct fake counts through a local mutable borrow"):
        fake := box(Counting { seen: 0 })
        $.with(Http=fake):
            assert_equal(body!("https://example.com/a"), "1", reason="first")
            assert_equal(body!("https://example.com/b"), "2", reason="second")
        assert_equal(fake.seen, 2, reason="the caller's struct changed")
