# test: Request and Response are struct values, ScriptedHttp::new returns a handle the test and the installed provider share, and a program's struct with a &mut self send! serves as an Http fake
# Spec std/http: std-http.types.request-builder, std-http.trait.decl-ref, std-http.send.mut-ref.reference-values, std-http.scripted.new-ref, std-http.scripted.sent-ref.
# expect: test
use std.http.{Http, HttpError, Request, Response, ScriptedHttp, get, send}

struct Counting:
    seen: i32

impl Http for Counting:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.seen = self.seen + 1
        .Ok(Response { status: 200, headers: [], body: "${self.seen}".to_utf8(), url: request.url })

fn body!(url: string) -> string $ Http:
    match get!(url):
        .Ok(response) => response.text()
        .Err(_) => "error"

tests:
    use std.testing.assert_equal

    it("records are values"):
        request := Request { url: "https://example.com/" }
        let mut changed = request
        changed.url = "https://example.org/"
        assert_equal(request.url, "https://example.com/", reason="the original keeps its URL")
        response := Response { status: 200, headers: [], body: [] }
        let mut other = response
        other.status = 500
        assert_equal(response.status, 200, reason="the original keeps its status")

    it("the scripted provider is one object"):
        http := ScriptedHttp::new({"https://example.com/": Response { status: 204, headers: [], body: [] }})
        $.with(Http=http):
            _ := get!("https://example.com/")
        $.with(Http=http):
            _ := send!(Request { url: "https://example.com/missing" })
        assert_equal(http.sent().len(), 2, reason="both scopes recorded on the one object")
        assert_equal(http.sent()[1].url, "https://example.com/missing", reason="the unanswered request too")

    it("a struct fake counts through &mut"):
        let mut fake = Counting { seen: 0 }
        $.with(Http=&mut fake):
            assert_equal(body!("a"), "1", reason="first")
            assert_equal(body!("b"), "2", reason="second")
        assert_equal(fake.seen, 2, reason="the caller's struct changed")
