# test: copies made before an element reference, after it, and while its indexes are evaluated stay values of their own
# Spec 13 Element References: ref.elem.index, ref.elem.slot.
fn set(target: &mut i32, value: i32) -> void:
    *target = value

fn save_outer(a: &List[List[List[i32]]], saved: &mut List[List[List[i32]]]) -> usize:
    *saved = *a
    0

tests:
    use std.testing.assert_equal

    it("an earlier copy detaches before a reference is taken"):
        let mut a = [[[+1]]]
        b := a
        set(&mut a[0][0][0], 9)
        assert_equal(a[0][0][0], 9, reason="the detached original changes")
        assert_equal(b[0][0][0], 1, reason="the earlier copy is isolated")

    it("a copy made after the call still behaves as a value"):
        let mut a = [[+1]]
        set(&mut a[0][0], 9)
        let mut b = a
        b[0][0] = 5
        assert_equal(a[0][0], 9, reason="ended accesses leave value semantics intact")

    it("an index call copying the outer list cannot capture the exposed path"):
        let mut a = [[[+1]]]
        let mut saved: List[List[List[i32]]] = []
        snapshot := fn() -> usize:
            saved = a
            0
        set(&mut a[0][snapshot()][0], 9)
        assert_equal(a[0][0][0], 9, reason="the reference still reaches the original")
        assert_equal(saved[0][0][0], 1, reason="index evaluation copies an exposed ancestor")

    it("an intermediate index call observes an isolated snapshot"):
        let mut a = [[[+1]]]
        let mut saved: List[List[List[i32]]] = []
        set(&mut a[0][save_outer(&a, &mut saved)][0], 9)
        assert_equal(a[0][0][0], 9, reason="the reference keeps the original path")
        assert_equal(saved[0][0][0], 1, reason="a callee cannot share an exposed path")
