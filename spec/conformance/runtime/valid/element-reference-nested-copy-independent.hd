# test: copies isolate references into nested lists, including shared ancestors and escaped references
# Spec 13 Element References: ref.elem.copy.
struct Bag:
    items: List[i32]

fn escape(xs: &mut List[List[i32]]) -> &mut i32:
    &mut xs[0][0]

fn next_index(calls: &mut usize) -> usize:
    *calls += 1
    0

fn save_outer(a: &List[List[List[i32]]], saved: &mut List[List[List[i32]]]) -> usize:
    *saved = *a
    0

tests:
    use std.testing.assert_equal

    it("a nested reference leaves a later outer copy unchanged"):
        let mut a = [[+1]]
        p := &mut a[0][0]
        b := a
        *p = 9
        assert_equal(a[0][0], 9, reason="the original changes")
        assert_equal(b[0][0], 1, reason="the copy owns the pinned descendant")

    it("a struct field list is isolated"):
        let mut a = Bag { items: [+1] }
        p := &mut a.items[0]
        b := a
        *p = 9
        assert_equal(b.items[0], 1, reason="the struct copies its pinned list")

    it("a list of structs isolates list fields"):
        let mut a = [Bag { items: [+1] }]
        p := &mut a[0].items[0]
        b := a
        *p = 9
        assert_equal(a[0].items[0], 9, reason="the original field changes")
        assert_equal(b[0].items[0], 1, reason="the outer copy isolates the field")

    it("three levels expose every ancestor"):
        let mut a = [[[+1]]]
        p := &mut a[0][0][0]
        b := a
        *p = 9
        assert_equal(b[0][0][0], 1, reason="the outermost copy is isolated")

    it("an earlier copy detaches before a reference is taken"):
        let mut a = [[[+1]]]
        b := a
        p := &mut a[0][0][0]
        *p = 9
        assert_equal(a[0][0][0], 9, reason="the detached original changes")
        assert_equal(b[0][0][0], 1, reason="the earlier copy is isolated")

    it("fresh containment copies an exposed value"):
        let mut a = [[+1]]
        p := &mut a[0][0]
        box := [a]
        b := box
        *p = 9
        assert_equal(b[0][0][0], 1, reason="fresh containers do not reintroduce sharing")

    it("exposure outlasts the scope taking a reference"):
        let mut a = [[+1]]
        p := escape(&mut a)
        b := a
        *p = 9
        assert_equal(a[0][0], 9, reason="the escaped reference reaches its original")
        assert_equal(b[0][0], 1, reason="ancestor exposure outlives lexical pins")

    it("an element reference can later expose a descendant"):
        let mut a = [[+1]]
        row := &mut a[0]
        p := &mut row[0]
        b := a
        *p = 9
        assert_equal(b[0][0], 1, reason="the parent was exposed when its element was referenced")

    it("ancestor growth preserves exposure"):
        let mut a = [[+1]]
        p := &mut a[0][0]
        a.push([+2])
        b := a
        *p = 9
        assert_equal(a[0][0], 9, reason="growth keeps the original descendant")
        assert_equal(b[0][0], 1, reason="growth does not clear exposure")

    it("each index is evaluated once"):
        let mut a = [[[+1]]]
        let mut calls = 0
        p := &mut a[next_index(&mut calls)][next_index(&mut calls)][next_index(&mut calls)]
        b := a
        *p = 9
        assert_equal(calls, 3, reason="exposure reuses evaluated indices")
        assert_equal(b[0][0][0], 1, reason="the copy remains isolated")

    it("a reference loop exposes its containing list"):
        let mut a = [[+1]]
        for p in &mut a[0]:
            b := a
            *p = 9
            assert_equal(b[0][0], 1, reason="loop references isolate outer copies")

    it("a copy made after the leaf dies still behaves as a value"):
        let mut a = [[+1]]
        p := &mut a[0][0]
        *p = 9
        let mut b = a
        b[0][0] = 5
        assert_equal(a[0][0], 9, reason="expired descendant pins leave value semantics intact")

    it("an index call copying the outer list cannot capture the exposed path"):
        let mut a = [[[+1]]]
        let mut saved: List[List[List[i32]]] = []
        snapshot := fn() -> usize:
            saved = a
            0
        p := &mut a[0][snapshot()][0]
        *p = 9
        assert_equal(a[0][0][0], 9, reason="the reference still reaches the original")
        assert_equal(saved[0][0][0], 1, reason="index evaluation copies an exposed ancestor")

    it("an intermediate index call observes an isolated snapshot"):
        let mut a = [[[+1]]]
        let mut saved: List[List[List[i32]]] = []
        p := &mut a[0][save_outer(&a, &mut saved)][0]
        *p = 9
        assert_equal(a[0][0][0], 9, reason="the reference keeps the original path")
        assert_equal(saved[0][0][0], 1, reason="a callee cannot share an exposed path")
