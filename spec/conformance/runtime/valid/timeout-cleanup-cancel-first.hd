# expect-stdout: cancelled
# expect-stdout: caller cancels, closing, still closing, closed, after deadline
# test: a cancel of timeout! before the limit sets the cleanup deadline, and the bound goes on as part of the cancelled timeout!'s cleanup
# Spec std/task Cleanup Bound: std-task.policy.time-limit.cleanup-outlives, .cleanup-deadline, .cleanup-abandon.
use std.ops.Disposable
use std.task.{TimedOut, all, race, timeout, apply}
use std.time.{Clock, Duration, ms, s, sleep}

struct Close:
    log: *mut List[string]
    ack: mut Suspend[void]

impl Disposable for Close:
    fn dispose!(&mut self) -> void:
        defer:
            self.log.push("closed")
        self.log.push("closing")
        let mut ack = self.ack
        ack!()
        self.log.push("acknowledged")

fn session!(log: *mut List[string]) -> string $ Clock:
    using close = &mut Close { log: log, ack: sleep(s(60)) }
    sleep!(s(60))
    "reply"

# The caller cancels at 50 ms, long before the limit, so the deadline is
# 250 ms.
fn request!(log: *mut List[string]) -> string $ Clock:
    result := apply!(timeout(s(60), cleanup=ms(200))):
        let done: Result[string, TimedOut] = .Ok(session!(log))
        done
    match result:
        .Ok(value) => value
        .Err(error) => error.to_string()

fn caller_cancels!(log: &mut List[string]) -> string $ Clock:
    sleep!(ms(50))
    log.push("caller cancels")
    "cancelled"

fn mark!(log: &mut List[string], at: Duration, text: string) -> void $ Clock:
    sleep!(at)
    log.push(text)

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    let (outcome, _, _) = all!(
        race(request(&mut log), caller_cancels(&mut log)),
        mark(&mut log, ms(150), "still closing"),
        mark(&mut log, ms(350), "after deadline"),
    )
    println(outcome)
    println(log.join(", "))
