# test: a function stored in a field, own or promoted, is called by parenthesizing the field read
fn add_one(value: i32) -> i32: value + 1

data Button:
    pub on_click: fn(i32) -> i32

data Panel:
    Button

tests:
    use std.testing.assert_equal

    it("own and promoted function-typed fields are called through a field read"):
        button := Button { on_click: add_one }
        panel := Panel { Button: ...button }
        assert_equal((button.on_click)(41), 42, reason="own field call")
        assert_equal((panel.on_click)(1), 2, reason="promoted field call")
