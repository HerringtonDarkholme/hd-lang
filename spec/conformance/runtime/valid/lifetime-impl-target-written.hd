# test: a trait implementation target lifetime runs through Self at runtime
# Spec 13 Lifetime Implementation Targets: ref.lifetime.impl-target.
# expect-stdout: outer
struct Wrap[T]:
    value: T

trait Identity:
    fn identity(self) -> Self

impl['a] Identity for Wrap[&'a string]:
    fn identity(self) -> Self:
        self

pub fn main() -> void $ Console:
    text := "outer"
    wrapped := Wrap { value: &text }
    same := wrapped.identity()
    println(*same.value)
