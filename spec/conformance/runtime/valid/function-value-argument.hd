# test: callbacks / function values

use std.testing.assert_equal

fn increment(value: i32) -> i32: value + 1

fn apply(value: i32, transform: fn(i32) -> i32) -> i32:
    transform(value)

fn main() -> i32: apply(41, increment)

test "main returns 42":
    assert_equal(main(), 42, reason="callbacks / function values")
