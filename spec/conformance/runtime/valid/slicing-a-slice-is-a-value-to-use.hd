# test: a slice is a value to use
# expect-stdout: 2
# expect-stdout: 3
# expect-stdout: 8
# expect-stdout: hé
pub fn main() -> void $ Console:
    items := [10, 20, 30, 40]
    println(items.slice(1, 3).len())
    println("hello".slice(1, 4).len())
    let mut part = items.slice(1, items.len())
    part.push(50)
    println(part.len() + items.len())
    println("héllo".slice(0, 3))
