    sum += chunk_sum(value.c41)
    sum += chunk_sum(value.c42)
    sum += chunk_sum(value.c43)
    sum += chunk_sum(value.c44)
    sum += chunk_sum(value.c45)
    sum += chunk_sum(value.c46)
    sum += chunk_sum(value.c47)
    sum += chunk_sum(value.c48)
    sum += chunk_sum(value.c49)
    sum += chunk_sum(value.c50)
    sum += chunk_sum(value.c51)
    sum += chunk_sum(value.c52)
