    sum += chunk_sum(value.c54)
    sum

fn recurse(value: Wide, depth: usize) -> usize:
    if depth == 0:
        return chunk_sum(value.c0)
    recurse(value, depth - 1) + chunk_sum(value.c54)

fn repeated_ref(value: &Wide, stop: bool) -> usize:
    let sum: usize = 0
    for i in 0..3:
        sum += chunk_sum(value.c0)
        if stop && i == 1:
            return sum
    sum

struct Holder[T]:
    item: *mut T

trait Factory:
    fn hold[T](self, value: T) -> Holder[T]:
        let mut local = value
        Holder { item: &mut local }

struct Maker: pass
impl Factory for Maker

tests:
    it("all wide fields read by value and reference instantiate"):
        value := make("word${+7}")
        assert_equal(sum_value(value), 4125, reason="55 chunks of fifteen five-byte strings")
        assert_equal(sum_ref(&value), 4125, reason="the reference reads the same fields")
        assert_equal(recurse(value, 2), 225, reason="recursive frames restore the caller storage")

    it("wide fields through erased reference views"):
        let factory: &dyn Factory = &Maker {}
        value := factory.hold(make("word${+7}")).item
        assert_equal(sum_ref(value), 4125, reason="erased getter retains the selected field")
        assert_equal(repeated_ref(value, false), 225, reason="each loop getter releases its box")
        assert_equal(
            repeated_ref(value, true),
            150,
            reason="early return releases the selected field",
        )
