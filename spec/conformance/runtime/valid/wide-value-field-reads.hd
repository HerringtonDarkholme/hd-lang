    sum += chunk_sum(value.c11)
    sum += chunk_sum(value.c12)
    sum += chunk_sum(value.c13)
    sum += chunk_sum(value.c14)
    sum += chunk_sum(value.c15)
    sum += chunk_sum(value.c16)
    sum += chunk_sum(value.c17)
    sum += chunk_sum(value.c18)
    sum += chunk_sum(value.c19)
    sum += chunk_sum(value.c20)
    sum += chunk_sum(value.c21)
    sum += chunk_sum(value.c22)
    sum += chunk_sum(value.c23)
    sum += chunk_sum(value.c24)
    sum += chunk_sum(value.c25)
    sum += chunk_sum(value.c26)
    sum += chunk_sum(value.c27)
    sum += chunk_sum(value.c28)
    sum += chunk_sum(value.c29)
    sum += chunk_sum(value.c30)
    sum += chunk_sum(value.c31)
    sum += chunk_sum(value.c32)
    sum += chunk_sum(value.c33)
    sum += chunk_sum(value.c34)
    sum += chunk_sum(value.c35)
    sum += chunk_sum(value.c36)
    sum += chunk_sum(value.c37)
    sum += chunk_sum(value.c38)
    sum += chunk_sum(value.c39)
    sum += chunk_sum(value.c40)
    sum += chunk_sum(value.c41)
    sum += chunk_sum(value.c42)
    sum += chunk_sum(value.c43)
    sum += chunk_sum(value.c44)
    sum += chunk_sum(value.c45)
    sum += chunk_sum(value.c46)
    sum += chunk_sum(value.c47)
    sum += chunk_sum(value.c48)
    sum += chunk_sum(value.c49)
    sum += chunk_sum(value.c50)
    sum += chunk_sum(value.c51)
    sum += chunk_sum(value.c52)
    sum += chunk_sum(value.c53)
    sum += chunk_sum(value.c54)
    sum

fn sum_ref(value: &Wide) -> usize:
    let sum: usize = 0
    sum += chunk_sum(value.c0)
    sum += chunk_sum(value.c1)
    sum += chunk_sum(value.c2)
    sum += chunk_sum(value.c3)
    sum += chunk_sum(value.c4)
    sum += chunk_sum(value.c5)
    sum += chunk_sum(value.c6)
    sum += chunk_sum(value.c7)
    sum += chunk_sum(value.c8)
    sum += chunk_sum(value.c9)
    sum += chunk_sum(value.c10)
    sum += chunk_sum(value.c11)
    sum += chunk_sum(value.c12)
    sum += chunk_sum(value.c13)
    sum += chunk_sum(value.c14)
    sum += chunk_sum(value.c15)
    sum += chunk_sum(value.c16)
    sum += chunk_sum(value.c17)
    sum += chunk_sum(value.c18)
    sum += chunk_sum(value.c19)
    sum += chunk_sum(value.c20)
    sum += chunk_sum(value.c21)
    sum += chunk_sum(value.c22)
    sum += chunk_sum(value.c23)
    sum += chunk_sum(value.c24)
    sum += chunk_sum(value.c25)
    sum += chunk_sum(value.c26)
    sum += chunk_sum(value.c27)
    sum += chunk_sum(value.c28)
    sum += chunk_sum(value.c29)
    sum += chunk_sum(value.c30)
    sum += chunk_sum(value.c31)
    sum += chunk_sum(value.c32)
    sum += chunk_sum(value.c33)
    sum += chunk_sum(value.c34)
    sum += chunk_sum(value.c35)
    sum += chunk_sum(value.c36)
    sum += chunk_sum(value.c37)
    sum += chunk_sum(value.c38)
    sum += chunk_sum(value.c39)
