# test: a method written in a derivation block replaces the template's method, and the others still come from the template
# Spec 14 Derivation Blocks: annot.block.methods.
use std.structure.{Structure, Field, Variant, Walker}
struct Tag:
    text: string

struct Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

struct Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string
    fn kind(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, &mut w)
        w.out

    fn kind(self) -> string:
        "template"

struct Point:
    x: i64

impl Probe for Point by Structure:
    fn kind(self) -> string:
        "written"

tests:
    use std.testing.assert_equal

    it("uses the written kind and the template's probe"):
        assert_equal(
            Point { x: 1 }.kind(),
            "written",
            reason="the written method replaces the template's",
        )
        assert_equal(Point { x: 1 }.probe(), "x=-/-;", reason="probe still comes from the template")
