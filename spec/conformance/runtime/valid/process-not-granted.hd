# test: run! reports a program outside the run-time grant as NotGranted, apart from the operating system's PermissionDenied
# Spec Modules, Processes: module.process.not-granted, module.process.denied.
# expect: test
use std.process.{Command, Process, ProcessError, ProcessOutput}
struct GrantedProcess: pass

impl Process for GrantedProcess:
    fn run!(&mut self, command: Command) -> Result[ProcessOutput, ProcessError]:
        program := command.program
        match program:
            "git" => .Ok(ProcessOutput { stdout: "ran", stderr: "", status: 0 })
            "locked" => .Err(.PermissionDenied(program))
            _ => .Err(.NotGranted)

fn start!(program: string) -> Result[ProcessOutput, ProcessError] $ Process:
    $.use(Process).run!(Command { program: program })

tests:
    use std.testing.assert_equal

    it("a program outside the grant is NotGranted"):
        let mut process = GrantedProcess {}
        $.with(Process=&mut process):
            match start!("curl"):
                .Err(error) =>
                    assert_equal(
                        error == ProcessError.NotGranted,
                        true,
                        reason="the grant refused it",
                    )
                .Ok(_) => assert_equal(true, false, reason="curl is not granted")
            match start!("locked"):
                .Err(error) =>
                    assert_equal(
                        error == ProcessError.NotGranted,
                        false,
                        reason="the operating system refused it",
                    )
                .Ok(_) => assert_equal(true, false, reason="locked never starts")
            match start!("git"):
                .Ok(output) => assert_equal(output.stdout, "ran", reason="git is granted")
                .Err(_) => assert_equal(true, false, reason="git starts")
