# test: list-binary-search preserves values and copy independence
# expect: test
# Spec std/collections: std-collections.list.binary-search.

tests:
    use std.testing.{assert, assert_equal}

    it("list-binary-search"):
        items := [+1, 3, 3, 7]
        match items.binary_search(&+3):
            .Ok(at) => assert_equal(items[at], +3)
            .Err(_) => assert(false)
        assert_equal(items.binary_search(&+0), .Err(0))
        assert_equal(items.binary_search(&+2), .Err(1))
        assert_equal(items.binary_search(&+4), .Err(3))
        assert_equal(items.binary_search(&+8), .Err(4))
        let empty: List[i32] = []
        assert_equal(empty.binary_search(&+1), .Err(0))
