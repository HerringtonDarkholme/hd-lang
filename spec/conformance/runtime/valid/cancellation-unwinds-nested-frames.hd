# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait
use std.ops.defer

let cleaned: bool = false

fn wait!() -> void:
    pass

fn pending!() -> void:
    defer(fn() -> void: cleaned = true)
    wait!()

pub fn main!() -> void:
    pending!()

pub fn cleanup_ran() -> bool:
    cleaned
