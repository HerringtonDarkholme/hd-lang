# test: a readonly List[mut List[i32]] reads an element as mut List[i32]
# Spec 05 List Indexing: expr.index.list.read.
fn grow(rows: List[mut List[i32]]) -> void:
    rows[0].push(+2)

tests:
    use std.testing.assert_equal

    it("the element keeps its mut type through a readonly list"):
        let row: mut List[i32] = [+1]
        grow([row])
        assert_equal(row, [+1, +2], reason="push reached the element")
