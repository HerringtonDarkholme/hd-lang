# test: a literal nested in a generic call's argument solves the type parameter
# Spec 04 Generic Arguments: types.generic.infer; the inner Box literal meets the Box[T] of b: Box[Box[T]].
struct Box[T]:
    item: T

fn nested[T](b: Box[Box[T]]) -> T:
    b.item.item

tests:
    use std.testing.assert_equal

    it("passes a nested literal straight to the call"):
        assert_equal(
            nested(Box { item: Box { item: 2.25 } }),
            2.25,
            reason="T is f64 and the inner literal weakened",
        )
