# test: a fresh literal nested in a generic call's argument weakens where the formal is readonly
# Spec 04 Bindings And Fresh Values: types.fresh.weaken; the inner Box literal meets the readonly Box[T] of b: Box[Box[T]].
use std.testing.assert_equal

data Box[T]:
    item: T

fn nested[T](b: Box[Box[T]]) -> T:
    b.item.item

tests:
    it("passes a nested literal straight to the call"):
        assert_equal(nested(Box { item: Box { item: 2.25 } }), 2.25, reason="T is f64 and the inner literal weakened")
