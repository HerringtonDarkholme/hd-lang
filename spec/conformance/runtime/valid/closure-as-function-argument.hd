# test: closure as function argument
# Spec 07 Closures: fn.closure.form, fn.closure.one-line,
# fn.closure.monomorphic, fn.closure.result-expected.

fn apply(value: i32, transform: fn(i32) -> i32) -> i32:
    transform(value)

fn main() -> i32:
    increment := fn(value: i32) -> i32: value + 1
    apply(41, increment)

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="closure as function argument")
