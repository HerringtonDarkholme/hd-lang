# test: structs with function fields and trait value type arguments are inspectable
# Spec 09 Inspectable Types: identity is the declaration, whatever its fields hold, and a trait
# value type counts as inspectable as a type argument, matched exactly.
# Spec 09 Traits: trait.inspectable.declared, trait.inspectable.fields, trait.inspectable.reference, trait.inspectable.argument-examples.reference-values.
use std.inspect.{Inspectable}
struct Handler:
    run: fn() -> i32

struct Label:
    text: string

impl Display for Label:
    fn to_string(self) -> string:
        self.text

fn run_handler(value: *dyn Inspectable) -> i32:
    match value.downcast_ref::[Handler]().map(fn(found): *found):
        .Some(handler) => (handler.run)()
        .None => 0

fn joined(value: *dyn Inspectable) -> string:
    match value.downcast_ref::[List[*dyn Display]]().map(fn(found): *found):
        .Some(parts) =>
            let text: string = ""
            for part in parts:
                text = text + part.to_string()
            text
        .None => "no match"

tests:
    use std.testing.assert_equal

    it("a recovered handler is callable"):
        run := fn() -> i32: 7
        handler := box(Handler { run: run })
        assert_equal(run_handler(handler), 7, reason="the function field is called after recovery")

    it("a trait value type argument matches exactly"):
        shown := box::[List[*dyn Display]]([box(Label { text: "a" }), box(Label { text: "b" })])
        assert_equal(joined(shown), "ab", reason="List[Display] matches List[Display]")
        labels := box::[List[Label]]([Label { text: "c" }])
        assert_equal(joined(labels), "no match", reason="List[Label] is not List[Display]")
