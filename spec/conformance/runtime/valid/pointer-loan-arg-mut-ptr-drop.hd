# test: pointer loans: a `&mut` to a field of a boxed struct, passed as a call argument; an alias drops the last other pointer to the object; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

struct Holder:
    child: *mut Cell

fn observe(r: &mut string, holder: *mut Holder) -> string:
    holder.child = make()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

fn probe(p: *mut Cell, holder: *mut Holder) -> string:
    observe(&mut p.value, holder)

pub fn main() -> void $ Console:
    holder := box(Holder { child: make() })
    seen := probe(holder.child, holder)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
