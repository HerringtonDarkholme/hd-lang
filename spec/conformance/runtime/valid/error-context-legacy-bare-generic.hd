# test: a legacy bare erased error through a generic context must not produce an invalid recovery payload
# Spec 09 Trait Values As Bounds: trait.dyn.bound; Error Trait: trait.error.inherent-recovery.
# expect-stdout: 3
use std.error.Error
@error("inner")
struct UserError:
    count: i32
fn wrapped[E < Error](error: E) -> &dyn Error:
    let result: Result[void, E] = .Err(error)
    match result.context("outer"):
        .Err(failure) => failure
        .Ok(_) => panic("expected an error")
pub fn main() -> void $ Console:
    let bare: dyn Error = UserError { count: 3 }
    failure := wrapped(bare)
    match failure.find::[UserError]():
        .Some(found) => println(found.count)
        .None => println("none")
