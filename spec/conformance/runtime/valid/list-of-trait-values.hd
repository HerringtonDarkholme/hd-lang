# test: collections / trait lists
# Spec 09 Traits: trait.dyn.form, trait.dyn.convert.

trait Value:
    fn get(self) -> i32

data Number:
    value: i32

impl Value for Number:
    fn get(self) -> i32: self.value

fn main() -> i32:
    let values: List[dyn Value] = [Number { value: 20 }, Number { value: 22 }]
    values[0].get() + values[1].get()

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="collections / trait lists")
