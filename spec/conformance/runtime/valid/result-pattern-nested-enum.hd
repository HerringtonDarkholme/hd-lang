# test: Result patterns recursively match imported enum payloads
# Spec 10 Use Forms: module.use.single.

use std.console.ConsoleError

fn outcome() -> Result[i32, ConsoleError]:
    .Err(ConsoleError.Closed)

fn main() -> i32:
    match outcome():
        .Err(ConsoleError.Closed) => 42
        _ => 0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="Result patterns recursively match imported enum payloads")
