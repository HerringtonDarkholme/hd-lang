# test: ? in a test block propagates by the ordinary rules to the block's inferred result
# Spec 05 Propagation In Test Blocks: a test block counts as the nearest function, and its
# result type is inferred like a closure's. Result[void, string] implements Termination,
# so a string error needs no wrapper. A void body also passes.
use std.testing.assert_equal

fn parse_digit(text: string) -> Result[i32, string]:
    if text == "7": .Ok(7) else: .Err("not a digit: " + text)

fn passed() -> Result[void, string]:
    .Ok()

test "parses a digit":
    digit := parse_digit("7")?
    assert_equal(digit, 7, reason="the digit parses")
    passed()

test "a void body passes":
    match parse_digit("x"):
        .Ok(_) => panic("x is not a digit")
        .Err(message) => assert_equal(message, "not a digit: x", reason="the helper rejects x")
