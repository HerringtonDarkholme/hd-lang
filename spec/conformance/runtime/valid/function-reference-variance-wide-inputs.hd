        value,
    )

fn settle!(cancel: bool) -> void:
    pending := escaped()
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(pending!(), 7, reason="the retained input is read after its caller exits")

tests:
    it("plain input 64 is borrowed for final and live caller uses"):
        plain(false)
        plain(true)

    it("cold input 64 is borrowed for final and live caller uses"):
        cold_lifetime!(false)
        cold_lifetime!(true)

    it("an escaped cold frame retains input 64 until completion"):
        settle!(false)

    it("an escaped cold frame retains input 64 until cancellation"):
        settle!(true)
