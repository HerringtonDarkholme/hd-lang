# test: function variance borrows a reference at input index 64 for plain and cold calls
# Spec functions: fn.type.declared-variance, fn.type.variance-repr; weak: std-weak.release.target.
use std.annotation.cold
use std.testing.{assert, assert_equal}
use std.weak.{Weak, weak}

