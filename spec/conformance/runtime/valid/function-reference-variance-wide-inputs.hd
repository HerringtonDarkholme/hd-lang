fn settle!(cancel: bool) -> Weak[i32]?:
    let (seen, pending) = escaped()
    assert(alive(seen), reason="the escaped cold frame keeps input 64 before polling")
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(pending!(), 7, reason="the retained input is read after its caller exits")
    assert(expired(seen), reason="completion or cancellation releases the frame's input 64")
    seen

tests:
    it("plain input 64 is borrowed for final and live caller uses"):
        assert(expired(plain(false)), reason="the final-use caller releases its owner")
        assert(expired(plain(true)), reason="the live caller releases its owner on exit")

    it("cold input 64 is borrowed for final and live caller uses"):
        assert(
            expired(cold_lifetime!(false)),
            reason="the final-use cold caller releases its owner",
        )
        assert(
            expired(cold_lifetime!(true)),
            reason="the live cold caller releases its owner on exit",
        )

    it("an escaped cold frame retains input 64 until completion"):
        assert(expired(settle!(false)), reason="completion leaves no strong owner")

    it("an escaped cold frame retains input 64 until cancellation"):
        assert(expired(settle!(true)), reason="cancellation leaves no strong owner")
