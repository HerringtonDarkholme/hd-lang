        assert_equal(*value, 7, reason="a final caller use follows the cold call")
    seen

@cold
fn escaped() -> (Weak[i32]?, Suspend[i32]):
    value := box(+7)
    seen := weak(value)
    let adapted: fn!(i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, *i32) -> i32 = read_cold
    let call: fn(i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, i32, *i32) -> Suspend[
        i32,
    ] = adapted
    (
        seen,
        call(
            +0,
            +0,
            +0,
            +0,
            +0,
            +0,
            +0,
            +0,
            +0,
