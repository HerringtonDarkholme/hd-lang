# test: zip pairs by position and pulls self first; chain reads self, then other
# Spec std/iter More Adapters: std-iter.adapter.zip, .zip.order, .chain, and .chain.order (recommended reading of TEXT-COLLECTIONS-SURFACE, spec pass 78).
use std.testing.assert_equal

fn labeled(names: List[string]) -> List[(i32, string)]:
    [1, 2, 3].iter().zip(names.iter()).collect()

tests:
    it("zip stops at the shorter"):
        assert_equal(labeled(["a", "b"]), [(1, "a"), (2, "b")], reason="names end first")
        assert_equal(labeled(["a", "b", "c", "d"]).len(), 3, reason="numbers end first")
    it("zip does not read other past the end of self"):
        let mut other = [10, 20, 30].iter()
        _ := [1].iter().zip(other).collect()
        assert_equal(other.next(), .Some(20), reason="only one item of other was read")
    it("chain"):
        assert_equal([1].iter().chain([2, 3].iter()).collect(), [1, 2, 3], reason="in order")
        let empty: List[i32] = []
        assert_equal(empty.iter().chain(empty.iter()).collect(), [], reason="both empty")
