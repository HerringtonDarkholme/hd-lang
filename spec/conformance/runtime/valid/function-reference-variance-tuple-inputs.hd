# test: function variance borrows a tuple input that holds a counted reference
# Spec functions: fn.type.declared-variance, fn.type.variance-repr; types: types.variance.no-insertion; weak: std-weak.release.target.
use std.annotation.cold
use std.testing.{assert, assert_equal}
use std.weak.{Weak, weak}

fn read(value: (&i32, i32)) -> i32:
    *value._0 + value._1

@cold
fn read_cold!(value: (&i32, i32)) -> i32:
    *value._0 + value._1

fn keep(value: (*i32, i32)) -> i32:
    *value._0 + value._1

fn alive(link: Weak[i32]?) -> bool:
    match link:
        .Some(seen) => seen.upgrade().is_some()
        .None => false

fn expired(link: Weak[i32]?) -> bool:
    match link:
        .Some(seen) => seen.upgrade().is_none()
        .None => false

@cold
fn invoke(call: fn((*i32, i32)) -> i32, value: *i32) -> Weak[i32]?:
    seen := weak(value)
    assert_equal(call((value, +3)), 10, reason="the tuple is read through the adapted function")
    seen

fn plain(live: bool) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    let call: fn((*i32, i32)) -> i32 = read
    assert_equal(call((value, +3)), 10, reason="the tuple is read through the adapted function")
    if live:
        assert(alive(seen), reason="the caller still owns the tuple's reference")
        assert_equal(*value, 7, reason="a final caller use follows the plain call")
    seen

fn owner(live: bool) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    let call: fn((*i32, i32)) -> i32 = keep
    assert_equal(call((value, +3)), 10, reason="a counted target receives its own owner")
    if live:
        assert(alive(seen), reason="the caller still owns the tuple's reference")
        assert_equal(*value, 7, reason="a final caller use follows the owning call")
    seen

fn literal(live: bool) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    let call: fn((*i32, i32)) -> i32 = fn(t: (&i32, i32)) -> i32: *t._0 + t._1
    assert_equal(call((value, +3)), 10, reason="a closure reads the borrowed tuple")
    if live:
        assert(alive(seen), reason="the caller still owns the tuple's reference")
        assert_equal(*value, 7, reason="a final caller use follows the closure call")
    seen

fn cold_lifetime!(live: bool) -> Weak[i32]?:
    value := box(+7)
    seen := weak(value)
    let call: fn!((*i32, i32)) -> i32 = read_cold
    assert_equal(call!((value, +3)), 10, reason="the tuple is read through the adapted cold function")
    if live:
        assert(alive(seen), reason="the caller still owns the tuple's reference")
        assert_equal(*value, 7, reason="a final caller use follows the cold call")
    seen

@cold
fn escaped() -> (Weak[i32]?, Suspend[i32]):
    value := box(+7)
    seen := weak(value)
    let adapted: fn!((*i32, i32)) -> i32 = read_cold
    let call: fn((*i32, i32)) -> Suspend[i32] = adapted
    (seen, call((value, +3)))

fn settle!(cancel: bool) -> Weak[i32]?:
    let (seen, pending) = escaped()
    assert(alive(seen), reason="the escaped cold frame keeps the tuple's reference before polling")
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(pending!(), 10, reason="the retained tuple is read after its caller exits")
    assert(expired(seen), reason="completion or cancellation releases the frame's reference")
    seen

tests:
    it("a cold caller borrows the tuple for a plain target"):
        assert(expired(invoke(read, box(+7))), reason="no tuple count leaks")

    it("a plain tuple input is borrowed for final and live caller uses"):
        assert(expired(plain(false)), reason="the final-use caller releases its owner")
        assert(expired(plain(true)), reason="the live caller releases its owner on exit")

    it("an owning target takes its own count of the borrowed tuple"):
        assert(expired(owner(false)), reason="the final-use caller releases its owner")
        assert(expired(owner(true)), reason="the live caller releases its owner on exit")

    it("a closure literal borrows the tuple"):
        assert(expired(literal(false)), reason="the final-use caller releases its owner")
        assert(expired(literal(true)), reason="the live caller releases its owner on exit")

    it("a cold tuple input is borrowed for final and live caller uses"):
        assert(expired(cold_lifetime!(false)), reason="the final-use cold caller releases its owner")
        assert(expired(cold_lifetime!(true)), reason="the live cold caller releases its owner on exit")

    it("an escaped cold frame retains the tuple's reference until completion"):
        assert(expired(settle!(false)), reason="completion leaves no strong owner")

    it("an escaped cold frame retains the tuple's reference until cancellation"):
        assert(expired(settle!(true)), reason="cancellation leaves no strong owner")
