# test: function variance borrows a tuple input that holds a counted reference
# Spec functions: fn.type.declared-variance, fn.type.variance-repr; types: types.variance.no-insertion.
use std.annotation.cold
use std.testing.assert_equal

fn read(value: (&i32, i32)) -> i32:
    *value._0 + value._1

@cold
fn read_cold!(value: (&i32, i32)) -> i32:
    *value._0 + value._1

fn keep(value: (*i32, i32)) -> i32:
    *value._0 + value._1

@cold
fn invoke(call: fn((*i32, i32)) -> i32, value: *i32) -> i32:
    assert_equal(call((value, +3)), 10, reason="the tuple is read through the adapted function")
    *value

fn plain(live: bool) -> void:
    value := box(+7)
    let call: fn((*i32, i32)) -> i32 = read
    assert_equal(call((value, +3)), 10, reason="the tuple is read through the adapted function")
    if live:
        assert_equal(*value, 7, reason="a final caller use follows the plain call")

fn owner(live: bool) -> void:
    value := box(+7)
    let call: fn((*i32, i32)) -> i32 = keep
    assert_equal(call((value, +3)), 10, reason="a counted target receives its own owner")
    if live:
        assert_equal(*value, 7, reason="a final caller use follows the owning call")

fn literal(live: bool) -> void:
    value := box(+7)
    let call: fn((*i32, i32)) -> i32 = fn(t: (&i32, i32)) -> i32: *t._0 + t._1
    assert_equal(call((value, +3)), 10, reason="a closure reads the borrowed tuple")
    if live:
        assert_equal(*value, 7, reason="a final caller use follows the closure call")

fn cold_lifetime!(live: bool) -> void:
    value := box(+7)
    let call: fn!((*i32, i32)) -> i32 = read_cold
    assert_equal(
        call!((value, +3)),
        10,
        reason="the tuple is read through the adapted cold function",
    )
    if live:
        assert_equal(*value, 7, reason="a final caller use follows the cold call")

@cold
fn escaped() -> Suspend[i32]:
    value := box(+7)
    let adapted: fn!((*i32, i32)) -> i32 = read_cold
    let call: fn((*i32, i32)) -> Suspend[i32] = adapted
    call((value, +3))

fn settle!(cancel: bool) -> void:
    pending := escaped()
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(pending!(), 10, reason="the retained tuple is read after its caller exits")

tests:
    it("a cold caller borrows the tuple for a plain target"):
        assert_equal(invoke(read, box(+7)), 7, reason="the caller's owner outlives the call")

    it("a plain tuple input is borrowed for final and live caller uses"):
        plain(false)
        plain(true)

    it("an owning target takes its own count of the borrowed tuple"):
        owner(false)
        owner(true)

    it("a closure literal borrows the tuple"):
        literal(false)
        literal(true)

    it("a cold tuple input is borrowed for final and live caller uses"):
        cold_lifetime!(false)
        cold_lifetime!(true)

    it("an escaped cold frame retains the tuple's reference until completion"):
        settle!(false)

    it("an escaped cold frame retains the tuple's reference until cancellation"):
        settle!(true)
