# fixture-runtime-profile: pending-tick
# expect-stdout: blocking
# expect-stdout: between
# expect-stdout: stored
# expect-stdout: awaited
# test: recursive function values returning a cold suspension and indirect bang calls preserve normal host slots.
use std.task.block_on

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn invoke(tick: fn(string) -> mut Suspend[void], text: string, count: i32) -> mut Suspend[void]:
    if count == 0: tick(text) else: invoke(tick, text, count - 1)

pub fn main!() -> void $ Console + Tick:
    println("blocking")
    let ticker: *mut dyn Tick = $.use(Tick)
    let tick: fn(string) -> mut Suspend[void] = ticker::tick
    let saved: mut Suspend[void] = invoke(tick, "stored\n", +1)
    println("between")
    _ := block_on(saved)
    println("stored")
    let bang: fn!(string) -> void = ticker::tick
    bang!("awaited\n")
    println("awaited")
