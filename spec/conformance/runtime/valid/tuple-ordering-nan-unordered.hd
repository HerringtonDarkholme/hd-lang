# test: composite ordering stops at the first unordered element, so a NaN head makes the tuples unordered
tests:
    use std.testing.assert

    it("NaN inside a tuple is unordered"):
        let nan: f64 = 0.0 / 0.0
        assert(!((nan, 1) < (1.0, 2)), reason="unordered head: < is false")
        assert(!((nan, 1) <= (1.0, 2)), reason="unordered head: <= is false")
        assert(!((nan, 1) > (1.0, 2)), reason="unordered head: > is false")
        assert(!((nan, 1) >= (1.0, 2)), reason="unordered head: >= is false")

    it("an ordered head decides before a later NaN"):
        let nan: f64 = 0.0 / 0.0
        assert((1.0, nan) < (2.0, 0.0), reason="the first unequal element decides")
