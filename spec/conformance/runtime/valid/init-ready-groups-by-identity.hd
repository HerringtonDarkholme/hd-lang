# test: groups that are ready together initialize in module identity order, not in the order of the uses that reach them
# Spec 10 Initialization Order: module.init.cycle.ready-order, module.init.cycle.once;
# Entry Behavior: module.init.tests. The tree's src/alpha.hd and src/beta.hd each
# record their name at top level through src/log/mod.hd.
# fixture-package-tree: init-order/src/report.hd
use pkg.beta.{beta}
use pkg.alpha.{alpha}
use pkg.log.{recorded}
use std.testing.assert_equal

tests:
    it("alpha initializes before beta"):
        assert_equal(recorded(), ["alpha", "beta"], reason="pkg.alpha orders before pkg.beta")
        assert_equal("${alpha()}${beta()}", "ab", reason="both modules are in use")
