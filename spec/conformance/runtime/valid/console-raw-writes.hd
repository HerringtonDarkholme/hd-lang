# test: raw console writes preserve text; println separates text and newline while print and eprintln keep one chunk
# Spec std/console: std-console.print.one-write, std-console.eprintln.one-write, std-console.buffer.output-text.
use std.console.{MemoryConsole, eprintln, print}

pub fn main() -> void $ Console:
    print("ready: ")
    println(1)

tests:
    use std.testing.assert_equal

    it("raw writes do not add or remove line endings"):
        console := MemoryConsole::new()
        match console.write!("a"):
            .Ok(()) => pass
            .Err(_) => panic("memory write failed")
        _ := console.write!("b\r\nc\n")
        _ := console.write!("")
        _ := console.write_error!("error")
        assert_equal(console.output(), ["a", "b\r\nc\n", ""], reason="exact chunks")
        assert_equal(console.error_output(), ["error"], reason="raw stderr")

    it("println appends exactly one LF in its own write"):
        console := MemoryConsole::new()
        $.with(Console=console):
            print("a")
            print(12)
            println("x")
            println("y\n")
            println("")
            eprintln("warning")
        assert_equal(
            console.output(),
            ["a", "12", "x", "\n", "y\n", "\n", "", "\n"],
            reason="two chunks per println, one per print",
        )
        assert_equal(console.error_output(), ["warning\n"], reason="one stderr chunk")
