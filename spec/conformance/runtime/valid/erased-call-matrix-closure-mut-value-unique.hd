# test: erased call matrix closure-mut-value-unique
# expect: test
# Generated by spec/tools/generate-erased-call-matrix.ts; edit the generator.
# Rules: trait.dyn.safe.method-type-param, ref.generic.local.
use std.collections.UniqList

struct Parcel:
    words: UniqList[string]

impl !Copy for Parcel

impl Item for Parcel:
    fn value(&self) -> usize:
        self.words.len()
    fn bump(&mut self) -> void:
        self.words.push("extra")

fn make(round: usize) -> Parcel:
    let mut words = UniqList::[string].new()
    words.push("word_$round")
    words.push("tail_$round")
    Parcel { words: words }

trait Item < ?Copy:
    fn value(&self) -> usize
    fn bump(&mut self) -> void

trait Driver:
    fn run[T < ?Copy & Item](self, value: &mut T) -> usize

struct Worker:
    calls: usize

impl Driver for Worker:
    fn run[T < ?Copy & Item](self, value: &mut T) -> usize:
        apply := fn(value: &mut T) -> usize:
            value.bump()
            value.value()
        apply(value)

tests:
    it("closure-mut-value-unique preserves its argument and receiver"):
        for round in 0..8:
            let mut worker = Worker { calls: 0 }
            let mut item: Parcel = make(round)
            before := item.value()
            let driver: &dyn Driver = &worker
            result := driver.run(&mut item)
            assert_equal(result, before + 1, reason="the erased call returns the value")
            assert_equal(item.value(), before + 1, reason="the caller observes the borrow")
            assert_equal(
                item.words.get_ref(0).expect("first word"),
                &"word_$round",
                reason="the nested buffer keeps its original element",
            )
            assert_equal(worker.calls, 0, reason="receiver effects reach the caller")
