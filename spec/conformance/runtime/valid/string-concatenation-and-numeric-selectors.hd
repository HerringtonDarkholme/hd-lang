# test: strings concatenate and unnamed enum fields use underscore selectors

use std.testing.assert_equal

enum StatusCode(i32):
    Answer -> StatusCode(38)

fn main() -> i32:
    status := StatusCode.Answer
    message := "A" + "界"  # 1 + 3 bytes
    status._0 + message.len()

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="strings concatenate and unnamed enum fields use underscore selectors")
