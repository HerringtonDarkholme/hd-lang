# test: enum defaults, variant overrides, struct codes and transparent forwarding
# expect-stdout: 0 2 1 7 7 7 7 0 2 0 Quiet -2147483648 2147483647
use std.error.Error

@error(exit_code=2)
enum CommandError:
    @error("$usage", exit_code=0)
    Help(usage: string)
    @error("bad option: $name")
    Unknown(name: string)
    Unmarked
    @error(exit_code=0)
    Quiet

@error
enum DefaultError:
    Plain

@error("leaf", exit_code=7)
struct Leaf: pass

@error(transparent)
struct Wrapper:
    inner: Leaf

@error(exit_code=2)
enum Mixed:
    @error(transparent)
    Wrapped(inner: Leaf)
    Other

@error(transparent)
struct Generic[E]:
    inner: E

@error("minimum", exit_code=-2147483648)
struct Minimum: pass

@error("maximum", exit_code=2147483647)
struct Maximum: pass

fn dynamic_code(error: &dyn Error) -> i32:
    error.exit_code()

pub fn main() -> void $ Console:
    help := CommandError.Help("usage")
    leaf := Leaf {}
    println("${help.exit_code()} ${CommandError.Unknown("--wat").exit_code()} ${DefaultError.Plain.exit_code()} ${leaf.exit_code()} ${Wrapper { inner: leaf }.exit_code()} ${Mixed.Wrapped(leaf).exit_code()} ${Generic { inner: leaf }.exit_code()} ${dynamic_code(&help)} ${CommandError.Unmarked.exit_code()} ${CommandError.Quiet.exit_code()} ${CommandError.Quiet.to_string()} ${Minimum {}.exit_code()} ${Maximum {}.exit_code()}")
