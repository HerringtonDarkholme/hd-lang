# test: unique collections drop their storage once on every ownership path
# expect: test
# Spec std/collections UniqList and UniqMap: std-collections.uniq-list.into-iter, std-collections.uniq-map.insert, std-collections.uniq-map.clear.
use std.collections.{UniqList, UniqMap}
use std.iter.Iterable

struct Parcel:
    label: string

impl !Copy for Parcel

struct Shelf:
    name: string
    items: UniqList[Parcel]

impl !Copy for Shelf

trait Count < ?Copy:
    fn count(&self) -> usize

impl Count for Shelf:
    fn count(&self) -> usize:
        self.items.len()

fn parcels(n: usize) -> UniqList[Parcel]:
    let mut out = UniqList::[Parcel].new()
    let i: usize = 0
    while i < n:
        out.push(Parcel { label: "p$i" })
        i += 1
    out

fn consume(list: UniqList[Parcel]) -> usize:
    list.len()

fn first_label(list: UniqList[Parcel]) -> string:
    for parcel in list:
        return parcel.label
    "none"

fn shelf(n: usize) -> Shelf:
    Shelf { name: "s", items: parcels(n) }

fn nested(n: usize) -> UniqList[UniqList[Parcel]]:
    let mut out = UniqList::[UniqList[Parcel]].new()
    let i: usize = 0
    while i < n:
        out.push(parcels(i))
        i += 1
    out

tests:
    use std.testing.assert_equal

    it("moves a list into a call that drops it"):
        let round: usize = 0
        while round < 50:
            assert_equal(consume(parcels(20)), 20, reason="all moved")
            round += 1

    it("drops what a consuming loop leaves after an early return"):
        assert_equal(first_label(parcels(10)), "p0", reason="first")

    it("reassigns a list variable, dropping the old one"):
        let mut list = parcels(5)
        list = parcels(7)
        list = parcels(3)
        assert_equal(list.len(), 3, reason="last wins")

    it("moves a list through a struct and a trait value"):
        let mut store = UniqList::[Shelf].new()
        store.push(shelf(4))
        store.push(shelf(9))
        let total: usize = 0
        for s in store:
            total += s.count()
        assert_equal(total, 13, reason="both shelves")

    it("captures a list in a closure"):
        list := parcels(6)
        size := fn() -> usize: list.len()
        assert_equal(size(), 6, reason="captured")

    it("nests unique lists and drops all levels"):
        let round: usize = 0
        while round < 20:
            lists := nested(12)
            assert_equal(lists.len(), 12, reason="outer")
            round += 1

    it("grows, removes and clears a map of lists"):
        let mut shelves = UniqMap::[string, UniqList[Parcel]].new()
        let i: usize = 0
        while i < 40:
            _ := shelves.insert("k$i", parcels(i % 5))
            i += 1
        _ := shelves.remove("k3")
        _ := shelves.insert("k4", parcels(2))
        assert_equal(shelves.len(), 39, reason="one removed")
        shelves.clear()
        assert_equal(shelves.len(), 0, reason="cleared")

    it("drops a list left in an optional and on a break"):
        let kept: UniqList[Parcel]? = .Some(parcels(3))
        let n: usize = 0
        while true:
            inner := parcels(4)
            n += inner.len()
            if n > 10:
                break
        assert_equal(n, 12, reason="three rounds")
        match kept:
            .Some(list) => assert_equal(list.len(), 3, reason="kept")
            .None => assert_equal(0, 1, reason="missing")
