# test: ExitCode and ProcessOutput implement Eq field by field
# Spec std/process Exit Data: std-process.exit-code.eq, std-process.output.eq.
# expect: test
use std.process.{ExitCode, ProcessOutput}
fn clean(output: ProcessOutput) -> bool:
    output == ProcessOutput { stdout: "", stderr: "", status: 0 }

fn same(left: ExitCode, right: ExitCode) -> bool:
    left == right

tests:
    use std.testing.assert_equal

    it("exit codes compare by value"):
        assert_equal(same(ExitCode(3), ExitCode(3)), true, reason="equal codes")
        assert_equal(same(ExitCode(0), ExitCode(1)), false, reason="different codes")

    it("outputs compare every field"):
        assert_equal(clean(ProcessOutput { stdout: "", stderr: "", status: 0 }), true, reason="all equal")
        assert_equal(clean(ProcessOutput { stdout: "", stderr: "", status: 1 }), false, reason="status differs")
        assert_equal(clean(ProcessOutput { stdout: "x", stderr: "", status: 0 }), false, reason="stdout differs")
