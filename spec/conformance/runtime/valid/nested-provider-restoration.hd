# test: a nested provider scope overrides a key and the outer provider returns after it
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

test "nested scope override is lexical":
    $.with(Tag=FixedTag { value: "outer" }):
        before := current()
        inner := $.with(Tag=FixedTag { value: "inner" }):
            current()
        after := current()
        assert_equal(before + "," + inner + "," + after, "outer,inner,outer", reason="outer provider restored after the nested block")

test "context spreads apply left to right and later bindings win":
    base := $.context(Tag=FixedTag { value: "spread" })
    first := $.with(...base, Tag=FixedTag { value: "explicit" }):
        current()
    override := $.context(Tag=FixedTag { value: "explicit" })
    second := $.with(...override, ...base):
        current()
    assert_equal(first, "explicit", reason="explicit binding after the spread wins")
    assert_equal(second, "spread", reason="the later spread wins")
