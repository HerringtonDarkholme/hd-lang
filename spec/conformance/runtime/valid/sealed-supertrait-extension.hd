# test: a trait extending Inspectable is implemented with its own members only, and its values keep their recorded type when widened
# Spec 09 Extending A Sealed Trait: trait.sealed.extend, trait.sealed.extend.members; Compiler-Supplied Implementations: trait.sealed.supplied, trait.sealed.behaves.
# Spec 09 Supertrait Widening: trait.dyn.widen, trait.dyn.recover; Erasure To Inspectable: trait.erase.child-impl, trait.erase.widen.reference-values, trait.erase.keeps.
use std.inspect.{Inspectable, TypeId}
trait Plugin < Inspectable:
    fn name(self) -> string

struct Exporter:
    format: string

impl Plugin for Exporter:
    fn name(self) -> string:
        "export " + self.format

struct Importer:
    source: string

impl Plugin for Importer:
    fn name(self) -> string:
        "import " + self.source

fn as_inspectable(plugin: *dyn Plugin) -> *dyn Inspectable:
    plugin

fn format_of(value: *dyn Inspectable) -> string:
    match value.downcast_ref::[Exporter]().map(fn(found): *found):
        .Some(exporter) => exporter.format
        .None => "none"

tests:
    use std.testing.{assert, assert_equal}

    it("the child trait's own members dispatch"):
        let plugins: List[*dyn Plugin] = [
            box(Exporter { format: "csv" }),
            box(Importer { source: "s3" }),
        ]
        assert_equal(plugins[0].name(), "export csv", reason="Exporter's name")
        assert_equal(plugins[1].name(), "import s3", reason="Importer's name")

    it("the supplied Inspectable part reports the concrete type"):
        let plugin: &dyn Plugin = &Exporter { format: "json" }
        assert(
            plugin.runtime_type() == TypeId::of::[Exporter](),
            reason="the recorded type is Exporter",
        )

    it("widening to Inspectable keeps the recorded type"):
        widened := as_inspectable(box(Exporter { format: "xml" }))
        assert(
            widened.runtime_type() == TypeId::of::[Exporter](),
            reason="nothing is wrapped twice",
        )
        assert_equal(format_of(widened), "xml", reason="the widened value downcasts to Exporter")
        assert_equal(
            format_of(as_inspectable(box(Importer { source: "ftp" }))),
            "none",
            reason="an Importer is not an Exporter",
        )
