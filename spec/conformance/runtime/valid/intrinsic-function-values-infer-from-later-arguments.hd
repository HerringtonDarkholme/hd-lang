# test: intrinsic function values infer from later arguments
# Spec lang/03-names-and-scopes.md: names.category.value.
# Spec lang/07-functions.md: fn.type.generic.argument.sources.
# expect-stdout: 13
# expect-stdout: 5
# expect-stdout: equal
# expect-stdout: 4 7
use std.function.{Fn, FnMut}
use std.testing.assert_equal

fn invoke[F, T, R](call: fn(&F, (T,)) -> R, f: F, value: T) -> R:
    call(&f, (value,))

fn invoke_mut[F, T, R](call: fn(&mut F, (T,)) -> R, f: &mut F, value: T) -> R:
    call(f, (value,))

fn apply[T, R](f: fn(T) -> R, value: T) -> R:
    f(value)

fn compare[T](check: fn(T, T, string) -> void, actual: T, expected: T) -> void:
    check(actual, expected, "inferred from values")

fn inc(value: i32) -> i32:
    value + 1

pub fn main() -> void $ Console:
    println(invoke(Fn::call, inc, +12))
    let cell = apply(box, +5)
    println(*cell)
    compare(assert_equal, "same", "same")
    println("equal")
    let total = +0
    let mut add = fn(value: i32) -> i32:
        total += value
        total
    let first = invoke_mut(FnMut::call_mut, &mut add, +4)
    let second = invoke_mut(FnMut::call_mut, &mut add, +3)
    println("$first $second")
