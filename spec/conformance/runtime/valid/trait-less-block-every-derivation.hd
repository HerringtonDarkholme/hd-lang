# test: the facts of a block with no trait are declaration facts, which every derivation of the type sees
# Spec 14 Derivation Blocks With No Trait: annot.no-trait.declaration-facts.
use std.structure.{Structure, Field, Variant, Walker}
data Tag:
    text: string

data Note:
    text: string

fn tag(text: string) -> Tag:
    Tag { text: text }

fn note(text: string) -> Note:
    Note { text: text }

data Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        tagged := match h.info.facts.find::[Tag]():
            .Some(found) => found.text
            .None => "-"
        noted := match h.info.facts.find::[Note]():
            .Some(found) => found.text
            .None => "-"
        self.out = self.out + h.info.name + "=" + tagged + "/" + noted + ";"
        .Ok(())

trait Probe:
    fn probe(self) -> string

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, w)
        w.out

trait Echo:
    fn echo(self) -> string

impl[T] Echo for T by Structure:
    fn echo(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, w)
        w.out

@derive(Probe, Echo)
data Point:
    x: i64

impl Point by Structure:
    x += [tag("a")]

tests:
    use std.testing.assert_equal

    it("both derivations see the fact"):
        assert_equal(Point { x: 1 }.probe(), "x=a/-;", reason="Probe sees it")
        assert_equal(Point { x: 1 }.echo(), "x=a/-;", reason="Echo sees it")
