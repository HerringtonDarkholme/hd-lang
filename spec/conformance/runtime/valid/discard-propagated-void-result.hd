# test: discarding the void value produced by propagating an Ok Result[void, E] continues the function
use std.testing.assert_equal

fn close() -> Result[void, string]:
    Ok()

fn after_close() -> Result[i32, string]:
    _ := close()?
    Ok(1)

test "a propagated Ok(void) is discarded and execution continues":
    let expected: Result[i32, string] = Ok(1)
    assert_equal(after_close(), expected, reason="Ok() produces void and the function continues")
