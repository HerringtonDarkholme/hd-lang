# test: suspension calls evaluate callee arguments before the child body runs
# expect: test
struct Log:
    text: string

fn note(log: &mut Log, tag: string, value: i32) -> i32:
    log.text = log.text + tag
    value

fn work!(log: &mut Log, first: i32, second: i32) -> i32:
    log.text = log.text + "body"
    first + second

tests:
    use std.testing.assert_equal

    it("cold construction evaluates arguments but not the body"):
        log := box(Log { text: "" })
        view := log
        let pending: mut Suspend[i32] = work(log, note(log, "a", 1), note(log, "b", 2))
        assert_equal(view.text, "ab", reason="arguments are captured at construction")
        result := pending!()
        assert_equal(view.text, "abbody", reason="body runs only when driven")
        assert_equal(result, 3, reason="captured arguments are used")

    it("bang call evaluates arguments left to right before the child body"):
        let mut log = &mut Log { text: "" }
        result := work!(log, second=note(log, "b", 2), first=note(log, "a", 1))
        assert_equal(log.text, "babody", reason="source-order arguments, then body")
        assert_equal(result, 3, reason="named arguments bind by name")
