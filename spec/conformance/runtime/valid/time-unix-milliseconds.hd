# test: Timestamp.unix_milliseconds and Instant.as_milliseconds return the milliseconds their constructors took, and a Timestamp displays as RFC 3339
# Spec std/time Timestamps And Instants: std-time.timestamp.unix-milliseconds, std-time.timestamp.api-milliseconds,
# std-time.instant.api-milliseconds, std-time.instant.as-milliseconds, std-time.timestamp.display (spec pass 89, audit Q2).
use std.time.{Instant, Timestamp, s}

tests:
    use std.testing.{assert, assert_equal}

    it("round trip"):
        let values: List[i64] = [0, 1, -1, 1700000000500, -86400000, 9223372036854775807, -9223372036854775807]
        for millis in values:
            assert_equal(Timestamp::from_unix_milliseconds(millis).unix_milliseconds(), millis, reason="the same milliseconds")
            assert_equal(Instant::from_milliseconds(millis).as_milliseconds(), millis, reason="the same instant milliseconds")

    it("follows arithmetic and parsing"):
        later := Timestamp::from_unix_milliseconds(1000) + s(2)
        assert_equal(later.unix_milliseconds(), 3000, reason="1000 ms plus two seconds")
        match Timestamp::parse_rfc3339("1970-01-01T00:00:01.250Z"):
            .Ok(stamp) => assert_equal(stamp.unix_milliseconds(), 1250, reason="the parsed instant")
            .Err(_) => assert(false, reason="the text is valid RFC 3339")

    it("displays as RFC 3339"):
        stamp := Timestamp::from_unix_milliseconds(1700000000500)
        assert_equal("${stamp}", "2023-11-14T22:13:20.500Z", reason="Display is to_rfc3339")
