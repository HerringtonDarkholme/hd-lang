# test: list append grows

use std.testing.assert_equal

fn main() -> i32:
    let values: mut List[i32] = []
    values.push(1)
    values.push(2)
    values.push(3)
    values.push(4)
    values.push(5)
    values.push(36)
    values.len() + values[5]

tests:
    it("main returns 42"):
        assert_equal(main(), 42, reason="list append grows")
