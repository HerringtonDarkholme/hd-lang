# test: list append grows

fn main() -> i32:
    let values: mut List[i32] = []
    values.push(1)
    values.push(2)
    values.push(3)
    values.push(4)
    values.push(5)
    values.push(36)
    values[values.len() - 1] + values[values.len() - 2] + 1

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="list append grows")
