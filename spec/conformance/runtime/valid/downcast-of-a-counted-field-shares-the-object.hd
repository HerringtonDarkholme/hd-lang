# test: a counted trait value lends itself to downcast and the local result shares its boxed object
# Spec 09 Recovering A Concrete Type: trait.downcast.local-receiver, trait.downcast.reference-identity.
# expect-stdout: 2 true
# expect-stdout: 3
use std.inspect.Inspectable

struct User:
    count: i32

struct Pair:
    a: User
    b: *mut User

fn shared(p: &Pair) -> (i32, bool):
    let erased: *dyn Inspectable = p.b
    match erased.downcast_ref::[User]():
        .Some(u) => (u.count, u is p.b)
        .None => (0, false)

pub fn main() -> void $ Console:
    pair := Pair { a: User { count: 1 }, b: box(User { count: 2 }) }
    let (count, same) = shared(&pair)
    println("${count} ${same}")
    pair.b.count += 1
    let (changed, _) = shared(&pair)
    println("${changed}")
