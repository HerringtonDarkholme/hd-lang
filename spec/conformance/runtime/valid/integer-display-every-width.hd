# test: every integer width displays the same base-ten text as digit-by-digit division
# Spec lang/04-type-system types.display.int; std-json.number.display; the property cases compare against a reference that
# prepends one digit at a time, and the extremes of every width are checked by value.
use std.testing.{assert_equal, it_prop}

fn digit(value: i64) -> string:
    "0123456789".slice(usize(value), usize(value) + 1)

# The reference text of a non-negative magnitude, one digit at a time.
fn reference_unsigned(value: u64) -> string:
    let text = digit(i64(value % 10))
    let rest = value / 10
    while rest != 0:
        text = digit(i64(rest % 10)) + text
        rest = rest / 10
    text

# Negative remainders keep the minimum value from being negated.
fn reference_signed(value: i64) -> string:
    if value >= 0:
        return reference_unsigned(u64(value))
    let text = ""
    let rest = value
    while rest != 0:
        text = digit(0 - rest % 10) + text
        rest = rest / 10
    "-" + text

tests:
    it("the extremes of every width"):
        assert_equal("${i8(-127 - 1)} ${i8(127)} ${i8(0)}", "-128 127 0", reason="i8")
        assert_equal("${i16(-32768)} ${i16(32767)}", "-32768 32767", reason="i16")
        assert_equal("${i32(-2147483648)} ${i32(2147483647)}", "-2147483648 2147483647", reason="i32")
        let smallest: i64 = -9223372036854775807 - 1
        let largest: i64 = 9223372036854775807
        assert_equal("$smallest $largest", "-9223372036854775808 9223372036854775807", reason="i64")
        assert_equal("${u8(0)} ${u8(255)}", "0 255", reason="u8")
        assert_equal("${u16(0)} ${u16(65535)}", "0 65535", reason="u16")
        assert_equal("${u32(0)} ${u32(4294967295)}", "0 4294967295", reason="u32")
        let top: u64 = 18446744073709551615
        assert_equal("${u64(0)} $top", "0 18446744073709551615", reason="u64")
        assert_equal("${usize(0)} ${usize(10)} ${usize(99)} ${usize(100)}", "0 10 99 100", reason="usize")

    it("every power of ten and its neighbors"):
        let power: u64 = 1
        for _ in 0..19:
            assert_equal("${power - 1}", reference_unsigned(power - 1), reason="below")
            assert_equal("${power}", reference_unsigned(power), reason="at")
            assert_equal("${power + 1}", reference_unsigned(power + 1), reason="above")
            power = power * 10

    it_prop("i8", prop=fn!(value: i8):
        assert_equal("$value", reference_signed(i64(value)), reason="i8")
        assert_equal(value.to_string(), reference_signed(i64(value)), reason="i8 to_string")
    )

    it_prop("i16", prop=fn!(value: i16):
        assert_equal("$value", reference_signed(i64(value)), reason="i16")
    )

    it_prop("i32", prop=fn!(value: i32):
        assert_equal("$value", reference_signed(i64(value)), reason="i32")
    )

    it_prop("i64", prop=fn!(value: i64):
        assert_equal("$value", reference_signed(value), reason="i64")
        assert_equal(debug(value), reference_signed(value), reason="i64 debug")
    )

    it_prop("u8", prop=fn!(value: u8):
        assert_equal("$value", reference_unsigned(u64(value)), reason="u8")
    )

    it_prop("u16", prop=fn!(value: u16):
        assert_equal("$value", reference_unsigned(u64(value)), reason="u16")
    )

    it_prop("u32", prop=fn!(value: u32):
        assert_equal("$value", reference_unsigned(u64(value)), reason="u32")
    )

    it_prop("u64", prop=fn!(value: u64):
        assert_equal("$value", reference_unsigned(value), reason="u64")
    )

    it_prop("usize", prop=fn!(value: usize):
        assert_equal("$value", reference_unsigned(u64(value)), reason="usize")
    )
