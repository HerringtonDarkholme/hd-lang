# test: an outer field does not hide an embedded method, because a call looks up methods only
use std.testing.assert_equal

data Base:
    note: string

impl Base:
    fn label(self) -> string:
        "base " + self.note

data Page:
    Base
    label: string

test "the outer field is read and the call reaches the promoted method":
    page := Page { Base: ...Base { note: "x" }, label: "outer" }
    assert_equal(page.label, "outer", reason="own field")
    assert_equal(page.label(), "base x", reason="promoted method")
