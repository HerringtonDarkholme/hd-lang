# test: negative zero, infinities and every NaN display by fixed spellings
# Spec 04 Numeric Display: types.display.special, types.display.nan-canonical.
# expect-stdout: -0.0 inf -inf
# expect-stdout: NaN NaN
fn ratio(a: f64, b: f64) -> f64: a / b

pub fn main() -> void $ Console:
    zero := 0.0
    nan := ratio(zero, zero)
    println("${-zero} ${ratio(1.0, zero)} ${ratio(-1.0, zero)}")
    println("$nan ${-nan}")
