# test: generic data fields
# Spec 04 Generics: types.generic.type-parameter.complete, types.generic.naming,
# types.generic.kind, types.generic.explicit,
# types.generic.sharing, types.generic.interfaces,
# types.generic.identity.primitive.

struct Box[T]:
    value: T

struct Pair[A, B]:
    first: A
    second: B

fn keep[T](boxed: Box[T]) -> Box[T]:
    boxed

fn main() -> Pair[Box[i32], string]:
    boxed := Box { value: +40 }
    Pair { first: keep(boxed), second: "hd" }

tests:
    use std.testing.assert_equal

    it("fields keep their instantiated types"):
        pair := main()
        assert_equal(pair.first.value + 2, 42, reason="generic data fields")
        assert_equal(pair.second.len(), 2, reason="the string field")
