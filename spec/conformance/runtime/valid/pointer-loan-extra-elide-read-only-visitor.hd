# test: pointer loans, adversarial: a read-only visitor called through a trait value over pointers; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
trait Visitor:
    fn see(&mut self, name: &string) -> void

struct Shape:
    name: string

struct Scene:
    shapes: List[*Shape]

struct Counter:
    chars: usize

impl Visitor for Counter:
    fn see(&mut self, name: &string) -> void:
        self.chars += name.len()

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn walk(scene: *Scene, v: &mut dyn Visitor) -> void:
    for shape in &scene.shapes:
        n := &shape.name
        v.see(n)

pub fn main() -> void $ Console:
    scene := box(Scene { shapes: [box(Shape { name: orig() }), box(Shape { name: orig() })] })
    let mut counter = Counter { chars: 0 }
    walk(scene, &mut counter)
    seen := if counter.chars == 2 * orig().len(): orig() else: fresh()
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
