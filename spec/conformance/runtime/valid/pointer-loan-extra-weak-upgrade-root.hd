# test: pointer loans, adversarial: a reference through an upgraded weak pointer outlives the last strong holder's release; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
use std.weak.{Weak, weak}

struct Cell:
    value: string

struct Holder:
    child: *Cell

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn probe(holder: *mut Holder, w: Weak[Cell]) -> string:
    match w.upgrade():
        .Some(strong) =>
            r := &strong.value
            holder.child = box(Cell { value: fresh() })
            junk := churn()
            seen := *r
            _ := junk.len()
            seen
        .None => ""

pub fn main() -> void $ Console:
    holder := box(Holder { child: box(Cell { value: orig() }) })
    w := weak(holder.child).expect("a whole object")
    seen := probe(holder, w)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
