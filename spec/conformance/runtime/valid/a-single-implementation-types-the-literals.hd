# test: a single implementation types the literals
# Rules: expr.index.trait.choice, trait.resolve.literal-arg.
# expect-stdout: 2.0
# expect-stdout: 4.0
use std.ops.Index

struct Board:
    cells: List[f64]

impl Index[(i32, i32)] for Board:
    type Out = f64
    fn index(self, at: (i32, i32)) -> f64:
        self.cells[usize(at._0 * 2 + at._1)]

pub fn main() -> void $ Console:
    let b = Board { cells: [1.0, 2.0, 3.0, 4.0] }
    let x: f64 = b[(0, 1)]
    println(x)
    println(b[(1, 1)])
