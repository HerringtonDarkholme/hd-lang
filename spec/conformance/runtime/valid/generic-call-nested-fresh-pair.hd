# test: a Box literal inside a Pair literal fills a generic Pair[Box[T], U] parameter
# Spec 04 Generic Arguments: types.generic.infer; T and U are solved from the nested literal.
struct Box[T]:
    item: T

struct Pair[A, B]:
    first: A
    second: B

fn left[T, U](pair: Pair[Box[T], U]) -> T:
    pair.first.item

tests:
    use std.testing.assert_equal

    it("solves T as i64 and U as string from the nested literal"):
        assert_equal(left(Pair { first: Box { item: i64(7) }, second: "seven" }), i64(7), reason="T is i64 and U is string")
