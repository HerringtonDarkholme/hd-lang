# expect-stdout: shared open false
# expect-stdout: dyn open false
# expect-stdout: open true, closed value, using shared, closed shared, closed dyn
# test: a using binding of a value disposes its own place, and one of a reference or a trait value reference disposes what it refers to, which every other reference sees
# Spec lang/06 Using Bindings: flow.using.place.v2, flow.using.reference.v2, flow.using.protocol.required.
use std.ops.Disposable

struct Conn:
    name: string
    log: *mut List[string]
    open: bool

impl Disposable for Conn:
    fn dispose(&mut self) -> void:
        self.open = false
        self.log.push("closed ${self.name}")

trait Session < Disposable:
    fn name(&self) -> string

impl Session for Conn:
    fn name(&self) -> string:
        self.name

fn by_value(log: *mut List[string]) -> void:
    using conn = Conn { name: "value", log: log, open: true }
    log.push("open ${conn.open}")

fn by_reference(conn: &mut Conn) -> void:
    using held = conn
    held.log.push("using ${held.name}")

fn by_trait(session: &mut dyn Session) -> void:
    using held = session
    _ := held.name()

pub fn main!() -> void $ Console:
    log := box::[List[string]]([])
    by_value(log)
    shared := box(Conn { name: "shared", log: log, open: true })
    by_reference(shared)
    println("shared open ${shared.open}")
    other := box(Conn { name: "dyn", log: log, open: true })
    by_trait(other)
    println("dyn open ${other.open}")
    println(log.join(", "))
