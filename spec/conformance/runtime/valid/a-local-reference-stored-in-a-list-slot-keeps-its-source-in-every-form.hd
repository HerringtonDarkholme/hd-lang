# test: a local reference keeps its source alive however a local collection holds it: a copy of the list, a slot through a reference, a slot's slot, a tuple in a slot, a map slot, a slot read from another slot, a store in a loop, a source in a cell, and a suspending body
# Spec 13 Values and References: ref.dep.scope, ref.local.escape.
# expect-stdout: a1 b2 c3
# expect-stdout: b2 c3
# expect-stdout: b2 c3
# expect-stdout: b2 c3
# expect-stdout: b2 c3
# expect-stdout: b2 c3
# expect-stdout: b2 7 c3
# expect-stdout: b2 c3
# expect-stdout: a1 c3
# expect-stdout: n1 c3
# expect-stdout: d4 d4 c3
# expect-stdout: b2 a1 c3

use std.time.{Clock, ms, sleep}

struct P:
    name: string

fn make(tag: string, n: i32) -> P:
    P { name: "$tag$n" }

fn junk() -> string:
    "c${3}"

fn pushed() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p]
    ps.push(&q)
    j := junk()
    println("${ps[0].name} ${ps[1].name} $j")

fn pushed_binding() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p]
    r := &q
    ps.push(r)
    j := junk()
    println("${ps[1].name} $j")

fn in_an_optional() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut os: List[(&P)?] = [&p]
    os[0] = &q
    j := junk()
    match os[0]:
        .Some(r) => println("${r.name} $j")
        .None => println("none")

fn copied() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p]
    ps[0] = &q
    qs := ps
    j := junk()
    println("${qs[0].name} $j")

fn through_a_reference() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p]
    r := &mut ps
    r[0] = &q
    j := junk()
    println("${ps[0].name} $j")

fn nested() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut pss = [[&p]]
    pss[0][0] = &q
    j := junk()
    println("${pss[0][0].name} $j")

fn in_a_tuple() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [(&p, 1)]
    ps[0] = (&q, 7)
    j := junk()
    println("${ps[0]._0.name} ${ps[0]._1} $j")

fn in_a_map() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut by: Map[string, &P] = { "k": &p }
    by["k"] = &q
    j := junk()
    println("${by["k"].name} $j")

fn from_another_slot() -> void $ Console:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p, &q]
    ps[1] = ps[0]
    j := junk()
    println("${ps[1].name} $j")

fn in_a_loop() -> void $ Console:
    p := make("n", 0)
    q := make("n", 1)
    let mut ps = [&p]
    for i in 0..3:
        if i == 1:
            ps[0] = &q
    j := junk()
    println("${ps[0].name} $j")

fn in_a_cell() -> void $ Console:
    p := make("a", 1)
    let mut q = make("b", 2)
    set := fn() -> void: q = make("d", 4)
    set()
    let mut ps = [&p]
    ps[0] = &q
    ps.push(&q)
    j := junk()
    println("${ps[0].name} ${ps[1].name} $j")

fn suspending!() -> void $ Console + Clock:
    p := make("a", 1)
    q := make("b", 2)
    let mut ps = [&p]
    ps[0] = &q
    ps.push(&p)
    sleep!(ms(1))
    j := junk()
    println("${ps[0].name} ${ps[1].name} $j")

pub fn main!() -> void $ Console + Clock:
    pushed()
    pushed_binding()
    in_an_optional()
    copied()
    through_a_reference()
    nested()
    in_a_tuple()
    in_a_map()
    from_another_slot()
    in_a_loop()
    in_a_cell()
    suspending!()
