# test: requirements / inferred rows / private function infers its row

use std.testing.assert_equal

trait Clock

data FixedClock: pass

impl Clock for FixedClock

fn read_clock() -> i32:
    _ := $.use(Clock)
    42

test "inferred row is satisfied by the provider scope":
    $.with(Clock=FixedClock {}):
        assert_equal(read_clock(), 42, reason="private function infers its row")
