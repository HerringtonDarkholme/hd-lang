# expect-stdout: abandoned
# expect-stdout: work defer, stop finished, send close, channel defer, both defer
# test: block_on of a suspension cancelled inside its own drive whose cleanup is cut short gives .Abandoned
# Spec lang/11 Driving A Stored Suspension: req.drive.block-on.cancelled; Abandoning: req.abandon.dependency.result; std/task Block On: std-task.block-on.abandoned.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.{join, block_on}
use std.time.{Clock, s, sleep}

struct Channel['a]:
    log: *mut List[string]
    ack: Suspend[void, 'a]

impl['a] AsyncDisposable for Channel['a]:
    fn dispose!(&mut self) -> void:
        defer(fn() -> void: self.log.push("channel defer"))
        self.log.push("send close")
        let mut wait = self.ack
        wait!() # ack was abandoned: the dispose is cut short here
        self.log.push("acked")

fn work!(log: &mut List[string]) -> string $ Clock:
    defer(fn() -> void: log.push("work defer"))
    sleep!(s(60))
    "late"

fn stop!(job: Suspend[string], log: &mut List[string]) -> string:
    match job.cancel!():
        .Finished => log.push("stop finished")
        .Abandoned => log.push("stop abandoned")
    "stopped"

# `job` turns out cancelled when `join!` polls it again, so `join!` and
# `both` are cancelled, and the dispose of `channel` cannot finish.
fn both!(
    job: Suspend[string],
    ack: Suspend[void],
    log: *mut List[string],
) -> string $ Clock:
    defer(fn() -> void: log.push("both defer"))
    using! channel = &mut Channel { log: log, ack: ack }
    let (worked, stopped) = join!(job, stop(job, log))
    "${worked} ${stopped}"

fn drive(log: *mut List[string]) -> string $ Clock:
    let ack: Suspend[void] = sleep(s(60))
    ack.abandon()
    let job: Suspend[string] = work(log)
    match block_on(both(job, ack, log)):
        .Completed(value) => value
        .Cancelled => "cancelled"
        .Abandoned => "abandoned"

pub fn main() -> void $ Console + Clock:
    log := box::[List[string]]([])
    println(drive(log))
    println(log.join(", "))
