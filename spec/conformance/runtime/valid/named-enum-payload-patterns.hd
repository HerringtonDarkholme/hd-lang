# test: named enum payload patterns resolve bindings by field name

use std.testing.assert_equal

enum Choice:
    Pair(then_value: i32, else_value: i32)

fn ordered(choice: Choice) -> i32:
    match choice:
        Choice.Pair(else_value=right, then_value=left) => left - right

fn main() -> i32: ordered(Choice.Pair(50, 8))

test "main returns 42":
    assert_equal(main(), 42, reason="named enum payload patterns resolve bindings by field name")
