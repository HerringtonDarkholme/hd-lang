# test: chain takes any Iterable, takes its iterator once when called, and reads self, then other
# Spec std/iter More Adapters: std-iter.adapter.chain-iterable, .iterable-arg, and .chain-iterable.order.
use std.collections.Set
use std.testing.assert_equal

# An iterable whose `iter` and whose iterator's pulls run given closures.
data Probe:
    start: fn() -> void
    pull: fn() -> i32?

impl Iterable[i32] for Probe:
    fn iter(self) -> mut Iterator[i32]:
        (self.start)()
        Iterator::from_fn(self.pull)

tests:
    it("chain"):
        assert_equal([1].iter().chain([2, 3]).collect(), [1, 2, 3], reason="a list")
        assert_equal([1].iter().chain(2..4).collect(), [1, 2, 3], reason="a range")
        let seen: mut Set[i32] = Set::new()
        _ := seen.insert(7)
        assert_equal([+1].iter().chain(seen).collect(), [1, 7], reason="a set")
        let empty: List[i32] = []
        assert_equal(empty.iter().chain(empty).collect(), [], reason="both empty")
    it("chain takes iter once, when called, and reads other only after self"):
        let log: mut List[string] = []
        let at = +0
        probe := Probe {
            start: fn() -> void: log.push("iter"),
            pull: fn() -> i32?:
                log.push("next")
                at = at + 1
                .Some(at * 10)
        }
        let mut joined = [+1].iter().chain(probe)
        assert_equal(log, ["iter"], reason="iter at the call, and no next")
        assert_equal(joined.next(), .Some(1), reason="self first")
        assert_equal(log, ["iter"], reason="other not read yet")
        assert_equal(joined.next(), .Some(10), reason="then other")
        assert_equal(log, ["iter", "next"], reason="one read of other")
