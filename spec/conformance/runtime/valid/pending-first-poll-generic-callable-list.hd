# fixture-runtime-profile: tick
# fixture-runtime-scenario: pending-first-poll
# test: a generic list invokes a stored suspending callable whose host call is pending first
use std.testing.assert_equal

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn stored!() -> i32 $ Console + Tick:
    let mut console = $.use(Console)
    $.use(Tick).tick!("stored\n")
    _ := console.write_sync("stored\n")
    42

fn invoke_first![T](tasks: List[fn!() -> T $ Console + Tick]) -> T $ Console + Tick:
    task := tasks[0]
    task!()

pub fn main!() -> void $ Console + Tick:
    assert_equal(
        invoke_first!([stored]),
        42,
        reason="the stored callable completes after its pending tick",
    )
