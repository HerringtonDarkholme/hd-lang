# test: after use std.time as clock, clock.s is the function value time.s
# Spec 03 Use Declarations: names.use.introduces; a module use with as binds the module namespace under the alias.
use std.time as clock

fn make_one(make: fn(i64) -> clock.Duration) -> clock.Duration:
    make(1)

tests:
    use std.testing.assert_equal

    it("the alias reaches the module's members"):
        assert_equal(make_one(clock.s), clock.ms(1000), reason="clock.s is time.s")
