# test: a value of a map in a writable place is a place, so a field write through it changes the value in the map
# Spec 04 Map Values: types.coll.map-value.place.
struct Stock:
    count: i32
    tags: List[string]

fn restock(shelves: Map[string, Stock]) -> Map[string, Stock]:
    let mut copy = shelves
    copy["apple"].count = 5
    copy

fn tag(shelves: &mut Map[string, Stock], name: string) -> void:
    shelves[name].count += 1
    shelves[name].tags.push("checked")

tests:
    use std.testing.assert_equal

    it("a field write changes the value in place"):
        let shelves: Map[string, Stock] = {"apple": Stock { count: 1, tags: [] }}
        copy := restock(shelves)
        assert_equal(copy["apple"].count, 5, reason="the copy's value changed")
        assert_equal(shelves["apple"].count, 1, reason="the original map is a value of its own")

    it("a compound field write and a nested change go through a reference to the map"):
        let mut shelves: Map[string, Stock] = {"pear": Stock { count: 2, tags: [] }}
        tag(&mut shelves, "pear")
        assert_equal(shelves["pear"].count, 3, reason="the field changed in the caller's map")
        assert_equal(shelves["pear"].tags, ["checked"], reason="the inner list changed where it is stored")
