# test: map_all! with a full-width limit returns results in input order
# Spec std/task Map All: std-task.map-all.order and std-task.map-all.start-order.
use std.task.map_all
struct Log:
    started: *mut List[i32]

fn square!(log: &mut Log, value: i32) -> i32:
    log.started.push(value)
    value * value

fn squares!(log: *mut Log) -> List[i32]:
    map_all!([3, 1, 2], 3, fn!(value: i32) -> i32: square!(log, value))

tests:
    use std.testing.assert_equal

    it("results come back in input order"):
        log := box(Log { started: box::[List[i32]]([]) })
        assert_equal(squares!(log), [9, 1, 4], reason="one result per task, in task order")
        assert_equal(*log.started, [3, 1, 2], reason="the tasks start in input order")
