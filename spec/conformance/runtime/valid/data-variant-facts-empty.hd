# test: a data type's one variant has no facts of its own
# Spec 14 Members And Variants: a template reads type-level facts through T::facts().
use std.structure.{Structure, Field, Variant, Walker}
use std.testing.assert_equal

data Style:
    prefix: string = ""

fn style(prefix: string = "") -> Style:
    Style { prefix: prefix }

trait Probe:
    fn probe(self) -> string

data Prober:
    out: string

impl[S] Walker[S] for Prober:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        label := match v.info.facts.find[Style]():
            .Some(found) => found.prefix
            .None => "none"
        self.out = self.out + "variant:" + label + ";"
        .Ok()

    fn member[F](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        .Ok()

impl[T] Probe for T by Structure:
    fn probe(self) -> string:
        let mut w = Prober { out: "" }
        _ := Structure::walk(self, w)
        label := match T::facts().find[Style]():
            .Some(found) => found.prefix
            .None => "none"
        w.out + "type:" + label

@derive(Probe)
@style(prefix="p_")
data Point:
    x: i64

tests:
    it("the data variant's facts are empty"):
        assert_equal(Point { x: 1 }.probe(), "variant:none;type:p_", reason="type-level facts come from T::facts()")
