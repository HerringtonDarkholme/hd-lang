# test: suspending closure values forward their requirement rows
# Spec 11 Suspending Closures And Binding: req.suspend.closure.marker,
# req.suspend.closure.requirements, req.suspend.closure.row-inference,
# req.bind.construction, req.bind.captured, req.bind.caller.

trait Increment:
    fn next!(self, value: i32) -> i32

data FixedIncrement: pass

impl Increment for FixedIncrement:
    fn next!(self, value: i32) -> i32:
        value + 1

fn drive_required_closure!() -> i32:
    operation := fn!(value: i32) -> i32 $ Increment:
        provider := $.use(Increment)
        provider.next!(value)
    $.with(Increment=FixedIncrement {}):
        operation!(41)

tests:
    use std.testing.assert_equal

    it("the closure receives its provider when its suspension is constructed"):
        assert_equal(
            drive_required_closure!(),
            42,
            reason="the callable requirement row must reach the generated closure frame",
        )
