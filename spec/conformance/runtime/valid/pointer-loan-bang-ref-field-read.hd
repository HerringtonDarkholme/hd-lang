# test: pointer loans: a `&` to a field of a struct field behind a `*T`, held across a bang call that suspends and acts; an alias reads the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
use std.time.{Clock, sleep}

struct Inner:
    value: string

struct Outer:
    inner: Inner
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { inner: Inner { value: orig() }, other: second() })

fn act!(alias: *Outer) -> string $ Clock:
    sleep!(1ms)
    seen_alias := alias.inner.value
    junk := churn()
    _ := seen_alias.len()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *Outer) -> string $ Clock:
    r := &p.inner.value
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Clock:
    p := make()
    seen := probe!(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
