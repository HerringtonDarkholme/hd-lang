# test: copy-update is shallow and does not re-evaluate field defaults
# expect: test
# Spec 08 Copy-Update Literals: data.update.new-value, data.update.no-defaults, data.update.mutable-result; Field Defaults: data.default.eval.
use std.testing.{assert, assert_equal}

data Child:
    name: string

data Parent:
    child: mut Child
    label: string
    tags: List[string] = []

tests:
    it("a copied composite field is shared with the source"):
        let mut original = Parent { child: Child { name: "a" }, label: "x" }
        let mut copy = Parent { ...original, label: "y" }
        assert(copy.child is original.child, reason="shallow copy shares the child")
        copy.child.name = "b"
        assert_equal(original.child.name, "b", reason="mutation through the copy is visible")
        assert_equal(original.label, "x", reason="replaced primitive field does not affect the source")

    it("the spread supplies defaulted fields instead of re-evaluating defaults"):
        let mut original = Parent { child: Child { name: "a" }, label: "x" }
        copy := Parent { ...original }
        assert(copy.tags is original.tags, reason="default is not evaluated for a spread copy")

    it("each ordinary construction evaluates the default afresh"):
        first := Parent { child: Child { name: "a" }, label: "1" }
        second := Parent { child: Child { name: "a" }, label: "2" }
        assert(!(first.tags is second.tags), reason="one default list per construction")

    it("a readonly source with an explicit mut replacement"):
        let mut original = Parent { child: Child { name: "a" }, label: "x" }
        let readonly: Parent = original
        let mut replaced = Parent { ...readonly, child: Child { name: "fresh" } }
        replaced.child.name = "changed"
        assert_equal(original.child.name, "a", reason="replacement child is independent")
        assert_equal(replaced.label, "x", reason="other fields are copied")
