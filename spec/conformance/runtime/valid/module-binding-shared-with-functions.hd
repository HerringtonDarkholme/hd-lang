# test: module bindings are shared with declared functions
# Spec 10 Top-Level Statements: module.init.binding, module.init.storage.

use std.testing.assert_equal

let count = +0
label := "requests"

fn increment() -> void:
    count = count + 1

fn value() -> i32:
    count

increment()

tests:
    it("initialization and later calls update one module binding"):
        assert_equal(value(), 1, reason="module initialization ran increment once")
        increment()
        assert_equal(value(), 2, reason="a later call updates the same binding")
        assert_equal(label, "requests", reason="an immutable module binding is readable")
