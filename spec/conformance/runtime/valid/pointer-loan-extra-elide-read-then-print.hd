struct Person:
    name: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn greet(p: *Person) -> void $ Console:
    n := &p.name
    println(*n)

pub fn main() -> void $ Console:
    p := box(Person { name: "ok" })
    greet(p)
