# test: a tuple spread fills the remaining fixed parameters, one element each
# expect: test
use std.function.{Fn, Tuple}
use std.testing.assert_equal

fn add(a: i32, b: i32) -> i32: a + b
fn add3(a: i32, b: i32, c: i32) -> i32: a + b + c
fn twice!(a: i32, b: i32) -> i32: (a + b) * 2

fn through[Args < Tuple, O](f: Fn[Args, O, $()], args: Args) -> O:
    f(args...)

fn suspended!(pair: (i32, i32)) -> i32:
    twice!(pair...)

tests:
    it("a tuple fills fixed parameters"):
        pair := (1, 2)
        assert_equal(add(pair...), 3, reason="every parameter")
        assert_equal(add3(10, pair...), 13, reason="the remaining parameters")
        assert_equal(through(add, (4, 5)), 9, reason="a function value's inputs tuple")
        assert_equal(suspended!((3, 4)), 14, reason="a bang call spreads the same way")
