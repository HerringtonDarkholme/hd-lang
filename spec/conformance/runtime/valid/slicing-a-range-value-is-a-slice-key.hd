# test: ordinary slice methods take explicit offsets from range values
# expect-stdout: el
# expect-stdout: 4
# expect-stdout: abc
use std.ops.{Range, RangeFrom}

pub fn main() -> void $ Console:
    let r: Range[usize] = Range { start: 1, end: 3, inclusive: false }
    let from: RangeFrom[usize] = RangeFrom { start: 3 }
    println("hello".slice(r.start, r.end))
    println([1, 2, 3, 4].slice(from.start, 4)[0])
    println("abc".slice(0, 3))
