# test: an implementation's associated type names the target's lifetime, and an index call reads through it
# Spec 13 Lifetime Implementation Targets: ref.lifetime.impl-target.assoc.
# expect-stdout: 7
use std.ops.Index

struct Borrowed[T, 'a]:
    item: &'a T

impl[T, 'a] Index[usize] for Borrowed[T, 'a]:
    type Out = &'a T
    fn index(self, key: usize) -> &'a T:
        if key > 0:
            panic("out of bounds")
        self.item

pub fn main() -> void $ Console:
    value := +7
    borrowed := Borrowed { item: &value }
    println("${*borrowed[0]}")
