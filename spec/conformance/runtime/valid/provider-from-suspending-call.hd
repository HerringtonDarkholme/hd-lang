# test: provider from suspending call

use std.testing.assert_equal

trait Clock

data MockClock:
    value: i32

impl Clock for MockClock

fn make_clock!(value: i32) -> Clock:
    MockClock { value: value }

fn read() -> i32 $ Clock:
    _ := $.use(Clock)
    42

fn main!() -> i32:
    $.with(Clock=make_clock!(1)):
        read()

test "main returns 42":
    assert_equal(main!(), 42, reason="provider from suspending call")
