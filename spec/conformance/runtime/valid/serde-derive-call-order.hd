# test: a derived Serialize uses the data hooks for a struct and the variant hooks for an enum; each writes members in order, and a list is begin_list, items, end_list
# Spec 02 Traits And Implementations: grammar.impl.by-structure.
# Spec std/serde Data Model, Derived Implementations: std-serde.derive.serialize.data-and-enum-forms, std-serde.model.data-record, std-serde.model.enum-record, std-serde.model.list, std-serde.derive.omitted (task #320).
# Spec std/serde Data Model, Derived Implementations: std-serde.model.map-scalar-keys, std-serde.model.container-len, std-serde.model.null, std-serde.model.bool, std-serde.model.int, std-serde.model.uint, std-serde.model.member-args.local-ref, std-serde.derive.serialize.template.
use std.serde.{Serialize, Serializer}
use std.structure.{Structure, Facts, VariantInfo, Member}
# Records each call as a word, so the test reads the call order.
struct Calls:
    pub log: string

impl Calls:
    fn add(&mut self, word: string) -> Result[void, never]:
        if self.log == "":
            self.log = word
        else:
            self.log = self.log + " " + word
        .Ok(())

impl Serializer for Calls:
    type Error = never

    fn null(&mut self) -> Result[void, never]:
        self.add("null")

    fn bool(&mut self, value: bool) -> Result[void, never]:
        self.add("bool:$value")

    fn int(&mut self, value: i64) -> Result[void, never]:
        self.add("int:$value")

    fn uint(&mut self, value: u64) -> Result[void, never]:
        self.add("uint:$value")

    fn float(&mut self, value: f64) -> Result[void, never]:
        self.add("float:$value")

    fn text(&mut self, value: string) -> Result[void, never]:
        self.add("text:$value")

    fn begin_list(&mut self, len: usize) -> Result[void, never]:
        self.add("list:$len")

    fn end_list(&mut self) -> Result[void, never]:
        self.add("end-list")

    fn begin_map(&mut self, len: usize) -> Result[void, never]:
        self.add("map:$len")

    fn key(&mut self, key: string) -> Result[void, never]:
        self.add("key:$key")

    fn end_map(&mut self) -> Result[void, never]:
        self.add("end-map")

    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.add("data:${v.name}")

    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.add("variant:${v.name}")

    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.add("newtype:${v.name}")

    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, never]:
        self.add("tuple:${v.name}:$len")

    fn member(&mut self, m: &Member) -> Result[void, never]:
        self.add("member:${m.name}")

    fn end_data(&mut self) -> Result[void, never]:
        self.add("end-data")

    fn end_variant(&mut self) -> Result[void, never]:
        self.add("end-variant")

struct Cache:
    hits: i64

struct Order:
    id: u32
    lines: List[i8]
    note: string?
    cache: Cache = Cache { hits: 0 }

impl Serialize for Order by Structure:
    cache = pass

@derive(Serialize)
enum Step:
    Start
    Move(by: i32)
    Token(i32)
    Pair(i32, string)

fn calls[T < Serialize](value: T) -> string:
    let mut out = Calls { log: "" }
    _ := value.serialize(&mut out)
    out.log

tests:
    use std.testing.assert_equal

    it("a data value is one variant of its members, in declaration order"):
        order := Order { id: 7, lines: [1, -2], note: .None }
        assert_equal(
            calls(order),
            "data:Order member:id uint:7 member:lines list:2 int:1 int:-2 end-list member:note null end-data",
            reason="omitted cache is not written",
        )

    it("an enum value is its variant with that variant's members"):
        assert_equal(calls(Step.Start), "variant:Start end-variant", reason="no members")
        assert_equal(
            calls(Step.Move(3)),
            "variant:Move member:by int:3 end-variant",
            reason="one member",
        )
        assert_equal(
            calls(Step.Token(4)),
            "newtype:Token int:4 end-variant",
            reason="one positional member",
        )
        assert_equal(
            calls(Step.Pair(5, "x")),
            "tuple:Pair:2 int:5 text:x end-variant",
            reason="several positional members",
        )

    it("a map writes a key before each value"):
        assert_equal(calls({ "a": true }), "map:1 key:a bool:true end-map", reason="map")
