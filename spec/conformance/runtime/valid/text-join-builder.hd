# test: join, as a function and a List[string] method, puts the separator between parts, and StringBuilder joins pushed text in order
# Spec std/text Joining And Building: std-text.join.result, std-text.join.method, std-text.builder.new, .push, .build.
use std.text.{StringBuilder, join}
use std.testing.assert_equal

fn csv(cells: List[string]) -> string:
    cells.join(",")

fn dotted(parts: List[string]) -> string:
    join(parts, ".")

fn report(names: List[string]) -> string:
    let mut out = StringBuilder::new()
    for name in names:
        out.push("- ${name}\n")
    out.build()

tests:
    it("joins"):
        assert_equal(csv(["a", "b", "c"]), "a,b,c", reason="between each two")
        assert_equal(csv(["a"]), "a", reason="one part")
        assert_equal(csv([]), "", reason="no part")
        assert_equal(["a", "b"].join(", "), "a, b", reason="a literal receiver")
        assert_equal(["a", "", "c"].join("-"), "a--c", reason="an empty part stays")
        assert_equal(dotted(["x", "y"]), "x.y", reason="the free function")
        assert_equal(csv(["p", "q"]), dotted(["p", "q"]).replace(".", ","), reason="both forms agree")

    it("builds"):
        assert_equal(report(["Ada", "Bo"]), "- Ada\n- Bo\n", reason="in push order")
        let mut empty = StringBuilder::new()
        assert_equal(empty.build(), "", reason="an empty builder")
        empty.push("x")
        assert_equal(empty.build(), "x", reason="build leaves it unchanged")
        assert_equal(empty.build(), "x", reason="twice")
