# test: the List[string] join method puts the separator between parts, and StringBuilder joins pushed text in order
# Spec std/text Joining And Building: std-text.join.list-result, std-text.join.list-method, std-text.builder.new-ref, .push-ref, .push-char-ref, .build-empties.
use std.text.StringBuilder
fn csv(cells: List[string]) -> string:
    cells.join(",")

fn report(names: List[string]) -> string:
    out := StringBuilder::new()
    for name in names:
        out.push("- ").push(name).push_char('\n')
    out.build()

tests:
    use std.testing.assert_equal

    it("joins"):
        assert_equal(csv(["a", "b", "c"]), "a,b,c", reason="between each two")
        assert_equal(csv(["a"]), "a", reason="one part")
        assert_equal(csv([]), "", reason="no part")
        assert_equal(["a", "b"].join(", "), "a, b", reason="a literal receiver")
        assert_equal(["a", "", "c"].join("-"), "a--c", reason="an empty part stays")
        assert_equal(["x", "y"].join("."), "x.y", reason="another separator")
        assert_equal(["x", "y"].join(""), "xy", reason="an empty separator")

    it("builds"):
        assert_equal(report(["Ada", "Bo"]), "- Ada\n- Bo\n", reason="in push order")
        empty := StringBuilder::new()
        assert_equal(empty.build(), "", reason="an empty builder")
        empty.push("x")
        assert_equal(empty.build(), "x", reason="what was pushed")
        assert_equal(empty.build(), "", reason="build empties it")

    it("chains and pushes characters"):
        assert_equal(StringBuilder::new().push("a").push_char('b').build(), "ab", reason="push chains into push_char")
        out := StringBuilder::new()
        out.push_char('a').push_char('\u{e9}').push_char('\u{20ac}').push_char('\u{1f600}').push("!")
        text := out.build()
        assert_equal(text, "a\u{e9}\u{20ac}\u{1f600}!", reason="1-, 2-, 3- and 4-byte scalars")
        assert_equal(text.len(), 11, reason="ten bytes of scalars and one of text")
        out.push_char('z').push("y").push_char('x')
        assert_equal(out.build(), "zyx", reason="characters and texts keep push order")
        assert_equal(StringBuilder::new().push_char('q').build(), "q", reason="characters alone")
