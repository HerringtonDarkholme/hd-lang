# test: f32 is_nan and is_finite match the f64 methods
# Spec std/num Floating-Point Classification: std-num.is-nan, std-num.is-finite (issue #478).
tests:
    use std.testing.assert_equal

    it("is_nan"):
        let nan: f32 = 0.0 / 0.0
        let infinity: f32 = 1.0 / 0.0
        let one: f32 = 2.5
        let zero: f32 = -0.0
        assert_equal(nan.is_nan(), true, reason="NaN")
        assert_equal(f32::from_bits(4290772992).is_nan(), true, reason="a negative NaN")
        assert_equal(infinity.is_nan(), false, reason="infinity is not NaN")
        assert_equal(one.is_nan(), false, reason="an ordinary value")
        assert_equal(zero.is_nan(), false, reason="negative zero")

    it("is_finite"):
        let nan: f32 = 0.0 / 0.0
        let infinity: f32 = 1.0 / 0.0
        let one: f32 = 2.5
        let zero: f32 = -0.0
        largest := f32::from_bits(2139095039)
        assert_equal(one.is_finite(), true, reason="an ordinary value")
        assert_equal(zero.is_finite(), true, reason="negative zero")
        assert_equal(largest.is_finite(), true, reason="the largest finite value")
        assert_equal(nan.is_finite(), false, reason="NaN")
        assert_equal(infinity.is_finite(), false, reason="infinity")
        assert_equal((-infinity).is_finite(), false, reason="negative infinity")
