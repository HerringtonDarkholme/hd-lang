# test: a bare field read selects the field even when a trait method has the same name
use std.testing.assert_equal

trait Named:
    fn name(self) -> string

data User:
    name: string

impl Named for User:
    fn name(self) -> string:
        "user " + self.name

tests:
    it("field read and trait-qualified call"):
        user := User { name: "ada" }
        assert_equal(user.name, "ada", reason="bare access reads the field")
        assert_equal(Named::name(user), "user ada", reason="Trait::m selects the trait method")
