# test: cases from the JSONTestSuite (github.com/nst/JSONTestSuite) that RFC 8259 fixes, y_ files parse and n_ files fail
# Spec std/json Parsing: std-json.parse.grammar, std-json.parse.whitespace, std-json.parse.string.control, std-json.parse.end (JSON-SURFACE; task #226).
use std.json.{parse, Json}
tests:
    use std.testing.{assert, assert_equal}

    it("y_ files parse and print as the expected compact text"):
        cases := [
            ("y_array_empty", "[]", "[]"),
            ("y_array_ending_with_newline", "[\"a\"]\n", "[\"a\"]"),
            ("y_array_with_several_null", "[1,null,null,null,2]", "[1,null,null,null,2]"),
            ("y_array_with_leading_space", " [1]", "[1]"),
            ("y_array_with_trailing_space", "[2] ", "[2]"),
            ("y_object_empty", "{}", "{}"),
            ("y_object_basic", "{\"asd\":\"sdf\"}", "{\"asd\":\"sdf\"}"),
            ("y_object_extreme_numbers", "{ \"min\": -9223372036854775808, \"max\": 18446744073709551615 }", "{\"min\":-9223372036854775808,\"max\":18446744073709551615}"),
            ("y_object_long_strings", "{\"x\":[{\"id\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}], \"id\": \"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}", "{\"x\":[{\"id\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}],\"id\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}"),
            ("y_object_duplicated_key", "{\"a\":\"b\",\"a\":\"c\"}", "{\"a\":\"c\"}"),
            ("y_object_with_newlines", "{\n\"a\": \"b\"\n}", "{\"a\":\"b\"}"),
            ("y_number_negative_int", "[-123]", "[-123]"),
            ("y_number_simple_int", "[123]", "[123]"),
            ("y_number_after_space", "[ 4]", "[4]"),
            ("y_string_accepted_surrogate_pair", "[\"\\uD801\\udc37\"]", "[\"\u{10437}\"]"),
            ("y_string_double_escape_a", "[\"\\\\a\"]", "[\"\\\\a\"]"),
            ("y_string_escaped_control_character", "[\"\\u0012\"]", "[\"\\u0012\"]"),
            ("y_string_in_array_with_leading_space", "[ \"asd\"]", "[\"asd\"]"),
            ("y_string_nonCharacterInUTF-8_U+FFFF", "[\"\u{ffff}\"]", "[\"\u{ffff}\"]"),
            ("y_string_u+2028_line_sep", "[\"\u{2028}\"]", "[\"\u{2028}\"]"),
            ("y_string_unicode_U+10FFFE_nonchar", "[\"\\uDBFF\\uDFFE\"]", "[\"\u{10fffe}\"]"),
            ("y_string_uescaped_newline", "[\"new\\u000Aline\"]", "[\"new\\nline\"]"),
            ("y_string_unicode_escaped_double_quote", "[\"\\u0022\"]", "[\"\\\"\"]"),
            ("y_string_null_escape", "[\"\\u0000\"]", "[\"\\u0000\"]"),
            ("y_structure_lonely_int", "42", "42"),
            ("y_structure_lonely_true", "true", "true"),
            ("y_structure_lonely_null", "null", "null"),
            ("y_structure_lonely_string", "\"asd\"", "\"asd\""),
            ("y_structure_string_empty", "\"\"", "\"\""),
            ("y_structure_trailing_newline", "[\"a\"]\n", "[\"a\"]"),
            ("y_structure_whitespace_array", " [] ", "[]"),
        ]
        for case in cases:
            match parse(case._1):
                .Ok(value) => assert_equal("${value}", case._2, reason=case._0)
                .Err(_) => assert(false, reason="${case._0} should parse")

    it("n_ files fail"):
        cases := [
            ("n_array_comma_after_close", "[\"\"],"),
            ("n_array_comma_and_number", "[,1]"),
            ("n_array_double_comma", "[1,,2]"),
            ("n_array_extra_close", "[\"x\"]]"),
            ("n_array_extra_comma", "[\"\",]"),
            ("n_array_incomplete", "[\"x\""),
            ("n_array_inner_array_no_comma", "[3[4]]"),
            ("n_array_just_comma", "[,]"),
            ("n_array_missing_value", "[   , \"\"]"),
            ("n_array_unclosed", "[\"\""),
            ("n_array_colon_instead_of_comma", "[\"\": 1]"),
            ("n_incomplete_true", "[tru"),
            ("n_incomplete_null", "[nul"),
            ("n_incomplete_false", "[fals"),
            ("n_number_hex", "[0x1]"),
            ("n_number_plus", "[+1]"),
            ("n_number_leading_zero", "[012]"),
            ("n_number_minus_space", "[- 1]"),
            ("n_number_NaN", "[NaN]"),
            ("n_number_infinity", "[Infinity]"),
            ("n_number_minus_infinity", "[-Infinity]"),
            ("n_number_dot_without_digits", "[.5]"),
            ("n_number_with_alpha", "[1.2a-3]"),
            ("n_object_trailing_comma", "{\"id\":0,}"),
            ("n_object_unquoted_key", "{a:\"b\"}"),
            ("n_object_single_quote", "{'a':0}"),
            ("n_object_missing_colon", "{\"a\"}"),
            ("n_object_missing_value", "{\"a\":"),
            ("n_object_missing_key", "{:\"b\"}"),
            ("n_object_comma_instead_of_colon", "{\"x\", null}"),
            ("n_object_unterminated", "{\"a\":\"a"),
            ("n_object_with_trailing_garbage", "{\"a\":\"b\"}#"),
            ("n_string_single_quote", "['single quote']"),
            ("n_string_unescaped_tab", "[\"\t\"]"),
            ("n_string_unescaped_newline", "[\"new\nline\"]"),
            ("n_string_invalid_backslash_esc", "[\"\\a\"]"),
            ("n_string_escape_x", "[\"\\x00\"]"),
            ("n_string_incomplete_escape", "[\"\\\"]"),
            ("n_string_incomplete_surrogate", "[\"\\uD834\\uDd\"]"),
            ("n_string_1_surrogate_then_escape", "[\"\\uD800\\\"]"),
            ("n_string_invalid_unicode_escape", "[\"\\uqqqq\"]"),
            ("n_string_incomplete_escaped_character", "[\"\\u00A\"]"),
            ("n_string_accentuated_char_no_quotes", "[é]"),
            ("n_string_backslash_00", "[\"\\\u{0}\"]"),
            ("n_string_unclosed", "\"abc"),
            ("n_structure_no_data", ""),
            ("n_structure_only_whitespace", " \n\t"),
            ("n_structure_close_unopened_array", "1]"),
            ("n_structure_double_array", "[][]"),
            ("n_structure_unclosed_array", "[1"),
            ("n_structure_unclosed_object", "{\"asd\":\"asd\""),
            ("n_structure_comma_instead_of_closing_brace", "{\"x\": true,"),
            ("n_structure_whitespace_formfeed", "[\u{c}]"),
            ("n_structure_UTF8_BOM_no_data", "\u{feff}"),
            ("n_structure_number_with_trailing_garbage", "2@"),
            ("n_structure_array_trailing_garbage", "[1]x"),
            ("n_structure_object_followed_by_closing_object", "{}}"),
            ("n_structure_unicode-identifier", "å"),
            ("n_structure_capitalized_True", "[True]"),
            ("n_structure_open_array_object", "[{\"\":".repeat(5)),
        ]
        for case in cases:
            assert(parse(case._1).is_err(), reason="${case._0} should fail")
