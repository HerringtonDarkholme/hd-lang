# test: a loop that pushes each element of the list it walks ends after the old elements, doubling the list
# Spec 06 Snapshot Iteration: flow.for.snapshot, flow.for.snapshot.change.
fn doubled(values: List[i32]) -> List[i32]:
    let mut out = values
    for value in out:
        out.push(value) # the loop still ends after the old elements
    out

tests:
    use std.testing.assert_equal

    it("each old element once more"):
        assert_equal(
            doubled([+1, 2]),
            [+1, 2, 1, 2],
            reason="the loop visited the two old elements",
        )
