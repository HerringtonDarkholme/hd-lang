# test: lint never replaces an unsigned comparison or skips its operand
# Spec 05: expr.order.left-to-right, expr.ord.unsigned-zero.lint.

struct Counter:
    reads: usize

fn next(counter: &mut Counter) -> u32:
    counter.reads += 1
    7u32

tests:
    it("unsigned comparison operands run exactly once"):
        let mut counter = Counter { reads: 0 }
        assert_equal(next(&mut counter) >= 0, true, reason="greater or equal")
        assert_equal(0 <= next(&mut counter), true, reason="less or equal")
        assert_equal(next(&mut counter) < 0, false, reason="less")
        assert_equal(0 > next(&mut counter), false, reason="greater")
        assert_equal(counter.reads, 4, reason="each operand evaluated once")
