# fixture-runtime-profile: pending-tick
# expect-stdout: blocking
# expect-stdout: disposed
# test: a shielded cleanup await keeps its callable cold host slot beside an immediate blocking drive.
use std.ops.AsyncDisposable

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Flush:
    console: *mut dyn Console
    ticker: *mut dyn Tick

impl AsyncDisposable for Flush:
    fn dispose!(&mut self) -> void:
        let tick: fn!(string) -> void = self.ticker::tick
        tick!("disposed\n")
        _ := self.console.write_sync("disposed\n")

pub fn main!() -> void $ Console + Tick:
    println("blocking")
    using! flush = &mut Flush { console: $.use(Console), ticker: $.use(Tick) }
