# test: a `&mut dyn` trait value reference is built from `&mut` of a value whose type implements the trait
# Spec 04 Assignability And Coercion: types.assign.trait-value.ref.
trait Counter:
    fn count(&self) -> i32
    fn bump(&mut self) -> void

struct Clicks:
    value: i32

impl Counter for Clicks:
    fn count(&self) -> i32:
        self.value

    fn bump(&mut self) -> void:
        self.value = self.value + 1

fn bump_twice(counter: &mut dyn Counter) -> void:
    counter.bump()
    counter.bump()

tests:
    use std.testing.assert_equal

    it("the trait value mutates the shared value"):
        let mut clicks = Clicks { value: 0 }
        let edit: &mut dyn Counter = &mut clicks
        bump_twice(edit)
        assert_equal(clicks.value, 2, reason="mutation through the trait value")
