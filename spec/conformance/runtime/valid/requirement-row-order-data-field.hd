# test: one callable stored in Job[User, Post] and in Job[Post, User] reads each provider by its key
# Spec 11 Row Sets: req.row.set.order; the field row Repo[A] + Repo[B] is the same row for both argument orders.
use std.testing.assert_equal

trait Repo[T]:
    fn count(self) -> i32

data User: pass
data Post: pass
data UserRepo: pass
data PostRepo: pass

impl Repo[User] for UserRepo:
    fn count(self) -> i32: 20

impl Repo[Post] for PostRepo:
    fn count(self) -> i32: 1

data Job[A, B]:
    callback: fn() -> i32 $ Repo[A] + Repo[B]

fn activity() -> i32 $ Repo[User] + Repo[Post]:
    $.use(Repo[User]).count() * 10 + $.use(Repo[Post]).count()

tests:
    it("both field orders read Repo[User] as 20 and Repo[Post] as 1"):
        $.with(Repo[User]=UserRepo {}, Repo[Post]=PostRepo {}):
            let forward: Job[User, Post] = Job { callback: activity }
            let reverse: Job[Post, User] = Job { callback: activity }
            assert_equal((forward.callback)(), 201, reason="keys in declaration order")
            assert_equal((reverse.callback)(), 201, reason="keys in reverse order")
