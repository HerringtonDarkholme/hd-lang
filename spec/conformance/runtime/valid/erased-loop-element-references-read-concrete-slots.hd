# test: a generic method called through a trait value loops over its list, takes element references and changes a copy, at packed and counted element types
# Spec 06 Element Reference Loops: flow.for.list, flow.for.ref.read. Spec 13 Element References: ref.elem.place.
struct User:
    name: string

impl Display for User:
    fn to_string(&self) -> string:
        "user ${self.name}"

trait Collector:
    fn show_all[T < Display](self, xs: List[T]) -> string
    fn swap_first[T < Display](self, xs: List[T], extra: T) -> string

struct Simple:
    tag: string

impl Collector for Simple:
    fn show_all[T < Display](self, xs: List[T]) -> string:
        let s = self.tag
        for x in xs:
            s = s + x.to_string()
        let i: usize = 1
        while i < xs.len():
            x := &xs[i]
            s = s + "," + x.to_string()
            i += 1
        s

    fn swap_first[T < Display](self, xs: List[T], extra: T) -> string:
        let mut ys = xs
        ys[0] = extra
        ys.push(extra)
        "${ys[0]} ${ys[1]} ${ys.len()} ${xs[0]}"

fn run(c: &dyn Collector) -> List[string]:
    [
        c.show_all([+1, +2]),
        c.show_all([+1.5, 2.5, 3.5]),
        c.show_all([User { name: "a" }, User { name: "b" }]),
        c.swap_first([+1.5, 2.5], 9.5),
        c.swap_first([User { name: "a" }, User { name: "b" }], User { name: "z" }),
    ]

tests:
    use std.testing.assert_equal

    it("element references read the caller's concrete slots"):
        out := run(&Simple { tag: "s:" })
        assert_equal(out[0], "s:12,2", reason="packed i32 slots")
        assert_equal(out[1], "s:1.52.53.5,2.5,3.5", reason="f64 slots wider than an open value")
        assert_equal(out[2], "s:user auser b,user b", reason="counted struct slots")
        assert_equal(out[3], "9.5 2.5 3 1.5", reason="a change copies a shared list with its concrete layout")
        assert_equal(out[4], "user z user b 3 user a", reason="counted elements copy with their counts")
