# test: references held in an Option, tuple or struct loan only their field and end when the holding value is released
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
# expect-stdout: a 2 option
# expect-stdout: option 3 tuple
# expect-stdout: tuple 4 struct
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User

struct Held['a]:
    name: &'a string

fn option(t: &Team, alias: *mut User) -> string:
    let held: Option[&string] = .Some(&t.lead.name)
    alias.age += 1
    match held:
        .Some(value) => *value
        .None => ""

fn tuple(t: &Team, alias: *mut User) -> string:
    held := (&t.lead.name, +1)
    alias.age += 1
    *held._0

fn structure(t: &Team, alias: *mut User) -> string:
    held := Held { name: &t.lead.name }
    alias.age += 1
    *held.name

pub fn main() -> void $ Console:
    t := Team { lead: box(User { name: "a", age: +1 }) }
    alias := t.lead
    first := option(&t, alias)
    alias.name = "option"
    println("$first ${alias.age} ${alias.name}")
    second := tuple(&t, alias)
    alias.name = "tuple"
    println("$second ${alias.age} ${alias.name}")
    third := structure(&t, alias)
    alias.name = "struct"
    println("$third ${alias.age} ${alias.name}")
