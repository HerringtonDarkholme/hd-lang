# test: a loop over a call's or a literal's list borrows that temporary for the loop, and a map loop keeps its snapshot
# Spec 06 For Loops: flow.for.list.temporary, flow.for.snapshot.
# expect: test

fn numbers() -> List[i32]:
    [+1, +2, +3]

fn words() -> List[string]:
    ["first", "second"]

fn returned(values: List[i32]) -> List[i32]:
    values

fn shared(values: *mut List[i32]) -> *mut List[i32]:
    values

fn first_word() -> string:
    for word in words():
        return *word
    "missing"

fn nested_words() -> List[string]:
    let mut out: List[string] = []
    for left in ["a", "b"]:
        for right in ["x", "y"]:
            out.push(left + right)
    out

fn table() -> Map[string, i32]:
    { "a": +1, "b": +2 }

tests:
    use std.testing.assert_equal

    it("calls and literals supply the loop's own value"):
        let sum = +0
        for value in numbers():
            sum = sum + value
        for value in [+4, +5]:
            sum = sum + value
        assert_equal(sum, +15, reason="owned call and literal sources")
        let length = 0
        for word in words():
            length = length + word.len()
        assert_equal(length, 11, reason="counted items survive their reads")

    it("a returned copy stays independent of the caller's named list"):
        let mut source = numbers()
        let sum = +0
        for value in returned(source):
            source[1] = 99
            sum = sum + value
        assert_equal(sum, +6, reason="the returned value is independent")
        assert_equal(source[1], +99, reason="the original changes")

    it("a list reached through a returned reference is the place itself"):
        source := box(numbers())
        let sum = +0
        for value in shared(source):
            sum = sum + value
        assert_equal(sum, +6, reason="the loop reads the boxed list")

    it("owned sources survive nested loops, breaks and early returns"):
        assert_equal(first_word(), "first", reason="early return keeps its counted result")
        assert_equal(nested_words(), ["ax", "ay", "bx", "by"], reason="nested owner lifetimes")
        let seen = 0
        for word in words():
            seen = seen + word.len()
            break
        assert_equal(seen, 5, reason="a break finishes the owner")

    it("map temporaries obey the same ownership rule and named maps keep snapshots"):
        let total = +0
        for (_, value) in table():
            total = total + value
        assert_equal(total, +3, reason="returned map owner")
        let mut source = table()
        let original = +0
        for (key, value) in source:
            source[key] = +99
            original = original + value
        assert_equal(original, +3, reason="named map snapshot")
