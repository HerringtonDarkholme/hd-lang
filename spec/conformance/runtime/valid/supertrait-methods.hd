# test: supertraits require and expose parent implementations

use std.testing.assert_equal

trait Describe:
    fn describe(self) -> string

trait Formattable: Describe:
    fn format(self) -> string

data User:
    name: string

impl Describe for User:
    fn describe(self) -> string: self.name

impl Formattable for User:
    fn format(self) -> string: self.describe()

fn formatted_length() -> i32:
    User { name: "Alice" }.format().len()

fn parent_length[T: Formattable](value: T) -> i32:
    value.describe().len()

fn bounded_parent_length() -> i32:
    parent_length(User { name: "Alice" })

fn dynamic_parent(value: Formattable) -> i32:
    value.describe().len()

fn dynamic_parent_length() -> i32:
    let value: Formattable = User { name: "Alice" }
    dynamic_parent(value)

fn parent_dynamic(value: Describe) -> i32:
    value.describe().len()

fn widened_parent_length() -> i32:
    let value: Formattable = User { name: "Alice" }
    parent_dynamic(value)

test "formatted_length returns 5":
    assert_equal(formatted_length(), 5, reason="supertraits require and expose parent implementations")

test "bounded_parent_length returns 5":
    assert_equal(bounded_parent_length(), 5, reason="supertraits require and expose parent implementations")

test "dynamic_parent_length returns 5":
    assert_equal(dynamic_parent_length(), 5, reason="supertraits require and expose parent implementations")

test "widened_parent_length returns 5":
    assert_equal(widened_parent_length(), 5, reason="supertraits require and expose parent implementations")
