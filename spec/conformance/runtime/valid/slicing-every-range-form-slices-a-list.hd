# test: every range form slices a list
# expect-stdout: 20 30
# expect-stdout: 20 30 40
# expect-stdout: 30 40
# expect-stdout: 10 20
# expect-stdout: 10 20 30
# expect-stdout: 10 20 30 40
fn show(items: List[i32]) -> void $ Console:
    let line = ""
    for item in items:
        line = if line.len() == 0: "$item" else: "$line $item"
    println(line)

pub fn main() -> void $ Console:
    let items: List[i32] = [10, 20, 30, 40]
    show(items[1..3])
    show(items[1..=3])
    show(items[2..])
    show(items[..2])
    show(items[..=2])
    show(items[..])
