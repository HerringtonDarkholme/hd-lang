# test: an interpolation reaches the display impl
# Spec lang/10-modules.md: module.init.definite.implicit.
# expect-stdout: tag 5

struct Tag:
    n: i32

later := +5

impl Display for Tag:
    fn to_string(self) -> string:
        "tag ${later}"

first := "${Tag { n: 1 }}"

pub fn main() -> void $ Console:
    println(first)
