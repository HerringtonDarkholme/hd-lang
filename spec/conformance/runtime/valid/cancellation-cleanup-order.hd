# test: cancellation runs child cleanup before parent cleanup
# Spec 11 Cancellation: req.cancel.steps, req.cancel.sync-cleanup,
# req.cancel.cooperative, req.runtime.cancel-cleanup.
# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait

use std.ops.defer

let order = +0

fn wait!() -> void:
    pass

fn leaf!() -> void:
    defer(fn() -> void: order = order * 10 + 1)
    wait!()

fn middle!() -> void:
    defer(fn() -> void: order = order * 10 + 2)
    leaf!()

pub fn main!() -> void:
    defer(fn() -> void: order = order * 10 + 3)
    middle!()

pub fn cleanup_ran() -> bool:
    order == 123
