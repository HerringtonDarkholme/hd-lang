# test: cancellation runs child cleanup before parent cleanup
# Spec 11 Cancellation: req.cancel.synchronous, req.cancel.steps,
# req.cancel.defer, req.cancel.cooperative,
# req.cancel.hook-synchronous, req.runtime.cancel-cleanup.
# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait

let order = +0

fn wait!() -> void: pass

fn leaf!() -> void:
    defer:
        order = order * 10 + 1
    wait!()

fn middle!() -> void:
    defer:
        order = order * 10 + 2
    leaf!()

pub fn main!() -> void:
    defer:
        order = order * 10 + 3
    middle!()

pub fn cleanup_ran() -> bool:
    order == 123
