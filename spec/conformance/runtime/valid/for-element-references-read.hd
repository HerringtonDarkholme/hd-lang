# test: for p in &xs binds a read-only reference to each element in turn, which the body may pass to a call
# Spec 06 Element Reference Loops: flow.for.ref, flow.for.ref.binding.
fn read(value: &i32) -> i32:
    *value

tests:
    use std.testing.assert_equal

    it("the references read the elements in order"):
        values := [+4, 5, 6]
        let total = +0
        let mut seen: List[i32] = []
        for value in &values:
            total = total + *value
            seen.push(read(value))
        assert_equal(total, 15, reason="each element was read")
        assert_equal(seen, [+4, 5, 6], reason="each reference named its own slot")
