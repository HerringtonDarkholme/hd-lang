# test: contextual variant patterns
# Spec 08 Matching Enums: data.match.variant-patterns.

enum Flag:
    On(value: i32)
    Off

fn read(flag: Flag) -> i32:
    match flag:
        .On(value) => value
        .Off => 0

fn main() -> i32: read(Flag.On(42))

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="contextual variant patterns")
