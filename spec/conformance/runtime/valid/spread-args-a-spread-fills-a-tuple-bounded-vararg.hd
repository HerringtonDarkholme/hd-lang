# test: a spread fills a tuple bounded vararg
# expect-stdout: 4
# expect-stdout: a
# expect-stdout: 2b
# expect-stdout: 1a
use std.function.Tuple

fn pack[Args < Tuple](args...: Args) -> Args:
    args
fn label(parts...: (i32, string)) -> string:
    "${parts._0}${parts._1}"

pub fn main() -> void $ Console:
    pair := (+3, +4)
    packed := pack(pair...)
    println(packed._1)
    println(pack(1, "a")._1)
    one := (+2, "b")
    println(label(one...))
    println(label(1, "a"))
