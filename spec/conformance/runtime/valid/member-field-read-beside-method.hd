# test: value.name without an argument clause reads the field, even when a method of the same name exists
# Spec 05 Member Access: expr.member.field-read.
struct Timer:
    count: i32

impl Timer:
    fn count(self) -> i32:
        self.count * 10

tests:
    use std.testing.assert_equal

    it("reads the field"):
        timer := Timer { count: 3 }
        assert_equal(timer.count, 3, reason="no argument clause reads the field")
