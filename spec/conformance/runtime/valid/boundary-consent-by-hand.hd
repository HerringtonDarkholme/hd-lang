# test: a Serialize and a Deserialize written by hand are consent too, so a type with a private field crosses a host call both ways, as the same tree of fields
# Spec Modules, Private Fields At A Boundary: module.boundary.consent.out, module.boundary.consent.in, module.boundary.consent.tree.
# Spec 14 Serialization: annot.serde.by-hand, annot.serde.definition.
# fixture-runtime-profile: consent-vault
use std.serde.{Serialize, Serializer, Deserialize, Deserializer}
use std.testing.assert_equal

pub data Token:
    pub owner: string
    secret: i64

impl Serialize for Token:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        out.text(self.owner)

impl Deserialize for Token:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Token, R::Error]:
        .Ok(Token { owner: input.text("Token")?, secret: 0 })

pub trait Vault:
    fn keep(self, token: Token) -> Token

pub fn main() -> void $ Vault:
    kept := $.use(Vault).keep(Token { owner: "ada", secret: 42 })
    assert_equal(kept.owner, "ada", reason="the public field crosses")
    assert_equal(kept.secret, 42, reason="the consent changes no encoding: the private field crosses as a field")
