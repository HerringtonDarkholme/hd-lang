# Spec 06 Deferred Cleanup: flow.defer.register, flow.defer.run,
# flow.defer.result-saved, flow.defer.operands, flow.defer.captures,
# flow.defer.scopes, flow.defer.void.
use std.testing.assert_equal

data Trace:
    text: string

fn observed_value(trace: mut Trace) -> string:
    defer:
        trace.text = trace.text + "a"
    defer:
        trace.text = trace.text + "b"
    trace.text

tests:
    it("defer preserves the result and runs LIFO"):
        let mut trace = Trace { text: "start" }
        observed := observed_value(trace)
        assert_equal(observed, "start", reason="result is saved before cleanup")
        assert_equal(trace.text, "startba", reason="cleanup runs in LIFO order")
