# std Operations, Library Defer: std-ops.defer.cleanup,
# std-ops.defer.order, std-ops.defer.captures.
use std.ops.defer

struct Trace:
    text: string

fn observed_value(trace: &mut Trace) -> string:
    defer(fn() -> void: trace.text = trace.text + "a")
    defer(fn() -> void: trace.text = trace.text + "b")
    trace.text

tests:
    use std.testing.assert_equal

    it("defer preserves the result and runs LIFO"):
        let mut trace = &mut Trace { text: "start" }
        observed := observed_value(trace)
        assert_equal(observed, "start", reason="result is saved before cleanup")
        assert_equal(trace.text, "startba", reason="cleanup runs in LIFO order")
