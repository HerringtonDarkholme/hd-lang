# test: a recursive bang closure keeps its self value across pending calls
# Spec 07 Recursive Local Closures: fn.recursion.closure.ordinary-binding.
# Spec 11 Suspension: req.suspend.bang.point.
# fixture-runtime-profile: pending-tick
# expect-stdout: step 3
# expect-stdout: step 2
# expect-stdout: step 1
# expect-stdout: step 0
# expect-stdout: 13

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

pub fn main!() -> void $ Console + Tick:
    seed := +7
    sum := fn!(n: i32) -> i32 $ Console + Tick:
        $.use(Tick).tick!("step $n\n")
        _ := $.use(Console).write_sync("step $n\n")
        if n == 0: seed else: n + sum!(n - 1)
    println(sum!(+3))
