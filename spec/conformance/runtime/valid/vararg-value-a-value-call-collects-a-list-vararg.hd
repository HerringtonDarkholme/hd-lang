# test: a value call collects a list vararg
# expect-stdout: 100
# expect-stdout: 220
# expect-stdout: 340
# expect-stdout: 730
fn label(tag: i32, values...: List[i32]) -> i32: tag * 100 + i32(values.len()) * 10

fn apply(callback: fn(i32, List[i32]...) -> i32) -> i32:
    callback(7, 1, 2, 3)

pub fn main() -> void $ Console:
    f := label
    println(f(1))
    println(f(2, 5, 6))
    xs := [+4, 5, 6, 7]
    println(f(3, xs...))
    println(apply(label))
