# test: boxing a counted reference before erasing it dispatches Debug for the reference's referent
# Spec lang 09 Trait Value References: trait.dyn.ref.counted, trait.dyn.ref.counted.new,
# with std/format References: std-format.debug.reference-derived.
# expect-stdout: Point { x: 3, y: 4 }
# expect-stdout: Point { x: 3, y: 4 }
# expect-stdout: Point { x: 3, y: 4 }
@derive(Debug)
struct Point:
    x: i32
    y: i32

fn erase[T < Debug & 'static](value: T) -> *dyn Debug:
    box(value)

pub fn main() -> void $ Console:
    point := box(Point { x: 3, y: 4 })
    println(debug(erase(point)))
    let erased: *dyn Debug = box(point)
    println(debug(erased))
    println(debug(point))
