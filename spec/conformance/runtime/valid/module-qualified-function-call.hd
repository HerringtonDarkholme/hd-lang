# test: after use std.time, time.s(...) calls the function the module declares
# Spec Expressions, Names: expr.name.qualified; a qualified name selects a declaration through a module namespace.
use std.time

fn timeout(seconds: i64) -> time.Duration:
    time.s(seconds)

tests:
    use std.testing.assert_equal

    it("builds a timeout from seconds"):
        assert_equal(timeout(30), time.ms(30000), reason="thirty seconds are 30000 milliseconds")
