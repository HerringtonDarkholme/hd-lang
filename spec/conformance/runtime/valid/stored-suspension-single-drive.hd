# test: stored suspension single drive
# Spec 11 Suspension Values: req.suspend.cold, req.suspend.bang.point,
# req.suspend.type.plain-call, req.suspend.type.bang, req.drive.bang,
# req.drive.once, req.drive.not-method, req.value.cold, req.value.single,
# req.value.stateful.

use std.testing.assert_equal

fn ready!() -> i32: 42
fn main!() -> i32:
    let pending: mut Suspend[i32] = ready()
    pending!()

tests:
    it("main returns 42"):
        assert_equal(main!(), 42, reason="stored suspension single drive")
