# test: a key holding a `&mut` reference changes when the value it refers to is written, leaving a stale entry
# Spec 04 Mutated Keys: types.map.reference-key.
# expect-stdout: true
# expect-stdout: false 1
pub fn main() -> void $ Console:
    let mut level = +1
    let seen: mut Map[&mut i32, string] = {}
    seen[&mut level] = "one"
    println(seen.get(&mut level).is_some())
    level = 2
    println("${seen.get(&mut level).is_some()} ${seen.len()}")
