# test: a list can grow after the last use of a copy of an element reference that a callee kept
# Spec 13 Call-Scoped Access: ref.elem.callee-copy.
fn keep(target: *mut i32) -> *mut i32:
    target

tests:
    use std.testing.assert_equal

    it("a dead kept copy no longer pins the list"):
        let mut xs = [+1, 2]
        saved := keep(&mut xs[0])
        *saved = 10
        xs.push(3)
        assert_equal(xs, [+10, 2, 3], reason="the kept copy's last use is before the push")
