# test: optional injection and mutable local-reference payloads keep no count
# Rules: ref.convert.lend, ref.count.local.
use std.annotation.cold
use std.testing.assert_equal

@cold
fn read_optional(value: (&i32)?) -> i32:
    match value:
        .Some(item) => *item
        .None => -1

@cold
fn read_mutable_optional(value: (&mut i32)?) -> i32:
    match value:
        .Some(item) =>
            *item += 1
            *item
        .None => -1

@cold
fn outcome_injected(mutable: bool) -> void:
    owner := box(+7)
    if mutable:
        let call: fn((&mut i32)?) -> i32 = read_mutable_optional
        assert_equal(call(.Some(owner)), 8)
        assert_equal(*owner, 8, reason="a mutable payload still lends the caller's object")
    else:
        let call: fn((&i32)?) -> i32 = read_optional
        assert_equal(call(owner), 7)
        assert_equal(*owner, 7, reason="optional injection keeps the caller's owner")

pub fn main() -> void:
    for mutable in [false, true]:
        outcome_injected(mutable)
