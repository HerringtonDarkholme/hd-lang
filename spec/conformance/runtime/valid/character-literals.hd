# test: character literals carry Unicode scalar values and compare in scalar order

use std.testing.assert_equal

fn main() -> char:
    if 'A' < '界' and '😀' == '\u{1F600}':
        '😀'
    else:
        'x'

test "main returns '\u{1F600}'":
    assert_equal(main(), '\u{1F600}', reason="character literals carry Unicode scalar values and compare in scalar order")
