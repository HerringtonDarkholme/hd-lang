# test: a closure declared in cleanup propagates within its own function
# std Operations, Library Defer: std-ops.defer.cleanup.
use std.ops.defer

fn main() -> i32:
    defer(
        fn() -> void:
            inner := fn() -> Result[i32, string]:
                let answer: Result[i32, string] = .Err("failure")
                _ := answer?
                .Ok(0)
            _ := inner()
        ,
    )
    42

tests:
    use std.testing.assert_equal

    it("cleanup-local propagation completes the frame"):
        assert_equal(main(), 42, reason="the closure propagates inside its own function")
