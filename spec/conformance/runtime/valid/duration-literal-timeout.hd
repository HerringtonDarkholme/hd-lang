# test: sleep and timeout accept duration units without importing their functions
use std.time.{Clock, ManualClock, Timestamp, sleep}
use std.task.{TimedOut, timeout, apply}

tests:
    use std.testing.assert_equal

    it("sleep and timeout accept import-free units"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            result := apply!(timeout(10ms)):
                sleep!(2ms)
                let done: Result[usize, TimedOut] = .Ok(7)
                done
            assert_equal(result, .Ok(7), reason="manual time")
        assert_equal(clock.now().unix_milliseconds(), 2, reason="slept two milliseconds")
