# test: shared enum data initializes after its dependency and before main observes the completed trace
# Spec 08 Shared Enum Constructor Data: data.shared.module-init,
# data.shared.module-init.order, data.shared.module-init.effects.
# Spec 08 Shared Parameter Defaults: data.shared.default.eval-order.
# Spec 10 Initialization Order: module.init.cycle.once.
# fixture-package-tree: shared-enum-init/src/app.hd
use pkg.shipping.{Shipping}
use pkg.trace.{recorded}
use std.testing.assert_equal

fn main() -> List[string]:
    recorded()

tests:
    it("initializes shared data before main reads the trace"):
        assert_equal(main(), ["dependency", "base", "tax", "handling"], reason="dependency and shared data initialized before main")
        assert_equal(Shipping.Standard.base, 10, reason="the explicit argument initialized the variant")
        assert_equal(Shipping.Standard.tax, 5, reason="the first omitted default followed it")
        assert_equal(Shipping.Standard.handling, 2, reason="the second omitted default followed it")
        assert_equal(main(), ["dependency", "base", "tax", "handling"], reason="reads do not repeat initialization")
