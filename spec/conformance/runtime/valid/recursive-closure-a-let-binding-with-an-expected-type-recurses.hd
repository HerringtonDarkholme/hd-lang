# test: a let binding with an expected type recurses
# Spec lang/07-functions.md: fn.recursion.closure.ordinary-binding.
# expect-stdout: 45

fn total(limit: i32) -> i32:
    let sum: fn(i32) -> i32 = fn(n) -> i32:
        if n == 0:
            0
        else:
            n + sum(n - 1)
    sum(limit)

pub fn main() -> void $ Console:
    println(total(9))
