# test: pointer loans, adversarial: an argument of a `&mut self` call reads the receiver's object through an alias, as `xs.push(xs.len())` does; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Bag:
    items: List[usize]

fn probe(p: *mut Bag, alias: *Bag) -> usize:
    p.items.push(alias.items.len())
    p.items[1]

pub fn main() -> void $ Console:
    p := box(Bag { items: [+0usize] })
    if probe(p, p) != 1:
        panic("the push read the wrong length")
    println("ok")
