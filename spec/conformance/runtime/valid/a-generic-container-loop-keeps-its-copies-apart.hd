# test: a generic container's loop compares and changes its list, and a copy taken before it keeps its values
# Spec 04 Collection Values: types.coll.value.
# expect-stdout: 1 9 3 | 9 1 3 | a c b | c a b | 7 8 | 9 8 | 1 2 3 | 2 3 1

struct Queue[T < Ord]:
    items: List[T]

impl[T < Ord] Queue[T]:
    # Moves `value` down from the top: the loop compares through shared
    # element references, then writes one element each round.
    fn settle(&mut self, value: T) -> void:
        size := self.items.len()
        let parent: usize = 0
        while parent < size / 2:
            left := 2 * parent + 1
            let larger = left
            if left + 1 < size:
                match self.items[left].cmp(&self.items[left + 1]):
                    .Less => larger = left + 1
                    _ => pass
            match value.cmp(&self.items[larger]):
                .Less => pass
                _ => break
            self.items[parent] = self.items[larger]
            parent = larger
        self.items[parent] = value

    # Each round reads an element through a binding, across a store to
    # another element, which the binding must not see as a copy.
    fn swap_up(&mut self) -> void:
        let i: usize = 0
        while i + 1 < self.items.len():
            first := &self.items[i]
            kept := *first
            self.items[i] = self.items[i + 1]
            self.items[i + 1] = kept
            i += 1

fn show(xs: &List[i64]) -> string:
    let out = ""
    for x in xs:
        if out != "":
            out = out + " "
        out = out + "$x"
    out

fn show_names(xs: &List[string]) -> string:
    let out = ""
    for x in xs:
        if out != "":
            out = out + " "
        out = out + x
    out

pub fn main() -> void $ Console:
    let mut q: Queue[i64] = Queue { items: [1, 9, 3] }
    saved := q
    q.settle(1)
    let mut names: Queue[string] = Queue { items: ["a", "c", "b"] }
    kept := names
    names.settle("a")
    let mut pair: Queue[i64] = Queue { items: [7, 8] }
    both := pair
    pair.settle(9)
    let mut row: Queue[i64] = Queue { items: [1, 2, 3] }
    before := row
    row.swap_up()
    println("${show(&saved.items)} | ${show(&q.items)} | ${show_names(&kept.items)} | ${show_names(&names.items)} | ${show(&both.items)} | ${show(&pair.items)} | ${show(&before.items)} | ${show(&row.items)}")
