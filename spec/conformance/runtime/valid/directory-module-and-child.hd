# test: src/user/mod.hd is the module user, and src/user/types.hd is its child user.types, which a use names on its own
# Spec 10 Path-Inferred Modules: module.path.name, module.path.no-declaration; Directory Modules:
# module.path.directory, module.path.mod-file.
# fixture-package-tree: user-modules/src/report.hd
use pkg.user
use pkg.user.types
use std.testing.assert_equal

fn welcome(owner: types.User) -> string:
    user.greeting(owner.name)

tests:
    it("reaches the directory module and its child"):
        assert_equal(welcome(types.User { name: "Ada" }), "hello, Ada", reason="user and user.types are two modules")
