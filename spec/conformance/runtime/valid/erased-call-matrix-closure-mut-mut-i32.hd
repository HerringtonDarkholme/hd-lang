# test: erased call matrix closure-mut-mut-i32
# expect: test
# Generated by spec/tools/generate-erased-call-matrix.ts; edit the generator.
# Rules: trait.dyn.safe.method-type-param, ref.generic.local.
impl Item for i32:
    fn value(&self) -> usize:
        usize(*self)
    fn bump(&mut self) -> void:
        *self = *self + 1

fn make(round: usize) -> i32:
    i32(round + 7)

trait Item < ?Copy:
    fn value(&self) -> usize
    fn bump(&mut self) -> void

trait Driver:
    fn run[T < ?Copy & Item](&mut self, value: &mut T) -> usize

struct Worker:
    calls: usize

impl Driver for Worker:
    fn run[T < ?Copy & Item](&mut self, value: &mut T) -> usize:
        self.calls += 1
        apply := fn(value: &mut T) -> usize:
            value.bump()
            value.value()
        apply(value)

tests:
    it("closure-mut-mut-i32 preserves its argument and receiver"):
        for round in 0..8:
            let mut worker = Worker { calls: 0 }
            let mut item: i32 = make(round)
            before := item.value()
            let driver: &mut dyn Driver = &mut worker
            result := driver.run(&mut item)
            assert_equal(result, before + 1, reason="the erased call returns the value")
            assert_equal(item.value(), before + 1, reason="the caller observes the borrow")
            assert_equal(worker.calls, 1, reason="receiver effects reach the caller")
