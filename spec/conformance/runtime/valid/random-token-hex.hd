# test: token_hex returns the covering provider's fill bytes as lowercase hex text, two digits per byte
# Spec std/random Random Source: std-random.token-hex (stdlib audit design finding 14).
use std.random.{Random, token_hex}

data FixedBytes:
    bytes: List[u8]

impl Random for FixedBytes:
    fn next_u64(mut self) -> u64:
        0
    fn fill(mut self, count: usize) -> List[u8]:
        let out: mut List[u8] = []
        for index in 0..count:
            out.push(self.bytes[index])
        out

fn session() -> string $ Random:
    token_hex(4)

tests:
    use std.testing.assert_equal

    it("token_hex is the lowercase hex of fill"):
        let mut source = FixedBytes { bytes: [0, 15, 171, 255] }
        let made = ""
        $.with(Random=source):
            made = session()
        assert_equal(made, "000fabff", reason="two lowercase digits per byte")

    it("the count is the number of bytes"):
        let mut source = FixedBytes { bytes: [1, 2, 3, 4, 5, 6] }
        let made = ""
        $.with(Random=source):
            made = token_hex(6)
        assert_equal(made, "010203040506", reason="six bytes, twelve digits")
        let none = ""
        $.with(Random=source):
            none = token_hex(0)
        assert_equal(none, "", reason="no bytes, no digits")
