# test: MemoryFs reads back what it wrote, reports a missing file as NotFound, and covers FsRead and FsWrite rows through $.with
# Spec std/fs Memory File System: std-fs.memory.new-ref, std-fs.memory.normalized-keys, and std-fs.memory.error.not-found (STDLIB decision 4, PROVIDER-SHAPES; task #220).
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, read_text, write_text}
use std.path.Path
fn copy_notes!() -> Result[void, FsError] $ FsRead + FsWrite:
    text := read_text!(Path("notes.txt"))?
    write_text!(Path("notes.bak"), text)

fn read_error!(files: &MemoryFs, path: Path) -> FsError?:
    match files.read_text!(path):
        .Ok(_) => .None
        .Err(error) => .Some(error)

tests:
    use std.testing.{assert, assert_equal}

    it("copies in memory"):
        let mut files = MemoryFs::new()
        assert(files.write_text!(Path("notes.txt"), "tea").is_ok(), reason="seeded")
        $.with(FsRead=files, FsWrite=files):
            assert(copy_notes!().is_ok(), reason="copied")
        assert(files.read_text!(Path("notes.bak")).unwrap_or("") == "tea", reason="the copy")

    it("reads back what it wrote"):
        let mut files = MemoryFs::new()
        assert(files.write_bytes!(Path("data.bin"), [104, 105]).is_ok(), reason="bytes written")
        assert(files.read_text!(Path("data.bin")).unwrap_or("") == "hi", reason="read back as text")
        assert(files.append_text!(Path("data.bin"), "!").is_ok(), reason="appended")
        assert(
            files.read_text!(Path("data.bin")).unwrap_or("") == "hi!",
            reason="the appended text",
        )

    it("reports a missing file"):
        let mut files = MemoryFs::new()
        assert(files.write_text!(Path("a.txt"), "x").is_ok(), reason="seeded")
        missing := Path("./missing.txt")
        match read_error!(files, missing):
            .Some(error) =>
                assert(error == FsError.NotFound(path=missing), reason="the supplied missing path")
            .None => assert(false, reason="the file is missing")

    it("appends preserve earlier byte snapshots and copied file systems"):
        files := MemoryFs::new()
        _ := files.write_bytes!(Path("file"), [65, 66])
        bytes := files.read_bytes!(Path("file")).expect("read")
        let mut snapshot = *files
        _ := files.append_text!(Path("./file"), "C")
        assert_equal(bytes, [65, 66], reason="previous read is a value snapshot")
        assert_equal(
            snapshot.read_text!(Path("file")),
            .Ok("AB"),
            reason="copied file system is independent",
        )
        _ := snapshot.append_text!(Path("file"), "D")
        assert_equal(
            files.read_text!(Path("file")),
            .Ok("ABC"),
            reason="original grows independently",
        )
        assert_equal(
            snapshot.read_text!(Path("file")),
            .Ok("ABD"),
            reason="copied file system grows independently",
        )

    it("appends preserve copied files and renamed bytes"):
        files := MemoryFs::new()
        _ := files.write_bytes!(Path("source"), [0, 255])
        _ := files.copy!(Path("source"), Path("copy"))
        _ := files.append_text!(Path("source"), "λ")
        assert_equal(
            files.read_bytes!(Path("source")),
            .Ok([0, 255, 206, 187]),
            reason="arbitrary prefix and UTF-8 suffix",
        )
        assert_equal(
            files.read_bytes!(Path("copy")),
            .Ok([0, 255]),
            reason="copied bytes are independent",
        )
        _ := files.rename!(Path("source"), Path("renamed"))
        _ := files.append_text!(Path("renamed"), "!")
        assert_equal(
            files.read_bytes!(Path("renamed")),
            .Ok([0, 255, 206, 187, 33]),
            reason="append after rename",
        )

    it("repeated appends keep normalized paths and empty writes"):
        files := MemoryFs::new()
        let index: usize = 0
        while index < 128:
            _ := files.append_text!(Path("dir//./file"), "λ")
            index += 1
        _ := files.append_text!(Path("dir/file"), "")
        assert_equal(
            files.read_text!(Path("./dir/file")),
            .Ok("λ".repeat(128)),
            reason="same normalized file",
        )
        _ := files.append_text!(Path("empty"), "")
        assert_equal(
            files.read_bytes!(Path("empty")),
            .Ok([]),
            reason="empty append creates an empty file",
        )
