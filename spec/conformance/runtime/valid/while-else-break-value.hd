# test: while else break value
# Spec 06 Loop Values: flow.loop.else.value,
# flow.loop.else.break-value, flow.loop.else.type,
# flow.loop.else.skipped.

use std.ops.defer

fn main() -> i32:
    let cleanup = +0
    value := while true:
        defer(fn() -> void: cleanup = cleanup + 1)
        break 41
    else:
        +0
    value + cleanup

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="while else break value")
