# test: a drop reaches an enum's payloads, an optional's payload, a tuple's elements, a list's elements, a map's values and a generic type's owned field
# expect-stdout: parts end
# expect-stdout: closed boxed
# expect-stdout: closed map-a
# expect-stdout: closed map-b
# expect-stdout: closed list-1
# expect-stdout: closed list-2
# expect-stdout: closed tuple-1
# expect-stdout: closed tuple-2
# expect-stdout: closed some
# expect-stdout: closed two-a
# expect-stdout: closed two-b
# expect-stdout: closed one
# Spec 13 Drops: own.drop.parts, own.drop.elements, own.drop.nothing.
let log: mut List[string] = []

data File:
    name: string

impl OwnOnly for File

impl DropOwn for File:
    fn drop(^mut self) -> void:
        log.push("closed ${self.name}")

fn open(name: string) -> own File: File { name: name }

enum Slot:
    Empty
    One(file: own File)
    Two(a: own File, label: string, b: own File)

impl OwnOnly for Slot

@derive(OwnOnly)
data Box[T]:
    item: T

fn parts() -> void:
    let own _empty = Slot.Empty
    let own _one = Slot.One(open("one"))
    let own _two = Slot.Two(open("two-a"), "label", open("two-b"))
    let _some: own File? = .Some(open("some"))
    let _none: own File? = .None
    _tuple := (open("tuple-1"), 3, open("tuple-2"))
    let own _list: List[own File] = [open("list-1"), open("list-2")]
    let own _map: Map[string, own File] = {"a": open("map-a"), "b": open("map-b")}
    let own _boxed: Box[own File] = Box { item: open("boxed") }
    log.push("parts end")

pub fn main() -> void $ Console:
    parts()
    for line in log:
        println(line)
