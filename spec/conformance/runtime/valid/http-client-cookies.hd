# test: Client stores host-only cookies from each response and enforces Secure and deletion
# Spec std/http Client: std-http.client.cookie, std-http.client.cookies, std-http.client.cookies.host-only, std-http.client.cookies.secure, std-http.client.cookies.delete.
use std.http.{Client, Http, Request, Response, ScriptedHttp}

fn header(request: Request, name: string) -> string?:
    Response { status: 200, headers: request.headers }.header(name)

tests:
    use std.testing.assert_equal

    it("a login cookie is visible and sent on the redirect and next request"):
        http := ScriptedHttp::new()
        http.reply("https://api.example/login", .Ok(Response { status: 302, headers: [("Set-Cookie", "csrftoken=abc; Domain=other.example"), ("Location", "/home")] }))
        http.reply("https://api.example/home", .Ok(Response { status: 200 }))
        client := Client::new().base_url("https://api.example")
        $.with(Http=http):
            assert_equal(client.send!(Request { url: "/login" }).expect("login").url, "https://api.example/home", reason="client followed the redirect")
            assert_equal(client.cookie("/login", "csrftoken"), .Some("abc"), reason="lookup resolves against the base URL")
            _ := client.send!(Request { url: "/home" }).expect("next request")
        received := http.received()
        assert_equal(header(received[0], "Cookie"), .None, reason="jar starts empty")
        assert_equal(header(received[1], "Cookie"), .Some("csrftoken=abc"), reason="redirect receives newly stored cookie")
        assert_equal(header(received[2], "Cookie"), .Some("csrftoken=abc"), reason="jar survives subsequent sends")
        assert_equal(received.map(fn(request: Request) -> usize: request.redirects), [0, 0, 0], reason="provider never follows redirects")
        assert_equal(client.cookie("https://other.example/login", "csrftoken"), .None, reason="Domain did not widen the host")
        assert_equal(client.cookie("https://sub.api.example/login", "csrftoken"), .None, reason="subdomains are different hosts")

    it("Secure cookies stay on HTTPS and host spelling is case insensitive"):
        http := ScriptedHttp::new()
        http.reply("https://API.example/set", .Ok(Response { status: 200, headers: [("sEt-CoOkIe", "secret=yes; sEcUrE"), ("Set-Cookie", "plain=ok")] }))
        http.reply("http://api.example/next", .Ok(Response { status: 200 }))
        http.reply("https://api.example/next", .Ok(Response { status: 200 }))
        client := Client::new()
        $.with(Http=http):
            _ := client.send!(Request { url: "https://API.example/set" }).expect("set")
            _ := client.send!(Request { url: "http://api.example/next" }).expect("http")
            _ := client.send!(Request { url: "https://api.example/next" }).expect("https")
        assert_equal(client.cookie("http://api.example/", "secret"), .None, reason="Secure is not eligible on HTTP")
        assert_equal(client.cookie("https://api.example/", "secret"), .Some("yes"), reason="Secure is eligible on HTTPS")
        assert_equal(header(http.received()[1], "Cookie"), .Some("plain=ok"), reason="only non-secure cookie on HTTP")
        assert_equal(header(http.received()[2], "Cookie"), .Some("secret=yes; plain=ok"), reason="both cookies on HTTPS")

    it("same-name updates replace and Max-Age zero deletes"):
        http := ScriptedHttp::new()
        http.reply("https://api.example/", .Ok(Response { status: 200, headers: [("Set-Cookie", "token=one"), ("Set-Cookie", "token=two")] }))
        http.reply("https://api.example/", .Ok(Response { status: 200, headers: [("Set-Cookie", "token=gone; mAx-AgE=0")] }))
        http.reply("https://api.example/", .Ok(Response { status: 200 }))
        client := Client::new()
        $.with(Http=http):
            _ := client.send!(Request { url: "https://api.example/" }).expect("set")
            assert_equal(client.cookie("https://api.example/", "token"), .Some("two"), reason="latest value")
            _ := client.send!(Request { url: "https://api.example/" }).expect("delete")
            assert_equal(client.cookie("https://api.example/", "token"), .None, reason="deleted")
            _ := client.send!(Request { url: "https://api.example/" }).expect("after deletion")
        assert_equal(header(http.received()[1], "Cookie"), .Some("token=two"), reason="only latest cookie sent")
        assert_equal(header(http.received()[2], "Cookie"), .None, reason="deleted cookie is not sent")

    it("an explicit Cookie header overrides the jar for that request"):
        http := ScriptedHttp::new()
        http.reply("https://api.example/", .Ok(Response { status: 200, headers: [("Set-Cookie", "token=jar")] }))
        http.reply("https://api.example/", .Ok(Response { status: 200 }))
        client := Client::new()
        $.with(Http=http):
            _ := client.send!(Request { url: "https://api.example/" }).expect("set")
            _ := client.send!(Request { url: "https://api.example/", headers: [("cOoKiE", "token=manual")] }).expect("manual")
        assert_equal(header(http.received()[1], "Cookie"), .Some("token=manual"), reason="explicit request header wins")
        assert_equal(client.cookie("https://api.example/", "token"), .Some("jar"), reason="explicit header does not replace stored value")
