# test: after use std.time, time.s is a function value that can be passed as an argument
# Spec Expressions, Names: expr.name.qualified; the qualified name selects the declaration s, which is a value.
use std.time

fn durations(counts: List[i64], make: fn(i64) -> time.Duration) -> List[time.Duration]:
    let mut result: List[time.Duration] = []
    for count in counts:
        result.push(make(count))
    result

tests:
    use std.testing.assert_equal

    it("makes a duration per count"):
        found := durations([1, 2], time.s)
        assert_equal(found, [time.ms(1000), time.ms(2000)], reason="each count is in seconds")
