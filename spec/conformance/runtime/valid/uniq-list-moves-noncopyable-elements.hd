# test: a UniqList grows, shifts, swaps, truncates, and returns non-copyable elements without copying them
# expect: test
# Spec std/collections UniqList: std-collections.uniq-list.type, std-collections.uniq-list.movers, std-collections.uniq-list.get-ref, std-collections.uniq-list.sort.
use std.collections.UniqList
use std.console.MemoryConsole
use std.hash.hash_of
use std.iter.Iterable

struct Ticket:
    label: string

impl !Copy for Ticket

fn take_last(items: &mut UniqList[Ticket]) -> Ticket:
    match items.pop():
        .Some(ticket) => ticket
        .None => panic("expected a ticket")

fn open_labels() -> List[string]:
    let mut items = UniqList::[Ticket].new()
    items.push(Ticket { label: "open" })
    items.push(Ticket { label: "" })
    items.push(Ticket { label: "ready" })
    let kept: UniqList[_] = Iterable::[Ticket]::iter(items)
        .filter(fn(item: &Ticket) -> bool: item.label.len() > 0)
        .collect()
    let mut labels: List[string] = []
    for item in kept:
        labels.push(item.label)
    labels

tests:
    use std.testing.assert_equal

    it("moves non-copyable elements through every core mutation"):
        console := MemoryConsole::new()
        let mut items = UniqList::[Ticket].with_capacity(1)
        assert_equal(items.is_empty(), true, reason="the new list is empty")
        items.push(Ticket { label: "a" })
        items.push(Ticket { label: "c" })
        items.insert(1, Ticket { label: "b" })
        items.swap(0, 2)
        first := items.remove_at(0)
        $.with(Console=console):
            println(first.label)
        assert_equal(first.label, "c", reason="remove_at returns the moved element")
        last := take_last(&mut items)
        $.with(Console=console):
            println(last.label)
        assert_equal(last.label, "a", reason="pop returns the moved last element")
        items.push(Ticket { label: "d" })
        items.push(Ticket { label: "e" })
        items.truncate(1)
        only := take_last(&mut items)
        $.with(Console=console):
            println(only.label)
        assert_equal(only.label, "b", reason="truncate keeps the prefix")
        assert_equal(
            console.output(),
            ["c", "\n", "a", "\n", "b", "\n"],
            reason="each moved element prints in the order it leaves the list",
        )
        items.push(Ticket { label: "z" })
        items.clear()
        assert_equal(items.len(), 0, reason="clear drops every element")

    it("copies access results only for copyable elements"):
        let mut values = UniqList::[i32].new()
        values.push(+1)
        values.push(2)
        assert_equal(values.get(1), .Some(2), reason="get copies the indexed value")
        assert_equal(values.first(), .Some(+1), reason="first copies the first value")
        assert_equal(values.last(), .Some(2), reason="last copies the last value")
        assert_equal(values.get(2), .None, reason="get outside the list returns none")

    it("lends non-copyable elements and changes them in place"):
        let mut items = UniqList::[Ticket].new()
        items.push(Ticket { label: "pear" })
        items.push(Ticket { label: "fig" })
        items.push(Ticket { label: "plum" })
        match items.get_mut(0):
            .Some(item) => item.label = "kiwi"
            .None => panic("expected the first ticket")
        assert_equal(
            items.get_ref(0).map(fn(item: &Ticket) -> string: item.label),
            .Some("kiwi"),
            reason="get_mut changes the item that get_ref reads",
        )
        match items.first_mut():
            .Some(item) => item.label = "lime"
            .None => panic("expected the first ticket")
        match items.last_mut():
            .Some(item) => item.label = "date"
            .None => panic("expected the last ticket")
        assert_equal(
            items.first_ref().map(fn(item: &Ticket) -> string: item.label),
            .Some("lime"),
            reason="first_mut changes the item that first_ref lends",
        )
        assert_equal(
            items.last_ref().map(fn(item: &Ticket) -> string: item.label),
            .Some("date"),
            reason="last_mut changes the item that last_ref lends",
        )
        assert_equal(
            items.find_ref(fn(item: &Ticket) -> bool: item.label == "fig")
                .map(fn(item: &Ticket) -> string: item.label),
            .Some("fig"),
            reason="find_ref lends the first matching item",
        )
        assert_equal(
            items.any(fn(item: &Ticket) -> bool: item.label == "date"),
            true,
            reason="any finds a matching item",
        )
        assert_equal(
            items.all(fn(item: &Ticket) -> bool: item.label.len() >= 3),
            true,
            reason="all checks every item",
        )
        let visited: usize = 0
        for item in items.iter():
            assert(item.label.len() >= 3, "iter lends each item")
            visited += 1
        assert_equal(visited, 3, reason="iter visits every item")
        items.retain(fn(item: &Ticket) -> bool: item.label != "fig")
        items.sort_by(fn(left: &Ticket, right: &Ticket) -> Ordering: right.label.cmp(&left.label))
        items.sort_by_key(fn(item: &Ticket) -> usize: item.label.len())
        assert_equal(
            items.first_ref().map(fn(item: &Ticket) -> string: item.label),
            .Some("lime"),
            reason="retain and the stable sorts keep the expected first item",
        )

    it("sorts and indexes copyable elements"):
        let mut values = UniqList::[i32].new()
        values.push(3)
        values.push(+1)
        values.push(2)
        values.sort()
        assert_equal(values[0], +1, reason="indexing copies the sorted item")

    it("consumes, filters, and collects non-copyable elements"):
        assert_equal(open_labels(), ["open", "ready"], reason="the cursor moves matching items")

    it("converts and implements the value-looking traits"):
        values := UniqList::[i32]::from_list([+1, 2, 3])
        same := UniqList::[i32]::from_list([+1, 2, 3])
        assert_equal(values.to_list(), [+1, 2, 3], reason="to_list copies in order")
        assert(values == same, "Eq compares elements in order")
        assert_equal(debug(&values), "[1, 2, 3]", reason="Debug uses list syntax")
        assert_equal(hash_of(&values), hash_of(&same), reason="equal unique lists hash equally")
