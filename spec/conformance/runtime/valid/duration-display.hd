# test: a Duration displays as its count in the largest suffix unit that divides it exactly
# Spec std/time Duration Display: std-time.duration.display, std-time.duration.display.zero, std-time.duration.display.negative (DURATION-OPS; task #221).
use std.testing.assert_equal
use std.time.{Duration, h, min, ms, s}

tests:
    it("uses the largest exact unit"):
        assert_equal((1500ms).to_string(), "1500ms", reason="not a whole second")
        assert_equal((2000ms).to_string(), "2s", reason="whole seconds")
        assert_equal((300s).to_string(), "5min", reason="whole minutes")
        assert_equal((60min).to_string(), "1h", reason="whole hours")
        assert_equal((90min).to_string(), "90min", reason="not a whole hour")

    it("zero and negative durations"):
        assert_equal((0s).to_string(), "0ms", reason="zero is 0ms")
        assert_equal((-(90s)).to_string(), "-90s", reason="a leading minus")
        assert_equal("waited ${2h}", "waited 2h", reason="interpolation uses Display")
