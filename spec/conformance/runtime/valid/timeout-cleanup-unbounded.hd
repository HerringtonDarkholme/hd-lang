# expect-stdout: timed out after 5s
# expect-stdout: closing, acknowledged, closed
# expect-stdout: TimedOut { limit: 5s, cleanup: CleanupEnd.Finished }
# test: without cleanup, timeout! waits for the whole cleanup of the cancelled work, and TimedOut.cleanup is .Finished
# Spec std/task: std-task.policy.time-limit.cleanup-unbounded, std-task.timeout.cleanup-end, std-task.timeout.fields-value.
use std.ops.AsyncDisposable
use std.task.{TimedOut, timeout, apply}
use std.time.{Clock, ManualClock, Timestamp, ms, s, sleep}

struct Close:
    log: *mut List[string]
    ack: mut Suspend[void]

impl AsyncDisposable for Close:
    fn dispose!(&mut self) -> void:
        defer:
            self.log.push("closed")
        self.log.push("closing")
        let mut ack = self.ack
        ack!()
        self.log.push("acknowledged")

# The reply and the acknowledgement wait on the host's clock: the reply
# outlasts the manual limit, and the acknowledgement comes after it.
fn silent!() -> void $ Clock:
    sleep!(60s)

pub fn main!() -> void $ Console + Clock:
    log := box::[List[string]]([])
    let reply: mut Suspend[void] = silent()
    let ack: mut Suspend[void] = sleep(ms(30))
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Clock=clock):
        result := apply!(timeout(5s)):
            using! close = &mut Close { log: log, ack: ack }
            let done: Result[void, TimedOut] = .Ok(reply!())
            done
        match result:
            .Ok(_) => println("in time")
            .Err(error) =>
                println(error.to_string())
                println(log.join(", "))
                println(debug(error))
