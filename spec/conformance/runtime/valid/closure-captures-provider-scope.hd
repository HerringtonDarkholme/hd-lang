# test: closures / provider captures

fn make_reader() -> (fn() -> i32) $ Backup:
    $.with(Clock=$.use(Backup)):
        clock := $.use(Clock)
        fn() -> i32:
            _ := clock
            42

fn run() -> i32 $ Backup:
    reader := make_reader()
    reader()

trait Clock

trait Backup < Clock:
    fn label(self) -> i32

data FixedBackup: pass

impl Clock for FixedBackup

impl Backup for FixedBackup:
    fn label(self) -> i32: 0

tests:
    use std.testing.assert_equal

    it("run returns 42 with its providers"):
        $.with(Backup=FixedBackup {}):
            assert_equal(run(), 42, reason="closures / provider captures")
