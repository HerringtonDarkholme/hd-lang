# test: += on a list element reads the element, then stores p + e back
# Spec 05 Compound Assignment: expr.assign.compound.index-read-write (Operator Traits OP13, stress test decision 11).
use std.ops.Add
data Score:
    points: i64

impl Add[Score] for Score:
    type Out = Score
    fn add(self, rhs: Score) -> Score:
        Score { points: self.points + rhs.points }

fn bump(counts: mut List[i32], scores: mut List[Score]) -> (i32, i64):
    first := scores[0]
    counts[1] += 5
    scores[0] += Score { points: 10 }
    (counts[1], scores[0].points + first.points)

tests:
    use std.testing.assert_equal

    it("reads and stores each element"):
        assert_equal(bump([1, 2], [Score { points: 1 }]), (7, 12), reason="2 + 5, and 11 + the old 1")
