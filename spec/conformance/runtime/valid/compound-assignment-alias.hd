# test: += on a data place stores a new value, so another reference keeps the old one
# Spec 05 Compound Assignment: expr.assign.compound.fresh-value (Operator Traits OP13).
use std.ops.Add
use std.testing.assert_equal

data Score:
    points: i64

impl Add[Score] for Score:
    type Out = Score
    fn add(self, rhs: Score) -> Score:
        Score { points: self.points + rhs.points }

fn alias() -> (i64, i64):
    let a = Score { points: 1 }  # readonly Score, so += rebinds a
    b := a
    a += Score { points: 2 }
    (a.points, b.points)

tests:
    it("replaces the value in the place"):
        assert_equal(alias(), (3, 1), reason="a holds the sum, b keeps the old Score")
