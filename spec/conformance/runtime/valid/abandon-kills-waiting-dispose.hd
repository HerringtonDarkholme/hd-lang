# expect-stdout: won waited stopped
# expect-stdout: closing, abandon, conn defer, session defer, abandon returned, waiter abandoned
# expect-stdout: later abandoned
# test: abandon() of a job whose dispose! waits kills the dispose at its wait after its own defer, runs the outer defer, and every waiting and later cancel!() returns .Abandoned
# Spec lang/11 Abandoning: req.abandon.dispose, req.abandon.host, req.abandon.result; std/task Cleanup End: std-task.cleanup-end.cut-short.
use std.ops.Disposable
use std.task.{all, race}
use std.time.{Clock, s, sleep}

struct Conn:
    log: *mut List[string]
    closing: mut Suspend[void]

impl Disposable for Conn:
    fn dispose!(&mut self) -> void:
        defer: self.log.push("conn defer")
        self.log.push("closing")
        let mut wait = self.closing
        wait!()
        self.log.push("closed")

fn session!(log: *mut List[string]) -> string $ Clock:
    defer: log.push("session defer")
    using conn = &mut Conn { log: log, closing: sleep(s(60)) }
    sleep!(s(60))
    "late"

fn ready!() -> string:
    "won"

fn ended!(job: mut Suspend[string]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn waiter!(job: mut Suspend[string], log: &mut List[string]) -> string:
    log.push("waiter ${ended!(job)}")
    "waited"

fn stop!(job: mut Suspend[string], log: &mut List[string]) -> string:
    log.push("abandon")
    job.abandon()
    log.push("abandon returned")
    "stopped"

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    let job: mut Suspend[string] = session(&mut log)
    let (winner, waited, stopped) = all!(race(job, ready()), waiter(job, &mut log), stop(job, &mut log))
    println("${winner} ${waited} ${stopped}")
    println(log.join(", "))
    println("later ${ended!(job)}")
