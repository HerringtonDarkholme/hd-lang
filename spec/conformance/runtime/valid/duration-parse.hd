# test: parsing a Duration reads Go-style text in h, min, m, s, ms, us, µs, μs, and ns, exactly, and the text of every duration parses back
# Spec std/time Duration Parsing: std-time.duration.parse, std-time.duration.parse.text-grammar, std-time.duration.parse.no-sign, std-time.duration.parse.units, std-time.duration.parse.components-sum, std-time.duration.parse.exact, std-time.duration.parse.zero-text, std-time.duration.parse.range-max, std-time.duration.parse.round-trip, std-time.duration.parse.no-panic (#370).
use std.time.{Duration, ParseTimeError, h, min, ms, s}

fn timeout_of(text: string) -> Result[Duration, ParseTimeError]:
    text.parse::[Duration]()

fn millis_of(text: string) -> i64:
    match text.parse::[Duration]():
        .Ok(duration) => duration.as_milliseconds()
        .Err(_) => -1

tests:
    use std.testing.{assert, assert_equal}

    it("components sum, with an optional plus sign"):
        assert_equal(millis_of("1h30m"), 5400000, reason="Go's m is minutes")
        assert_equal(millis_of("1h0min5s"), 3605000, reason="the text Display writes")
        assert_equal(millis_of("250ms"), 250, reason="milliseconds")
        assert_equal(millis_of("1.5s"), 1500, reason="a fraction")
        assert_equal(millis_of("+2s"), 2000, reason="a plus sign")
        assert_equal(timeout_of("1.5h"), .Ok(90min), reason="a fraction of hours")
        assert_equal(timeout_of("1m1m"), .Ok(2min), reason="a unit may repeat")

    it("finer units are accepted when the value is whole"):
        assert_equal(millis_of("2000us"), 2, reason="microseconds")
        assert_equal(millis_of("2000µs"), 2, reason="micro sign U+00B5")
        assert_equal(millis_of("2000μs"), 2, reason="Greek mu U+03BC")
        assert_equal(millis_of("3000000ns"), 3, reason="nanoseconds")
        assert_equal(millis_of("1.500000000s"), 1500, reason="zeros after the fraction")
        assert_equal(millis_of("0.001s"), 1, reason="one millisecond as a fraction")
        assert_equal(millis_of("0.0000025h"), 9, reason="a long fraction that is whole")
        assert_equal(millis_of("2.000ms"), 2, reason="a zero fraction")

    it("zero needs no unit"):
        assert_equal(timeout_of("0"), .Ok(0s), reason="bare zero")
        assert_equal(timeout_of("+0"), .Ok(0s), reason="plus zero")
        assert_equal(timeout_of("0s"), .Ok(0s), reason="zero with a unit")
        assert_equal(timeout_of("00"), .Err(ParseTimeError.MissingUnit(2)), reason="only the text 0")

    it("the whole range of Duration parses"):
        assert_equal(millis_of("9223372036854775807ms"), 9223372036854775807, reason="the largest")
        assert_equal(timeout_of("2562047788015h12min55.807s"), .Ok(Duration::milliseconds(9223372036854775807)), reason="its Display text")

    it("a minus sign is an error, as no duration is negative"):
        assert_equal(timeout_of("-5s"), .Err(ParseTimeError.InvalidCharacter(0)), reason="a negative duration")
        assert_equal(timeout_of("-0"), .Err(ParseTimeError.InvalidCharacter(0)), reason="negative zero")
        assert_equal(timeout_of("-1.5h"), .Err(ParseTimeError.InvalidCharacter(0)), reason="a negative fraction")

    it("the text of a duration parses back"):
        let values: List[i64] = [0, 1, 500, 999, 1000, 1005, 1050, 59999, 60000, 3600000, 3605000, 3723500, 90000, 9223372036854775807]
        for value in values:
            duration := Duration::milliseconds(value)
            assert_equal(duration.to_string().parse::[Duration](), .Ok(duration), reason="round trip of ${duration}")
