# test: generic suspending function bound

use std.testing.assert_equal

trait Score:
    fn score(self) -> i32

data Value:
    amount: i32

impl Score for Value:
    fn score(self) -> i32: self.amount

fn pause!() -> void: pass

fn read![T < Score](value: T) -> i32:
    pause!()
    value.score()

fn main!() -> i32:
    read!(Value { amount: 42 })

test "main returns 42":
    assert_equal(main!(), 42, reason="generic suspending function bound")
