# test: a new object written `box(Tally { ... })` installed for a trait with `&self` or `&mut self` methods is one object that every `$.use` shares, and `box(Name { ... })` serves a trait whose methods read only
# Spec 11 Providers Behind References: req.ref.install-counted, req.ref.use.reference-values; Spec 11 Mutable Providers: req.mut.install-writable-counted, req.mut.use-readonly.reference-values.
# expect-stdout: 11 12
# expect-stdout: <ada> <bo>
trait Counter:
    fn bump(&mut self) -> void
    fn total(&self) -> i32

trait Shown:
    fn shown(&self) -> string

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1
    fn total(&self) -> i32:
        self.n

struct Name:
    text: string

impl Shown for Name:
    fn shown(&self) -> string:
        "<${self.text}>"

fn tick() -> i32 $ Counter:
    $.use(Counter).bump()
    $.use(Counter).total()

fn show() -> string $ Shown:
    let s: &dyn Shown = $.use(Shown)
    s.shown()

pub fn main() -> void $ Console:
    $.with(Counter=box(Tally { n: 10 })):
        first := tick()
        println("$first ${tick()}")
    name := box(Name { text: "ada" })
    $.with(Shown=name):
        first := show()
        $.with(Shown=box(Name { text: "bo" })):
            println("$first ${show()}")
