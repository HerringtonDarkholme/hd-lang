# Spec 10 Standard Testing: module.testing.uses-eq.
@derive(Debug)
data User:
    id: string
    display_name: string

impl Eq for User:
    fn eq(self, other: Self) -> bool:
        self.id == other.id

tests:
    use std.testing.assert_equal

    it("values equal under an explicit Eq pass assert_equal"):
        ada := User { id: "ada", display_name: "Ada" }
        same_ada := User { id: "ada", display_name: "Ada" }
        assert_equal(ada, same_ada, reason="equal ids and names")

    it("assert_equal uses the explicit Eq, not field-by-field comparison"):
        ada := User { id: "ada", display_name: "Ada" }
        renamed := User { id: "ada", display_name: "Countess" }
        assert_equal(ada, renamed, reason="the implementation compares only ids")
