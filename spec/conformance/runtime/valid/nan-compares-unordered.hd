# test: NaN compares as IEEE 754 says: unequal to itself and unordered
# Spec 04 Numeric Display: types.display.nan-compare.
fn ratio(a: f64, b: f64) -> f64: a / b

tests:
    use std.testing.assert_equal

    it("NaN is unequal and unordered"):
        nan := ratio(0.0, 0.0)
        assert_equal(nan == nan, false, reason="NaN is not equal to itself")
        assert_equal(nan != nan, true, reason="NaN is unequal to itself")
        assert_equal(nan < 1.0 || nan >= 1.0, false, reason="NaN is unordered")
