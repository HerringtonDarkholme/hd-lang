# test: a value of a type that implements a trait is assignable to that dyn trait
# Spec 04 Assignability And Coercion: types.assign.trait-value.
data User:
    name: string

impl Display for User:
    fn to_string(self) -> string: self.name

tests:
    use std.testing.assert_equal

    it("a User is a dyn Display"):
        let shown: dyn Display = User { name: "ada" }
        assert_equal("$shown", "ada", reason="the trait value calls User's to_string")
