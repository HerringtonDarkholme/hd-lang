# test: when instantiations fit only through a numeric literal, the literal's fallback type wins: usize, i32 for a signed literal, or f64
# Spec 09 Traits: trait.resolve.literal-arg.example.
trait Combine[T]:
    fn combine(self, other: T) -> string

data Money:
    cents: i32

impl Combine[i32] for Money:
    fn combine(self, other: i32) -> string:
        "i32"

impl Combine[i64] for Money:
    fn combine(self, other: i64) -> string:
        "i64"

impl Combine[usize] for Money:
    fn combine(self, other: usize) -> string:
        "usize"

impl Combine[f32] for Money:
    fn combine(self, other: f32) -> string:
        "f32"

impl Combine[f64] for Money:
    fn combine(self, other: f64) -> string:
        "f64"

tests:
    use std.testing.assert_equal

    it("integer literals fall back to usize or, when signed, i32, and float literals to f64"):
        price := Money { cents: 10 }
        let wide: i64 = 5
        assert_equal(price.combine(5), "usize", reason="an unsigned integer literal falls back to usize")
        assert_equal(price.combine(-5), "i32", reason="a signed integer literal falls back to i32")
        assert_equal(price.combine(2.5), "f64", reason="a float literal falls back to f64")
        assert_equal(price.combine(wide), "i64", reason="a typed argument still selects exactly")
