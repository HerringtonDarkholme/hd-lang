# test: a direct call reads each key from its own provider
# Spec lang/11-requirements-and-suspension.md: req.key.binding.identity.
# expect-stdout: 201

trait Repo[T]:
    fn count(self) -> i32

struct User: pass
struct Post: pass
struct UserRepo: pass
struct PostRepo: pass

impl Repo[User] for UserRepo:
    fn count(self) -> i32: 20

impl Repo[Post] for PostRepo:
    fn count(self) -> i32: 1

fn activity() -> i32 $ Repo[User] + Repo[Post]:
    $.use(Repo[User]).count() * 10 + $.use(Repo[Post]).count()


pub fn main!() -> void $ Console:
    $.with(Repo[User]=UserRepo {}, Repo[Post]=PostRepo {}):
        println(activity())
