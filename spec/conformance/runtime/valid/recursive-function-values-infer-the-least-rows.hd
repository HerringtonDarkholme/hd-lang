# test: a recursive group propagates requirements through function values
# Spec 11 Omitted Requirement Clauses: req.row.omitted.inferred-private, req.row.omitted.cycle.
# expect-stdout: b 2
# expect-stdout: b 0

fn a(n: i32) -> void:
    if n > 0:
        next := b
        next(n - 1)

fn b(n: i32) -> void:
    println("b $n")
    if n > 0:
        a(n - 1)

pub fn main() -> void $ Console:
    a(3)
