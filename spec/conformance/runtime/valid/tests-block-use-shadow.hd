# test: a use inside a tests block shadows the module's function inside the block
# Spec 03 Tests Blocks: names.tests.shadow.
fn snapshot(text: string) -> string:
    "module"

fn main() -> string: snapshot("outside")

tests:
    use std.testing.snapshot

    it("sees the block import inside the block"):
        snapshot("inside", expect="inside")

    it("module code sees its own function"):
        assert_equal(main(), "module", reason="outside the block nothing changes")
