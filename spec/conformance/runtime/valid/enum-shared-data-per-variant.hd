# test: every value of one variant has the same shared data
# Spec 08 Shared Fields: data.shared.value-read; Variant Constructors As Function Values: data.enum.fn-value.payload-free.
# Spec 08 Shared Enum Constructor Data: data.shared.constructor, data.shared.per-variant.

enum HttpStatus(code: i32, phrase: string):
    Ok -> HttpStatus(200, phrase="OK")
    Moved(target: string) -> HttpStatus(301, phrase="Moved")

tests:
    use std.testing.assert_equal

    it("values of one variant share their data"):
        first := HttpStatus.Moved(target="/a")
        second := HttpStatus.Moved(target="/b")
        assert_equal(first.code, second.code, reason="per-variant code")
        assert_equal(first.phrase, "Moved", reason="per-variant phrase")
        assert_equal(HttpStatus.Ok.code, 200, reason="a payload-free variant reads its data")
