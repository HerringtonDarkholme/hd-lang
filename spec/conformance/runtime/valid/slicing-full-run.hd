# test: a .. index selects the whole string or a copy of the whole list, and ..=b selects through b
# Spec 05 Slicing: expr.index.slice.full, expr.index.slice.to-inclusive, expr.index.slice.list (batch 49).
tests:
    use std.testing.assert_equal

    it("slices the whole string"):
        assert_equal("hello"[..], "hello", reason="..")
        assert_equal("hello"[..=1], "he", reason="..=b")

    it("copies the whole list"):
        let items: mut List[i32] = [1, 2, 3]
        let copy: mut List[i32] = items[..]
        assert_equal(copy, [1, 2, 3], reason="every element")
        assert_equal(items[..=1], [1, 2], reason="..=b")
        copy[0] = 7
        items.push(4)
        assert_equal(items, [1, 2, 3, 4], reason="the copy did not change the list")
        assert_equal(copy, [7, 2, 3], reason="the list did not change the copy")
