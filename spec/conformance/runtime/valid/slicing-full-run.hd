# test: explicit slice methods select independent list values and string byte ranges
# Spec std/collections List Slices: std-collections.list.slice; Spec 10: module.string.slice.
tests:
    use std.testing.assert_equal

    it("slices the whole string"):
        assert_equal("hello".slice(0, "hello".len()), "hello", reason="..")
        assert_equal("hello".slice(0, 2), "he", reason="..=b")

    it("copies the whole list"):
        let mut items: List[i32] = [1, 2, 3]
        let mut copy: List[i32] = items.slice(0, items.len())
        assert_equal(copy, [1, 2, 3], reason="every element")
        assert_equal(items.slice(0, 2), [1, 2], reason="..=b")
        copy[0] = 7
        items.push(4)
        assert_equal(items, [1, 2, 3, 4], reason="the copy did not change the list")
        assert_equal(copy, [7, 2, 3], reason="the list did not change the copy")
