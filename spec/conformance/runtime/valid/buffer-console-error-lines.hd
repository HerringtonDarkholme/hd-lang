# test: MemoryConsole keeps write_error! text apart from write! text
# Spec std/console Buffer Console: std-console.buffer.error-text (spec pass 89, audit item 8).
use std.console.{MemoryConsole, eprintln}
tests:
    use std.testing.assert_equal

    it("keeps the streams apart"):
        let mut console = MemoryConsole::new()
        $.with(Console=console):
            println("out")
            eprintln("err")
        assert_equal(console.output(), ["out\n"], reason="standard output")
        assert_equal(console.error_output(), ["err\n"], reason="standard error")
