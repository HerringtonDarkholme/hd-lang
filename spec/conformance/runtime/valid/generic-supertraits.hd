# test: generic supertraits substitute parent arguments across every dispatch path
# Spec 09 Traits: trait.super.satisfy, trait.dyn.supertrait-methods, trait.dyn.widen.

trait Source[Output]:
    fn source(self) -> Output

trait Wrapped[Item] < Source[List[Item]]:
    fn marker(self) -> i32

trait Specialized[Item] < Source[List[Item]]:
    fn specialized(self) -> i32

data Box[T]:
    item: T

impl[T] Source[List[T]] for Box[T]:
    fn source(self) -> List[T]: [self.item]

impl[T] Wrapped[T] for Box[T]:
    fn marker(self) -> i32: 0

impl Specialized[i32] for Box[i32]:
    fn specialized(self) -> i32: 0

fn generic_supertrait_direct() -> i32:
    Box::[i32] { item: 42 }.source()[0]

fn read_wrapped[T < Wrapped[i32]](value: T) -> i32:
    value.source()[0]

fn generic_supertrait_bound() -> i32:
    read_wrapped(Box::[i32] { item: 42 })

fn read_dynamic(value: dyn Wrapped[i32]) -> i32:
    value.source()[0]

fn generic_supertrait_dynamic() -> i32:
    let value: dyn Wrapped[i32] = Box::[i32] { item: 42 }
    read_dynamic(value)

fn read_source(value: dyn Source[List[i32]]) -> i32:
    value.source()[0]

fn generic_supertrait_widened() -> i32:
    let child: dyn Wrapped[i32] = Box::[i32] { item: 42 }
    read_source(child)

fn concrete_child_uses_blanket_parent() -> i32:
    let child: dyn Specialized[i32] = Box::[i32] { item: 42 }
    child.source()[0]

tests:
    use std.testing.assert_equal

    it("generic_supertrait_direct returns 42"):
        assert_equal(generic_supertrait_direct(), 42, reason="generic supertraits substitute parent arguments across every dispatch path")

    it("generic_supertrait_bound returns 42"):
        assert_equal(generic_supertrait_bound(), 42, reason="generic supertraits substitute parent arguments across every dispatch path")

    it("generic_supertrait_dynamic returns 42"):
        assert_equal(generic_supertrait_dynamic(), 42, reason="generic supertraits substitute parent arguments across every dispatch path")

    it("generic_supertrait_widened returns 42"):
        assert_equal(generic_supertrait_widened(), 42, reason="generic supertraits substitute parent arguments across every dispatch path")

    it("concrete_child_uses_blanket_parent returns 42"):
        assert_equal(concrete_child_uses_blanket_parent(), 42, reason="generic supertraits substitute parent arguments across every dispatch path")
