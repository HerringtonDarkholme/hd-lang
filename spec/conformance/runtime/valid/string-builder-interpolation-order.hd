# test: builder interpolation evaluates every expression before appending its parts
# Spec std/text Joining And Building: std-text.builder.push-local, std-text.builder.build-empties.
use std.text.StringBuilder
use std.testing.assert_equal

fn select(out: *mut StringBuilder, log: &mut List[string]) -> *mut StringBuilder:
    log.push("receiver")
    out

fn piece(out: *mut StringBuilder, log: &mut List[string], text: string) -> string:
    log.push(text)
    out.push(text)
    text

tests:
    it("receiver and expressions run once before builder writes"):
        out := StringBuilder::new()
        let mut log: List[string] = []
        out.push_char('é')
        select(out, &mut log).push("left${piece(out, &mut log, "one")}middle${piece(out, &mut log, "two")}right")
        assert_equal(log, ["receiver", "one", "two"], reason="left to right, exactly once")
        first := out.build()
        assert_equal(first, "éonetwoleftonemiddletworight", reason="effects precede every append")
        out.push("${+3}")
        out.push_char('λ')
        out.push("${""}")
        assert_equal(first, "éonetwoleftonemiddletworight", reason="an earlier result is its own string")
        assert_equal(out.build(), "3λ", reason="mixed text and characters retain order")
