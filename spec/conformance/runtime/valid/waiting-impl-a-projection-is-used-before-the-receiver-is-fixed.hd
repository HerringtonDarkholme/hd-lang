# test: a projection is used before the receiver is fixed
# expect-stdout: -2
# expect-stdout: -2.5
# expect-stdout: 3
# expect-stdout: 5
# expect-stdout: xy
use std.ops.{Div, Neg}

struct Point:
    x: i32

trait Get:
    type Out
    fn get(self) -> Self::Out

impl Get for (i32, string):
    type Out = string
    fn get(self) -> string:
        self._1

impl Get for (i32, bool):
    type Out = Point
    fn get(self) -> Point:
        Point { x: 5 }

pub fn main() -> void $ Console:
    q := Div::[i32]::div(-7, 2) + 1
    println(q)
    let y: f64 = Neg::neg(2.5)
    println(y)
    println((+1, "abc").get().len())
    println((+1, true).get().x)
    let t: string = (+1, "xy").get()
    println(t)
