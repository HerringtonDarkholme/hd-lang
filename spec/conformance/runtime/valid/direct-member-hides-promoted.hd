# test: a pub own member hides a promoted member of the same name, for fields and methods alike
# Spec 03 Member Resolution: names.member.namespaces, names.member.fields,
# names.member.methods, names.member.shared-name,
# names.lookup.forms, names.lookup.only, names.lookup.field-form,
# names.lookup.method-form, names.visible.field-method, names.part.definition,
# names.part.depth, names.promote.member, names.field-lookup.select,
# names.promoted.explicit.
data Base:
    pub label: string

impl Base:
    pub fn describe(self) -> string:
        "base"

data Wrapper:
    Base
    pub label: string

impl Wrapper:
    pub fn describe(self) -> string:
        "wrapper"

tests:
    use std.testing.assert_equal

    it("direct field hides promoted field"):
        wrapper := Wrapper { Base: ...Base { label: "inner" }, label: "outer" }
        assert_equal(wrapper.label, "outer", reason="direct field wins")
        assert_equal(wrapper.Base.label, "inner", reason="qualified access reaches the embedded field")

    it("direct method hides promoted method"):
        wrapper := Wrapper { Base: ...Base { label: "inner" }, label: "outer" }
        assert_equal(wrapper.describe(), "wrapper", reason="direct method wins")
        assert_equal(wrapper.Base.describe(), "base", reason="qualified call reaches the embedded method")
