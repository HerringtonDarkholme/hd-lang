# test: optional and nominal local-reference payloads release their counted sources
# Rules: ref.count.local, std-weak.release.target.
use std.annotation.cold
use std.testing.assert_equal
use std.weak.{Weak, weak}

enum Payload[T]:
    Present(value: T)
    Missing

@cold
fn read_optional(value: (&i32)?) -> i32:
    match value:
        .Some(item) => *item
        .None => -1

@cold
fn read_nominal(value: Payload[&i32]) -> i32:
    match value:
        .Present(item) => *item
        .Missing => -1

@cold
fn consume(owner: *i32, explicit: bool, nominal: bool) -> void:
    let result = if nominal:
        let call: fn(Payload[&i32]) -> i32 = read_nominal
        if explicit:
            let value: &i32 = owner
            call(.Present(value))
        else:
            call(.Present(owner))
    else:
        let call: fn((&i32)?) -> i32 = read_optional
        if explicit:
            let value: &i32 = owner
            call(.Some(value))
        else:
            call(.Some(owner))
    assert_equal(result, 7)

@cold
fn outcome(explicit: bool, nominal: bool, read_after: bool) -> Weak[i32]?:
    owner := box(+7)
    seen := weak(owner)
    consume(owner, explicit, nominal)
    if read_after:
        assert_equal(*owner, 7, reason="the caller still owns its original reference")
    seen

fn verify(explicit: bool, nominal: bool, read_after: bool) -> void:
    let alive = match outcome(explicit, nominal, read_after):
        .Some(link) => link.upgrade().is_some()
        .None => false
    assert_equal(alive, false, reason="no converted payload keeps the counted source")

pub fn main() -> void:
    verify(false, false, false)
    verify(false, false, true)
    verify(false, true, false)
    verify(false, true, true)
    verify(true, false, false)
    verify(true, false, true)
    verify(true, true, false)
    verify(true, true, true)
