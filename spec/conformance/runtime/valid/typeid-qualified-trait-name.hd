# test: a TypeId prints a trait value type by its trait's absolute qualified name
# Spec 09 Stability And Printing: trait.typeid.name, trait.typeid.name.qualified; Runtime Identity: trait.identity.trait-value; Inspectable Types: trait.inspectable.dynamic.
use std.error.Error
use std.inspect.TypeId
use std.testing.assert_equal

tests:
    it("a trait value type prints its trait's absolute name"):
        assert_equal(TypeId::of::[dyn Error]().to_string(), "std.error.Error", reason="qualified trait name")
        assert_equal(TypeId::of::[List[dyn Error]]().to_string(), "List[std.error.Error]", reason="as a type argument")
