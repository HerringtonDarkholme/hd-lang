# test: chain yields the error itself, then each source in order, until a source is .None
# Spec std/error Cause Chain: std-error.chain.source-order (task #221).
use std.error.Error
@error("disk full")
struct DiskError:
    free: i64

@error
enum SaveError:
    @error("cannot save $path")
    Write(path: string, @source error: DiskError)

@error
enum SyncError:
    @error("sync failed")
    Save(@from error: SaveError)

fn messages(errors: List[&dyn Error]) -> List[string]:
    errors.map(fn(error: &dyn Error) -> string: error.to_string())

tests:
    use std.testing.assert_equal

    it("a two-level source chain"):
        failure := SyncError.Save(SaveError.Write("notes.txt", DiskError { free: 0 }))
        let error: &dyn Error = &failure
        errors := error.chain()
        assert_equal(errors.len(), 3, reason="the error and its two sources")
        assert_equal(messages(errors), ["sync failed", "cannot save notes.txt", "disk full"], reason="outermost first")

    it("an error without a source"):
        let error: &dyn Error = &DiskError { free: 0 }
        assert_equal(messages(error.chain()), ["disk full"], reason="only the error itself")
