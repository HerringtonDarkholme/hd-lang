# test: Error.exit_code defaults to 1, an override picks the code, and Termination reads it
# Spec std/error Exit Status: std-error.exit-code.default, std-error.exit-code.dyn, std-error.exit-code.context.
# Spec 10 Exit Status: module.entry.termination.err-code.
use std.error.{Error, message}
use std.process.{ExitCode, Termination}

pub data Usage:
    text: string

impl Display for Usage:
    fn to_string(self) -> string: self.text

impl Error for Usage:
    fn exit_code(self) -> i32: 3

pub data Plain:
    text: string

impl Display for Plain:
    fn to_string(self) -> string: self.text

impl Error for Plain

fn code_of[T < Termination](value: T) -> u8:
    u8(value.report())

tests:
    use std.testing.assert_equal

    it("an error keeps the default code 1"):
        assert_equal(Plain { text: "x" }.exit_code(), 1, reason="the default")
        assert_equal("x".exit_code(), 1, reason="string keeps the default")

    it("an override picks the code"):
        assert_equal(Usage { text: "x" }.exit_code(), 3, reason="the override")

    it("a dyn Error answers with its own code"):
        let erased: dyn Error = Usage { text: "x" }
        assert_equal(erased.exit_code(), 3, reason="forwarded through dyn")
        assert_equal(message("x").exit_code(), 1, reason="a message error keeps the default")

    it("context keeps the default"):
        let failed: Result[i32, Usage] = .Err(Usage { text: "x" })
        match failed.context("saving"):
            .Ok(_) => assert_equal(true, false, reason="expected an error")
            .Err(error) => assert_equal(error.exit_code(), 1, reason="context makes it 1")

    it("Termination reads the code"):
        let result: Result[void, Usage] = .Err(Usage { text: "x" })
        assert_equal(code_of(result), 3, reason=".Err reports the error's code")
        let plain: Result[void, Plain] = .Err(Plain { text: "x" })
        assert_equal(code_of(plain), 1, reason="the default")
        let zero: Result[void, string] = .Err("x")
        assert_equal(code_of(zero), 1, reason="string")
