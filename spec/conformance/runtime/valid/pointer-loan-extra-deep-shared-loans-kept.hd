# test: pointer loans, adversarial: seventy nested shared loans on one object that a `&mut` elsewhere keeps, past an inline counter's width and into the bits above it; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Cell:
    value: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn depth(p: *Cell, w: *mut Cell, n: usize) -> usize:
    r := &p.value
    below := if n == 0: 0 else: depth(p, w, n - 1)
    if n > 1000:
        m := &mut w.value
        *m = fresh()
    r.len() + below

pub fn main() -> void $ Console:
    p := box(Cell { value: orig() })
    w := box(Cell { value: fresh() })
    if depth(p, w, 70) != 71 * orig().len():
        panic("the nested reads disagree")
    p.value = fresh()
    println("ok")
