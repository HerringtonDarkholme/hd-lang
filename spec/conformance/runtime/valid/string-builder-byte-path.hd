# test: push_ascii appends one ASCII byte, reserve appends nothing, and build hands over everything pushed since the last build and empties the builder
# Spec std/text Joining And Building: std-text.builder.push-ascii-local, std-text.builder.reserve-local, std-text.builder.build-empties.
use std.text.StringBuilder

# The decimal digits of `n`, pushed as bytes after room for them.
fn digits(n: u32) -> string:
    out := StringBuilder::new()
    out.reserve(10)
    let mut backward: List[u8] = []
    let rest = n
    while rest >= 10:
        backward.push(u8(48 + rest % 10))
        rest = rest / 10
    out.push_ascii(u8(48 + rest))
    let index = backward.len()
    while index > 0:
        index = index - 1
        out.push_ascii(backward[index])
    out.build()

tests:
    use std.testing.assert_equal

    it("pushes ASCII bytes"):
        assert_equal(digits(0), "0", reason="one digit")
        assert_equal(digits(4096), "4096", reason="digits in order")
        text := StringBuilder::new()
        text.push_ascii(104)
        text.push_ascii(105)
        assert_equal(text.build(), "hi", reason="ASCII bytes in order")
        text.push_ascii(0)
        text.push_ascii(127)
        assert_equal(text.build().len(), 2, reason="ASCII bytes")
        text.push_ascii(97)
        text.push_char('a')
        assert_equal(text.build(), "aa", reason="as push_char of the same character")

    it("reserves room and appends nothing"):
        out := StringBuilder::new()
        out.push("ab")
        out.reserve(100)
        assert_equal(out.build(), "ab", reason="reserve appends nothing")
        out.push_ascii(33)
        out.reserve(0)
        out.push_ascii(63)
        assert_equal(out.build(), "!?", reason="reserve appends nothing, and 0 is allowed")

    it("build empties the builder"):
        out := StringBuilder::new()
        out.push_ascii(120)
        out.push("y")
        out.push_char('z')
        first := out.build()
        assert_equal(first, "xyz", reason="everything pushed")
        assert_equal(out.build(), "", reason="the builder is empty after build")
        out.push_ascii(49)
        assert_equal(out.build(), "1", reason="only what was pushed since the last build")
        assert_equal(first, "xyz", reason="an earlier result is its own string")

    it("many pushes grow one buffer"):
        out := StringBuilder::new()
        let i = +0
        while i < 1000:
            out.push("ab")
            out.push_char('c')
            i += 1
        text := out.build()
        assert_equal(text.len(), 3000, reason="every push kept")
        assert_equal(text.slice(2997, 3000), "abc", reason="in order")
