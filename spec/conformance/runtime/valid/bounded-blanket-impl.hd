# test: bounded blanket impl
# Spec 09 Traits: trait.overlap.generic, trait.target.arguments, trait.dyn.convert.

use std.testing.assert_equal

trait Score:
    fn score(self) -> i32

data Point:
    value: i32

impl Score for Point:
    fn score(self) -> i32: self.value

impl[Item < Score] Score for List[Item]:
    fn score(self) -> i32: self[0].score()

fn dynamic_score() -> i32:
    let points: List[Point] = [Point { value: 42 }]
    let dynamic: dyn Score = points
    dynamic.score()

fn read_score[T < Score](value: T) -> i32:
    value.score()

fn bounded_score() -> i32:
    let points: List[Point] = [Point { value: 42 }]
    read_score(points)

fn erase_scores[T < Score](values: List[T]) -> dyn Score:
    values

fn forwarded_score() -> i32:
    let points: List[Point] = [Point { value: 42 }]
    erase_scores(points).score()

tests:
    it("dynamic_score returns 42"):
        assert_equal(dynamic_score(), 42, reason="bounded blanket impl")

    it("bounded_score returns 42"):
        assert_equal(bounded_score(), 42, reason="bounded blanket impl")

    it("forwarded_score returns 42"):
        assert_equal(forwarded_score(), 42, reason="bounded blanket impl")
