# test: pointer loans, adversarial: a loop over a list behind a pointer writes another field through the same pointer; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Bag:
    items: List[string]
    count: usize

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn probe(p: *mut Bag) -> string:
    let seen = ""
    for item in &p.items:
        p.count += 1
        seen = *item
    seen

pub fn main() -> void $ Console:
    seen := probe(box(Bag { items: [orig()], count: 0 }))
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
