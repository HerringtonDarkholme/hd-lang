# test: pointer loans, adversarial: a getter called in a loop that writes only another type; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision elided; call-scoped fallback rejected; Go model runs.
struct Person:
    name: string

struct Log:
    lines: i32

impl Person:
    fn name_ref(&self) -> &string:
        &self.name

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn total(p: *Person, log: *mut Log) -> usize:
    let sum: usize = 0
    for round in 0..3:
        n := p.name_ref()
        log.lines += 1
        sum += n.len()
    sum

pub fn main() -> void $ Console:
    p := box(Person { name: orig() })
    log := box(Log { lines: +0 })
    seen := if total(p, log) == 3 * orig().len(): orig() else: fresh()
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
