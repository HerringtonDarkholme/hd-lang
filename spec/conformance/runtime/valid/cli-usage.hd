# test: the usage text lists the positionals, then the flags and options, with each help in one column
# Spec std/cli Usage Text: std-cli.usage.parser, std-cli.usage.parser-line, std-cli.usage.arguments, std-cli.usage.options, std-cli.usage.term, std-cli.usage.entry, std-cli.usage.no-help, std-cli.usage.parser-no-help, std-cli.error.help-required (task #242).
use std.cli.{Arg, ArgParser, CliError}
fn tool() -> &mut ArgParser:
    ArgParser::new("count").arg(Arg { name: "verbose", kind: .Flag, short: 'v', help: "print each file" }).arg(Arg { name: "out", kind: .Option, short: 'o', help: "write the total here" }).arg(Arg { name: "dry-run", kind: .Flag, short: .None, help: "" }).arg(Arg { name: "pattern", kind: .Positional, required: true, help: "the files to count" })

tests:
    use std.testing.assert_equal

    it("a full usage text"):
        expected := "usage: count [options] <pattern>\n\narguments:\n  pattern            the files to count\n\noptions:\n  -v, --verbose      print each file\n  -o, --out <value>  write the total here\n      --dry-run"
        assert_equal(tool().usage(), expected, reason="every section")

    it("sections without declarations are left out"):
        assert_equal(ArgParser::new("bare").usage(), "usage: bare", reason="no declarations")
        assert_equal(ArgParser::new("cat").arg(Arg { name: "file", kind: .Positional, required: true, help: "the file" }).usage(), "usage: cat <file>\n\narguments:\n  file  the file", reason="positionals only")
        assert_equal(ArgParser::new("ls").arg(Arg { name: "all", kind: .Flag, short: 'a', help: "every entry" }).usage(), "usage: ls [options]\n\noptions:\n  -a, --all  every entry", reason="flags only")

    it("--help is an ordinary flag"):
        assert_equal(tool().parse(["--help"]), .Err(CliError.UnknownOption("--help")), reason="not declared")
        helped := ArgParser::new("count").arg(Arg { name: "help", kind: .Flag, short: 'h', help: "show this text" }).arg(Arg { name: "pattern", kind: .Positional, required: true, help: "the files to count" })
        match helped.parse(["-h"]):
            .Ok(parsed) => assert_equal(parsed.flag("help"), true, reason="declared, and no positional is missing")
            .Err(error) => panic("parse failed: $error")
        assert_equal(helped.parse([]), .Err(CliError.MissingArgument("<pattern>")), reason="without -h a positional is missing")
        assert_equal(helped.parse(["-h", "--colour"]), .Err(CliError.UnknownOption("--colour")), reason="other errors still count")
