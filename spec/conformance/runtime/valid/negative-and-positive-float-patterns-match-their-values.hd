# test: negative and positive float patterns match their values
# Rules: flow.match.literal.
# expect-stdout: 3
# expect-stdout: 4
# expect-stdout: 5
# expect-stdout: 6
# expect-stdout: 0
# expect-stdout: 0
fn pick(value: f64) -> i32:
    match value:
        -1.5 => 3
        1.5 => 4
        0.25 => 5
        -0.25 => 6
        _ => 0

pub fn main() -> void $ Console:
    println(pick(-1.5))
    println(pick(1.5))
    println(pick(0.25))
    println(pick(-0.25))
    println(pick(2.5))
    println(pick(-2.5))
