# test: a payload and a field declared `S::Item` are borrowed and written through a `*mut` owner, passed as a reference and reborrowed
# Spec 13 Values And References: ref.match.borrow, ref.write.field. Spec 9 Traits: trait.assoc.projection.
# expect-stdout: 9
# expect-stdout: 10
# expect-stdout: 5
trait Source:
    type Item

struct Provider: pass

struct Number:
    value: u32

impl !Copy for Number

impl Source for Provider:
    type Item = Number

enum Holder[S < Source]:
    Empty
    Full(value: S::Item)

struct Box2[S < Source]:
    item: S::Item

fn write(holder: &mut Holder[Provider]) -> void:
    match holder:
        .Full(value) => value.value = 9
        .Empty => pass

fn read(holder: &Holder[Provider]) -> u32:
    match holder:
        .Full(value) => value.value
        .Empty => 0

pub fn main() -> void $ Console:
    let h: *mut Holder[Provider] = box(Holder::[Provider].Full(Number { value: 1 }))
    write(h)
    println(read(h))
    match &mut *h:
        .Full(value) => value.value += 1
        .Empty => pass
    println(read(&*h))
    let b: *mut Box2[Provider] = box(Box2::[Provider] { item: Number { value: 1 } })
    b.item.value = 5
    println(b.item.value)
