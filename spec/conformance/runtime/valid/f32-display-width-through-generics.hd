# test: f32 values keep their width through generic Display and convert exactly to f64
# expect: test
fn pass_through[T](value: T) -> T:
    value

fn render[T < Display](value: T) -> string:
    "$value"

tests:
    use std.testing.assert_equal

    it("f32 shortest round-trip text survives erasure"):
        let small: f32 = 0.1
        assert_equal("$small", "0.1", reason="direct f32 Display")
        assert_equal(render(small), "0.1", reason="generic Display keeps f32 width")
        assert_equal(render(pass_through(small)), "0.1", reason="erased round trip keeps f32 width")
        wide := f64(small)
        assert_equal("$wide", "0.10000000149011612", reason="the f32 to f64 cast is exact")
