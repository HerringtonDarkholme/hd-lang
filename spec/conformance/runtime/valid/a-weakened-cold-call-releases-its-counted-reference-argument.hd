# test: weakened cold function values release their counted reference argument exactly once
# Spec std/weak: std-weak.release.target; functions: fn.type.suspend.weaken and fn.type.suspend.ctor.
use std.annotation.cold
use std.testing.assert_equal
use std.weak.{Weak, weak}

@cold
fn echo!(value: *i32) -> *i32:
    value

@cold
fn generic_echo![T](value: T) -> T:
    value

fn link(value: &i32) -> Weak[i32]?:
    weak(value)

fn expired(link: Weak[i32]?) -> bool:
    match link:
        .Some(seen) => seen.upgrade().is_none()
        .None => false

@cold
fn read(value: &i32) -> i32:
    *value

@cold
fn read_cold!(value: &i32) -> i32:
    *value

fn plain_view(nested: bool) -> fn(*i32) -> i32:
    if nested:
        let source: List[fn(&i32) -> i32] = [read]
        let viewed: List[fn(*i32) -> i32] = source
        viewed[0]
    else:
        read

fn cold_view(nested: bool) -> fn!(*i32) -> i32:
    if nested:
        let source: List[fn!(&i32) -> i32] = [read_cold]
        let viewed: List[fn!(*i32) -> i32] = source
        viewed[0]
    else:
        read_cold

@cold
fn invoke[T](call: fn(T) -> i32, value: T) -> i32:
    call(value)

fn adapted_plain(nested: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    adapted := plain_view(nested)
    assert_equal(invoke(adapted, value), 7, reason="contravariant lending reads the argument")
    seen

fn adapted_plain_live(nested: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    adapted := plain_view(nested)
    assert_equal(invoke(adapted, value), 7, reason="contravariant lending reads the argument")
    assert_equal(*value, 7, reason="a live caller keeps its owner")
    seen

fn adapted_cold!(nested: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    adapted := cold_view(nested)
    assert_equal(adapted!(value), 7, reason="contravariant lending reads the argument")
    seen

fn adapted_cold_live!(nested: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    adapted := cold_view(nested)
    assert_equal(adapted!(value), 7, reason="contravariant lending reads the argument")
    assert_equal(*value, 7, reason="a live caller keeps its owner")
    seen

type View[+T](T)

@cold
fn read_view(value: View[&i32]) -> i32:
    7

fn nominal_view(live: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    let adapted: fn(View[*i32]) -> i32 = read_view
    assert_equal(
        adapted(View(value)),
        7,
        reason="a closed nominal input uses the common reference ABI",
    )
    assert_equal(invoke(adapted, View(value)), 7, reason="nominal reference views keep their ABI")
    if live:
        assert_equal(*value, 7, reason="a nominal view does not take a live caller's owner")
    seen

fn anonymous_capture() -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    let make: fn(*i32) -> fn() -> i32 = fn(item: *i32) -> fn() -> i32:
        fn() -> i32: *item
    saved := make(value)
    assert_equal(saved() + saved(), 14, reason="an anonymous creator copies its borrowed argument")
    seen

fn anonymous_weakening!(complete: bool) -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    let cold: fn!(*i32) -> *i32 = fn!(item: *i32) -> *i32: item
    let ctor: fn(*i32) -> Suspend[*i32] = cold
    pending := ctor(value)
    if complete:
        assert_equal(*pending!(), 7, reason="anonymous weakening preserves its owned result")
    else:
        _ := pending.cancel!()
    seen

fn alive(link: Weak[i32]?) -> bool:
    match link:
        .Some(seen) => seen.upgrade().is_some()
        .None => false

@cold
fn escaping_variance(nested: bool) -> (Weak[i32]?, Suspend[i32]):
    value := box(+7)
    seen := link(value)
    let ctor: fn(*i32) -> Suspend[i32] = cold_view(nested)
    (seen, ctor(value))

fn settle_variance!(nested: bool, cancel: bool) -> Weak[i32]?:
    let (seen, pending) = escaping_variance(nested)
    assert_equal(
        alive(seen),
        true,
        reason="the escaped cold frame keeps the referent before polling",
    )
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(
            pending!(),
            7,
            reason="polling after the lifetime check still reads the referent",
        )
    assert_equal(
        expired(seen),
        true,
        reason="completion or cancellation releases the frame's owner",
    )
    seen

fn make(generic: bool) -> (Weak[i32]?, Suspend[*i32]):
    value := box(+7)
    seen := link(value)
    let call: fn(*i32) -> Suspend[*i32] = if generic: generic_echo else: echo
    (seen, call(value))

fn complete!(generic: bool) -> Weak[i32]?:
    let (seen, pending) = make(generic)
    value := pending!()
    assert_equal(*value, 7, reason="the weakened call preserves its result")
    seen

fn cancel!(generic: bool) -> Weak[i32]?:
    let (seen, pending) = make(generic)
    _ := pending.cancel!()
    seen

trait Read:
    fn read(self) -> i32

impl Read for i32:
    fn read(self) -> i32:
        self

type Handle(*i32)

@cold
fn capture(value: *dyn Read) -> fn() -> i32:
    fn() -> i32: value.read()

@cold
fn keep[T < 'static](value: T) -> fn() -> T:
    fn() -> T: value

@cold
fn project(value: &i32) -> &i32:
    value

fn projected() -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    borrowed := project(value)
    assert_equal(*borrowed, 7, reason="a dependent result keeps its counted origin")
    seen

fn captured() -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    let readable: *dyn Read = value
    saved := capture(readable)
    assert_equal(saved() + saved(), 14, reason="both calls keep the captured trait reference")
    seen

fn wrapped() -> Weak[i32]?:
    value := box(+7)
    seen := link(value)
    saved := keep(Handle(value))
    _ := saved()
    _ := saved()
    seen

tests:
    it("function variance settles moved and live counted arguments"):
        for nested in [false, true]:
            assert(expired(adapted_plain(nested)), reason="plain variance leaves no orphan owner")
            assert(
                expired(adapted_plain_live(nested)),
                reason="a live plain caller releases its owner",
            )
            assert(expired(adapted_cold!(nested)), reason="cold variance leaves no orphan owner")
            assert(
                expired(adapted_cold_live!(nested)),
                reason="a live cold caller releases its owner",
            )

    it("nominal function inputs preserve the borrowed reference convention"):
        for live in [false, true]:
            assert(expired(nominal_view(live)), reason="a nominal view leaves no orphan owner")

    it("anonymous code uses the same reference contract as function adapters"):
        assert(expired(anonymous_capture()), reason="the anonymous creator leaves no orphan owner")
        for complete in [false, true]:
            assert(
                expired(anonymous_weakening!(complete)),
                reason="anonymous cold code settles its owner",
            )

    it("an escaped cold variance frame holds its argument until it settles"):
        for nested in [false, true]:
            for cancel in [false, true]:
                assert(
                    expired(settle_variance!(nested, cancel)),
                    reason="the settled frame leaves no owner",
                )

    it("completion releases the last strong argument and result"):
        for generic in [false, true]:
            seen := complete!(generic)
            assert(expired(seen), reason="completion leaves no orphan owner")

    it("cold cancellation releases the last strong argument"):
        for generic in [false, true]:
            seen := cancel!(generic)
            assert(expired(seen), reason="cancellation leaves no orphan owner")

    it("a dependent local result keeps its counted source until its last use"):
        assert(expired(projected()), reason="the last dependent read releases its origin")

    it("ordinary captures preserve fat references and nominal wrappers"):
        assert(expired(captured()), reason="the final fat capture owner is released")
        assert(expired(wrapped()), reason="the final newtype capture owner is released")
