# test: weakened cold function values release their counted reference argument exactly once
# Spec functions: fn.type.suspend.weaken and fn.type.suspend.ctor. The checked runs' audit fails on
# a leaked owner, and a freed referent's poison fails each read.
use std.annotation.cold
use std.testing.assert_equal

@cold
fn echo!(value: *i32) -> *i32:
    value

@cold
fn generic_echo![T](value: T) -> T:
    value

@cold
fn read(value: &i32) -> i32:
    *value

@cold
fn read_cold!(value: &i32) -> i32:
    *value

fn plain_view(nested: bool) -> fn(*i32) -> i32:
    if nested:
        let source: List[fn(&i32) -> i32] = [read]
        let viewed: List[fn(*i32) -> i32] = source
        viewed[0]
    else:
        read

fn cold_view(nested: bool) -> fn!(*i32) -> i32:
    if nested:
        let source: List[fn!(&i32) -> i32] = [read_cold]
        let viewed: List[fn!(*i32) -> i32] = source
        viewed[0]
    else:
        read_cold

@cold
fn invoke[T](call: fn(T) -> i32, value: T) -> i32:
    call(value)

fn adapted_plain(nested: bool) -> void:
    value := box(+7)
    adapted := plain_view(nested)
    assert_equal(invoke(adapted, value), 7, reason="contravariant lending reads the argument")

fn adapted_plain_live(nested: bool) -> void:
    value := box(+7)
    adapted := plain_view(nested)
    assert_equal(invoke(adapted, value), 7, reason="contravariant lending reads the argument")
    assert_equal(*value, 7, reason="a live caller keeps its owner")

fn adapted_cold!(nested: bool) -> void:
    value := box(+7)
    adapted := cold_view(nested)
    assert_equal(adapted!(value), 7, reason="contravariant lending reads the argument")

fn adapted_cold_live!(nested: bool) -> void:
    value := box(+7)
    adapted := cold_view(nested)
    assert_equal(adapted!(value), 7, reason="contravariant lending reads the argument")
    assert_equal(*value, 7, reason="a live caller keeps its owner")

type View[+T](T)

@cold
fn read_view(value: View[&i32]) -> i32:
    7

fn nominal_view(live: bool) -> void:
    value := box(+7)
    let adapted: fn(View[*i32]) -> i32 = read_view
    assert_equal(
        adapted(View(value)),
        7,
        reason="a closed nominal input uses the common reference ABI",
    )
    assert_equal(invoke(adapted, View(value)), 7, reason="nominal reference views keep their ABI")
    if live:
        assert_equal(*value, 7, reason="a nominal view does not take a live caller's owner")

fn anonymous_capture() -> void:
    value := box(+7)
    let make: fn(*i32) -> fn() -> i32 = fn(item: *i32) -> fn() -> i32:
        fn() -> i32: *item
    saved := make(value)
    assert_equal(saved() + saved(), 14, reason="an anonymous creator copies its borrowed argument")

fn anonymous_weakening!(complete: bool) -> void:
    value := box(+7)
    let cold: fn!(*i32) -> *i32 = fn!(item: *i32) -> *i32: item
    let ctor: fn(*i32) -> Suspend[*i32] = cold
    pending := ctor(value)
    if complete:
        assert_equal(*pending!(), 7, reason="anonymous weakening preserves its owned result")
    else:
        _ := pending.cancel!()

@cold
fn escaping_variance(nested: bool) -> Suspend[i32]:
    value := box(+7)
    let ctor: fn(*i32) -> Suspend[i32] = cold_view(nested)
    ctor(value)

fn settle_variance!(nested: bool, cancel: bool) -> void:
    pending := escaping_variance(nested)
    if cancel:
        _ := pending.cancel!()
    else:
        assert_equal(
            pending!(),
            7,
            reason="polling after the lifetime check still reads the referent",
        )

fn make(generic: bool) -> Suspend[*i32]:
    value := box(+7)
    let call: fn(*i32) -> Suspend[*i32] = if generic: generic_echo else: echo
    call(value)

fn complete!(generic: bool) -> void:
    pending := make(generic)
    value := pending!()
    assert_equal(*value, 7, reason="the weakened call preserves its result")

fn cancel!(generic: bool) -> void:
    pending := make(generic)
    _ := pending.cancel!()

trait Read:
    fn read(self) -> i32

impl Read for i32:
    fn read(self) -> i32:
        self

type Handle(*i32)

@cold
fn capture(value: *dyn Read) -> fn() -> i32:
    fn() -> i32: value.read()

@cold
fn keep[T < 'static](value: T) -> fn() -> T:
    fn() -> T: value

@cold
fn project(value: &i32) -> &i32:
    value

fn projected() -> void:
    value := box(+7)
    borrowed := project(value)
    assert_equal(*borrowed, 7, reason="a dependent result keeps its counted origin")

fn captured() -> void:
    value := box(+7)
    let readable: *dyn Read = value
    saved := capture(readable)
    assert_equal(saved() + saved(), 14, reason="both calls keep the captured trait reference")

fn wrapped() -> void:
    value := box(+7)
    saved := keep(Handle(value))
    _ := saved()
    _ := saved()

tests:
    it("function variance settles moved and live counted arguments"):
        for nested in [false, true]:
            adapted_plain(nested)
            adapted_plain_live(nested)
            adapted_cold!(nested)
            adapted_cold_live!(nested)

    it("nominal function inputs preserve the borrowed reference convention"):
        for live in [false, true]:
            nominal_view(live)

    it("anonymous code uses the same reference contract as function adapters"):
        anonymous_capture()
        for complete in [false, true]:
            anonymous_weakening!(complete)

    it("an escaped cold variance frame holds its argument until it settles"):
        for nested in [false, true]:
            for cancel in [false, true]:
                settle_variance!(nested, cancel)

    it("completion releases the last strong argument and result"):
        for generic in [false, true]:
            complete!(generic)

    it("cold cancellation releases the last strong argument"):
        for generic in [false, true]:
            cancel!(generic)

    it("a dependent local result keeps its counted source until its last use"):
        projected()

    it("ordinary captures preserve fat references and nominal wrappers"):
        captured()
        wrapped()
