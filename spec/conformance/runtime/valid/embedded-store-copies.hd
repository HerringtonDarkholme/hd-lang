# test: assigning an embedded field of a mut value stores a copy
use std.testing.assert_equal

data Timestamps:
    created_at: i32
    pub updated_at: i32

impl Timestamps:
    pub fn touch(mut self, at: i32) -> void:
        self.updated_at = at

data Post:
    Timestamps
    id: string
    title: string

tests:
    it("store copies"):
        let mut post = Post { Timestamps: ...Timestamps { created_at: 1, updated_at: 1 }, id: "p", title: "t" }
        let mut stamps = Timestamps { created_at: 2, updated_at: 2 }
        post.Timestamps ...= stamps
        post.touch(9)
        assert_equal(post.updated_at, 9, reason="the stored part changed")
        assert_equal(stamps.updated_at, 2, reason="the stored value is a copy")
