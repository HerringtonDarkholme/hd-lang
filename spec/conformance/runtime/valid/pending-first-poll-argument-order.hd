# fixture-runtime-profile: tick
# fixture-runtime-scenario: pending-first-poll
# test: suspending calls as arguments run left to right when each host call is pending first
use std.testing.assert_equal

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

let order = +0

fn mark!(id: i32) -> i32 $ Console + Tick:
    let mut console = $.use(Console)
    $.use(Tick).tick!("mark ${id}\n")
    _ := console.write_sync("mark ${id}\n")
    order = order * 10 + id
    id

fn add!(left: i32, right: i32) -> i32:
    left + right

fn sum!(first: i32, second: i32, third: i32) -> i32:
    first + second + third

pub fn main!() -> void $ Console + Tick:
    assert_equal(add!(mark!(1), mark!(2)), 3, reason="the nested results add")
    assert_equal(order, 12, reason="the first argument runs before the second")
    assert_equal(
        sum!(mark!(3), add!(mark!(4), mark!(5)), mark!(6)),
        18,
        reason="nested arguments add",
    )
    assert_equal(order, 123456, reason="arguments run in source order")
