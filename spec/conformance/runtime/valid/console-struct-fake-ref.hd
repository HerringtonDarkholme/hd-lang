# test: a program's own struct serves as a Console test fake: its &mut self methods implement Console's &mut self methods and it is installed as `&mut fake`; MemoryConsole::new returns a new object that the installed provider and the test share
# Spec std/console Buffer Console: std-console.buffer.install-ref, std-console.buffer.output-text, std-console.buffer.error-text; lang/11 req.ref.key.reference-values, req.ref.install-ref.
# expect: test
use std.console.{MemoryConsole, eprintln}

struct Numbered:
    lines: List[string]
    next: i32

impl Console for Numbered:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.next = self.next + 1
        self.lines.push("${self.next}: ${text}")
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write!("error: ${text}")

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")
    eprintln("greeted ${name}")

tests:
    use std.testing.assert_equal

    it("records into the caller's struct"):
        let mut fake = Numbered { lines: [], next: 0 }
        $.with(Console=&mut fake):
            greet("Ada")
        assert_equal(
            fake.lines,
            ["1: hello, Ada", "2: \n", "3: error: greeted Ada\n"],
            reason="three chunks, in order, numbered by the struct",
        )
        copy := fake
        fake.lines.clear()
        assert_equal(copy.next, 3, reason="a copy keeps the count")
        assert_equal(copy.lines.len(), 3, reason="a copy is its own value")

    it("a MemoryConsole is one object behind &mut"):
        console := MemoryConsole::new()
        same := console
        $.with(Console=console):
            greet("Bo")
        $.with(Console=same):
            println("again")
        assert_equal(
            console.output(),
            ["hello, Bo", "\n", "again", "\n"],
            reason="both scopes wrote to the one object",
        )
        assert_equal(same.error_output(), ["greeted Bo\n"], reason="error lines apart")
        assert_equal(console is same, true, reason="one place")
