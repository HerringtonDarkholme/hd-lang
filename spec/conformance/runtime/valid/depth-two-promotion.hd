# test: promotion reaches fields and inherent methods two embedding levels down
# Spec 03 Promotion: names.part.definition, names.part.depth,
# names.promote.member, names.members.considered,
# names.field-lookup.select, names.method-lookup.inherent,
# names.method-lookup.inherent.by-name, names.method-lookup.candidates,
# names.method-lookup.promoted-candidate, names.method-lookup.one,
# names.promoted.path.
data Core:
    pub value: i32

impl Core:
    pub fn doubled(self) -> i32:
        self.value * 2

data Middle:
    Core

data Outer:
    Middle

tests:
    use std.testing.assert_equal

    it("depth-two field and method"):
        outer := Outer { Middle: ...Middle { Core: ...Core { value: 21 } } }
        assert_equal(outer.value, 21, reason="depth-two field")
        assert_equal(outer.doubled(), 42, reason="depth-two method")
