# test: ScriptedHttp keys on parsed URL Display, answers every method and records bodies independently
# expect: test
use std.http.{Http, HttpError, Request, Response, ScriptedHttp, Url, get}
fn status!(url: string) -> u16 $ Http:
    match get!(url):
        .Ok(response) => response.status.code()
        .Err(_) => 0

fn latest_release!(repo: string) -> Result[string, HttpError] $ Http:
    response := Request::get(Url::parse("https://api.github.com/repos/${repo}/releases/latest")?)
        .send!()?
    if response.status != .Ok:
        return .Err(.Other("status ${response.status.code()}"))
    .Ok(response.text()?)

tests:
    use std.testing.assert_equal

    it("reads the scripted status"):
        http := ScriptedHttp::new()
        http.reply("https://example.com/", .Ok(Response::status(.NoContent)))
        $.with(Http=http):
            assert_equal(status!("https://example.com/"), 204, reason="scripted")
        assert_equal(http.received().len(), 1, reason="one request")

    it("a 404 is an ordinary send response"):
        http := ScriptedHttp::new()
        http.reply(
            "https://api.github.com/repos/hd/hd/releases/latest",
            .Ok(Response::status(.NotFound)),
        )
        $.with(Http=http):
            assert_equal(
                latest_release!("hd/hd"),
                .Err(HttpError.Other("status 404")),
                reason="status is data",
            )

    it("answers every method and records independently readable request bodies"):
        http := ScriptedHttp::new()
        http.reply("https://example.com/", .Ok(Response::status(.Ok).set_text("hi")))
        posted := Request::post(Url::parse("https://example.com/").expect("fixture URL"))
            .set_bytes([1])
        $.with(Http=http):
            match posted.send!():
                .Ok(response) => assert_equal(response.text(), .Ok("hi"), reason="scripted body")
                .Err(_) => assert_equal(true, false, reason="a scripted URL answers")
            assert_equal(status!("https://example.com/"), 200, reason="GET too")
        sent := http.received()
        assert_equal(sent.len(), 2, reason="in order")
        assert_equal(sent[0].method, .Post, reason="first request")
        assert_equal(sent[0].bytes(), .Ok([1]), reason="recorded body is independent of sending")
        assert_equal(sent[1].method, .Get, reason="second request")
        assert_equal(sent[1].bytes(), .Ok([]), reason="empty GET body")
