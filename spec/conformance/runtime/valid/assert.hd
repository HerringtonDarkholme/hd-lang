# Spec 10 Standard Testing: module.testing.exports, module.testing.reason.
let order = +0

fn ordered_condition() -> bool:
    order = order + 1
    order == 2

fn ordered_reason() -> string:
    order = order + 1
    "condition should run after this named reason"

tests:
    use std.testing.assert

    it("assert accepts a true condition"):
        assert(1 + 1 == 2, reason="integer addition remains consistent")

    it("assert preserves source evaluation order"):
        assert(reason=ordered_reason(), condition=ordered_condition())
