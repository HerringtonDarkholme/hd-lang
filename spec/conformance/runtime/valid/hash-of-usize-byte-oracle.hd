# test: usize hashing matches an independent four-byte FNV-1a oracle at boundaries and scattered keys
# Spec std Hash: std-hash.bytes.integer, std-hash.default.algorithm, std-hash.hash-of-local.
use std.hash.hash_of
use std.testing.assert_equal

fn byte_oracle(value: usize) -> u64:
    let hash: u64 = 14695981039346656037
    let rest = u64(value)
    for _ in 0..4:
        hash = (hash ^ (rest & 255)).wrapping_mul(1099511628211)
        rest = rest >> 8
    hash

fn scattered(index: usize) -> usize:
    usize((u64(index) * 2654435761) % 4294967291)

tests:
    it("hashes byte, sign-bit and maximum boundaries"):
        let edges: List[usize] = [
            0,
            1,
            2,
            254,
            255,
            256,
            257,
            65535,
            65536,
            2147483647,
            2147483648,
            4294967294,
            4294967295,
        ]
        for value in edges:
            assert_equal(hash_of(value), byte_oracle(value), reason="four little-endian bytes")

    it("hashes the first and last thousand scattered keys"):
        let count: usize = 1000
        for index in 0..count:
            value := scattered(index)
            assert_equal(hash_of(value), byte_oracle(value), reason="first scattered keys")
        for index in 0..count:
            value := scattered(999000 + index)
            assert_equal(hash_of(value), byte_oracle(value), reason="last scattered keys")
