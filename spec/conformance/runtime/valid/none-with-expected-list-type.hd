# test: an expected optional element type lets .None sit beside present values
# expect: test

tests:
    use std.testing.assert_equal

    it("an expected type types .None"):
        let values: List[i32?] = [1, .None]
        assert_equal(values.len(), 2, reason="two elements")
        assert_equal(values[1], .None, reason="the second element is absent")
