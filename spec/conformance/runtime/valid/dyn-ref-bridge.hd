# test: a struct's `&mut self` method is called through `&mut dyn`, changing the caller's place or a new object written `&mut Tally { ... }`
# Spec 09 Trait Value References: trait.dyn.ref.share, trait.dyn.ref.member.
# expect-stdout: 2 2
# expect-stdout: 1
trait Counter:
    fn bump(&mut self) -> void
    fn total(self) -> i32

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1
    fn total(self) -> i32:
        self.n

pub fn main() -> void $ Console:
    let mut tally = Tally { n: 0 }
    let counter: &mut dyn Counter = &mut tally
    counter.bump()
    counter.bump()
    println("${tally.n} ${counter.total()}")
    let fresh: &mut dyn Counter = &mut Tally { n: 0 }
    fresh.bump()
    println("${fresh.total()}")
