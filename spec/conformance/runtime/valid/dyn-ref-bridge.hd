# test: a struct's `&mut self` method that fills a trait method declared `mut self` is called through `&mut dyn`, changing the caller's place or the new object
# Spec 09 Trait Value References: trait.dyn.ref.bridge. Spec 09 Receivers Of Struct Implementations: trait.impl.receiver-bridge.direct-or-ref.
# expect-stdout: 2 2
# expect-stdout: 0 1
trait Counter:
    fn bump(mut self) -> void
    fn total(self) -> i32

struct Tally:
    n: i32

impl Counter for Tally:
    fn bump(&mut self) -> void:
        self.n += 1
    fn total(self) -> i32:
        self.n

pub fn main() -> void $ Console:
    let mut tally = Tally { n: 0 }
    let counter: &mut dyn Counter = &mut tally
    counter.bump()
    counter.bump()
    println("${tally.n} ${counter.total()}")
    let fresh = Tally { n: 0 }
    let copied: &mut dyn Counter = fresh
    copied.bump()
    println("${fresh.n} ${copied.total()}")
