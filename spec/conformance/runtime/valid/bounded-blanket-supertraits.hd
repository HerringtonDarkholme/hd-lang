# test: bounded blanket supertraits

use std.testing.assert_equal

trait Score:
    fn score(self) -> i32

trait Measure:
    fn measure(self) -> i32

trait Scored < Measure:
    fn marker(self) -> i32

data Point:
    value: i32

impl Score for Point:
    fn score(self) -> i32: self.value

impl[Item < Score] Measure for list[Item]:
    fn measure(self) -> i32: self[0].score()

impl[Item < Score] Scored for list[Item]:
    fn marker(self) -> i32: 0

fn dynamic_parent_dictionary() -> i32:
    let points: list[Point] = [Point { value: 42 }]
    let dynamic: Scored = points
    dynamic.measure()

fn read_parent[T < Scored](value: T) -> i32:
    value.measure()

fn bounded_parent_dictionary() -> i32:
    let points: list[Point] = [Point { value: 42 }]
    read_parent(points)

test "dynamic_parent_dictionary returns 42":
    assert_equal(dynamic_parent_dictionary(), 42, reason="bounded blanket supertraits")

test "bounded_parent_dictionary returns 42":
    assert_equal(bounded_parent_dictionary(), 42, reason="bounded blanket supertraits")
