# test: @derive(Debug) on a newtype writes its constructor call around the base type's Debug text
# Spec 09 Derived Newtypes: trait.derive.newtype.templated; std-format.debug.source.newtype.
use std.testing.assert_equal

@derive(Debug)
type Meters(i64)

tests:
    it("debug of the newtype is its constructor call"):
        let distance: i64 = 3
        assert_equal(debug(Meters(distance)), "Meters(${debug(distance)})", reason="the base implementation is applied inside the call")
