# test: pointer loans: a `&mut` to a field of a local struct, returned by a method; an alias writes the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision no *T; call-scoped fallback allowed; Go model runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

impl Cell:
    fn slot_mut(&mut self) -> &mut string:
        &mut self.value

fn probe(alias: *mut Cell) -> string:
    let mut own = Cell { value: orig(), other: second() }
    r := own.slot_mut()
    alias.value = fresh()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    other := make()
    seen := probe(other)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
