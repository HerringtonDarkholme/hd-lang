# expect-stdout: won stopped
# expect-stdout: loser closing, loser closed, racer defer, cancel finished
# test: a cancel that reaches a race! while a loser's dispose! waits continues that dispose inside the cleanup of the race's task, and a cancel!() of that task waits for it
# Spec lang/11 Standard Combinators: req.combinator.race-outer-cancel.
use std.ops.Disposable
use std.task.{all, race}
use std.time.{Clock, ms, s, sleep}

struct Conn:
    log: *mut List[string]
    closing: mut Suspend[void]

impl Disposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("loser closing")
        let mut wait = self.closing
        wait!()
        self.log.push("loser closed")

fn slow!(log: *mut List[string]) -> string $ Clock:
    using conn = &mut Conn { log: log, closing: sleep(ms(5)) }
    sleep!(s(60))
    "late"

fn ready!() -> string:
    "won"

fn racer!(log: *mut List[string]) -> string $ Clock:
    defer:
        log.push("racer defer")
    winner := race!(slow(log), ready())
    log.push("racer got ${winner}")
    winner

fn stopper!(job: mut Suspend[string], log: &mut List[string]) -> string $ Clock:
    sleep!(ms(1))
    match job.cancel!():
        .Finished => log.push("cancel finished")
        .Abandoned => log.push("cancel abandoned")
    "stopped"

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    let job: mut Suspend[string] = racer(&mut log)
    let (winner, stopped) = all!(race(job, ready()), stopper(job, &mut log))
    println("${winner} ${stopped}")
    println(log.join(", "))
