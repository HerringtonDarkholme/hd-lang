# test: a streaming Sha256 gives the one-shot digest however the message is split, including at block boundaries
# Spec std/digest SHA-256: std-digest.sha256.decl-struct, std-digest.sha256.new-ref, std-digest.sha256.update-ref, std-digest.sha256.finish, std-digest.sha256.oneshot (task #481).
use std.digest.{Sha256, sha256}

fn counting(size: usize) -> List[u8]:
    let mut bytes: List[u8] = []
    for index in 0..size:
        bytes.push(u8(index * 7 + 3))
    bytes

fn slice(bytes: List[u8], from: usize, to: usize) -> List[u8]:
    let mut part: List[u8] = []
    for index in from..to:
        part.push(bytes[index])
    part

fn repeated(byte: u8, count: usize) -> List[u8]:
    let mut bytes: List[u8] = []
    for _ in 0..count:
        bytes.push(byte)
    bytes

fn split_at(bytes: List[u8], cut: usize) -> bool:
    streamed := Sha256::new().update(slice(bytes, 0, cut)).update(slice(bytes, cut, bytes.len())).finish()
    streamed == sha256(bytes)

fn one_at_a_time(bytes: List[u8]) -> bool:
    hasher := Sha256::new()
    for byte in bytes:
        hasher.update([byte])
    hasher.finish() == sha256(bytes)

tests:
    use std.testing.{assert, assert_equal}

    it("finishing an empty hasher"):
        assert_equal(Sha256::new().finish().to_hex(), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", reason="the empty message")
        assert(Sha256::new().update([]).finish() == sha256([]), reason="an empty update changes nothing")

    it("the NIST vectors in one update"):
        assert_equal(Sha256::new().update([97, 98, 99]).finish().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", reason="abc")
        text := "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes().collect()
        assert_equal(Sha256::new().update(text).finish().to_hex(), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", reason="448 bits")

    it("the NIST vectors one byte at a time"):
        assert(one_at_a_time([97, 98, 99]), reason="abc")
        text := "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes().collect()
        assert(one_at_a_time(text), reason="448 bits")
        assert_equal(Sha256::new().update([97, 98, 99]).finish().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", reason="abc again")

    it("a split at every offset around the block boundaries"):
        bytes := counting(130)
        for cut in usize(0)..usize(131):
            assert(split_at(bytes, cut), reason="a split at " + cut.to_string())

    it("messages that end near a block boundary"):
        for size in [usize(0), 1, 54, 55, 56, 57, 63, 64, 65, 119, 120, 127, 128, 129]:
            bytes := counting(size)
            assert(one_at_a_time(bytes), reason="one byte at a time, size " + size.to_string())
            assert(split_at(bytes, size / 2), reason="halves, size " + size.to_string())

    it("many updates of mixed sizes"):
        bytes := counting(1000)
        hasher := Sha256::new()
        let at: usize = 0
        let step: usize = 1
        while at < bytes.len():
            to := if at + step < bytes.len(): at + step else: bytes.len()
            hasher.update(slice(bytes, at, to))
            at = to
            step = step + 3
        assert(hasher.finish() == sha256(bytes), reason="updates of growing size")

    it("finish leaves the hasher unchanged"):
        hasher := Sha256::new()
        hasher.update([97])
        first := hasher.finish()
        assert(hasher.finish() == first, reason="finishing twice")
        hasher.update([98, 99])
        assert_equal(hasher.finish().to_hex(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", reason="more bytes after finish")

    it("the one-shot digest is the streaming digest"):
        bytes := counting(200)
        assert(sha256(bytes) == Sha256::new().update(bytes).finish(), reason="same digest")
