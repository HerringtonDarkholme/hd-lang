# test: main maps an error to ExitCode(2), and a Result's .Err reports 1
# Spec 10 Exit Status: module.entry.termination.exit-code, module.entry.termination.err-one, module.entry.termination.ok.
# expect-stdout: done
use std.process.{ExitCode, Termination}

@error
enum ReportFailure:
    Failed

enum CliError:
    Usage(string)
    Failed(string)

fn run(args: List[string]) -> Result[void, CliError]:
    if args.len() == 0: .Err(.Usage("usage: tool FILE"))
    else if args[0] == "fail": .Err(.Failed("cannot read ${args[0]}"))
    else: .Ok(())

fn exit_for(result: Result[void, CliError]) -> ExitCode:
    match result:
        .Ok(_) => ExitCode(0)
        .Err(.Usage(_)) => ExitCode(2)
        .Err(.Failed(_)) => ExitCode(1)

pub fn main() -> ExitCode $ Console:
    result := run(["file.txt"])
    println("done")
    exit_for(result)

tests:
    use std.testing.assert_equal

    it("a usage error maps to 2"):
        assert_equal(u8(exit_for(run([]))), 2, reason="main picks the usage code")

    it("another error maps to 1"):
        assert_equal(u8(exit_for(run(["fail"]))), 1, reason="main picks the failure code")

    it("an Err result reports 1"):
        let result: Result[void, ReportFailure] = .Err(.Failed)
        assert_equal(u8(result.report()), 1, reason="Termination reports 1 for .Err")
