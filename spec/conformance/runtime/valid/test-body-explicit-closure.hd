# test: an explicit closure body keeps its own Termination result
# Spec 05 Propagation In Test Blocks: expr.try.test.explicit-closure. Result[void, string]
# implements Termination, and .Ok(()) reports ExitCode(0).
fn check_port(port: i32) -> Result[void, string]:
    if port > 0: .Ok(()) else: .Err("bad port")

tests:
    it("a string error result", body=fn!() -> Result[void, string]: check_port(8080))
