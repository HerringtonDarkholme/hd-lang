# test: an explicit closure body keeps its own Termination result
# Spec 05 Propagation In Test Blocks: expr.try.test.explicit-closure. Result[void, PortError]
# implements Termination, and .Ok(()) reports ExitCode(0).
@error
enum PortError:
    Bad

fn check_port(port: i32) -> Result[void, PortError]:
    if port > 0: .Ok(()) else: .Err(.Bad)

tests:
    it("a typed error result", body=fn!() -> Result[void, PortError]: check_port(8080))
