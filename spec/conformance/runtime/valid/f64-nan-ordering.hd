# test: an unordered comparison makes all four relational operators false
use std.testing.assert

tests:
    it("NaN is unordered against a number"):
        let nan: f64 = 0.0 / 0.0
        assert(!(nan < 1.0), reason="NaN < 1.0 is false")
        assert(!(nan <= 1.0), reason="NaN <= 1.0 is false")
        assert(!(nan > 1.0), reason="NaN > 1.0 is false")
        assert(!(nan >= 1.0), reason="NaN >= 1.0 is false")
        assert(!(1.0 < nan), reason="1.0 < NaN is false")
        assert(!(1.0 >= nan), reason="1.0 >= NaN is false")

    it("NaN is unordered against itself"):
        let nan: f64 = 0.0 / 0.0
        assert(!(nan < nan), reason="NaN < NaN is false")
        assert(!(nan <= nan), reason="NaN <= NaN is false")
        assert(!(nan > nan), reason="NaN > NaN is false")
        assert(!(nan >= nan), reason="NaN >= NaN is false")
