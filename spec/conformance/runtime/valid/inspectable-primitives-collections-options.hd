# test: primitives, string, lists, maps, tuples, and optionals of inspectable types erase to Inspectable and come back exactly
# Spec 09 Inspectable Types: trait.inspectable.primitive, trait.inspectable.collections, trait.inspectable.option, trait.inspectable.exact.
# Spec 09 Recovering A Concrete Type: trait.downcast.copy-through-reference, trait.downcast.exact.reference-values, trait.downcast.optional-local-reference; Ordinary Rules: trait.downcast.reference-methods.reference-values.
use std.inspect.{Inspectable}
struct Sku:
    code: string

fn stock_of(value: *dyn Inspectable) -> i32:
    match value.downcast_ref::[Map[string, i32]]().map(fn(found): *found):
        .Some(stock) => stock["apple"]
        .None => -1

fn pair_of(value: *dyn Inspectable) -> string:
    match value.downcast_ref::[(i32, string)]().map(fn(found): *found):
        .Some(pair) => "${pair._0}:${pair._1}"
        .None => "none"

fn weight_of(value: *dyn Inspectable) -> f64:
    match value.downcast_ref::[f64]().map(fn(found): *found):
        .Some(weight) => weight
        .None => 0.0

fn sku_of(value: *dyn Inspectable) -> string:
    match value.downcast_ref::[Sku?]().map(fn(found): *found):
        .Some(found) =>
            match found:
                .Some(sku) => sku.code
                .None => "no sku"
        .None => "not an optional sku"

tests:
    use std.testing.assert_equal

    it("a map and a tuple come back with their exact types"):
        stock := box::[Map[string, i32]]({ "apple": 12 })
        assert_equal(stock_of(stock), 12, reason="Map[string, i32]")
        other := box::[Map[string, i64]]({ "apple": 12 })
        assert_equal(stock_of(other), -1, reason="Map[string, i64] is another type")
        pair := box::[(i32, string)]((7, "bolts"))
        assert_equal(pair_of(pair), "7:bolts", reason="a tuple of inspectable elements")

    it("a primitive comes back by value"):
        weight := box::[f64](2.5)
        assert_equal(weight_of(weight), 2.5, reason="f64")
        assert_equal(weight_of(box("2.5")), 0.0, reason="a string is not an f64")

    it("an optional is inspectable when its payload is"):
        present := box::[Sku?](Sku { code: "A-1" })
        absent := box::[Sku?](.None)
        assert_equal(sku_of(present), "A-1", reason="Sku? gives Sku??")
        assert_equal(sku_of(absent), "no sku", reason="an erased .None keeps its type")
        assert_equal(
            sku_of(box(Sku { code: "B-2" })),
            "not an optional sku",
            reason="Sku is not Sku?",
        )
