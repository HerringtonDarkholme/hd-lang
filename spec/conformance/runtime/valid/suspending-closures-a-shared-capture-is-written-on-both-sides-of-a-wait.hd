# test: a shared capture is written on both sides of a wait
# expect-stdout: 22
# expect-stdout: 33
use std.time.{Clock, Duration, sleep}
use std.task.{all, race}

fn nap!(ms: i64) -> void $ Clock:
    sleep!(Duration::milliseconds(ms))

pub fn main!() -> void $ Console + Clock:
    let count: i32 = 0
    bump := fn!() -> void $ Clock:
        count = count + 1
        nap!(1)
        count = count + 10
    _ := all!(bump(), bump())
    println(count)
    bump!()
    println(count)
