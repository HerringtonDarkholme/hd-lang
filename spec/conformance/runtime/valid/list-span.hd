# test: a Span reads, slices, and iterates a list without copying its elements
# std Collections, Spans: std-collections.span.list, std-collections.span.get, std-collections.span.index, std-collections.span.slice, std-collections.span.iter.
use std.collections.Span

fn middle['a](items: &'a List[i32]) -> Span[i32, 'a]:
    items.span().slice(1..3)

tests:
    use std.testing.assert_equal

    it("reads and slices a list"):
        items := [+10, 20, 30, 40]
        span := items.span()
        part := middle(&items)
        inclusive := span.slice(1..=2)
        assert_equal(span.len(), 4, reason="the whole list")
        assert_equal(*span.get(1).expect("index 1"), 20, reason="get returns a reference")
        assert_equal(*span[2], 30, reason="indexing returns a reference")
        assert_equal(part.len(), 2, reason="the exclusive subspan")
        assert_equal(*part[0], 20, reason="slice indices are relative")
        assert_equal(*inclusive[1], 30, reason="the inclusive end is present")

    it("iterates by reference in order"):
        items := [+10, 20, 30, 40]
        let mut seen: List[i32] = []
        for item in items.span().slice(1..3).iter():
            seen.push(*item)
        assert_equal(seen, [+20, 30], reason="the cursor yields borrowed elements in span order")
