# test: a type with a private field crosses a host call out of hd and back in when it implements both traits, private field included, since derived serialize writes every member
# Spec Modules, Private Fields At A Boundary: module.boundary.out, module.boundary.in, module.boundary.direction, module.boundary.serialize.exact (task #320).
# fixture-runtime-profile: serde-vault
use std.serde.{Serialize, Deserialize}
use std.testing.assert_equal

@derive(Serialize, Deserialize)
pub data Token:
    pub owner: string
    secret: i64

pub trait Vault:
    fn keep(self, token: Token) -> Token

pub fn main() -> void $ Vault:
    kept := $.use(Vault).keep(Token { owner: "ada", secret: 42 })
    assert_equal(kept.owner, "ada", reason="the public field crosses")
    assert_equal(kept.secret, 42, reason="derived serialize writes the private field too")
