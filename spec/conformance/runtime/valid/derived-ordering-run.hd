# test: derived ordering is lexicographic in field order, variants compare by declaration order, and a float field makes it partial
# Spec std/cmp Derived Ordering: std-cmp.derive.ord.data, std-cmp.derive.ord.variants,
# std-cmp.derive.ord.same-variant, std-cmp.derive.ord.partial, std-cmp.derive.ord.ord.
# Spec 09 Traits: trait.derive.related.partial-ord, trait.derive.related.ord, trait.cmp.ordering.
@derive(Eq, PartialOrd, Ord)
struct Key:
    first: i32
    second: string

@derive(Eq, PartialOrd, Ord)
enum Priority:
    Low(value: i32)
    High(value: i32)
    Urgent

@derive(Eq, PartialOrd)
struct Measurement:
    value: f64

@derive(Eq, PartialOrd, Ord)
struct Empty: pass

@derive(Eq, PartialOrd)
enum Mixed:
    Fixed(value: i32)
    Floating(value: f64)

fn total[T < Ord](left: T, right: T) -> string:
    match left.cmp(right):
        .Less => "less"
        .Equal => "equal"
        .Greater => "greater"

tests:
    use std.testing.{assert, assert_equal}

    it("data fields compare in declaration order"):
        assert(
            Key { first: 1, second: "z" } < Key { first: 2, second: "a" },
            reason="the first field decides",
        )
        assert(
            Key { first: 1, second: "a" } < Key { first: 1, second: "b" },
            reason="the second field breaks a tie",
        )
        assert_equal(
            total(Key { first: 1, second: "a" }, Key { first: 1, second: "a" }),
            "equal",
            reason="Ord",
        )

    it("enum variants compare by declaration order, then payloads"):
        assert(Priority.Low(99) < Priority.High(0), reason="an earlier variant is less")
        assert(Priority.Low(2) < Priority.Low(3), reason="the same variant compares payloads")
        assert_equal(
            total(Priority.Urgent, Priority.High(5)),
            "greater",
            reason="a later variant is greater",
        )

    it("a float field leaves the ordering partial"):
        assert(Measurement { value: 1.0 } < Measurement { value: 2.0 }, reason="ordered values")
        assert(
            !(Measurement { value: 0.0 / 0.0 } < Measurement { value: 2.0 }),
            reason="NaN is unordered",
        )
        assert_equal(
            Measurement { value: 0.0 / 0.0 }.partial_cmp(Measurement { value: 2.0 }),
            .None,
            reason="partial_cmp gives .None",
        )

    it("empty structs and tuple comparisons keep their ordering"):
        assert_equal(Empty {}.cmp(Empty {}), .Equal, reason="zero fields")
        assert_equal(Empty {}.partial_cmp(Empty {}), .Some(.Equal), reason="empty partial order")
        assert_equal((+1, "a").cmp((+1, "b")), .Less, reason="tuple fields")
        assert_equal((+2, "a").partial_cmp((+1, "z")), .Some(.Greater), reason="tuple first field")

    it("different variants order without comparing NaN payloads"):
        nan := 0.0 / 0.0
        assert_equal(
            Mixed.Fixed(99).partial_cmp(Mixed.Floating(nan)),
            .Some(.Less),
            reason="declaration order wins",
        )
        assert_equal(
            Mixed.Floating(nan).partial_cmp(Mixed.Fixed(99)),
            .Some(.Greater),
            reason="reverse variant order",
        )
        assert_equal(
            Mixed.Floating(nan).partial_cmp(Mixed.Floating(1.0)),
            .None,
            reason="same variant compares its payload",
        )
