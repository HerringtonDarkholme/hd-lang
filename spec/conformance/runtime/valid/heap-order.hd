# test: a Heap pops its largest element first, peeks without removing, and copies its elements in ascending order
# Spec std/collections Heap: std-collections.heap.len, std-collections.heap.push, std-collections.heap.pop, std-collections.heap.peek, std-collections.heap.sorted (COLLECTIONS-DATES-SURFACE; task #225).
use std.collections.Heap
fn drained(heap: &mut Heap[i32]) -> List[i32]:
    let mut popped: List[i32] = []
    while true:
        match heap.pop():
            .Some(value) => popped.push(value)
            .None => return popped

tests:
    use std.testing.{assert, assert_equal}

    it("largest first"):
        let mut heap: Heap[i32] = Heap::new()
        assert(heap.is_empty(), reason="new is empty")
        for value in [5, 1, 8, 3, 9, 2, 8, -4]:
            heap.push(value)
        assert_equal(heap.len(), 8, reason="eight elements")
        assert_equal(heap.peek(), .Some(9), reason="peek")
        assert_equal(heap.len(), 8, reason="peek removes nothing")
        assert_equal(drained(&mut heap), [9, 8, 8, 5, 3, 2, 1, -4], reason="descending")
        assert_equal(heap.pop(), .None, reason="an empty pop")
        assert_equal(heap.peek(), .None, reason="an empty peek")

    it("pushes after pops"):
        let mut heap: Heap[i32] = Heap::new()
        for value in [+4, 7, 1]:
            heap.push(value)
        assert_equal(heap.pop(), .Some(7), reason="the largest")
        heap.push(6)
        heap.push(0)
        assert_equal(drained(&mut heap), [6, 4, 1, 0], reason="the rest, descending")

    it("to_sorted_list copies in ascending order"):
        let mut heap: Heap[string] = Heap::new()
        for word in ["pear", "apple", "fig"]:
            heap.push(word)
        assert_equal(heap.to_sorted_list(), ["apple", "fig", "pear"], reason="ascending")
        assert_equal(heap.len(), 3, reason="the heap is unchanged")
        assert_equal(heap.pop(), .Some("pear"), reason="still a max-heap")

    it("empty and singleton heaps can be refilled repeatedly"):
        let mut heap: Heap[i32] = Heap::new()
        for value in [+4, -2, 4, 0]:
            assert_equal(heap.pop(), .None, reason="empty before refill")
            heap.push(value)
            assert_equal(heap.peek(), .Some(value), reason="singleton peek")
            assert_equal(heap.pop(), .Some(value), reason="singleton pop")
            assert(heap.is_empty(), reason="empty after singleton pop")

    it("sifting handles either child and duplicate parents at every size"):
        for size in 0..40:
            let mut heap: Heap[i32] = Heap::new()
            let mut source: List[i32] = []
            for index in 0..size:
                value := i32((index * 17 + 3) % 11) - 5
                source.push(value)
                heap.push(value)
            assert_equal(heap.to_sorted_list(), source.sorted(), reason="all values retained")
            assert_equal(
                drained(&mut heap),
                source.sorted().reversed(),
                reason="descending through odd and even sizes",
            )

    it("copies and sorted lists stay independent during later sifts"):
        let mut original = [+3, 9, 2, 9, -1].iter().collect::[Heap[i32]]()
        let mut copy = original
        let mut sorted = original.to_sorted_list()
        assert_equal(original.pop(), .Some(9), reason="remove from original")
        original.push(12)
        copy.push(7)
        assert_equal(copy.pop(), .Some(9), reason="copy retained both maxima")
        sorted[0] = -99
        assert_equal(
            drained(&mut original),
            [+12, 9, 3, 2, -1],
            reason="original has only its own writes",
        )
        assert_equal(drained(&mut copy), [+9, 7, 3, 2, -1], reason="copy has only its own writes")
        assert_equal(sorted, [-99i32, 2, 3, 9, 9], reason="sorted list has only its own writes")
