# test: it is an ordinary function whose body may be passed by name
# Spec 10 Test Cases: it's options are defaulted parameters before its final body parameter.
use std.testing.assert_equal

tests:
    it("takes a trailing block"):
        assert_equal(1 + 1, 2, reason="the trailing block is the body")

    it("takes a named body", body=fn!(): assert_equal(2 + 2, 4, reason="the named argument is the body"))
