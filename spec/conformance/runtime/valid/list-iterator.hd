tests:
    use std.testing.assert

    it("list iterator yields values, then .None"):
        let mut values: List[i32] = [20, 22]
        let mut iterator = values.iter()
        let first: i32? = 20
        let second: i32? = 22
        let exhausted: i32? = .None
        assert(iterator.next() == first, reason="the first call yields the first value")
        assert(iterator.next() == second, reason="the second call yields the second value")
        assert(iterator.next() == exhausted, reason="an exhausted iterator returns .None")

    it("element replacement leaves an iterator on its snapshot"):
        let mut values: List[i32] = [1, 2]
        let mut iterator = values.iter()
        let first: i32? = 1
        let second: i32? = 2
        assert(iterator.next() == first, reason="the iterator advances before replacement")
        values[1] = 42
        assert(iterator.next() == second, reason="the iterator yields the list as iter found it")
        assert(values[1] == 42, reason="the list itself has the replacement")

    it("for continues from a partly consumed mutable iterator"):
        let mut values: List[i32] = [20, 21, 22]
        let mut iterator = values.iter()
        let first: i32? = 20
        assert(iterator.next() == first, reason="the explicit call consumes the first value")
        let total = +0
        for value in iterator:
            total = total + value
        assert(total == 43, reason="for uses the same cursor without resetting it")
