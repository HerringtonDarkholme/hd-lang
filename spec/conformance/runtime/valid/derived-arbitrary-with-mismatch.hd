# test: an arbitrary.with generator of the wrong type panics on the first case
# Spec 10 Derived Arbitrary: module.testing.arbitrary.with.unchecked, .with.mismatch, and
# .with.no-fallback (Testing PT2); the check passes, and the property panics when it runs.
use std.testing.{Arbitrary, Choices, it_prop}
use std.testing.arbitrary

fn label(c: mut Choices) -> string:
    c.string(max_chars=4)

@derive(Arbitrary, Debug)
data Item:
    @arbitrary.with(label)
    price: i32

tests:
    it_prop("a string generator for an i32 member panics", expect_panic="explicit-panic", prop=fn!(item: Item):
        pass
    )
