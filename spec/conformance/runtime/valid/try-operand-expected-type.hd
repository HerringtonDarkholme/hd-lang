# test: the operand of ? gets an expected type as a hint, which solves a call's open type argument
# Spec 05 Propagation: expr.try.expected, expr.try.expected.result, expr.try.expected.option, expr.try.expected.hint-only (owner decision Q-?, batch 15, 2026-09-30).
fn empty_ok[T]() -> Result[List[T], string]:
    .Ok([])

fn failed[T](message: string) -> Result[T, string]:
    .Err(message)

fn empty_some[T]() -> List[T]?:
    .Some([])

fn missing[T]() -> T?:
    .None

fn no_ports() -> Result[List[i32], string]:
    let ports: List[i32] = empty_ok()?
    .Ok(ports)

fn bad_port() -> Result[i32, string]:
    let port: i32 = failed("bad")?
    .Ok(port)

fn none_found() -> List[i32]?:
    let found: List[i32] = empty_some()?
    .Some(found)

fn not_found() -> i32?:
    let found: i32 = missing()?
    .Some(found)

tests:
    use std.testing.assert_equal

    it("a Result hint solves the type argument of an Ok producer"):
        let none: List[i32] = []
        assert_equal(no_ports(), .Ok(none), reason="the Ok payload continues")

    it("a Result hint solves the type argument of an Err producer"):
        assert_equal(bad_port(), .Err("bad"), reason="the error propagates")

    it("an optional hint solves the type argument of a producer"):
        let none: List[i32] = []
        assert_equal(none_found(), .Some(none), reason="the Some payload continues")
        assert_equal(not_found(), .None, reason="None propagates")
