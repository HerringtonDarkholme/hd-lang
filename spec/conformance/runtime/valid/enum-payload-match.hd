# test: enum payload match

use std.testing.assert_equal

enum Outcome:
    Value(value: i32)
    Failure(code: i32)
    Empty

fn read(outcome: Outcome) -> i32:
    match outcome:
        Outcome.Value(value) => value
        Outcome.Failure(code) => -code
        Outcome.Empty => 0

fn main() -> i32: read(Outcome.Value(42))

test "main returns 42":
    assert_equal(main(), 42, reason="enum payload match")
