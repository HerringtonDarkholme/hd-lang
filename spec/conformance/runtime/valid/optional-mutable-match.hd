# test: a mutable optional supplies mutable payload access through inference and matching
# Spec 04 Optional Types: types.option.invariant (a mutable payload annotation grants payload access).
use std.testing.assert_equal

data User:
    name: i32

fn find() -> mut User?: .Some(User { name: 40 })

tests:
    it("matching a mutable optional exposes its payload"):
        let mut found = find()
        match found:
            .Some(value) =>
                value.name = value.name + 2
                assert_equal(value.name, 42, reason="payload reached 42")
            .None => assert_equal(1, 2, reason="expected .Some")
