# test: compound assignment on primitive locals, list elements, and fields
# Spec 05 Compound Assignment: expr.assign.compound.primitive, expr.assign.compound.once (Operator Traits OP5, OP13).
struct Box:
    value: i32

fn run() -> i32:
    let x = +10
    x += 5
    x -= 3
    x *= 4
    x /= 6
    x %= 5
    x <<= 3
    x >>= 1
    x |= 1
    x &= 13
    x ^= 2
    x

fn bump(items: &mut List[i32], boxed: &mut Box) -> i32:
    items[1] += 10
    boxed.value *= 3
    items[1] + boxed.value

tests:
    use std.testing.assert_equal

    it("updates primitive places"):
        assert_equal(run(), 15, reason="10 + 5 - 3, * 4, / 6, % 5, << 3, >> 1, | 1, & 13, ^ 2")
        assert_equal(bump(&mut [1, 2], &mut Box { value: 4 }), 24, reason="12 + 12")
