# test: float powers are within one ULP of a reference pow
# Spec lang/05-expressions.md: expr.power.float.within-ulp.
# expect-stdout: 300 of 300 within 1 ULP

# The expected values are JavaScript's Math.pow results (Node 24), with
# finite nonzero results: ordinary magnitudes, bases near 1 with large
# exponents, negative bases with integer exponents, results near the
# overflow end, subnormal results, and bases across the exponent range.

# The largest power of two not above `size`, a positive finite value.
fn binade(size: f64) -> f64:
    let power = 1.0
    while power * 2.0 <= size:
        power = power * 2.0
    while power > size:
        power = power * 0.5
    power

# The gap from `size` to the next float above it.
fn gap_above(size: f64) -> f64:
    power := binade(size)
    if power < 2.2250738585072014e-308: 5e-324 else: power * 2.220446049250313e-16

# The gap from `size` to the next float below it.
fn gap_below(size: f64) -> f64:
    gap := gap_above(size)
    if binade(size) == size && size > 2.2250738585072014e-308: gap * 0.5 else: gap

# Whether `got` equals `want` or is a float next to it.
fn within_one_ulp(got: f64, want: f64) -> bool:
    if got == want:
        return true
    if (got < 0.0) != (want < 0.0):
        return false
    got_size := if got < 0.0: -got else: got
    want_size := if want < 0.0: -want else: want
    if got_size > want_size:
        got_size - want_size <= gap_above(want_size)
    else:
        want_size - got_size <= gap_below(want_size)

