# fixture-runtime-scenario: pending-first-poll
# test: non-suspending comprehensions propagate through a frame resumed after a pending host call
use std.testing.assert_equal

data State:
    count: i32

data Failure:
    code: i32

fn child!() -> i32 $ Console:
    let mut console = $.use(Console)
    _ := console.write_line!("child")
    40

fn parse(ok: bool) -> Result[i32, Failure]:
    if ok: .Ok(40) else: .Err(Failure { code: 7 })

fn list_run!(state: mut State, ok: bool) -> Result[List[i32], Failure] $ Console:
    defer:
        state.count = state.count + 1
    _ := child!()
    .Ok([for item in [ok] => parse(item)?])

fn map_value_run!(state: mut State, ok: bool) -> Result[Map[i32, i32], Failure] $ Console:
    defer:
        state.count = state.count + 1
    _ := child!()
    .Ok({for item in [ok] => 0: parse(item)?})

fn map_key_run!(state: mut State, ok: bool) -> Result[Map[i32, i32], Failure] $ Console:
    defer:
        state.count = state.count + 1
    _ := child!()
    .Ok({for item in [ok] => parse(item)?: 1})

fn inspect_list(value: Result[List[i32], Failure]) -> i32:
    match value:
        .Ok(actual) => i32(actual.len()) + 39
        .Err(error) => -error.code

fn inspect_map(value: Result[Map[i32, i32], Failure]) -> i32:
    match value:
        .Ok(actual) => i32(actual.len()) + 39
        .Err(error) => -error.code

pub fn main!() -> void $ Console:
    let mut state = State { count: 0 }
    assert_equal(inspect_list(list_run!(state, true)), 40, reason="the list comprehension succeeds")
    assert_equal(inspect_list(list_run!(state, false)), -7, reason="the list comprehension fails")
    assert_equal(inspect_map(map_value_run!(state, true)), 40, reason="the map value comprehension succeeds")
    assert_equal(inspect_map(map_value_run!(state, false)), -7, reason="the map value comprehension fails")
    assert_equal(inspect_map(map_key_run!(state, true)), 40, reason="the map key comprehension succeeds")
    assert_equal(inspect_map(map_key_run!(state, false)), -7, reason="the map key comprehension fails")
    assert_equal(state.count, 6, reason="defer ran once per call")
