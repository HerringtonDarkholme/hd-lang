# test: Repo[A] + Repo[B] with A and B both User is the one-key row Repo[User]
# Spec 11 Row Sets: req.row.set.once; a key occurs at most once after normalization, so a Repo[User] callable fits the field.
use std.testing.assert_equal

trait Repo[T]:
    fn count(self) -> i32

data User: pass
data UserRepo: pass

impl Repo[User] for UserRepo:
    fn count(self) -> i32: 20

data Job[A, B]:
    callback: fn() -> i32 $ Repo[A] + Repo[B]

fn count_users() -> i32 $ Repo[User]:
    $.use(Repo[User]).count()

tests:
    it("Job[User, User] holds a callable that needs only Repo[User]"):
        $.with(Repo[User]=UserRepo {}):
            let job: Job[User, User] = Job { callback: count_users }
            assert_equal((job.callback)(), 20, reason="the row is Repo[User]")
