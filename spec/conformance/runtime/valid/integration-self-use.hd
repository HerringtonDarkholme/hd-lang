# test: in an integration test module, self names the test root, so tests/checkout.hd uses tests/common.hd as self.common
# Spec 10 Relative Uses: module.relative.test-root (Batch 45 TESTS-SELF).
# fixture-package-tree: integration-self/tests/checkout.hd
use self.common.{expected}
use std.testing.assert_equal

it("uses the shared module through self"):
    assert_equal(expected(), "hi", reason="self.common is tests.common")
