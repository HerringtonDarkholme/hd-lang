# test: Debug strings preserve Unicode runs and exact escapes at every run boundary
# Spec std/format: std-format.debug.source.
tests:
    use std.testing.{assert, assert_equal}
    use std.text.process_escapes

    it("keeps long plain Unicode text unchanged"):
        text := "λ界😀 café ".repeat(128)
        assert_equal(debug(text), "\"${text}\"", reason="ordinary Unicode is copied unchanged")
        assert_equal(debug(""), "\"\"", reason="empty text")

    it("escapes the entire ASCII range as source"):
        text := "\0\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\t\n\u{b}\u{c}\r\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f} !\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u{7f}"
        shown := debug(text)
        assert(shown.starts_with("\"") && shown.ends_with("\""), reason="quoted literal")
        for byte in shown.bytes():
            assert(byte >= 32 && byte != 127, reason="controls are escaped")
        assert_equal(process_escapes(shown.slice(1, shown.len() - 1)), .Ok(text), reason="all source escapes round-trip")

    it("keeps Unicode adjacent to leading trailing and consecutive escapes"):
        assert_equal(debug("\nλ界😀"), "\"\\nλ界😀\"", reason="run boundary")
        assert_equal(debug("λ界😀\n"), "\"λ界😀\\n\"", reason="run boundary")
        assert_equal(debug("λ\n\t\r\0界"), "\"λ\\n\\t\\r\\0界\"", reason="run boundary")
        assert_equal(debug("\"\\\$\u{1f}\u{7f}😀"), "\"\\\"\\\\\\\$\\u{1f}\\u{7f}😀\"", reason="run boundary")

    it("keeps char escaping separate from string interpolation escaping"):
        assert_equal(debug('\''), "'\\''", reason="char delimiter")
        assert_equal(debug('"'), "'\"'", reason="char delimiter")
        assert_equal(debug('\\'), "'\\\\'", reason="char delimiter")
        assert_equal(debug('$'), "'\$'", reason="char delimiter")
        assert_equal(debug('\n'), "'\\n'", reason="char delimiter")
        assert_equal(debug('\u{1f}'), "'\\u{1f}'", reason="char delimiter")
        assert_equal(debug('\u{7f}'), "'\\u{7f}'", reason="char delimiter")
        assert_equal(debug('λ'), "'λ'", reason="char delimiter")
