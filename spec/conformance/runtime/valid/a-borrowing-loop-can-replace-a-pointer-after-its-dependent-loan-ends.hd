# test: the loop element can change after its dependent loan ends
# expect-stdout: a1 cccccc3
# expect-stdout: b2
struct P:
    name: string

fn name_of(p: &P) -> &string:
    &p.name

pub fn main() -> void $ Console:
    let mut ps = [box(P { name: "a${1}" })]
    for p in &ps:
        d := name_of(*p)
        junk := "cccccc${3}"
        println("${*d} $junk")
        ps[0] = box(P { name: "b${2}" })
        println(p.name)
