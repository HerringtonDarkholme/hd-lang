# test: a call through a trait value lends an owned argument, which the caller releases after the call
# Spec 09 Traits: trait.dyn.bound.reference-dispatch.
trait Sink:
    fn take(&self, text: string) -> usize

struct Counter:
    seen: usize

impl Sink for Counter:
    fn take(&self, text: string) -> usize:
        text.len() + self.seen

fn feed(sink: &dyn Sink, round: usize) -> usize:
    text := "round $round"
    sink.take(text)

tests:
    use std.testing.assert_equal

    it("each owned argument is released once"):
        counter := Counter { seen: 1 }
        let mut total = 0
        for round in 0..4:
            total += feed(&counter, round)
        assert_equal(total, 32, reason="four calls of 7 bytes plus one")
