# test: data fields named in any order
# Spec 08 Data Literals: data.literal.any-order.

data Point:
    x: i32
    y: i32

fn sum(point: Point) -> i32: point.x + point.y

fn main() -> i32:
    point := Point { y: 22, x: 20 }
    sum(point)

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(main(), 42, reason="data fields named in any order")
