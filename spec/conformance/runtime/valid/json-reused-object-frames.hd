# test: successive JSON objects retain only their own active keys and last values
# Spec std/json Encode And Decode: std-json.decode.direct, std-json.decode.no-tree, std-json.parse.object.duplicate-last, std-json.object.order.
use std.json.{decode, parse, from_json}
use std.serde.Deserialize
use std.testing.assert_equal

@derive(Deserialize, Eq, Debug)
struct Item:
    name: string
    count: usize = 7

@derive(Deserialize, Eq, Debug)
struct Group:
    items: List[Item]
    note: string?

fn same[T < Deserialize & Eq & Debug](text: string) -> void:
    expected := match parse(text):
        .Ok(value) => from_json::[T](value)
        .Err(error) => .Err(error)
    assert_equal(decode::[T](text), expected, reason=text)

tests:
    it("wide, small, empty and nested objects may reuse the same depth"):
        same::[List[Item]]("[{\"a0\":0,\"a1\":1,\"a2\":2,\"a3\":3,\"a4\":4,\"a5\":5,\"a6\":6,\"a7\":7,\"a8\":8,\"a9\":9,\"a10\":10,\"a11\":11,\"a12\":12,\"a13\":13,\"a14\":14,\"a15\":15,\"name\":\"first\",\"count\":2,\"name\":\"last\"},{\"name\":\"small\"},{\"na\\u006de\":\"escaped\",\"count\":3}]")
        same::[List[Group]]("[{\"items\":[{\"name\":\"one\",\"count\":1},{\"count\":2,\"name\":\"two\"}],\"note\":\"first\"},{\"items\":[],\"note\":null},{\"items\":[{\"name\":\"three\"}]}]")
        same::[List[Item]]("[{\"name\":\"one\",\"count\":1},{}]")

    it("maps preserve key order and duplicate-last values across frame reuse"):
        same::[List[Map[string, usize]]]("[{\"a\":1,\"b\":2,\"a\":3},{},{\"b\":4},{\"c\":5,\"b\":6,\"c\":7}]")
