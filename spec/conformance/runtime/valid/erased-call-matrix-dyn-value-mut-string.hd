# test: erased call matrix dyn-value-mut-string
# expect: test
# Generated by spec/tools/generate-erased-call-matrix.ts; edit the generator.
# Rules: trait.dyn.safe.method-type-param, ref.generic.local.
impl Item for string:
    fn value(&self) -> usize:
        self.len()
    fn bump(&mut self) -> void:
        *self = *self + "!"

fn make(round: usize) -> string:
    "word_$round"

trait Item < ?Copy:
    fn value(&self) -> usize
    fn bump(&mut self) -> void

trait Driver:
    fn run[T < ?Copy & Item](&mut self, value: T) -> T

struct Worker:
    calls: usize

impl Driver for Worker:
    fn run[T < ?Copy & Item](&mut self, value: T) -> T:
        self.calls += 1
        let mut hop = Hop {}
        let relay: &mut dyn Relay[T] = &mut hop
        relay.apply(value)

trait Relay[T < ?Copy & Item]:
    fn apply(&mut self, value: T) -> T

struct Hop: pass

impl[T < ?Copy & Item] Relay[T] for Hop:
    fn apply(&mut self, value: T) -> T:
        value

tests:
    it("dyn-value-mut-string preserves its argument and receiver"):
        for round in 0..8:
            let mut worker = Worker { calls: 0 }
            let mut item: string = make(round)
            before := item.value()
            let driver: &mut dyn Driver = &mut worker
            back := driver.run(item)
            assert_equal(back.value(), before, reason="the moved result remains usable")
            assert_equal(worker.calls, 1, reason="receiver effects reach the caller")
