# test: group_by maps each key to its elements in list order, one key per distinct result
# Spec std/collections List Helpers: std-collections.helper.group-by.
use std.testing.assert_equal

fn by_initial(words: List[string]) -> Map[string, List[string]]:
    words.group_by(fn(word: string) -> string: word.slice(0, 1))

tests:
    it("groups in list order"):
        groups := by_initial(["bean", "apple", "beet", "avocado"])
        assert_equal(groups.get("a"), .Some(["apple", "avocado"]), reason="group a")
        assert_equal(groups.get("b"), .Some(["bean", "beet"]), reason="group b")
    it("has one key per distinct result"):
        assert_equal(by_initial(["bean", "apple", "beet"]).keys().sorted(), ["a", "b"], reason="a and b")
    it("gives an empty map for an empty list"):
        assert_equal(by_initial([]).len(), 0, reason="no groups")
