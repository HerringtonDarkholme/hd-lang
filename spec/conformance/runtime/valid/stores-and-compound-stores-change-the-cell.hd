# test: stores and compound stores change the cell
# Spec 05 Callable Values: expr.assign.order.call, expr.assign.compound.call-once.
# expect-stdout: 4
# expect-stdout: 7
# expect-stdout: 28
# expect-stdout: 6
# expect-stdout: 28
use std.ops.{Apply, Update}

struct Cell:
    value: i32

impl Apply for Cell:
    type Out = i32
    fn apply(self) -> i32: self.value

impl Update[i32] for Cell:
    fn update(&mut self, value: i32) -> void:
        self.value = value

fn live(value: i32) -> Cell:
    Cell { value: value }

struct Panel:
    count: Cell
    frozen: Cell

pub fn main() -> void $ Console:
    let mut count = live(+0)
    count() = 4
    println(count())
    count() += 3
    println(count())
    count() <<= 2
    println(count())
    let mut panel = Panel { count: live(+10), frozen: live(+0) }
    (panel.count)() -= 4
    println((panel.count)())
    println(count())
