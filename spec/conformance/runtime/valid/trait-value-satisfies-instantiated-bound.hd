# test: a trait value of a generic trait satisfies a bound that names the same instantiation, and calls dispatch through its table
# Spec 09 Trait Values As Bounds: trait.dyn.bound, trait.dyn.bound.instantiation, trait.dyn.bound.dispatch.
data User:
    name: string

trait Repository[T]:
    fn count(self) -> i32

data MemoryUsers:
    users: List[User]

impl Repository[User] for MemoryUsers:
    fn count(self) -> i32:
        i32(self.users.len())

fn size[R < Repository[User]](repository: R) -> i32:
    repository.count()

tests:
    use std.testing.assert_equal

    it("Repository[User] satisfies R < Repository[User]"):
        let users: dyn Repository[User] = MemoryUsers { users: [User { name: "ada" }, User { name: "alan" }] }
        assert_equal(size(users), 2, reason="the static call dispatches through the value's table")
