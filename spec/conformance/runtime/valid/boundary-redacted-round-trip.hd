# test: a hand-written Serialize that redacts a private field keeps it from the host: the value crosses as exactly what serialize writes
# Spec Modules, Private Fields At A Boundary: module.boundary.serialize.exact, module.boundary.deserialize.exact.
# Spec 14 Serialization: annot.serde.by-hand, annot.serde.definition.
# fixture-runtime-profile: consent-vault
use std.serde.{Serialize, Serializer, Deserialize, Deserializer}
use std.testing.assert_equal

pub data Token:
    pub owner: string
    secret: i64

impl Serialize for Token:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        out.text(self.owner)

impl Deserialize for Token:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Token, R::Error]:
        .Ok(Token { owner: input.text("Token")?, secret: 0 })

pub trait Vault:
    fn keep(self, token: Token) -> Token

pub fn main() -> void $ Vault:
    kept := $.use(Vault).keep(Token { owner: "ada", secret: 42 })
    assert_equal(kept.owner, "ada", reason="the written field crosses")
    assert_equal(kept.secret, 0, reason="the redacted field never reaches the host")
