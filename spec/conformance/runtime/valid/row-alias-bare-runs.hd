# test: a context and a function type written with a row alias after $ run with the alias's providers
# expect: test
use std.function.Fn
use std.testing.assert_equal

trait Db:
    fn name(self) -> string

trait Log:
    fn tag(self) -> string

data MemoryDb: pass

impl Db for MemoryDb:
    fn name(self) -> string: "db"

data PlainLog: pass

impl Log for PlainLog:
    fn tag(self) -> string: "log"

type AppRow = $ Db + Log

fn describe() -> string $ AppRow:
    "${$.use(Db).name()} ${$.use(Log).tag()}"

fn app_context() -> $.Context[$ AppRow]:
    $.context(Db=MemoryDb {}, Log=PlainLog {})

fn run(ctx: $.Context[$ AppRow], handler: Fn[(), string, $ AppRow]) -> string:
    $.with(ctx...):
        handler()

tests:
    it("the bare alias names the keys the context provides"):
        assert_equal(run(app_context(), describe), "db log", reason="AppRow is Db and Log")
