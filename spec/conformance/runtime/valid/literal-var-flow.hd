# test: open literal variables flow through ranges, tuples, lists, enums, and generic data
use std.testing.assert

data Pair[T]:
    first: T
    second: T

fn take(value: u8) -> u8:
    value

fn widen(value: u64) -> u64:
    value

tests:
    it("an index use fixes a for loop's range"):
        let items: List[i32] = [10, 20, 30]
        let sum: i32 = 0
        for i in 0..3:
            sum = sum + items[i]
        assert(sum == 60, reason="the loop indexes every element")

    it("a tuple pattern fixes one slot and the other falls back"):
        let (a, b) = (200, 2.5)
        let small = take(a)
        assert(small == 200, reason="the first slot is a u8")
        assert(b * 2.0 == 5.0, reason="the second slot is an f64")

    it("a push fixes a list literal's element"):
        let n: u16 = 60000
        let mut xs = [1, 2]
        xs.push(n)
        assert(xs[2] == n, reason="the list holds u16 values")
        assert(xs.len() == 3, reason="the push appends")

    it("a match payload fixes a generic enum value"):
        let got: u8 = match Option.Some(3):
            .Some(n) => take(n)
            .None => 0
        assert(got == 3, reason="the payload is a u8")

    it("a data pattern fixes a generic data literal"):
        let Pair { first, second } = Pair { first: 1, second: 2 }
        let total: u64 = widen(first) + second
        assert(total == 3, reason="both fields are u64")
