# test: literals take their width from the typed parts of their own expression: ranges, lists, enums, and generic data
# Spec 04 Open Literal Width: types.literal.local.class.meet and its expression forms.
data Pair[T]:
    first: T
    second: T

fn take(value: u8) -> u8:
    value

fn widen(value: u64) -> u64:
    value

tests:
    use std.testing.assert

    it("an index use reads a range of usize literals"):
        let items: List[i32] = [10, 20, 30]
        let sum: i32 = 0
        for i in 0..3:
            sum = sum + items[i]
        assert(sum == 60, reason="the loop indexes every element")

    it("a list element takes the parameter type of the call it is read in"):
        let small = take([200, 7][0])
        assert(small == 200, reason="the list is a List[u8]")

    it("a typed element fixes a list literal's literals"):
        let n: u16 = 60000
        let mut xs = [n, 1, 2]
        xs.push(n)
        assert(xs[3] == n, reason="the list holds u16 values")
        assert(xs.len() == 4, reason="the push appends")

    it("a match payload takes the width its arm needs"):
        let got: u8 = match Option.Some(3):
            .Some(n) => take(n)
            .None => 0
        assert(got == 3, reason="the payload is a u8")

    it("a typed field fixes a generic data literal"):
        let pair = Pair { first: widen(1), second: 2 }
        let total: u64 = pair.first + pair.second
        assert(total == 3, reason="both fields are u64")
