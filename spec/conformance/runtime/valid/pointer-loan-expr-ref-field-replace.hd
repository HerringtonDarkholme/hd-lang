# test: pointer loans: a `&` to a field of a struct field behind a `*T`, used within one expression; an alias replaces what holds the place; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
struct Inner:
    value: string

struct Outer:
    inner: Inner
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { inner: Inner { value: orig() }, other: second() })

fn length(slot: &string) -> string:
    *slot

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    seen := length(&p.inner.value)
    alias.inner = Inner { value: fresh() }
    junk := churn()
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
