# test: a projection returned through a generic function keeps the reference its argument holds
# Spec 13 Lifetime Traits: ref.lifetime.trait.bound-argument,
# ref.lifetime.return. `S::Item` is `Keep['b]` for `Sh`; `pick` returns the
# `Keep` it was given, which refers to `main`'s `q`.
# expect-stdout: 2
# expect-stdout: 1
struct Point:
    x: i32

trait Store[T]:
    fn put(&mut self, value: T) -> void

trait Shelf['b]:
    type Item < Store[&'b Point]

struct Keep['a]:
    last: &'a Point

impl['a] Store[&'a Point] for Keep['a]:
    fn put(&mut self, value: &'a Point) -> void:
        self.last = value

struct Sh:
    n: i32

impl['b] Shelf['b] for Sh:
    type Item = Keep['b]

fn pick['a, S < Shelf['a]](x: S::Item, p: &'a Point) -> S::Item:
    x

fn passed['a, S < Shelf['a]](x: S::Item, p: &'a Point) -> S::Item:
    let mut y = pick::[S](x, p)
    y.put(p)
    y

pub fn main() -> void $ Console:
    p := Point { x: 1 }
    q := Point { x: 2 }
    k := pick::[Sh](Keep { last: &q }, &p)
    println(k.last.x)
    j := passed::[Sh](k, &p)
    println(j.last.x)
