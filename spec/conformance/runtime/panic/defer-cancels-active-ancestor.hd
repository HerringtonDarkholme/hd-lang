# test: a defer suite that cancels its own active ancestor panics as reentrant
data Slot:
    task: (mut Suspend[i32])?

fn inner!(slot: mut Slot) -> i32:
    defer:
        match slot.task:
            .Some(task) => task.cancel()
            .None => pass
    1

fn outer!(slot: mut Slot) -> i32:
    inner!(slot)

pub fn main!() -> void:
    let mut slot = Slot { task: .None }
    let pending: mut Suspend[i32] = outer(slot)
    slot.task = pending
    _ := pending!()  # panic: suspension-reentrant-poll
