# #1383: exposing a generic consumer preserves captured-root loans.
# ref.excl.alias.shared-variable; ref.dep.call; fn.capture.cell;
# fn.trait.mut.call.
use std.function.FnMut

struct P:
    name: string

fn name_of(p: &P) -> &string:
    &p.name

fn repeat[F < FnMut() -> void](n: usize, mut f: F) -> void:
    for _ in 0..n:
        f()

fn borrow_then_change() -> string:
    let mut ps = [box(P { name: "a" })]
    change := fn() -> void: ps[0] = box(P { name: "b" }) # panic: borrow-conflict
    d := name_of(ps[0])
    repeat(1, change)
    *d

pub fn main() -> void $ Console:
    println(borrow_then_change())
