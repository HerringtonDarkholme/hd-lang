# test: += on a missing map key panics, since the read expects the key
# Spec 05 Compound Assignment: expr.assign.compound.map-missing (evening follow-up 5, 2026-09-29).
fn tally(word: string) -> Map[string, i32]:
    let counts: mut Map[string, i32] = {}
    counts[word] += 1  # panic: index-out-of-bounds
    counts

tests:
    it("panics on a missing key"):
        _ := tally("a")
