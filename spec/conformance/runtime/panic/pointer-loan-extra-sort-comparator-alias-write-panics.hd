# test: pointer loans, adversarial: a comparator writes another field of the object whose list it sorts; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Bag:
    items: List[i32]
    calls: i32

fn probe(p: *mut Bag, alias: *mut Bag) -> void:
    compare := fn(left: &i32, right: &i32) -> Ordering:
        alias.calls += 1 # panic: borrow-conflict
        left.cmp(right)
    p.items.sort_by(compare)

pub fn main() -> void $ Console:
    p := box(Bag { items: [+3, 1, 2], calls: +0 })
    probe(p, p)
    println("${p.calls}")
