# test: a `&mut self` call through an unseen `*mut` alias writes the whole object, so it panics while a `&` binding borrows one field
# Spec 13 Conflicts Through Aliases: ref.excl.alias.access, ref.excl.alias.conflict.
struct User:
    name: string
    age: i32

impl User:
    fn birthday(&mut self) -> void:
        self.age += 1

struct Team:
    lead: *mut User

fn celebrate(t: &Team, alias: *mut User) -> string:
    n := &t.lead.name
    alias.birthday() # panic: borrow-conflict
    *n

tests:
    it("a mut self call through an alias panics while a field is borrowed"):
        t := Team { lead: box(User { name: "a", age: +1 }) }
        alias := t.lead
        _ := celebrate(&t, alias)
