# test: abs of the smallest i64 overflows as negation does
# Spec std/num Absolute Value: std-num.abs.min.
fn magnitude(value: i64) -> i64:
    value.abs()  # panic: integer-overflow

tests:
    it("overflows on the minimum"):
        let lowest: i64 = -9223372036854775807 - 1
        _ := magnitude(lowest)
