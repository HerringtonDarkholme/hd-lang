# test: a pop that removes an element through a box alias the checker cannot see during an element reference's call panics borrow-conflict, as model A gives a write through an alias of a borrowed collection
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn change(list: &mut List[i32], first: &mut i32) -> void:
    _ := list.pop() # panic: borrow-conflict
    *first = 5

tests:
    it("pop shortens a pinned list"):
        xs := box([+1, 2, 3])
        alias := xs
        change(alias, &mut xs[2])
