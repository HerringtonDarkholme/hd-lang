# test: a balance that falls back to usize panics when a subtraction goes below zero
# Spec 04 Open Literal Width: types.literal.local.default; 06 Panic Behavior: flow.panic.report.fallback (SIGN-FALLBACK, batch 83).

fn settle():
    let balance = 100
    balance = balance - 150  # panic: integer-overflow
    balance

result := settle()
