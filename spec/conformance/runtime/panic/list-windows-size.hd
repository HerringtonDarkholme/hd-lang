# test: windows with a size below 1 panics
# Spec std/collections List Helpers: std-collections.helper.windows.size.

use std.collections.ListView

fn paged(items: List[i32]) -> List[ListView[i32]]:
    items.windows(0) # panic: explicit-panic

tests:
    it("rejects size 0"):
        _ := paged([1, 2])
