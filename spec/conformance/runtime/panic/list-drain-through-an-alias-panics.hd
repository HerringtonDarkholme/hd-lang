# test: a list drain through a pointer alias while an element reference borrows the same object panics borrow-conflict, as model A gives
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan.

struct Bag:
    items: List[string]

fn change(first: &mut string, alias: *mut Bag) -> void:
    _ := alias.items.drain(0..1) # panic: borrow-conflict
    *first = "still live"

tests:
    it("rejects a drain through an alias of a pinned collection"):
        bag := box(Bag { items: ["original", "tail"] })
        alias := bag
        change(&mut bag.items[0], alias)
