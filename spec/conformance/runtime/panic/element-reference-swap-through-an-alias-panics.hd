# test: a boxed list lent as a `&mut` argument beside element references from another alias of it conflicts for the call, so swapping through it panics
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn swap_then_read(names: &mut List[string], left: &string, right: &string) -> string:
    held := names[0]
    names[0] = names[1]
    names[1] = held
    "${*left} ${*right}"

# The list comes through a box alias, which the checker does not see.
fn swapped(names: *mut List[string]) -> string:
    alias := names
    swap_then_read(alias, &names[0], &names[1]) # panic: borrow-conflict

tests:
    use std.testing.assert_equal

    it("a swap moves elements between slots, not references"):
        names := box(["ada", "lin"])
        assert_equal(swapped(names), "lin ada", reason="each slot holds the other element")
