# test: appending to a list invalidates its views, even past a view's end
# std Collections, Views: std-collections.view.invalidate, std-collections.view.invalidate.anywhere, std-collections.view.invalid-use (batch 49).
fn stale(items: mut List[i32]) -> usize:
    window := items.view(0, 2)
    items.push(4)
    window.len()  # panic: iterator-invalidated

let numbers: mut List[i32] = [1, 2, 3]
result := stale(numbers)
