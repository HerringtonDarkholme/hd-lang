# test: a panic after a computed string argument panics before the call
# Spec 04 The never Type: types.never.assignable; Spec 05: expr.order.left-to-right (issue #850).

fn join(a: string, b: string) -> string:
    a + b

pub fn main() -> void $ Console:
    s := "a".repeat(3)
    println(join(s, panic("no second part")))  # panic: explicit-panic
