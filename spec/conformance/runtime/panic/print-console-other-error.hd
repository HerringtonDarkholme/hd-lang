# test: print panics when a provider returns a console failure
# Spec std/console: std-console.print.error.
use std.console.print

struct Failed: pass

impl Console for Failed:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        .Err(ConsoleError.Other("sink failed"))

pub fn main() -> void:
    $.with(Console=&mut Failed {}):
        print("lost")  # panic: explicit-panic
