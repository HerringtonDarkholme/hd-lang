# test: Map's Index implementation panics on a missing key
# Spec 05 Built-In Implementations: expr.index.std.hd-bodies, expr.index.map.read-value (Strings STR8; SSC Q8, batch 26).
use std.ops.Index

fn lookup[K, V, C < Index[K, Out = V]](entries: C, key: K) -> V:
    entries[key]

ages := { "ada": 36 }
age := lookup(ages, "grace") # panic: index-out-of-bounds
