# test: a reference held through a read-only counted reference registers a loan, so writing its field through a writable alias panics
# Spec 13 Conflicts Through Aliases: ref.excl.alias.shared-counted-loan, ref.excl.alias.conflict.
struct User:
    name: string
    age: i32

fn conflict(view: *User, alias: *mut User) -> string:
    held := &view.name
    alias.name = "b" # panic: borrow-conflict
    *held

pub fn main() -> void $ Console:
    alias := box(User { name: "a", age: 1 })
    let view: *User = alias
    println(conflict(view, alias))
