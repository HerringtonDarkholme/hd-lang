# test: a map loop panics when length-keeping changes rebuild the map's storage
# Spec 06 Iterator Invalidation: flow.for.invalidate.map-rebuild.
# Each pass removes, inserts, inserts and removes, so the length stays 4,
# and the appended entries soon make the map rebuild its storage.
fn churn(entries: mut Map[string, i32]) -> void:
    for (key, _) in entries:  # panic: iterator-invalidated
        for i in 0..64:
            _ := entries.remove(key)
            entries["new$i"] = i
            entries[key] = 0
            _ := entries.remove("new$i")

tests:
    it("removals and insertions that keep the length"):
        let entries: mut Map[string, i32] = {"a": +1, "b": +2, "c": +3, "d": +4}
        churn(entries)
