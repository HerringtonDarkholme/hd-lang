# test: pointer loans, adversarial: another task of a `join!` writes the object a task's reference holds across a suspension; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.task.join
use std.time.{Clock, s, sleep}

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn hold!(p: *mut Cell) -> string $ Clock:
    r := &p.value
    # join! polls its tasks in argument order (req.schedule.all-unfinished),
    # so act! runs, and writes, while this task waits here.
    sleep!(s(60))
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

fn act!(alias: *mut Cell) -> string:
    alias.other = fresh() # panic: borrow-conflict
    "acted"

pub fn main!() -> void $ Console + Clock:
    p := box(Cell { value: orig(), other: fresh() })
    let (seen, _) = join!(hold(p), act(p))
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
