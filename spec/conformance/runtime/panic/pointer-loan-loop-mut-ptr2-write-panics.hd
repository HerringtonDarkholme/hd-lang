# test: pointer loans: a `&mut` to a field behind a `*T` then a `*T`, held across a loop iteration; an alias writes the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, sees the write.
struct Cell:
    value: string
    other: string

struct Outer:
    next: *mut Cell
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { next: box(Cell { value: orig(), other: second() }), other: second() })

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := &mut p.next.value
    let seen = ""
    for round in 0..2:
        if round == 1:
            alias.next.value = fresh() # panic: borrow-conflict
            junk := churn()
            _ := junk.len()
        seen = *r
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
