# test: a callee that returns its reference parameter hands back a copy of the element reference, which pins the list while it lives
# Spec 13 Call-Scoped Access: ref.elem.callee-copy.
fn keep(target: *mut i32) -> *mut i32:
    target

tests:
    it("a kept copy of an element reference holds the list's pin"):
        let mut xs = [+1, 2]
        saved := keep(&mut xs[0])
        xs.push(3) # panic: collection-pinned
        *saved = 10
