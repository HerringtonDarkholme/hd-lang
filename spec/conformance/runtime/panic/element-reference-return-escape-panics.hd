# test: a returned element reference keeps the caller's list pinned until the returned reference's last use
# Spec 13 Element References: ref.elem.release.copies.
fn first(xs: &mut List[i32]) -> &mut i32: &mut xs[0]

tests:
    it("a returned element reference holds the list's pin"):
        let mut xs = [+1, 2]
        saved := first(&mut xs)
        xs.push(3)  # panic: collection-pinned
        *saved = 10
