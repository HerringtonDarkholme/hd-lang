# test: a `&mut` argument and an element reference from two aliases of one boxed list conflict for the call, even for an extend that appends nothing
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
@derive(Eq, Debug)
struct Bag:
    name: string
    items: List[i32]

struct Holder:
    words: List[string]

fn grow(words: &mut List[string], more: List[string]) -> void:
    words.extend(more)

# Extending by nothing keeps the length, so the pin of `first` allows it.
fn nothing_more(list: &mut List[string], first: &string) -> string:
    list.extend([])
    *first

# The list comes through a box alias, which the checker does not see.
fn through(list: *mut List[string]) -> string:
    alias := list
    nothing_more(alias, &list[0])

tests:
    use std.testing.assert_equal

    it("extending a pinned list by nothing does not panic"):
        words := box(["w"])
        assert_equal(through(words), "w", reason="the length is unchanged") # panic: borrow-conflict
