# test: println reached through a requirement-free helper while a default expression runs panics
# Spec 10 Console: module.console.println-block-on.indirect.

struct QuietConsole: pass

impl Console for QuietConsole:
    fn write!(&mut self, text: string) -> Result[void, ConsoleError]:
        .Ok(())

    fn write_error!(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write!(text)

fn announce() -> i32:
    let mut console: QuietConsole = QuietConsole {}
    $.with(Console=&mut console):
        println("default") # panic: suspension-forbidden-context
    1

fn count(start: i32 = announce()) -> i32:
    start

pub fn main() -> void:
    _ := count()
