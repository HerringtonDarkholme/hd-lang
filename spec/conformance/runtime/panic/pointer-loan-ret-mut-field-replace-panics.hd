# test: pointer loans: a `&mut` to a field of a struct field behind a `*T`, returned by a method; an alias replaces what holds the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Inner:
    value: string

struct Outer:
    inner: Inner
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { inner: Inner { value: orig() }, other: second() })

impl Outer:
    fn slot_mut(&mut self) -> &mut string:
        &mut self.inner.value

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := p.slot_mut()
    alias.inner = Inner { value: fresh() } # panic: borrow-conflict
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
