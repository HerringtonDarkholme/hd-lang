# test: block_on reached through a helper while a deferred callback runs panics; the check accepts it
use std.ops.defer
use std.task.block_on

fn ready!() -> i32:
    42

fn wait_now() -> i32:
    let pending: mut Suspend[i32] = ready()
    match block_on(pending): # panic: suspension-forbidden-context
        .Completed(value) => value
        _ => 0

fn cleanup() -> void:
    defer(fn() -> void: _ := wait_now())
    pass

pub fn main() -> void:
    cleanup()
