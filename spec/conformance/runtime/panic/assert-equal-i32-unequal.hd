# Spec 10 Standard Testing: module.testing.assert-panic.
tests:
    use std.testing.assert_equal

    it("an earlier passing test does not mask a later failure"):
        assert_equal(1, 1, reason="equal values pass")

    it("unequal i32 values fail assert_equal"):
        assert_equal(3 + 4, 8, reason="deliberately unequal integers")  # panic: assertion-failed
