# test: pointer loans, adversarial: a closure that captured the pointer writes the object; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision loan needed; call-scoped fallback rejected; Go model runs, sees the write.
struct Cell:
    value: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn probe(p: *mut Cell, alias: *mut Cell) -> string:
    bump := fn() -> void: alias.value = fresh() # panic: borrow-conflict
    r := &p.value
    bump()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := box(Cell { value: orig() })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
