# test: pointer loans, adversarial: a recursive callee writes the object at its deepest call; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, sees the write.
struct Cell:
    value: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn walk(alias: *mut Cell, depth: i32) -> void:
    if depth == 0:
        alias.value = fresh() # panic: borrow-conflict
    else:
        walk(alias, depth - 1)

fn probe(p: *mut Cell, alias: *mut Cell) -> string:
    r := &p.value
    walk(alias, 3)
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := box(Cell { value: orig() })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
