# test: a call's result through a `*mut` holds the whole object its receiver refers to, so a write through an unseen alias to another field panics with borrow-conflict
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict; Writes While Borrowed: ref.excl.call.
struct User:
    name: string
    age: i32

impl User:
    fn label(&self) -> &string:
        &self.name

struct Team:
    lead: *mut User

fn older(t: &Team, alias: *mut User) -> string:
    n := t.lead.label()
    alias.age += 1 # panic: borrow-conflict
    *n

tests:
    it("a write through an alias panics while a call's result holds the object"):
        t := Team { lead: box(User { name: "a", age: +1 }) }
        alias := t.lead
        _ := older(&t, alias)
