# test: a returned element reference holds its boxed list until its last use, so a push through a box alias the checker cannot see panics
# Spec 13 Call-Scoped Access: ref.elem.access.alias; Dependent Results: ref.dep.origin.element; Conflicts Through Aliases: ref.excl.alias.loan.
fn first_mut[T](xs: &mut List[T]) -> &mut T?:
    if xs.len() == 0: .None else: .Some(&mut xs[0])

tests:
    it("push panics while an element result is live"):
        xs := box([+1, 2])
        alias := xs
        match first_mut(xs):
            .Some(r) =>
                alias.push(3) # panic: borrow-conflict
                *r += 1
            .None => pass
