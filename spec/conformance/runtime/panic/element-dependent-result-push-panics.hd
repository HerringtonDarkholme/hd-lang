# test: a returned element reference pins its list until its last use, so a push through a box alias the checker cannot see panics
# Spec 13 Element References: ref.elem.access.pin, ref.elem.pinned; Dependent Results: ref.dep.origin.element.
fn first_mut[T](xs: &mut List[T]) -> &mut T?:
    if xs.len() == 0: .None else: .Some(&mut xs[0])

tests:
    it("push panics while an element result is live"):
        xs := box([+1, 2])
        alias := xs
        match first_mut(xs):
            .Some(r) =>
                alias.push(3) # panic: collection-pinned
                *r += 1
            .None => pass
