# test: a call's result held across a suspension in a suspending body keeps the object its receiver refers to, so a write through an unseen alias after the resume panics with borrow-conflict
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
use std.time.{Clock, sleep}

struct User:
    name: string
    age: i32

impl User:
    fn label(&self) -> &string:
        &self.name

struct Team:
    lead: *mut User

fn older!(t: &Team, alias: *mut User) -> string $ Clock:
    n := t.lead.label()
    sleep!(1ms)
    alias.age += 1 # panic: borrow-conflict
    *n

pub fn main!() -> void $ Console + Clock:
    t := Team { lead: box(User { name: "a", age: +1 }) }
    alias := t.lead
    println(older!(&t, alias))
