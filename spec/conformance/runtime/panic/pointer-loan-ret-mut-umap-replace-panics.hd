# test: pointer loans: a `&mut` to a `UniqMap` value behind a `*T`, returned by a method; an alias replaces what holds the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): panics collection-pinned.
use std.collections.UniqMap

struct Outer:
    map: UniqMap[string, string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq_map(a: string, b: string) -> UniqMap[string, string]:
    let mut map = UniqMap::[string, string].new()
    _ := map.insert("a", a)
    _ := map.insert("b", b)
    map

fn make() -> *mut Outer:
    box(Outer { map: uniq_map(orig(), second()), other: second() })

impl Outer:
    fn slot_mut(&mut self) -> &mut string:
        self.map.get_mut("a").expect("slot")

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := p.slot_mut()
    alias.map = uniq_map(fresh(), fresh()) # panic: borrow-conflict
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
