# test: two facts that read each other fail at once with fact-evaluation-failed
# Spec 14 Facts: annot.fact.eval.reentrant, annot.fact.eval.panic-runtime.
use std.annotation.facts_of

struct Route:
    path: string

fn route(path: string) -> Route:
    Route { path: path }

fn path_of_b() -> string:
    match facts_of(b).find::[Route]():
        .Some(r) => r.path
        .None => "none"

fn path_of_a() -> string:
    match facts_of(a).find::[Route]():
        .Some(r) => r.path
        .None => "none"

@route(path_of_b())
fn a() -> void:
    pass

@route(path_of_a())
fn b() -> void:
    pass

pub fn main() -> void:
    _ := facts_of(a).find::[Route]()  # panic: fact-evaluation-failed
