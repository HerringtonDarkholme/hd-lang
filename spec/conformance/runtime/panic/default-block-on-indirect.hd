# test: block_on reached through a helper while a default expression runs panics; the check accepts it
use std.task.block_on

fn ready!() -> i32:
    42

fn wait_now() -> i32:
    let pending: mut Suspend[i32] = ready()
    match block_on(pending):  # panic: suspension-forbidden-context
        .Completed(value) => value
        _ => 0

fn invalid(value: i32 = wait_now()) -> i32:
    value

pub fn main() -> void:
    _ := invalid()
