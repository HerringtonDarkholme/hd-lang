# test: pointer loans, adversarial: a trait-value call writes the borrowed object through a pointer it holds; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, sees the write.
trait Touch:
    fn touch(&self) -> void

struct Cell:
    value: string

struct Toucher:
    target: *mut Cell

impl Touch for Toucher:
    fn touch(&self) -> void:
        self.target.value = fresh() # panic: borrow-conflict

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn probe(p: *mut Cell, t: &dyn Touch) -> string:
    r := &p.value
    t.touch()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := box(Cell { value: orig() })
    toucher := Toucher { target: p }
    seen := probe(p, &toucher)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
