# test: a panic used as a list literal element panics before the list is built
# Spec 04 The never Type: types.never.assignable; Spec 05: expr.order.left-to-right (issue #850).

pub fn main() -> void $ Console:
    let xs: List[i32] = [+1, panic("no element"), +3]  # panic: explicit-panic
    println("${xs.len()}")
