# test: pointer loans: a `&mut` to a field behind a `*T` then a `*T`, captured by a closure; an alias reads the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision loan needed; call-scoped fallback rejected; Go model runs.
struct Cell:
    value: string
    other: string

struct Outer:
    next: *mut Cell
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { next: box(Cell { value: orig(), other: second() }), other: second() })

fn apply(alias: *Outer, read: fn() -> string) -> string:
    seen_alias := alias.next.value # panic: borrow-conflict
    junk := churn()
    _ := seen_alias.len()
    seen := read()
    _ := junk.len()
    seen

fn probe(p: *mut Outer, alias: *Outer) -> string:
    r := &mut p.next.value
    apply(alias, fn() -> string: *r)

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
