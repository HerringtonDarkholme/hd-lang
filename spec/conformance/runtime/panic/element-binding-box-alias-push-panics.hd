# test: a push through a box alias the checker cannot see while an element reference binding is live panics
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
tests:
    it("push panics through another alias"):
        xs := box([+1, 2])
        alias := xs
        first := &mut xs[0]
        alias.push(3) # panic: borrow-conflict
        *first += 1
