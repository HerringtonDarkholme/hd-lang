# test: a push through a box alias in the body of a loop over the element references of a boxed list panics borrow-conflict
# Spec 06 Element Reference Loops: flow.for.ref.access; Spec 13 Call-Scoped Access: ref.elem.access.alias.
fn doubled(list: *mut List[i32], alias: *mut List[i32]) -> void:
    for x in &mut list:
        alias.push(*x) # panic: borrow-conflict

tests:
    it("the loop holds its list"):
        xs := box([+1, 2])
        doubled(xs, xs)
