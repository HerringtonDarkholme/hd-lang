# test: two `&mut` projections of one field through aliases of an erased factory's box conflict, since the first holds an exclusive loan on the whole object
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
struct Pair:
    number: i32
    text: string

trait Factory:
    fn make[T < 'static](self, value: T) -> *mut T:
        box(value)

struct Maker: pass
impl Factory for Maker

tests:
    use std.testing.assert

    it("a second `&mut` through an alias panics"):
        let factory: &dyn Factory = &Maker {}
        pair := factory.make(Pair { number: +4, text: "first" })
        same := pair
        field := &mut pair.text
        another := &mut same.text # panic: borrow-conflict
        assert(field is another, reason="independently created projections share identity")
