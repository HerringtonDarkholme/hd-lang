# test: pointer loans, adversarial: a callee writes only the type that holds the pointer the reference crossed; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
struct Cell:
    value: string

struct Outer:
    next: *mut Cell

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn rewire(alias: *mut Outer) -> void:
    alias.next = box(Cell { value: fresh() }) # panic: borrow-conflict

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := &p.next.value
    rewire(alias)
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := box(Outer { next: box(Cell { value: orig() }) })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
