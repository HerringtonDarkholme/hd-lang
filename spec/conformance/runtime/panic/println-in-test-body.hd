# test: a test body runs under a driver, so println called from it panics as block_on does
# Spec 10 Console: module.console.println-block-on (MHP-1 follow-up).

data BufferConsole:
    lines: mut List[string]

impl Console for BufferConsole:
    fn write_line!(mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.append(text)
        .Ok()

fn greet(name: string) -> void $ Console:
    println("hello, ${name}")  # panic: suspension-nested-driver

tests:
    it("println panics under the test driver"):
        let console: mut BufferConsole = BufferConsole { lines: [] }
        $.with(Console=console):
            greet("Ada")
