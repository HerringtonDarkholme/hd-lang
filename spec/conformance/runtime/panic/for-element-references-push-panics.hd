# test: a push in the body of a loop over the element references of a list reached through a &mut parameter panics with collection-pinned
# Spec 06 Element Reference Loops: flow.for.ref.pinned.
fn doubled(list: &mut List[i32]) -> void:
    for x in &mut list:
        list.push(*x) # panic: collection-pinned

tests:
    it("the loop pins its list"):
        let mut xs = [+1, 2]
        doubled(&mut xs)
