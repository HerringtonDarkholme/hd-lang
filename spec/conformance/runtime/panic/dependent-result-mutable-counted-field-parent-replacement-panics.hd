# test: a dependent result from a mutable counted field keeps its parent loan
# Rule: ref.excl.alias.conflict.
struct P:
    name: string

struct M:
    p: *mut P

fn name_of(p: &mut P) -> &mut string:
    &mut p.name

fn replace(h: *mut M, alias: *mut M, next: *mut P) -> string:
    d := name_of(h.p)
    alias.p = next # panic: borrow-conflict
    *d

pub fn main() -> void:
    h := box(M { p: box(P { name: "a" }) })
    _ := replace(h, h, box(P { name: "b" }))
