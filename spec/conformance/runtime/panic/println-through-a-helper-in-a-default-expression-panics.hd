# test: println through a helper in a default expression panics
# Rules: std-task.block-on.completed; Spec 11 Drivers: req.drive.block-on.indirect.
use std.task.block_on

fn ready!() -> i32:
    42

fn wait_now() -> i32:
    let pending: mut Suspend[i32] = ready()
    match block_on(pending):
        .Completed(value) => value
        _ => 0

struct QuietConsole: pass

impl Console for QuietConsole:
    fn write_line!(&mut self, text: string) -> Result[void, ConsoleError]:
        .Ok(())

fn print_now() -> i32:
    let mut console = QuietConsole {}
    $.with(Console=&mut console):
        println("quiet")  # panic: suspension-forbidden-context
    1

fn count(start: i32 = print_now()) -> i32:
    start

pub fn main() -> void:
    _ := count()
