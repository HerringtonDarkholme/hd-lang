# test: abandoning a suspension from inside its own active poll panics as reentrant
# Spec lang/11 Abandoning: req.abandon.active.
struct Slot:
    task: (Suspend[i32])?

fn halt(slot: &mut Slot) -> void:
    match slot.task:
        .Some(task) => task.abandon()
        .None => pass

fn inner!(slot: &mut Slot) -> i32:
    halt(slot)
    1

fn outer!(slot: &mut Slot) -> i32:
    inner!(slot)

pub fn main!() -> void:
    # Distinct counted aliases permit the slot write before the cold frame is driven.
    slot := box(Slot { task: .None })
    frame_slot := slot
    let pending: Suspend[i32] = outer(frame_slot)
    slot.task = pending
    _ := pending!() # panic: suspension-reentrant-poll
