# test: a fact whose evaluation reads the same fact fails at once with fact-evaluation-failed
# Spec 14 Facts: annot.fact.eval.reentrant, annot.fact.eval.panic-runtime.
use std.annotation.facts_of

struct Route:
    path: string

fn route(path: string) -> Route:
    Route { path: path }

fn own_path() -> string:
    match facts_of(list_users).find::[Route]():
        .Some(r) => r.path
        .None => "none"

@route(own_path())
fn list_users() -> void:
    pass

pub fn main() -> void:
    _ := facts_of(list_users).find::[Route]() # panic: fact-evaluation-failed
