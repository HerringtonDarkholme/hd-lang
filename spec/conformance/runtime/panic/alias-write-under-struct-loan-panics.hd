# test: a reference held in a struct keeps its run-time loan, so a write through an unseen alias panics with borrow-conflict
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User

struct Held['a]:
    name: &'a string

fn rename(t: &Team, alias: *mut User) -> string:
    held := Held { name: &t.lead.name }
    alias.name = "b" # panic: borrow-conflict
    *held.name

tests:
    it("a write panics while a struct holds the reference"):
        t := Team { lead: box(User { name: "a", age: +1 }) }
        alias := t.lead
        _ := rename(&t, alias)
