# test: a List first_mut result pins its list until the result's last use
# std Collections: std-collections.access.first-mut; Spec 13 Element References: ref.elem.pinned.
tests:
    it("push panics while first_mut is live"):
        let mut items = [+1, 2]
        match items.first_mut():
            .Some(first) =>
                items.push(3) # panic: collection-pinned
                *first += 1
            .None => pass
