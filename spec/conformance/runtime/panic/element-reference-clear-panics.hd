# test: a clear through a box alias the checker cannot see during an element reference's call panics with collection-pinned
# Spec 13 Call-Scoped Access: ref.elem.access.pin, ref.elem.pinned.
fn change(list: &mut List[i32], first: &mut i32) -> void:
    list.clear() # panic: collection-pinned
    *first = 5

tests:
    it("clear empties a pinned list"):
        xs := box([+1, 2, 3])
        alias := xs
        change(alias, &mut xs[2])
