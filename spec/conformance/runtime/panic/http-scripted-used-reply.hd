# Rule: std-http.scripted.reply-used-panic.
use std.http.{Response, ScriptedHttp}

pub fn main() -> void:
    response := Response::status(.Ok).set_text("already read")
    _ := response.text()
    http := ScriptedHttp::new()
    http.reply("https://example.test/", .Ok(response)) # panic: explicit-panic
