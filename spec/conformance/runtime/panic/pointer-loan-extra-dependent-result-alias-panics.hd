# test: pointer loans, adversarial: an alias writes the object while a call result that depends on the pointer lives; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Cell:
    value: string
    other: string

impl Cell:
    fn change(&mut self) -> void:
        self.other = fresh()

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn borrow(b: &Cell) -> &string:
    &b.value

fn probe(boxed: *mut Cell, alias: *mut Cell) -> string:
    r := borrow(boxed)
    alias.change() # panic: borrow-conflict
    *r

pub fn main() -> void $ Console:
    boxed := box(Cell { value: orig(), other: fresh() })
    seen := probe(boxed, boxed)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
