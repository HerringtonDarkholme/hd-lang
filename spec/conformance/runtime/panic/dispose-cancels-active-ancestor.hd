# test: a dispose! that cancels its own active ancestor panics as reentrant
use std.ops.Disposable

struct Slot:
    task: (mut Suspend[i32])?

struct Guard:
    slot: *mut Slot

impl Disposable for Guard:
    fn dispose!(&mut self) -> void:
        match self.slot.task:
            .Some(task) =>
                _ := task.cancel!()
            .None => pass

fn inner!(slot: *mut Slot) -> i32:
    using guard = Guard { slot: slot }
    1

fn outer!(slot: *mut Slot) -> i32:
    inner!(slot)

pub fn main!() -> void:
    let mut slot = Slot { task: .None }
    let pending: mut Suspend[i32] = outer(&mut slot)
    slot.task = pending
    _ := pending!()  # panic: suspension-reentrant-poll
