# test: skip with a negative count panics when called
# Spec std/iter More Adapters: std-iter.adapter.skip.negative (recommended reading of TEXT-COLLECTIONS-SURFACE, spec pass 78).

fn tail(values: List[i32]) -> List[i32]:
    values.iter().skip(-1).collect()  # panic: explicit-panic

tests:
    it("rejects a negative count"):
        _ := tail([1, 2, 3])
