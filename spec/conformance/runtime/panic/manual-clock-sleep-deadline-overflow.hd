# test: an overflowing ManualClock sleep deadline panics with integer-overflow in every build
# Spec std/time Manual Clock: std-time.manual.sleep.deadline-overflow.
use std.time.{Clock, Duration, ManualClock, Timestamp}

tests:
    it("rejects a deadline beyond the largest timestamp"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(1))
        clock.sleep!(Duration::milliseconds(9223372036854775807)) # panic: integer-overflow
