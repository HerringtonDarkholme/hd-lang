# test: a call's result held across a suspension keeps its loan on the whole object its argument reaches while the body waits, so a write to another field through an alias after the suspension panics
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
use std.time.{Clock, sleep}

struct Addr:
    city: string

impl Addr:
    fn place(&self) -> &string:
        &self.city

struct User:
    name: string
    age: i32
    addr: Addr

struct Team:
    lead: *mut User

fn moved!(t: &Team, alias: *mut User) -> void $ Console + Clock:
    c := t.lead.addr.place()
    sleep!(1ms)
    alias.age += 1 # panic: borrow-conflict
    println("${*c} ${alias.name} ${alias.age}")
    sleep!(1ms)
    alias.addr.city = "d"
    println(*t.lead.addr.place())

pub fn main!() -> void $ Console + Clock:
    t := Team { lead: box(User { name: "a", age: +1, addr: Addr { city: "c" } }) }
    alias := t.lead
    moved!(&t, alias)
