# test: pointer loans, adversarial: a callee writes another field of an object the caller's reference borrows; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn bump(alias: *mut Cell) -> void:
    alias.other = fresh() # panic: borrow-conflict

fn probe(p: *mut Cell, alias: *mut Cell) -> string:
    r := &p.value
    bump(alias)
    *r

pub fn main() -> void $ Console:
    p := box(Cell { value: orig(), other: fresh() })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
