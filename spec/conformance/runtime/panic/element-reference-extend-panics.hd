# test: a std extend that adds elements through a box alias the checker cannot see during an element reference's call panics borrow-conflict, as model A gives a write through an alias of a borrowed collection
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn change(list: &mut List[i32], first: &i32) -> i32:
    list.extend([+3]) # panic: borrow-conflict
    *first

tests:
    it("extend grows a pinned list"):
        xs := box([+1, 2])
        alias := xs
        _ := change(alias, &xs[0])
