# test: a parser with positionals cannot declare a command
# Spec std/cli: std-cli.command.no-positionals.
use std.cli.{Arg, ArgParser}

pub fn main() -> void:
    parser := ArgParser::new("tool").arg(Arg { name: "file", kind: .Positional })
    parser.command("run", *ArgParser::new("tool run"))  # panic: explicit-panic
    pass
