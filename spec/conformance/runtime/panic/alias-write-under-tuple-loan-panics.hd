# test: a reference held in a tuple keeps its run-time loan, so a write through an unseen alias panics with borrow-conflict
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User

fn rename(t: &Team, alias: *mut User) -> string:
    held := (&t.lead.name, +1)
    alias.name = "b" # panic: borrow-conflict
    *held._0

tests:
    it("a write panics while a tuple holds the reference"):
        t := Team { lead: box(User { name: "a", age: +1 }) }
        alias := t.lead
        _ := rename(&t, alias)
