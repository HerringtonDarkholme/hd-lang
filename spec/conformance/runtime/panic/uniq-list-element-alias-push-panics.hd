# test: a push through a box alias while an element reference into the unique list behind it is live panics borrow-conflict, as the reference holds the list's object
# std Collections: std-collections.uniq-list.type; Spec 13 Conflicts Through Aliases: ref.excl.alias.loan.
use std.collections.UniqList

struct Bag:
    items: UniqList[string]

fn grow(first: &mut string, alias: *mut Bag) -> void:
    alias.items.push("pushed") # panic: borrow-conflict
    *first = "written"

tests:
    it("the element reference pins the unique list"):
        bag := box(Bag { items: UniqList::[string].new() })
        bag.items.push("original")
        alias := bag
        match bag.items.get_mut(0):
            .Some(first) => grow(first, alias)
            .None => pass
