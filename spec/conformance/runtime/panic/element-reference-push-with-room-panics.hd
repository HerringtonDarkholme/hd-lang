# test: push with room left in the buffer, through a box alias the checker cannot see, during an element reference's call panics borrow-conflict, as model A gives a write through an alias of a borrowed collection
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn change(list: &mut List[i32], first: &mut i32) -> void:
    list.push(4) # panic: borrow-conflict
    *first = 5

tests:
    it("push with room changes the length of a pinned list"):
        xs := box::[List[i32]]([])
        xs.push(1)
        xs.push(2)
        xs.push(3)
        alias := xs
        change(alias, &mut xs[2])
