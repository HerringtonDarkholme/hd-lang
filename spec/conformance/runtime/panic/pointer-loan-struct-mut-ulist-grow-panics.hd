# test: pointer loans: a `&mut` to a `UniqList` element behind a `*T`, stored in a lifetime struct; an alias grows the collection; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): panics collection-pinned.
use std.collections.UniqList

struct Outer:
    items: UniqList[string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq(first: string, last: string) -> UniqList[string]:
    let mut items = UniqList::[string].new()
    items.push(first)
    items.push(last)
    items

fn make() -> *mut Outer:
    box(Outer { items: uniq(second(), orig()), other: second() })

struct ViewMut['a]:
    r: &'a mut string

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    view := ViewMut { r: p.items.get_mut(1).expect("slot") }
    for round in 0..16:
        alias.items.push(fresh()) # panic: borrow-conflict
    junk := churn()
    seen := *view.r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
