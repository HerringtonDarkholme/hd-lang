# test: Short and Positional cannot configure the same CLI field
# Spec std/cli: std-cli.positional.value-short-conflict.
use std.cli.{Cli, short, positional}
@derive(Cli)
struct Config:
    @short('x')
    @positional
    input: string
pub fn main() -> void:
    _ := Config::parser() # panic: explicit-panic
