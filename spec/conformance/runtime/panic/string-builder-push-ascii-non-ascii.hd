# test: push_ascii of a byte of 128 or more panics
# Spec std/text Joining And Building: std-text.builder.push-ascii.range.
use std.text.StringBuilder

fn add(out: *mut StringBuilder, byte: u8) -> void:
    _ := out.push_ascii(byte)  # panic: explicit-panic

tests:
    it("rejects byte 128"):
        out := StringBuilder::new()
        out.push_ascii(127)
        add(out, 128)
