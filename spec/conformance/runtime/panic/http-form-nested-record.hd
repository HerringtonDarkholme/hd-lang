# Spec std/http Request Builder: std-http.request.form-unsupported.
use std.http.Request
use std.serde.Serialize

@derive(Serialize)
struct Child:
    value: string

@derive(Serialize)
struct Input:
    child: Child

pub fn main() -> void:
    _ := Request::post("/").form(Input { child: Child { value: "x" } })  # panic: explicit-panic
