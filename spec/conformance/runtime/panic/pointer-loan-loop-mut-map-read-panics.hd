# test: pointer loans: a `&mut` to a `Map` value behind a `*T`, held across a loop iteration; an alias reads the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
struct Outer:
    map: Map[string, string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { map: { "a": orig(), "b": second() }, other: second() })

fn probe(p: *mut Outer, alias: *Outer) -> string:
    r := &mut p.map["a"]
    let seen = ""
    for round in 0..2:
        if round == 1:
            seen_alias := alias.map["a"] # panic: borrow-conflict
            junk := churn()
            _ := seen_alias.len()
            _ := junk.len()
        seen = *r
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
