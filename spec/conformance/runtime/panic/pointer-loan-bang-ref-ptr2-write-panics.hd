# test: pointer loans: a `&` to a field behind a `*T` then a `*T`, held across a bang call that suspends and acts; an alias writes the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision loan needed; call-scoped fallback rejected; Go model runs, sees the write.
use std.time.{Clock, sleep}

struct Cell:
    value: string
    other: string

struct Outer:
    next: *mut Cell
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { next: box(Cell { value: orig(), other: second() }), other: second() })

fn act!(alias: *mut Outer) -> string $ Clock:
    sleep!(1ms)
    alias.next.value = fresh() # panic: borrow-conflict
    junk := churn()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *mut Outer) -> string $ Clock:
    r := &p.next.value
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Clock:
    p := make()
    seen := probe!(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
