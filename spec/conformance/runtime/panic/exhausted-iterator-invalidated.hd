# test: an invalidated iterator panics on its next next call even after it was exhausted
# Spec 06 Iterator Invalidation: flow.for.invalidate.panic.
fn drain_then_grow() -> i32?:
    let mut items: List[i32] = [+1]
    let mut cursor = items.iter()
    _ := cursor.next()
    _ := cursor.next()
    items.push(+2)
    cursor.next()  # panic: iterator-invalidated

tests:
    it("exhausted, then invalidated"):
        _ := drain_then_grow()
