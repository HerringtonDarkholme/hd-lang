# test: pointer loans, adversarial: an alias copies a list while a `&mut` element reference into it lives; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1323), not yet accepted.
# Verdicts: elision loan needed; call-scoped fallback rejected; Go model runs, the copy sees the write.
struct Bag:
    items: List[string]

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn probe(p: *mut Bag, alias: *Bag) -> string:
    r := &mut p.items[0]
    copy := alias.items # panic: borrow-conflict
    *r = fresh()
    copy[0]

pub fn main() -> void $ Console:
    p := box(Bag { items: [orig()] })
    seen := probe(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
