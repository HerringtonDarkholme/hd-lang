# test: a list element reference holds a loan on the boxed list it crosses until its last use, so a push through a box alias the checker cannot see panics
# Spec 13 Conflicts Through Aliases: ref.excl.alias.loan, ref.excl.alias.conflict.
tests:
    it("push panics while an element reference is live"):
        items := box([+1, 2])
        alias := items
        first := &mut items[0]
        alias.push(3) # panic: borrow-conflict
        *first += 1
