use std.testing.assert_equal

fn expect_same[T < Eq + Debug](actual: T, expected: T) -> void:
    assert_equal(actual, expected, reason="the bounds supply Eq and Debug")  # panic: assertion-failed

tests:
    it("a generic Eq value instantiated with i32 fails when unequal"):
        expect_same(40 + 1, 42)
