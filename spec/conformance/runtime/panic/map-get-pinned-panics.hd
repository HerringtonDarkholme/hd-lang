# test: a Map.get result pins its map until the result's last use, so an insert through a box alias the checker cannot see panics
# std Collections: std-collections.map.get; Spec 13 Element References: ref.elem.pinned.map.
tests:
    it("an insert panics while get's reference is live"):
        counts := box({ "a": +1 })
        alias := counts
        match counts.get("a"):
            .Some(n) =>
                alias["b"] = 2 # panic: collection-pinned
                assert(*n == 1)
            .None => pass
