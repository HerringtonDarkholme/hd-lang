# test: a call on a list element holds a loan on the list until it returns, so a push through a reference that the call cannot see panics, as model A gives a write through an alias of a borrowed collection
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
struct Item:
    n: i32

impl Item:
    fn grow(&mut self, all: &mut List[Item]) -> void:
        self.n += 1
        all.push(Item { n: 0 }) # panic: borrow-conflict

tests:
    it("the receiver's list is pinned for the call"):
        items := box([Item { n: 0 }])
        alias := items
        items[0].grow(alias)
