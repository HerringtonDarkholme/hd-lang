# test: a call on a list element pins the list until it returns, so a push through a reference that the call cannot see panics
# Spec 07 Reference Receivers: fn.method.auto-address.collection-element.
struct Item:
    n: i32

impl Item:
    fn grow(&mut self, all: &mut List[Item]) -> void:
        self.n += 1
        all.push(Item { n: 0 }) # panic: collection-pinned

tests:
    it("the receiver's list is pinned for the call"):
        let mut items = [Item { n: 0 }]
        r := &mut items
        items[0].grow(r)
