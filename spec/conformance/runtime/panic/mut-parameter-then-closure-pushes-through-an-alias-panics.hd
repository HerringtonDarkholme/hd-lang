# test: a boxed list lent as a `&mut` parameter holds an exclusive loan for the call, so a closure that pushes through another alias panics, even when the callee passes the list on by value
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn len_after(items: List[i32], change: fn() -> void) -> usize:
    change()
    items.len()

fn view_len_after(view: &mut List[i32], change: fn() -> void) -> usize:
    len_after(*view, change)

tests:
    use std.testing.assert_equal

    it("a &mut parameter passed on by value is copied"):
        items := box::[List[i32]]([+1])
        alias := items
        assert_equal(
            view_len_after(items, fn(): alias.push(2)), # panic: borrow-conflict
            1,
            reason="the parameter is the list as passed",
        )
