# test: pointer loans, adversarial: a pointer passed where `&mut` is expected lends its whole object from its evaluation, so a later argument that writes through an alias panics; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn write_other(alias: *mut Cell) -> usize:
    alias.other = fresh() # panic: borrow-conflict
    1

fn observe(c: &mut Cell, n: usize) -> string:
    c.value

fn probe(boxed: *mut Cell, alias: *mut Cell) -> string:
    observe(boxed, write_other(alias))

pub fn main() -> void $ Console:
    boxed := box(Cell { value: orig(), other: fresh() })
    seen := probe(boxed, boxed)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
