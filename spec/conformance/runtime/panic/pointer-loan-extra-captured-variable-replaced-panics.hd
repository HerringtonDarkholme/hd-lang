# test: pointer loans, adversarial: a stored closure that shares a variable replaces it while a reference into it lives; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
struct Hook:
    run: fn() -> void

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

pub fn main() -> void $ Console:
    let mut xs = [orig()]
    hook := Hook { run: fn() -> void: xs = [] } # panic: borrow-conflict
    r := &xs[0]
    (hook.run)()
    junk := churn()
    seen := *r
    _ := junk.len()
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
