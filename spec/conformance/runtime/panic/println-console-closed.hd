# test: println panics with explicit-panic when the covering provider's write_sync returns .Err(ConsoleError.Closed)
# Spec 10 Console: module.console.println-error.category, module.console.error.coded-variants, module.console.println-std, module.console.println-panics.
# Spec 10 Console: module.console.println-write-error.either, .println-error.category, and .error.closed.

struct ClosedConsole:
    attempts: List[string]

impl Console for ClosedConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.attempts.push(text)
        .Err(ConsoleError.Closed)

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write_sync(text)

fn greet(name: string) -> void $ Console:
    println("hello, ${name}") # panic: explicit-panic

tests:
    it("println panics when its first text write fails"):
        console := box(ClosedConsole { attempts: [] })
        $.with(Console=console):
            greet("Ada")
