# test: pointer loans, adversarial: a closure a suspending body made writes through its pointer while another function's reference to the object lives; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.time.{Clock, ms, sleep}

struct Cell:
    value: string
    other: string

fn hold(a: *Cell, f: fn() -> void) -> usize:
    x := &a.value
    f()
    x.len()

pub fn main!() -> void $ Console + Clock:
    p := box(Cell { value: "a", other: "o" })
    alias := p
    r := &p.other
    f := fn() -> void: p.value = "b" # panic: borrow-conflict
    println(*r)
    sleep!(ms(1))
    println("${hold(alias, f)}")
