struct Slot:
    task: (Suspend[i32])?

fn inner!(slot: &mut Slot) -> i32:
    match slot.task:
        .Some(task) => _ := task.cancel!()
        .None => pass
    1

fn outer!(slot: &mut Slot) -> i32:
    inner!(slot)

pub fn main!() -> void:
    # A counted slot: the suspension keeps it, and borrows no local.
    slot := box(Slot { task: .None })
    let pending: Suspend[i32] = outer(slot)
    slot.task = pending
    _ := pending!() # panic: suspension-reentrant-poll
