# test: a store of a new key into a map reached through a box alias the checker cannot see during an element reference's call panics borrow-conflict, as model A gives a write through an alias of a borrowed collection
# Spec 13 Conflicts Through Aliases: ref.excl.alias.call-loan, ref.excl.alias.conflict.
fn change(stock: &mut Map[string, i32], apples: &mut i32) -> void:
    stock["pear"] = 1 # panic: borrow-conflict
    *apples += 1

tests:
    it("a new key changes the length of a pinned map"):
        stock := box::[Map[string, i32]]({ "apple": 3 })
        alias := stock
        change(alias, &mut stock["apple"])
