# test: a store of a new key into a map reached through a box alias the checker cannot see during an element reference's call panics with collection-pinned
# Spec 13 Call-Scoped Access: ref.elem.pinned.map.
fn change(stock: &mut Map[string, i32], apples: &mut i32) -> void:
    stock["pear"] = 1 # panic: collection-pinned
    *apples += 1

tests:
    it("a new key changes the length of a pinned map"):
        stock := box::[Map[string, i32]]({ "apple": 3 })
        alias := stock
        change(alias, &mut stock["apple"])
