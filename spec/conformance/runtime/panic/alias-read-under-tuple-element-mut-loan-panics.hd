# test: a read through an unseen `*mut` alias of a tuple element a live `&mut` binding borrows panics with borrow-conflict
# Spec 13 Conflicts Through Aliases: ref.place.tuple-element, ref.excl.alias.loan, ref.excl.alias.conflict.
fn bump(t: *mut (i32, i32), alias: *mut (i32, i32)) -> i32:
    m := &mut t._0
    seen := alias._0 # panic: borrow-conflict
    *m = 3
    seen

tests:
    it("a read of a mutably borrowed tuple element through an alias panics"):
        t := box((+1, +2))
        _ := bump(t, t)
