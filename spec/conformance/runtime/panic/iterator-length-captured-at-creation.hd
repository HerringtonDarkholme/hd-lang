# test: a list iterator captures the length when it is created, so a push before its first next invalidates it
# Spec 06 Iterator Invalidation: flow.for.length.
fn grow_then_step() -> i32?:
    let mut items: List[i32] = [+1]
    let mut cursor = items.iter()
    items.push(+2)
    cursor.next()  # panic: iterator-invalidated

tests:
    it("the first next sees a changed length"):
        _ := grow_then_step()
