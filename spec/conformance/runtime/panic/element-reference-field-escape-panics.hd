# test: an element reference stored in a field keeps its list pinned until the field's last use
# Spec 13 Element References: ref.elem.release.copies.
struct Holder:
    slot: &mut i32

tests:
    it("a field holds a live copy of the element reference"):
        let mut xs = [+1, 2]
        r := &mut xs[0]
        saved := Holder { slot: r }
        xs.push(3)  # panic: collection-pinned
        *saved.slot = 10
