# test: pointer loans, adversarial: another task replaces a `UniqList` while the reference waits across a bang call; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Proposal: docs/future-work/POINTER_LOANS.md (issue #1336), not yet accepted.
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): panics collection-pinned.
use std.collections.UniqList
use std.task.join
use std.time.{Clock, s, sleep}

struct Bag:
    items: UniqList[string]

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq(value: string) -> UniqList[string]:
    let mut items = UniqList::[string].new()
    items.push(value)
    items

fn hold!(p: *mut Bag) -> string $ Clock:
    r := p.items.get_ref(0).expect("slot")
    # join! polls its tasks in argument order (req.schedule.all-unfinished),
    # so act! writes while this task waits; the panic ends the run.
    sleep!(s(60))
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

fn act!(alias: *mut Bag) -> string:
    alias.items = uniq(fresh()) # panic: borrow-conflict
    "acted"

pub fn main!() -> void $ Console + Clock:
    p := box(Bag { items: uniq(orig()) })
    let (seen, _) = join!(hold(p), act(p))
    println("${p.items.len()}")
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
