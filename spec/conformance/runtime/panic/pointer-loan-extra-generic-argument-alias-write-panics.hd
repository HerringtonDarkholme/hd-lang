# test: pointer loans, adversarial: a generic callee writes through an alias of the object its `&mut T` argument points into; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, sees the write.
trait Grow:
    fn grow(&mut self) -> void

struct Counter:
    n: i32

impl Grow for Counter:
    fn grow(&mut self) -> void:
        self.n += 1

fn twice[T < Grow](value: &mut T, alias: *mut Counter) -> void:
    value.grow()
    alias.n += 1 # panic: borrow-conflict
    value.grow()

fn probe(c: *mut Counter, alias: *mut Counter) -> void:
    twice(&mut *c, alias)

pub fn main() -> void $ Console:
    c := box(Counter { n: +0 })
    probe(c, c)
    println("${c.n}")
