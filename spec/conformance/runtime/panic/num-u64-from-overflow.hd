# test: from_u64 panics when the value does not fit the target integer type
# Spec std/num Conversion To And From u64: std-num.u64.checked.
use std.num.Integer

fn narrow[N < Integer](n: u64) -> N:
    N::from_u64(n)  # panic: integer-overflow

tests:
    it("overflows"):
        _ := narrow::[u8](256)
