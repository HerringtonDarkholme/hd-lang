use std.testing.assert_equal

data User:
    id: string
    display_name: string

impl PartialEq for User:
    fn eq(self, other: Self) -> bool:
        self.id == other.id

test "values unequal under an explicit PartialEq fail assert_equal":
    ada := User { id: "ada", display_name: "Ada" }
    grace := User { id: "grace", display_name: "Ada" }
    assert_equal(ada, grace, reason="deliberately unequal ids")  # panic: assertion-failed
