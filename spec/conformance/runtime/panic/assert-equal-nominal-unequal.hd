# Spec 10 Standard Testing: module.testing.assert-panic.
@derive(Debug)
data User:
    id: string
    display_name: string

impl Eq for User:
    fn eq(self, other: Self) -> bool:
        self.id == other.id

tests:
    use std.testing.assert_equal

    it("values unequal under an explicit Eq fail assert_equal"):
        ada := User { id: "ada", display_name: "Ada" }
        grace := User { id: "grace", display_name: "Ada" }
        assert_equal(ada, grace, reason="deliberately unequal ids")  # panic: assertion-failed
