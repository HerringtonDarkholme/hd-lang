# test: pointer loans: a `&mut` to a `UniqList` element behind a `*T`, held across a bang call that suspends and acts; an alias grows the collection; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): panics collection-pinned.
use std.time.{Clock, sleep}
use std.collections.UniqList

struct Outer:
    items: UniqList[string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq(first: string, last: string) -> UniqList[string]:
    let mut items = UniqList::[string].new()
    items.push(first)
    items.push(last)
    items

fn make() -> *mut Outer:
    box(Outer { items: uniq(second(), orig()), other: second() })

fn act!(alias: *mut Outer) -> string $ Clock:
    sleep!(1ms)
    for round in 0..16:
        alias.items.push(fresh()) # panic: borrow-conflict
    junk := churn()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *mut Outer) -> string $ Clock:
    r := p.items.get_mut(1).expect("slot")
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Clock:
    p := make()
    seen := probe!(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
