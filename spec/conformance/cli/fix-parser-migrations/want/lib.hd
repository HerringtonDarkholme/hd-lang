## café keeps every edit in UTF-8 byte coordinates.
use std.fs.{FsRead, read_text}

fn first(pair: (string, i32)) -> string:
    pair._0

fn empty() -> Map[string, i32]:
    let table: Map[string, i32] = {}
    table

fn save() -> void:
    pass

fn finish() -> void:
    defer:
        save()

fn spread(pair: (i32, i32)) -> i32:
    let (low, high) = pair
    high - low
