use std.testing.assert_equal

fn in_if(value: i32?) -> i32:
    if true:
        let .Some(number) = value else: return 0
        return number
    0

fn in_else_if(value: i32?) -> i32:
    if false:
        return 0
    else if true:
        let .Some(number) = value else: return 0
        return number
    0

fn in_else(value: i32?) -> i32:
    if false:
        return 0
    else:
        let .Some(number) = value else: return 0
        return number

fn in_while(value: i32?) -> i32:
    while true:
        let .Some(number) = value else: return 0
        return number
    0

fn in_match(value: i32?) -> i32:
    match value:
        .Some(_) =>
            let .Some(number) = value else: return 0
            number
        .None => 0

fn in_for(values: List[i32?]) -> i32:
    for value in values:
        let .Some(number) = value else: continue
        return number
    0

fn deeper(value: i32?) -> i32:
    if true:
        for _ in 0..1:
            if true:
                let .Some(number) = value else: return 0
                return number
    0

fn nested_loop_else(values: List[i32]) -> i32:
    if true:
        for value in values:
            return value
        else:
            return 0
    0

pub fn main() -> void $ Console:
    assert_equal(in_if(.Some(2)), 2, reason="if success")
    assert_equal(in_if(.None), 0, reason="if fallback")
    assert_equal(in_else_if(.Some(2)), 2, reason="else if")
    assert_equal(in_else(.Some(2)), 2, reason="else")
    assert_equal(in_while(.Some(2)), 2, reason="while")
    assert_equal(in_match(.Some(2)), 2, reason="match")
    assert_equal(in_for([.None, .Some(2)]), 2, reason="for continue")
    assert_equal(deeper(.Some(2)), 2, reason="deeper nesting")
    assert_equal(nested_loop_else([]), 0, reason="loop else neighbour")
    println("nested let-else ok")
