# Cancelling a pending wait leaves its socket open and its input available.
# No time provider is needed to let a sibling cancel a network wait.
use std.net.{Net, NetError, TcpStream, UdpSocket, bind_udp, connect, listen}
use std.task.{all, race}
use std.testing.assert_equal

fn read_size!(stream: &mut dyn TcpStream) -> usize:
    stream.read!(2).expect("the pending TCP read").len()

fn receive_size!(socket: &mut dyn UdpSocket) -> usize:
    socket.receive!(2).expect("the pending datagram").bytes.len()

fn stop!() -> usize:
    0

pub fn main!() -> Result[void, NetError] $ Net + Console:
    using listener = listen!("127.0.0.1", 0)?
    address := listener.local_address()?
    pair := all!(listener.accept(), connect("127.0.0.1", address._1))
    using peer = pair._0?
    using client = pair._1?
    assert_equal(race!(read_size(peer), stop()), 0, reason="a sibling cancels the pending read")
    client.write!("abc".to_utf8())?
    assert_equal(peer.read!(1)?, "a".to_utf8(), reason="the next read keeps the prefix")
    assert_equal(peer.read!(1)?, "b".to_utf8(), reason="a partial read leaves the next byte")
    assert_equal(peer.read!(1)?, "c".to_utf8(), reason="the suffix remains in order")

    using receiver = bind_udp!("127.0.0.1", 0)?
    using sender = bind_udp!("127.0.0.1", 0)?
    target := receiver.local_address()?
    assert_equal(
        race!(receive_size(receiver), stop()),
        0,
        reason="a sibling cancels the pending receive",
    )
    sender.send_to!("127.0.0.1", target._1, "hey".to_utf8())?
    datagram := receiver.receive!(3)?
    assert_equal(datagram.bytes, "hey".to_utf8(), reason="the next receive keeps the datagram")
    println("cancelled waits keep TCP and UDP input")
    .Ok(())
