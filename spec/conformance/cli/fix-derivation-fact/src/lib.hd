use std.structure.Structure

data Style:
    prefix: string = ""

fn style(prefix: string = "") -> Style:
    Style { prefix: prefix }

data Loud:
    id: i64

@style(prefix="db_")  # keep café
impl Loud by Structure:
    id += ["key"]

data Quiet:
    id: i64

@"internal"
impl Quiet by Structure:
    id += ["key"]
