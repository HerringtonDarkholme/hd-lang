enum Pair:
    Values(left: i32, right: i32)

fn count() -> i32:
    let mut counter = +0
    counter += +1
    counter

fn borrowed() -> i32:
    let mut counter = +0
    r := &mut counter
    *r += +1
    counter

fn work!() -> void:
    pass

fn annotated() -> void:
    let mut pending: Suspend[void] = work()
    _ := pending

fn swapped(value: Pair) -> i32:
    match value:
        .Values(right, left) => left - right

pub fn main() -> void:
    _ := count()
    _ := borrowed()
    annotated()
    _ := swapped(.Values(+1, +2))

# Spec 04 Binding Forms: types.bind.let-mut-primitive-lint, with an annotation.
fn count_up() -> i32:
    let mut n: i32 = +0
    n = n + +1
    n

enum Choice:
    Pair(then_value: i32, else_value: i32)

# Spec 06 Payload Patterns: flow.match.payload.name-mismatch.lint and
# flow.match.payload.name-mismatch.example, through a type-qualified variant.
fn qualified(choice: Choice) -> i32:
    match choice:
        Choice.Pair(else_value, then_value) => then_value - else_value
