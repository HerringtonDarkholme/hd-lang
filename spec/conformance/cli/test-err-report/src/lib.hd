@error("disk full")
pub data DiskError:
    free: i64

@error
pub enum SaveError:
    @error("cannot save $path")
    Write(path: string, @source error: DiskError)

pub fn save() -> Result[void, SaveError]:
    .Err(SaveError.Write("notes.txt", DiskError { free: 0 }))

tests:
    it("saves the notes"):
        save()?
        .Ok(())
