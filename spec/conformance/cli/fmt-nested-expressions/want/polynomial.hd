fn polynomial(x: f64) -> f64:
    square := x * x
    (
        1.66666666666666019037e-01
        + square * (
            -2.77777777770155933842e-03
            + square * (
                6.61375632143793436117e-05
                + square * (-1.65339022054652515390e-06 + square * 4.13813679705723846039e-08)
            )
        )
    )
