use std.task.{Backoff, Layer, Retry, SelectiveRetry, TimeLimit, apply, retry, timeout, with_timeout}

pub struct Counts:
    runs: usize

struct CountRuns:
    counts: *mut Counts

impl[T, $R] Layer[fn!() -> T $ R] for CountRuns:
    type Wrapped = fn!() -> T $ R
    fn wrap(self, work: fn!() -> T $ R) -> (fn!() -> T $ R):
        fn!() -> T $ R:
            self.counts.runs += 1
            work!()

pub fn answer!(counts: *mut Counts) -> usize:
    apply!(((), CountRuns { counts: counts })):
        42

pub fn configurations() -> (TimeLimit, Retry, SelectiveRetry[string], ((), TimeLimit)):
    (timeout(1s), retry(Backoff {}), retry(Backoff {}).when(fn(error: string): error == "busy"), with_timeout(2s, ()))

fn configuration_count(values: (TimeLimit, Retry, SelectiveRetry[string], ((), TimeLimit))) -> usize: 4

pub fn main!() -> void $ Console:
    if configuration_count(configurations()) != 4:
        panic("policy configuration construction needs no Clock")
    counts := &mut Counts { runs: 0 }
    value := answer!(counts)
    if value != 42 || counts.runs != 1:
        panic("untimed policy returned the wrong value or invocation count")
    println("untimed $value ${counts.runs}")
