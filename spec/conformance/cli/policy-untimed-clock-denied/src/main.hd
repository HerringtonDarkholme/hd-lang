use std.convert.From
use std.task.{
    Backoff,
    Breaker,
    CircuitOpen,
    Guard,
    Hedge,
    Layer,
    Retry,
    SelectiveRetry,
    TimeLimit,
    apply,
    fallback,
    guarded,
    hedged,
    retry,
    timeout,
    with_timeout,
}

pub struct Counts:
    runs: usize

struct CountRuns:
    counts: *mut Counts

impl[T, $ R] Layer[fn!() -> T $ R] for CountRuns:
    type Wrapped = fn!() -> T $ R
    fn wrap(self, work: fn!() -> T $ R) -> (fn!() -> T $ R):
        fn!() -> T $ R:
            self.counts.runs += 1
            work!()

pub fn answer!(counts: *mut Counts) -> usize:
    apply!(((), CountRuns { counts: counts })):
        42

pub fn configurations() -> (TimeLimit, Retry, SelectiveRetry[string], ((), TimeLimit)):
    (
        timeout(1s),
        retry(Backoff {}),
        retry(Backoff {}).when(fn(error: string): error == "busy"),
        with_timeout(2s, ()),
    )

fn configuration_count(
    values: (TimeLimit, Retry, SelectiveRetry[string], ((), TimeLimit)),
) -> usize:
    4

enum GuardError:
    Failed
    Open

impl From[CircuitOpen] for GuardError:
    fn from(error: CircuitOpen) -> GuardError:
        .Open

fn backup!() -> Result[usize, GuardError]:
    .Ok(7)

pub fn untimed_fallback!() -> usize:
    state := box(Breaker { failures: 0, limit: 1, calls: 0 })
    result := apply!(guarded(state) |> fallback(backup, _)):
        let failed: Result[usize, GuardError] = .Err(.Failed)
        failed
    match result:
        .Ok(value) => value
        .Err(_) => panic("untimed fallback failed")

pub fn more_configurations(state: *mut Breaker) -> (Guard, Hedge):
    (guarded(state), hedged(1ms))

fn more_configuration_count(values: (Guard, Hedge)) -> usize:
    2

pub fn main!() -> void $ Console:
    if configuration_count(configurations()) != 4:
        panic("policy configuration construction needs no Clock")
    state := box(Breaker { failures: 0, limit: 1, calls: 0 })
    if more_configuration_count(more_configurations(state)) != 2 || untimed_fallback!() != 7:
        panic("new policy construction and untimed application need no Clock")
    counts := box(Counts { runs: 0 })
    value := answer!(counts)
    if value != 42 || counts.runs != 1:
        panic("untimed policy returned the wrong value or invocation count")
    println("untimed $value ${counts.runs}")
