# café: preserve UTF-8 and the actual expression names
pub fn list(items: List[string]) -> string:
    "items ${items}"

pub fn map(entries: Map[string, i32]) -> string:
    "entries ${entries}"

pub fn unicode(τιμές: List[i32]) -> string:
    "${τιμές} and ${τιμές}"

pub fn bounded[T < Debug](items: List[T]) -> string:
    "${items}"

type Lookup = Map[string, i32]
pub fn alias(values: Lookup) -> string:
    "${values}"
