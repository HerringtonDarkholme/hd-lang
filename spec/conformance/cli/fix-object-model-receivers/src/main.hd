data Counter:
    count: i32

impl Counter:
    fn bump(mut self) -> void:
        self.count += 1

    fn read(self) -> i32:
        self.count

pub fn main() -> void $ Console:
    let mut c = Counter { count: 0 }
    c.bump()
    c.bump()
    let seen: mut List[i32] = []
    seen.push(c.read())
    println("${c.read()} ${seen.len()}")
