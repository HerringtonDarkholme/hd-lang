data Node:
    name: string
    next: Node?

data Team:
    names: List[string]
    lead: mut Node

fn chain(n: Node?) -> string:
    match n:
        .Some(node) => node.name + " " + chain(node.next)
        .None => "."

fn add(xs: mut List[string], x: string) -> void:
    xs.push(x)

fn count(xs: List[string]) -> usize:
    xs.len()

pub fn main() -> void $ Console:
    let roster: mut List[string] = ["ada"]
    tail := Node { name: "b", next: .None }
    let team: mut Team = Team { names: roster, lead: Node { name: "a", next: tail } }
    add(roster, "grace")
    team.lead.name = "z"
    println("${count(team.names)} ${chain(team.lead)}")
