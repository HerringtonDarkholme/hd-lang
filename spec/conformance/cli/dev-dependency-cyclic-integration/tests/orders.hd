use dep.fixtures.{sample_count, sample_orders}
use pkg.{order_count}
use std.testing.assert_equal

it("counts the sample orders"):
    assert_equal(order_count(sample_orders()), 2, reason="two sample orders")
    assert_equal(sample_count(), 2, reason="the fixtures package sees the one normal build")

# Spec 10 Test Modules: module.test.dev-dependency, module.test.cyclic-dev-allowed.
# fixtures is a dev dependency that depends back on shop; an integration test may use it.
