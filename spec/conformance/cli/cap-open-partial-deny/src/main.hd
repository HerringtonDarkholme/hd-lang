use std.fs.{FsError, FsRead, open}
use std.io.Read
use std.path.Path

fn attempt!(path: string) -> string $ FsRead:
    match open!(Path(path)):
        .Ok(opened) =>
            using! file = opened
            match file.read!(64):
                .Ok(bytes) => "read ${bytes.len()} bytes"
                .Err(_) => "read failed"
        .Err(FsError.NotGranted(_)) => "not granted"
        .Err(_) => "failed"

pub fn main!() -> void $ Console + FsRead:
    println("data/note.txt: ${attempt!("data/note.txt")}")
    println("top.txt: ${attempt!("top.txt")}")
