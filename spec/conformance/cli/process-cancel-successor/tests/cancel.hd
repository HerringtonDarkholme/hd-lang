use std.process.Command
use std.task.timeout
use std.testing.{assert, assert_equal}
use std.time.ms

it("a process still runs after cancellation of its predecessor"):
    cancelled := timeout!(500ms):
        Command::new("wait").run!()
    assert(cancelled.is_err(), reason="the pending process is cancelled")
    output := Command::new("next").run!().expect("the successor starts")
    assert_equal(output.stdout, "successor\n", reason="its complete output is retained")
    assert_equal(output.status, 0, reason="it finishes normally")
