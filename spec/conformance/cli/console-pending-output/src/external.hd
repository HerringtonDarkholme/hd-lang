# The parity driver holds stdout unread until the sibling writes a marker.
use std.fs.{FsWrite, write_text}
use std.path.Path
use std.task.all
use std.time.{Clock, ms, sleep}

fn output!(marker: string) -> void $ Console + FsWrite + Clock:
    write_text!(Path(marker + "-entered"), "entered").expect("entry marker")
    $.use(Console).write!("x".repeat(2097152)).expect("output")
    sleep!(ms(50))

fn sibling!(marker: string, fail: bool) -> void $ FsWrite + Clock:
    sleep!(ms(10))
    write_text!(Path(marker), "tick").expect("progress marker")
    if fail:
        panic("output-panic-drain")

pub fn exercise!(marker: string, fail: bool) -> void $ Console + FsWrite + Clock:
    _ := all!(output(marker), sibling(marker, fail))
