use std.error.Error

use std.cli.{args, Args}
use std.process.ExitCode

pub fn main!() -> Result[ExitCode, *dyn Error] $ Console + Args:
    println("hello")
    words := args()
    for word in words:
        println(word)
    if words.len() > 0:
        return .Ok(ExitCode(3))
    .Ok(ExitCode(0))
