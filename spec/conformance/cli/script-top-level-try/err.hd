use std.error.Error
use std.time.{ms, sleep}

pub struct Refused:
    reason: string

impl Display for Refused:
    fn to_string(self) -> string: "refused: ${self.reason}"

impl Error for Refused

fn check(ok: bool) -> Result[void, Refused]:
    if ok: .Ok(()) else: .Err(Refused { reason: "no" })

sleep!(ms(1))
println("before")
check(false)?
println("after")
