struct Parcel:
    label: string
    weight: i32

@derive(Debug)
enum Expr:
    Num(n: i64)
    Add(left: *Expr, right: *Expr)

pub fn main() -> void $ Console:
    parcel := Parcel { label: "mug", weight: 3 }
    shared := box(Parcel { label: "mug", weight: 3 })
    weight := box(+3)
    dbg(parcel)
    dbg(shared)
    dbg(weight)
    dbg(box(Expr.Num(7)))
    println("done")

# Spec 10 Debug Values: module.dbg.value.reference, module.dbg.value.debug; std/format References: std-format.debug.reference.
