fn first['a, T](x: &'a T, y: &'a T) -> &'a T:
    x

fn second[T, 'a](x: &'a T, y: &'a T) -> &'a T:
    y

pub fn main() -> void:
    a := +1
    b := +2
    _ := *first(&a, &b) + *second(&a, &b)

# A method's parameter list is checked too.
struct S:
    n: i32

impl S:
    fn pick['a, T](x: &'a T) -> &'a T:
        x
