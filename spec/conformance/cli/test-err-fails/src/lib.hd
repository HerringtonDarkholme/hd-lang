use std.error.Error

struct Notice:
    text: string

impl Display for Notice:
    fn to_string(self) -> string:
        "notice: ${self.text}"

impl Error for Notice

fn check(text: string) -> Result[void, Notice]:
    if text == "ok": .Ok(()) else: .Err(Notice { text: text })

tests:
    use std.testing.{it_each, it_prop}

    it("passes on an Ok result"):
        check("ok")?
        .Ok(())

    it("fails on an Err result"):
        check("help")?
        .Ok(())

    it_each(
        "each row follows the rule",
        ["ok", "again"],
        body=fn!(text: string):
            check(text)?
            .Ok(())
        ,
    )

    it_prop(
        "a property follows the rule",
        prop=fn!(value: i32):
            check("prop")?
            .Ok(())
        ,
    )

# Spec 10 Test Outcomes: module.testing.passes, module.testing.fail-cases, module.testing.err-runner-source-report.
