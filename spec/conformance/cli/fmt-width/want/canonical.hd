        20.. if a % 2 == 0 => 1
        -3.. if a > 0 => 2
        ..5 if a > 0 => 3
        ..=-5 if a < 0 => 4
        6..8 if a > 0 => 5
        9..=12 if a > 0 => 6
        _ => 7
    match t:
