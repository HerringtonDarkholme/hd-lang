    )
# a pipe closure chain keeps empty arguments and uses dot lines
fn f(value: Item):
    value
        |> map(fn(item): item.configuration().named("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))
# a postfix chain keeps the first complete call as its head
fn f(app: App):
    app.configuration()
        .named(
            "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        )
# nested groups repeat until every breakable line fits
fn f():
