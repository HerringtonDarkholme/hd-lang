# a value `if` before another struct field stays parseable
struct S:
    a: i32
    b: i32

fn pick(
    flag_with_a_rather_long_name: bool,
    first_value_with_a_long_name: i32,
    second_value_with_a_long_name: i32,
) -> S:
    S {
        a: if flag_with_a_rather_long_name: first_value_with_a_long_name else: second_value_with_a_long_name + 1000000,
        b: 2,
    }
# a nonfinal value `if` in call and collection literals stays parseable
fn f(
    flag_with_a_rather_long_name: bool,
    first_value_with_a_long_name: i32,
    second_value_with_a_long_name: i32,
):
    consume(
        if flag_with_a_rather_long_name: first_value_with_a_long_name else: second_value_with_a_long_name + 1000000,
        2,
    )
    [
        if flag_with_a_rather_long_name:
            first_value_with_a_long_name
        else:
            second_value_with_a_long_name + 1000000
        , 2,
    ]
    {
        "a": if flag_with_a_rather_long_name: first_value_with_a_long_name else: second_value_with_a_long_name + 1000000,
        "b": 2,
    }
