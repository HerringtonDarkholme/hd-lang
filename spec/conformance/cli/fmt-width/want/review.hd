                the_second_descriptive_parameter_name,
                the_third_descriptive_parameter_name,
            ],
        },
        the_first_descriptive_parameter_name,
    )
# literal arguments split without splitting either literal
fn f():
    consume(
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy",
    )
# inline closures and suites keep their expression boundaries
