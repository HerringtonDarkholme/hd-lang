# a suite-valued comprehension clause keeps the next clause separate
fn f():
    {for _ in match true:
        _ => return
    for '\n' in main := if true:
        return
    if true => false: false}
# pipe step suites remain on one line
fn f(value: i32):
    value
        |> map(fn(item): consume(item, aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa))
# a generated comma is included in the fit decision
