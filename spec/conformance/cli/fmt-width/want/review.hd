# a suffix comment's separator does not count toward the code width
fn f():
    consume(xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx) # note
# continuation wrappers use the printed column
fn f():
    value := (
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
        + bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
    )
# binary parentheses are added only in whitelisted slots
fn f():
    consume(
