fn demo(mut count: List[i32]) -> void:
    button("add", fn():
        n := count[0]
        count[0] = n + 1
    )
    one(fn():
        count[0] = 1
        count[0] = 2
    , "x")
    two(
        fn():
            count[0] = 1
            count[0] = 2
        , fn():
            count[0] = 3
            count[0] = 4
    )
# a closure holding a trailing block keeps its suite inside brackets
fn demo() -> List[string]:
    each(["a", "b"], fn(item):
        live:
            "<$item>"
    )
# an existing multi-line closure joins with no lone comma
fn f():
    consume(
        the_first_descriptive_parameter_name,
        the_second_descriptive_parameter_name,
        the_third_descriptive_parameter_name,
        fn(value): use_value(value)
    )
# parenthesized multi-line closures keep their delimiter lines
fn pick(flag: bool):
    choice(
        flag,
        (fn(a):
            doubled := a * 2
            doubled + 22
        ),
        (fn(b):
            halved := b / 2
            halved - 5
        )
    )
