pub fn group(n: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    for i in 0..n:
        let mut xs = m.get(0).unwrap_or([])
        xs.push(i)
        m[0] = xs
    for i in 0..n:
        let mut ys = match m.get(1):
            .Some(v) => v
            .None => []
        ys.push(i)
        ys.push(i + 1)
        m[1] = ys
    m

pub fn kept(n: i32) -> usize:
    let mut m: Map[i32, List[i32]] = {}
    let total: usize = 0
    for i in 0..n:
        let mut xs = m.get(0).unwrap_or([])
        xs.push(i)
        m[0] = xs
        total = total + xs.len()
    total
