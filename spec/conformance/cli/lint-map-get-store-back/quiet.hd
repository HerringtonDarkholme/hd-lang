# After the fix-its of shapes.hd, no finding is left.
# A `match` on `get` is reported in either arm order, and with a wildcard arm.
fn group_match_arms(n: i32, key: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    for i in 0..n:
        ys := m.get_or_insert(key, [])
        ys.push(i)
        ys.push(i + 1)
    for i in 0..n:
        m.get_or_insert(1, [7])[0] = i
    for i in 0..n:
        m.get_or_insert(2, []).push(i)
    m

# After the fix-its of shapes.hd, no finding is left.
# Struct values, their fields and a map held in a field are rewritten.
struct Tally:
    count: i32
    names: List[string]

struct Book:
    tallies: Map[string, Tally]

impl Book:
    fn note(&mut self, name: string) -> void:
        tally := self.tallies.get_or_insert(name, Tally { count: 0, names: [] })
        tally.count += 1
        # the name joins the list
        tally.names.push("seen")

fn count(words: List[string]) -> Map[string, Tally]:
    let mut t: Map[string, Tally] = {}
    for word in words:
        t.get_or_insert(word, Tally { count: 0, names: [] }).count += 1
    t

# After the fix-its of shapes.hd, no finding is left.
# Two interleaved maps and a reused name each report their own store.
fn group_two_maps(n: i32) -> Map[i32, List[i32]]:
    let mut a: Map[i32, List[i32]] = {}
    let mut b: Map[i32, List[i32]] = {}
    for i in 0..n:
        a.get_or_insert(0, []).push(i)
        b.get_or_insert(0, []).push(i)
    a

# After the fix-its of shapes.hd, no finding is left.
# A generic body, a closure body and a nested block each report once.
fn add[K < Eq & Hash](m: &mut Map[K, List[i32]], key: K, n: i32) -> void:
    m.get_or_insert(key, []).push(n)

fn group_body_forms(n: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    add(&mut m, 1, 2)
    add(&mut m, 3, 4)
    note := fn(key: i32): add(&mut m, key, 0)
    note(5)
    if n > 0:
        m.get_or_insert(n, []).push(1)
    m

# A change that reads the map, or moves the key, is silent.
fn group_reads_map_or_moves_key(n: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    let mut key = 0
    for i in 0..n:
        let mut xs = m.get(0).unwrap_or([])
        size := m.len()
        xs.push(i)
        m[0] = xs
    for i in 0..n:
        let mut ys = m.get(key).unwrap_or([])
        key = key + 1
        ys.push(i)
        m[key] = ys
    for i in 0..n:
        let mut zs = m.get(key).unwrap_or([])
        zs.push(i)
        m[key + 1] = zs
    for i in 0..n:
        let mut ws = m.get(1).unwrap_or(m.get(2).unwrap_or([]))
        ws.push(i)
        m[1] = ws
    m

# An early exit, a closure or another use between the get and the store is silent.
fn keep(xs: List[i32]) -> void:
    _ := xs

fn group_other_uses_between(n: i32) -> Map[i32, List[i32]]?:
    let mut m: Map[i32, List[i32]] = {}
    let limits: Map[i32, i32] = {}
    for i in 0..n:
        let mut xs = m.get(0).unwrap_or([])
        if i > 3:
            break
        xs.push(i)
        m[0] = xs
    for i in 0..n:
        let mut xs = m.get(1).unwrap_or([])
        xs.push(limits.get(i)?)
        m[1] = xs
    for i in 0..n:
        let mut xs = m.get(2).unwrap_or([])
        xs.push(i)
        keep(xs)
        m[2] = xs
    for i in 0..n:
        let mut xs = m.get(3).unwrap_or([])
        add := fn(x: i32): x + 1
        xs.push(add(i))
        m[3] = xs
    for i in 0..n:
        let mut xs = m.get(4).unwrap_or([])
        xs = [i]
        m[4] = xs
    .Some(m)

# Other matches on `get` are silent.
fn group_other_matches(n: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    for i in 0..n:
        let mut xs = match m.get(0):
            .Some(v) if v.len() > 2 => v
            .Some(v) => v
            .None => []
        xs.push(i)
        m[0] = xs
    for i in 0..n:
        let mut xs = match m.get(1):
            .Some(v) => [i]
            .None => []
        xs.push(i)
        m[1] = xs
    for i in 0..n:
        let mut xs = match m.get(2):
            .Some(_) => []
            .None => []
        xs.push(i)
        m[2] = xs
    for i in 0..n:
        let mut xs = match m.get(3):
            .None => []
            found => found.unwrap_or([])
        xs.push(i)
        m[3] = xs
    for i in 0..n:
        let mut xs = match m.get(4):
            .Some(v) => v
            .None => return m
        xs.push(i)
        m[4] = xs
    for i in 0..n:
        let mut xs = match m.get(5):
            .Some(v) => v
            .None =>
                fresh := [i]
                fresh
        xs.push(i)
        m[5] = xs
    m

# A computed key may run twice in the original and once in the fix, so only a
# name or a literal key is rewritten.
fn group_computed_key(n: i32) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    for i in 0..n:
        let mut xs = m.get(i % 4).unwrap_or([])
        xs.push(i)
        m[i % 4] = xs
    m

# Shapes without a map copy are silent.
fn group_no_map_copy(
    n: i32,
    mut lists: List[List[i32]],
    mut maps: List[Map[i32, List[i32]]],
) -> Map[i32, List[i32]]:
    let mut m: Map[i32, List[i32]] = {}
    for i in 0..n:
        let mut xs = maps[0].get(0).unwrap_or([])
        xs.push(i)
        maps[0][0] = xs
    for i in 0..n:
        let mut xs = lists.get(0).unwrap_or([])
        xs.push(i)
        lists[0] = xs
    for i in 0..n:
        let mut xs = m.remove(0).unwrap_or([])
        xs.push(i)
        m[0] = xs
    for i in 0..n:
        xs := m.get(0).unwrap_or([])
        m[0] = xs
    for i in 0..n:
        let mut xs = m.get(0).unwrap_or([])
        m[0] = xs
        xs.push(i)
    let mut outer: List[i32] = []
    for i in 0..n:
        outer = m.get(5).unwrap_or([])
        outer.push(i)
        m[5] = outer
    m
