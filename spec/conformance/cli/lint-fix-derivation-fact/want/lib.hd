use std.meta.Structure

struct Style:
    prefix: string = ""

fn style(prefix: string = "") -> Style:
    Style { prefix: prefix }

struct Loud:
    id: i64

@style(prefix="db_") # keep café
impl Loud by Structure:
    id += ["key"]

struct Quiet:
    id: i64

@"internal"
impl Quiet by Structure:
    id += ["key"]

# Spec 14 Facts: annot.fact.unused-block-decorator.lint (a user value, `Loud`)
# and annot.fact.unused-block-decorator.any-type (a standard value, `Quiet`).
