use std.error.Error

pub struct Usage:
    text: string

impl Display for Usage:
    fn to_string(self) -> string:
        self.text

impl Error for Usage

fn parse() -> Result[void, Usage]:
    .Err(Usage { text: "bad flag" })

pub fn main() -> Result[void, *dyn Error] $ Console:
    println("starting")
    parse()?
    .Ok(())
