use dep.fixtures.{sample_orders}
use pkg.{order_count}
use std.testing.assert_equal

it("counts the sample orders in a unit test"):
    assert_equal(order_count(sample_orders()), 2, reason="two sample orders")

# Spec 10 Test Modules: module.test.dev-dependency. A test module may use a dev
# dependency that does not depend back on the package.
