use std.console.{ConsoleInput, read_all, read_line}

pub fn main!() -> void $ Console + ConsoleInput:
    println(debug(read_line!().expect("first line is readable").unwrap_or("EOF")))
    println(debug(read_all!().expect("remaining input is readable")))
    println(debug(read_line!().expect("EOF is readable").unwrap_or("EOF")))
