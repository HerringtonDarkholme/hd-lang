## Greets by name.
##
## ```hd
## use pkg.{greeting}
## use std.testing.snapshot
##
## snapshot(greeting("Ada"),
##     expect="""
##     hello
##     """)
## snapshot(greeting("Grace"))
## snapshot(greeting("Lin"), expect="hello,\u{20}Lin")
## ```
pub fn greeting(name: string) -> string: "hello, " + name

struct Box:
    ## ```hd
    ## use pkg.{greeting}
    ## use std.testing.snapshot
    ##
    ## snapshot(greeting("Box"), expect="")
    ## ```
    label: string
