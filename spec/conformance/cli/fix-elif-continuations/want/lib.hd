## café keeps both edit ranges in UTF-8 bytes.
fn size(n: i32) -> string:
    if n > 100: "large" else if n > 10: "medium" else: "small"

fn inline(n: i32) -> string:
    if n > 100: "large" else if n > 10: "medium" else: "small"

fn elif(value: i32) -> i32:
    value

fn named(flag: bool) -> i32:
    if flag:
        pass
    elif(+7)

fn binding(flag: bool) -> usize:
    if flag:
        pass
    elif := 4
    elif
