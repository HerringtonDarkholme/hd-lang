use std.meta.Structure
use std.encoding.Serialize

struct Session:
    id: i64
    cache: i64 = 0

impl Debug for Session by Structure:
    cache = pass

impl Serialize for Session by Structure:
    id = []

pub fn main() -> void:
    pass

# Spec 14 Line Drift: annot.line.drift.lint.derive, with standard traits.
@derive(Debug)
struct Record:
    id: i64
    cache: i64 = 0

impl Serialize for Record by Structure:
    cache = pass
