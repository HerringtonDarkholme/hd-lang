struct Account:
    owner: string
    balance: i64

fn deposit(a: &mut Account, amount: i64) -> void:
    a.balance += amount

pub fn main() -> void $ Console:
    let acct: &mut Account = &mut Account { owner: "ada", balance: 10 }
    seen := acct
    deposit(acct, 5)
    println("${acct.owner} ${acct.balance} ${seen.balance}")
