## Shapes, with one typo of each kind of name.

pub struct Point:
    x: i32
    yval: i32

pub enum Shape:
    Dot(at: Point)
    Empty

pub fn height(p: Point) -> i32:
    p.yvl

pub fn moved(count: i32) -> Pont:
    Point { x: cuont, yval: 0 }

pub fn area(s: Shape) -> i32:
    match s:
        .Dot(at=p) => 0
        .Emtpy => 1

pub fn size(xs: List[i32]) -> usize:
    xs.lenn()
