data Base:
    id: i32

data Item:
    Base
    name: string

data Box:
    label: string
    count: i32

pub fn main() -> void $ Console:
    item := Item { Base: ...Base { id: 1 }, name: "pen" }
    let b: mut Box = Box { label: "desk", count: 2 }
    b.count += 1
    println("${item.name} ${b.label} ${b.count}")
