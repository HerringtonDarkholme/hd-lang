fn order_count(lines: List[string]) -> usize:
    lines.len()

tests:
    use dep.fixtures.{sample_orders}
    use std.testing.assert_equal

    it("counts the sample orders"):
        assert_equal(order_count(sample_orders()), 2, reason="two sample orders")

# Spec 10 Test Modules: module.test.dev-dependency.in-tests. A tests block in a
# plain source module may use a dev dependency that does not depend back.
