use std.task.timeout
use std.time.{Clock, ms}

@host
pub trait Source:
    fn wait!(&mut self, kind: string) -> string
    fn aborts(&self) -> u32

pub fn main!() -> void $ Source + Clock + Console:
    match timeout!(ms(10), work=fn!() -> string $ Source: $.use(Source).wait!("cancel")):
        .Err(_) => println("cancelled")
        .Ok(_) => panic("the cancelled operation must not complete")
    println("aborts ${$.use(Source).aborts()}")
    println($.use(Source).wait!("deliver"))
