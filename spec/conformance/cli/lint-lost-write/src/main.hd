struct Box:
    value: i32

impl Box:
    fn set(&mut self, value: i32) -> void:
        self.value = value

fn push_lost(mut values: List[i32]) -> void:
    values.push(+1)

fn element_store_lost(mut values: List[i32]) -> void:
    values[0] = +1

fn map_store_lost(mut values: Map[string, i32]) -> void:
    values["one"] = +1

fn receiver_call_lost(mut value: Box) -> void:
    value.set(+1)

fn read_after(mut values: List[i32]) -> usize:
    values.push(+1)
    values.len()

fn print_after(mut values: List[i32]) -> void $ Console:
    values.push(+1)
    println(values.len())

fn pass_after(mut values: List[i32]) -> usize:
    values.push(+1)
    read_after(values)

fn return_after(mut values: List[i32]) -> List[i32]:
    values.push(+1)
    values

fn capture_after(mut values: List[i32]) -> fn() -> usize:
    values.push(+1)
    fn() -> usize: values.len()

fn countdown(mut n: i32) -> i32:
    let steps = +0
    while n > 0:
        n = n - 1
        steps = steps + 1
    steps

fn count_new(mut seen: List[i32], items: List[i32]) -> usize:
    let n: usize = 0
    for x in items:
        if !seen.contains(x):
            seen.push(x)
            n = n + 1
    n

pub fn main() -> void:
    pass
