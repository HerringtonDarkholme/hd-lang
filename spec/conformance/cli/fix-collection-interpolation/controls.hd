fn optional(value: i32?) -> string:
    "${value}"

fn short(items: List[string]) -> string:
    "$items"

fn shadow_parameter(items: List[string], debug: fn(List[string]) -> string) -> string:
    "${items}"

fn shadow_local(items: List[string]) -> string:
    debug := fn(value: List[string]) -> string: "hidden"
    _ := debug
    "${items}"

fn generic[T](items: List[T]) -> string:
    "${items}"

struct Hidden:
    value: i32

fn missing_debug(items: List[Hidden]) -> string:
    "${items}"

fn same(items: List[string]) -> List[string]:
    items

fn complex(items: List[string]) -> string:
    "${same(items)}"

fn other_bound[T < Display](items: T) -> string:
    items.to_string()

fn argument(items: List[string]) -> string:
    other_bound(items)
