pub trait Tagged:
    fn tag(self) -> string

pub trait Stamped:
    fn mark(self) -> string

pub data Inner:
    pub note: string
    pub code: string
    serial: i32

impl Inner:
    pub fn tag(self) -> string:
        "inner"

    pub fn code(self) -> string:
        "inner code"

    pub fn secret(self) -> string:
        "inner secret"

    fn audit(self) -> string:
        "inner audit"

pub data Outer:
    Inner
    code: string
    revision: i32

impl Outer:
    fn secret(self) -> string:
        "outer secret"

    fn stamp(self) -> string:
        "outer stamp"

impl Tagged for Outer:
    fn tag(self) -> string:
        "outer"

impl Stamped for Outer:
    fn mark(self) -> string:
        "outer mark"

pub fn make_outer() -> Outer:
    Outer { Inner: ...Inner { note: "note", code: "inner field", serial: 7 }, code: "private", revision: 1 }
