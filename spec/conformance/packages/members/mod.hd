pub trait Tagged:
    fn tag(self) -> string

pub trait Stamped:
    fn mark(self) -> string

pub data Inner:
    pub note: string
    serial: i32

impl Inner:
    pub fn tag(self) -> string:
        "inner"

    pub fn code(self) -> string:
        "inner code"

    fn audit(self) -> string:
        "inner audit"

pub data Outer:
    Inner
    code: string
    revision: i32

impl Outer:
    fn stamp(self) -> string:
        "outer stamp"

impl Tagged for Outer:
    fn tag(self) -> string:
        "outer"

impl Stamped for Outer:
    fn mark(self) -> string:
        "outer mark"

pub fn make_outer() -> Outer:
    Outer { Inner: ...Inner { note: "note", serial: 7 }, code: "private", revision: 1 }

pub data CreatedBySystem:
    pub id: string

impl CreatedBySystem:
    pub fn label(self) -> string:
        "created by system"

pub data ReviewDraft:
    CreatedBySystem
    pub id: string

impl ReviewDraft:
    pub fn label(self) -> string:
        "draft"

pub fn make_draft() -> ReviewDraft:
    ReviewDraft { CreatedBySystem: ...CreatedBySystem { id: "system" }, id: "draft" }
