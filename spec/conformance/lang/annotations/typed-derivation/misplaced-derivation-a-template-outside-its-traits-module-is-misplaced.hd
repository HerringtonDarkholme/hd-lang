# test: a template outside its traits module is misplaced
# fixture-package-tree: misplaced-derivation-a-template-outside-its-traits-module-is-misplaced/src/main.hd
use pkg.lib.show.Show
use std.meta.{Structure, Field, Variant, Describer}

struct Count:
    n: i32

impl[S] Describer[S] for Count:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        self.n = self.n + 1
        .Ok(())

impl[T] Show for T by Structure: # diagnostic: misplaced-derivation
    fn show(self) -> string:
        let mut d = Count { n: 0 }
        _ := T::describe(&mut d)
        "${d.n}"
