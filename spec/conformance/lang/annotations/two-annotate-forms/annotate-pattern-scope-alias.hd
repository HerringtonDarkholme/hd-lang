# test: resolved annotate names retain their generic type pattern
use std.meta
use std.meta.annotate
use std.meta.annotate as targets

@targets::[List[T]](.Field)
struct Fact[T]: pass

fn fact[T]() -> Fact[T]:
    Fact::[T] {}

struct Record:
    @fact
    good: List[i32]
    @fact # diagnostic: type-mismatch
    bad: i32
