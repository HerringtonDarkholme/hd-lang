# test: annotate patterns see non-Copy parameters without instantiating the runtime function at the pattern
use std.meta
use std.meta.annotate as targets

@targets::[T](.Field)
struct StructFact[T < ?Copy]: pass

@meta.annotate::[T](.Field)
enum EnumFact[T < ?Copy]:
    Value

@targets::[fn(T) -> R](.Fn, .Field)
struct FunctionFact[T < ?Copy, R < ?Copy]: pass
