# test: facts of the result of a function declaration is its facts
use std.meta.facts_of

@"label"
fn tagged() -> void:
    pass

fn plain() -> void:
    pass

fn count() -> usize:
    facts_of(tagged).items.len()

fn first() -> string?:
    facts_of(plain).find::[string]()
pub fn main() -> void:
    pass
