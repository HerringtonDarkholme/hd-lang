# test: an unknown name is unknown
# Spec 14 facts_of: annot.facts-of.target.unresolved; name resolution fails first. so not invalid-facts-of-target.
use std.annotation.facts_of

@"label"
fn tagged() -> void:
    pass

fn plain() -> void:
    pass

value := facts_of(missing) # diagnostic: unknown-name
pub fn main() -> void:
    pass
