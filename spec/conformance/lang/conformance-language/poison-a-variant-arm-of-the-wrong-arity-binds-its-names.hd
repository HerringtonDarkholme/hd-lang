# test: an arm with the wrong number of fields binds its names to poison
# Spec README.md: Diagnostics (one failure, one diagnostic).

enum Shape:
    Dot(i32)
    Line(i32, i32)

fn size(s: Shape) -> i32:
    match s:
        .Dot(n, m) => n + m # diagnostic: pattern-arity
        .Line(a, b) => a + b
