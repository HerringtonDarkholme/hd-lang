# test: a bound tuple key takes the clause key
# Rules: expr.index.trait.choice, expr.index.trait.shared-place, trait.resolve.literal-arg.
# expect-stdout: 3
# expect-stdout: 13
# expect-stdout: 20
# expect-stdout: 7
use std.ops.Index
use std.ops.IndexMut
use std.ops.IndexSet

struct Grid:
    cells: List[i32]

impl Index[(i32, i32)] for Grid:
    type Out = i32
    fn index(&self, k: (i32, i32)) -> &i32:
        &self.cells[usize(k._0 * 2 + k._1)]

impl IndexMut[(i32, i32)] for Grid:
    fn index_mut(&mut self, k: (i32, i32)) -> &mut i32:
        &mut self.cells[usize(k._0 * 2 + k._1)]

impl IndexSet[(i32, i32), i32] for Grid:
    fn index_set(&mut self, k: (i32, i32), v: i32) -> void:
        self.cells[usize(k._0 * 2 + k._1)] = v

struct Cube:
    v: i32

impl Index[((i32, i64), i32)] for Cube:
    type Out = i32
    fn index(&self, k: ((i32, i64), i32)) -> &i32:
        &self.v

fn read[T < Index[(i32, i32), Out = i32]](g: &T) -> i32:
    g[(1, 0)]

fn bump[T < IndexMut[(i32, i32), Out = i32]](g: &mut T) -> void:
    g[(1, 0)] += +10

fn put[T < IndexSet[(i32, i32), i32]](g: &mut T) -> void:
    g[(0, 1)] = +20

fn nested[T < Index[((i32, i64), i32), Out = i32]](c: T) -> i32:
    c[((1, 2), 0)]

pub fn main() -> void $ Console:
    let mut g = Grid { cells: [+1, +2, +3, +4] }
    println(read(&g))
    bump(&mut g)
    println(g[(1, 0)])
    put(&mut g)
    println(g[(0, 1)])
    println(nested(Cube { v: +7 }))
