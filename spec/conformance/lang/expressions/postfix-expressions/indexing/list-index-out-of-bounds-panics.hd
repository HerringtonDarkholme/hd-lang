# test: a List index at or past its length panics, for a read and a write
# Spec 05 Index Traits: expr.index.trait.shared-place; std List's `index` checks its bound as `expr.index.list.range` does.

fn store(xs: &mut List[i64], at: usize) -> void:
    xs[at] = 1

pub fn main() -> void:
    let mut xs: List[i64] = [1, 2, 3]
    store(&mut xs, 2)
    store(&mut xs, 3) # panic: index-out-of-bounds
