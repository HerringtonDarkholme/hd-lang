# test: an opaque tuple key takes the clause key
# Rules: expr.index.trait.choice, types.opaque.head-only, trait.resolve.literal-arg.
# expect-stdout: 3
# expect-stdout: 4
use std.ops.Index

struct Grid:
    cells: List[i32]

impl Index[(i32, i32)] for Grid:
    type Out = i32
    fn index(&self, k: (i32, i32)) -> &i32:
        &self.cells[usize(k._0 * 2 + k._1)]

fn make() -> impl Index[(i32, i32), Out = i32]:
    Grid { cells: [+1, +2, +3, +4] }

pub fn main() -> void $ Console:
    let g = make()
    println(g[(1, 0)])
    println(make()[(1, 1)])
