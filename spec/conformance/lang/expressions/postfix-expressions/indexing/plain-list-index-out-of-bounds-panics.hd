# test: a PlainList index at or past its length panics, for a read and a write
# Spec 05 Index Traits: expr.index.trait.shared-place; std PlainList's `index` checks its bound as `expr.index.list.range` does.
use std.collections.PlainList

fn store(xs: &mut PlainList[i64], at: usize) -> void:
    xs[at] = 1

pub fn main() -> void:
    let mut xs: PlainList[i64] = [1, 2, 3]
    store(&mut xs, 2)
    store(&mut xs, 3) # panic: index-out-of-bounds
