# test: f32 power uses the same-width libm result, directly and through a Float bound
# expect: test
use std.num.Float

fn power[T < Float](x: T, y: T) -> T:
    x ** y

tests:
    it("f32 power keeps musl powf rounding at the operator boundary"):
        for (x_bits, y_bits, expected) in [
            (1095454373u32, 3248488448u32, 449367554u32),
            (1082633958, 3248158147, 726022733),
            (1074460728, 3247827845, 889410113),
        ]:
            x := f32::from_bits(x_bits)
            y := f32::from_bits(y_bits)
            assert_equal((x ** y).to_bits(), expected, reason="same-width power")
            assert_equal(power(x, y).to_bits(), expected, reason="Float-bound power")
