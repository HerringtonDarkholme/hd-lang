# test: a spread into a built list literal takes any `for` source: a PlainList, a List, a reference, an integer range and an iterator, each item pushed in order; an exact-size cursor's length is reserved, so two spreads of 9 make a capacity of 18
# Spec 05 List Literals: expr.list.spread.iterable, expr.list.spread.count.
# expect-stdout: 0 5 6 a b 1 2 3 9
# expect-stdout: 9 8
# expect-stdout: 2 6 2 3
# expect-stdout: 9 true
use std.collections.PlainList

fn show(xs: PlainList[string]) -> string:
    let mut out = ""
    for x in xs:
        out = if out == "": x else: "$out $x"
    out

pub fn main() -> void $ Console:
    let ps: PlainList[string] = ["5", "6"]
    names := ["a", "b"]
    let xs: PlainList[string] = ["0", ps..., names..., "1", "2", "3", "9"]
    println(show(xs))
    let ns: PlainList[i64] = [0, (1..4)..., 4, 5, 6, (7..9)...]
    println("${ns.len()} ${ns[8]}")
    r := &ns
    let odd: PlainList[i64] = [ns.iter().filter(fn(x: &i64) -> bool: *x % 2 == 1)...]
    let twice: PlainList[i64] = [r..., r...]
    println("${odd.len() - 2} ${twice.capacity() / 3} ${twice[2]} ${twice[12]}")
    let low: i64 = 10
    let mut it = (low..20).iter()
    _ := it.next()
    let rest: PlainList[i64] = [(&mut it)...]
    println("${rest.len()} ${it.next().is_none()}")
