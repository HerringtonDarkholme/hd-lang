trait Saved:
    fn number(&self) -> i32

struct Wrapped[T]:
    value: T

impl Saved for Wrapped[&'static i32]:
    fn number(&self) -> i32:
        +7

fn require_saved[T < Saved](value: T) -> void:
    pass

fn inspect['a](value: Wrapped[&'a i32]) -> void:
    require_saved(value) # diagnostic: local-reference-escapes
