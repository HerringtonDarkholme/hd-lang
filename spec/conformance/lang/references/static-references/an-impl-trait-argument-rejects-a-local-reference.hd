trait Saved[A]:
    pass

struct Holder:
    value: i32

impl Saved[&'static i32] for Holder:
    pass

fn require_saved['a, T < Saved[&'a i32]](value: T, marker: &'a i32) -> void:
    pass

fn inspect['a](value: Holder, marker: &'a i32) -> void:
    require_saved(value, marker) # diagnostic: local-reference-escapes
