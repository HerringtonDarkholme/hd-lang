# test: a newtype over a type that is not Copy cannot implement a trait whose Self is Copy
# Spec 04 Newtypes: types.newtype.holds. Spec 13 Copy: ref.copy.trait.default.
struct Photo:
    width: u32

impl !Copy for Photo

type Album(Photo)

trait Sized2D:
    fn area(&self) -> u32

impl Sized2D for Album: # diagnostic: missing-supertrait-implementation
    fn area(&self) -> u32:
        1
