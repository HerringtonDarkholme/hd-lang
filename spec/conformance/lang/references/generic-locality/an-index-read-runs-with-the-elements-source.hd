# test: a reference read through a user Index keeps the element it read after the receiver stores a new one
# Spec 13 Generic Locality: ref.generic.call, ref.dep.scope; Spec 5: expr.index.trait.read-ref.
# expect-stdout: x1 q
use std.ops.Index
use std.ops.IndexMut
use std.ops.IndexSet

struct P:
    name: string

struct Holder[T]:
    value: T

impl[T] Index[usize] for Holder[T]:
    type Out = T
    fn index(&self, key: usize) -> &T:
        &self.value

impl[T] IndexMut[usize] for Holder[T]:
    fn index_mut(&mut self, key: usize) -> &mut T:
        &mut self.value

impl[T] IndexSet[usize, T] for Holder[T]:
    fn index_set(&mut self, key: usize, value: T) -> void:
        self.value = value

pub fn main() -> void $ Console:
    p := P { name: "x${1}" }
    q := P { name: "q" }
    let mut h = Holder { value: &p }
    d := &h[0].name
    h[0] = &q
    println("${*d} ${h.value.name}")
