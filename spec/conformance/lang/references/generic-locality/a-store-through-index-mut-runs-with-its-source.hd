# test: a store through the place `&mut r[k]` lends from a user IndexMut keeps a local reference whose source outlives the receiver
# Spec 13 Generic Locality: ref.generic.store, ref.dep.scope; Spec 5: expr.index.trait.mutable-place.
# expect-stdout: c1 zzzzzz9
use std.ops.Index
use std.ops.IndexMut
use std.ops.IndexSet

struct P:
    name: string

struct Holder[T]:
    value: T

impl[T] Index[usize] for Holder[T]:
    type Out = T
    fn index(&self, key: usize) -> &T:
        &self.value

impl[T] IndexMut[usize] for Holder[T]:
    fn index_mut(&mut self, key: usize) -> &mut T:
        &mut self.value

impl[T] IndexSet[usize, T] for Holder[T]:
    fn index_set(&mut self, key: usize, value: T) -> void:
        self.value = value

pub fn main() -> void $ Console:
    a := P { name: "a" }
    c := P { name: "c${1}" }
    let mut h = Holder { value: &a }
    m := &mut h[0]
    *m = &c
    junk := "zzzzzz${9}"
    println("${h.value.name} $junk")
