# test: a function parameter holds no local reference, so it may be passed for a type parameter bounded by 'static
# Spec 13 Local References: ref.local.fn-static.
use std.ops.FnMut

fn later[F < FnMut() -> void & 'static](f: F) -> *mut F:
    box(f)

fn keep(f: fn() -> void) -> void:
    kept := later(f)
