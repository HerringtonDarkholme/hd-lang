# test: a box of a reference to a local is rejected, as a write through any copy of the box would outlive the local
# Spec 13 Boxes: ref.box.local; Local References: ref.local.holding.counted.
struct User:
    name: string

fn alias(a: User) -> usize:
    b := box(&a) # diagnostic: local-reference-outlives-local
    c := b
    if a.name.len() > 0:
        u := User { name: "u" }
        *c = &u
    b.name.len()
