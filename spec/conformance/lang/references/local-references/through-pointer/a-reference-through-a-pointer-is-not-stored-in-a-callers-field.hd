# test: a reference made through a pointer is not stored into a field the caller owns
# Spec 13 Local References: ref.local.pointer.
struct Node:
    v: i32

struct Holder:
    item: *mut Node

struct Slot['a]:
    n: &'a mut Node

fn fill['a](h: &'a Holder, out: &mut Slot['a]) -> void:
    out.n = &mut *h.item # diagnostic: local-reference-escapes
