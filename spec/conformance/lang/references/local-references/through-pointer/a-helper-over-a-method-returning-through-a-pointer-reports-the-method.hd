# test: a helper that returns a method's result reports nothing itself; the method that made its `&mut` through a `*mut` field is the error
# Spec 13 Local References: ref.local.pointer.
struct Node:
    v: i32

struct Holder:
    item: *mut Node

impl Holder:
    fn get(&self) -> &mut Node:
        &mut *self.item # diagnostic: local-reference-escapes

fn grab(h: &Holder) -> &mut Node:
    h.get()
