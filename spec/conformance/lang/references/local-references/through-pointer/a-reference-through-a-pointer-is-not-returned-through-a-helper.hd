# test: a reference made through a pointer and passed to a helper whose result depends on it is still local, so the helper's result is not returned
# Spec 13 Local References: ref.local.pointer.
struct Node:
    v: i32

struct Holder:
    item: *mut Node

fn forward['a](n: &'a mut Node) -> &'a mut Node:
    n

impl Holder:
    fn get(&self) -> &mut Node:
        forward(&mut *self.item) # diagnostic: local-reference-escapes
