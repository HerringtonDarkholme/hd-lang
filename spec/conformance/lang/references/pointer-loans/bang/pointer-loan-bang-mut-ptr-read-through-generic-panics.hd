# test: pointer loans: a `&mut` to a field of a boxed struct, held across a bang call that suspends and acts, through a never-inlined generic forwarder; an alias reads the place; panics borrow-conflict
# fixture-runtime-profile: pending-tick
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.meta.inline

@inline(.Never)
fn hold_generic[T < ?Copy](value: T) -> T:
    value

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

fn act!(alias: *Cell) -> string $ Tick:
    $.use(Tick).tick!("")
    seen_alias := alias.value # panic: borrow-conflict
    junk := churn()
    _ := seen_alias.len()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Cell, alias: *Cell) -> string $ Tick:
    r := hold_generic(&mut p.value)
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Tick:
    p := make()
    seen := probe!(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
