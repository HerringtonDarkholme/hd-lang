# test: pointer loans: a `&mut` to a `Map` value behind a `*T`, held across a bang call that suspends and acts, through a never-inlined padded tuple carrier; an alias grows the collection; panics borrow-conflict
# fixture-runtime-profile: pending-tick
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
use std.meta.inline

@inline(.Never)
fn hold_carrier[T < ?Copy](value: (usize, T)) -> T:
    value._1

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Outer:
    map: Map[string, string]
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Outer:
    box(Outer { map: { "a": orig(), "b": second() }, other: second() })

fn act!(alias: *mut Outer) -> string $ Tick:
    $.use(Tick).tick!("")
    for round in 0..16:
        alias.map["z$round"] = fresh() # panic: borrow-conflict
    junk := churn()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *mut Outer) -> string $ Tick:
    r := hold_carrier((42, &mut p.map["a"]))
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Tick:
    p := make()
    seen := probe!(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
