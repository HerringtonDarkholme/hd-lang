# test: pointer loans: a `&` to a field of a local struct, held across a bang call that suspends and acts, through a never-inlined generic forwarder; an alias cannot reach the local, so its write touches another object; runs
# fixture-runtime-profile: pending-tick
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: no *T; keep-alive (B): runs.
use std.annotation.inline

@inline(.Never)
fn hold_generic[T < ?Copy](value: T) -> T:
    value

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

fn act!(alias: *mut Cell) -> string $ Tick:
    $.use(Tick).tick!("")
    alias.value = fresh()
    junk := churn()
    _ := junk.len()
    "acted"

fn probe!(alias: *mut Cell) -> string $ Tick:
    let mut own = Cell { value: orig(), other: second() }
    r := hold_generic(&own.value)
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Tick:
    other := make()
    seen := probe!(other)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
