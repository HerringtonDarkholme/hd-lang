# test: pointer loans: a `&` to a list element a method lends, behind a `*T`, held across a bang call that suspends and acts, through a never-inlined padded tuple carrier; an alias reads the place; runs
# fixture-runtime-profile: pending-tick
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
use std.meta.inline

@inline(.Never)
fn hold_carrier[T < ?Copy](value: (usize, T)) -> T:
    value._1

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Slots:
    items: List[string]

impl Slots:
    fn len(&self) -> usize:
        self.items.len()

    fn get(&self, index: usize) -> string?:
        if index < self.items.len(): .Some(self.items[index]) else: .None

    fn get_ref['a](&'a self, index: usize) -> (&'a string)?:
        if index < self.items.len(): .Some(&self.items[index]) else: .None

    fn get_mut['a](&'a mut self, index: usize) -> (&'a mut string)?:
        if index < self.items.len(): .Some(&mut self.items[index]) else: .None

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

    fn remove(&mut self, index: usize) -> string:
        self.items.remove(index)

    fn swap(&mut self, left: usize, right: usize) -> void:
        self.items.swap(left, right)

struct Outer:
    items: Slots
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn slots(first: string, last: string) -> Slots:
    Slots { items: [first, last] }

fn make() -> *mut Outer:
    box(Outer { items: slots(second(), orig()), other: second() })

fn act!(alias: *Outer) -> string $ Tick:
    $.use(Tick).tick!("")
    seen_alias := alias.items.get(1).unwrap_or("")
    junk := churn()
    _ := seen_alias.len()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *Outer) -> string $ Tick:
    r := hold_carrier((42, p.items.get_ref(1).expect("slot")))
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Tick:
    p := make()
    seen := probe!(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
