# test: pointer loans: a `&` to a map value a method lends, behind a `*T`, held across a bang call that suspends and acts, through a never-inlined padded tuple carrier; an alias reads the place; runs
# fixture-runtime-profile: pending-tick
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
use std.meta.inline

@inline(.Never)
fn hold_carrier[T < ?Copy](value: (usize, T)) -> T:
    value._1

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct SlotMap:
    map: Map[string, string]

impl SlotMap:
    fn get(&self, key: string) -> string?:
        self.map.get(key)

    fn get_ref['a](&'a self, key: string) -> (&'a string)?:
        if self.map.contains_key(key): .Some(&self.map[key]) else: .None

    fn get_mut['a](&'a mut self, key: string) -> (&'a mut string)?:
        if self.map.contains_key(key): .Some(&mut self.map[key]) else: .None

    fn insert(&mut self, key: string, value: string) -> string?:
        old := self.map.get(key)
        self.map[key] = value
        old

    fn remove(&mut self, key: string) -> string?:
        self.map.remove(key)

struct Outer:
    map: SlotMap
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn slot_map(a: string, b: string) -> SlotMap:
    SlotMap { map: { "a": a, "b": b } }

fn make() -> *mut Outer:
    box(Outer { map: slot_map(orig(), second()), other: second() })

fn act!(alias: *Outer) -> string $ Tick:
    $.use(Tick).tick!("")
    seen_alias := alias.map.get("a").unwrap_or("")
    junk := churn()
    _ := seen_alias.len()
    _ := junk.len()
    "acted"

fn probe!(p: *mut Outer, alias: *Outer) -> string $ Tick:
    r := hold_carrier((42, p.map.get_ref("a").expect("slot")))
    _ := act!(alias)
    seen := *r
    seen

pub fn main!() -> void $ Console + Tick:
    p := make()
    seen := probe!(p, p)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
