# test: pointer loans: a `&mut` to a list element a method lends, behind a `*T`, returned by a method, through a never-inlined padded tuple carrier; an alias replaces what holds the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
use std.annotation.inline

@inline(.Never)
fn hold_carrier[T < ?Copy](value: (usize, T)) -> T:
    value._1

struct Slots:
    items: List[string]

impl Slots:
    fn len(&self) -> usize:
        self.items.len()

    fn get(&self, index: usize) -> string?:
        if index < self.items.len(): .Some(self.items[index]) else: .None

    fn get_ref['a](&'a self, index: usize) -> (&'a string)?:
        if index < self.items.len(): .Some(&self.items[index]) else: .None

    fn get_mut['a](&'a mut self, index: usize) -> (&'a mut string)?:
        if index < self.items.len(): .Some(&mut self.items[index]) else: .None

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

    fn remove(&mut self, index: usize) -> string:
        self.items.remove(index)

    fn swap(&mut self, left: usize, right: usize) -> void:
        self.items.swap(left, right)

struct Outer:
    items: Slots
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn slots(first: string, last: string) -> Slots:
    Slots { items: [first, last] }

fn make() -> *mut Outer:
    box(Outer { items: slots(second(), orig()), other: second() })

impl Outer:
    fn slot_mut(&mut self) -> &mut string:
        hold_carrier((42, self.items.get_mut(1).expect("slot")))

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := p.slot_mut()
    alias.items = slots(fresh(), fresh()) # panic: borrow-conflict
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
