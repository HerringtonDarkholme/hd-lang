# test: pointer loans: a `&mut` to a field of a local struct, passed as a call argument, through a never-inlined generic forwarder; an alias cannot reach the local, so its write touches another object; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: no *T; keep-alive (B): runs.
use std.meta.inline

@inline(.Never)
fn hold_generic[T < ?Copy](value: T) -> T:
    value

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn make() -> *mut Cell:
    box(Cell { value: orig(), other: second() })

fn observe(r: &mut string, alias: *mut Cell) -> string:
    alias.value = fresh()
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

fn probe(alias: *mut Cell) -> string:
    let mut own = Cell { value: orig(), other: second() }
    observe(hold_generic(&mut own.value), alias)

pub fn main() -> void $ Console:
    other := make()
    seen := probe(other)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
