# test: pointer loans, same root: replacing a list behind the pointer while an element reference its method lent lives is a compile-time error in both models
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
struct Cell:
    n: i32

impl Cell:
    fn change(&mut self) -> void:
        self.n += 1
    fn read(&self) -> i32:
        self.n

struct Outer:
    next: *mut Cell
    list: List[i32]
    map: Map[string, i32]

fn bump(c: *mut Cell) -> void:
    c.n += 1

struct Slots:
    items: List[string]

impl Slots:
    fn len(&self) -> usize:
        self.items.len()

    fn get(&self, index: usize) -> string?:
        if index < self.items.len(): .Some(self.items[index]) else: .None

    fn get_ref['a](&'a self, index: usize) -> (&'a string)?:
        if index < self.items.len(): .Some(&self.items[index]) else: .None

    fn get_mut['a](&'a mut self, index: usize) -> (&'a mut string)?:
        if index < self.items.len(): .Some(&mut self.items[index]) else: .None

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

    fn remove(&mut self, index: usize) -> string:
        self.items.remove(index)

    fn swap(&mut self, left: usize, right: usize) -> void:
        self.items.swap(left, right)

struct Bag:
    items: Slots

fn probe(a: *mut Bag) -> string:
    c := a.items.get_ref(0).expect("slot")
    a.items = Slots { items: [] } # diagnostic: conflicting-access
    *c
