# test: pointer loans, adversarial: a task that `race!` abandons while it holds an exclusive loan across a suspension ends that loan, so a later write to the object runs; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
# fixture-runtime-profile: pending-tick
use std.task.race

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

# Three ticks here and one in quick!, so quick! wins while this task waits.
fn hold!(p: *mut Cell) -> string $ Tick:
    r := &mut p.value
    for round in 0..3:
        $.use(Tick).tick!("")
    *r

fn quick!() -> string $ Tick:
    $.use(Tick).tick!("")
    orig()

pub fn main!() -> void $ Console + Tick:
    p := box(Cell { value: orig(), other: orig() })
    winner := race!(hold(p), quick())
    p.value = fresh()
    seen := if p.value == fresh(): winner else: "lost"
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
