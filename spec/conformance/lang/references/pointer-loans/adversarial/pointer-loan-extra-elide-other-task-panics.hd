# test: pointer loans, adversarial: another task replaces a list whose method lent the reference, while the reference waits across a bang call; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
# fixture-runtime-profile: pending-tick
use std.task.join

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Slots:
    items: List[string]

impl Slots:
    fn len(&self) -> usize:
        self.items.len()

    fn get(&self, index: usize) -> string?:
        if index < self.items.len(): .Some(self.items[index]) else: .None

    fn get_ref['a](&'a self, index: usize) -> (&'a string)?:
        if index < self.items.len(): .Some(&self.items[index]) else: .None

    fn get_mut['a](&'a mut self, index: usize) -> (&'a mut string)?:
        if index < self.items.len(): .Some(&mut self.items[index]) else: .None

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

    fn remove_at(&mut self, index: usize) -> string:
        self.items.remove_at(index)

    fn swap(&mut self, left: usize, right: usize) -> void:
        self.items.swap(left, right)

struct Bag:
    items: Slots

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn uniq(value: string) -> Slots:
    Slots { items: [value] }

fn hold!(p: *mut Bag) -> string $ Tick:
    r := p.items.get_ref(0).expect("slot")
    # join! polls its tasks in argument order (req.schedule.all-unfinished),
    # so act! writes while this task waits; the panic ends the run.
    $.use(Tick).tick!("")
    junk := churn()
    seen := *r
    _ := junk.len()
    seen

fn act!(alias: *mut Bag) -> string:
    alias.items = uniq(fresh()) # panic: borrow-conflict
    "acted"

pub fn main!() -> void $ Console + Tick:
    p := box(Bag { items: uniq(orig()) })
    let (seen, _) = join!(hold(p), act(p))
    println("${p.items.len()}")
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
