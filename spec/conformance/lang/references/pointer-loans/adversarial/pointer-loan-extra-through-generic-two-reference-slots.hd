# test: pointer loans, adversarial: a generic tuple result keeps its second reference while the unused first source changes; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs.
use std.annotation.inline
struct Slots:
    items: List[string]
impl Slots:
    fn get_ref['a](&'a self) -> (&'a string)?:
        if self.items.len() > 0: .Some(&self.items[0]) else: .None
    fn push(&mut self) -> void:
        for round in 0..64:
            self.items.push("new-" + "x".repeat(40 + round))
@inline(.Never)
fn keep[T < ?Copy](value: T) -> T:
    value
fn probe(p: *mut Slots, q: *mut Slots, alias: *mut Slots) -> string:
    pair := keep((p.get_ref().expect("slot"), q.get_ref().expect("slot")))
    r := pair._1
    alias.push()
    *r
pub fn main() -> void $ Console:
    p := box(Slots { items: ["left-" + "p".repeat(40)] })
    q := box(Slots { items: ["right-" + "q".repeat(40)] })
    seen := probe(p, q, p)
    if seen != "right-" + "q".repeat(40):
        panic("the unrelated mutation changed the selected reference")
    println("ok")
