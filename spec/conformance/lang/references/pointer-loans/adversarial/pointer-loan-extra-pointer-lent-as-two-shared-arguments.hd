# test: pointer loans, adversarial: two pointers to one object passed where `&` is expected take two shared loans, which coexist; runs
# expect-stdout: ok
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: elided; keep-alive (B): runs.
struct Cell:
    value: string
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn both(a: &Cell, b: &Cell) -> string:
    _ := b.other.len()
    a.value

fn probe(boxed: *mut Cell, alias: *mut Cell) -> string:
    both(boxed, alias)

pub fn main() -> void $ Console:
    boxed := box(Cell { value: orig(), other: fresh() })
    seen := probe(boxed, boxed)
    if seen != orig():
        panic("the reference read another value than its original")
    println("ok")
