# test: pointer loans, adversarial: a generic padded struct carrier forwards its reference to a result slot; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
use std.annotation.inline

struct Slots:
    items: List[string]

impl Slots:
    fn get_ref['a](&'a self) -> (&'a string)?:
        if self.items.len() > 0: .Some(&self.items[0]) else: .None

    fn push(&mut self) -> void:
        for round in 0..64:
            self.items.push("new-" + "x".repeat(40 + round))

struct Carrier[T]:
    padding: usize
    value: T

@inline(.Never)
fn keep[T](carrier: Carrier[T]) -> T:
    carrier.value

fn through_call(p: *mut Slots, alias: *mut Slots) -> string:
    r := keep(Carrier { padding: 42, value: p.get_ref().expect("slot") })
    alias.push() # panic: borrow-conflict
    *r

pub fn main() -> void $ Console:
    p := box(Slots { items: ["original-" + "z".repeat(40)] })
    println(through_call(p, p))
