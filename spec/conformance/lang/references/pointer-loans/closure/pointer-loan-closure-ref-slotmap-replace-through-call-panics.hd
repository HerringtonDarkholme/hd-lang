# test: pointer loans: a `&` to a map value a method lends, behind a `*T`, captured by a closure, through a never-inlined forwarder; an alias replaces what holds the place; panics borrow-conflict
# Generated by spec/tools/generate-pointer-loan-matrix.ts; edit the generator.
# Accepted design: docs/compiler/ownership.md#pointer-loans-model-a (2026-11-03; built under #1336).
# Verdicts: loans (A) with elision: loan needed; keep-alive (B): runs, stale.
use std.annotation.inline

@inline(.Never)
fn hold_ref['a](value: &'a string) -> &'a string:
    value

struct SlotMap:
    map: Map[string, string]

impl SlotMap:
    fn get(&self, key: string) -> string?:
        self.map.get(key)

    fn get_ref['a](&'a self, key: string) -> (&'a string)?:
        if self.map.contains_key(key): .Some(&self.map[key]) else: .None

    fn get_mut['a](&'a mut self, key: string) -> (&'a mut string)?:
        if self.map.contains_key(key): .Some(&mut self.map[key]) else: .None

    fn insert(&mut self, key: string, value: string) -> string?:
        old := self.map.get(key)
        self.map[key] = value
        old

    fn remove(&mut self, key: string) -> string?:
        self.map.remove(key)

struct Outer:
    map: SlotMap
    other: string

fn orig() -> string:
    "orig-" + "z".repeat(40)

fn second() -> string:
    "second-" + "y".repeat(40)

fn fresh() -> string:
    "w-" + "x".repeat(40)

fn set(slot: &mut string, value: string) -> void:
    *slot = value

# Allocates blocks the size of a freed string, so a read of freed memory
# sees other bytes.
fn churn() -> List[string]:
    let mut junk: List[string] = []
    for round in 0..8:
        junk.push("j".repeat(44 + round))
    junk

fn slot_map(a: string, b: string) -> SlotMap:
    SlotMap { map: { "a": a, "b": b } }

fn make() -> *mut Outer:
    box(Outer { map: slot_map(orig(), second()), other: second() })

fn apply(alias: *mut Outer, read: fn() -> string) -> string:
    alias.map = slot_map(fresh(), fresh()) # panic: borrow-conflict
    junk := churn()
    seen := read()
    _ := junk.len()
    seen

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    r := hold_ref(p.map.get_ref("a").expect("slot"))
    apply(alias, fn() -> string: *r)

pub fn main() -> void $ Console:
    p := make()
    seen := probe(p, p)
    if !(seen == orig() || seen == second() || seen == fresh()):
        panic("the reference read a value no write stored")
    println("ok")
