# test: a `&self` method's `&mut` result holds its receiver shared, so two live results of it check
# Spec 13 Writes While Borrowed: ref.excl.call.
struct Bump:
    used: usize

impl Bump:
    fn alloc['s, T](&'s self, v: T) -> &'s mut T:
        panic("stub")

pub fn main() -> void:
    b := Bump { used: 0 }
    x := b.alloc(1)
    y := b.alloc(2)
    *x = 3
    *y = 4
