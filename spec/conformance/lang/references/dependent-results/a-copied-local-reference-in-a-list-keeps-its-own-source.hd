# test: a reference read through a list element keeps its own source after the element is replaced with a reference to another local
struct P:
    name: string

fn name_of(p: &P) -> &string:
    &p.name

pub fn main() -> void $ Console:
    p := P { name: "a${1}" }
    q := P { name: "b${2}" }
    let mut ps = [&p]
    d := &ps[0].name
    ps[0] = &q
    junk := "cccccc${3}"
    println("${*d} $junk")
