# test: a frozen loan ends with the lifetime its marker bound names, so an element store after the scope's last use is valid
# Spec 13 Frozen Loans: ref.frozen.lifetime.
use std.meta.Send

struct Player:
    score: i32

struct Scope['s]:
    done: &'s mut List[i32]

impl['s] Scope['s]:
    fn spawn(&mut self, code: fn() -> i32 + Send & 's) -> void:
        self.done.push(code())

fn demo(players: List[Player]) -> i32:
    let mut all = players
    let mut done: List[i32] = []
    let mut s = Scope { done: &mut done }
    first := &all[0]
    s.spawn(fn() -> i32: first.score)
    all[0].score = 9
    all[0].score + done[0]

tests:
    use std.testing.assert_equal

    it("the store after the scope's last use runs"):
        assert_equal(demo([Player { score: 2 }]), 11)
