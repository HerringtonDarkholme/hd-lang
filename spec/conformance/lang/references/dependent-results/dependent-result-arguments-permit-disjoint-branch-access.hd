# test: branch-dependent arguments permit writes to the disjoint object across repeated calls
struct Slots:
    items: List[string]

impl Slots:
    fn at['a](&'a self, index: usize) -> &'a string:
        &self.items[index]

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

struct Outer:
    items: Slots

fn observe(r: &string, alias: *mut Outer) -> string:
    *r

fn later(alias: *mut Outer) -> *mut Outer:
    alias.items.push("changed before observe")
    alias

fn probe(p: *mut Outer, other: *mut Outer, pick: bool) -> string:
    alias := if pick: other else: p
    observe(if pick: p.items.at(0) else: other.items.at(0), later(alias))

pub fn main() -> void $ Console:
    p := box(Outer { items: Slots { items: ["orig-" + "z".repeat(40)] } })
    other := box(Outer { items: Slots { items: ["other-" + "y".repeat(40)] } })
    for round in 0..4:
        println(probe(p, other, round % 2 == 0))
