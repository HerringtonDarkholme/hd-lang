# test: dependent result loan survives inner argument loop
struct Slots:
    items: List[string]

impl Slots:
    fn at['a](&'a self, index: usize) -> &'a string:
        &self.items[index]

    fn push(&mut self, value: string) -> void:
        self.items.push(value)

struct Outer:
    items: Slots

fn observe(r: &string, alias: *mut Outer) -> string:
    *r

fn later(alias: *mut Outer) -> *mut Outer:
    alias.items.push("changed before observe") # panic: borrow-conflict
    alias

fn probe(p: *mut Outer, alias: *mut Outer) -> string:
    observe(
        p.items.at(0),
        if p.items.items.len() == 1:
            for round in 0..2:
                break
            later(alias)
        else:
            later(alias)
    )

pub fn main() -> void $ Console:
    p := box(Outer { items: Slots { items: ["orig-" + "z".repeat(40)] } })
    println(probe(p, p))
