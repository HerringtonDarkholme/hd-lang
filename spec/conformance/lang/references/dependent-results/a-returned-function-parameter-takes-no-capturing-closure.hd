# test: a function may return its function parameter, whose closure argument may not capture a local reference
# Spec 13 Local References: ref.local.escape.fn-capture, ref.local.fn-static.
struct Counter:
    value: i32

fn forward(reader: fn() -> i32) -> fn() -> i32:
    reader

fn read() -> i32:
    counter := Counter { value: 42 }
    let local: &Counter = &counter
    reader := forward(fn() -> i32: local.value) # diagnostic: local-reference-escapes
    reader()
