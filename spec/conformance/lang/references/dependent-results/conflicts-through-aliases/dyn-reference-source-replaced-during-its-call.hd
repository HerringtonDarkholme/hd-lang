# expect-stdout: second second
# test: a trait value's object stays alive for a call made through a copy of its pointer, when the call replaces the pointer the copy came from
# Spec 13 Values and References: ref.excl.alias.shared-variable, ref.excl.alias.conflict.
trait Note:
    fn text(&self, step: fn() -> void) -> string

struct Held:
    name: string

impl Note for Held:
    fn text(&self, step: fn() -> void) -> string:
        step()
        self.name

fn make(name: string) -> *dyn Note:
    box(Held { name: "${name}" })

fn through(note: &dyn Note, step: fn() -> void) -> string:
    note.text(step)

fn replaced_behind_reference() -> string:
    let mut p = make("second")
    replace := fn() -> void: p = make("other")
    receiver := p
    through(receiver, replace)

pub fn main() -> void $ Console:
    println("${replaced_behind_reference()} second")
