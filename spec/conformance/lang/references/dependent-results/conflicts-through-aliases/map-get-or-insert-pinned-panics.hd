# test: `through` lends two aliases of one boxed map as two `&mut` arguments, so the call conflicts before Map.get_or_insert runs
# Spec 13 Conversions: ref.convert.lend.loan; Conflicts Through Aliases: ref.excl.alias.conflict.
fn insert(stock: &mut Map[string, i32], apples: &mut i32) -> void:
    _ := stock.get_or_insert("pear", 1)
    *apples += 1

fn through(stock: &mut Map[string, i32], alias: &mut Map[string, i32]) -> void:
    apples := stock.get_or_insert("apple", 0)
    insert(alias, apples)

tests:
    it("a missing key changes the length of a pinned map"):
        stock := box::[Map[string, i32]]({ "apple": 3 })
        alias := stock
        through(stock, alias) # panic: borrow-conflict
