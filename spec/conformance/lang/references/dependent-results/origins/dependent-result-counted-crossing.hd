# test: a place reached through a counted reference is a local of the function, so a reference to it is not returned
# Spec 13 Origins: ref.dep.origin.counted; Spec 13 Local References: ref.local.pointer.
struct P:
    x: i32

struct H:
    p: *mut P

fn through(h: &H) -> &i32:
    &h.p.x # diagnostic: local-reference-escapes
