# test: a counted reference bound by a pattern from a place is lent from that place, so a dependent result of it may be returned
# Spec 13 Origins: ref.dep.origin.lend, ref.dep.origin.projection,
# ref.dep.origin.counted. `m` is read from `n.next`, so `last(m)` has
# `n`'s origins.
struct Node:
    value: i32
    next: *Node?

fn last(n: &Node) -> &Node:
    match n.next:
        .Some(m) => last(m)
        .None => n
