# test: a result path never crosses a `*T` field, since a reference made through it is local to the function
# Spec 13 Result Paths: ref.result.path.counted; Spec 13 Local References: ref.local.pointer.
struct User:
    name: string

struct Team:
    lead: *User
    size: i32

fn lead_name(t: &Team) -> &'t.lead.name string: # diagnostic: local-reference-escapes
    panic("a result path through a pointer")
