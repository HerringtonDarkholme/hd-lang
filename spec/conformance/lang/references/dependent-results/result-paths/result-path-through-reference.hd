# test: a result path never crosses a `*mut` field, since a reference made through it is local to the function
# Spec 13 Result Paths: ref.result.path.counted; Spec 13 Local References: ref.local.pointer.
struct User:
    name: string
    age: i32

struct Team:
    lead: *mut User
    size: i32

fn lead_name(t: &Team) -> &'t.lead.name mut string: # diagnostic: local-reference-escapes
    panic("a result path through a pointer")
