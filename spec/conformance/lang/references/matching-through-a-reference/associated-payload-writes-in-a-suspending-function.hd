# fixture-runtime-profile: pending-tick
# test: a suspending function borrows and writes a payload declared `S::Item` across suspension points
# Spec 13 Values And References: ref.match.borrow, ref.write.field. Spec 9 Traits: trait.assoc.projection.
# expect-stdout: 9

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

trait Source:
    type Item

struct Provider: pass

struct Number:
    value: u32

impl !Copy for Number

impl Source for Provider:
    type Item = Number

enum Holder[S < Source]:
    Empty
    Full(value: S::Item)

struct Box2[S < Source]:
    item: S::Item

fn write!(holder: &mut Holder[Provider]) -> void $ Tick:
    host_wait!()
    match holder:
        .Full(value) =>
            host_wait!()
            value.value = 9
        .Empty => pass

fn read!(holder: &Holder[Provider]) -> u32 $ Tick:
    match holder:
        .Full(value) =>
            host_wait!()
            value.value
        .Empty => 0

pub fn main!() -> void $ Console + Tick:
    let mut holder = Holder::[Provider].Full(Number { value: 1 })
    write!(&mut holder)
    println(read!(&holder))
