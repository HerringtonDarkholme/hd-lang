# test: a parameter bound by two instantiations of one generic trait meets a goal for either
# Spec 02 Multiple Bounds: grammar.generic.bound.and; the goal
# goals `T: Conv[string]` and `T: Conv[i32]` each pass over the other
# clause to the one whose argument matches.
trait Conv[U]:
    fn conv(&self) -> U

fn need[T < Conv[string]](x: &T) -> string:
    x.conv()

fn need_number[T < Conv[i32]](x: &T) -> i32:
    x.conv()

fn both[T < Conv[i32] & Conv[string]](x: T) -> string:
    need(&x)

fn both_number[T < Conv[i32] & Conv[string]](x: T) -> i32:
    need_number(&x)
