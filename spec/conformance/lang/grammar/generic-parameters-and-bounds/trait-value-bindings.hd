# test: a trait value type may end its arguments with associated type bindings in a field, a list element, a parameter and an annotation
# Spec 02 Associated Type Bindings In Bounds: grammar.generic.binding.positions-key.reference-values (owner decision AT2).

trait Supplier:
    type Item
    fn get(self) -> Self::Item

struct Holder:
    source: &dyn Supplier[Item = i32]
    backups: List[&dyn Supplier[Item = i32]]

fn read(source: &dyn Supplier[Item = i32]) -> i32:
    let copy: &dyn Supplier[Item = i32] = source
    copy.get()
