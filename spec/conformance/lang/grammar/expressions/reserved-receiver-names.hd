# test: self and Self parse as receiver names, while test, derive, pack and map_list stay ordinary function names
trait Named:
    fn name(self) -> string
    fn clone_name(self) -> Self

struct User:
    name: string

impl Named for User:
    fn name(self) -> string:
        self.name
    fn clone_name(self) -> Self:
        self

fn map_list() -> void:
    pass
fn test() -> void:
    pass
fn derive() -> void:
    pass
fn pack() -> void:
    pass
