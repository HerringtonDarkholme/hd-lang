# test: an embedded part labelled in a literal and assigned by its type name parses, also in a same-line suite
struct Timestamps:
    created_at: i32
    updated_at: i32

struct Post:
    Timestamps
    id: string

fn build(stamps: Timestamps) -> Post:
    let mut post = Post { Timestamps: stamps, id: "p" }
    post.Timestamps = Timestamps { created_at: 2, updated_at: 2 }
    if post.id == "p": post.Timestamps = stamps
    post
