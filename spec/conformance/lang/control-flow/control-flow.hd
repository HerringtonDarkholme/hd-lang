# test: an if chain with else is a value, and a for or while with an else gives the else value and its break values one type
# Spec 06 Suites, Conditionals, Loops, And Completion: flow.condition.bool,
# flow.if.else-if, flow.if.value.else, flow.for.binding,
# flow.while.condition, flow.loop.else.value, flow.loop.else.break-value,
# flow.loop.else.type.
fn first_large(values: List[i32]) -> i32?:
    for value in values:
        if value > 100:
            break value
    else:
        .None

fn label(score: i32) -> string:
    if score >= 90: "excellent" else if score >= 70: "passing" else: "needs work"

fn first_prefix(names: List[string], prefix: string) -> string?:
    let index: usize = 0
    while index < names.len():
        if names[index] == prefix:
            break names[index]
        index = index + 1
    else:
        .None
