# fixture-runtime-profile: pending-tick
# expect-stdout: open a, open b, body, closing b, closed b, defer, closing a, closed a
# expect-stdout: open a, open b, closing b, closed b, defer, closing a, closed a
# expect-stdout: 2 1
# test: a dispose! that suspends finishes before scope exit continues, in order with deferred callbacks
# Spec lang/06 Using Bindings: flow.using.async-disposable.row, flow.using.dispose.v2, flow.using.order.v2, flow.using.async.suite-suspends.
use std.ops.defer
use std.ops.AsyncDisposable

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Conn:
    name: string
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing ${self.name}")
        let mut wait = self.closing
        wait!()
        self.log.push("closed ${self.name}")

fn connect!(name: string, log: *mut List[string]) -> *mut Conn $ Tick:
    log.push("open ${name}")
    box(Conn { name: name, log: log, closing: host_wait() })

fn work!(log: *mut List[string], stop: bool) -> i32 $ Tick:
    using! a = connect!("a", log)
    defer(fn() -> void: log.push("defer"))
    using! b = connect!("b", log)
    if stop:
        return 1
    host_wait!()
    log.push("body")
    2

pub fn main!() -> void $ Console + Tick:
    log := box::[List[string]]([])
    n := work!(log, false)
    println(log.join(", "))
    log.clear()
    m := work!(log, true)
    println(log.join(", "))
    println("${n} ${m}")
