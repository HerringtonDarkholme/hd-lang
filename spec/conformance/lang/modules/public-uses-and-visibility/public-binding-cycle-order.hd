# test: in a module cycle, a statement that reads an imported binding through a call runs after its statement
# Spec 10 Public Bindings: module.vis.pub.binding.init. src/b.hd reads BASE in twice.
# fixture-package-tree: public-binding-cycle/src/a.hd
use pkg.b.{twice}

early := twice()
pub let BASE: i64 = 21

tests:
    use std.testing.assert_equal

    it("initializes BASE first"):
        assert_equal(early, 42i64, reason="early waits on BASE")
