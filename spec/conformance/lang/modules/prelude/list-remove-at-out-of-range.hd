# test: list remove at len() panics with index-out-of-bounds
# Spec lang/10 Built-In Methods: module.method.list-remove-indexed.range.

fn shrink(values: &mut List[i32]) -> i32:
    values.remove(values.len()) # panic: index-out-of-bounds

tests:
    it("rejects the index len()"):
        let mut values: List[i32] = [1, 2]
        _ := shrink(&mut values)
