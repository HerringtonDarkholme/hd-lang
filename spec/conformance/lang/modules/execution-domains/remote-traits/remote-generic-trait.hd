# test: a remote trait may be generic, and a served type fixes its type argument
# Spec 10 Remote Traits: module.remote.r1.trait-generic.
use std.meta.Wire
use std.remote.{CrossError, Remote}

enum StoreError:
    Missing

trait TypedStore[T < Wire] < Remote:
    fn get!(&mut self, key: string) -> Result[T, StoreError | CrossError]

struct Names:
    first: string

impl TypedStore[string] for Names:
    fn get!(&mut self, key: string) -> Result[string, StoreError]:
        .Ok(self.first)
