# test: an implementation of a remote method that declares CrossError is rejected
# Spec 10 Remote Traits: module.remote.r2.impl.
use std.remote.{CrossError, Remote}

struct User:
    id: i64
    name: string

enum UserError:
    Missing(id: i64)

trait Users < Remote:
    fn load_user!(&mut self, id: i64) -> Result[User, UserError | CrossError]

struct Fixed:
    user: User

impl Users for Fixed:
    fn load_user!(&mut self, id: i64) -> Result[User, UserError | CrossError]: # diagnostic: trait-method-signature
        .Ok(self.user)
