# test: a call that runs a remote method's implementation returns its error as case _0
# Spec 10 Remote Traits: module.remote.r2.public, module.remote.r2.wrap.
use std.remote.{CrossError, Remote}

struct User:
    id: i64
    name: string

enum UserError:
    Missing(id: i64)

trait Users < Remote:
    fn load_user!(&mut self, id: i64) -> Result[User, UserError | CrossError]

struct Fixed:
    user: User

impl Users for Fixed:
    fn load_user!(&mut self, id: i64) -> Result[User, UserError]:
        if id == self.user.id:
            return .Ok(self.user)
        .Err(UserError.Missing(id))

fn outcome!(users: &mut dyn Users, id: i64) -> string:
    match users.load_user!(id):
        .Ok(user) => user.name
        .Err(._0(.Missing(id))) => "missing $id"
        .Err(._1(_)) => "not sent"

tests:
    use std.testing.assert_equal

    it("a local call returns the implementation's error as case _0"):
        let mut users = Fixed { user: User { id: 7, name: "Ada" } }
        assert_equal(outcome!(&mut users, 7), "Ada")
        assert_equal(outcome!(&mut users, 8), "missing 8")
