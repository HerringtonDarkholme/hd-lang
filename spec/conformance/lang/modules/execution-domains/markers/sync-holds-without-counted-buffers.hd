# test: a type with no counted buffer is Sync, through composites and local references
# Spec 10 Markers: module.marker.sync, module.marker.sync.leaf, module.marker.sync.structural, module.marker.sync.refs.
use std.marker.Sync

struct Point:
    x: i32
    y: f64

enum Shape:
    Dot(at: Point)
    Empty

fn read_at_once[T < ?Copy & Sync](value: T) -> void:
    pass

fn demo(p: Point, r: &Point, m: &mut Shape) -> void:
    read_at_once(p)
    read_at_once((+1, true, 'c'))
    read_at_once(Shape.Dot(p))
    read_at_once(r)
    read_at_once(m)
