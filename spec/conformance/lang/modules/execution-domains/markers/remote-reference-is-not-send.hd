# test: a remote reference is not Send, since a stub calls through its own transport
# Spec 10 Remote References: module.remote.ref.not-send; Spec 10 Markers: module.marker.table.remote.
use std.meta.Send
use std.remote.{CrossError, Remote}

trait Users < Remote:
    fn count!(&mut self) -> Result[i64, string | CrossError]

fn share[T < Send](value: T) -> void:
    pass

fn demo(users: *mut dyn Users) -> void:
    share(users) # diagnostic: unsatisfied-trait-bound
