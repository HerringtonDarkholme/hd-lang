# test: a crossing closure that captures a function value is rejected, since only the literal crosses
# Spec 07 Crossing Closures: fn.crossing.fn-value.
use std.marker.Wire

fn run[T < ?Copy & Wire](code: fn() -> T + Wire) -> T:
    code()

fn demo(n: i32) -> i32:
    read := fn() -> i32: n
    run(fn() -> i32: read()) # diagnostic: unsatisfied-trait-bound
