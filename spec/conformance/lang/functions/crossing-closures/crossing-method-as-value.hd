# test: a method with a crossing parameter is only called, never a bound method value
# Spec 07 Crossing Closures: fn.crossing.no-value.
use std.meta.Wire

struct Pool:
    size: i32

impl Pool:
    fn run[T < ?Copy & Wire](&self, code: fn() -> T + Wire) -> T:
        code()

fn demo(pool: *mut Pool, xs: *mut List[i32]) -> usize:
    g := pool::run::[usize] # diagnostic: crossing-closure-not-literal
    g(fn() -> usize: xs.len())
