# test: a function with a crossing parameter is only called, never a function value, so no closure reaches it unchecked
# Spec 07 Crossing Closures: fn.crossing.no-value.
use std.marker.Wire

fn run[T < ?Copy & Wire](code: fn() -> T + Wire) -> T:
    code()

fn demo(xs: *mut List[i32]) -> usize:
    f := run::[usize] # diagnostic: crossing-closure-not-literal
    f(fn() -> usize: xs.len())
