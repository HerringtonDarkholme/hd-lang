# test: a callee passes its own crossing parameter on whole to another crossing parameter of the same marker
# Spec 07 Crossing Closures: fn.crossing.literal, fn.crossing.parameter.uses.
use std.marker.Wire

fn run[T < ?Copy & Wire](code: fn() -> T + Wire) -> T:
    code()

fn logged[T < ?Copy & Wire](code: fn() -> T + Wire) -> T:
    run(code)

fn demo(n: i32) -> i32:
    logged(fn() -> i32: n + 1)
