struct Fixed[N < const usize]:
    value: i32
fn outer[N < const usize](value: Fixed[N]) -> Fixed[N]:
    fn first[B < const bool]() -> void:
        pass
    fn second[C < const char]() -> void:
        pass
    fn keep[M < const usize](value: Fixed[M]) -> Fixed[M]:
        value
    first::[true]()
    second::['x']()
    keep::[N](value)
