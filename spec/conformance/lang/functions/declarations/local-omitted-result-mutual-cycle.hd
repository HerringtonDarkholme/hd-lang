# test: local omitted result mutual cycle
# Rule: fn.decl.omitted-cycle.
fn outer() -> void:
    fn first(n: i32): # diagnostic: recursive-function-needs-result-type
        fn second(n: i32):
            if n == +0: +0 else: first(n - 1)
        if n == +0: +0 else: second(n - 1)
    let _ = first(+1)
