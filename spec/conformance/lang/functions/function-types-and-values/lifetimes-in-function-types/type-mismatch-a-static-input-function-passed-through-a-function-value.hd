# test: an argument of a call through a function value takes no function needing a longer input lifetime
# Spec 07 Function Types: fn.type.lifetime.input. `apply`'s input `fn(&i32) -> void` takes a reference of any
# lifetime.
fn inspect(value: &'static i32) -> void:
    pass

fn run_with(apply: fn(fn(&i32) -> void) -> void) -> void:
    apply(inspect) # diagnostic: type-mismatch
