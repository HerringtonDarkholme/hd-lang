# test: a result tuple's function type takes no function needing a longer input lifetime
# Spec 07 Function Types: fn.type.lifetime.input. The tuple's first element lets a caller pass a `&'a i32`.
fn inspect(value: &'static i32) -> void:
    pass

fn tupled['a]() -> (fn(&'a i32) -> void, i32):
    (inspect, 1) # diagnostic: type-mismatch
