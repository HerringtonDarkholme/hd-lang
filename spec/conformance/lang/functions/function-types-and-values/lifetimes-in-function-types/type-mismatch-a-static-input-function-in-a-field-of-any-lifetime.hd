# test: a function needing a static reference is no field whose function type writes no input lifetime
# Spec 07 Function Types: fn.type.lifetime.input. `Loose.f` takes a reference of any lifetime.
fn inspect(value: &'static i32) -> void:
    pass

struct Loose:
    f: fn(&i32) -> void

fn stored() -> Loose:
    Loose { f: inspect } # diagnostic: type-mismatch
