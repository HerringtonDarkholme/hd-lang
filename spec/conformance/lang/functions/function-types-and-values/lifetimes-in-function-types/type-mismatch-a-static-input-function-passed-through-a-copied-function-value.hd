# test: a copy of a function-value parameter keeps the parameter's declared input types
# Spec 07 Function Types: fn.type.lifetime.input. `other` is `apply`, whose input `fn(&i32) -> void` takes a reference
# of any lifetime.
fn inspect(value: &'static i32) -> void:
    pass

fn run_with(apply: fn(fn(&i32) -> void) -> void) -> void:
    other := apply
    other(inspect) # diagnostic: type-mismatch
