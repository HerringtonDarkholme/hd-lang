# test: a function value read from a field through a call's counted result passes its argument at the call's lifetime the field's type writes, though the stored function writes none
# Spec 07 Function Types: fn.type.lifetime.call.written.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn count['a, T](h: Holder['a, T], p: &'a Point) -> *Holder['a, T]:
    box(h)

fn x_of(p: &Point) -> i32:
    p.x

fn counted(p: &Point) -> i32:
    q := Point { x: 1 }
    (count(Holder { f: x_of }, p).f)(&q) # diagnostic: local-reference-escapes
