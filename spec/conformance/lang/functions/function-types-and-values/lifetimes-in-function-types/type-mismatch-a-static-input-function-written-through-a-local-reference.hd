# test: a field written through a local copy of a reference parameter takes no function needing a longer input lifetime
# Spec 07 Function Types: fn.type.lifetime.input. `r` is `h`, so `r.f` lets a later caller pass a `&'a i32`.
fn inspect(value: &'static i32) -> void:
    pass

struct Holder['a]:
    f: fn(&'a i32) -> void

fn put['a](h: &mut Holder['a]) -> void:
    r := h
    r.f = inspect # diagnostic: type-mismatch
