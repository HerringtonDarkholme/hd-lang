# test: a function value read from a field of a function's result passes its argument at the lifetime the result elides to, though the stored function writes none
# Spec 07 Function Types: fn.type.lifetime.call.written; Spec 13:
# ref.dep.elide. `make`'s result `Holder[i32]` elides `'a` to `p`'s
# lifetime, so the field's type passes `&q` there.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn x_of(p: &Point) -> i32:
    p.x

fn make(p: &Point) -> Holder[i32]:
    Holder { f: x_of }

fn in_result(p: &Point) -> i32:
    q := Point { x: 1 }
    (make(p).f)(&q) # diagnostic: local-reference-escapes
