# test: a function parameter whose type writes a lifetime holds no local reference, so it may be stored in a field
# Spec 13 Local References: ref.local.fn-static.
struct Point:
    x: i32

struct Holder['a, T]:
    f: fn(&'a Point) -> T

fn make['a, T](f: fn(&'a Point) -> T) -> Holder['a, T]:
    Holder { f: f }
