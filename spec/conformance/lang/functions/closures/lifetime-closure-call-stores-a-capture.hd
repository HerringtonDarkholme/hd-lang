# test: a closure stores a reference it captured at its parameter's call lifetime, which the reference outlives
# Spec 07 Closure Annotations: fn.closure.lifetime.call.
use std.ops.FnMut

struct Point:
    x: i32

struct Shelf['s]:
    count: i32

impl['s] Shelf['s]:
    fn keep(&mut self, point: &'s Point) -> void:
        self.count += point.x

fn fill['s](mut code: impl FnMut(&mut Shelf['s]) -> i32) -> i32:
    let mut shelf = Shelf { count: 0 }
    code(&mut shelf)

fn demo(point: Point) -> i32:
    first := &point
    fill(fn(shelf: &mut Shelf) -> i32:
        shelf.keep(first)
        shelf.count
    )
