# test: a function parameter stored into a local, directly or through a reference to it, may be called, and a closure argument for it may not capture a local reference
# Spec 13 Local References: ref.local.escape.fn-capture, ref.local.fn-static.
struct Point:
    x: i32

fn swap['a, T](f: fn(&'a Point) -> T, g: fn(&'a Point) -> T, p: &'a Point) -> T:
    let mut k = g
    r := &mut k
    *r = f
    k(p)

fn pick(f: fn(&Point) -> i32, g: fn(&Point) -> i32) -> i32:
    let mut k = fn(q: &Point) -> i32: q.x
    r := &mut k
    *r = f
    k = g
    p := Point { x: 1 }
    k(&p)

fn total(origin: &Point) -> i32:
    n := pick(fn(q: &Point) -> i32: q.x + origin.x, fn(q: &Point) -> i32: q.x) # diagnostic: local-reference-escapes
    m := swap(fn(q: &Point) -> i32: q.x, fn(q: &Point) -> i32: q.x, origin)
    n + m
