# test: a store through a reference to a struct's field is a store in that field, which a function parameter may take
# Spec 13 Local References: ref.local.fn-static.
struct Point:
    x: i32

struct Holder:
    f: fn(&Point) -> i32

fn keep(f: fn(&Point) -> i32) -> Holder:
    let mut h = Holder { f: fn(q: &Point) -> i32: q.x }
    r := &mut h.f
    *r = f
    h
