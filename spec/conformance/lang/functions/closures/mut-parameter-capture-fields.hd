# test: closures observe field writes to captured mutable parameters
# Spec 07: fn.capture.cell.writes.
# expect: test
use std.meta.inline

struct Point:
    x: usize

struct Outer:
    point: Point

@inline(.Never)
fn changed(mut value: Outer) -> usize:
    first := fn() -> usize: value.point.x
    second := fn() -> usize: value.point.x
    value.point.x = 91
    first() + second()

impl Point:
    @inline(.Never)
    fn changed(mut self) -> usize:
        read := fn() -> usize: self.x
        self.x = 91
        read()

tests:
    use std.testing.assert_equal

    it("two readers see a nested parameter field write"):
        assert_equal(changed(Outer { point: Point { x: 3 } }), 182)

    it("a reader sees a mutable receiver field write"):
        assert_equal(Point { x: 3 }.changed(), 91)

    it("a nested closure sees its closure parameter assignment"):
        change := fn(mut value: usize) -> usize:
            read := fn() -> usize: value
            value = 91
            read()
        assert_equal(change(3), 91)
