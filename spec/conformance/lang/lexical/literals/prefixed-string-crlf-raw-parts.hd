# test: prefixed multiline string raw parts normalize CRLF around an interpolation
# Spec: lex.prefix.lines; lex.multiline.line-feed; expr.prefix.raw-parts.
# expect-stdout: true
use std.ops.{Template, str_prefix}

@str_prefix
fn valid(t: Template[string]) -> bool:
    t.raw_parts == ["first\n", "\nlast"] && t.values == ["middle"]

pub fn main() -> void $ Console:
    middle := "middle"
    println(
        valid"""first
$middle
last""",
    )
