# fixture-runtime-profile: pending-tick
# expect-stdout: 1 2
# test: a host wait that completes while a sibling's dispose! drives a block_on still wakes its join! child
# Spec lang/11 Cooperative Scheduling: req.schedule.all-unfinished.
use std.ops.AsyncDisposable
use std.task.{join, block_on}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

struct Pause:
    tick: *mut dyn Tick

impl AsyncDisposable for Pause:
    fn dispose!(&mut self) -> void:
        _ := block_on(self.tick.tick(""))

fn first!() -> usize $ Tick:
    $.use(Tick).tick!("")
    1

fn second!() -> usize $ Tick:
    using! pause = &mut Pause { tick: $.use(Tick) }
    2

pub fn main!() -> void $ Tick + Console:
    pair := join!(first(), second())
    println("${pair._0} ${pair._1}")
