# fixture-runtime-profile: pending-tick
# expect-stdout: second
# expect-stdout: 3 3
# test: host waits that complete while a println in a nested join! waits in the host wake both the inner and the outer join! child
# Spec lang/11 Cooperative Scheduling: req.schedule.all-unfinished.
use std.task.join

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn first!() -> usize $ Tick:
    $.use(Tick).tick!("")
    1

fn second!() -> usize $ Console:
    println("second")
    2

fn inner!() -> usize $ Tick + Console:
    pair := join!(first(), second())
    pair._0 + pair._1

fn third!() -> usize $ Tick:
    $.use(Tick).tick!("")
    3

pub fn main!() -> void $ Tick + Console:
    outer := join!(third(), inner())
    println("${outer._0} ${outer._1}")
