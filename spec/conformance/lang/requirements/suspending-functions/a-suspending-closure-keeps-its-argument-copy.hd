# fixture-runtime-profile: pending-tick
# test: a suspending closure owns its argument before polling and across a wait
# expect-stdout: keepkeep newnew
# expect-stdout: againagain

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

pub fn main!() -> void $ Console + Tick:
    later := fn!(value: string) -> string $ Tick:
        $.use(Tick).tick!(value)
        value
    let mut text = "keep" + "keep"
    let pending: Suspend[string] = later(text)
    text = "new" + "new"
    println("${pending!()} $text")
    _ := later("drop" + "drop")
    println(later!("again" + "again"))
