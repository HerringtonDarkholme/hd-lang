# fixture-runtime-profile: pending-tick
# expect-stdout: second
# expect-stdout: 3
# test: a block_on that drives an join! polls again instead of waiting when a nested println took a child's completion
# Spec lang/11 Driving A Stored Suspension: req.drive.block-on.inner-only.
use std.task.{join, block_on}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn first!() -> usize $ Tick:
    $.use(Tick).tick!("")
    1

fn second!() -> usize $ Console:
    println("second")
    2

fn both!() -> usize $ Tick + Console:
    pair := join!(first(), second())
    pair._0 + pair._1

fn drive() -> usize $ Tick + Console:
    match block_on(both()):
        .Completed(value) => value
        .Cancelled => 0
        .Abandoned => 0

pub fn main() -> void $ Tick + Console:
    println("${drive()}")
