# test: a deferred callback that reaches block_on indirectly type-checks; defer-block-on-indirect.hd shows that it panics at run time
use std.ops.defer
use std.task.block_on

fn ready!() -> i32:
    1

fn drive() -> i32:
    let pending: Suspend[i32] = ready()
    match block_on(pending):
        .Completed(value) => value
        _ => 0

fn plain() -> i32:
    1

fn cleanup_indirect() -> void:
    defer(fn() -> void: _ := drive())
    pass

fn cleanup_plain() -> void:
    defer(fn() -> void: _ := plain())
    pass
