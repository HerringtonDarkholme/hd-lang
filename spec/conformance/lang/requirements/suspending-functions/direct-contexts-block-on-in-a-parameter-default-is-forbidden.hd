# test: direct contexts block on in a parameter default is forbidden
use std.task.block_on

fn ready!() -> i32:
    42
struct Tag:
    name: string
fn tag_of[T](source: T) -> Tag:
    Tag { name: "t" }
fn done[T](end: T) -> i32:
    1
fn text!() -> string:
    "t"

fn f(v: i32 = done(block_on(ready()))) -> i32: # diagnostic: suspension-forbidden-context
    v

pub fn main() -> void:
    pass
