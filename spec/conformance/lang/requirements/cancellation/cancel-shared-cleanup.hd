# fixture-runtime-profile: pending-tick
# expect-stdout: won
# expect-stdout: closing, closed, waiters, finished, finished
# expect-stdout: later finished
# test: several cancel!() calls share one cleanup: the close runs once, each gets the same result, and a later call returns the kept result
# Spec lang/11 Cancellation: req.cancel.shared, req.cancel.kept.
use std.ops.AsyncDisposable
use std.task.{join, race}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Conn:
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing")
        let mut wait = self.closing
        wait!()
        self.log.push("closed")

fn session!(log: *mut List[string]) -> string $ Tick:
    using! conn = &mut Conn { log: log, closing: host_wait() }
    host_wait!()
    "late"

fn ready!() -> string:
    "won"

fn stop_twice!(job: Suspend[string], log: &mut List[string]) -> string:
    let (first, second) = join!(job.cancel(), job.cancel())
    log.push("waiters")
    for end in [first, second]:
        match end:
            .Finished => log.push("finished")
            .Abandoned => log.push("abandoned")
    "stopped"

pub fn main!() -> void $ Console + Tick:
    log := box::[List[string]]([])
    let job: Suspend[string] = session(log)
    let (winner, _) = join!(race(job, ready()), stop_twice(job, log))
    println(winner)
    println(log.join(", "))
    match job.cancel!():
        .Finished => println("later finished")
        .Abandoned => println("later abandoned")
