# fixture-runtime-profile: pending-tick
# expect-stdout: stopped
# expect-stdout: tail, dispose start, dispose defer, outer
# test: abandon() unwinds a job at once as one LIFO list: the tail defer, the dispose that had not started up to its first wait with its own defer, then the outer defer
# Spec lang/11 Abandoning: req.abandon.method.v2, req.abandon.unwind, req.abandon.order.using-split, req.abandon.registered-cleanup, req.abandon.dispose.unstarted.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.race

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Release:
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Release:
    fn dispose!(&mut self) -> void:
        defer(fn() -> void: self.log.push("dispose defer"))
        self.log.push("dispose start")
        let mut wait = self.closing
        wait!()
        self.log.push("dispose end")

fn ordered!(res: &mut Release, log: &mut List[string]) -> string $ Tick:
    defer(fn() -> void: log.push("outer"))
    using! r = res
    defer(fn() -> void: log.push("tail"))
    host_wait!()
    "late"

fn stop!(job: Suspend[string]) -> string:
    job.abandon()
    "stopped"

pub fn main!() -> void $ Console + Tick:
    let log: *mut List[string] = box([])
    let job: Suspend[string] = ordered(&mut Release { log: log, closing: host_wait() }, log)
    println(race!(job, stop(job)))
    println(log.join(", "))
