# fixture-runtime-profile: pending-tick
# expect-stdout: won won
# expect-stdout: closing, closed, stopper defer
# test: cancelling a task that waits in cancel!() stops only its wait: the cleanup goes on inside that task's own cleanup, which ends after it
# Spec lang/11 Cancellation: req.cancel.nested.using-split.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.{join, race}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Conn:
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Conn:
    fn dispose!(&mut self) -> void:
        self.log.push("closing")
        let mut wait = self.closing
        wait!()
        self.log.push("closed")

fn session!(log: *mut List[string]) -> string $ Tick:
    using! conn = &mut Conn { log: log, closing: host_wait() }
    host_wait!()
    "late"

fn ready!() -> string:
    "won"

fn stopper!(job: Suspend[string], log: &mut List[string]) -> string:
    defer(fn() -> void: log.push("stopper defer"))
    _ := job.cancel!()
    log.push("stopper resumed")
    "stopper"

pub fn main!() -> void $ Console + Tick:
    log := box::[List[string]]([])
    let job: Suspend[string] = session(log)
    let (first, second) = join!(race(job, ready()), race(stopper(job, log), ready()))
    println("${first} ${second}")
    println(log.join(", "))
