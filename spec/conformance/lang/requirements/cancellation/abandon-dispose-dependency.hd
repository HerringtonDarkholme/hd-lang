# fixture-runtime-profile: pending-tick
# expect-stdout: won
# expect-stdout: send close, channel defer, plain closed
# expect-stdout: cancelled abandoned
# expect-stdout: value
# expect-stdout: send close, channel defer
# expect-stdout: completed abandoned
# test: a dispose! that awaits a job cancelled elsewhere unwinds from that await as an abandon would, the rest of the cleanup goes on, and the cleanup ends .Abandoned; after an ordinary return the job still completes with its value
# Spec lang/11 Abandoning: req.abandon.dependency, req.abandon.dependency.result, req.abandon.dependency.completed.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.race

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Channel['a]:
    log: *mut List[string]
    ack: Suspend[void, 'a]

impl['a] AsyncDisposable for Channel['a]:
    fn dispose!(&mut self) -> void:
        defer(fn() -> void: self.log.push("channel defer"))
        self.log.push("send close")
        let mut wait = self.ack
        wait!()
        self.log.push("acked")

struct Plain:
    log: *mut List[string]

impl AsyncDisposable for Plain:
    fn dispose!(&mut self) -> void:
        self.log.push("plain closed")

fn talk!(log: *mut List[string], ack: Suspend[void]) -> string $ Tick:
    using! plain = &mut Plain { log: log }
    using! channel = &mut Channel { log: log, ack: ack }
    host_wait!()
    "late"

fn quick!(log: *mut List[string], ack: Suspend[void]) -> string:
    using! channel = &mut Channel { log: log, ack: ack }
    "value"

fn ready!() -> string:
    "won"

fn ended!(job: Suspend[string]) -> string:
    match job.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

pub fn main!() -> void $ Console + Tick:
    let ack: Suspend[void] = host_wait()
    _ := ack.cancel!()
    log := box::[List[string]]([])
    let job: Suspend[string] = talk(log, ack)
    println(race!(job, ready()))
    println(log.join(", "))
    println("cancelled ${ended!(job)}")
    other := box::[List[string]]([])
    let done: Suspend[string] = quick(other, ack)
    println(done!())
    println(other.join(", "))
    println("completed ${ended!(done)}")
