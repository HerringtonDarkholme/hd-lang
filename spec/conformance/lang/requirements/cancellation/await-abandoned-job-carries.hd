# fixture-runtime-profile: pending-tick
# expect-stdout: abandon: drive abandoned, cleanup abandoned
# expect-stdout: graceful: drive cancelled, cleanup finished
# expect-stdout: dependency: drive abandoned, cleanup abandoned
# expect-stdout: chain: drive abandoned, cleanup abandoned
# test: a task cancelled because the job it awaits was cancelled ends .Abandoned when that job's cleanup ended .Abandoned, before the await or while the task unwinds, and .Cancelled otherwise; the result carries up a chain of awaiters
# Spec lang/11 Abandoning: req.abandon.carry; Cancellation: req.cancel.await, req.cancel.await.unwind, req.cancel.await.propagate; Driving A Stored Suspension: req.drive.block-on.cancelled.
use std.ops.AsyncDisposable
use std.task.{join, block_on}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Conn['a]:
    closing: Suspend[void, 'a]
    ack: Suspend[void, 'a]

impl['a] AsyncDisposable for Conn['a]:
    fn dispose!(&mut self) -> void:
        let mut wait = self.closing
        wait!()
        let mut ack = self.ack
        ack!() # abandoned in the dependency case

fn session!(ack: Suspend[void]) -> string $ Tick:
    using! conn = Conn { closing: host_wait(), ack: ack }
    host_wait!()
    "late"

fn stop!(job: Suspend[string], hard: bool) -> string:
    if hard:
        job.abandon()
    else:
        job.cancel!()
    "stopped"

# `join!` polls `job` again once `stop` cancelled it, so `pair` is
# cancelled at that await and its cleanup folds the job's.
fn pair!(job: Suspend[string], hard: bool) -> string:
    let (a, b) = join!(job, stop(job, hard))
    "${a} ${b}"

fn watch!(job: Suspend[string]) -> string:
    job!()

# `watch` is cancelled at its bang call of `job`, and `chained` at its
# `join!` of `watch`.
fn chained!(job: Suspend[string]) -> string:
    let (a, b) = join!(watch(job), stop(job, true))
    "${a} ${b}"

fn report!(task: Suspend[string]) -> string:
    match task.cancel!():
        .Finished => "finished"
        .Abandoned => "abandoned"

fn run(name: string, hard: bool, ack: Suspend[void]) -> string $ Tick:
    let job: Suspend[string] = session(ack)
    drive(name, pair(job, hard))

fn drive(name: string, task: Suspend[string]) -> string:
    let drive = match block_on(task):
        .Completed(value) => value
        .Cancelled => "cancelled"
        .Abandoned => "abandoned"
    let cleanup = match block_on(report(task)):
        .Completed(value) => value
        .Cancelled => "cancelled"
        .Abandoned => "abandoned"
    "${name}: drive ${drive}, cleanup ${cleanup}"

pub fn main() -> void $ Console + Tick:
    println(run("abandon", true, host_wait()))
    println(run("graceful", false, host_wait()))
    let dep: Suspend[void] = host_wait()
    dep.abandon()
    println(run("dependency", false, dep))
    let job: Suspend[string] = session(host_wait())
    println(drive("chain", chained(job)))
