# test: cancelling a cold suspension marks it without running it, returns .Finished, and a second cancel does the same
# Spec 11 Cancellation: req.cancel.cold-job, req.check.cancel-idempotent.

struct Runs:
    count: i32

fn ready!(runs: *mut Runs) -> i32:
    runs.count += 1
    42

fn main!() -> i32:
    runs := box(Runs { count: 0 })
    let pending: Suspend[i32] = ready(runs)
    first := pending.cancel!()
    second := pending.cancel!()
    if runs.count != 0:
        return 0
    match first:
        .Finished => pass
        .Abandoned => return 0
    match second:
        .Finished => 42
        .Abandoned => 0

tests:
    use std.testing.assert_equal

    it("main returns 42"):
        assert_equal(
            main!(),
            42,
            reason="cancelling a cold suspension twice returns .Finished both times",
        )
