# fixture-runtime-profile: pending-tick
# expect-stdout: abandon, a closing, a defer, b closing, b defer
# expect-stdout: c closing, abandon, c defer, waiter abandoned
# test: abandon() abandons every cleanup folded into the job: the children join! started, and a shared cleanup the job waits on in cancel!(), whose other waiter gets .Abandoned
# Spec lang/11 Abandoning: req.abandon.folded, req.abandon.dispose.unstarted, req.abandon.result.
use std.ops.defer
use std.ops.AsyncDisposable
use std.task.{join, race}

pub trait Tick:
    fn tick!(&mut self, note: string) -> void

fn host_wait!() -> void $ Tick:
    $.use(Tick).tick!("")

struct Conn:
    name: string
    log: *mut List[string]
    closing: Suspend[void]

impl AsyncDisposable for Conn:
    fn dispose!(&mut self) -> void:
        defer(fn() -> void: self.log.push("${self.name} defer"))
        self.log.push("${self.name} closing")
        let mut wait = self.closing
        wait!()
        self.log.push("${self.name} closed")

fn worker!(name: string, log: *mut List[string]) -> i32 $ Tick:
    using! conn = &mut Conn { name: name, log: log, closing: host_wait() }
    host_wait!()
    +1

fn pair!(log: *mut List[string]) -> i32 $ Tick:
    let (a, b) = join!(worker("a", log), worker("b", log))
    a + b

fn waiter!(job: Suspend[i32], log: &mut List[string]) -> i32:
    end := job.cancel!()
    match end:
        .Finished => log.push("waiter finished")
        .Abandoned => log.push("waiter abandoned")
    +2

fn ready!() -> i32:
    +0

fn stop!(job: Suspend[i32], log: &mut List[string]) -> i32:
    log.push("abandon")
    job.abandon()
    +3

pub fn main!() -> void $ Console + Tick:
    log := box::[List[string]]([])
    let job: Suspend[i32] = pair(log)
    _ := race!(job, stop(job, log))
    println(log.join(", "))
    other := box::[List[string]]([])
    let shared: Suspend[i32] = worker("c", other)
    holder_log := other
    waiter_log := other
    stop_log := other
    let holder: Suspend[i32] = waiter(shared, holder_log)
    _ := join!(
        race(shared, ready()),
        waiter(shared, waiter_log),
        race(holder, stop(holder, stop_log)),
    )
    println(other.join(", "))
