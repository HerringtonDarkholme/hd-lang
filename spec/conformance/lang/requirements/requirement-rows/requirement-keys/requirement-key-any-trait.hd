# test: a requirement key may name a trait with an associated function, and its method stays callable through $.use
# Spec 11 Requirement Keys: req.key.any-trait-members.reference-values; Spec 09 Dyn Types: trait.dyn.except-fn, trait.dyn.member.assoc-function.

trait Factory:
    fn create() -> Self
    fn name(self) -> string

fn build() -> string $ Factory:
    $.use(Factory).name()
