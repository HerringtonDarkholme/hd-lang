# test: row aliases a nested alias flattens into the keys of its caller
# fixture-package-tree: row-aliases-nested-keys/src/main.hd
use pkg.keys.{Db, Cache, Log, Web, WithLog}

fn serve() -> void $ Web + Db:
    pass

fn run() -> void $ Log + Cache + Db:
    serve()

fn logged[$ R](job: fn() -> void $ R) -> void $ WithLog[$ R]:
    job()

fn quiet() -> void $ Db:
    pass

fn outer() -> void $ Db + Log:
    logged(quiet)
