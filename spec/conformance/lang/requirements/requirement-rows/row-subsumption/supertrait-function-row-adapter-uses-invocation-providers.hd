# test: supertrait function row adapter uses invocation providers
# Spec lang/11-requirements-and-suspension.md: req.row.subsume.adapt.
# expect-stdout: 40
# expect-stdout: 60
trait Base:
    fn base(&self) -> i32

trait Named < Base:
    fn name(&self) -> i32

struct S:
    n: i32

impl Base for S:
    fn base(&self) -> i32:
        self.n * 10

impl Named for S:
    fn name(&self) -> i32:
        self.n

fn original() -> i32 $ Base:
    $.use(Base).base()

fn invoke(f: fn() -> i32 $ Named) -> i32 $ Named:
    f()

pub fn main() -> void $ Console:
    let callback: fn() -> i32 $ Named = original
    $.with(Named=box(S { n: 4 })):
        println(invoke(callback))
    $.with(Named=box(S { n: 6 })):
        println(invoke(callback))
