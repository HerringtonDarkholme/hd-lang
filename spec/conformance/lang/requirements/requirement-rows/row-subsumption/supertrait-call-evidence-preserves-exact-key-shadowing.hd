# test: supertrait call evidence preserves exact key shadowing
# Spec lang/11-requirements-and-suspension.md: req.row.entail.super.
# expect-stdout: 20
# expect-stdout: 40
# expect-stdout: 60
# expect-stdout: 40
# expect-stdout: 40
# expect-stdout: 60

trait Base:
    fn base(&self) -> i32

trait Named < Base:
    fn name(&self) -> i32

struct Source:
    n: i32

impl Base for Source:
    fn base(&self) -> i32:
        self.n * 10

impl Named for Source:
    fn name(&self) -> i32:
        self.n

fn needs_base() -> i32 $ Base:
    $.use(Base).base()

fn inferred():
    needs_base()

fn projected() -> i32 $ Named:
    needs_base()

fn shadowed() -> i32 $ Named:
    $.with(Named=box(Source { n: 6 })):
        needs_base()

fn exact() -> i32 $ Base + Named:
    $.with(Named=box(Source { n: 9 })):
        needs_base()

pub fn main() -> void $ Console:
    $.with(Base=box(Source { n: 2 }), Named=box(Source { n: 4 })):
        println(exact())
        println(projected())
        println(shadowed())
    let callback: fn() -> i32 $ Base = needs_base
    $.with(Named=box(Source { n: 4 })):
        println(callback())
        println(inferred())
    $.with(Named=box(Source { n: 6 })):
        println(callback())
