# test: $.use with two names gives each its own provider, in the order the list names them

trait Left:
    fn value(self) -> i32

trait Right:
    fn value(self) -> i32

struct Number:
    value: i32

impl Left for Number:
    fn value(self) -> i32:
        self.value

impl Right for Number:
    fn value(self) -> i32:
        self.value

fn main() -> i32:
    $.with(Left=Number { value: 20 }, Right=Number { value: 22 }):
        let (left, right) = $.use(Left, Right)
        left.value() * 100 + right.value()

tests:
    use std.testing.assert_equal

    it("each name in the use list gets its own provider"):
        assert_equal(
            main(),
            2022,
            reason="Left is 20 and Right is 22, in the order the list names them",
        )
