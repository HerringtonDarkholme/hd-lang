# test: a trait argument that misses its parameter bound is rejected at an implementation header
trait Shown:
    fn shown(self) -> i32

trait Tagged[T < Shown]:
    fn tag(self, t: T) -> i32

struct Plain:
    v: i64

struct Holder:
    v: i32

impl Tagged[Plain] for Holder: # diagnostic: unsatisfied-trait-bound
    fn tag(self, t: Plain) -> i32:
        +1
