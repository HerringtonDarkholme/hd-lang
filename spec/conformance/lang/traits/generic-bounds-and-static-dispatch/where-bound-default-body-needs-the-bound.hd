# test: a default body that calls a where-bounded method without that bound of its own fails at the call
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.body, trait.where.call.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

    fn unbounded(self) -> i32:
        self.top_rank() # diagnostic: unsatisfied-trait-bound
