# test: a call through a generic bound needs the where bound on the caller's parameter
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.call.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

fn any_rank[T, P < Pile[T]](pile: P) -> i32:
    pile.top_rank() # diagnostic: unsatisfied-trait-bound
