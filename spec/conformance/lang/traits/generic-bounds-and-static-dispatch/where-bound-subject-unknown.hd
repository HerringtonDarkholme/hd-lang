# test: a where bound may not name a name that is not a parameter of the enclosing trait or implementation
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.subject.error.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T
    fn odd(self) -> T where V < Rank  # diagnostic: syntax-error
