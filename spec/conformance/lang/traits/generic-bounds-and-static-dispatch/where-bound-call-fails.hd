# test: a call of a method on a concrete type that fails the method's where bound is an error at the call
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.call, trait.where.implements.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

struct Words:
    first: string

impl Pile[string] for Words:
    fn top(self) -> string:
        self.first

fn word_rank(words: Words) -> i32:
    words.top_rank() # diagnostic: unsatisfied-trait-bound
