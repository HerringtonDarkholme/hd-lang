# test: Box[Box[i32]] needs a bound of depth 3, which is accepted
# Spec 09 Traits: trait.bound.depth.
trait Marker

struct Box[T]:
    value: T

impl Marker for i32

impl[T < Marker] Marker for Box[T]

fn need[T < Marker](value: T) -> void:
    pass

fn deep(value: Box[Box[i32]]) -> void:
    need(value)
