# test: an implementation method repeats the trait method's where bound over its own parameter, and leaves out one whose subject became a concrete type
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.impl.repeat, trait.where.impl.concrete, trait.where.body.
# expect-stdout: 30 104
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

struct Card:
    value: i32

impl Rank for Card:
    fn rank(self) -> i32:
        self.value

struct Deck[T]:
    first: T

impl[T] Pile[T] for Deck[T]:
    fn top(self) -> T:
        self.first

    fn top_rank(self) -> i32 where T < Rank:
        self.first.rank() * 10

struct Cards:
    first: Card

impl Pile[Card] for Cards:
    fn top(self) -> Card:
        self.first

    fn top_rank(self) -> i32:
        self.first.rank() + 100

pub fn main() -> void $ Console:
    deck := Deck { first: Card { value: 3 } }
    cards := Cards { first: Card { value: 4 } }
    println("${deck.top_rank()} ${cards.top_rank()}")
