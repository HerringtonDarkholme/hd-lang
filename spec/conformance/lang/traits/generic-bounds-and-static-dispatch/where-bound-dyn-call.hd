# test: a method with a where bound is unavailable on a trait value, while the trait's other methods stay available
# Spec 09 Dyn Types: trait.dyn.member.where, trait.dyn.member.unavailable.error. Spec 09 Method Bounds On Enclosing Parameters: trait.where.dyn.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

struct Card:
    value: i32

impl Rank for Card:
    fn rank(self) -> i32:
        self.value

fn through(pile: &dyn Pile[Card]) -> i32:
    pile.top().value + pile.top_rank() # diagnostic: dyn-member-unavailable
