# test: an implementation method that leaves out a where bound over its own parameter differs from the trait's declaration
# Spec 09 Method Bounds On Enclosing Parameters: trait.where.impl.repeat, trait.where.impl.error.
trait Rank:
    fn rank(self) -> i32

trait Pile[T]:
    fn top(self) -> T

    fn top_rank(self) -> i32 where T < Rank:
        self.top().rank()

struct Hand[T]:
    first: T

impl[T] Pile[T] for Hand[T]:
    fn top(self) -> T:
        self.first

    fn top_rank(self) -> i32: # diagnostic: trait-method-signature
        0
