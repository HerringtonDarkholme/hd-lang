# test: a trait with a method type parameter bounded by Error is still a valid dyn type
# Spec 09 Dyn Types: trait.dyn.member.type-param; Spec 04 Dynamic Safety: types.trait.safe.method-type-param.
use std.error.Error

trait Registry:
    fn lookup[T < Error](self, name: string) -> T?

fn valid(registry: &dyn Registry) -> void:
    pass
