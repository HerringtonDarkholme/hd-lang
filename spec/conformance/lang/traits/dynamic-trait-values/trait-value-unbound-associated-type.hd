# test: a trait value type that leaves an associated type unbound is an error
# Spec 09 Bound Associated Types: trait.dyn.binding.complete.reference-values; Dyn Types: trait.dyn.assoc-type.reference-values (owner decision AT2).

trait Supplier:
    type Item
    fn get(self) -> Self::Item

fn unbound(source: &dyn Supplier) -> void: # diagnostic: invalid-dyn-type
    pass
