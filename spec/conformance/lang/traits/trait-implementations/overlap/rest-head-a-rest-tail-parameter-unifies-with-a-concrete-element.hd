# test: a rest tail parameter unifies with a concrete element
# Spec: trait.overlap.unify; types.tuple.rest.same.
trait Pick[A]:
    fn pick(self, value: A) -> i32

impl[T] Pick[i32] for (i32, List[T]...):
    fn pick(self, value: i32) -> i32:
        1

impl Pick[i32] for (i32, List[bool]...): # diagnostic: overlapping-impl
    fn pick(self, value: i32) -> i32:
        2
