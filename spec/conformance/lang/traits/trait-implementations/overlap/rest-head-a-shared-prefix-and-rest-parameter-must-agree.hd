# test: a shared prefix and rest parameter must agree
# Spec: trait.overlap.unify; types.tuple.rest.same.
trait Pick[A]:
    fn pick(self, value: A) -> i32

impl[T] Pick[i32] for (T, List[T]...):
    fn pick(self, value: i32) -> i32:
        1

impl Pick[i32] for (i32, List[string]...):
    fn pick(self, value: i32) -> i32:
        2
