# test: impl targets an inherent impl of a struct is well formed
use std.ops.Fn

trait Marker
trait Log:
    fn write(self, text: string) -> void
trait Holder[T]:
    fn get(self) -> T
trait Store:
    type Item
    fn first(self) -> Self::Item
trait Summary:
    fn summary(self) -> string
struct User:
    name: string
struct Feed[I]:
    items: I
type Person = User

impl User:
    fn label(self) -> string:
        self.name

pub fn main() -> void:
    pass
