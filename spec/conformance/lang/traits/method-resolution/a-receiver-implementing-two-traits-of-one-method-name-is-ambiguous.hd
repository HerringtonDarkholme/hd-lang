# test: a receiver whose type implements two traits declaring one method name is ambiguous
# Spec 09 Method Resolution: trait.resolve.ambiguous.
trait Mix:
    fn mix(&self) -> i32

trait Other:
    fn mix(&self) -> i32

struct A:
    n: i32

impl Mix for A:
    fn mix(&self) -> i32: self.n

impl Other for A:
    fn mix(&self) -> i32: 2

pub fn main() -> void $ Console:
    a := A { n: 1 }
    println("${a.mix()}") # diagnostic: ambiguous-method
