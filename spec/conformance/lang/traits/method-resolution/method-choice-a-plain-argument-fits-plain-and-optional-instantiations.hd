# trait.resolve.many-apply: a plain argument fits both a parameter of its own type and an optional one, so the call stays ambiguous.
trait Take[A]:
    fn take(&self, a: A) -> i32

struct X:
    n: i32

struct P:
    v: i32

impl Take[P] for X:
    fn take(&self, a: P) -> i32:
        a.v

impl Take[P?] for X:
    fn take(&self, a: P?) -> i32:
        0

pub fn main() -> void:
    x := X { n: 0 }
    t := x.take(P { v: 1 }) # diagnostic: ambiguous-method
