# test: a spelled function type is not inspectable as a type argument, so a struct holding one does not erase to Inspectable
use std.function.Fn
use std.inspect.Inspectable

struct Box[T]:
    value: T

fn one() -> i32:
    1

fn erase(boxed: Box[Fn[(), i32, $()]]) -> *dyn Inspectable:
    box(boxed) # diagnostic: type-mismatch
