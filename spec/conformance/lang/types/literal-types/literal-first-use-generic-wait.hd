# test: an unconstrained generic argument waits for the deciding use, so an i64 comparison after the call decides it
# Spec 04 Open Literal Width: types.literal.local.statement, types.literal.local.obligation.

fn show[T < Display](value: T) -> string:
    "$value"

fn run(limit: i64) -> bool:
    let i = 0
    let text = show(i)
    i < limit
