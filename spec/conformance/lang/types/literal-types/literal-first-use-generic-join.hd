# test: a generic call decides an open variable when another argument fixes its parameter
# Spec 04 Open Literal Width: types.literal.local.form.argument.

fn biggest[T < Ord](left: T, right: T) -> T:
    match left.cmp(&right):
        .Less => right
        _ => left

fn run(limit: i64) -> i64:
    let i = 0
    let top = biggest(i, limit)
    top + i
