# test: open variables flow through ranges, lists, maps, generic enums, generic data, tuples, and generic calls

struct Pair[T]:
    first: T
    second: T

fn identity[T](value: T) -> T:
    value

fn build() -> void:
    let span = 0..10
    let xs = [1, 2]
    let scores = { "Ada": 1.5 }
    let found = Option.Some(3)
    let pair = Pair { first: 1, second: 2 }
    let both = (1, 2.5)
    let same = identity(7)
    let low: i64 = span.start
    let head: u8 = xs[0]
    let score: f32 = scores["Ada"]
    let inner: i16? = found
    let left: u64 = pair.first
    let number: i8 = both._0
    let ratio: f32 = both._1
    let copied: u16 = same
