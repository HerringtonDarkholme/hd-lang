# test: least common type if branches of function lists with different rows have no common type
# Spec lang/04-type-system.md: types.lct.sites.

trait Db

trait Clock

fn health() -> string $ Clock:
    "ok"

fn orders() -> string $ Db:
    "orders"

fn count() -> i32 $ Clock:
    1

fn f(c: bool) -> void:
    _v := if c: [orders] else: [health] # diagnostic: no-common-type
