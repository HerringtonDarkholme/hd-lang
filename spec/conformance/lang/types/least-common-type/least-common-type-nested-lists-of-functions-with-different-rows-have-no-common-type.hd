# test: least common type nested lists of functions with different rows have no common type
# Spec lang/04-type-system.md: types.lct.sites.

trait Db

trait Clock

fn health() -> string $ Clock:
    "ok"

fn orders() -> string $ Db:
    "orders"

fn count() -> i32 $ Clock:
    1

fn f() -> void:
    _v := [[health], [orders]] # diagnostic: no-common-type
