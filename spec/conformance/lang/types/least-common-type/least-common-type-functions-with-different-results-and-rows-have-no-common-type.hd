# test: functions with different results have no common type, even after their different rows are joined
# Spec lang/04-type-system.md: types.lct.sites, types.lct.row-union-every-site.

trait Db

trait Clock

fn orders() -> string $ Db:
    "orders"

fn count() -> i32 $ Clock:
    1

fn f() -> void:
    _v := [orders, count] # diagnostic: no-common-type
