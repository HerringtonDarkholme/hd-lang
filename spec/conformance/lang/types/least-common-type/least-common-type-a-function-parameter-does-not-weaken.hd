# test: the least common type does not convert a function's reference parameter
# Spec 04 Least Common Type: types.lct.no-combine, types.variance.function.

struct Cell:
    v: i32

fn pick(flag: bool, owned: fn(&mut Cell) -> i32, shared: fn(&Cell) -> i32) -> void:
    _ := if flag: owned else: shared # diagnostic: no-common-type
