use std.ops.Index
use std.ops.IndexSet

struct Grid:
    width: i32

impl Index[(i32, i32)] for Grid:
    type Out = i32
    fn index(&self, key: (i32, i32)) -> i32:
        key._0 * self.width + key._1

impl Index[i32] for Grid:
    type Out = i32
    fn index(&self, key: i32) -> i32:
        self.width + key

impl IndexSet[(i32, i32), i32] for Grid:
    fn index_set(&mut self, key: (i32, i32), value: i32) -> void:
        self.width = value

fn grid() -> impl Index[(i32, i32), Out = i32]:
    Grid { width: 10 }

fn row() -> impl Index[i32, Out = i32]:
    Grid { width: 10 }

fn cells() -> impl IndexSet[(i32, i32), i32]:
    Grid { width: 10 }

fn cell() -> i32:
    let mut c = cells()
    c[(1, 2)] = 5
    grid()[(1, 2)] + row()[3]
