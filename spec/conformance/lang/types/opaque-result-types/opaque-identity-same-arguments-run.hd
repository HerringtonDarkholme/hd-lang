# Spec 04 Opaque Result Types: types.opaque.identity-position.
# expect-stdout: ok
trait Extra:
    pass

fn make[T, N < const i32, $ R](value: T) -> (impl Eq, List[impl Eq]):
    (+1, [+2])

fn anonymous(value: impl Eq) -> impl Eq:
    +1

struct Maker[T, $ R, N < const i32]:
    value: T

impl[T, $ R, N < const i32] Maker[T, $ R, N]:
    fn result(&self) -> impl Eq:
        +1

    fn extra[M < const bool, $ S](&self) -> impl Eq:
        +2

trait Produce:
    fn produce(&self) -> impl Eq

impl[T, $ R, N < const i32] Produce for Maker[T, $ R, N]:
    fn produce(&self) -> impl Eq:
        +3

fn outer[T, N < const i32, $ R](value: T) -> impl Eq:
    fn inner() -> impl Eq:
        +4
    inner()

fn same[T](left: T, right: T) -> void:
    pass

pub fn main() -> void $ Console:
    same(make::[i32, 1, $()](+0)._0, make::[i32, 1, $()](+1)._0)
    same(make::[i32, 2, $ Console + Extra](+0)._1, make::[i32, 2, $ Extra + Console](+1)._1)
    same(anonymous(+1), anonymous(+2))
    maker := Maker::[i32, $ Console, 1] { value: +0 }
    same(maker.result(), maker.result())
    same(maker.extra::[true, $ Console](), maker.extra::[true, $ Console]())
    same(maker.produce(), maker.produce())
    same(outer::[i32, 1, $ Console](+0), outer::[i32, 1, $ Console](+1))
    println("ok")
