# Spec 04 Opaque Result Types: types.opaque.identity-position.
trait Extra:
    pass

fn make[$ R]() -> impl Eq:
    +1

fn same[T](left: T, right: T) -> void:
    pass

pub fn main() -> void:
    same(make::[$()](), make::[$ Console]()) # diagnostic: type-mismatch
    same(make::[$ Console](), make::[$ Console]())
    same(make::[$ Console + Extra](), make::[$ Extra + Console]())
