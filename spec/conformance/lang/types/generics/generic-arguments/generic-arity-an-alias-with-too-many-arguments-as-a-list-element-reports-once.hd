# test: generic arity an alias with too many arguments as a list element reports once
type Both[A, B] = (A, B)

trait Show:
    fn show(self) -> string

trait Conv[T]:
    fn conv(self) -> T

struct Pair[K, V]:
    key: K
    value: V

enum Choice[T]:
    Some(T)
    Empty

type Wrap[T](T)

fn f(b: List[Both[i32, string, bool]]) -> i32: # diagnostic: argument-count
    0
