# data.enum.no-recursion, trait.assoc.projection: a by-value cycle through an associated payload is reported beside a clean instance of the same enum that another body already checked.
trait Source:
    type Item

struct Provider[T]: pass

struct Plain: pass

enum Holder[S < Source]:
    Empty
    Full(value: S::Item)

impl[T] Source for Provider[T]:
    type Item = Holder[Provider[T]]

impl Source for Plain:
    type Item = i32

fn make[S < Source]() -> Holder[S]:
    .Empty

fn clean() -> void:
    value := (make::[Plain](), make::[Plain]())

fn mixed() -> void:
    value := (make::[Plain](), make::[Provider[i32]]()) # diagnostic: recursive-value-type

pub fn main() -> void:
    clean()
    mixed()
