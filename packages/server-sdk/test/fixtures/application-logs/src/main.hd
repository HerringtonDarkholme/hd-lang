use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Request, Response}
use std.ops.AsyncDisposable
use std.time.{Clock, sleep, ms}

struct State: pass

struct Closing:
    work: mut Suspend[void]

impl AsyncDisposable for Closing:
    fn dispose!(&mut self) -> void:
        let mut work = self.work
        work!()

fn close!(label: string) -> void $ Console:
    _ := $.use(Console).write_error_sync("cleanup $label\n")

fn handle!(request: Request, _state: &mut State) -> Response $ Console + Clock:
    if request.url.path.ends_with("/denied"):
        out := $.use(Console).write_sync("private stdout")
        err := $.use(Console).write_error_sync("private stderr")
        a := match out:
            .Err(.NotGranted(stream)) => "$stream"
            _ => "incorrect stdout permission"
        b := match err:
            .Err(.NotGranted(stream)) => "$stream"
            _ => "incorrect stderr permission"
        return Response::status(.Ok).set_text("$a/$b")
    label := request.url.to_string()
    using! closing = Closing { work: close(label) }
    _ := $.use(Console).write_sync("start $label\n")
    sleep!(ms(if request.url.path.ends_with("/slow"): 30 else: 1))
    _ := $.use(Console).write_error_sync("end $label\n")
    if request.url.path.ends_with("/panic"):
        panic("private guest diagnostic")
    Response::status(.Ok).set_text(label)

pub fn main!() -> void $ HttpServer + Console + Clock:
    _ := $.use(Console).write_sync("startup\n")
    serve!(4, &mut State {}, handle).expect("serve")
