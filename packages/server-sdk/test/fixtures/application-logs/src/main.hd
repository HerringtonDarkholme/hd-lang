use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Request, Response}
use std.ops.Disposable
use std.time.{Clock, sleep, ms}

struct State: pass

struct Closing:
    work: mut Suspend[void]

impl Disposable for Closing:
    fn dispose!(&mut self) -> void:
        let mut work = self.work
        work!()

fn close!(label: string) -> void $ Console:
    _ := $.use(Console).write_error!("cleanup $label\n")

fn handle!(request: Request, _state: &mut State) -> Response $ Console + Clock:
    if request.url.ends_with("/denied"):
        out := $.use(Console).write!("private stdout")
        err := $.use(Console).write_error!("private stderr")
        a := match out:
            .Err(.NotGranted(subject)) => subject
            _ => "incorrect stdout permission"
        b := match err:
            .Err(.NotGranted(subject)) => subject
            _ => "incorrect stderr permission"
        return Response { status: 200, body: "$a/$b".to_utf8() }
    label := request.url
    using closing = Closing { work: close(label) }
    _ := $.use(Console).write!("start $label\n")
    sleep!(ms(if request.url.ends_with("/slow"): 30 else: 1))
    _ := $.use(Console).write_error!("end $label\n")
    if request.url.ends_with("/panic"):
        panic("private guest diagnostic")
    Response { status: 200, body: label.to_utf8() }

pub fn main!() -> void $ HttpServer + Console + Clock:
    _ := $.use(Console).write!("startup\n")
    serve!(4, &mut State {}, handle).expect("serve")
