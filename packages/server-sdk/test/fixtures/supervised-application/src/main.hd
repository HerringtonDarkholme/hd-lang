use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Http, Request, Response, HttpError, Url}
use std.ops.AsyncDisposable
use std.task.block_on
use std.time.{Clock, sleep, ms, s}

struct State:
    hits: usize

struct InfiniteCleanup: pass
impl AsyncDisposable for InfiniteCleanup:
    fn dispose!(&mut self) -> void:
        while true:
            pass

struct WaitingCleanup:
    wait: mut Suspend[void]
impl AsyncDisposable for WaitingCleanup:
    fn dispose!(&mut self) -> void:
        let mut wait = self.wait
        wait!()

struct HttpCleanup:
    wait: mut Suspend[Result[Response, HttpError]]
impl AsyncDisposable for HttpCleanup:
    fn dispose!(&mut self) -> void:
        let mut wait = self.wait
        _ := wait!()

fn spin() -> void:
    while true:
        pass

fn forward!(target: string) -> Result[Response, HttpError] $ Http:
    Request::get(Url::parse(target)?).send!()

fn handle!(request: Request, state: &mut State) -> Response $ Http + Clock:
    state.hits += 1
    if request.url.path.ends_with("/cpu"):
        spin()
    if request.url.path.ends_with("/trap"):
        panic("private HD panic must not reach a client")
    if request.url.path.ends_with("/cleanup-cpu"):
        using! closing = InfiniteCleanup {}
        url := request.text().expect("entry acknowledgement URL")
        _ := forward!(url)
        sleep!(s(60))
        return Response::status(.Ok)
    if request.url.path.ends_with("/cleanup-wait"):
        using! closing = WaitingCleanup { wait: sleep(s(60)) }
        url := request.text().expect("entry acknowledgement URL")
        _ := forward!(url)
        sleep!(s(60))
        return Response::status(.Ok)
    if request.url.path.ends_with("/slow"):
        sleep!(ms(80))
    if request.url.path.ends_with("/ack"):
        url := request.text().expect("cleanup URL")
        using! closing = HttpCleanup { wait: forward(url) }
        return Response::status(.Ok).set_text("after cleanup")
    if request.url.path.ends_with("/block-pending"):
        url := request.text().expect("upstream URL")
        _ := block_on(forward(url))
    if request.url.path.ends_with("/proxy"):
        url := request.text().expect("upstream URL")
        return match forward!(url):
            .Ok(response) => response
            .Err(error) => Response::status(.BadGateway).set_text("$error")
    Response::status(.Ok).set_text("${state.hits}")

pub fn main!() -> void $ HttpServer + Http + Clock:
    serve!(4, box(State { hits: 0 }), handle).expect("server")
