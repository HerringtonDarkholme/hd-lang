use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Http, Request, Response, HttpError}
use std.ops.Disposable
use std.task.block_on
use std.time.{Clock, sleep, ms, s}

struct State:
    hits: usize

struct InfiniteCleanup: pass
impl Disposable for InfiniteCleanup:
    fn dispose!(&mut self) -> void:
        while true: pass

struct WaitingCleanup:
    wait: mut Suspend[void]
impl Disposable for WaitingCleanup:
    fn dispose!(&mut self) -> void:
        let mut wait = self.wait
        wait!()

struct HttpCleanup:
    wait: mut Suspend[Result[Response, HttpError]]
impl Disposable for HttpCleanup:
    fn dispose!(&mut self) -> void:
        let mut wait = self.wait
        _ := wait!()

fn spin() -> void:
    while true: pass

fn handle!(request: Request, state: &mut State) -> Response $ Http + Clock:
    state.hits += 1
    if request.url.ends_with("/cpu"):
        spin()
    if request.url.ends_with("/trap"):
        panic("private HD panic must not reach a client")
    if request.url.ends_with("/cleanup-cpu"):
        using closing = InfiniteCleanup {}
        url := string::from_utf8(request.body).expect("entry acknowledgement URL")
        _ := Request::get(url).send!()
        sleep!(s(60))
        return Response { status: 200 }
    if request.url.ends_with("/cleanup-wait"):
        using closing = WaitingCleanup { wait: sleep(s(60)) }
        url := string::from_utf8(request.body).expect("entry acknowledgement URL")
        _ := Request::get(url).send!()
        sleep!(s(60))
        return Response { status: 200 }
    if request.url.ends_with("/slow"):
        sleep!(ms(80))
    if request.url.ends_with("/ack"):
        url := string::from_utf8(request.body).expect("cleanup URL")
        using closing = HttpCleanup { wait: Request::get(url).send() }
        return Response { status: 200, body: "after cleanup".to_utf8() }
    if request.url.ends_with("/block-pending"):
        url := string::from_utf8(request.body).expect("upstream URL")
        _ := block_on(Request::get(url).send())
    if request.url.ends_with("/proxy"):
        url := string::from_utf8(request.body).expect("upstream URL")
        return match Request::get(url).send!():
            .Ok(response) => response
            .Err(error) => Response { status: 502, body: "${error}".to_utf8() }
    Response { status: 200, body: "${state.hits}".to_utf8() }

pub fn main!() -> void $ HttpServer + Http + Clock:
    serve!(4, &mut State { hits: 0 }, handle).expect("server")
