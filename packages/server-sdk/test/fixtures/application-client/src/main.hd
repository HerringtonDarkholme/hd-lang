use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Http, HttpError, Request, Response, Url}

struct State: pass

fn forward!(target: string) -> Result[Response, HttpError] $ Http:
    Request::get(Url::parse(target)?).send!()

fn handle!(request: Request, _state: &mut State) -> Response $ Http:
    url := request.text().expect("the upstream URL")
    match forward!(url):
        .Ok(response) => response
        .Err(error) => Response::status(.BadGateway).set_text("$error")

pub fn main!() -> void $ HttpServer + Http:
    serve!(4, &mut State {}, handle).expect("the server")
