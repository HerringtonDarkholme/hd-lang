use pkg.{Artifacts, CloudflareOptions, DeploymentReceipt, DeploymentError, Deployment, cloudflare}
use std.testing.assert_equal

struct RecordingDeployment:
    names: List[string]

impl Deployment for RecordingDeployment:
    fn cloudflare!(&mut self, options: CloudflareOptions) -> Result[DeploymentReceipt, DeploymentError]:
        self.names.push(options.name)
        .Ok(DeploymentReceipt {
            directory: options.artifacts.output,
            runtime_fingerprint: "runtime",
            wasm_sha256: "wasm",
            bindings_sha256: "bindings"
        })

it("deployment options default to no environment bindings"):
    options := CloudflareOptions {
        name: "example",
        artifacts: Artifacts { wasm: "app.wasm", bindings: "app.host.mjs", output: "cloudflare" },
        compatibility_date: "2026-10-23"
    }
    assert_equal(options.env_bindings.len(), 0, reason="deployment never discovers ambient environment names")

it("deployment facade forwards options to the selected capability"):
    provider := &mut RecordingDeployment { names: [] }
    result := $.with(Deployment=provider):
        cloudflare!(CloudflareOptions {
            name: "example",
            artifacts: Artifacts { wasm: "app.wasm", bindings: "app.host.mjs", output: "cloudflare" },
            compatibility_date: "2026-10-23",
            env_bindings: ["APP_MODE"]
        })
    match result:
        .Ok(receipt) =>
            assert_equal(receipt.directory, "cloudflare", reason="the typed receipt is preserved")
            assert_equal(receipt.runtime_fingerprint, "runtime", reason="runtime identity is preserved")
            assert_equal(receipt.wasm_sha256, "wasm", reason="Wasm identity is preserved")
            assert_equal(receipt.bindings_sha256, "bindings", reason="binding identity is preserved")
        .Err(_) => panic("the recording capability succeeds")
    assert_equal(provider.names.len(), 1, reason="one call reaches the selected capability")
    assert_equal(provider.names[0], "example", reason="the selected Worker name is preserved")
