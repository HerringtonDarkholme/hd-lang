use std.http.{Http, Request, Response, request_from_wire, response_to_wire}
use std.http_wire.{WireRequest, WireResponse}
use std.task.{apply, map_all, race, timeout, TimedOut, CleanupEnd}
use std.ops.AsyncDisposable
use std.time.{Clock, ms, s}

pub struct RequestId:
    pub generation: u64
    pub sequence: u64

pub struct Incoming:
    pub id: RequestId
    pub request: WireRequest

@error
pub enum ServerError:
    @error("server closed")
    Closed
    @error("request lease expired")
    Expired
    @error("$reason")
    Other(reason: string)

pub enum CancelReason:
    Disconnected
    Deadline
    Stopping

@host
pub trait HttpServer:
    fn accept!(&mut self) -> Result[Incoming?, ServerError]
    fn respond!(&mut self, id: RequestId, response: WireResponse) -> Result[void, ServerError]
    fn cancelled!(&mut self, id: RequestId) -> CancelReason
    fn client(&mut self, id: RequestId) -> *mut dyn Http
    fn clock(&mut self, id: RequestId) -> *mut dyn Clock
    fn console(&mut self, id: RequestId) -> *mut dyn Console
    fn finish(&mut self, id: RequestId, abandoned: bool) -> void

enum JobEnd:
    Response(value: Response)
    Cancelled

struct CleanupState:
    abandoned: bool

# The timeout owns the handler and bounds its cleanup even when cancelled
# externally. The lease outlives the race and acknowledges cleanup last.
struct Lease:
    server: *mut dyn HttpServer
    id: RequestId
    job: mut Suspend[Result[Response, TimedOut]]
    state: *mut CleanupState

impl AsyncDisposable for Lease:
    fn dispose!(&mut self) -> void:
        end := self.job.cancel!()
        self.server.finish(self.id, self.state.abandoned || end == CleanupEnd.Abandoned)

fn cancellation!(server: &mut dyn HttpServer, id: RequestId) -> JobEnd:
    _ := server.cancelled!(id)
    .Cancelled

fn response!(job: mut Suspend[Result[Response, TimedOut]], state: &mut CleanupState) -> JobEnd:
    match job!():
        .Ok(value) => .Response(value)
        .Err(error) =>
            state.abandoned = error.cleanup == CleanupEnd.Abandoned
            .Response(Response::status(.GatewayTimeout).set_text("request timed out"))

fn request![S, $ R](
    server: *mut dyn HttpServer,
    incoming: Incoming,
    state: *mut S,
    handler: fn!(Request, &mut S) -> Response $ R,
) -> Result[void, ServerError] $ R:
    message := match request_from_wire(incoming.request):
        .Ok(message) => message
        .Err(error) =>
            server.finish(incoming.id, false)
            return .Err(.Other("$error"))
    cleanup := box(CleanupState { abandoned: false })
    client := server.client(incoming.id)
    clock := server.clock(incoming.id)
    console := server.console(incoming.id)
    let job: mut Suspend[Result[Response, TimedOut]] = $.with(
        Http=client,
        Clock=clock,
        Console=console,
    ):
        apply(
            timeout(s(20), cleanup=ms(100)),
            work=fn!() -> Result[Response, TimedOut] $ R: .Ok(handler!(message, state))
            ,
        )
    using! lease = Lease { server: server, id: incoming.id, job: job, state: cleanup }
    end := race!(cancellation(server, incoming.id), response(job, cleanup))
    match end:
        .Cancelled => .Ok(())
        .Response(value) =>
            wire := response_to_wire(&value).map_err(fn(error): ServerError.Other("$error"))?
            match server.respond!(incoming.id, wire):
                .Err(.Expired) => .Ok(())
                result => result

fn worker![S, $ R](
    state: *mut S,
    handler: fn!(Request, &mut S) -> Response $ R,
) -> Result[void, ServerError] $ R + HttpServer:
    let server: *mut dyn HttpServer = $.use(HttpServer)
    while true:
        incoming := match server.accept!()?:
            .Some(incoming) => incoming
            .None => return .Ok(())
        request!(server, incoming, state, handler)?

pub fn serve![S, $ R](
    workers: usize,
    state: *mut S,
    handler: fn!(Request, &mut S) -> Response $ R,
) -> Result[void, ServerError] $ R + HttpServer:
    width := if workers < 1: 1 else: workers
    let mut slots: List[usize] = []
    for slot in 0..width:
        slots.push(slot)
    results := map_all!(
        slots,
        width,
        fn!(_slot: usize) -> Result[void, ServerError] $ R + HttpServer: worker!(state, handler)
        ,
    )
    for result in results:
        result?
    .Ok(())
