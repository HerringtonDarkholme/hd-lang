# std.json: the untyped JSON value, its parser, and its writers, and
# typed JSON over the `std.serde` opt-in: `to_json`, `from_json`,
# `encode`, `encode_pretty`, and `decode` (spec/std/json.md).
use std.format.DebugWriter
use std.error.Error
use std.num.parse_f64
use std.serde.{Serialize, Deserialize, Serializer, Deserializer, ValueKind}
use std.structure.{VariantInfo, Member, Facts}

# One JSON value (r-std-json.value.decl). An object keeps its members in
# insertion order (r-std-json.object.order).
## A JSON value: `null`, `Bool`, `Number`, `Text`, `Array`, or `Object`.
## See [std-json.value.decl](../../spec/std/json.md#r-std-json.value.decl).
@derive(Debug, Eq)
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: Number)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: JsonObject)

# The members of a JSON object (r-std-json.object.decl-struct): `entries` holds them
# in insertion order. An object of up to 8 members finds a key by comparing
# it with each; a larger one also keeps `index`, which maps each key to its
# place in `entries`, so a lookup does not scan.
## The members of a JSON object, in insertion order.
## See [std-json.object.decl-struct](../../spec/std/json.md#r-std-json.object.decl-struct).
pub struct JsonObject:
    entries: List[(string, Json)]
    index: Map[string, usize]

impl JsonObject:
    ## Returns an object with no members.
    ## See [std-json.object.new-value](../../spec/std/json.md#r-std-json.object.new-value).
    pub fn new() -> JsonObject:
        JsonObject { entries: [], index: {} }

    ## Returns the number of members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn len(self) -> usize:
        self.entries.len()

    ## True exactly when the object has no members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn is_empty(self) -> bool:
        self.entries.len() == 0

    ## The value of `key`, or `.None` when the object has no such key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn get(self, key: string) -> Json?:
        match self.position(key):
            .Some(at) => .Some(self.entries[at]._1)
            .None => .None

    ## True exactly when the object has the key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn contains_key(self, key: string) -> bool:
        self.position(key).is_some()

    ## Sets `key` to `value`. A new key goes last, and an existing key keeps its place.
    ## See [std-json.object.set-ref](../../spec/std/json.md#r-std-json.object.set-ref).
    pub fn set(&mut self, key: string, value: Json) -> void:
        match self.position(key):
            .Some(at) => self.entries[at] = (key, value)
            .None =>
                count := self.entries.len()
                self.entries.push((key, value))
                if self.index.len() > 0:
                    self.index[key] = count
                else if count >= 8:
                    let at: usize = 0
                    while at <= count:
                        self.index[self.entries[at]._0] = at
                        at = at + 1

    ## Removes `key` and returns its value, or `.None` when the object has no such key. The other members keep their order.
    ## See [std-json.object.remove-ref](../../spec/std/json.md#r-std-json.object.remove-ref).
    pub fn remove(&mut self, key: string) -> Json?:
        match self.position(key):
            .None => .None
            .Some(at) =>
                removed := self.entries.remove_at(at)
                if self.index.len() > 0:
                    _ := self.index.remove(key)
                    size := self.entries.len()
                    let later: usize = at
                    while later < size:
                        self.index[self.entries[later]._0] = later
                        later = later + 1
                .Some(removed._1)

    # The place of `key` in `entries`. `index` is empty until it is kept.
    fn position(&self, key: string) -> usize?:
        if self.index.len() > 0:
            return self.index.get(key)
        size := self.entries.len()
        let at: usize = 0
        while at < size:
            if self.entries[at]._0 == key:
                return .Some(at)
            at = at + 1
        .None

    ## The keys, in insertion order.
    ## See [std-json.object.order](../../spec/std/json.md#r-std-json.object.order).
    pub fn keys(self) -> List[string]:
        self.entries.map(fn(entry: (string, Json)) -> string: entry._0)

impl Iterable[(string, Json)] for JsonObject:
    fn iter(self) -> &mut Iterator[(string, Json)]:
        self.entries.iter()

# The same members, in any order (r-std-json.value.eq.object).
# Keep handwritten Eq: compare keys and values, independent of entry order.
impl Eq for JsonObject:
    fn eq(self, other: JsonObject) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in self.entries:
            match other.get(key):
                .Some(found) =>
                    if found != value:
                        return false
                .None => return false
        true

# What a `Number` holds: an integer below zero, an integer from zero up, or
# a finite float. Normalized, so one integer has one representation
# (r-std-json.number.repr).
@derive(Eq)
enum NumberRepr:
    Negative(value: i64)
    NonNegative(value: u64)
    Float(value: f64)

# A JSON number that keeps 64-bit integers exact, modeled on
# `serde_json::Number` (r-std-json.number.decl-struct).
## A JSON number, exact for 64-bit integers: integers in the `i64` and `u64` ranges are exact, and every other number is an `f64`.
## See [std-json.number.decl-struct](../../spec/std/json.md#r-std-json.number.decl-struct).
@derive(Eq)
pub struct Number:
    repr: NumberRepr

impl Number:
    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.i64](../../spec/std/json.md#r-std-json.number.constructors.i64).
    pub fn from_i64(value: i64) -> Number:
        if value < 0:
            return Number { repr: NumberRepr.Negative(value) }
        Number { repr: NumberRepr.NonNegative(u64(value)) }

    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.u64](../../spec/std/json.md#r-std-json.number.constructors.u64).
    pub fn from_u64(value: u64) -> Number:
        Number { repr: NumberRepr.NonNegative(value) }

    ## Returns the float `value` as a `Number`, or `.None` for a NaN or an infinity.
    ## See [std-json.number.constructors.f64](../../spec/std/json.md#r-std-json.number.constructors.f64).
    pub fn from_f64(value: f64) -> Number?:
        if !value.is_finite():
            return .None
        .Some(Number { repr: NumberRepr.Float(value) })

    ## The integer when it is in the `i64` range, and `.None` for a float.
    ## See [std-json.number.accessors.i64](../../spec/std/json.md#r-std-json.number.accessors.i64).
    pub fn as_i64(self) -> i64?:
        match self.repr:
            .Negative(value) => .Some(value)
            .NonNegative(value) =>
                if value < sign_limit():
                    .Some(i64(value))
                else:
                    .None
            .Float(_) => .None

    ## The integer when it is from zero up, and `.None` for a negative integer or a float.
    ## See [std-json.number.accessors.u64](../../spec/std/json.md#r-std-json.number.accessors.u64).
    pub fn as_u64(self) -> u64?:
        match self.repr:
            .NonNegative(value) => .Some(value)
            _ => .None

    ## `.Some` of the float, or of the integer converted to the nearest `f64`.
    ## See [std-json.number.accessors.f64](../../spec/std/json.md#r-std-json.number.accessors.f64).
    pub fn as_f64(self) -> f64?:
        match self.repr:
            .Negative(value) => .Some(f64(value))
            .NonNegative(value) => .Some(f64(value))
            .Float(value) => .Some(value)

# Keep handwritten Display: render the represented number without its private enum wrapper.
impl Display for Number:
    fn to_string(self) -> string:
        match self.repr:
            .Negative(value) => "$value"
            .NonNegative(value) => "$value"
            .Float(value) => "$value"

impl Json:
    # JSON text with two-space indentation (r-std-json.value.pretty).
    ## The pretty text of the value: each item of an array and each entry of an object on its own line, indented by two spaces for each level of nesting.
    ## See [std-json.value.pretty](../../spec/std/json.md#r-std-json.value.pretty).
    pub fn pretty(self) -> string:
        let mut parts: List[string] = []
        render(self, &mut parts, true, 0)
        concat_all(parts)

    ## The value of `key` when the value is an `Object` with that key.
    ## See [std-json.value.accessors.get](../../spec/std/json.md#r-std-json.value.accessors.get).
    pub fn get(self, key: string) -> Json?:
        match self:
            .Object(fields) => fields.get(key)
            _ => .None

    ## The item at `index` when the value is an `Array` and `index` is from 0 up to its length.
    ## See [std-json.value.accessors.at-index](../../spec/std/json.md#r-std-json.value.accessors.at-index).
    pub fn at(self, index: usize) -> Json?:
        match self:
            .Array(items) =>
                if index < items.len():
                    .Some(items[index])
                else:
                    .None
            _ => .None

    ## The string of a `Text` value.
    ## See [std-json.value.accessors.text](../../spec/std/json.md#r-std-json.value.accessors.text).
    pub fn as_text(self) -> string?:
        match self:
            .Text(value) => .Some(value)
            _ => .None

    ## The value of a `Bool`.
    ## See [std-json.value.accessors.bool](../../spec/std/json.md#r-std-json.value.accessors.bool).
    pub fn as_bool(self) -> bool?:
        match self:
            .Bool(value) => .Some(value)
            _ => .None

    ## `true` exactly for `Null`.
    ## See [std-json.value.accessors.null](../../spec/std/json.md#r-std-json.value.accessors.null).
    pub fn is_null(self) -> bool:
        match self:
            .Null => true
            _ => false

    ## The integer of a `Number` that is an integer in the `i64` range; a float, even `1.0`, gives `.None`.
    ## See [std-json.value.accessors.i64](../../spec/std/json.md#r-std-json.value.accessors.i64).
    pub fn as_i64(self) -> i64?:
        match self:
            .Number(value) => value.as_i64()
            _ => .None

    ## The integer of a `Number` that is an integer from zero up in the `u64` range; a float gives `.None`.
    ## See [std-json.value.accessors.u64](../../spec/std/json.md#r-std-json.value.accessors.u64).
    pub fn as_u64(self) -> u64?:
        match self:
            .Number(value) => value.as_u64()
            _ => .None

    ## The `f64` of any `Number`, an integer converted to the nearest `f64`.
    ## See [std-json.value.accessors.f64](../../spec/std/json.md#r-std-json.value.accessors.f64).
    pub fn as_f64(self) -> f64?:
        match self:
            .Number(value) => value.as_f64()
            _ => .None

    # RFC 6901: `""` is the value itself, and every other pointer is `/`
    # and a token for each step (r-std-json.pointer.syntax). A token is cut
    # at the next `/` and decoded at once; `/` and `~` are ASCII, so every
    # cut is on a scalar boundary.
    ## The value at the JSON Pointer `path` (RFC 6901), such as `/db/pool/0`, or `.None` when no value is there.
    ## See [std-json.pointer](../../spec/std/json.md#r-std-json.pointer).
    pub fn pointer(self, path: string) -> Json?:
        size := bytes_len(path)
        if size == 0:
            return .Some(self)
        if bytes_at(path, 0) != 47:
            return .None
        let current = self
        let start: usize = 1
        while start <= size:
            let end = start
            while end < size && bytes_at(path, end) != 47:
                end = end + 1
            match pointer_step(current, pointer_token(path, start, end)):
                .Some(next) => current = next
                .None => return .None
            start = end + 1
        .Some(current)

# One pointer step: an object's member named `token`, or an array's item
# at the index `token` writes (r-std-json.pointer.step).
fn pointer_step(value: Json, token: string) -> Json?:
    match value:
        .Object(fields) => fields.get(token)
        .Array(items) =>
            match pointer_index(token, items.len()):
                .Some(index) => .Some(items[index])
                .None => .None
        _ => .None

# The index that `token` writes when it is below `len`: base-ten digits,
# with no sign and no leading zero (r-std-json.pointer.index).
fn pointer_index(token: string, len: usize) -> usize?:
    size := bytes_len(token)
    if size == 0 || (size > 1 && bytes_at(token, 0) == 48):
        return .None
    let value: usize = 0
    let at: usize = 0
    while at < size:
        byte := bytes_at(token, at)
        if byte < 48 || byte > 57:
            return .None
        value = value * 10 + usize(byte - 48)
        if value >= len:
            return .None
        at = at + 1
    .Some(value)

# The token from `start` up to `end` of `path`, with `~1` read as `/` and
# `~0` as `~`; any other `~` stays as written (r-std-json.pointer.escapes).
fn pointer_token(path: string, start: usize, end: usize) -> string:
    let mut parts: List[string] = []
    let plain = start
    let at = start
    while at + 1 < end:
        if bytes_at(path, at) == 126:
            next := bytes_at(path, at + 1)
            if next == 48 || next == 49:
                if at > plain:
                    parts.push(bytes_slice(path, plain, at))
                parts.push(if next == 48: "~" else: "/")
                at = at + 2
                plain = at
                continue
        at = at + 1
    if parts.len() == 0:
        return bytes_slice(path, start, end)
    if plain < end:
        parts.push(bytes_slice(path, plain, end))
    concat_all(parts)

# Compact JSON text (r-std-json.display.compact).
# Keep handwritten Display: render JSON syntax rather than an Error message.
impl Display for Json:
    fn to_string(self) -> string:
        let mut parts: List[string] = []
        render(self, &mut parts, false, 0)
        concat_all(parts)

# The text is collected as pieces and joined once. Every piece is valid
# UTF-8 (a literal, a number's text, or a run of a string cut next to an
# ASCII byte), so the joined text needs no check.
fn render(value: Json, parts: &mut List[string], spaced: bool, depth: usize) -> void:
    match value:
        .Null => parts.push("null")
        .Bool(flag) => parts.push(if flag: "true" else: "false")
        .Number(number) => parts.push("$number")
        .Text(text) => push_quoted(parts, text)
        .Array(items) =>
            if items.len() == 0:
                parts.push("[]")
                return
            parts.push("[")
            let first = true
            for item in items:
                if !first:
                    parts.push(",")
                first = false
                line_break(parts, spaced, depth + 1)
                render(item, parts, spaced, depth + 1)
            line_break(parts, spaced, depth)
            parts.push("]")
        .Object(fields) =>
            if fields.len() == 0:
                parts.push("{}")
                return
            parts.push("{")
            let first = true
            for entry in fields:
                if !first:
                    parts.push(",")
                first = false
                line_break(parts, spaced, depth + 1)
                push_quoted(parts, entry._0)
                parts.push(if spaced: ": " else: ":")
                render(entry._1, parts, spaced, depth + 1)
            line_break(parts, spaced, depth)
            parts.push("}")

fn line_break(parts: &mut List[string], spaced: bool, depth: usize) -> void:
    if !spaced:
        return
    parts.push("\n")
    if depth > 0:
        parts.push("  ".repeat(depth))

fn push_quoted(parts: &mut List[string], text: string) -> void:
    parts.push("\"")
    push_escaped(parts, text)
    parts.push("\"")

# The inside of a quoted string: `"` and `\` escaped, the control
# characters below U+0020 as `\b`, `\f`, `\n`, `\r`, `\t`, or `\u00XX` with
# lowercase hex, and every other scalar value as itself
# (r-std-json.display.text). Each run of bytes that needs no escape goes in
# whole, as a slice that shares the string's bytes; an escaped byte is
# ASCII, so every run starts and ends on a scalar boundary.
fn push_escaped(parts: &mut List[string], text: string) -> void:
    size := bytes_len(text)
    let plain: usize = 0
    let index: usize = 0
    while index < size:
        byte := bytes_at(text, index)
        if byte >= 32 && byte != 34 && byte != 92:
            index = index + 1
            continue
        if index > plain:
            parts.push(bytes_slice(text, plain, index))
        parts.push(escape_text(byte))
        index = index + 1
        plain = index
    if plain == 0:
        if size > 0:
            parts.push(text)
    else if plain < size:
        parts.push(bytes_slice(text, plain, size))

fn escape_text(byte: u8) -> string:
    match byte:
        34 => "\\\""
        92 => "\\\\"
        8 => "\\b"
        12 => "\\f"
        10 => "\\n"
        13 => "\\r"
        9 => "\\t"
        _ =>
            let mut bytes: List[u8] = [92, 117, 48, 48]
            bytes.push(hex_symbol(byte >> 4))
            bytes.push(hex_symbol(byte & 15))
            string_from_bytes(bytes)

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

# Why parsing failed, at a byte offset into the text (r-std-json.error.position-bytes), or why
# decoding failed, at a path such as `$.users[2].name`
# (r-std-json.error.variants).
## The error that `parse` and `decode` return: seven parse errors at a byte position, and three decode errors at a path.
## See [std-json.error.variants](../../spec/std/json.md#r-std-json.error.variants).
@error
@derive(Debug, Eq)
pub enum JsonError:
    # The text stops inside a value; `position` is its length.
    @error("unexpected end of text at position $position")
    UnexpectedEnd(position: usize)
    # A character the grammar does not allow there.
    @error("unexpected character at position $position")
    UnexpectedCharacter(position: usize)
    # A bad escape; `position` is its backslash.
    @error("invalid escape at position $position")
    InvalidEscape(position: usize)
    # A `\u` surrogate with no partner; `position` is its backslash.
    @error("lone surrogate escape at position $position")
    LoneSurrogate(position: usize)
    # A raw control character inside a string.
    @error("control character in a string at position $position")
    ControlCharacter(position: usize)
    # A number past the finite f64 range; `position` is its first character.
    @error("number out of range at position $position")
    NumberOutOfRange(position: usize)
    # An array or object nested deeper than 128 levels; `position` is its
    # opening bracket.
    @error("nesting too deep at position $position")
    NestingTooDeep(position: usize)
    # A value of the wrong kind, or a number out of the type's range;
    # `expected` names what the decoder reads (r-std-json.error.kind.type).
    @error("expected $expected at $path")
    WrongType(path: string, expected: string)
    # An object without a key that its type needs.
    @error("missing field at $path")
    MissingField(path: string)
    # A variant name that the enum does not declare.
    @error("unknown variant \"$name\" at $path")
    UnknownVariant(path: string, name: string)

# Strict RFC 8259 text to a `Json` (r-std-json.parse).
## Reads one JSON text, strictly as RFC 8259 defines it, and returns `.Ok` of the value or `.Err` of the first error.
## See [std-json.parse](../../spec/std/json.md#r-std-json.parse).
pub fn parse(text: string) -> Result[Json, JsonError]:
    parser := &mut Parser { text: text, size: bytes_len(text), at: 0 }
    value := parser.value(0)?
    parser.skip_space()
    if parser.at < parser.size:
        return .Err(JsonError.UnexpectedCharacter(parser.at))
    .Ok(value)

# A recursive descent over the input's own bytes, read through `bytes_at`;
# `at` is the offset of the next byte to read. A string with no escape is
# a slice of the input, which shares its bytes: the input is a valid string
# and the slice starts and ends next to a quote, so it needs no check.
struct Parser:
    text: string
    size: usize
    at: usize

impl Parser:
    # The error for a byte that cannot continue the text at `offset`.
    fn unexpected(&self, offset: usize) -> JsonError:
        if offset >= self.size:
            return JsonError.UnexpectedEnd(offset)
        JsonError.UnexpectedCharacter(offset)

    fn skip_space(&mut self) -> void:
        text := self.text
        size := self.size
        let index = self.at
        while index < size:
            byte := bytes_at(text, index)
            if byte != 32 && byte != 9 && byte != 10 && byte != 13:
                break
            index = index + 1
        self.at = index

    # The value after any whitespace at `at`.
    fn value(&mut self, depth: usize) -> Result[Json, JsonError]:
        self.skip_space()
        index := self.at
        if index >= self.size:
            return .Err(JsonError.UnexpectedEnd(index))
        byte := bytes_at(self.text, index)
        if byte == 34:
            return .Ok(Json.Text(self.string()?))
        if byte == 123:
            return self.object(depth)
        if byte == 91:
            return self.array(depth)
        if byte == 116:
            return self.word("true", Json.Bool(true))
        if byte == 102:
            return self.word("false", Json.Bool(false))
        if byte == 110:
            return self.word("null", Json.Null)
        if byte == 45 || (byte >= 48 && byte <= 57):
            return self.number()
        .Err(JsonError.UnexpectedCharacter(index))

    fn word(&mut self, word: string, value: Json) -> Result[Json, JsonError]:
        text := self.text
        size := bytes_len(word)
        let index = self.at
        let offset: usize = 0
        while offset < size:
            if index >= self.size || bytes_at(text, index) != bytes_at(word, offset):
                return .Err(self.unexpected(index))
            index = index + 1
            offset = offset + 1
        self.at = index
        .Ok(value)

    # The array whose `[` is at `at`.
    fn array(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut items: List[Json] = []
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 93:
            self.at = self.at + 1
            return .Ok(Json.Array(items))
        while true:
            items.push(self.value(depth + 1)?)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    continue
                if byte == 93:
                    self.at = index + 1
                    return .Ok(Json.Array(items))
            return .Err(self.unexpected(index))

    # The object whose `{` is at `at`.
    fn object(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut fields = JsonObject::new()
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 125:
            self.at = self.at + 1
            return .Ok(Json.Object(fields))
        while true:
            quote := self.at
            if quote >= self.size || bytes_at(self.text, quote) != 34:
                return .Err(self.unexpected(quote))
            key := self.string()?
            self.skip_space()
            colon := self.at
            if colon >= self.size || bytes_at(self.text, colon) != 58:
                return .Err(self.unexpected(colon))
            self.at = colon + 1
            found := self.value(depth + 1)?
            fields.set(key, found)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    self.skip_space()
                    continue
                if byte == 125:
                    self.at = index + 1
                    return .Ok(Json.Object(fields))
            return .Err(self.unexpected(index))

    # The string whose opening quote is at `at`: a slice of the input when
    # it has no escape.
    fn string(&mut self) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        start := self.at + 1
        let index = start
        while index < size:
            byte := bytes_at(text, index)
            if byte == 34:
                self.at = index + 1
                return .Ok(bytes_slice(text, start, index))
            if byte == 92:
                return self.escaped(start, index)
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            index = index + 1
        .Err(JsonError.UnexpectedEnd(index))

    # The rest of a string that starts at `start` and has its first escape
    # at `index`. Each run between escapes is a slice of the input, each
    # escape the text it stands for, and the pieces are joined once.
    fn escaped(&mut self, start: usize, first: usize) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        let mut parts: List[string] = []
        let plain = start
        let index = first
        while true:
            if index >= size:
                return .Err(JsonError.UnexpectedEnd(index))
            byte := bytes_at(text, index)
            if byte == 34:
                if index > plain:
                    parts.push(bytes_slice(text, plain, index))
                self.at = index + 1
                return .Ok(concat_all(parts))
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            if byte != 92:
                index = index + 1
                continue
            if index > plain:
                parts.push(bytes_slice(text, plain, index))
            backslash := index
            if index + 1 >= size:
                return .Err(JsonError.UnexpectedEnd(index + 1))
            escaped := bytes_at(text, index + 1)
            index = index + 2
            if escaped == 34:
                parts.push("\"")
            else if escaped == 92:
                parts.push("\\")
            else if escaped == 47:
                parts.push("/")
            else if escaped == 98:
                parts.push("\u{8}")
            else if escaped == 102:
                parts.push("\u{c}")
            else if escaped == 110:
                parts.push("\n")
            else if escaped == 114:
                parts.push("\r")
            else if escaped == 116:
                parts.push("\t")
            else if escaped == 117:
                unit := self.hex4(index)
                if unit == -2:
                    return .Err(JsonError.UnexpectedEnd(size))
                if unit < 0:
                    return .Err(JsonError.InvalidEscape(backslash))
                index = index + 4
                let point = unit
                if unit >= 56320 && unit <= 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                if unit >= 55296 && unit <= 56319:
                    low := if index + 1 < size && bytes_at(text, index) == 92 && bytes_at(text, index + 1) == 117: self.hex4(index + 2) else: -1
                    if low < 56320 || low > 57343:
                        return .Err(JsonError.LoneSurrogate(backslash))
                    point = 65536 + (unit - 55296) * 1024 + (low - 56320)
                    index = index + 6
                parts.push(scalar_text(point))
            else:
                return .Err(JsonError.InvalidEscape(backslash))
            plain = index

    # The value of the four hex digits at `at`, -1 when one is not a hex
    # digit, or -2 when the text ends first.
    fn hex4(&self, at: usize) -> i32:
        let value: i32 = 0
        let offset: usize = 0
        while offset < 4:
            if at + offset >= self.size:
                return -2
            digit := hex_value(i32(bytes_at(self.text, at + offset)))
            if digit < 0:
                return -1
            value = value * 16 + digit
            offset = offset + 1
        value

    # The number that starts at `at`: `-`? then `0` or a nonzero digit and
    # digits. An integer in the i64 or u64 range is exact; `-0` is the float
    # -0.0, as in serde_json. A fraction, an exponent, or an integer past
    # both ranges is the float that `parse_f64` gives
    # (r-std-json.parse.number.float).
    fn number(&mut self) -> Result[Json, JsonError]:
        text := self.text
        size := self.size
        start := self.at
        let index = start
        negative := bytes_at(text, index) == 45
        if negative:
            index = index + 1
        if index >= size:
            return .Err(self.unexpected(index))
        let magnitude: u64 = 0
        let overflow = false
        first := bytes_at(text, index)
        if first == 48:
            index = index + 1
        else if first >= 49 && first <= 57:
            while index < size && is_digit(bytes_at(text, index)):
                digit := u64(bytes_at(text, index) - 48)
                if magnitude > (u64_max() - digit) / 10:
                    overflow = true
                else:
                    magnitude = magnitude * 10 + digit
                index = index + 1
        else:
            return .Err(self.unexpected(index))
        let exotic = false
        if index < size && bytes_at(text, index) == 46:
            index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(text, index)):
                index = index + 1
            exotic = true
        if index < size && (bytes_at(text, index) == 101 || bytes_at(text, index) == 69):
            index = index + 1
            if index < size && (bytes_at(text, index) == 43 || bytes_at(text, index) == 45):
                index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(text, index)):
                index = index + 1
            exotic = true
        self.at = index
        if exotic || overflow || (negative && magnitude > sign_limit()):
            return float_number(text, start, index)
        if !negative:
            return .Ok(Json.Number(Number::from_u64(magnitude)))
        if magnitude == 0:
            match Number::from_f64(-0.0):
                .Some(zero) => return .Ok(Json.Number(zero))
                .None => return float_number(text, start, index)
        if magnitude == sign_limit():
            return .Ok(Json.Number(Number::from_i64(-9223372036854775808)))
        .Ok(Json.Number(Number::from_i64(-i64(magnitude))))

fn is_digit(byte: u8) -> bool:
    byte >= 48 && byte <= 57

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        return code - 48
    if code >= 97 && code <= 102:
        return code - 87
    if code >= 65 && code <= 70:
        return code - 55
    -1

# The UTF-8 text of a scalar value, which is never a surrogate.
fn scalar_text(point: i32) -> string:
    let mut out: List[u8] = []
    if point < 128:
        out.push(u8(point))
    else if point < 2048:
        out.push(u8(192 + (point >> 6)))
        out.push(u8(128 + (point & 63)))
    else if point < 65536:
        out.push(u8(224 + (point >> 12)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    else:
        out.push(u8(240 + (point >> 18)))
        out.push(u8(128 + ((point >> 12) & 63)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    string_from_bytes(out)

# 2^63, the first u64 past the i64 range, and the largest u64.
fn sign_limit() -> u64:
    9223372036854775808

fn u64_max() -> u64:
    18446744073709551615

# The float of the number text from `start` up to `end`, which the caller
# has read to the end of its grammar; past the f64 range it is a
# `NumberOutOfRange` at `start` (r-std-json.parse.number.out-of-range).
fn float_number(text: string, start: usize, end: usize) -> Result[Json, JsonError]:
    value := match parse_f64(bytes_slice(text, start, end)):
        .Ok(found) => found
        .Err(_) => panic("std.json: a JSON number is parse_f64 text")
    match Number::from_f64(value):
        .Some(number) => .Ok(Json.Number(number))
        .None => .Err(JsonError.NumberOutOfRange(start))

# Keep handwritten Debug: hide the representation variant behind Number(value).
impl Debug for Number:
    fn debug(self, out: &mut DebugWriter) -> void:
        match self.repr:
            .Negative(value) => out.debug_tuple("Number").field(value).finish()
            .NonNegative(value) => out.debug_tuple("Number").field(value).finish()
            .Float(value) => out.debug_tuple("Number").field(value).finish()

# One `debug_list` entry per member, in insertion order.
# Keep handwritten Debug: render entries as a list rather than storage fields.
impl Debug for JsonObject:
    fn debug(self, out: &mut DebugWriter) -> void:
        list := out.debug_list()
        for entry in self.entries:
            _ := list.entry(entry)
        list.finish()

# ---------------------------------------------------------------------------
# Typed JSON (spec/std/json.md#typed-json): JSON as a format that reads the
# `std.serde` opt-in. `to_json` writes a value through `JsonWriter`,
# `encode` writes its text through `TextWriter`, and `from_json` reads one
# through `JsonReader`.

# The `Json` of a value (r-std-json.to-json).
## The `Json` that `value`'s `serialize` writes.
## See [std-json.to-json](../../spec/std/json.md#r-std-json.to-json).
pub fn to_json[T < Serialize](value: T) -> Json:
    writer := &mut JsonWriter { result: Json.Null, pending: "", keys: [], values: [], frames: [] }
    match value.serialize(writer):
        .Ok(_) => writer.result
        .Err(_) => panic("std.json: the JSON writer never fails")

# The value that a `Json` describes, or the first decode error
# (r-std-json.from-json).
## The `T` that `T::deserialize` reads from `value`, or the first error it finds.
## See [std-json.from-json](../../spec/std/json.md#r-std-json.from-json).
pub fn from_json[T < Deserialize](value: Json) -> Result[T, JsonError]:
    reader := JsonReader::new(value)
    T::deserialize(reader)

# The compact text of a value's `Json` (r-std-json.encode). `TextWriter`
# writes that text during the walk, with no `Json` in between; a walk it
# does not write directly goes through the tree, which defines the text.
## The compact JSON text of `value`, with no whitespace outside strings.
## See [std-json.encode](../../spec/std/json.md#r-std-json.encode).
pub fn encode[T < Serialize](value: T) -> string:
    writer := TextWriter::new(false)
    _ := value.serialize(writer)
    match writer.finish():
        .Some(text) => text
        .None => "${to_json(value)}"

# The pretty text of a value's `Json` (r-std-json.encode-pretty), written
# by `TextWriter` in its spaced layout, or through the tree as `encode`
# falls back.
## The pretty JSON text of `value`: `to_json(value).pretty()`.
## See [std-json.encode-pretty](../../spec/std/json.md#r-std-json.encode-pretty).
pub fn encode_pretty[T < Serialize](value: T) -> string:
    writer := TextWriter::new(true)
    _ := value.serialize(writer)
    match writer.finish():
        .Some(text) => text
        .None => to_json(value).pretty()

# `parse`, then `from_json` (r-std-json.decode).
## `parse(text)`, then `from_json` of the parsed value.
## See [std-json.decode](../../spec/std/json.md#r-std-json.decode).
pub fn decode[T < Deserialize](text: string) -> Result[T, JsonError]:
    value := parse(text)?
    from_json::[T](value)

# `Json` writes and reads itself (r-std-json.std.json).
# Keep handwritten Serialize: write the JSON value itself, not an externally tagged enum.
impl Serialize for Json:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        match self:
            .Null => out.null()
            .Bool(flag) => out.bool(flag)
            .Number(number) =>
                match number.repr:
                    .Negative(found) => out.int(found)
                    .NonNegative(found) => out.uint(found)
                    .Float(found) => out.float(found)
            .Text(text) => out.text(text)
            .Array(items) =>
                out.begin_list(items.len())?
                for item in items:
                    item.serialize(out)?
                out.end_list()
            .Object(fields) =>
                out.begin_map(fields.len())?
                for entry in fields:
                    out.key(entry._0)?
                    entry._1.serialize(out)?
                out.end_map()

# Keep handwritten Deserialize: read the JSON value itself, not an externally tagged enum.
impl Deserialize for Json:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Json, R::Error]:
        match input.peek()?:
            .Null =>
                _ := input.is_null()?
                .Ok(Json.Null)
            .Bool => .Ok(Json.Bool(input.bool("bool")?))
            .Int => .Ok(Json.Number(Number::from_i64(input.int("i64")?)))
            .Uint => .Ok(Json.Number(Number::from_u64(input.uint("u64")?)))
            .Float =>
                found := input.float("f64")?
                match Number::from_f64(found):
                    .Some(number) => .Ok(Json.Number(number))
                    .None => .Ok(Json.Null)
            .Text => .Ok(Json.Text(input.text("string")?))
            .List =>
                input.begin_list()?
                let mut items: List[Json] = []
                while input.next_item()?:
                    items.push(Json::deserialize(input)?)
                .Ok(Json.Array(items))
            .Map =>
                input.begin_map()?
                let mut fields = JsonObject::new()
                while true:
                    match input.next_key()?:
                        .Some(key) => fields.set(key, Json::deserialize(input)?)
                        .None => break
                .Ok(Json.Object(fields))

# One open list, map, or variant of the writer: its kind, where its items
# start in `values`, the key it goes under in its own container, and a
# variant's name and form.
struct OpenFrame:
    pub kind: i32
    pub start: usize
    pub key: string
    pub name: string
    pub of_data: bool

# Builds the `Json` of one value. The items of every open container sit on
# one stack, `values`, each beside its key in `keys`; closing a container
# replaces its items with its value (r-std-json.derive.to-json.data).
struct JsonWriter:
    pub result: Json
    pub pending: string
    pub keys: List[string]
    pub values: List[Json]
    pub frames: List[OpenFrame]

impl JsonWriter:
    fn put(&mut self, value: Json) -> Result[void, never]:
        if self.frames.len() == 0:
            self.result = value
        else:
            self.keys.push(self.pending)
            self.values.push(value)
        .Ok(())

    fn open(&mut self, kind: i32, name: string, of_data: bool) -> Result[void, never]:
        self.frames.push(OpenFrame { kind: kind, start: self.values.len(), key: self.pending, name: name, of_data: of_data })
        .Ok(())

    # The innermost frame, its items, and its keys, popped.
    fn close(&mut self) -> (OpenFrame, List[string], List[Json]):
        frame := match self.frames.pop():
            .Some(found) => found
            .None => panic("std.json: a close without an open container")
        let mut keys: List[string] = []
        let mut values: List[Json] = []
        let index = frame.start
        while index < self.values.len():
            keys.push(self.keys[index])
            values.push(self.values[index])
            index = index + 1
        while self.values.len() > frame.start:
            _ := self.values.pop()
            _ := self.keys.pop()
        self.pending = frame.key
        (frame, keys, values)

impl Serializer for JsonWriter:
    type Error = never

    fn null(&mut self) -> Result[void, never]:
        self.put(Json.Null)

    fn bool(&mut self, value: bool) -> Result[void, never]:
        self.put(Json.Bool(value))

    fn int(&mut self, value: i64) -> Result[void, never]:
        self.put(Json.Number(Number::from_i64(value)))

    fn uint(&mut self, value: u64) -> Result[void, never]:
        self.put(Json.Number(Number::from_u64(value)))

    # A NaN or an infinity has no JSON number, so it writes `null`, as in
    # serde_json (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, never]:
        match Number::from_f64(value):
            .Some(number) => self.put(Json.Number(number))
            .None => self.put(Json.Null)

    fn text(&mut self, value: string) -> Result[void, never]:
        self.put(Json.Text(value))

    fn begin_list(&mut self, len: usize) -> Result[void, never]:
        self.open(0, "", false)

    fn end_list(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Array(closed._2))

    fn begin_map(&mut self, len: usize) -> Result[void, never]:
        self.open(1, "", false)

    fn key(&mut self, key: string) -> Result[void, never]:
        self.pending = key
        .Ok(())

    fn end_map(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    fn begin_variant(&mut self, facts: Facts, v: VariantInfo) -> Result[void, never]:
        self.open(2, v.name, v.of_data)

    fn member(&mut self, m: Member) -> Result[void, never]:
        self.pending = m.name
        .Ok(())

    # A data type is an object; a variant with no member is its name, and
    # any other variant `{"Variant": {...}}` (r-std-json.derive.to-json.enum).
    fn end_variant(&mut self) -> Result[void, never]:
        closed := self.close()
        frame := closed._0
        fields := object_of(closed._1, closed._2)
        if frame.of_data:
            return self.put(Json.Object(fields))
        if fields.len() == 0:
            return self.put(Json.Text(frame.name))
        let mut outer = JsonObject::new()
        outer.set(frame.name, Json.Object(fields))
        self.put(Json.Object(outer))

fn object_of(keys: List[string], values: List[Json]) -> JsonObject:
    let mut fields = JsonObject::new()
    let index: usize = 0
    while index < keys.len():
        fields.set(keys[index], values[index])
        index = index + 1
    fields

# What an open container of the text writer is.
enum FrameKind:
    # A list.
    Items
    # A map.
    Entries
    # A data type's object.
    Record
    # An enum variant: its name, or `{"Variant":{...}}`.
    Tagged

# The writer met a walk that it does not write directly.
enum Irregular:
    Walk

# Writes the compact text of the `Json` that `JsonWriter` would build, or
# its pretty text when `spaced` is true, as
# the walk reaches each part, into pieces joined once at the end. It writes
# the walks that derived and standard implementations make: one value, a
# key before each value in an object, every key new in its object, and each
# end matching its begin. Any other walk sets `regular` to false and stops,
# and `encode` builds the tree instead: the tree's rules for a missing,
# stale, or repeated key, or for a second value, are the definition.
#
# The open containers are a stack of `depth` frames in four lists: each
# frame's kind, its variant name, its number of values so far, and where
# its keys start in `keys`. An object's first 16 keys sit in `keys`, with a
# cheap print of each in `prints`; a larger object moves its keys into a
# map on `indexes`. The stacks keep their slots when a frame closes, and
# the next frame reuses them. `indent` is the nesting level of the pretty
# text: a list, a map, or a record adds one, and a variant two, for its
# `{"Variant": {` once a member opens it.
struct TextWriter:
    pub parts: &mut List[string]
    pub depth: usize
    pub kinds: List[FrameKind]
    pub names: List[string]
    pub counts: List[usize]
    pub key_starts: List[usize]
    pub key_count: usize
    pub keys: List[string]
    pub prints: List[usize]
    pub indexes: List[Map[string, bool]]
    pub pending: string
    pub keyed: bool
    pub written: bool
    pub regular: bool
    pub spaced: bool
    pub indent: usize

impl TextWriter:
    fn new(spaced: bool) -> &mut TextWriter:
        &mut TextWriter { parts: &mut [], depth: 0, kinds: [], names: [], counts: [], key_starts: [], key_count: 0, keys: [], prints: [], indexes: [], pending: "", keyed: false, written: false, regular: true, spaced: spaced, indent: 0 }

    # The text, or `.None` when the walk was not regular or not complete.
    fn finish(&self) -> string?:
        if !self.regular || !self.written || self.depth > 0:
            return .None
        .Some(concat_all(*self.parts))

    fn give_up(&mut self) -> Result[void, Irregular]:
        self.regular = false
        .Err(Irregular.Walk)

    # Starts one value: a comma after an earlier item, and in an object the
    # value's key, which must be new there. The first member of an enum
    # variant opens `{"Variant":{` first.
    fn start(&mut self) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0:
            if self.written:
                return self.give_up()
            self.written = true
            return .Ok(())
        last := self.depth - 1
        count := self.counts[last]
        self.counts[last] = count + 1
        kind := self.kinds[last]
        match kind:
            .Items =>
                if count > 0:
                    self.parts.push(",")
                line_break(self.parts, self.spaced, self.indent)
                return .Ok(())
            _ => pass
        if !self.keyed:
            return self.give_up()
        key := self.pending
        self.keyed = false
        if !self.add_key(last, count, key):
            return self.give_up()
        if self.spaced:
            self.spaced_key(kind, count, self.names[last], key)
            return .Ok(())
        if count > 0:
            self.parts.push(",\"")
        else:
            match kind:
                .Tagged =>
                    self.parts.push("{\"")
                    push_escaped(self.parts, self.names[last])
                    self.parts.push("\":{\"")
                _ => self.parts.push("\"")
        push_escaped(self.parts, key)
        self.parts.push("\":")
        .Ok(())

    # The pretty text before a value of an object: a comma after an earlier
    # entry, a line break, and `"key": `. The first member of a variant
    # opens `{`, its name, and `: {` first, each on its own line.
    fn spaced_key(&mut self, kind: FrameKind, count: usize, name: string, key: string) -> void:
        if count > 0:
            self.parts.push(",")
        else:
            match kind:
                .Tagged =>
                    self.parts.push("{")
                    line_break(self.parts, true, self.indent - 1)
                    push_quoted(self.parts, name)
                    self.parts.push(": {")
                _ => pass
        line_break(self.parts, true, self.indent)
        push_quoted(self.parts, key)
        self.parts.push(": ")

    # Whether `key` is new among the `count` keys of the object at `frame`;
    # a new key is recorded. A key is compared with the first 16 by its
    # print, and by its text only when the prints match; from the 17th key
    # on, the object's keys are in a map.
    fn add_key(&mut self, frame: usize, count: usize, key: string) -> bool:
        start := self.key_starts[frame]
        if count < 16:
            print := key_print(key)
            let at: usize = start
            while at < self.key_count:
                if self.prints[at] == print && self.keys[at] == key:
                    return false
                at = at + 1
            if at < self.keys.len():
                self.keys[at] = key
                self.prints[at] = print
            else:
                self.keys.push(key)
                self.prints.push(print)
            self.key_count = at + 1
            return true
        if count == 16:
            let mut index: Map[string, bool] = {}
            let at: usize = start
            while at < self.key_count:
                index[self.keys[at]] = true
                at = at + 1
            self.indexes.push(index)
        last := self.indexes.len() - 1
        before := self.indexes[last].len()
        self.indexes[last][key] = true
        self.indexes[last].len() > before

    fn open(&mut self, kind: FrameKind, name: string) -> Result[void, Irregular]:
        self.start()?
        match kind:
            .Items => self.parts.push("[")
            .Tagged => pass
            _ => self.parts.push("{")
        at := self.depth
        if at < self.kinds.len():
            self.kinds[at] = kind
            self.names[at] = name
            self.counts[at] = 0
            self.key_starts[at] = self.key_count
        else:
            self.kinds.push(kind)
            self.names.push(name)
            self.counts.push(0)
            self.key_starts.push(self.key_count)
        self.depth = at + 1
        self.indent = self.indent + levels_of(kind)
        .Ok(())

    # Ends the innermost frame, which must be of `kind`; `Record` also ends
    # a `Tagged` frame. A variant with no member is its name
    # (r-std-json.derive.to-json.unit).
    fn close(&mut self, kind: FrameKind) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        last := self.depth - 1
        count := self.counts[last]
        open_kind := self.kinds[last]
        let keyed_frame = true
        let spaced = self.spaced && count > 0
        match (kind, open_kind):
            (.Items, .Items) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("]")
                keyed_frame = false
            (.Entries, .Entries) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("}")
            (.Record, .Record) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("}")
            (.Record, .Tagged) =>
                if spaced:
                    line_break(self.parts, true, self.indent - 1)
                    self.parts.push("}")
                    line_break(self.parts, true, self.indent - 2)
                    self.parts.push("}")
                else if count > 0:
                    self.parts.push("}}")
                else:
                    push_quoted(self.parts, self.names[last])
            _ => return self.give_up()
        if keyed_frame && count > 16:
            _ := self.indexes.pop()
        self.key_count = self.key_starts[last]
        self.depth = last
        self.indent = self.indent - levels_of(open_kind)
        .Ok(())

    # A key or a member name names the next value of an object.
    fn name_next(&mut self, key: string) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        match self.kinds[self.depth - 1]:
            .Items => return self.give_up()
            _ => pass
        self.pending = key
        self.keyed = true
        .Ok(())

    fn scalar(&mut self, text: string) -> Result[void, Irregular]:
        self.start()?
        self.parts.push(text)
        .Ok(())

impl Serializer for TextWriter:
    type Error = Irregular

    fn null(&mut self) -> Result[void, Irregular]:
        self.scalar("null")

    fn bool(&mut self, value: bool) -> Result[void, Irregular]:
        self.scalar(if value: "true" else: "false")

    fn int(&mut self, value: i64) -> Result[void, Irregular]:
        self.scalar("$value")

    fn uint(&mut self, value: u64) -> Result[void, Irregular]:
        self.scalar("$value")

    # A NaN or an infinity writes `null` (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, Irregular]:
        if value.is_finite():
            return self.scalar("$value")
        self.scalar("null")

    fn text(&mut self, value: string) -> Result[void, Irregular]:
        self.start()?
        push_quoted(self.parts, value)
        .Ok(())

    fn begin_list(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Items, "")

    fn end_list(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Items)

    fn begin_map(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Entries, "")

    fn key(&mut self, key: string) -> Result[void, Irregular]:
        self.name_next(key)

    fn end_map(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Entries)

    fn begin_variant(&mut self, facts: Facts, v: VariantInfo) -> Result[void, Irregular]:
        self.open(if v.of_data: FrameKind.Record else: FrameKind.Tagged, v.name)

    fn member(&mut self, m: Member) -> Result[void, Irregular]:
        self.name_next(m.name)

    fn end_variant(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Record)

# The nesting levels a frame adds to the pretty text: a variant's
# `{"Variant": {` is two.
fn levels_of(kind: FrameKind) -> usize:
    match kind:
        .Tagged => 2
        _ => 1

# A key's length with its first and last bytes: equal keys have equal
# prints, and most different keys of one object do not.
fn key_print(key: string) -> usize:
    size := bytes_len(key)
    if size == 0:
        return 0
    size * 65536 + usize(bytes_at(key, 0)) * 256 + usize(bytes_at(key, size - 1))

# What an open container of the reader is.
enum ReadKind:
    # A list, read with `next_item`.
    Items
    # A map, read with `next_key`.
    Entries
    # A data type's object, read with `member`.
    Record
    # An enum variant's payload, read with `member`; its path adds `.Variant`.
    Tagged

# Reads one `Json` for `from_json`. `value` is the value at the cursor, and
# `present` is false for a member whose key is missing.
#
# The cursor's path (r-std-json.error.path) is written out only for an
# error. Until then it is its first `depth` steps: step `i` is the item
# index `steps[i]`, or the key `names[i]` when `steps[i]` is -1. The open
# containers are a stack of `open` frames in parallel lists: the container,
# its kind, its next index (for a variant, the member index after the last
# one found), the path depth of its items' container, the depth to restore
# when it closes, and a variant's name. A variant frame's container is the
# payload object, or `null` for a variant written as its name. The stacks
# keep their slots when a frame closes, and the next frame reuses them.
struct JsonReader:
    pub value: Json
    pub present: bool
    pub depth: usize
    pub steps: List[i64]
    pub names: List[string]
    pub open: usize
    pub containers: List[Json]
    pub kinds: List[ReadKind]
    pub next: List[usize]
    pub bases: List[usize]
    pub homes: List[usize]
    pub variants: List[string]

impl JsonReader:
    fn new(value: Json) -> &mut JsonReader:
        &mut JsonReader { value: value, present: true, depth: 0, steps: [], names: [], open: 0, containers: [], kinds: [], next: [], bases: [], homes: [], variants: [] }

    # The path of the first `depth` steps: `$`, then `.key` or `[index]`
    # for each.
    fn path_to(&self, depth: usize) -> string:
        let mut parts: List[string] = ["\$"]
        let index: usize = 0
        while index < depth:
            step := self.steps[index]
            if step < 0:
                parts.push(".")
                parts.push(self.names[index])
            else:
                parts.push("[$step]")
            index = index + 1
        concat_all(parts)

    # A missing key is a `MissingField`; any other value that does not fit
    # is a `WrongType` (r-std-json.derive.from-json.missing).
    fn fail(&self, expected: string) -> JsonError:
        path := self.path_to(self.depth)
        if !self.present:
            return JsonError.MissingField(path)
        JsonError.WrongType(path, expected)

    fn step_index(&mut self, slot: usize, index: usize) -> void:
        if slot < self.steps.len():
            self.steps[slot] = i64(index)
        else:
            self.steps.push(i64(index))
            self.names.push("")

    fn step_key(&mut self, slot: usize, key: string) -> void:
        if slot < self.steps.len():
            self.steps[slot] = -1
            self.names[slot] = key
        else:
            self.steps.push(-1)
            self.names.push(key)

    # Opens a frame whose items' container is at path depth `base`.
    fn enter(&mut self, container: Json, kind: ReadKind, base: usize, name: string) -> void:
        at := self.open
        if at < self.containers.len():
            self.containers[at] = container
            self.kinds[at] = kind
            self.next[at] = 0
            self.bases[at] = base
            self.homes[at] = self.depth
            self.variants[at] = name
        else:
            self.containers.push(container)
            self.kinds.push(kind)
            self.next.push(0)
            self.bases.push(base)
            self.homes.push(self.depth)
            self.variants.push(name)
        self.open = at + 1

    # The innermost frame.
    fn top(&self) -> usize:
        if self.open == 0:
            panic("std.json: no open container")
        self.open - 1

    # Closes the innermost frame; the cursor's path is its container's
    # again.
    fn leave(&mut self) -> void:
        last := self.top()
        self.depth = self.homes[last]
        self.open = last

    # The item, or the map value, at `index` of the frame `last`, with its
    # path step.
    fn read_item(&mut self, last: usize, value: Json, index: usize) -> void:
        self.next[last] = index + 1
        self.value = value
        self.present = true
        base := self.bases[last]
        self.step_index(base, index)
        self.depth = base + 1

    # Moves the cursor to the member called `name` of the variant frame
    # `last`: its value, or absent. A decoder reads the members in
    # declaration order, which is most often the text's, so the entry after
    # the last one found is tried before a search.
    fn find_member(&mut self, last: usize, name: string) -> void:
        match self.containers[last]:
            .Object(fields) =>
                entries := fields.entries
                let at = self.next[last]
                if at >= entries.len() || entries[at]._0 != name:
                    match fields.position(name):
                        .Some(found) => at = found
                        .None =>
                            self.value = Json.Null
                            self.present = false
                            return
                self.next[last] = at + 1
                self.value = entries[at]._1
                self.present = true
            _ =>
                self.value = Json.Null
                self.present = false

impl Deserializer for JsonReader:
    type Error = JsonError

    fn peek(&mut self) -> Result[ValueKind, JsonError]:
        if !self.present:
            return .Ok(ValueKind.Null)
        match self.value:
            .Null => .Ok(ValueKind.Null)
            .Bool(_) => .Ok(ValueKind.Bool)
            .Number(number) =>
                match number.repr:
                    .Negative(_) => .Ok(ValueKind.Int)
                    .NonNegative(found) =>
                        if found < sign_limit():
                            .Ok(ValueKind.Int)
                        else:
                            .Ok(ValueKind.Uint)
                    .Float(_) => .Ok(ValueKind.Float)
            .Text(_) => .Ok(ValueKind.Text)
            .Array(_) => .Ok(ValueKind.List)
            .Object(_) => .Ok(ValueKind.Map)

    # A missing key reads as `null` (r-std-json.derive.from-json.missing).
    fn is_null(&mut self) -> Result[bool, JsonError]:
        .Ok(!self.present || self.value.is_null())

    fn bool(&mut self, expected: string) -> Result[bool, JsonError]:
        if self.present:
            match self.value:
                .Bool(flag) => return .Ok(flag)
                _ => pass
        .Err(self.fail(expected))

    # A float is never an integer (r-std-json.std.integer.read).
    fn int(&mut self, expected: string) -> Result[i64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_i64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn uint(&mut self, expected: string) -> Result[u64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_u64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn float(&mut self, expected: string) -> Result[f64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_f64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn text(&mut self, expected: string) -> Result[string, JsonError]:
        if self.present:
            match self.value:
                .Text(found) => return .Ok(found)
                _ => pass
        .Err(self.fail(expected))

    fn begin_list(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Array(_) =>
                    self.enter(self.value, ReadKind.Items, self.depth, "")
                    return .Ok(())
                _ => pass
        .Err(self.fail("array"))

    # An item's path adds `[index]` (r-std-json.std.item-path). A map's
    # items are its values; a variant has none.
    fn next_item(&mut self) -> Result[bool, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            self.read_item(last, items[index], index)
                            return .Ok(true)
                    _ => pass
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        if index < fields.entries.len():
                            self.read_item(last, fields.entries[index]._1, index)
                            return .Ok(true)
                    _ => pass
            _ => pass
        self.leave()
        .Ok(false)

    fn begin_map(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Object(_) =>
                    self.enter(self.value, ReadKind.Entries, self.depth, "")
                    return .Ok(())
                _ => pass
        .Err(self.fail("object"))

    # A map value's path adds `.key` (r-std-json.std.item-path). A list
    # has no keys, and a variant has none to iterate.
    fn next_key(&mut self) -> Result[string?, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        if index < fields.entries.len():
                            entry := fields.entries[index]
                            self.next[last] = index + 1
                            self.value = entry._1
                            self.present = true
                            base := self.bases[last]
                            self.step_key(base, entry._0)
                            self.depth = base + 1
                            return .Ok(.Some(entry._0))
                    _ => pass
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            panic("std.json: next_key in a list")
                    _ => pass
            _ => pass
        self.leave()
        .Ok(.None)

    # A data type reads an object. An enum reads `"Variant"` as
    # `{"Variant": {}}`, or an object with exactly one key
    # (r-std-json.derive.from-json.enum).
    fn begin_variant(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if choices.len() == 1 && choices[0].of_data:
            if self.present:
                match self.value:
                    .Object(_) =>
                        self.enter(self.value, ReadKind.Record, self.depth, "")
                        return .Ok(0)
                    _ => pass
            return .Err(self.fail("object"))
        if !self.present:
            return .Err(self.fail("variant"))
        let name = ""
        let payload = Json.Null
        let named = false
        match self.value:
            .Text(text) =>
                name = text
                named = true
            .Object(fields) =>
                if fields.len() != 1:
                    return .Err(self.fail("variant"))
                entry := fields.entries[0]
                name = entry._0
                payload = entry._1
            _ => return .Err(self.fail("variant"))
        let index: usize = 0
        while index < choices.len():
            if choices[index].name == name:
                if !named:
                    match payload:
                        .Object(_) => pass
                        _ => return .Err(JsonError.WrongType(concat_all([self.path_to(self.depth), ".", name]), "object"))
                depth := self.depth
                self.step_key(depth, name)
                self.enter(payload, ReadKind.Tagged, depth + 1, name)
                return .Ok(index)
            index = index + 1
        .Err(JsonError.UnknownVariant(self.path_to(self.depth), name))

    # A member reads the value of its key; a missing key is absent
    # (r-std-json.derive.from-json.member). A list or a map has no members.
    fn member(&mut self, m: Member) -> Result[void, JsonError]:
        last := self.top()
        base := self.bases[last]
        match self.kinds[last]:
            .Record => self.find_member(last, m.name)
            .Tagged =>
                self.step_key(base - 1, self.variants[last])
                self.find_member(last, m.name)
            _ =>
                self.value = Json.Null
                self.present = false
        self.step_key(base, m.name)
        self.depth = base + 1
        .Ok(())

    fn end_variant(&mut self) -> Result[void, JsonError]:
        self.leave()
        .Ok(())

    fn invalid(&mut self, expected: string) -> JsonError:
        self.fail(expected)

    # A missing key is absent, so a member with a declared default takes
    # it (r-std-json.derive.from-json.default).
    fn is_absent(&mut self) -> bool:
        !self.present

# Primitives (spec/std/README.md#standard-library-primitives). The compiler
# supplies each body. `@intrinsic` is prototype-internal and accepted only
# in lib/std.

@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

# The bytes from offset `start` up to `end`, sharing them in constant time.
@intrinsic("bytes_slice")
fn bytes_slice(text: string, start: usize, end: usize) -> string:
    panic("intrinsic")

# Every part's bytes in order, copied once into one new string.
@intrinsic("concat_all")
fn concat_all(parts: List[string]) -> string:
    panic("intrinsic")

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")
