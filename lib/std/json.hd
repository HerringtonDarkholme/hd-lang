# std.json: the untyped JSON value, its parser, and its writers, and the
# typed traits `ToJson` and `FromJson` with `encode` and `decode`
# (spec/std/json.md).
use std.format.DebugWriter
use std.error.Error
use std.num.parse_f64
use std.structure.{Structure, Walker, Source, Variant, Field, Members, Key}

# One JSON value (r-std-json.value.decl). An object keeps its keys in
# insertion order, as every `Map` does.
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: Number)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: Map[string, Json])

# What a `Number` holds: an integer below zero, an integer from zero up, or
# a finite float. Normalized, so one integer has one representation
# (r-std-json.number.repr).
enum NumberRepr:
    Negative(value: i64)
    NonNegative(value: u64)
    Float(value: f64)

# A JSON number that keeps 64-bit integers exact, modeled on
# `serde_json::Number` (r-std-json.number.decl).
pub data Number:
    repr: NumberRepr

impl Number:
    pub fn from_i64(value: i64) -> Number:
        if value < 0:
            return Number { repr: NumberRepr.Negative(value) }
        Number { repr: NumberRepr.NonNegative(u64(value)) }

    pub fn from_u64(value: u64) -> Number:
        Number { repr: NumberRepr.NonNegative(value) }

    pub fn from_f64(value: f64) -> Number?:
        if !value.is_finite():
            return .None
        .Some(Number { repr: NumberRepr.Float(value) })

    pub fn as_i64(self) -> i64?:
        match self.repr:
            .Negative(value) => .Some(value)
            .NonNegative(value) =>
                if value < sign_limit():
                    .Some(i64(value))
                else:
                    .None
            .Float(_) => .None

    pub fn as_u64(self) -> u64?:
        match self.repr:
            .NonNegative(value) => .Some(value)
            _ => .None

    pub fn as_f64(self) -> f64?:
        match self.repr:
            .Negative(value) => .Some(f64(value))
            .NonNegative(value) => .Some(f64(value))
            .Float(value) => .Some(value)

impl Eq for Number:
    fn eq(self, other: Number) -> bool:
        match (self.repr, other.repr):
            (.Negative(left), .Negative(right)) => left == right
            (.NonNegative(left), .NonNegative(right)) => left == right
            (.Float(left), .Float(right)) => left == right
            _ => false

impl Display for Number:
    fn to_string(self) -> string:
        match self.repr:
            .Negative(value) => "$value"
            .NonNegative(value) => "$value"
            .Float(value) => "$value"

impl Json:
    # JSON text with two-space indentation (r-std-json.value.pretty).
    pub fn pretty(self) -> string:
        let out: mut List[u8] = []
        render(self, out, true, 0)
        bytes_text(out)

    pub fn get(self, key: string) -> Json?:
        match self:
            .Object(fields) => fields.get(key)
            _ => .None

    pub fn at(self, index: usize) -> Json?:
        match self:
            .Array(items) =>
                if index < items.len():
                    .Some(items[index])
                else:
                    .None
            _ => .None

    pub fn as_text(self) -> string?:
        match self:
            .Text(value) => .Some(value)
            _ => .None

    pub fn as_bool(self) -> bool?:
        match self:
            .Bool(value) => .Some(value)
            _ => .None

    pub fn as_number(self) -> Number?:
        match self:
            .Number(value) => .Some(value)
            _ => .None

    pub fn is_null(self) -> bool:
        match self:
            .Null => true
            _ => false

impl Eq for Json:
    fn eq(self, other: Json) -> bool:
        match (self, other):
            (.Null, .Null) => true
            (.Bool(left), .Bool(right)) => left == right
            (.Number(left), .Number(right)) => left == right
            (.Text(left), .Text(right)) => left == right
            (.Array(left), .Array(right)) => left == right
            (.Object(left), .Object(right)) => left == right
            _ => false

# Compact JSON text (r-std-json.display.compact).
impl Display for Json:
    fn to_string(self) -> string:
        let out: mut List[u8] = []
        render(self, out, false, 0)
        bytes_text(out)


fn render(value: Json, out: mut List[u8], spaced: bool, depth: usize) -> void:
    match value:
        .Null => push_text(out, "null")
        .Bool(flag) => push_text(out, if flag: "true" else: "false")
        .Number(number) => push_text(out, "$number")
        .Text(text) => render_text(out, text)
        .Array(items) =>
            if items.len() == 0:
                push_text(out, "[]")
                return
            out.push(91)
            let first = true
            for item in items:
                if !first:
                    out.push(44)
                first = false
                line_break(out, spaced, depth + 1)
                render(item, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            out.push(93)
        .Object(fields) =>
            if fields.len() == 0:
                push_text(out, "{}")
                return
            out.push(123)
            let first = true
            for entry in fields:
                if !first:
                    out.push(44)
                first = false
                line_break(out, spaced, depth + 1)
                render_text(out, entry._0)
                out.push(58)
                if spaced:
                    out.push(32)
                render(entry._1, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            out.push(125)

fn line_break(out: mut List[u8], spaced: bool, depth: usize) -> void:
    if !spaced:
        return
    out.push(10)
    let count = depth * 2
    while count > 0:
        out.push(32)
        count = count - 1

fn push_text(out: mut List[u8], text: string) -> void:
    for byte in text.bytes():
        out.push(byte)

# A quoted string: `"` and `\` escaped, the control characters below U+0020
# as `\b`, `\f`, `\n`, `\r`, `\t`, or `\u00XX` with lowercase hex, and
# every other scalar value as itself (r-std-json.display.text).
fn render_text(out: mut List[u8], text: string) -> void:
    out.push(34)
    for byte in text.bytes():
        if byte == 34:
            push_text(out, "\\\"")
        else if byte == 92:
            push_text(out, "\\\\")
        else if byte == 8:
            push_text(out, "\\b")
        else if byte == 12:
            push_text(out, "\\f")
        else if byte == 10:
            push_text(out, "\\n")
        else if byte == 13:
            push_text(out, "\\r")
        else if byte == 9:
            push_text(out, "\\t")
        else if byte < 32:
            push_text(out, "\\u00")
            out.push(hex_symbol(byte >> 4))
            out.push(hex_symbol(byte & 15))
        else:
            out.push(byte)
    out.push(34)

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

fn bytes_text(bytes: List[u8]) -> string:
    match string::from_utf8(bytes):
        .Ok(text) => text
        .Err(_) => panic("std.json: output bytes are valid UTF-8")

# Why parsing failed, at a byte offset into the text (r-std-json.error.position-bytes), or why
# decoding failed, at a path such as `$.users[2].name`
# (r-std-json.error.variants).
pub enum JsonError:
    # The text stops inside a value; `position` is its length.
    UnexpectedEnd(position: usize)
    # A character the grammar does not allow there.
    UnexpectedCharacter(position: usize)
    # A bad escape; `position` is its backslash.
    InvalidEscape(position: usize)
    # A `\u` surrogate with no partner; `position` is its backslash.
    LoneSurrogate(position: usize)
    # A raw control character inside a string.
    ControlCharacter(position: usize)
    # A number past the finite f64 range; `position` is its first character.
    NumberOutOfRange(position: usize)
    # An array or object nested deeper than 128 levels; `position` is its
    # opening bracket.
    NestingTooDeep(position: usize)
    # A value of the wrong kind, or a number out of the type's range;
    # `expected` names what the decoder reads (r-std-json.error.kind.type).
    WrongType(path: string, expected: string)
    # An object without a key that its type needs.
    MissingField(path: string)
    # A variant name that the enum does not declare.
    UnknownVariant(path: string, name: string)

impl Eq for JsonError:
    fn eq(self, other: JsonError) -> bool:
        match (self, other):
            (.UnexpectedEnd(left), .UnexpectedEnd(right)) => left == right
            (.UnexpectedCharacter(left), .UnexpectedCharacter(right)) => left == right
            (.InvalidEscape(left), .InvalidEscape(right)) => left == right
            (.LoneSurrogate(left), .LoneSurrogate(right)) => left == right
            (.ControlCharacter(left), .ControlCharacter(right)) => left == right
            (.NumberOutOfRange(left), .NumberOutOfRange(right)) => left == right
            (.NestingTooDeep(left), .NestingTooDeep(right)) => left == right
            (.WrongType(left, wanted), .WrongType(right, other)) => left == right && wanted == other
            (.MissingField(left), .MissingField(right)) => left == right
            (.UnknownVariant(left, name), .UnknownVariant(right, other)) => left == right && name == other
            _ => false

impl Display for JsonError:
    fn to_string(self) -> string:
        match self:
            .UnexpectedEnd(position) => "unexpected end of text at position $position"
            .UnexpectedCharacter(position) => "unexpected character at position $position"
            .InvalidEscape(position) => "invalid escape at position $position"
            .LoneSurrogate(position) => "lone surrogate escape at position $position"
            .ControlCharacter(position) => "control character in a string at position $position"
            .NumberOutOfRange(position) => "number out of range at position $position"
            .NestingTooDeep(position) => "nesting too deep at position $position"
            .WrongType(path, expected) => "expected $expected at $path"
            .MissingField(path) => "missing field at $path"
            .UnknownVariant(path, name) => "unknown variant \"$name\" at $path"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for JsonError

data Parsed:
    value: Json
    end: usize

data ParsedText:
    text: string
    end: usize

# Strict RFC 8259 text to a `Json` (r-std-json.parse).
pub fn parse(text: string) -> Result[Json, JsonError]:
    bytes := text.to_utf8()
    parsed := parse_value(bytes, 0, 0)?
    end := skip_space(bytes, parsed.end)
    if end < bytes.len():
        return .Err(JsonError.UnexpectedCharacter(end))
    .Ok(parsed.value)

# The error for a byte that cannot continue the text at `offset`.
fn unexpected(bytes: List[u8], offset: usize) -> JsonError:
    if offset >= bytes.len():
        return JsonError.UnexpectedEnd(offset)
    JsonError.UnexpectedCharacter(offset)

fn skip_space(bytes: List[u8], start: usize) -> usize:
    let index = start
    while index < bytes.len():
        byte := bytes[index]
        if byte != 32 && byte != 9 && byte != 10 && byte != 13:
            return index
        index = index + 1
    index

fn parse_value(bytes: List[u8], start: usize, depth: usize) -> Result[Parsed, JsonError]:
    index := skip_space(bytes, start)
    if index >= bytes.len():
        return .Err(unexpected(bytes, index))
    byte := bytes[index]
    if byte == 123:
        return parse_object(bytes, index, depth)
    if byte == 91:
        return parse_array(bytes, index, depth)
    if byte == 34:
        found := parse_string(bytes, index)?
        return .Ok(Parsed { value: Json.Text(found.text), end: found.end })
    if byte == 116:
        return parse_word(bytes, index, "true", Json.Bool(true))
    if byte == 102:
        return parse_word(bytes, index, "false", Json.Bool(false))
    if byte == 110:
        return parse_word(bytes, index, "null", Json.Null)
    if byte == 45 || (byte >= 48 && byte <= 57):
        return parse_number(bytes, index)
    .Err(unexpected(bytes, index))

fn parse_word(bytes: List[u8], start: usize, word: string, value: Json) -> Result[Parsed, JsonError]:
    let index = start
    for expected in word.bytes():
        if index >= bytes.len() || bytes[index] != expected:
            return .Err(unexpected(bytes, index))
        index = index + 1
    .Ok(Parsed { value: value, end: index })

fn parse_array(bytes: List[u8], open: usize, depth: usize) -> Result[Parsed, JsonError]:
    if depth >= 128:
        return .Err(JsonError.NestingTooDeep(open))
    let items: mut List[Json] = []
    let index = skip_space(bytes, open + 1)
    if index < bytes.len() && bytes[index] == 93:
        return .Ok(Parsed { value: Json.Array(items), end: index + 1 })
    while true:
        found := parse_value(bytes, index, depth + 1)?
        items.push(found.value)
        index = skip_space(bytes, found.end)
        if index < bytes.len() && bytes[index] == 44:
            index = index + 1
        else if index < bytes.len() && bytes[index] == 93:
            return .Ok(Parsed { value: Json.Array(items), end: index + 1 })
        else:
            return .Err(unexpected(bytes, index))
    .Err(unexpected(bytes, index))

fn parse_object(bytes: List[u8], open: usize, depth: usize) -> Result[Parsed, JsonError]:
    if depth >= 128:
        return .Err(JsonError.NestingTooDeep(open))
    let fields: mut Map[string, Json] = {}
    let index = skip_space(bytes, open + 1)
    if index < bytes.len() && bytes[index] == 125:
        return .Ok(Parsed { value: Json.Object(fields), end: index + 1 })
    while true:
        if index >= bytes.len() || bytes[index] != 34:
            return .Err(unexpected(bytes, index))
        key := parse_string(bytes, index)?
        index = skip_space(bytes, key.end)
        if index >= bytes.len() || bytes[index] != 58:
            return .Err(unexpected(bytes, index))
        found := parse_value(bytes, index + 1, depth + 1)?
        fields[key.text] = found.value
        index = skip_space(bytes, found.end)
        if index < bytes.len() && bytes[index] == 44:
            index = skip_space(bytes, index + 1)
        else if index < bytes.len() && bytes[index] == 125:
            return .Ok(Parsed { value: Json.Object(fields), end: index + 1 })
        else:
            return .Err(unexpected(bytes, index))
    .Err(unexpected(bytes, index))

# The string that starts at the quote at `open`.
fn parse_string(bytes: List[u8], open: usize) -> Result[ParsedText, JsonError]:
    let buffer: mut List[u8] = []
    let index = open + 1
    while true:
        if index >= bytes.len():
            return .Err(unexpected(bytes, index))
        byte := bytes[index]
        if byte == 34:
            return .Ok(ParsedText { text: bytes_text(buffer), end: index + 1 })
        if byte < 32:
            return .Err(JsonError.ControlCharacter(index))
        if byte != 92:
            buffer.push(byte)
            index = index + 1
            continue
        backslash := index
        if index + 1 >= bytes.len():
            return .Err(unexpected(bytes, index + 1))
        escaped := bytes[index + 1]
        index = index + 2
        if escaped == 34 || escaped == 92 || escaped == 47:
            buffer.push(escaped)
        else if escaped == 98:
            buffer.push(8)
        else if escaped == 102:
            buffer.push(12)
        else if escaped == 110:
            buffer.push(10)
        else if escaped == 114:
            buffer.push(13)
        else if escaped == 116:
            buffer.push(9)
        else if escaped == 117:
            unit := read_hex4(bytes, index)
            if unit == -2:
                return .Err(unexpected(bytes, bytes.len()))
            if unit < 0:
                return .Err(JsonError.InvalidEscape(backslash))
            index = index + 4
            let point = unit
            if unit >= 56320 && unit <= 57343:
                return .Err(JsonError.LoneSurrogate(backslash))
            if unit >= 55296 && unit <= 56319:
                low := if index + 1 < bytes.len() && bytes[index] == 92 && bytes[index + 1] == 117: read_hex4(bytes, index + 2) else: -1
                if low < 56320 || low > 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                point = 65536 + (unit - 55296) * 1024 + (low - 56320)
                index = index + 6
            push_scalar(buffer, point)
        else:
            return .Err(JsonError.InvalidEscape(backslash))
    .Err(unexpected(bytes, index))

# The value of the four hex digits at `at`, -1 when one is not a hex digit,
# or -2 when the text ends first.
fn read_hex4(bytes: List[u8], at: usize) -> i32:
    let value = 0
    let offset: usize = 0
    while offset < 4:
        if at + offset >= bytes.len():
            return -2
        digit := hex_value(i32(bytes[at + offset]))
        if digit < 0:
            return -1
        value = value * 16 + digit
        offset = offset + 1
    value

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        return code - 48
    if code >= 97 && code <= 102:
        return code - 87
    if code >= 65 && code <= 70:
        return code - 55
    -1

# The UTF-8 bytes of a scalar value.
fn push_scalar(out: mut List[u8], point: i32) -> void:
    if point < 128:
        out.push(u8(point))
    else if point < 2048:
        out.push(u8(192 + (point >> 6)))
        out.push(u8(128 + (point & 63)))
    else if point < 65536:
        out.push(u8(224 + (point >> 12)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    else:
        out.push(u8(240 + (point >> 18)))
        out.push(u8(128 + ((point >> 12) & 63)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))

# 2^63, the first u64 past the i64 range, and the largest u64.
fn sign_limit() -> u64:
    9223372036854775808

fn u64_max() -> u64:
    18446744073709551615

# The number that starts at `start`: `-`? then `0` or a nonzero digit and
# digits. An integer in the i64 or u64 range is exact; `-0` is the float
# -0.0, as in serde_json. A fraction, an exponent, or an integer past both
# ranges is the float that `parse_f64` gives (r-std-json.parse.number.float).
fn parse_number(bytes: List[u8], start: usize) -> Result[Parsed, JsonError]:
    size := bytes.len()
    let index = start
    negative := bytes[index] == 45
    if negative:
        index = index + 1
    if index >= size:
        return .Err(unexpected(bytes, index))
    let magnitude: u64 = 0
    let overflow = false
    if bytes[index] == 48:
        index = index + 1
    else if bytes[index] >= 49 && bytes[index] <= 57:
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            digit := u64(bytes[index] - 48)
            if magnitude > (u64_max() - digit) / 10:
                overflow = true
            else:
                magnitude = magnitude * 10 + digit
            index = index + 1
    else:
        return .Err(unexpected(bytes, index))
    let exotic = false
    if index < size && bytes[index] == 46:
        index = index + 1
        if index >= size || bytes[index] < 48 || bytes[index] > 57:
            return .Err(unexpected(bytes, index))
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            index = index + 1
        exotic = true
    if index < size && (bytes[index] == 101 || bytes[index] == 69):
        index = index + 1
        if index < size && (bytes[index] == 43 || bytes[index] == 45):
            index = index + 1
        if index >= size || bytes[index] < 48 || bytes[index] > 57:
            return .Err(unexpected(bytes, index))
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            index = index + 1
        exotic = true
    if exotic || overflow || (negative && magnitude > sign_limit()):
        return float_number(bytes, start, index)
    if !negative:
        return .Ok(Parsed { value: Json.Number(Number::from_u64(magnitude)), end: index })
    if magnitude == 0:
        match Number::from_f64(-0.0):
            .Some(zero) => return .Ok(Parsed { value: Json.Number(zero), end: index })
            .None => return float_number(bytes, start, index)
    if magnitude == sign_limit():
        return .Ok(Parsed { value: Json.Number(Number::from_i64(-9223372036854775808)), end: index })
    .Ok(Parsed { value: Json.Number(Number::from_i64(-i64(magnitude))), end: index })

# The float of the number text from `start` up to `end`, which the caller
# has read to the end of its grammar; past the f64 range it is a
# `NumberOutOfRange` at `start` (r-std-json.parse.number.out-of-range).
fn float_number(bytes: List[u8], start: usize, end: usize) -> Result[Parsed, JsonError]:
    let digits: mut List[u8] = []
    let index = start
    while index < end:
        digits.push(bytes[index])
        index = index + 1
    value := match parse_f64(bytes_text(digits)):
        .Ok(found) => found
        .Err(_) => panic("std.json: a JSON number is parse_f64 text")
    match Number::from_f64(value):
        .Some(number) => .Ok(Parsed { value: Json.Number(number), end: end })
        .None => .Err(JsonError.NumberOutOfRange(start))

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates:
# a `@derive` on a std declaration has no effect in the prototype.

impl Debug for Number:
    fn debug(self, out: mut DebugWriter) -> void:
        match self.repr:
            .Negative(value) => out.debug_tuple("Number").field(value).finish()
            .NonNegative(value) => out.debug_tuple("Number").field(value).finish()
            .Float(value) => out.debug_tuple("Number").field(value).finish()

impl Debug for Json:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Null => out.debug_struct("Null").finish()
            .Bool(value) => out.debug_struct("Bool").field("value", value).finish()
            .Number(value) => out.debug_struct("Number").field("value", value).finish()
            .Text(value) => out.debug_struct("Text").field("value", value).finish()
            .Array(items) => out.debug_struct("Array").field("items", items).finish()
            .Object(fields) => out.debug_struct("Object").field("fields", fields).finish()

impl Debug for JsonError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .UnexpectedEnd(position) => out.debug_struct("UnexpectedEnd").field("position", position).finish()
            .UnexpectedCharacter(position) => out.debug_struct("UnexpectedCharacter").field("position", position).finish()
            .InvalidEscape(position) => out.debug_struct("InvalidEscape").field("position", position).finish()
            .LoneSurrogate(position) => out.debug_struct("LoneSurrogate").field("position", position).finish()
            .ControlCharacter(position) => out.debug_struct("ControlCharacter").field("position", position).finish()
            .NumberOutOfRange(position) => out.debug_struct("NumberOutOfRange").field("position", position).finish()
            .NestingTooDeep(position) => out.debug_struct("NestingTooDeep").field("position", position).finish()
            .WrongType(path, expected) => out.debug_struct("WrongType").field("path", path).field("expected", expected).finish()
            .MissingField(path) => out.debug_struct("MissingField").field("path", path).finish()
            .UnknownVariant(path, name) => out.debug_struct("UnknownVariant").field("path", path).field("name", name).finish()

# ---------------------------------------------------------------------------
# Typed JSON (spec/std/json.md#typed-json): `ToJson`, `FromJson`, their
# standard implementations and templates, `encode`, and `decode`.

# A value's `Json` (r-std-json.to-json.trait).
pub trait ToJson:
    fn to_json(self) -> Json

# A value read from a `Json`, or the first error at its path
# (r-std-json.from-json.trait).
pub trait FromJson:
    fn from_json(value: Json) -> Result[Self, JsonError]

# The compact text of a value's `Json` (r-std-json.encode).
pub fn encode[T < ToJson](value: T) -> string:
    "${value.to_json()}"

# `parse`, then `from_json` (r-std-json.decode).
pub fn decode[T < FromJson](text: string) -> Result[T, JsonError]:
    value := parse(text)?
    T::from_json(value)

# A decode error at the root, `$`.
fn wrong_type(expected: string) -> JsonError:
    JsonError.WrongType("\$", expected)

# The path `$` followed by `segment` and then the rest of `path`, which
# starts with `$` (r-std-json.error.path).
fn rebase(path: string, segment: string) -> string:
    rest := path.slice(1, path.len())
    "\$$segment$rest"

# A child's decode error, moved under `segment`, such as `.name` or `[2]`.
fn nested(error: JsonError, segment: string) -> JsonError:
    match error:
        .WrongType(path, expected) => JsonError.WrongType(rebase(path, segment), expected)
        .MissingField(path) => JsonError.MissingField(rebase(path, segment))
        .UnknownVariant(path, name) => JsonError.UnknownVariant(rebase(path, segment), name)
        _ => error

impl ToJson for Json:
    fn to_json(self) -> Json:
        self

impl FromJson for Json:
    fn from_json(value: Json) -> Result[Json, JsonError]:
        .Ok(value)

impl ToJson for bool:
    fn to_json(self) -> Json:
        Json.Bool(self)

impl FromJson for bool:
    fn from_json(value: Json) -> Result[bool, JsonError]:
        match value:
            .Bool(flag) => .Ok(flag)
            _ => .Err(wrong_type("bool"))

impl ToJson for string:
    fn to_json(self) -> Json:
        Json.Text(self)

impl FromJson for string:
    fn from_json(value: Json) -> Result[string, JsonError]:
        match value:
            .Text(text) => .Ok(text)
            _ => .Err(wrong_type("string"))

# A `char` is a string of one character (r-std-json.std.char).
impl ToJson for char:
    fn to_json(self) -> Json:
        Json.Text("$self")

impl FromJson for char:
    fn from_json(value: Json) -> Result[char, JsonError]:
        match value:
            .Text(text) =>
                let found: mut List[char] = []
                for item in text.chars():
                    found.push(item)
                if found.len() == 1:
                    return .Ok(found[0])
                .Err(wrong_type("char"))
            _ => .Err(wrong_type("char"))

# The integer of a `Number` from `low` to `high`, or `.None` for a float,
# an integer out of range, or another kind.
fn signed_in(value: Json, low: i64, high: i64) -> i64?:
    match value:
        .Number(number) =>
            match number.as_i64():
                .Some(found) =>
                    if found >= low && found <= high:
                        .Some(found)
                    else:
                        .None
                .None => .None
        _ => .None

fn unsigned_in(value: Json, high: u64) -> u64?:
    match value:
        .Number(number) =>
            match number.as_u64():
                .Some(found) =>
                    if found <= high:
                        .Some(found)
                    else:
                        .None
                .None => .None
        _ => .None

impl ToJson for i8:
    fn to_json(self) -> Json:
        Json.Number(Number::from_i64(i64(self)))

impl FromJson for i8:
    fn from_json(value: Json) -> Result[i8, JsonError]:
        match signed_in(value, -128, 127):
            .Some(found) => .Ok(i8(found))
            .None => .Err(wrong_type("i8"))

impl ToJson for i16:
    fn to_json(self) -> Json:
        Json.Number(Number::from_i64(i64(self)))

impl FromJson for i16:
    fn from_json(value: Json) -> Result[i16, JsonError]:
        match signed_in(value, -32768, 32767):
            .Some(found) => .Ok(i16(found))
            .None => .Err(wrong_type("i16"))

impl ToJson for i32:
    fn to_json(self) -> Json:
        Json.Number(Number::from_i64(i64(self)))

impl FromJson for i32:
    fn from_json(value: Json) -> Result[i32, JsonError]:
        match signed_in(value, -2147483648, 2147483647):
            .Some(found) => .Ok(i32(found))
            .None => .Err(wrong_type("i32"))

impl ToJson for i64:
    fn to_json(self) -> Json:
        Json.Number(Number::from_i64(self))

impl FromJson for i64:
    fn from_json(value: Json) -> Result[i64, JsonError]:
        match value:
            .Number(number) =>
                match number.as_i64():
                    .Some(found) => .Ok(found)
                    .None => .Err(wrong_type("i64"))
            _ => .Err(wrong_type("i64"))

impl ToJson for u8:
    fn to_json(self) -> Json:
        Json.Number(Number::from_u64(u64(self)))

impl FromJson for u8:
    fn from_json(value: Json) -> Result[u8, JsonError]:
        match unsigned_in(value, 255):
            .Some(found) => .Ok(u8(found))
            .None => .Err(wrong_type("u8"))

impl ToJson for u16:
    fn to_json(self) -> Json:
        Json.Number(Number::from_u64(u64(self)))

impl FromJson for u16:
    fn from_json(value: Json) -> Result[u16, JsonError]:
        match unsigned_in(value, 65535):
            .Some(found) => .Ok(u16(found))
            .None => .Err(wrong_type("u16"))

impl ToJson for u32:
    fn to_json(self) -> Json:
        Json.Number(Number::from_u64(u64(self)))

impl FromJson for u32:
    fn from_json(value: Json) -> Result[u32, JsonError]:
        match unsigned_in(value, 4294967295):
            .Some(found) => .Ok(u32(found))
            .None => .Err(wrong_type("u32"))

impl ToJson for u64:
    fn to_json(self) -> Json:
        Json.Number(Number::from_u64(self))

impl FromJson for u64:
    fn from_json(value: Json) -> Result[u64, JsonError]:
        match unsigned_in(value, u64_max()):
            .Some(found) => .Ok(found)
            .None => .Err(wrong_type("u64"))

# A NaN or an infinity has no JSON number, so it writes `null`, as in
# serde_json (r-std-json.std.float-special).
impl ToJson for f64:
    fn to_json(self) -> Json:
        match Number::from_f64(self):
            .Some(number) => Json.Number(number)
            .None => Json.Null

impl FromJson for f64:
    fn from_json(value: Json) -> Result[f64, JsonError]:
        match value:
            .Number(number) =>
                match number.as_f64():
                    .Some(found) => .Ok(found)
                    .None => .Err(wrong_type("f64"))
            _ => .Err(wrong_type("f64"))

impl ToJson for f32:
    fn to_json(self) -> Json:
        f64(self).to_json()

# A number past the finite `f32` range is out of range
# (r-std-json.std.float-read).
impl FromJson for f32:
    fn from_json(value: Json) -> Result[f32, JsonError]:
        limit := 340282346638528859811704183484516925440.0
        match value:
            .Number(number) =>
                match number.as_f64():
                    .Some(found) =>
                        if found >= -limit && found <= limit:
                            return .Ok(f32(found))
                        .Err(wrong_type("f32"))
                    .None => .Err(wrong_type("f32"))
            _ => .Err(wrong_type("f32"))

# `.None` is `null` (r-std-json.std.optional).
impl[T < ToJson] ToJson for T?:
    fn to_json(self) -> Json:
        match self:
            .Some(found) => found.to_json()
            .None => Json.Null

impl[T < FromJson] FromJson for T?:
    fn from_json(value: Json) -> Result[T?, JsonError]:
        match value:
            .Null => .Ok(.None)
            _ =>
                match T::from_json(value):
                    .Ok(found) => .Ok(.Some(found))
                    .Err(error) => .Err(error)

impl[T < ToJson] ToJson for List[T]:
    fn to_json(self) -> Json:
        let items: mut List[Json] = []
        for item in self:
            items.push(item.to_json())
        Json.Array(items)

impl[T < FromJson] FromJson for List[T]:
    fn from_json(value: Json) -> Result[List[T], JsonError]:
        match value:
            .Array(items) =>
                let found: mut List[T] = []
                let index: usize = 0
                for item in items:
                    match T::from_json(item):
                        .Ok(decoded) => found.push(decoded)
                        .Err(error) => return .Err(nested(error, "[$index]"))
                    index = index + 1
                .Ok(found)
            _ => .Err(wrong_type("array"))

# Only `string` keys, since a JSON key is a string
# (r-std-json.std.map-keys).
impl[V < ToJson] ToJson for Map[string, V]:
    fn to_json(self) -> Json:
        let fields: mut Map[string, Json] = {}
        for entry in self:
            fields[entry._0] = entry._1.to_json()
        Json.Object(fields)

impl[V < FromJson] FromJson for Map[string, V]:
    fn from_json(value: Json) -> Result[Map[string, V], JsonError]:
        match value:
            .Object(fields) =>
                let found: mut Map[string, V] = {}
                for entry in fields:
                    match V::from_json(entry._1):
                        .Ok(decoded) => found[entry._0] = decoded
                        .Err(error) => return .Err(nested(error, ".${entry._0}"))
                .Ok(found)
            _ => .Err(wrong_type("object"))

# Derived `ToJson` (r-std-json.derive.to-json.template): a data type is an
# object with one key per member, in declaration order. An enum variant is
# `{"Variant": {...}}`, or the string `"Variant"` when it has no member.
impl[T] ToJson for T by Structure:
    fn to_json(self) -> Json:
        let w: mut JsonWalker[T] = JsonWalker::[T] { name: "", of_data: true, fields: {} }
        _ := Structure::walk(self, w)
        if w.of_data:
            return Json.Object(w.fields)
        if w.fields.len() == 0:
            return Json.Text(w.name)
        let outer: mut Map[string, Json] = {}
        outer[w.name] = Json.Object(w.fields)
        Json.Object(outer)

# The fields are public because the prototype checks the instantiated
# walker in the deriving module.
data JsonWalker[S]:
    pub name: string
    pub of_data: bool
    pub fields: mut Map[string, Json]

impl[S] Walker[S] for JsonWalker[S]:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        self.name = v.info.name
        self.of_data = v.info.of_data
        .Ok(())

    fn member[F < ToJson](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.fields[h.info.name] = value.to_json()
        .Ok(())

# Derived `FromJson` (r-std-json.derive.from-json.template): the inverse of
# derived `ToJson`. Unknown keys are ignored, and a missing key reads as
# `null`, so only a member whose type accepts `null` may be missing.
impl[T] FromJson for T by Structure:
    fn from_json(value: Json) -> Result[T, JsonError]:
        let s: mut JsonSource[T] = JsonSource::[T] { value: value, base: "", fields: {}, at: 0 }
        match T::build(s):
            .Ok(built) => .Ok(built)
            .Err(error) => .Err(error)

# Reads one object: `base` is the path segment of the object that holds
# the members, `""` for a data type and `.Variant` for an enum. The fields
# are public because the prototype checks the instantiated source in the
# program that uses it.
data JsonSource[S]:
    pub value: Json
    pub base: string
    pub fields: Map[string, Json]
    pub at: usize

impl[S] Source[S] for JsonSource[S]:
    type Error = JsonError

    # A data type reads an object. An enum reads `"Variant"` as
    # `{"Variant": {}}`, or an object with exactly one key.
    fn variant(mut self, choices: List[Variant[S]]) -> Result[Variant[S], JsonError]:
        if choices.len() == 1 && choices[0].info.of_data:
            match self.value:
                .Object(fields) =>
                    self.fields = fields
                    return .Ok(choices[0])
                _ => return .Err(wrong_type("object"))
        let name = ""
        let payload = Json.Null
        match self.value:
            .Text(text) =>
                name = text
                payload = Json.Object({})
            .Object(fields) =>
                if fields.len() != 1:
                    return .Err(wrong_type("variant"))
                for entry in fields:
                    name = entry._0
                    payload = entry._1
            _ => return .Err(wrong_type("variant"))
        for choice in choices:
            if choice.info.name == name:
                match payload:
                    .Object(fields) =>
                        self.fields = fields
                        self.base = ".$name"
                        return .Ok(choice)
                    _ => return .Err(JsonError.WrongType("\$.$name", "object"))
        .Err(JsonError.UnknownVariant("\$", name))

    # Every member, in declaration order.
    fn next(mut self, members: Members[S]) -> Result[Key[S], JsonError]:
        if self.at >= members.infos.len():
            return .Ok(members.end())
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    fn member[F < FromJson](mut self, h: Field[S, F], previous: F?) -> Result[F, JsonError]:
        segment := "${self.base}.${h.info.name}"
        match self.fields.get(h.info.name):
            .Some(found) =>
                match F::from_json(found):
                    .Ok(decoded) => .Ok(decoded)
                    .Err(error) => .Err(nested(error, segment))
            .None =>
                match F::from_json(Json.Null):
                    .Ok(decoded) => .Ok(decoded)
                    .Err(_) => .Err(JsonError.MissingField("\$$segment"))

    fn missing[F](mut self, h: Field[S, F]) -> Result[F, JsonError]:
        panic("the JSON source names every member")
