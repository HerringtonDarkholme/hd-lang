# std.json: the untyped JSON value, its parser, and its writers, and
# typed JSON over the `std.serde` opt-in: `to_json`, `from_json`,
# `encode`, `encode_pretty`, and `decode` (spec/std/json.md).
use std.format.DebugWriter
use std.iter.ListIter
use std.error.Error
use std.serde.{Serialize, Deserialize, Serializer, Deserializer, ValueKind, member_name}
use std.structure.{VariantInfo, Member, Facts}

# One JSON value (r-std-json.value.decl). An object keeps its members in
# insertion order (r-std-json.object.order).
## A JSON value: `null`, `Bool`, `Number`, `Text`, `Array`, or `Object`.
## See [std-json.value.decl](../../spec/std/json.md#r-std-json.value.decl).
@derive(Debug, Eq)
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: Number)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: JsonObject)

# The members of a JSON object (r-std-json.object.decl-struct): `entries` holds them
# in insertion order. An object of up to 8 members finds a key by comparing
# it with each; a larger one also keeps `index`, which maps each key to its
# place in `entries`, so a lookup does not scan.
## The members of a JSON object, in insertion order.
## See [std-json.object.decl-struct](../../spec/std/json.md#r-std-json.object.decl-struct).
pub struct JsonObject:
    entries: List[(string, Json)]
    index: Map[string, usize]

impl JsonObject:
    ## Returns an object with no members.
    ## See [std-json.object.new-value](../../spec/std/json.md#r-std-json.object.new-value).
    pub fn new() -> JsonObject:
        JsonObject { entries: [], index: {} }

    ## Returns the number of members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn len(self) -> usize:
        self.entries.len()

    ## True exactly when the object has no members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn is_empty(self) -> bool:
        self.entries.len() == 0

    ## The value of `key`, or `.None` when the object has no such key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn get(self, key: string) -> Json?:
        match self.position(key):
            .Some(at) => .Some(self.entries[at]._1)
            .None => .None

    ## True exactly when the object has the key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn contains_key(self, key: string) -> bool:
        self.position(key).is_some()

    ## Sets `key` to `value`. A new key goes last, and an existing key keeps its place.
    ## See [std-json.object.set-ref](../../spec/std/json.md#r-std-json.object.set-ref).
    pub fn set(&mut self, key: string, value: Json) -> void:
        match self.position(key):
            .Some(at) => self.entries[at] = (key, value)
            .None =>
                count := self.entries.len()
                self.entries.push((key, value))
                if self.index.len() > 0:
                    self.index[key] = count
                else if count >= 8:
                    let at: usize = 0
                    while at <= count:
                        self.index[self.entries[at]._0] = at
                        at = at + 1

    ## Removes `key` and returns its value, or `.None` when the object has no such key. The other members keep their order.
    ## See [std-json.object.remove-ref](../../spec/std/json.md#r-std-json.object.remove-ref).
    pub fn remove(&mut self, key: string) -> Json?:
        match self.position(key):
            .None => .None
            .Some(at) =>
                removed := self.entries.remove_at(at)
                if self.index.len() > 0:
                    _ := self.index.remove(key)
                    size := self.entries.len()
                    let later: usize = at
                    while later < size:
                        self.index[self.entries[later]._0] = later
                        later = later + 1
                .Some(removed._1)

    # The place of `key` in `entries`. `index` is empty until it is kept.
    fn position(&self, key: string) -> usize?:
        if self.index.len() > 0:
            return self.index.get(key)
        size := self.entries.len()
        let at: usize = 0
        while at < size:
            if self.entries[at]._0 == key:
                return .Some(at)
            at = at + 1
        .None

    ## The keys, in insertion order.
    ## See [std-json.object.order](../../spec/std/json.md#r-std-json.object.order).
    pub fn keys(self) -> List[string]:
        self.entries.map(fn(entry: (string, Json)) -> string: entry._0)

impl Iterable[(string, Json)] for JsonObject:
    type IntoIter = ListIter[(string, Json)]
    fn iter(self) -> ListIter[(string, Json)]:
        self.entries.iter()

# The same members, in any order (r-std-json.value.eq.object).
# Keep handwritten Eq: compare keys and values, independent of entry order.
impl Eq for JsonObject:
    fn eq(self, other: JsonObject) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in self.entries:
            match other.get(key):
                .Some(found) =>
                    if found != value:
                        return false
                .None => return false
        true

# What a `Number` holds: an integer below zero, an integer from zero up, or
# a finite float. Normalized, so one integer has one representation
# (r-std-json.number.repr).
@derive(Eq)
enum NumberRepr:
    Negative(value: i64)
    NonNegative(value: u64)
    Float(value: f64)

# A JSON number that keeps 64-bit integers exact, modeled on
# `serde_json::Number` (r-std-json.number.decl-struct).
## A JSON number, exact for 64-bit integers: integers in the `i64` and `u64` ranges are exact, and every other number is an `f64`.
## See [std-json.number.decl-struct](../../spec/std/json.md#r-std-json.number.decl-struct).
@derive(Eq)
pub struct Number:
    repr: NumberRepr

impl Number:
    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.i64](../../spec/std/json.md#r-std-json.number.constructors.i64).
    pub fn from_i64(value: i64) -> Number:
        if value < 0:
            return Number { repr: NumberRepr.Negative(value) }
        Number { repr: NumberRepr.NonNegative(u64(value)) }

    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.u64](../../spec/std/json.md#r-std-json.number.constructors.u64).
    pub fn from_u64(value: u64) -> Number:
        Number { repr: NumberRepr.NonNegative(value) }

    ## Returns the float `value` as a `Number`, or `.None` for a NaN or an infinity.
    ## See [std-json.number.constructors.f64](../../spec/std/json.md#r-std-json.number.constructors.f64).
    pub fn from_f64(value: f64) -> Number?:
        if !value.is_finite():
            return .None
        .Some(Number { repr: NumberRepr.Float(value) })

    ## The integer when it is in the `i64` range, and `.None` for a float.
    ## See [std-json.number.accessors.i64](../../spec/std/json.md#r-std-json.number.accessors.i64).
    pub fn as_i64(self) -> i64?:
        match self.repr:
            .Negative(value) => .Some(value)
            .NonNegative(value) =>
                if value < sign_limit(): .Some(i64(value)) else: .None
            .Float(_) => .None

    ## The integer when it is from zero up, and `.None` for a negative integer or a float.
    ## See [std-json.number.accessors.u64](../../spec/std/json.md#r-std-json.number.accessors.u64).
    pub fn as_u64(self) -> u64?:
        match self.repr:
            .NonNegative(value) => .Some(value)
            _ => .None

    ## `.Some` of the float, or of the integer converted to the nearest `f64`.
    ## See [std-json.number.accessors.f64](../../spec/std/json.md#r-std-json.number.accessors.f64).
    pub fn as_f64(self) -> f64?:
        match self.repr:
            .Negative(value) => .Some(f64(value))
            .NonNegative(value) => .Some(f64(value))
            .Float(value) => .Some(value)

# Keep handwritten Display: render the represented number without its private enum wrapper.
impl Display for Number:
    fn to_string(self) -> string:
        match self.repr:
            .Negative(value) => "$value"
            .NonNegative(value) => "$value"
            .Float(value) => "$value"

impl Json:
    # JSON text with two-space indentation (r-std-json.value.pretty).
    ## The pretty text of the value: each item of an array and each entry of an object on its own line, indented by two spaces for each level of nesting.
    ## See [std-json.value.pretty](../../spec/std/json.md#r-std-json.value.pretty).
    pub fn pretty(self) -> string:
        let mut parts: List[string] = []
        render(self, &mut parts, true, 0)
        concat_all(parts)

    ## The value of `key` when the value is an `Object` with that key.
    ## See [std-json.value.accessors.get](../../spec/std/json.md#r-std-json.value.accessors.get).
    pub fn get(self, key: string) -> Json?:
        match self:
            .Object(fields) => fields.get(key)
            _ => .None

    ## The item at `index` when the value is an `Array` and `index` is from 0 up to its length.
    ## See [std-json.value.accessors.at-index](../../spec/std/json.md#r-std-json.value.accessors.at-index).
    pub fn at(self, index: usize) -> Json?:
        match self:
            .Array(items) =>
                if index < items.len(): .Some(items[index]) else: .None
            _ => .None

    ## The string of a `Text` value.
    ## See [std-json.value.accessors.text](../../spec/std/json.md#r-std-json.value.accessors.text).
    pub fn as_text(self) -> string?:
        match self:
            .Text(value) => .Some(value)
            _ => .None

    ## The value of a `Bool`.
    ## See [std-json.value.accessors.bool](../../spec/std/json.md#r-std-json.value.accessors.bool).
    pub fn as_bool(self) -> bool?:
        match self:
            .Bool(value) => .Some(value)
            _ => .None

    ## `true` exactly for `Null`.
    ## See [std-json.value.accessors.null](../../spec/std/json.md#r-std-json.value.accessors.null).
    pub fn is_null(self) -> bool:
        match self:
            .Null => true
            _ => false

    ## The integer of a `Number` that is an integer in the `i64` range; a float, even `1.0`, gives `.None`.
    ## See [std-json.value.accessors.i64](../../spec/std/json.md#r-std-json.value.accessors.i64).
    pub fn as_i64(self) -> i64?:
        match self:
            .Number(value) => value.as_i64()
            _ => .None

    ## The integer of a `Number` that is an integer from zero up in the `u64` range; a float gives `.None`.
    ## See [std-json.value.accessors.u64](../../spec/std/json.md#r-std-json.value.accessors.u64).
    pub fn as_u64(self) -> u64?:
        match self:
            .Number(value) => value.as_u64()
            _ => .None

    ## The `f64` of any `Number`, an integer converted to the nearest `f64`.
    ## See [std-json.value.accessors.f64](../../spec/std/json.md#r-std-json.value.accessors.f64).
    pub fn as_f64(self) -> f64?:
        match self:
            .Number(value) => value.as_f64()
            _ => .None

    # RFC 6901: `""` is the value itself, and every other pointer is `/`
    # and a token for each step (r-std-json.pointer.syntax). A token is cut
    # at the next `/` and decoded at once; `/` and `~` are ASCII, so every
    # cut is on a scalar boundary.
    ## The value at the JSON Pointer `path` (RFC 6901), such as `/db/pool/0`, or `.None` when no value is there.
    ## See [std-json.pointer](../../spec/std/json.md#r-std-json.pointer).
    pub fn pointer(self, path: string) -> Json?:
        size := bytes_len(path)
        if size == 0:
            return .Some(self)
        if bytes_at(path, 0) != 47:
            return .None
        let current = self
        let start: usize = 1
        while start <= size:
            end := bytes_index(path, start, 47)
            match pointer_step(current, pointer_token(path, start, end)):
                .Some(next) => current = next
                .None => return .None
            start = end + 1
        .Some(current)

# One pointer step: an object's member named `token`, or an array's item
# at the index `token` writes (r-std-json.pointer.step).
fn pointer_step(value: Json, token: string) -> Json?:
    match value:
        .Object(fields) => fields.get(token)
        .Array(items) =>
            match pointer_index(token, items.len()):
                .Some(index) => .Some(items[index])
                .None => .None
        _ => .None

# The index that `token` writes when it is below `len`: base-ten digits,
# with no sign and no leading zero (r-std-json.pointer.index).
fn pointer_index(token: string, len: usize) -> usize?:
    size := bytes_len(token)
    if size == 0 || (size > 1 && bytes_at(token, 0) == 48):
        return .None
    let value: usize = 0
    let at: usize = 0
    while at < size:
        byte := bytes_at(token, at)
        if byte < 48 || byte > 57:
            return .None
        value = value * 10 + usize(byte - 48)
        if value >= len:
            return .None
        at = at + 1
    .Some(value)

# The token from `start` up to `end` of `path`, with `~1` read as `/` and
# `~0` as `~`; any other `~` stays as written (r-std-json.pointer.escapes).
fn pointer_token(path: string, start: usize, end: usize) -> string:
    let mut parts: List[string] = []
    let plain = start
    let at = start
    while at + 1 < end:
        if bytes_at(path, at) == 126:
            next := bytes_at(path, at + 1)
            if next == 48 || next == 49:
                if at > plain:
                    parts.push(bytes_slice(path, plain, at))
                parts.push(if next == 48: "~" else: "/")
                at = at + 2
                plain = at
                continue
        at = at + 1
    if parts.len() == 0:
        return bytes_slice(path, start, end)
    if plain < end:
        parts.push(bytes_slice(path, plain, end))
    concat_all(parts)

# Compact JSON text (r-std-json.display.compact).
# Keep handwritten Display: render JSON syntax rather than an Error message.
impl Display for Json:
    fn to_string(self) -> string:
        let mut parts: List[string] = []
        render(self, &mut parts, false, 0)
        concat_all(parts)

# The text is collected as pieces and joined once. Every piece is valid
# UTF-8 (a literal, a number's text, or a run of a string cut next to an
# ASCII byte), so the joined text needs no check.
fn render(value: Json, parts: &mut List[string], spaced: bool, depth: usize) -> void:
    match value:
        .Null => parts.push("null")
        .Bool(flag) =>
            parts.push(if flag: "true" else: "false")
        .Number(number) => parts.push("$number")
        .Text(text) => push_quoted(parts, text)
        .Array(items) =>
            if items.len() == 0:
                parts.push("[]")
                return
            parts.push("[")
            let first = true
            for item in items:
                if !first:
                    parts.push(",")
                first = false
                line_break(parts, spaced, depth + 1)
                render(item, parts, spaced, depth + 1)
            line_break(parts, spaced, depth)
            parts.push("]")
        .Object(fields) =>
            if fields.len() == 0:
                parts.push("{}")
                return
            parts.push("{")
            let first = true
            for entry in fields:
                if !first:
                    parts.push(",")
                first = false
                line_break(parts, spaced, depth + 1)
                push_quoted(parts, entry._0)
                parts.push(if spaced: ": " else: ":")
                render(entry._1, parts, spaced, depth + 1)
            line_break(parts, spaced, depth)
            parts.push("}")

fn line_break(parts: &mut List[string], spaced: bool, depth: usize) -> void:
    if !spaced:
        return
    parts.push("\n")
    if depth > 0:
        parts.push("  ".repeat(depth))

fn push_quoted(parts: &mut List[string], text: string) -> void:
    parts.push("\"")
    push_escaped(parts, text)
    parts.push("\"")

# The inside of a quoted string: `"` and `\` escaped, the control
# characters below U+0020 as `\b`, `\f`, `\n`, `\r`, `\t`, or `\u00XX` with
# lowercase hex, and every other scalar value as itself
# (r-std-json.display.text). Each run of bytes that needs no escape goes in
# whole, as a slice that shares the string's bytes; an escaped byte is
# ASCII, so every run starts and ends on a scalar boundary.
fn push_escaped(parts: &mut List[string], text: string) -> void:
    size := bytes_len(text)
    let plain: usize = 0
    let index = bytes_index_json(text, 0)
    while index < size:
        if index > plain:
            parts.push(bytes_slice(text, plain, index))
        parts.push(escape_text(bytes_at(text, index)))
        plain = index + 1
        index = bytes_index_json(text, plain)
    if plain == 0:
        if size > 0:
            parts.push(text)
    else if plain < size:
        parts.push(bytes_slice(text, plain, size))

fn escape_text(byte: u8) -> string:
    match byte:
        34 => "\\\""
        92 => "\\\\"
        8 => "\\b"
        12 => "\\f"
        10 => "\\n"
        13 => "\\r"
        9 => "\\t"
        _ =>
            let mut bytes: List[u8] = [92, 117, 48, 48]
            bytes.push(hex_symbol(byte >> 4))
            bytes.push(hex_symbol(byte & 15))
            string_from_bytes(bytes)

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

# Why parsing failed, at a byte offset into the text (r-std-json.error.position-bytes), or why
# decoding failed, at a path such as `$.users[2].name`
# (r-std-json.error.variants).
## The error that `parse` and `decode` return: seven parse errors at a byte position, and three decode errors at a path.
## See [std-json.error.variants](../../spec/std/json.md#r-std-json.error.variants).
@error
@derive(Debug, Eq)
pub enum JsonError:
    # The text stops inside a value; `position` is its length.
    @error("unexpected end of text at position $position")
    UnexpectedEnd(position: usize)
    # A character the grammar does not allow there.
    @error("unexpected character at position $position")
    UnexpectedCharacter(position: usize)
    # A bad escape; `position` is its backslash.
    @error("invalid escape at position $position")
    InvalidEscape(position: usize)
    # A `\u` surrogate with no partner; `position` is its backslash.
    @error("lone surrogate escape at position $position")
    LoneSurrogate(position: usize)
    # A raw control character inside a string.
    @error("control character in a string at position $position")
    ControlCharacter(position: usize)
    # A number past the finite f64 range; `position` is its first character.
    @error("number out of range at position $position")
    NumberOutOfRange(position: usize)
    # An array or object nested deeper than 128 levels; `position` is its
    # opening bracket.
    @error("nesting too deep at position $position")
    NestingTooDeep(position: usize)
    # A value of the wrong kind, or a number out of the type's range;
    # `expected` names what the decoder reads (r-std-json.error.kind.type).
    @error("expected $expected at $path")
    WrongType(path: string, expected: string)
    # An object without a key that its type needs.
    @error("missing field at $path")
    MissingField(path: string)
    # A variant name that the enum does not declare.
    @error("unknown variant \"$name\" at $path")
    UnknownVariant(path: string, name: string)

# Strict RFC 8259 text to a `Json` (r-std-json.parse).
## Reads one JSON text, strictly as RFC 8259 defines it, and returns `.Ok` of the value or `.Err` of the first error.
## See [std-json.parse](../../spec/std/json.md#r-std-json.parse).
pub fn parse(text: string) -> Result[Json, JsonError]:
    parser := &mut Parser {
        text: text,
        size: bytes_len(text),
        at: 0,
        index: [],
        pending: [],
        held: 0,
    }
    value := parser.value(0)?
    parser.skip_space()
    if parser.at < parser.size:
        return .Err(JsonError.UnexpectedCharacter(parser.at))
    .Ok(value)

# A recursive descent over the input's own bytes, read through `bytes_at`;
# `at` is the offset of the next byte to read. A string with no escape is
# a slice of the input, which shares its bytes: the input is a valid string
# and the slice starts and ends next to a quote, so it needs no check.
#
# `validate` also writes the structural index that `decode` reads instead
# of scanning the text again. Each non-empty array or object has one entry,
# written when it closes. Its first word is twice its member count, plus 1
# for an object whose keys may repeat; its second is the offset after its
# closing bracket. An object then has each member's key quote and value
# offset. Last come the entries of the container values, in order: an
# array records nothing for a scalar item, so a list of scalars costs two
# words. An empty container's entry is 0, and `index[0]` is 0, so entry 0
# reads as a container with no members. While a container is open, its
# members wait in `pending`, whose first `held` words are live; both lists
# are reused across the whole document, never a buffer per container.
struct Parser:
    text: string
    size: usize
    at: usize
    index: List[usize]
    pending: List[usize]
    held: usize

impl Parser:
    # Validate without retaining an untyped container, and return the
    # value's index entry. Decode validates first so a syntax error still
    # wins over any later typed-reader error.
    fn validate(&mut self, depth: usize) -> Result[usize, JsonError]:
        self.skip_space()
        start := self.at
        if start >= self.size:
            return .Err(self.unexpected(start))
        byte := bytes_at(self.text, start)
        if byte == 34:
            _ := self.validate_string()?
            return .Ok(0)
        if byte == 116:
            self.validate_word("true")?
            return .Ok(0)
        if byte == 102:
            self.validate_word("false")?
            return .Ok(0)
        if byte == 110:
            self.validate_word("null")?
            return .Ok(0)
        if byte == 45 || is_digit(byte):
            self.validate_number()?
            return .Ok(0)
        if byte != 91 && byte != 123:
            return .Err(self.unexpected(start))
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(start))
        object := byte == 123
        let close: u8 = if object: 125 else: 93
        mark := self.held
        # A bit per key's length and first byte: a repeated bit, or an
        # escaped key, marks the object as one whose keys may repeat.
        let seen: u64 = 0
        let repeats: usize = 0
        self.at = start + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == close:
            self.at = self.at + 1
            return .Ok(0)
        while true:
            if object:
                key := self.at
                if key >= self.size || bytes_at(self.text, key) != 34:
                    return .Err(self.unexpected(key))
                if self.validate_string()?:
                    length := self.at - key - 2
                    let first: u64 = if length > 0: u64(bytes_at(self.text, key + 1)) else: 0
                    let bit: u64 = 1 << ((u64(length) * 31 + first) & 63)
                    if seen & bit != 0:
                        repeats = 1
                    seen = seen | bit
                else:
                    repeats = 1
                self.skip_space()
                if self.at >= self.size || bytes_at(self.text, self.at) != 58:
                    return .Err(self.unexpected(self.at))
                self.at = self.at + 1
                self.skip_space()
                value := self.at
                entry := self.validate(depth + 1)?
                self.hold(key)
                self.hold(value)
                self.hold(entry)
            else:
                self.skip_space()
                item := if self.at < self.size: bytes_at(self.text, self.at) else: 0
                entry := self.validate(depth + 1)?
                if item == 91 || item == 123:
                    self.hold(entry)
            self.skip_space()
            index := self.at
            if index < self.size:
                next := bytes_at(self.text, index)
                if next == close:
                    self.at = index + 1
                    return .Ok(
                        if object: self.close_object(mark, repeats) else: self.close_array(mark)
                        ,
                    )
                if next == 44:
                    self.at = index + 1
                    if object:
                        self.skip_space()
                    continue
            return .Err(self.unexpected(index))

    # Keep one word of an open container's member.
    fn hold(&mut self, word: usize) -> void:
        held := self.held
        if held < self.pending.len():
            self.pending[held] = word
        else:
            self.pending.push(word)
        self.held = held + 1

    # Move the child entries held since `mark` into a new array entry, and
    # return its position.
    fn close_array(&mut self, mark: usize) -> usize:
        entry := self.index.len()
        held := self.held
        self.index.push((held - mark) * 2)
        self.index.push(self.at)
        let word = mark
        while word < held:
            self.index.push(self.pending[word])
            word = word + 1
        self.held = mark
        entry

    # Move the members held since `mark`, as key, value and entry, into a
    # new object entry, and return its position.
    fn close_object(&mut self, mark: usize, repeats: usize) -> usize:
        entry := self.index.len()
        held := self.held
        self.index.push((held - mark) / 3 * 2 + repeats)
        self.index.push(self.at)
        let word = mark
        while word < held:
            self.index.push(self.pending[word])
            self.index.push(self.pending[word + 1])
            word = word + 3
        word = mark
        while word < held:
            value := bytes_at(self.text, self.pending[word + 1])
            if value == 91 || value == 123:
                self.index.push(self.pending[word + 2])
            word = word + 3
        self.held = mark
        entry

    # The entry of member `slot`'s value at `at`, in the object whose entry
    # is `object` with `count` members: 0 for a scalar, else the child entry
    # after those of the container values before it.
    fn child_of(&self, object: usize, count: usize, slot: usize, at: usize) -> usize:
        byte := bytes_at(self.text, at)
        if byte != 91 && byte != 123:
            return 0
        let child: usize = 0
        let before: usize = 0
        while before < slot:
            value := bytes_at(self.text, self.index[object + 3 + 2 * before])
            if value == 91 || value == 123:
                child = child + 1
            before = before + 1
        self.index[object + 2 + 2 * count + child]

    # Move to the next item of a validated list after `cursor`, past any
    # comma, and return its first byte, which is `]` after the last item.
    fn list_item(&mut self, cursor: usize) -> u8:
        self.at = cursor
        self.skip_space()
        if bytes_at(self.text, self.at) == 44:
            self.at = self.at + 1
            self.skip_space()
        bytes_at(self.text, self.at)

    # The decoded key whose opening quote is at `quote`.
    fn key_at(&mut self, quote: usize) -> Result[string, JsonError]:
        self.at = quote
        self.string()

    # Whether the key whose opening quote is at `quote` decodes to `name`.
    # The bytes compare in place; only a key with an escape is decoded.
    fn key_is(&mut self, quote: usize, name: string) -> Result[bool, JsonError]:
        size := bytes_len(name)
        start := quote + 1
        let offset: usize = 0
        while offset <= size:
            byte := bytes_at(self.text, start + offset)
            if byte == 92:
                return .Ok(self.key_at(quote)? == name)
            if byte == 34:
                return .Ok(offset == size)
            if offset == size || byte != bytes_at(name, offset):
                return .Ok(false)
            offset = offset + 1
        .Ok(false)

    # The offset after the validated value at `at`, whose entry is
    # `entry`: a minimal scan with no error checks.
    fn value_end(&self, at: usize, entry: usize) -> usize:
        byte := bytes_at(self.text, at)
        if byte == 91 || byte == 123:
            if entry > 0:
                return self.index[entry + 1]
            let index = at + 1
            while true:
                next := bytes_at(self.text, index)
                if next == 93 || next == 125:
                    return index + 1
                index = index + 1
        if byte == 34:
            let index = at + 1
            while true:
                index = bytes_index_json(self.text, index)
                if bytes_at(self.text, index) == 34:
                    return index + 1
                index = index + 2
        let index = at + 1
        while index < self.size:
            next := bytes_at(self.text, index)
            if (
                next == 44
                || next == 93
                || next == 125
                || next == 32
                || next == 9
                || next == 10
                || next == 13
            ):
                return index
            index = index + 1
        index

    # Syntax-only scalar readers retain no Json, Number, or decoded string.
    fn validate_word(&mut self, word: string) -> Result[void, JsonError]:
        size := self.size
        let offset: usize = 0
        while offset < bytes_len(word):
            index := self.at + offset
            if index >= size || bytes_at(self.text, index) != bytes_at(word, offset):
                return .Err(self.unexpected(index))
            offset = offset + 1
        self.at = self.at + offset
        .Ok(())

    # Whether the string had no escape.
    fn validate_string(&mut self) -> Result[bool, JsonError]:
        size := self.size
        let index = self.at + 1
        let plain = true
        while true:
            index = bytes_index_json(self.text, index)
            if index >= size:
                return .Err(JsonError.UnexpectedEnd(index))
            byte := bytes_at(self.text, index)
            if byte == 34:
                self.at = index + 1
                return .Ok(plain)
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            plain = false
            backslash := index
            if index + 1 >= size:
                return .Err(JsonError.UnexpectedEnd(index + 1))
            escaped := bytes_at(self.text, index + 1)
            index = index + 2
            if escaped == 117:
                unit := self.hex4(index)
                if unit == -2:
                    return .Err(JsonError.UnexpectedEnd(size))
                if unit < 0:
                    return .Err(JsonError.InvalidEscape(backslash))
                index = index + 4
                if unit >= 56320 && unit <= 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                if unit >= 55296 && unit <= 56319:
                    low := if (
                        index + 1 < size
                        && bytes_at(self.text, index) == 92
                        && bytes_at(self.text, index + 1) == 117
                    ):
                        self.hex4(index + 2)
                    else:
                        -1
                    if low < 56320 || low > 57343:
                        return .Err(JsonError.LoneSurrogate(backslash))
                    index = index + 6
            else if (
                escaped != 34
                && escaped != 92
                && escaped != 47
                && escaped != 98
                && escaped != 102
                && escaped != 110
                && escaped != 114
                && escaped != 116
            ):
                return .Err(JsonError.InvalidEscape(backslash))

    fn validate_number(&mut self) -> Result[void, JsonError]:
        size := self.size
        start := self.at
        let index = start
        if bytes_at(self.text, index) == 45:
            index = index + 1
        if index >= size:
            return .Err(self.unexpected(index))
        first := bytes_at(self.text, index)
        if first == 48:
            index = index + 1
        else if first >= 49 && first <= 57:
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        else:
            return .Err(self.unexpected(index))
        let floating = false
        if index < size && bytes_at(self.text, index) == 46:
            floating = true
            index = index + 1
            if index >= size || !is_digit(bytes_at(self.text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        if index < size && (bytes_at(self.text, index) == 101 || bytes_at(self.text, index) == 69):
            floating = true
            index = index + 1
            if (
                index < size
                && (bytes_at(self.text, index) == 43 || bytes_at(self.text, index) == 45)
            ):
                index = index + 1
            if index >= size || !is_digit(bytes_at(self.text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        # At most 19 digits fit within the integer representations; larger
        # integers and floats still use the shared range/finite checks.
        if floating || index - start > 19:
            _ := self.number()?
        self.at = index
        .Ok(())

    # The error for a byte that cannot continue the text at `offset`.
    fn unexpected(&self, offset: usize) -> JsonError:
        if offset >= self.size:
            return JsonError.UnexpectedEnd(offset)
        JsonError.UnexpectedCharacter(offset)

    fn skip_space(&mut self) -> void:
        size := self.size
        let index = self.at
        while index < size:
            byte := bytes_at(self.text, index)
            if byte != 32 && byte != 9 && byte != 10 && byte != 13:
                break
            index = index + 1
        self.at = index

    # The value after any whitespace at `at`.
    fn value(&mut self, depth: usize) -> Result[Json, JsonError]:
        self.skip_space()
        index := self.at
        if index >= self.size:
            return .Err(JsonError.UnexpectedEnd(index))
        byte := bytes_at(self.text, index)
        if byte == 34:
            return .Ok(Json.Text(self.string()?))
        if byte == 123:
            return self.object(depth)
        if byte == 91:
            return self.array(depth)
        if byte == 116:
            return self.word("true", Json.Bool(true))
        if byte == 102:
            return self.word("false", Json.Bool(false))
        if byte == 110:
            return self.word("null", Json.Null)
        if byte == 45 || (byte >= 48 && byte <= 57):
            return self.number()
        .Err(JsonError.UnexpectedCharacter(index))

    fn word(&mut self, word: string, value: Json) -> Result[Json, JsonError]:
        text := self.text
        size := bytes_len(word)
        let index = self.at
        let offset: usize = 0
        while offset < size:
            if index >= self.size || bytes_at(text, index) != bytes_at(word, offset):
                return .Err(self.unexpected(index))
            index = index + 1
            offset = offset + 1
        self.at = index
        .Ok(value)

    # The array whose `[` is at `at`.
    fn array(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut items: List[Json] = []
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 93:
            self.at = self.at + 1
            return .Ok(Json.Array(items))
        while true:
            items.push(self.value(depth + 1)?)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    continue
                if byte == 93:
                    self.at = index + 1
                    return .Ok(Json.Array(items))
            return .Err(self.unexpected(index))

    # The object whose `{` is at `at`.
    fn object(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut fields = JsonObject::new()
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 125:
            self.at = self.at + 1
            return .Ok(Json.Object(fields))
        while true:
            quote := self.at
            if quote >= self.size || bytes_at(self.text, quote) != 34:
                return .Err(self.unexpected(quote))
            key := self.string()?
            self.skip_space()
            colon := self.at
            if colon >= self.size || bytes_at(self.text, colon) != 58:
                return .Err(self.unexpected(colon))
            self.at = colon + 1
            found := self.value(depth + 1)?
            fields.set(key, found)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    self.skip_space()
                    continue
                if byte == 125:
                    self.at = index + 1
                    return .Ok(Json.Object(fields))
            return .Err(self.unexpected(index))

    # The string whose opening quote is at `at`: a slice of the input when
    # it has no escape.
    fn string(&mut self) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        start := self.at + 1
        index := bytes_index_json(text, start)
        if index >= size:
            return .Err(JsonError.UnexpectedEnd(index))
        byte := bytes_at(text, index)
        if byte == 34:
            self.at = index + 1
            return .Ok(bytes_slice(text, start, index))
        if byte == 92:
            return self.escaped(start, index)
        .Err(JsonError.ControlCharacter(index))

    # The rest of a string that starts at `start` and has its first escape
    # at `index`. Each run between escapes is a slice of the input, each
    # escape the text it stands for, and the pieces are joined once.
    fn escaped(&mut self, start: usize, first: usize) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        let mut parts: List[string] = []
        let plain = start
        let index = first
        while true:
            index = bytes_index_json(text, index)
            if index >= size:
                return .Err(JsonError.UnexpectedEnd(index))
            byte := bytes_at(text, index)
            if byte == 34:
                if index > plain:
                    parts.push(bytes_slice(text, plain, index))
                self.at = index + 1
                return .Ok(concat_all(parts))
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            if index > plain:
                parts.push(bytes_slice(text, plain, index))
            backslash := index
            if index + 1 >= size:
                return .Err(JsonError.UnexpectedEnd(index + 1))
            escaped := bytes_at(text, index + 1)
            index = index + 2
            if escaped == 34:
                parts.push("\"")
            else if escaped == 92:
                parts.push("\\")
            else if escaped == 47:
                parts.push("/")
            else if escaped == 98:
                parts.push("\u{8}")
            else if escaped == 102:
                parts.push("\u{c}")
            else if escaped == 110:
                parts.push("\n")
            else if escaped == 114:
                parts.push("\r")
            else if escaped == 116:
                parts.push("\t")
            else if escaped == 117:
                unit := self.hex4(index)
                if unit == -2:
                    return .Err(JsonError.UnexpectedEnd(size))
                if unit < 0:
                    return .Err(JsonError.InvalidEscape(backslash))
                index = index + 4
                let point = unit
                if unit >= 56320 && unit <= 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                if unit >= 55296 && unit <= 56319:
                    low := if (
                        index + 1 < size
                        && bytes_at(text, index) == 92
                        && bytes_at(text, index + 1) == 117
                    ):
                        self.hex4(index + 2)
                    else:
                        -1
                    if low < 56320 || low > 57343:
                        return .Err(JsonError.LoneSurrogate(backslash))
                    point = 65536 + (unit - 55296) * 1024 + (low - 56320)
                    index = index + 6
                parts.push(scalar_text(point))
            else:
                return .Err(JsonError.InvalidEscape(backslash))
            plain = index

    # The value of the four hex digits at `at`, -1 when one is not a hex
    # digit, or -2 when the text ends first.
    fn hex4(&self, at: usize) -> i32:
        let value: i32 = 0
        let offset: usize = 0
        while offset < 4:
            if at + offset >= self.size:
                return -2
            digit := hex_value(i32(bytes_at(self.text, at + offset)))
            if digit < 0:
                return -1
            value = value * 16 + digit
            offset = offset + 1
        value

    # The number that starts at `at`: `-`? then `0` or a nonzero digit and
    # digits. An integer in the i64 or u64 range is exact; `-0` is the float
    # -0.0, as in serde_json. A fraction, an exponent, or an integer past
    # both ranges is the float that `f64` parsing gives
    # (r-std-json.parse.number.float-via-parse).
    fn number(&mut self) -> Result[Json, JsonError]:
        text := self.text
        size := self.size
        start := self.at
        let index = start
        negative := bytes_at(text, index) == 45
        if negative:
            index = index + 1
        if index >= size:
            return .Err(self.unexpected(index))
        let magnitude: u64 = 0
        let overflow = false
        first := bytes_at(text, index)
        if first == 48:
            index = index + 1
        else if first >= 49 && first <= 57:
            while index < size && is_digit(bytes_at(text, index)):
                digit := u64(bytes_at(text, index) - 48)
                if magnitude > (u64_max() - digit) / 10:
                    overflow = true
                else:
                    magnitude = magnitude * 10 + digit
                index = index + 1
        else:
            return .Err(self.unexpected(index))
        let exotic = false
        if index < size && bytes_at(text, index) == 46:
            index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(text, index)):
                index = index + 1
            exotic = true
        if index < size && (bytes_at(text, index) == 101 || bytes_at(text, index) == 69):
            index = index + 1
            if index < size && (bytes_at(text, index) == 43 || bytes_at(text, index) == 45):
                index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(text, index)):
                index = index + 1
            exotic = true
        self.at = index
        if exotic || overflow || (negative && magnitude > sign_limit()):
            return float_number(text, start, index)
        if !negative:
            return .Ok(Json.Number(Number::from_u64(magnitude)))
        if magnitude == 0:
            match Number::from_f64(-0.0):
                .Some(zero) => return .Ok(Json.Number(zero))
                .None => return float_number(text, start, index)
        if magnitude == sign_limit():
            return .Ok(Json.Number(Number::from_i64(-9223372036854775808)))
        .Ok(Json.Number(Number::from_i64(-i64(magnitude))))

fn is_digit(byte: u8) -> bool:
    byte >= 48 && byte <= 57

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        return code - 48
    if code >= 97 && code <= 102:
        return code - 87
    if code >= 65 && code <= 70:
        return code - 55
    -1

# The UTF-8 text of a scalar value, which is never a surrogate.
fn scalar_text(point: i32) -> string:
    let mut out: List[u8] = []
    if point < 128:
        out.push(u8(point))
    else if point < 2048:
        out.push(u8(192 + (point >> 6)))
        out.push(u8(128 + (point & 63)))
    else if point < 65536:
        out.push(u8(224 + (point >> 12)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    else:
        out.push(u8(240 + (point >> 18)))
        out.push(u8(128 + ((point >> 12) & 63)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    string_from_bytes(out)

# 2^63, the first u64 past the i64 range, and the largest u64.
fn sign_limit() -> u64:
    9223372036854775808

fn u64_max() -> u64:
    18446744073709551615

# The float of the number text from `start` up to `end`, which the caller
# has read to the end of its grammar; past the f64 range it is a
# `NumberOutOfRange` at `start` (r-std-json.parse.number.nonfinite-parse-result).
fn float_number(text: string, start: usize, end: usize) -> Result[Json, JsonError]:
    # Name the string method explicitly beside this module's JSON parse entry.
    value := match string::parse::[f64](bytes_slice(text, start, end)):
        .Ok(found) => found
        .Err(_) => panic("std.json: a JSON number is valid f64 text")
    match Number::from_f64(value):
        .Some(number) => .Ok(Json.Number(number))
        .None => .Err(JsonError.NumberOutOfRange(start))

# Keep handwritten Debug: hide the representation variant behind Number(value).
impl Debug for Number:
    fn debug(self, out: *mut DebugWriter) -> void:
        match self.repr:
            .Negative(value) => out.debug_tuple("Number").field(value).finish()
            .NonNegative(value) => out.debug_tuple("Number").field(value).finish()
            .Float(value) => out.debug_tuple("Number").field(value).finish()

# One `debug_list` entry per member, in insertion order.
# Keep handwritten Debug: render entries as a list rather than storage fields.
impl Debug for JsonObject:
    fn debug(self, out: *mut DebugWriter) -> void:
        list := out.debug_list()
        for entry in self.entries:
            _ := list.entry(entry)
        list.finish()

# ---------------------------------------------------------------------------
# Typed JSON (spec/std/json.md#typed-json): JSON as a format that reads the
# `std.serde` opt-in. `to_json` writes a value through `JsonWriter`,
# `encode` writes its text through `TextWriter`, and `from_json` reads one
# through `JsonReader`.

# The `Json` of a value (r-std-json.to-json).
## The `Json` that `value`'s `serialize` writes.
## See [std-json.to-json](../../spec/std/json.md#r-std-json.to-json).
pub fn to_json[T < Serialize](value: T) -> Json:
    writer := &mut JsonWriter {
        result: Json.Null,
        pending: "",
        keys: [],
        values: [],
        frames: [],
        no_facts: Facts { items: [] },
    }
    match value.serialize(writer):
        .Ok(_) => writer.result
        .Err(_) => panic("std.json: the JSON writer never fails")

# The value that a `Json` describes, or the first decode error
# (r-std-json.from-json).
## The `T` that `T::deserialize` reads from `value`, or the first error it finds.
## See [std-json.from-json](../../spec/std/json.md#r-std-json.from-json).
pub fn from_json[T < Deserialize](value: Json) -> Result[T, JsonError]:
    reader := JsonReader::new(value)
    T::deserialize(reader)

# The compact text of a value's `Json` (r-std-json.encode). `TextWriter`
# writes that text during the walk, with no `Json` in between; a walk it
# does not write directly goes through the tree, which defines the text.
## The compact JSON text of `value`, with no whitespace outside strings.
## See [std-json.encode](../../spec/std/json.md#r-std-json.encode).
pub fn encode[T < Serialize](value: T) -> string:
    writer := TextWriter::new(false)
    _ := value.serialize(writer)
    match writer.finish():
        .Some(text) => text
        .None => encode_fallback(value)

# The pretty text of a value's `Json` (r-std-json.encode-pretty), written
# by `TextWriter` in its spaced layout, or through the tree as `encode`
# falls back.
## The pretty JSON text of `value`: `to_json(value).pretty()`.
## See [std-json.encode-pretty](../../spec/std/json.md#r-std-json.encode-pretty).
pub fn encode_pretty[T < Serialize](value: T) -> string:
    writer := TextWriter::new(true)
    _ := value.serialize(writer)
    match writer.finish():
        .Some(text) => text
        .None => encode_pretty_fallback(value)

# Read validated text directly through the typed deserializer (r-std-json.decode.direct).
## Reads a typed value directly from validated JSON text.
## See [std-json.decode.direct](../../spec/std/json.md#r-std-json.decode.direct).
pub fn decode[T < Deserialize](text: string) -> Result[T, JsonError]:
    let mut parser = Parser {
        text: text,
        size: bytes_len(text),
        at: 0,
        index: [0, 0],
        pending: [],
        held: 0,
    }
    root := parser.validate(0)?
    parser.skip_space()
    if parser.at != parser.size:
        return .Err(parser.unexpected(parser.at))
    T::deserialize(TextReader::new(parser, root))

# `Json` writes and reads itself (r-std-json.std.json).
# Keep handwritten Serialize: write the JSON value itself, not an externally tagged enum.
impl Serialize for Json:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        match self:
            .Null => out.null()
            .Bool(flag) => out.bool(flag)
            .Number(number) =>
                match number.repr:
                    .Negative(found) => out.int(found)
                    .NonNegative(found) => out.uint(found)
                    .Float(found) => out.float(found)
            .Text(text) => out.text(text)
            .Array(items) =>
                out.begin_list(items.len())?
                for item in items:
                    item.serialize(out)?
                out.end_list()
            .Object(fields) =>
                out.begin_map(fields.len())?
                for entry in fields:
                    out.key(entry._0)?
                    entry._1.serialize(out)?
                out.end_map()

# Keep handwritten Deserialize: read the JSON value itself, not an externally tagged enum.
impl Deserialize for Json:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Json, R::Error]:
        match input.peek()?:
            .Null =>
                _ := input.is_null()?
                .Ok(Json.Null)
            .Bool => .Ok(Json.Bool(input.bool("bool")?))
            .Int => .Ok(Json.Number(Number::from_i64(input.int("i64")?)))
            .Uint => .Ok(Json.Number(Number::from_u64(input.uint("u64")?)))
            .Float =>
                found := input.float("f64")?
                match Number::from_f64(found):
                    .Some(number) => .Ok(Json.Number(number))
                    .None => .Ok(Json.Null)
            .Text => .Ok(Json.Text(input.text("string")?))
            .List =>
                input.begin_list()?
                let mut items: List[Json] = []
                while input.next_item()?:
                    items.push(Json::deserialize(input)?)
                .Ok(Json.Array(items))
            .Map =>
                input.begin_map()?
                let mut fields = JsonObject::new()
                while true:
                    match input.next_key()?:
                        .Some(key) => fields.set(key, Json::deserialize(input)?)
                        .None => break
                .Ok(Json.Object(fields))

# One open list, map, or variant of the writer: its kind, where its items
# start in `values`, the key it goes under in its own container, and a
# variant's name and form.
struct OpenFrame:
    pub kind: i32
    pub start: usize
    pub key: string
    pub name: string
    pub of_data: bool
    pub facts: Facts

# Builds the `Json` of one value. The items of every open container sit on
# one stack, `values`, each beside its key in `keys`; closing a container
# replaces its items with its value (r-std-json.derive.to-json.data-included-members).
struct JsonWriter:
    pub result: Json
    pub pending: string
    pub keys: List[string]
    pub values: List[Json]
    pub frames: List[OpenFrame]
    # The facts of a list or a map frame, and of a member with no frame,
    # made once per writer.
    pub no_facts: Facts

impl JsonWriter:
    fn put(&mut self, value: Json) -> Result[void, never]:
        if self.frames.len() == 0:
            self.result = value
        else:
            self.keys.push(self.pending)
            self.values.push(value)
        .Ok(())

    fn open(&mut self, kind: i32, name: string, of_data: bool, facts: Facts) -> Result[void, never]:
        self.frames.push(
            OpenFrame {
                kind: kind,
                start: self.values.len(),
                key: self.pending,
                name: name,
                of_data: of_data,
                facts: facts,
            },
        )
        .Ok(())

    # The innermost frame, its items, and its keys, popped.
    fn close(&mut self) -> (OpenFrame, List[string], List[Json]):
        frame := match self.frames.pop():
            .Some(found) => found
            .None => panic("std.json: a close without an open container")
        let mut keys: List[string] = []
        let mut values: List[Json] = []
        let index = frame.start
        while index < self.values.len():
            keys.push(self.keys[index])
            values.push(self.values[index])
            index = index + 1
        while self.values.len() > frame.start:
            _ := self.values.pop()
            _ := self.keys.pop()
        self.pending = frame.key
        (frame, keys, values)

impl Serializer for JsonWriter:
    type Error = never

    fn null(&mut self) -> Result[void, never]:
        self.put(Json.Null)

    fn bool(&mut self, value: bool) -> Result[void, never]:
        self.put(Json.Bool(value))

    fn int(&mut self, value: i64) -> Result[void, never]:
        self.put(Json.Number(Number::from_i64(value)))

    fn uint(&mut self, value: u64) -> Result[void, never]:
        self.put(Json.Number(Number::from_u64(value)))

    # A NaN or an infinity has no JSON number, so it writes `null`, as in
    # serde_json (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, never]:
        match Number::from_f64(value):
            .Some(number) => self.put(Json.Number(number))
            .None => self.put(Json.Null)

    fn text(&mut self, value: string) -> Result[void, never]:
        self.put(Json.Text(value))

    fn begin_list(&mut self, len: usize) -> Result[void, never]:
        self.open(0, "", false, self.no_facts)

    fn end_list(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Array(closed._2))

    fn begin_map(&mut self, len: usize) -> Result[void, never]:
        self.open(1, "", false, self.no_facts)

    fn key(&mut self, key: string) -> Result[void, never]:
        self.pending = key
        .Ok(())

    fn end_map(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.open(2, v.name, true, facts)

    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        # Kind 3 preserves the object payload of a named or mixed variant
        # even when every member is statically skipped.
        let kind: i32 = if !v.of_data && v.named > 0: 3 else: 2
        self.open(kind, v.name, v.of_data, facts)

    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.begin_map(1)?
        self.key(v.name)?
        self.frames[self.frames.len() - 1].name = v.name
        .Ok(())

    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, never]:
        self.begin_map(1)?
        self.key(v.name)?
        self.begin_list(len)?
        self.frames[self.frames.len() - 1].name = v.name
        .Ok(())

    fn member(&mut self, m: &Member) -> Result[void, never]:
        facts := if self.frames.is_empty():
            self.no_facts
        else:
            self.frames[self.frames.len() - 1].facts
        self.pending = member_name(m, facts)
        .Ok(())

    fn end_data(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    # A data type is an object; a variant with no member is its name, and
    # other variant forms follow their included members
    # (r-std-json.derive.to-json.included-enum-form).
    fn end_variant(&mut self) -> Result[void, never]:
        frame := self.frames[self.frames.len() - 1]
        if frame.name != "" && frame.kind == 0:
            self.end_list()?
            return self.end_map()
        if frame.name != "" && frame.kind == 1:
            return self.end_map()
        closed := self.close()
        closed_frame := closed._0
        fields := object_of(closed._1, closed._2)
        if closed_frame.of_data:
            return self.put(Json.Object(fields))
        if fields.len() == 0 && closed_frame.kind != 3:
            return self.put(Json.Text(closed_frame.name))
        let mut outer = JsonObject::new()
        outer.set(closed_frame.name, Json.Object(fields))
        self.put(Json.Object(outer))

fn object_of(keys: List[string], values: List[Json]) -> JsonObject:
    let mut fields = JsonObject::new()
    let index: usize = 0
    while index < keys.len():
        fields.set(keys[index], values[index])
        index = index + 1
    fields

# What an open container of the text writer is.
enum FrameKind:
    # A list, or an enum tuple variant when its stored name is nonempty.
    Items
    # A map, or an enum newtype variant when its stored name is nonempty.
    Entries
    # A data type's object.
    Record
    # An enum variant: its name, or `{"Variant":{...}}`.
    Tagged
    # A named or mixed enum variant, including an empty object payload.
    Named

# The writer met a walk that it does not write directly.
enum Irregular:
    Walk

# Writes the compact text of the `Json` that `JsonWriter` would build, or
# its pretty text when `spaced` is true, as
# the walk reaches each part, into pieces joined once at the end. It writes
# the walks that derived and standard implementations make: one value, a
# key before each value in an object, every key new in its object, and each
# end matching its begin. Any other walk sets `regular` to false and stops,
# and `encode` builds the tree instead: the tree's rules for a missing,
# stale, or repeated key, or for a second value, are the definition.
#
# The open containers are a stack of `depth` frames in four lists: each
# frame's kind, its variant name, its number of values so far, and where
# its keys start in `keys`. An object's first 16 keys sit in `keys`, with a
# cheap print of each in `prints`; a larger object moves its keys into a
# map on `indexes`. The stacks keep their slots when a frame closes, and
# the next frame reuses them. `indent` is the nesting level of the pretty
# text: a list, a map, or a record adds one, and a variant two, for its
# `{"Variant": {` once a member opens it.
struct TextWriter:
    pub parts: *mut List[string]
    pub depth: usize
    pub kinds: List[FrameKind]
    pub names: List[string]
    pub counts: List[usize]
    pub key_starts: List[usize]
    pub facts: List[Facts]
    # The facts of a list or a map frame, made once per writer.
    pub no_facts: Facts
    pub key_count: usize
    pub keys: List[string]
    pub prints: List[usize]
    pub pending: string
    pub keyed: bool
    pub written: bool
    pub regular: bool
    pub spaced: bool
    pub indent: usize

impl TextWriter:
    fn new(spaced: bool) -> *mut TextWriter:
        &mut TextWriter {
            parts: &mut [],
            depth: 0,
            kinds: [],
            names: [],
            counts: [],
            key_starts: [],
            facts: [],
            no_facts: Facts { items: [] },
            key_count: 0,
            keys: [],
            prints: [],
            pending: "",
            keyed: false,
            written: false,
            regular: true,
            spaced: spaced,
            indent: 0,
        }

    # The text, or `.None` when the walk was not regular or not complete.
    fn finish(&self) -> string?:
        if !self.regular || !self.written || self.depth > 0:
            return .None
        .Some(concat_all(*self.parts))

    fn give_up(&mut self) -> Result[void, Irregular]:
        self.regular = false
        .Err(Irregular.Walk)

    # Starts one value: a comma after an earlier item, and in an object the
    # value's key, which must be new there. The first member of an enum
    # variant opens `{"Variant":{` first.
    fn start(&mut self) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0:
            if self.written:
                return self.give_up()
            self.written = true
            return .Ok(())
        last := self.depth - 1
        count := self.counts[last]
        self.counts[last] = count + 1
        kind := self.kinds[last]
        match kind:
            .Items =>
                if count > 0:
                    self.parts.push(",")
                line_break(self.parts, self.spaced, self.indent)
                return .Ok(())
            _ => pass
        if !self.keyed:
            return self.give_up()
        key := self.pending
        self.keyed = false
        if !self.add_key(last, key):
            return self.give_up()
        if self.spaced:
            self.spaced_key(kind, count, self.names[last], key)
            return .Ok(())
        if count > 0:
            self.parts.push(",\"")
        else:
            match kind:
                .Tagged =>
                    self.parts.push("{\"")
                    push_escaped(self.parts, self.names[last])
                    self.parts.push("\":{\"")
                .Named =>
                    self.parts.push("{\"")
                    push_escaped(self.parts, self.names[last])
                    self.parts.push("\":{\"")
                _ => self.parts.push("\"")
        push_escaped(self.parts, key)
        self.parts.push("\":")
        .Ok(())

    # The pretty text before a value of an object: a comma after an earlier
    # entry, a line break, and `"key": `. The first member of a variant
    # opens `{`, its name, and `: {` first, each on its own line.
    fn spaced_key(&mut self, kind: FrameKind, count: usize, name: string, key: string) -> void:
        if count > 0:
            self.parts.push(",")
        else:
            match kind:
                .Tagged =>
                    self.parts.push("{")
                    line_break(self.parts, true, self.indent - 1)
                    push_quoted(self.parts, name)
                    self.parts.push(": {")
                .Named =>
                    self.parts.push("{")
                    line_break(self.parts, true, self.indent - 1)
                    push_quoted(self.parts, name)
                    self.parts.push(": {")
                _ => pass
        line_break(self.parts, true, self.indent)
        push_quoted(self.parts, key)
        self.parts.push(": ")

    # Reuse the writer's key slots across objects. No object allocates a
    # duplicate-key map; nested objects use disjoint ranges of the buffer.
    fn add_key(&mut self, frame: usize, key: string) -> bool:
        start := self.key_starts[frame]
        print := key_print(key)
        let at: usize = start
        while at < self.key_count:
            if self.prints[at] == print && self.keys[at] == key:
                return false
            at = at + 1
        if at < self.keys.len():
            self.keys[at] = key
            self.prints[at] = print
        else:
            self.keys.push(key)
            self.prints.push(print)
        self.key_count = at + 1
        true

    fn open(&mut self, kind: FrameKind, name: string, facts: Facts) -> Result[void, Irregular]:
        self.start()?
        match kind:
            .Items => self.parts.push("[")
            .Tagged => pass
            .Named => pass
            _ => self.parts.push("{")
        at := self.depth
        if at < self.kinds.len():
            self.kinds[at] = kind
            self.names[at] = name
            self.counts[at] = 0
            self.key_starts[at] = self.key_count
            self.facts[at] = facts
        else:
            self.kinds.push(kind)
            self.names.push(name)
            self.counts.push(0)
            self.key_starts.push(self.key_count)
            self.facts.push(facts)
        self.depth = at + 1
        self.indent = self.indent + levels_of(kind)
        .Ok(())

    # Ends the innermost frame, which must be of `kind`; `Record` also ends
    # a `Tagged` frame. A variant with no member is its name
    # (r-std-json.derive.to-json.unit-form).
    fn close(&mut self, kind: FrameKind) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        last := self.depth - 1
        count := self.counts[last]
        open_kind := self.kinds[last]
        let spaced = self.spaced && count > 0
        match (kind, open_kind):
            (.Items, .Items) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("]")
            (.Entries, .Entries) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("}")
            (.Record, .Record) =>
                line_break(self.parts, spaced, self.indent - 1)
                self.parts.push("}")
            (.Record, .Tagged) =>
                if spaced:
                    line_break(self.parts, true, self.indent - 1)
                    self.parts.push("}")
                    line_break(self.parts, true, self.indent - 2)
                    self.parts.push("}")
                else if count > 0:
                    self.parts.push("}}")
                else:
                    push_quoted(self.parts, self.names[last])
            (.Record, .Named) =>
                if count > 0:
                    if spaced:
                        line_break(self.parts, true, self.indent - 1)
                        self.parts.push("}")
                        line_break(self.parts, true, self.indent - 2)
                        self.parts.push("}")
                    else:
                        self.parts.push("}}")
                else if self.spaced:
                    self.parts.push("{")
                    line_break(self.parts, true, self.indent - 1)
                    push_quoted(self.parts, self.names[last])
                    self.parts.push(": {}")
                    line_break(self.parts, true, self.indent - 2)
                    self.parts.push("}")
                else:
                    self.parts.push("{\"")
                    push_escaped(self.parts, self.names[last])
                    self.parts.push("\":{}}")
            _ => return self.give_up()
        self.key_count = self.key_starts[last]
        self.depth = last
        self.indent = self.indent - levels_of(open_kind)
        .Ok(())

    # A key or a member name names the next value of an object.
    fn name_next(&mut self, key: string) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        match self.kinds[self.depth - 1]:
            .Items => return self.give_up()
            _ => pass
        self.pending = key
        self.keyed = true
        .Ok(())

    fn scalar(&mut self, text: string) -> Result[void, Irregular]:
        self.start()?
        self.parts.push(text)
        .Ok(())

impl Serializer for TextWriter:
    type Error = Irregular

    fn null(&mut self) -> Result[void, Irregular]:
        self.scalar("null")

    fn bool(&mut self, value: bool) -> Result[void, Irregular]:
        self.scalar(if value: "true" else: "false")

    fn int(&mut self, value: i64) -> Result[void, Irregular]:
        self.scalar("$value")

    fn uint(&mut self, value: u64) -> Result[void, Irregular]:
        self.scalar("$value")

    # A NaN or an infinity writes `null` (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, Irregular]:
        if value.is_finite():
            return self.scalar("$value")
        self.scalar("null")

    fn text(&mut self, value: string) -> Result[void, Irregular]:
        self.start()?
        push_quoted(self.parts, value)
        .Ok(())

    fn begin_list(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Items, "", self.no_facts)

    fn end_list(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Items)

    fn begin_map(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Entries, "", self.no_facts)

    fn key(&mut self, key: string) -> Result[void, Irregular]:
        self.name_next(key)

    fn end_map(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Entries)

    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        self.open(FrameKind.Record, v.name, facts)

    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        kind := if v.of_data:
            FrameKind.Record
        else if v.named > 0:
            FrameKind.Named
        else:
            FrameKind.Tagged
        self.open(kind, v.name, facts)

    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        self.begin_map(1)?
        self.key(v.name)?
        self.names[self.depth - 1] = v.name
        .Ok(())

    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, Irregular]:
        self.begin_map(1)?
        self.key(v.name)?
        self.begin_list(len)?
        self.names[self.depth - 1] = v.name
        .Ok(())

    fn member(&mut self, m: &Member) -> Result[void, Irregular]:
        if !self.regular || self.depth == 0:
            return self.give_up()
        self.name_next(member_name(m, self.facts[self.depth - 1]))

    fn end_data(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Record)

    fn end_variant(&mut self) -> Result[void, Irregular]:
        if self.depth == 0:
            return self.give_up()
        last := self.depth - 1
        if self.names[last] != "":
            match self.kinds[last]:
                .Items =>
                    self.end_list()?
                    return self.end_map()
                .Entries => return self.end_map()
                _ => pass
        self.close(FrameKind.Record)

# The nesting levels a frame adds to the pretty text: a variant's
# `{"Variant": {` is two.
fn levels_of(kind: FrameKind) -> usize:
    match kind:
        .Tagged => 2
        .Named => 2
        _ => 1

# A key's length with its first and last bytes: equal keys have equal
# prints, and most different keys of one object do not.
fn key_print(key: string) -> usize:
    size := bytes_len(key)
    if size == 0:
        return 0
    size * 65536 + usize(bytes_at(key, 0)) * 256 + usize(bytes_at(key, size - 1))

# What an open container of the reader is.
enum ReadKind:
    # A list, read with `next_item`.
    Items
    # A map, read with `next_key`.
    Entries
    # A data type's object, read with `member`.
    Record
    # An enum variant's payload, read with `member`; its path adds `.Variant`.
    Tagged
    # An enum variant written as its name, with no payload.
    Unit

# Reads one `Json` for `from_json`. `value` is the value at the cursor, and
# `present` is false for a member whose key is missing.
#
# The cursor's path (r-std-json.error.path) is written out only for an
# error. Until then it is its first `depth` steps: step `i` is the item
# index `steps[i]`, or the key `names[i]` when `steps[i]` is -1. The open
# containers are a stack of `open` frames in parallel lists: the container,
# its kind, its next index (for a variant, the member index after the last
# one found), the path depth of its items' container, the depth to restore
# when it closes, and a variant's name. A variant frame's container is the
# payload object, or `null` for a variant written as its name. The stacks
# keep their slots when a frame closes, and the next frame reuses them.
struct JsonReader:
    pub value: Json
    pub present: bool
    pub depth: usize
    pub steps: List[i64]
    pub names: List[string]
    pub open: usize
    pub containers: List[Json]
    pub kinds: List[ReadKind]
    pub next: List[usize]
    pub bases: List[usize]
    pub homes: List[usize]
    pub variants: List[string]
    pub facts: List[Facts]
    # The facts of a list or a map frame, made once per reader.
    pub no_facts: Facts

impl JsonReader:
    fn new(value: Json) -> *mut JsonReader:
        &mut JsonReader {
            value: value,
            present: true,
            depth: 0,
            steps: [],
            names: [],
            open: 0,
            containers: [],
            kinds: [],
            next: [],
            bases: [],
            homes: [],
            variants: [],
            facts: [],
            no_facts: Facts { items: [] },
        }

    # The path of the first `depth` steps: `$`, then `.key` or `[index]`
    # for each.
    fn path_to(&self, depth: usize) -> string:
        let mut parts: List[string] = ["\$"]
        let index: usize = 0
        while index < depth:
            step := self.steps[index]
            if step < 0:
                parts.push(".")
                parts.push(self.names[index])
            else:
                parts.push("[$step]")
            index = index + 1
        concat_all(parts)

    # A missing key is a `MissingField`; any other value that does not fit
    # is a `WrongType` (r-std-json.derive.from-json.missing).
    fn fail(&self, expected: string) -> JsonError:
        path := self.path_to(self.depth)
        if !self.present:
            return JsonError.MissingField(path)
        JsonError.WrongType(path, expected)

    fn step_index(&mut self, slot: usize, index: usize) -> void:
        if slot < self.steps.len():
            self.steps[slot] = i64(index)
        else:
            self.steps.push(i64(index))
            self.names.push("")

    fn step_key(&mut self, slot: usize, key: string) -> void:
        if slot < self.steps.len():
            self.steps[slot] = -1
            self.names[slot] = key
        else:
            self.steps.push(-1)
            self.names.push(key)

    # Opens a frame whose items' container is at path depth `base`.
    fn enter(
        &mut self,
        container: Json,
        kind: ReadKind,
        base: usize,
        name: string,
        facts: Facts,
    ) -> void:
        at := self.open
        if at < self.containers.len():
            self.containers[at] = container
            self.kinds[at] = kind
            self.next[at] = 0
            self.bases[at] = base
            self.homes[at] = self.depth
            self.variants[at] = name
            self.facts[at] = facts
        else:
            self.containers.push(container)
            self.kinds.push(kind)
            self.next.push(0)
            self.bases.push(base)
            self.homes.push(self.depth)
            self.variants.push(name)
            self.facts.push(facts)
        self.open = at + 1

    # The innermost frame.
    fn top(&self) -> usize:
        if self.open == 0:
            panic("std.json: no open container")
        self.open - 1

    # Closes the innermost frame; the cursor's path is its container's
    # again.
    fn leave(&mut self) -> void:
        last := self.top()
        self.depth = self.homes[last]
        self.open = last

    # The item, or the map value, at `index` of the frame `last`, with its
    # path step.
    fn read_item(&mut self, last: usize, value: Json, index: usize) -> void:
        self.next[last] = index + 1
        self.value = value
        self.present = true
        base := self.bases[last]
        self.step_index(base, index)
        self.depth = base + 1

    # Moves the cursor to the member called `name` of the variant frame
    # `last`: its value, or absent. A decoder reads the members in
    # declaration order, which is most often the text's, so the entry after
    # the last one found is tried before a search.
    fn find_member(&mut self, last: usize, name: string) -> void:
        match self.containers[last]:
            .Object(fields) =>
                entries := fields.entries
                let at = self.next[last]
                if at >= entries.len() || entries[at]._0 != name:
                    match fields.position(name):
                        .Some(found) => at = found
                        .None =>
                            self.value = Json.Null
                            self.present = false
                            return
                self.next[last] = at + 1
                self.value = entries[at]._1
                self.present = true
            _ =>
                self.value = Json.Null
                self.present = false

impl Deserializer for JsonReader:
    type Error = JsonError

    fn peek(&mut self) -> Result[ValueKind, JsonError]:
        if !self.present:
            return .Ok(ValueKind.Null)
        match self.value:
            .Null => .Ok(ValueKind.Null)
            .Bool(_) => .Ok(ValueKind.Bool)
            .Number(number) =>
                match number.repr:
                    .Negative(_) => .Ok(ValueKind.Int)
                    .NonNegative(found) =>
                        if found < sign_limit(): .Ok(ValueKind.Int) else: .Ok(ValueKind.Uint)
                    .Float(_) => .Ok(ValueKind.Float)
            .Text(_) => .Ok(ValueKind.Text)
            .Array(_) => .Ok(ValueKind.List)
            .Object(_) => .Ok(ValueKind.Map)

    # A missing key reads as `null` (r-std-json.derive.from-json.missing).
    fn is_null(&mut self) -> Result[bool, JsonError]:
        .Ok(!self.present || self.value.is_null())

    fn bool(&mut self, expected: string) -> Result[bool, JsonError]:
        if self.present:
            match self.value:
                .Bool(flag) => return .Ok(flag)
                _ => pass
        .Err(self.fail(expected))

    # A float is never an integer (r-std-json.std.integer.read).
    fn int(&mut self, expected: string) -> Result[i64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_i64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn uint(&mut self, expected: string) -> Result[u64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_u64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn float(&mut self, expected: string) -> Result[f64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_f64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn text(&mut self, expected: string) -> Result[string, JsonError]:
        if self.present:
            match self.value:
                .Text(found) => return .Ok(found)
                _ => pass
        .Err(self.fail(expected))

    fn begin_list(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Array(_) =>
                    self.enter(self.value, ReadKind.Items, self.depth, "", self.no_facts)
                    return .Ok(())
                _ => pass
        .Err(self.fail("array"))

    # An item's path adds `[index]` (r-std-json.std.item-path). A map's
    # items are its values; a variant has none.
    fn next_item(&mut self) -> Result[bool, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            self.read_item(last, items[index], index)
                            return .Ok(true)
                    _ => pass
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        if index < fields.entries.len():
                            self.read_item(last, fields.entries[index]._1, index)
                            return .Ok(true)
                    _ => pass
            _ => pass
        self.leave()
        .Ok(false)

    fn begin_map(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Object(_) =>
                    self.enter(self.value, ReadKind.Entries, self.depth, "", self.no_facts)
                    return .Ok(())
                _ => pass
        .Err(self.fail("object"))

    # A map value's path adds `.key` (r-std-json.std.item-path). A list
    # has no keys, and a variant has none to iterate.
    fn next_key(&mut self) -> Result[string?, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        if index < fields.entries.len():
                            entry := fields.entries[index]
                            self.next[last] = index + 1
                            self.value = entry._1
                            self.present = true
                            base := self.bases[last]
                            self.step_key(base, entry._0)
                            self.depth = base + 1
                            return .Ok(.Some(entry._0))
                    _ => pass
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            panic("std.json: next_key in a list")
                    _ => pass
            _ => pass
        self.leave()
        .Ok(.None)

    fn begin_data(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if self.present:
            match self.value:
                .Object(_) =>
                    self.enter(self.value, ReadKind.Record, self.depth, "", facts)
                    return .Ok(0)
                _ => pass
        .Err(self.fail("object"))

    # A data type reads an object. An enum reads `"Variant"` as
    # `{"Variant": {}}`, or an object with exactly one key
    # (r-std-json.derive.from-json.enum).
    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, JsonError]:
        if choices.len() == 1 && choices[0].of_data:
            if self.present:
                match self.value:
                    .Object(_) =>
                        self.enter(self.value, ReadKind.Record, self.depth, "", facts)
                        return .Ok(0)
                    _ => pass
            return .Err(self.fail("object"))
        if !self.present:
            return .Err(self.fail("variant"))
        let name = ""
        let payload = Json.Null
        let named = false
        match self.value:
            .Text(text) =>
                name = text
                named = true
            .Object(fields) =>
                if fields.len() != 1:
                    return .Err(self.fail("variant"))
                entry := fields.entries[0]
                name = entry._0
                payload = entry._1
            _ => return .Err(self.fail("variant"))
        let index: usize = 0
        while index < choices.len():
            if choices[index].name == name:
                depth := self.depth
                self.step_key(depth, name)
                self.enter(
                    payload,
                    if named: ReadKind.Unit else: ReadKind.Tagged,
                    depth + 1,
                    name,
                    facts,
                )
                return .Ok(index)
            index = index + 1
        .Err(JsonError.UnknownVariant(self.path_to(self.depth), name))

    fn begin_newtype_variant(&mut self) -> Result[void, JsonError]:
        last := self.top()
        match self.kinds[last]:
            .Tagged =>
                self.kinds[last] = ReadKind.Unit
                if self.present:
                    self.next[last] = 1
                    self.value = self.containers[last]
                    self.depth = self.bases[last]
                    return .Ok(())
            _ => pass
        .Err(self.fail("newtype variant"))

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, JsonError]:
        last := self.top()
        base := self.bases[last]
        self.depth = base
        match self.kinds[last]:
            .Tagged =>
                match self.containers[last]:
                    .Array(items) =>
                        if items.len() == len:
                            self.kinds[last] = ReadKind.Items
                            self.next[last] = 0
                            return .Ok(())
                    _ => pass
            _ => pass
        .Err(self.fail("array of $len items"))

    # A member reads the value of its key; a missing key is absent
    # (r-std-json.derive.from-json.member-wire-name). A list or a map has no members.
    fn member(&mut self, m: &Member) -> Result[void, JsonError]:
        last := self.top()
        name := member_name(m, self.facts[last])
        base := self.bases[last]
        match self.kinds[last]:
            .Record => self.find_member(last, name)
            .Tagged =>
                self.step_key(base - 1, self.variants[last])
                match self.containers[last]:
                    .Object(_) => self.find_member(last, name)
                    _ => return .Err(JsonError.WrongType(self.path_to(base), "object"))
            _ =>
                self.value = Json.Null
                self.present = false
        self.step_key(base, name)
        self.depth = base + 1
        .Ok(())

    fn end_data(&mut self) -> Result[void, JsonError]:
        self.leave()
        .Ok(())

    fn end_variant(&mut self) -> Result[void, JsonError]:
        last := self.top()
        match self.kinds[last]:
            .Tagged =>
                match self.containers[last]:
                    .Object(_) => pass
                    _ =>
                        base := self.bases[last]
                        self.step_key(base - 1, self.variants[last])
                        return .Err(JsonError.WrongType(self.path_to(base), "object"))
            _ => pass
        self.leave()
        .Ok(())

    fn invalid(&mut self, expected: string) -> JsonError:
        self.fail(expected)

    # A missing key is absent, so a member with a declared default takes
    # it (r-std-json.derive.from-json.default).
    fn is_absent(&mut self) -> bool:
        !self.present

# The text reader keeps offsets, not Json values. It moves through the
# index that `validate` wrote (see `Parser`): a list scans to each item and
# jumps over a container item to its recorded end, and a record finds a key
# among its entry's members. A map and a record of more than 16 members
# list their distinct keys in reusable frame buffers. Frames are reused by
# depth, so retained storage is the active containers, never the document
# tree.
struct TextReadFrame:
    pub kind: ReadKind
    # The raw offset of this frame's value.
    pub at: usize
    # The container's index entry, and its member count there.
    pub entry: usize
    pub count: usize
    # Whether the object's keys may repeat, so a key's last member must be found.
    pub repeats: bool
    pub next: usize
    # A list's offset after its last item read, and its next child entry.
    pub cursor: usize
    pub child: usize
    # The distinct keys, first occurrence first, and the value offset and
    # entry of each one's last member; filled by `scan_object` only.
    pub keys: List[string]
    pub key_count: usize
    pub offsets: List[usize]
    pub children: List[usize]
    pub positions: Map[string, usize]
    pub base: usize
    pub home: usize
    pub name: string
    pub facts: Facts

struct TextReader:
    pub parser: *mut Parser
    pub at: usize
    # The index entry of the value at `at` (0 for a scalar).
    pub entry: usize
    pub present: bool
    pub depth: usize
    pub steps: List[i64]
    pub names: List[string]
    pub open: usize
    pub frames: List[*mut TextReadFrame]
    # The facts of a list or a map frame, made once per reader.
    pub no_facts: Facts

impl TextReader:
    fn new(parser: Parser, root: usize) -> *mut TextReader:
        let mut source = parser
        source.at = 0
        source.skip_space()
        &mut TextReader {
            parser: &mut source,
            at: source.at,
            entry: root,
            present: true,
            depth: 0,
            steps: [],
            names: [],
            open: 0,
            frames: [],
            no_facts: Facts { items: [] },
        }

    fn path_to(&self, depth: usize) -> string:
        let mut parts: List[string] = ["\$"]
        let index: usize = 0
        while index < depth:
            step := self.steps[index]
            if step < 0:
                parts.push("." + self.names[index])
            else:
                parts.push("[$step]")
            index = index + 1
        concat_all(parts)

    fn fail(&self, expected: string) -> JsonError:
        path := self.path_to(self.depth)
        if !self.present:
            return JsonError.MissingField(path)
        JsonError.WrongType(path, expected)

    fn step_index(&mut self, slot: usize, index: usize) -> void:
        if slot < self.steps.len():
            self.steps[slot] = i64(index)
        else:
            self.steps.push(i64(index))
            self.names.push("")

    fn step_key(&mut self, slot: usize, key: string) -> void:
        if slot < self.steps.len():
            self.steps[slot] = -1
            self.names[slot] = key
        else:
            self.steps.push(-1)
            self.names.push(key)

    fn byte(&mut self) -> u8:
        self.parser.at = self.at
        bytes_at(self.parser.text, self.at)

    # Move to the value of member `slot` of the object whose entry is
    # `object`, with `count` members.
    fn at_slot(&mut self, object: usize, count: usize, slot: usize) -> void:
        at := self.parser.index[object + 3 + 2 * slot]
        self.at = at
        self.entry = self.parser.child_of(object, count, slot, at)

    # List the distinct keys of the frame's object: the first occurrence
    # fixes key order and the last one the value, matching JsonObject. Small
    # objects need no map, and their unescaped keys remain input slices.
    fn scan_object(&mut self, frame: &mut TextReadFrame) -> Result[void, JsonError]:
        frame.key_count = 0
        if frame.positions.len() > 0:
            frame.positions = {}
        let member: usize = 0
        let child = frame.entry + 2 + 2 * frame.count
        while member < frame.count:
            key := self.parser.key_at(self.parser.index[frame.entry + 2 + 2 * member])?
            value := self.parser.index[frame.entry + 3 + 2 * member]
            byte := bytes_at(self.parser.text, value)
            let entry: usize = 0
            if byte == 91 || byte == 123:
                entry = self.parser.index[child]
                child = child + 1
            let slot = frame.key_count
            if frame.key_count <= 16:
                let i: usize = 0
                while i < frame.key_count:
                    if frame.keys[i] == key:
                        slot = i
                        break
                    i = i + 1
            else:
                slot = frame.positions.get(key).unwrap_or(frame.key_count)
            if slot == frame.key_count:
                if slot < frame.keys.len():
                    frame.keys[slot] = key
                    frame.offsets[slot] = value
                    frame.children[slot] = entry
                else:
                    frame.keys.push(key)
                    frame.offsets.push(value)
                    frame.children.push(entry)
                frame.key_count = slot + 1
                if frame.key_count == 17:
                    let i: usize = 0
                    while i < frame.key_count:
                        frame.positions[frame.keys[i]] = i
                        i = i + 1
                else if frame.key_count > 17:
                    frame.positions[key] = slot
            else:
                frame.offsets[slot] = value
                frame.children[slot] = entry
            member = member + 1
        .Ok(())

    fn enter(
        &mut self,
        at: usize,
        entry: usize,
        kind: ReadKind,
        base: usize,
        name: string,
        facts: Facts,
    ) -> Result[void, JsonError]:
        slot := self.open
        if slot == self.frames.len():
            self.frames.push(
                &mut TextReadFrame {
                    kind: kind,
                    at: 0,
                    entry: 0,
                    count: 0,
                    repeats: false,
                    next: 0,
                    cursor: 0,
                    child: 0,
                    keys: [],
                    key_count: 0,
                    offsets: [],
                    children: [],
                    positions: {},
                    base: base,
                    home: self.depth,
                    name: name,
                    facts: facts,
                },
            )
        frame := self.frames[slot]
        frame.kind = kind
        frame.at = at
        frame.entry = entry
        let head: usize = 0
        match kind:
            .Unit => pass
            .Tagged =>
                if bytes_at(self.parser.text, at) == 123:
                    head = self.parser.index[entry]
            _ => head = self.parser.index[entry]
        frame.count = head / 2
        frame.repeats = head % 2 == 1
        frame.next = 0
        frame.cursor = at + 1
        frame.child = 0
        frame.key_count = 0
        frame.base = base
        frame.home = self.depth
        frame.name = name
        frame.facts = facts
        match kind:
            .Items => pass
            .Entries => self.scan_object(frame)?
            _ =>
                if frame.count > 16:
                    self.scan_object(frame)?
        self.open = slot + 1
        .Ok(())

    fn top(&self) -> *mut TextReadFrame:
        if self.open == 0:
            panic("std.json: no open container")
        self.frames[self.open - 1]

    fn leave(&mut self) -> void:
        self.depth = self.top().home
        self.open = self.open - 1

    fn number(&mut self) -> Result[Number?, JsonError]:
        if self.present:
            byte := self.byte()
            if byte == 45 || is_digit(byte):
                match self.parser.number()?:
                    .Number(value) => return .Ok(.Some(value))
                    _ => pass
        .Ok(.None)

impl Deserializer for TextReader:
    type Error = JsonError

    fn peek(&mut self) -> Result[ValueKind, JsonError]:
        if !self.present:
            return .Ok(ValueKind.Null)
        byte := self.byte()
        if byte == 110:
            return .Ok(ValueKind.Null)
        if byte == 116 || byte == 102:
            return .Ok(ValueKind.Bool)
        if byte == 34:
            return .Ok(ValueKind.Text)
        if byte == 91:
            return .Ok(ValueKind.List)
        if byte == 123:
            return .Ok(ValueKind.Map)
        match self.number()?:
            .Some(number) =>
                match number.repr:
                    .Negative(_) => return .Ok(ValueKind.Int)
                    .NonNegative(found) =>
                        return .Ok(if found < sign_limit(): ValueKind.Int else: ValueKind.Uint)
                    .Float(_) => return .Ok(ValueKind.Float)
            .None => pass
        .Err(self.fail("value"))

    fn is_null(&mut self) -> Result[bool, JsonError]:
        .Ok(!self.present || self.byte() == 110)

    fn bool(&mut self, expected: string) -> Result[bool, JsonError]:
        if self.present:
            byte := self.byte()
            if byte == 116:
                return .Ok(true)
            if byte == 102:
                return .Ok(false)
        .Err(self.fail(expected))

    fn int(&mut self, expected: string) -> Result[i64, JsonError]:
        match self.number()?:
            .Some(number) =>
                match number.as_i64():
                    .Some(value) => return .Ok(value)
                    .None => pass
            .None => pass
        .Err(self.fail(expected))

    fn uint(&mut self, expected: string) -> Result[u64, JsonError]:
        match self.number()?:
            .Some(number) =>
                match number.as_u64():
                    .Some(value) => return .Ok(value)
                    .None => pass
            .None => pass
        .Err(self.fail(expected))

    fn float(&mut self, expected: string) -> Result[f64, JsonError]:
        match self.number()?:
            .Some(number) =>
                match number.as_f64():
                    .Some(value) => return .Ok(value)
                    .None => pass
            .None => pass
        .Err(self.fail(expected))

    fn text(&mut self, expected: string) -> Result[string, JsonError]:
        if self.present && self.byte() == 34:
            return self.parser.string()
        .Err(self.fail(expected))

    fn begin_list(&mut self) -> Result[void, JsonError]:
        if self.present && self.byte() == 91:
            return self.enter(self.at, self.entry, ReadKind.Items, self.depth, "", self.no_facts)
        .Err(self.fail("array"))

    fn next_item(&mut self) -> Result[bool, JsonError]:
        frame := self.top()
        index := frame.next
        let found = false
        match frame.kind:
            .Items =>
                byte := self.parser.list_item(frame.cursor)
                at := self.parser.at
                if byte != 93:
                    let entry: usize = 0
                    if byte == 91 || byte == 123:
                        entry = self.parser.index[frame.entry + 2 + frame.child]
                        frame.child = frame.child + 1
                    frame.cursor = self.parser.value_end(at, entry)
                    self.at = at
                    self.entry = entry
                    found = true
            .Entries =>
                if index < frame.key_count:
                    self.at = frame.offsets[index]
                    self.entry = frame.children[index]
                    found = true
            _ => pass
        if found:
            frame.next = index + 1
            self.present = true
            self.step_index(frame.base, index)
            self.depth = frame.base + 1
            return .Ok(true)
        self.leave()
        .Ok(false)

    fn begin_map(&mut self) -> Result[void, JsonError]:
        if self.present && self.byte() == 123:
            return self.enter(self.at, self.entry, ReadKind.Entries, self.depth, "", self.no_facts)
        .Err(self.fail("object"))

    fn next_key(&mut self) -> Result[string?, JsonError]:
        frame := self.top()
        index := frame.next
        match frame.kind:
            .Entries =>
                if index < frame.key_count:
                    key := frame.keys[index]
                    self.at = frame.offsets[index]
                    self.entry = frame.children[index]
                    self.present = true
                    frame.next = index + 1
                    self.step_key(frame.base, key)
                    self.depth = frame.base + 1
                    return .Ok(.Some(key))
            .Items =>
                if self.parser.list_item(frame.cursor) != 93:
                    panic("std.json: next_key in a list")
            _ => pass
        self.leave()
        .Ok(.None)

    fn begin_data(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if self.present && self.byte() == 123:
            self.enter(self.at, self.entry, ReadKind.Record, self.depth, "", facts)?
            return .Ok(0)
        .Err(self.fail("object"))

    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, JsonError]:
        if choices.len() == 1 && choices[0].of_data:
            if self.present && self.byte() == 123:
                self.enter(self.at, self.entry, ReadKind.Record, self.depth, "", facts)?
                return .Ok(0)
            return .Err(self.fail("object"))
        if !self.present:
            return .Err(self.fail("variant"))
        byte := self.byte()
        let name = ""
        let payload: usize? = .None
        if byte == 34:
            name = self.parser.string()?
        else if byte == 123:
            # Exactly one distinct key: every member has the first one's key,
            # and the last member holds the value.
            object := self.entry
            count := self.parser.index[object] / 2
            if count == 0:
                return .Err(self.fail("variant"))
            name = self.parser.key_at(self.parser.index[object + 2])?
            let other: usize = 1
            while other < count:
                same := self.parser.key_is(self.parser.index[object + 2 + 2 * other], name)?
                if !same:
                    return .Err(self.fail("variant"))
                other = other + 1
            payload = .Some(count - 1)
        else:
            return .Err(self.fail("variant"))
        let index: usize = 0
        while index < choices.len():
            if choices[index].name == name:
                let at: usize = self.at
                let entry: usize = self.entry
                let present = false
                match payload:
                    .Some(slot) =>
                        object := self.entry
                        at = self.parser.index[object + 3 + 2 * slot]
                        entry = self.parser.child_of(
                            object,
                            self.parser.index[object] / 2,
                            slot,
                            at,
                        )
                        present = true
                    .None => pass
                depth := self.depth
                self.step_key(depth, name)
                self.enter(
                    at,
                    entry,
                    if present: ReadKind.Tagged else: ReadKind.Unit,
                    depth + 1,
                    name,
                    facts,
                )?
                return .Ok(index)
            index = index + 1
        .Err(JsonError.UnknownVariant(self.path_to(self.depth), name))

    fn begin_newtype_variant(&mut self) -> Result[void, JsonError]:
        frame := self.top()
        match frame.kind:
            .Tagged =>
                frame.kind = ReadKind.Unit
                self.at = frame.at
                self.entry = frame.entry
                self.present = true
                self.depth = frame.base
                return .Ok(())
            _ => pass
        .Err(self.fail("newtype variant"))

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, JsonError]:
        frame := self.top()
        self.depth = frame.base
        match frame.kind:
            .Tagged =>
                if bytes_at(self.parser.text, frame.at) == 91:
                    let count: usize = 0
                    let cursor = frame.at + 1
                    let child: usize = 0
                    while true:
                        byte := self.parser.list_item(cursor)
                        at := self.parser.at
                        if byte == 93:
                            break
                        let entry: usize = 0
                        if byte == 91 || byte == 123:
                            entry = self.parser.index[frame.entry + 2 + child]
                            child = child + 1
                        cursor = self.parser.value_end(at, entry)
                        count = count + 1
                    if count == len:
                        frame.kind = ReadKind.Items
                        frame.count = count
                        frame.next = 0
                        frame.cursor = frame.at + 1
                        frame.child = 0
                        return .Ok(())
            _ => pass
        .Err(self.fail("array of $len items"))

    fn member(&mut self, m: &Member) -> Result[void, JsonError]:
        frame := self.top()
        name := member_name(m, frame.facts)
        let found = false
        let record = true
        match frame.kind:
            .Record => pass
            .Tagged =>
                self.step_key(frame.base - 1, frame.name)
                if bytes_at(self.parser.text, frame.at) != 123:
                    return .Err(JsonError.WrongType(self.path_to(frame.base), "object"))
            _ => record = false
        if record:
            if frame.count <= 16:
                # With distinct keys, try the member after the last one
                # found, then the first match; when keys may repeat, the
                # last match holds the value.
                let slot = frame.next
                let hit = (
                    !frame.repeats
                    && slot < frame.count
                    && self.parser.key_is(self.parser.index[frame.entry + 2 + 2 * slot], name)?
                )
                if !hit:
                    let probe: usize = 0
                    while probe < frame.count:
                        if self.parser.key_is(
                            self.parser.index[frame.entry + 2 + 2 * probe],
                            name,
                        )?:
                            slot = probe
                            hit = true
                            if !frame.repeats:
                                break
                        probe = probe + 1
                if hit:
                    self.at_slot(frame.entry, frame.count, slot)
                    found = true
                    frame.next = slot + 1
            else:
                let slot = frame.next
                if slot >= frame.key_count || frame.keys[slot] != name:
                    if frame.key_count > 16:
                        slot = frame.positions.get(name).unwrap_or(frame.key_count)
                    else:
                        slot = 0
                        while slot < frame.key_count && frame.keys[slot] != name:
                            slot = slot + 1
                if slot < frame.key_count:
                    self.at = frame.offsets[slot]
                    self.entry = frame.children[slot]
                    found = true
                    frame.next = slot + 1
        self.present = found
        if !found:
            self.at = 0
            self.entry = 0
        self.step_key(frame.base, name)
        self.depth = frame.base + 1
        .Ok(())

    fn end_data(&mut self) -> Result[void, JsonError]:
        self.leave()
        .Ok(())

    fn end_variant(&mut self) -> Result[void, JsonError]:
        frame := self.top()
        match frame.kind:
            .Tagged =>
                if bytes_at(self.parser.text, frame.at) != 123:
                    self.step_key(frame.base - 1, frame.name)
                    return .Err(JsonError.WrongType(self.path_to(frame.base), "object"))
            _ => pass
        self.leave()
        .Ok(())

    fn invalid(&mut self, expected: string) -> JsonError:
        self.fail(expected)

    fn is_absent(&mut self) -> bool:
        !self.present

# Primitives (spec/std/README.md#standard-library-primitives). The compiler
# supplies each body. `@intrinsic` is prototype-internal and accepted only
# in lib/std.

@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

# The bytes from offset `start` up to `end`, sharing them in constant time.
@intrinsic("bytes_slice")
fn bytes_slice(text: string, start: usize, end: usize) -> string:
    panic("intrinsic")

# Every part's bytes in order, copied once into one new string.
@intrinsic("concat_all")
fn concat_all(parts: List[string]) -> string:
    panic("intrinsic")

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# The offset of the first byte at or after `from` that JSON must escape,
# a control byte below 0x20, `"` or `\`, or `bytes_len(text)` when there
# is none. This body defines the result; the compiler supplies a SIMD128
# one (#428).
@intrinsic("bytes_index_json")
fn bytes_index_json(text: string, from: usize) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        byte := bytes_at(text, index)
        if byte < 32 || byte == 34 || byte == 92:
            return index
        index = index + 1
    size

# The offset of the first byte at or after `from` that equals `byte`, or
# `bytes_len(text)` when there is none. This body defines the result; the
# compiler supplies a SIMD128 one (#428).
@intrinsic("bytes_index")
fn bytes_index(text: string, from: usize, byte: u8) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        if bytes_at(text, index) == byte:
            return index
        index = index + 1
    size

# Kept as one call so a closed program whose concrete serializer is known
# to make a regular walk can leave the whole tree path unlinked. These stay
# last so adding the private link boundary changes no existing item ID.
fn encode_fallback[T < Serialize](value: T) -> string:
    "${to_json(value)}"

fn encode_pretty_fallback[T < Serialize](value: T) -> string:
    to_json(value).pretty()
