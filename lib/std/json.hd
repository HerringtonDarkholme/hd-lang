# std.json: the untyped JSON value, its parser, and its writers, and
# typed JSON over the `std.serde` consent: `to_json`, `from_json`,
# `encode`, and `decode` (spec/std/json.md).
use std.format.{DebugWriter, DebugList}
use std.error.Error
use std.num.parse_f64
use std.serde.{Serialize, Deserialize, Serializer, Deserializer, ValueKind}
use std.structure.{VariantInfo, Member, Facts}

# One JSON value (r-std-json.value.decl). An object keeps its members in
# insertion order (r-std-json.object.order).
## A JSON value: `null`, `Bool`, `Number`, `Text`, `Array`, or `Object`.
## See [std-json.value.decl](../../spec/std/json.md#r-std-json.value.decl).
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: Number)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: JsonObject)

# The members of a JSON object (r-std-json.object.decl): `entries` holds them
# in insertion order, and `index` maps each key to its place in `entries`, so
# a lookup does not scan.
## The members of a JSON object, in insertion order.
## See [std-json.object.decl](../../spec/std/json.md#r-std-json.object.decl).
pub data JsonObject:
    entries: mut List[(string, Json)]
    index: mut Map[string, usize]

impl JsonObject:
    ## Returns an object with no members.
    ## See [std-json.object.new](../../spec/std/json.md#r-std-json.object.new).
    pub fn new() -> mut JsonObject:
        let entries: mut List[(string, Json)] = []
        let index: mut Map[string, usize] = {}
        JsonObject { entries: entries, index: index }

    ## Returns the number of members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn len(self) -> usize:
        self.entries.len()

    ## True exactly when the object has no members.
    ## See [std-json.object.len](../../spec/std/json.md#r-std-json.object.len).
    pub fn is_empty(self) -> bool:
        self.entries.len() == 0

    ## The value of `key`, or `.None` when the object has no such key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn get(self, key: string) -> Json?:
        match self.index.get(key):
            .Some(at) => .Some(self.entries[at]._1)
            .None => .None

    ## True exactly when the object has the key.
    ## See [std-json.object.get](../../spec/std/json.md#r-std-json.object.get).
    pub fn contains_key(self, key: string) -> bool:
        self.index.get(key).is_some()

    ## Sets `key` to `value`. A new key goes last, and an existing key keeps its place.
    ## See [std-json.object.set](../../spec/std/json.md#r-std-json.object.set).
    pub fn set(mut self, key: string, value: Json) -> void:
        match self.index.get(key):
            .Some(at) => self.entries[at] = (key, value)
            .None =>
                self.index[key] = self.entries.len()
                self.entries.push((key, value))

    ## The keys, in insertion order.
    ## See [std-json.object.order](../../spec/std/json.md#r-std-json.object.order).
    pub fn keys(self) -> List[string]:
        self.entries.map(fn(entry: (string, Json)) -> string: entry._0)

impl Iterable[(string, Json)] for JsonObject:
    fn iter(self) -> mut Iterator[(string, Json)]:
        self.entries.iter()

# The same members, in any order (r-std-json.value.eq.object).
impl Eq for JsonObject:
    fn eq(self, other: JsonObject) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in self.entries:
            match other.get(key):
                .Some(found) =>
                    if found != value:
                        return false
                .None => return false
        true

# What a `Number` holds: an integer below zero, an integer from zero up, or
# a finite float. Normalized, so one integer has one representation
# (r-std-json.number.repr).
enum NumberRepr:
    Negative(value: i64)
    NonNegative(value: u64)
    Float(value: f64)

# A JSON number that keeps 64-bit integers exact, modeled on
# `serde_json::Number` (r-std-json.number.decl).
## A JSON number, exact for 64-bit integers: integers in the `i64` and `u64` ranges are exact, and every other number is an `f64`.
## See [std-json.number.decl](../../spec/std/json.md#r-std-json.number.decl).
pub data Number:
    repr: NumberRepr

impl Number:
    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.i64](../../spec/std/json.md#r-std-json.number.constructors.i64).
    pub fn from_i64(value: i64) -> Number:
        if value < 0:
            return Number { repr: NumberRepr.Negative(value) }
        Number { repr: NumberRepr.NonNegative(u64(value)) }

    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.u64](../../spec/std/json.md#r-std-json.number.constructors.u64).
    pub fn from_u64(value: u64) -> Number:
        Number { repr: NumberRepr.NonNegative(value) }

    ## Returns the float `value` as a `Number`, or `.None` for a NaN or an infinity.
    ## See [std-json.number.constructors.f64](../../spec/std/json.md#r-std-json.number.constructors.f64).
    pub fn from_f64(value: f64) -> Number?:
        if !value.is_finite():
            return .None
        .Some(Number { repr: NumberRepr.Float(value) })

    ## The integer when it is in the `i64` range, and `.None` for a float.
    ## See [std-json.number.accessors.i64](../../spec/std/json.md#r-std-json.number.accessors.i64).
    pub fn as_i64(self) -> i64?:
        match self.repr:
            .Negative(value) => .Some(value)
            .NonNegative(value) =>
                if value < sign_limit():
                    .Some(i64(value))
                else:
                    .None
            .Float(_) => .None

    ## The integer when it is from zero up, and `.None` for a negative integer or a float.
    ## See [std-json.number.accessors.u64](../../spec/std/json.md#r-std-json.number.accessors.u64).
    pub fn as_u64(self) -> u64?:
        match self.repr:
            .NonNegative(value) => .Some(value)
            _ => .None

    ## `.Some` of the float, or of the integer converted to the nearest `f64`.
    ## See [std-json.number.accessors.f64](../../spec/std/json.md#r-std-json.number.accessors.f64).
    pub fn as_f64(self) -> f64?:
        match self.repr:
            .Negative(value) => .Some(f64(value))
            .NonNegative(value) => .Some(f64(value))
            .Float(value) => .Some(value)

impl Eq for Number:
    fn eq(self, other: Number) -> bool:
        match (self.repr, other.repr):
            (.Negative(left), .Negative(right)) => left == right
            (.NonNegative(left), .NonNegative(right)) => left == right
            (.Float(left), .Float(right)) => left == right
            _ => false

impl Display for Number:
    fn to_string(self) -> string:
        match self.repr:
            .Negative(value) => "$value"
            .NonNegative(value) => "$value"
            .Float(value) => "$value"

impl Json:
    # JSON text with two-space indentation (r-std-json.value.pretty).
    ## The pretty text of the value: each item of an array and each entry of an object on its own line, indented by two spaces for each level of nesting.
    ## See [std-json.value.pretty](../../spec/std/json.md#r-std-json.value.pretty).
    pub fn pretty(self) -> string:
        let out: mut List[u8] = []
        render(self, out, true, 0)
        bytes_text(out)

    ## The value of `key` when the value is an `Object` with that key.
    ## See [std-json.value.accessors.get](../../spec/std/json.md#r-std-json.value.accessors.get).
    pub fn get(self, key: string) -> Json?:
        match self:
            .Object(fields) => fields.get(key)
            _ => .None

    ## The item at `index` when the value is an `Array` and `index` is from 0 up to its length.
    ## See [std-json.value.accessors.at-index](../../spec/std/json.md#r-std-json.value.accessors.at-index).
    pub fn at(self, index: usize) -> Json?:
        match self:
            .Array(items) =>
                if index < items.len():
                    .Some(items[index])
                else:
                    .None
            _ => .None

    ## The string of a `Text` value.
    ## See [std-json.value.accessors.text](../../spec/std/json.md#r-std-json.value.accessors.text).
    pub fn as_text(self) -> string?:
        match self:
            .Text(value) => .Some(value)
            _ => .None

    ## The value of a `Bool`.
    ## See [std-json.value.accessors.bool](../../spec/std/json.md#r-std-json.value.accessors.bool).
    pub fn as_bool(self) -> bool?:
        match self:
            .Bool(value) => .Some(value)
            _ => .None

    ## The `Number` of a `Number` value.
    ## See [std-json.value.accessors.number](../../spec/std/json.md#r-std-json.value.accessors.number).
    pub fn as_number(self) -> Number?:
        match self:
            .Number(value) => .Some(value)
            _ => .None

    ## `true` exactly for `Null`.
    ## See [std-json.value.accessors.null](../../spec/std/json.md#r-std-json.value.accessors.null).
    pub fn is_null(self) -> bool:
        match self:
            .Null => true
            _ => false

impl Eq for Json:
    fn eq(self, other: Json) -> bool:
        match (self, other):
            (.Null, .Null) => true
            (.Bool(left), .Bool(right)) => left == right
            (.Number(left), .Number(right)) => left == right
            (.Text(left), .Text(right)) => left == right
            (.Array(left), .Array(right)) => left == right
            (.Object(left), .Object(right)) => left == right
            _ => false

# Compact JSON text (r-std-json.display.compact).
impl Display for Json:
    fn to_string(self) -> string:
        let out: mut List[u8] = []
        render(self, out, false, 0)
        bytes_text(out)


fn render(value: Json, out: mut List[u8], spaced: bool, depth: usize) -> void:
    match value:
        .Null => push_text(out, "null")
        .Bool(flag) => push_text(out, if flag: "true" else: "false")
        .Number(number) => push_text(out, "$number")
        .Text(text) => render_text(out, text)
        .Array(items) =>
            if items.len() == 0:
                push_text(out, "[]")
                return
            out.push(91)
            let first = true
            for item in items:
                if !first:
                    out.push(44)
                first = false
                line_break(out, spaced, depth + 1)
                render(item, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            out.push(93)
        .Object(fields) =>
            if fields.len() == 0:
                push_text(out, "{}")
                return
            out.push(123)
            let first = true
            for entry in fields:
                if !first:
                    out.push(44)
                first = false
                line_break(out, spaced, depth + 1)
                render_text(out, entry._0)
                out.push(58)
                if spaced:
                    out.push(32)
                render(entry._1, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            out.push(125)

fn line_break(out: mut List[u8], spaced: bool, depth: usize) -> void:
    if !spaced:
        return
    out.push(10)
    let count = depth * 2
    while count > 0:
        out.push(32)
        count = count - 1

fn push_text(out: mut List[u8], text: string) -> void:
    for byte in text.bytes():
        out.push(byte)

# A quoted string: `"` and `\` escaped, the control characters below U+0020
# as `\b`, `\f`, `\n`, `\r`, `\t`, or `\u00XX` with lowercase hex, and
# every other scalar value as itself (r-std-json.display.text).
fn render_text(out: mut List[u8], text: string) -> void:
    out.push(34)
    for byte in text.bytes():
        if byte == 34:
            push_text(out, "\\\"")
        else if byte == 92:
            push_text(out, "\\\\")
        else if byte == 8:
            push_text(out, "\\b")
        else if byte == 12:
            push_text(out, "\\f")
        else if byte == 10:
            push_text(out, "\\n")
        else if byte == 13:
            push_text(out, "\\r")
        else if byte == 9:
            push_text(out, "\\t")
        else if byte < 32:
            push_text(out, "\\u00")
            out.push(hex_symbol(byte >> 4))
            out.push(hex_symbol(byte & 15))
        else:
            out.push(byte)
    out.push(34)

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

fn bytes_text(bytes: List[u8]) -> string:
    match string::from_utf8(bytes):
        .Ok(text) => text
        .Err(_) => panic("std.json: output bytes are valid UTF-8")

# Why parsing failed, at a byte offset into the text (r-std-json.error.position-bytes), or why
# decoding failed, at a path such as `$.users[2].name`
# (r-std-json.error.variants).
## The error that `parse` and `decode` return: seven parse errors at a byte position, and three decode errors at a path.
## See [std-json.error.variants](../../spec/std/json.md#r-std-json.error.variants).
pub enum JsonError:
    # The text stops inside a value; `position` is its length.
    UnexpectedEnd(position: usize)
    # A character the grammar does not allow there.
    UnexpectedCharacter(position: usize)
    # A bad escape; `position` is its backslash.
    InvalidEscape(position: usize)
    # A `\u` surrogate with no partner; `position` is its backslash.
    LoneSurrogate(position: usize)
    # A raw control character inside a string.
    ControlCharacter(position: usize)
    # A number past the finite f64 range; `position` is its first character.
    NumberOutOfRange(position: usize)
    # An array or object nested deeper than 128 levels; `position` is its
    # opening bracket.
    NestingTooDeep(position: usize)
    # A value of the wrong kind, or a number out of the type's range;
    # `expected` names what the decoder reads (r-std-json.error.kind.type).
    WrongType(path: string, expected: string)
    # An object without a key that its type needs.
    MissingField(path: string)
    # A variant name that the enum does not declare.
    UnknownVariant(path: string, name: string)

impl Eq for JsonError:
    fn eq(self, other: JsonError) -> bool:
        match (self, other):
            (.UnexpectedEnd(left), .UnexpectedEnd(right)) => left == right
            (.UnexpectedCharacter(left), .UnexpectedCharacter(right)) => left == right
            (.InvalidEscape(left), .InvalidEscape(right)) => left == right
            (.LoneSurrogate(left), .LoneSurrogate(right)) => left == right
            (.ControlCharacter(left), .ControlCharacter(right)) => left == right
            (.NumberOutOfRange(left), .NumberOutOfRange(right)) => left == right
            (.NestingTooDeep(left), .NestingTooDeep(right)) => left == right
            (.WrongType(left, wanted), .WrongType(right, other)) => left == right && wanted == other
            (.MissingField(left), .MissingField(right)) => left == right
            (.UnknownVariant(left, name), .UnknownVariant(right, other)) => left == right && name == other
            _ => false

impl Display for JsonError:
    fn to_string(self) -> string:
        match self:
            .UnexpectedEnd(position) => "unexpected end of text at position $position"
            .UnexpectedCharacter(position) => "unexpected character at position $position"
            .InvalidEscape(position) => "invalid escape at position $position"
            .LoneSurrogate(position) => "lone surrogate escape at position $position"
            .ControlCharacter(position) => "control character in a string at position $position"
            .NumberOutOfRange(position) => "number out of range at position $position"
            .NestingTooDeep(position) => "nesting too deep at position $position"
            .WrongType(path, expected) => "expected $expected at $path"
            .MissingField(path) => "missing field at $path"
            .UnknownVariant(path, name) => "unknown variant \"$name\" at $path"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for JsonError

data Parsed:
    value: Json
    end: usize

data ParsedText:
    text: string
    end: usize

# Strict RFC 8259 text to a `Json` (r-std-json.parse).
## Reads one JSON text, strictly as RFC 8259 defines it, and returns `.Ok` of the value or `.Err` of the first error.
## See [std-json.parse](../../spec/std/json.md#r-std-json.parse).
pub fn parse(text: string) -> Result[Json, JsonError]:
    bytes := text.to_utf8()
    parsed := parse_value(bytes, 0, 0)?
    end := skip_space(bytes, parsed.end)
    if end < bytes.len():
        return .Err(JsonError.UnexpectedCharacter(end))
    .Ok(parsed.value)

# The error for a byte that cannot continue the text at `offset`.
fn unexpected(bytes: List[u8], offset: usize) -> JsonError:
    if offset >= bytes.len():
        return JsonError.UnexpectedEnd(offset)
    JsonError.UnexpectedCharacter(offset)

fn skip_space(bytes: List[u8], start: usize) -> usize:
    let index = start
    while index < bytes.len():
        byte := bytes[index]
        if byte != 32 && byte != 9 && byte != 10 && byte != 13:
            return index
        index = index + 1
    index

fn parse_value(bytes: List[u8], start: usize, depth: usize) -> Result[Parsed, JsonError]:
    index := skip_space(bytes, start)
    if index >= bytes.len():
        return .Err(unexpected(bytes, index))
    byte := bytes[index]
    if byte == 123:
        return parse_object(bytes, index, depth)
    if byte == 91:
        return parse_array(bytes, index, depth)
    if byte == 34:
        found := parse_string(bytes, index)?
        return .Ok(Parsed { value: Json.Text(found.text), end: found.end })
    if byte == 116:
        return parse_word(bytes, index, "true", Json.Bool(true))
    if byte == 102:
        return parse_word(bytes, index, "false", Json.Bool(false))
    if byte == 110:
        return parse_word(bytes, index, "null", Json.Null)
    if byte == 45 || (byte >= 48 && byte <= 57):
        return parse_number(bytes, index)
    .Err(unexpected(bytes, index))

fn parse_word(bytes: List[u8], start: usize, word: string, value: Json) -> Result[Parsed, JsonError]:
    let index = start
    for expected in word.bytes():
        if index >= bytes.len() || bytes[index] != expected:
            return .Err(unexpected(bytes, index))
        index = index + 1
    .Ok(Parsed { value: value, end: index })

fn parse_array(bytes: List[u8], open: usize, depth: usize) -> Result[Parsed, JsonError]:
    if depth >= 128:
        return .Err(JsonError.NestingTooDeep(open))
    let items: mut List[Json] = []
    let index = skip_space(bytes, open + 1)
    if index < bytes.len() && bytes[index] == 93:
        return .Ok(Parsed { value: Json.Array(items), end: index + 1 })
    while true:
        found := parse_value(bytes, index, depth + 1)?
        items.push(found.value)
        index = skip_space(bytes, found.end)
        if index < bytes.len() && bytes[index] == 44:
            index = index + 1
        else if index < bytes.len() && bytes[index] == 93:
            return .Ok(Parsed { value: Json.Array(items), end: index + 1 })
        else:
            return .Err(unexpected(bytes, index))

fn parse_object(bytes: List[u8], open: usize, depth: usize) -> Result[Parsed, JsonError]:
    if depth >= 128:
        return .Err(JsonError.NestingTooDeep(open))
    let fields: mut JsonObject = JsonObject::new()
    let index = skip_space(bytes, open + 1)
    if index < bytes.len() && bytes[index] == 125:
        return .Ok(Parsed { value: Json.Object(fields), end: index + 1 })
    while true:
        if index >= bytes.len() || bytes[index] != 34:
            return .Err(unexpected(bytes, index))
        key := parse_string(bytes, index)?
        index = skip_space(bytes, key.end)
        if index >= bytes.len() || bytes[index] != 58:
            return .Err(unexpected(bytes, index))
        found := parse_value(bytes, index + 1, depth + 1)?
        fields.set(key.text, found.value)
        index = skip_space(bytes, found.end)
        if index < bytes.len() && bytes[index] == 44:
            index = skip_space(bytes, index + 1)
        else if index < bytes.len() && bytes[index] == 125:
            return .Ok(Parsed { value: Json.Object(fields), end: index + 1 })
        else:
            return .Err(unexpected(bytes, index))

# The string that starts at the quote at `open`.
fn parse_string(bytes: List[u8], open: usize) -> Result[ParsedText, JsonError]:
    let buffer: mut List[u8] = []
    let index = open + 1
    while true:
        if index >= bytes.len():
            return .Err(unexpected(bytes, index))
        byte := bytes[index]
        if byte == 34:
            return .Ok(ParsedText { text: bytes_text(buffer), end: index + 1 })
        if byte < 32:
            return .Err(JsonError.ControlCharacter(index))
        if byte != 92:
            buffer.push(byte)
            index = index + 1
            continue
        backslash := index
        if index + 1 >= bytes.len():
            return .Err(unexpected(bytes, index + 1))
        escaped := bytes[index + 1]
        index = index + 2
        if escaped == 34 || escaped == 92 || escaped == 47:
            buffer.push(escaped)
        else if escaped == 98:
            buffer.push(8)
        else if escaped == 102:
            buffer.push(12)
        else if escaped == 110:
            buffer.push(10)
        else if escaped == 114:
            buffer.push(13)
        else if escaped == 116:
            buffer.push(9)
        else if escaped == 117:
            unit := read_hex4(bytes, index)
            if unit == -2:
                return .Err(unexpected(bytes, bytes.len()))
            if unit < 0:
                return .Err(JsonError.InvalidEscape(backslash))
            index = index + 4
            let point = unit
            if unit >= 56320 && unit <= 57343:
                return .Err(JsonError.LoneSurrogate(backslash))
            if unit >= 55296 && unit <= 56319:
                low := if index + 1 < bytes.len() && bytes[index] == 92 && bytes[index + 1] == 117: read_hex4(bytes, index + 2) else: -1
                if low < 56320 || low > 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                point = 65536 + (unit - 55296) * 1024 + (low - 56320)
                index = index + 6
            push_scalar(buffer, point)
        else:
            return .Err(JsonError.InvalidEscape(backslash))

# The value of the four hex digits at `at`, -1 when one is not a hex digit,
# or -2 when the text ends first.
fn read_hex4(bytes: List[u8], at: usize) -> i32:
    let value: i32 = 0
    let offset: usize = 0
    while offset < 4:
        if at + offset >= bytes.len():
            return -2
        digit := hex_value(i32(bytes[at + offset]))
        if digit < 0:
            return -1
        value = value * 16 + digit
        offset = offset + 1
    value

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        return code - 48
    if code >= 97 && code <= 102:
        return code - 87
    if code >= 65 && code <= 70:
        return code - 55
    -1

# The UTF-8 bytes of a scalar value.
fn push_scalar(out: mut List[u8], point: i32) -> void:
    if point < 128:
        out.push(u8(point))
    else if point < 2048:
        out.push(u8(192 + (point >> 6)))
        out.push(u8(128 + (point & 63)))
    else if point < 65536:
        out.push(u8(224 + (point >> 12)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    else:
        out.push(u8(240 + (point >> 18)))
        out.push(u8(128 + ((point >> 12) & 63)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))

# 2^63, the first u64 past the i64 range, and the largest u64.
fn sign_limit() -> u64:
    9223372036854775808

fn u64_max() -> u64:
    18446744073709551615

# The number that starts at `start`: `-`? then `0` or a nonzero digit and
# digits. An integer in the i64 or u64 range is exact; `-0` is the float
# -0.0, as in serde_json. A fraction, an exponent, or an integer past both
# ranges is the float that `parse_f64` gives (r-std-json.parse.number.float).
fn parse_number(bytes: List[u8], start: usize) -> Result[Parsed, JsonError]:
    size := bytes.len()
    let index = start
    negative := bytes[index] == 45
    if negative:
        index = index + 1
    if index >= size:
        return .Err(unexpected(bytes, index))
    let magnitude: u64 = 0
    let overflow = false
    if bytes[index] == 48:
        index = index + 1
    else if bytes[index] >= 49 && bytes[index] <= 57:
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            digit := u64(bytes[index] - 48)
            if magnitude > (u64_max() - digit) / 10:
                overflow = true
            else:
                magnitude = magnitude * 10 + digit
            index = index + 1
    else:
        return .Err(unexpected(bytes, index))
    let exotic = false
    if index < size && bytes[index] == 46:
        index = index + 1
        if index >= size || bytes[index] < 48 || bytes[index] > 57:
            return .Err(unexpected(bytes, index))
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            index = index + 1
        exotic = true
    if index < size && (bytes[index] == 101 || bytes[index] == 69):
        index = index + 1
        if index < size && (bytes[index] == 43 || bytes[index] == 45):
            index = index + 1
        if index >= size || bytes[index] < 48 || bytes[index] > 57:
            return .Err(unexpected(bytes, index))
        while index < size && bytes[index] >= 48 && bytes[index] <= 57:
            index = index + 1
        exotic = true
    if exotic || overflow || (negative && magnitude > sign_limit()):
        return float_number(bytes, start, index)
    if !negative:
        return .Ok(Parsed { value: Json.Number(Number::from_u64(magnitude)), end: index })
    if magnitude == 0:
        match Number::from_f64(-0.0):
            .Some(zero) => return .Ok(Parsed { value: Json.Number(zero), end: index })
            .None => return float_number(bytes, start, index)
    if magnitude == sign_limit():
        return .Ok(Parsed { value: Json.Number(Number::from_i64(-9223372036854775808)), end: index })
    .Ok(Parsed { value: Json.Number(Number::from_i64(-i64(magnitude))), end: index })

# The float of the number text from `start` up to `end`, which the caller
# has read to the end of its grammar; past the f64 range it is a
# `NumberOutOfRange` at `start` (r-std-json.parse.number.out-of-range).
fn float_number(bytes: List[u8], start: usize, end: usize) -> Result[Parsed, JsonError]:
    let digits: mut List[u8] = []
    let index = start
    while index < end:
        digits.push(bytes[index])
        index = index + 1
    value := match parse_f64(bytes_text(digits)):
        .Ok(found) => found
        .Err(_) => panic("std.json: a JSON number is parse_f64 text")
    match Number::from_f64(value):
        .Some(number) => .Ok(Parsed { value: Json.Number(number), end: end })
        .None => .Err(JsonError.NumberOutOfRange(start))

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates:
# a `@derive` on a std declaration has no effect in the prototype.

impl Debug for Number:
    fn debug(self, out: mut DebugWriter) -> void:
        match self.repr:
            .Negative(value) => out.debug_tuple("Number").field(value).finish()
            .NonNegative(value) => out.debug_tuple("Number").field(value).finish()
            .Float(value) => out.debug_tuple("Number").field(value).finish()

impl Debug for Json:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Null => out.write("Json.Null")
            .Bool(value) => out.debug_tuple("Json.Bool").named_field("value", value).finish()
            .Number(value) => out.debug_tuple("Json.Number").named_field("value", value).finish()
            .Text(value) => out.debug_tuple("Json.Text").named_field("value", value).finish()
            .Array(items) => out.debug_tuple("Json.Array").named_field("items", items).finish()
            .Object(fields) => out.debug_tuple("Json.Object").named_field("fields", fields).finish()

# One `debug_list` entry per member, in insertion order.
impl Debug for JsonObject:
    fn debug(self, out: mut DebugWriter) -> void:
        let list: mut DebugList = out.debug_list()
        for entry in self.entries:
            _ := list.entry(entry)
        list.finish()

impl Debug for JsonError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .UnexpectedEnd(position) => out.debug_tuple("JsonError.UnexpectedEnd").named_field("position", position).finish()
            .UnexpectedCharacter(position) => out.debug_tuple("JsonError.UnexpectedCharacter").named_field("position", position).finish()
            .InvalidEscape(position) => out.debug_tuple("JsonError.InvalidEscape").named_field("position", position).finish()
            .LoneSurrogate(position) => out.debug_tuple("JsonError.LoneSurrogate").named_field("position", position).finish()
            .ControlCharacter(position) => out.debug_tuple("JsonError.ControlCharacter").named_field("position", position).finish()
            .NumberOutOfRange(position) => out.debug_tuple("JsonError.NumberOutOfRange").named_field("position", position).finish()
            .NestingTooDeep(position) => out.debug_tuple("JsonError.NestingTooDeep").named_field("position", position).finish()
            .WrongType(path, expected) => out.debug_tuple("JsonError.WrongType").named_field("path", path).named_field("expected", expected).finish()
            .MissingField(path) => out.debug_tuple("JsonError.MissingField").named_field("path", path).finish()
            .UnknownVariant(path, name) => out.debug_tuple("JsonError.UnknownVariant").named_field("path", path).named_field("name", name).finish()

# ---------------------------------------------------------------------------
# Typed JSON (spec/std/json.md#typed-json): JSON as a format that reads the
# `std.serde` consent. `to_json` writes a value through `JsonWriter`, and
# `from_json` reads one through `JsonReader`.

# The `Json` of a value (r-std-json.to-json).
## The `Json` that `value`'s `serialize` writes.
## See [std-json.to-json](../../spec/std/json.md#r-std-json.to-json).
pub fn to_json[T < Serialize](value: T) -> Json:
    let writer: mut JsonWriter = JsonWriter { result: Json.Null, pending: "", keys: [], values: [], frames: [] }
    match value.serialize(writer):
        .Ok(_) => writer.result
        .Err(_) => panic("std.json: the JSON writer never fails")

# The value that a `Json` describes, or the first decode error
# (r-std-json.from-json).
## The `T` that `T::deserialize` reads from `value`, or the first error it finds.
## See [std-json.from-json](../../spec/std/json.md#r-std-json.from-json).
pub fn from_json[T < Deserialize](value: Json) -> Result[T, JsonError]:
    let reader: mut JsonReader = JsonReader { value: value, present: true, path: "\$", frames: [], at: [] }
    T::deserialize(reader)

# The compact text of a value's `Json` (r-std-json.encode).
## The compact JSON text of `value`, with no whitespace outside strings.
## See [std-json.encode](../../spec/std/json.md#r-std-json.encode).
pub fn encode[T < Serialize](value: T) -> string:
    "${to_json(value)}"

# `parse`, then `from_json` (r-std-json.decode).
## `parse(text)`, then `from_json` of the parsed value.
## See [std-json.decode](../../spec/std/json.md#r-std-json.decode).
pub fn decode[T < Deserialize](text: string) -> Result[T, JsonError]:
    value := parse(text)?
    from_json::[T](value)

# `Json` writes and reads itself (r-std-json.std.json).
impl Serialize for Json:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        match self:
            .Null => out.null()
            .Bool(flag) => out.bool(flag)
            .Number(number) =>
                match number.repr:
                    .Negative(found) => out.int(found)
                    .NonNegative(found) => out.uint(found)
                    .Float(found) => out.float(found)
            .Text(text) => out.text(text)
            .Array(items) =>
                out.begin_list(items.len())?
                for item in items:
                    item.serialize(out)?
                out.end_list()
            .Object(fields) =>
                out.begin_map(fields.len())?
                for entry in fields:
                    out.key(entry._0)?
                    entry._1.serialize(out)?
                out.end_map()

impl Deserialize for Json:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Json, R::Error]:
        match input.peek()?:
            .Null =>
                _ := input.is_null()?
                .Ok(Json.Null)
            .Bool => .Ok(Json.Bool(input.bool("bool")?))
            .Int => .Ok(Json.Number(Number::from_i64(input.int("i64")?)))
            .Uint => .Ok(Json.Number(Number::from_u64(input.uint("u64")?)))
            .Float =>
                found := input.float("f64")?
                match Number::from_f64(found):
                    .Some(number) => .Ok(Json.Number(number))
                    .None => .Ok(Json.Null)
            .Text => .Ok(Json.Text(input.text("string")?))
            .List =>
                input.begin_list()?
                let items: mut List[Json] = []
                while input.next_item()?:
                    items.push(Json::deserialize(input)?)
                .Ok(Json.Array(items))
            .Map =>
                input.begin_map()?
                let fields: mut JsonObject = JsonObject::new()
                while true:
                    match input.next_key()?:
                        .Some(key) => fields.set(key, Json::deserialize(input)?)
                        .None => break
                .Ok(Json.Object(fields))

# One open list, map, or variant of the writer: its kind, where its items
# start in `values`, the key it goes under in its own container, and a
# variant's name and form.
data OpenFrame:
    pub kind: i32
    pub start: usize
    pub key: string
    pub name: string
    pub of_data: bool

# Builds the `Json` of one value. The items of every open container sit on
# one stack, `values`, each beside its key in `keys`; closing a container
# replaces its items with its value (r-std-json.derive.to-json.data).
data JsonWriter:
    pub result: Json
    pub pending: string
    pub keys: mut List[string]
    pub values: mut List[Json]
    pub frames: mut List[OpenFrame]

impl JsonWriter:
    fn put(mut self, value: Json) -> Result[void, never]:
        if self.frames.len() == 0:
            self.result = value
        else:
            self.keys.push(self.pending)
            self.values.push(value)
        .Ok(())

    fn open(mut self, kind: i32, name: string, of_data: bool) -> Result[void, never]:
        self.frames.push(OpenFrame { kind: kind, start: self.values.len(), key: self.pending, name: name, of_data: of_data })
        .Ok(())

    # The innermost frame, its items, and its keys, popped.
    fn close(mut self) -> (OpenFrame, List[string], List[Json]):
        frame := match self.frames.pop():
            .Some(found) => found
            .None => panic("std.json: a close without an open container")
        let keys: mut List[string] = []
        let values: mut List[Json] = []
        let index = frame.start
        while index < self.values.len():
            keys.push(self.keys[index])
            values.push(self.values[index])
            index = index + 1
        while self.values.len() > frame.start:
            _ := self.values.pop()
            _ := self.keys.pop()
        self.pending = frame.key
        (frame, keys, values)

impl Serializer for JsonWriter:
    type Error = never

    fn null(mut self) -> Result[void, never]:
        self.put(Json.Null)

    fn bool(mut self, value: bool) -> Result[void, never]:
        self.put(Json.Bool(value))

    fn int(mut self, value: i64) -> Result[void, never]:
        self.put(Json.Number(Number::from_i64(value)))

    fn uint(mut self, value: u64) -> Result[void, never]:
        self.put(Json.Number(Number::from_u64(value)))

    # A NaN or an infinity has no JSON number, so it writes `null`, as in
    # serde_json (r-std-json.std.float-special).
    fn float(mut self, value: f64) -> Result[void, never]:
        match Number::from_f64(value):
            .Some(number) => self.put(Json.Number(number))
            .None => self.put(Json.Null)

    fn text(mut self, value: string) -> Result[void, never]:
        self.put(Json.Text(value))

    fn begin_list(mut self, len: usize) -> Result[void, never]:
        self.open(0, "", false)

    fn end_list(mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Array(closed._2))

    fn begin_map(mut self, len: usize) -> Result[void, never]:
        self.open(1, "", false)

    fn key(mut self, key: string) -> Result[void, never]:
        self.pending = key
        .Ok(())

    fn end_map(mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    fn begin_variant(mut self, facts: Facts, v: VariantInfo) -> Result[void, never]:
        self.open(2, v.name, v.of_data)

    fn member(mut self, m: Member) -> Result[void, never]:
        self.pending = m.name
        .Ok(())

    # A data type is an object; a variant with no member is its name, and
    # any other variant `{"Variant": {...}}` (r-std-json.derive.to-json.enum).
    fn end_variant(mut self) -> Result[void, never]:
        closed := self.close()
        frame := closed._0
        fields := object_of(closed._1, closed._2)
        if frame.of_data:
            return self.put(Json.Object(fields))
        if fields.len() == 0:
            return self.put(Json.Text(frame.name))
        let outer: mut JsonObject = JsonObject::new()
        outer.set(frame.name, Json.Object(fields))
        self.put(Json.Object(outer))

fn object_of(keys: List[string], values: List[Json]) -> JsonObject:
    let fields: mut JsonObject = JsonObject::new()
    let index: usize = 0
    while index < keys.len():
        fields.set(keys[index], values[index])
        index = index + 1
    fields

# One open list, map, or variant of the reader: the path of its items'
# container, the path to restore when it closes, a list's items or a map's
# values with a map's keys, and a variant's members.
data ReadFrame:
    pub base: string
    pub home: string
    pub items: List[Json]
    pub keys: List[string]
    pub fields: JsonObject

# Reads one `Json` for `from_json`. `value` is the value at the cursor,
# `present` is false for a member whose key is missing, and `path` is the
# cursor's path (r-std-json.error.path). `at` holds each open frame's next
# index.
data JsonReader:
    pub value: Json
    pub present: bool
    pub path: string
    pub frames: mut List[ReadFrame]
    pub at: mut List[usize]

impl JsonReader:
    # A missing key is a `MissingField`; any other value that does not fit
    # is a `WrongType` (r-std-json.derive.from-json.missing).
    fn fail(self, expected: string) -> JsonError:
        if !self.present:
            return JsonError.MissingField(self.path)
        JsonError.WrongType(self.path, expected)

    fn push(mut self, frame: ReadFrame) -> void:
        self.frames.push(frame)
        self.at.push(0)

    fn top(self) -> ReadFrame:
        match self.frames.last():
            .Some(frame) => frame
            .None => panic("std.json: no open container")

    fn pop(mut self) -> void:
        frame := self.top()
        _ := self.frames.pop()
        _ := self.at.pop()
        self.path = frame.home

impl Deserializer for JsonReader:
    type Error = JsonError

    fn peek(mut self) -> Result[ValueKind, JsonError]:
        if !self.present:
            return .Ok(ValueKind.Null)
        match self.value:
            .Null => .Ok(ValueKind.Null)
            .Bool(_) => .Ok(ValueKind.Bool)
            .Number(number) =>
                match number.repr:
                    .Negative(_) => .Ok(ValueKind.Int)
                    .NonNegative(found) =>
                        if found < sign_limit():
                            .Ok(ValueKind.Int)
                        else:
                            .Ok(ValueKind.Uint)
                    .Float(_) => .Ok(ValueKind.Float)
            .Text(_) => .Ok(ValueKind.Text)
            .Array(_) => .Ok(ValueKind.List)
            .Object(_) => .Ok(ValueKind.Map)

    # A missing key reads as `null` (r-std-json.derive.from-json.missing).
    fn is_null(mut self) -> Result[bool, JsonError]:
        .Ok(!self.present || self.value.is_null())

    fn bool(mut self, expected: string) -> Result[bool, JsonError]:
        if self.present:
            match self.value:
                .Bool(flag) => return .Ok(flag)
                _ => pass
        .Err(self.fail(expected))

    # A float is never an integer (r-std-json.std.integer.read).
    fn int(mut self, expected: string) -> Result[i64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_i64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn uint(mut self, expected: string) -> Result[u64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_u64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn float(mut self, expected: string) -> Result[f64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_f64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn text(mut self, expected: string) -> Result[string, JsonError]:
        if self.present:
            match self.value:
                .Text(found) => return .Ok(found)
                _ => pass
        .Err(self.fail(expected))

    fn begin_list(mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Array(items) =>
                    self.push(ReadFrame { base: self.path, home: self.path, items: items, keys: [], fields: JsonObject::new() })
                    return .Ok(())
                _ => pass
        .Err(self.fail("array"))

    # An item's path adds `[index]` (r-std-json.std.item-path).
    fn next_item(mut self) -> Result[bool, JsonError]:
        frame := self.top()
        last := self.at.len() - 1
        index := self.at[last]
        if index >= frame.items.len():
            self.pop()
            return .Ok(false)
        self.at[last] = index + 1
        self.value = frame.items[index]
        self.present = true
        self.path = "${frame.base}[$index]"
        .Ok(true)

    fn begin_map(mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Object(fields) =>
                    let keys: mut List[string] = []
                    let items: mut List[Json] = []
                    for entry in fields:
                        keys.push(entry._0)
                        items.push(entry._1)
                    self.push(ReadFrame { base: self.path, home: self.path, items: items, keys: keys, fields: JsonObject::new() })
                    return .Ok(())
                _ => pass
        .Err(self.fail("object"))

    # A map value's path adds `.key` (r-std-json.std.item-path).
    fn next_key(mut self) -> Result[string?, JsonError]:
        frame := self.top()
        last := self.at.len() - 1
        index := self.at[last]
        if index >= frame.items.len():
            self.pop()
            return .Ok(.None)
        self.at[last] = index + 1
        key := frame.keys[index]
        self.value = frame.items[index]
        self.present = true
        self.path = "${frame.base}.$key"
        .Ok(.Some(key))

    # A data type reads an object. An enum reads `"Variant"` as
    # `{"Variant": {}}`, or an object with exactly one key
    # (r-std-json.derive.from-json.enum).
    fn begin_variant(mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if choices.len() == 1 && choices[0].of_data:
            if self.present:
                match self.value:
                    .Object(fields) =>
                        self.push(ReadFrame { base: self.path, home: self.path, items: [], keys: [], fields: fields })
                        return .Ok(0)
                    _ => pass
            return .Err(self.fail("object"))
        if !self.present:
            return .Err(self.fail("variant"))
        let name = ""
        let payload = Json.Null
        match self.value:
            .Text(text) =>
                name = text
                payload = Json.Object(JsonObject::new())
            .Object(fields) =>
                if fields.len() != 1:
                    return .Err(self.fail("variant"))
                for entry in fields:
                    name = entry._0
                    payload = entry._1
            _ => return .Err(self.fail("variant"))
        let index: usize = 0
        while index < choices.len():
            if choices[index].name == name:
                base := "${self.path}.$name"
                match payload:
                    .Object(fields) =>
                        self.push(ReadFrame { base: base, home: self.path, items: [], keys: [], fields: fields })
                        return .Ok(index)
                    _ => return .Err(JsonError.WrongType(base, "object"))
            index = index + 1
        .Err(JsonError.UnknownVariant(self.path, name))

    # A member reads the value of its key; a missing key is absent
    # (r-std-json.derive.from-json.member).
    fn member(mut self, m: Member) -> Result[void, JsonError]:
        frame := self.top()
        self.path = "${frame.base}.${m.name}"
        match frame.fields.get(m.name):
            .Some(found) =>
                self.value = found
                self.present = true
            .None =>
                self.value = Json.Null
                self.present = false
        .Ok(())

    fn end_variant(mut self) -> Result[void, JsonError]:
        self.pop()
        .Ok(())

    fn invalid(mut self, expected: string) -> JsonError:
        self.fail(expected)
