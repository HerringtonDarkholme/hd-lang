# std's root module: the top-level modules another package may use
# (spec/lang/10-modules.md#r-module.vis.parent). Every public top-level
# module is re-exported as it is; `std.rt` stays std's own
# (spec/lang/10-modules.md#r-module.rt.std-only).
pub use std.{
    arena,
    cli,
    cmp,
    collections,
    console,
    contract,
    convert,
    core,
    crypto,
    encoding,
    error,
    format,
    fs,
    hash,
    host,
    http,
    iter,
    json,
    meta,
    net,
    num,
    ops,
    option,
    path,
    prelude,
    process,
    random,
    regex,
    remote,
    result,
    serde,
    sync,
    task,
    testing,
    text,
    thread,
    time,
    validate,
}
