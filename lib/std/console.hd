# std.console: `println`, `eprintln`, console input, and the recording
# `BufferConsole`.
# `Console`, `ConsoleError`, and `println`
# are prelude names (spec/lang/10-modules.md#console), all declared here.
# The checker still also knows `ConsoleError` by name. No prototype runtime
# profile binds a host `ConsoleInput`. `println` drives the covering
# provider's `write_line!` with `block_on` (MHP-1), so a `BufferConsole`
# records `println` lines too.
use std.task.block_on
use std.format.DebugWriter

# The host console capability; `write_line!` takes `mut self`, so it is a
# mutable requirement trait.
pub trait Console:
    fn write_line!(mut self, text: string) -> Result[void, ConsoleError]

    # One line of error output. A provider that does not override it
    # records error lines with `write_line!`
    # (spec/lang/10-modules.md#r-module.console.write-error-line.default).
    fn write_error_line!(mut self, text: string) -> Result[void, ConsoleError]:
        self.write_line!(text)

# `read_line!` takes `mut self`, so a scripted provider can advance
# through its lines (spec/std/console.md#r-std-console.input.mut).
pub trait ConsoleInput:
    fn read_line!(mut self) -> Result[string?, ConsoleError]

# The next line of the covering provider's input
# (spec/std/console.md#r-std-console.input.helper).
pub fn read_line!() -> Result[string?, ConsoleError] $ ConsoleInput:
    let mut input = $.use(ConsoleInput)
    input.read_line!()

# The recording `Console` provider (spec/std/console.md#buffer-console).
# It keeps error lines apart from output lines.
pub data BufferConsole:
    lines: mut List[string]
    error_lines: mut List[string]

impl BufferConsole:
    pub fn new() -> mut BufferConsole:
        BufferConsole { lines: [], error_lines: [] }

    # The lines `write_line!` received, in order (r-std-console.buffer.output).
    pub fn output(self) -> List[string]:
        self.lines

    # The lines `write_error_line!` received, in order
    # (r-std-console.buffer.error-output).
    pub fn error_output(self) -> List[string]:
        self.error_lines

# The scripted `ConsoleInput` provider (spec/std/console.md#scripted-input):
# it returns its lines in order, then `.None`.
pub data ScriptedInput:
    lines: List[string]
    next: usize

impl ScriptedInput:
    pub fn new(lines: List[string]) -> mut ScriptedInput:
        ScriptedInput { lines: lines, next: 0 }

impl ConsoleInput for ScriptedInput:
    fn read_line!(mut self) -> Result[string?, ConsoleError]:
        if self.next >= self.lines.len():
            return .Ok(.None)
        line := self.lines[self.next]
        self.next = self.next + 1
        .Ok(.Some(line))

impl Debug for ScriptedInput:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ScriptedInput").field("lines", self.lines).field("next", self.next).finish()

# The derived builder calls, written by hand because `@derive` does not
# run inside lib/std (r-std-format.debug.std-types).
impl Debug for BufferConsole:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("BufferConsole").field("lines", self.lines).field("error_lines", self.error_lines).finish()

impl Console for BufferConsole:
    fn write_line!(mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_line!(mut self, text: string) -> Result[void, ConsoleError]:
        self.error_lines.push(text)
        .Ok(())

# `println` (spec/lang/10-modules.md#console) is ordinary std code: it drives the
# covering provider's `write_line!` with `block_on`, so it inherits all of
# `block_on`'s rules. Under an active driver, such as `main!` or a test
# body, it drives only its own write, and it is rejected in a `defer` suite
# or a default expression. An `.Err` is an ordinary panic.
pub fn println[T < Display](value: T) -> void $ Console:
    let mut console = $.use(Console)
    let call: mut Suspend[Result[void, ConsoleError]] = console.write_line("$value")
    match block_on(call):
        .Ok(()) => pass
        .Err(_) => panic("println: write_line! returned .Err(ConsoleError)")

# `eprintln` (spec/std/console.md#standard-error) drives the covering
# provider's `write_error_line!` as `println` drives `write_line!`.
pub fn eprintln[T < Display](value: T) -> void $ Console:
    let mut console = $.use(Console)
    let call: mut Suspend[Result[void, ConsoleError]] = console.write_error_line("$value")
    match block_on(call):
        .Ok(()) => pass
        .Err(_) => panic("eprintln: write_error_line! returned .Err(ConsoleError)")

# The error of a console write or read (spec/lang/10-modules.md#r-module.console.error.closed).
pub enum ConsoleError:
    Closed

impl Display for ConsoleError:
    fn to_string(self) -> string:
        match self:
            .Closed => "console closed"

# One variant, so every two values are equal (r-std-console.error.traits).
impl Eq for ConsoleError:
    fn eq(self, other: ConsoleError) -> bool:
        true

impl Debug for ConsoleError:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("Closed")
