# std.console: `println`, `eprintln`, console input, and the recording
# `MemoryConsole`.
# `Console`, `ConsoleError`, and `println`
# are prelude names (spec/lang/10-modules.md#console), all declared here.
# The checker still also knows `ConsoleError` by name. The default profile
# binds a host `ConsoleInput` to standard input. `println` calls the
# covering provider's `write_sync` directly, so a `MemoryConsole` records
# `println` lines too.
use std.text.StringBuilder

# The host console capability; `write_sync` takes `&mut self`, so it is a
# mutable requirement trait and `$.use(Console)` is a `&mut dyn Console`,
# which every `println` reaches. Output never suspends: a host provider may
# block until the text is written
# (spec/lang/10-modules.md#r-module.console.write-sync.never-suspends).
## The host capability to write unchanged output text and error text.
## See [module.console.host-trait](../../spec/lang/10-modules.md#r-module.console.host-trait).
pub trait Console:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]

    # Error text. A provider that does not override it
    # forwards it unchanged to `write_sync`
    # (spec/lang/10-modules.md#r-module.console.write-error-sync.forwarding).
    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.write_sync(text)

# `read_line!` takes `&mut self`, so a scripted provider can advance
# through its lines (spec/std/console.md#r-std-console.input.mut-ref.reference-values).
## The host capability to read a line of input.
## See [std-console.input.decl](../../spec/std/console.md#r-std-console.input.decl).
pub trait ConsoleInput:
    fn read_line!(&mut self) -> Result[string?, ConsoleError]

    # The rest of the input. The default body cannot see whether the last
    # line had an ending, so it ends every line with `\n`
    # (spec/std/console.md#r-std-console.input.read-all-default).
    # The host's provider overrides it with one read of standard input,
    # which keeps the text as it was, with `\r\n` read as `\n`
    # (spec/std/console.md#r-std-console.input.read-all-host).
    fn read_all!(&mut self) -> Result[string, ConsoleError]:
        out := StringBuilder::new()
        while true:
            match self.read_line!()?:
                .Some(line) =>
                    out.push(line)
                    out.push("\n")
                .None => break
        .Ok(out.build())

# The next line of the covering provider's input
# (spec/std/console.md#r-std-console.input.helper).
## Returns the next line of input without its line ending, or `.None` at the end of input.
## See [std-console.input.read-line](../../spec/std/console.md#r-std-console.input.read-line).
pub fn read_line!() -> Result[string?, ConsoleError] $ ConsoleInput:
    input := $.use(ConsoleInput)
    input.read_line!()

# The rest of the covering provider's input, as one string
# with the line structure of the text
# (spec/std/console.md#r-std-console.input.read-all-helper).
## Returns all the input that is left, as text, with `\r\n` read as `\n`.
## See [std-console.input.read-all-helper](../../spec/std/console.md#r-std-console.input.read-all-helper).
pub fn read_all!() -> Result[string, ConsoleError] $ ConsoleInput:
    input := $.use(ConsoleInput)
    input.read_all!()

# The recording `Console` provider (spec/std/console.md#buffer-console).
# It keeps error lines apart from output lines. It is a struct used behind
# `&mut`: `new` returns a new object, so the test that installs it reads
# the lines it recorded (r-std-console.buffer.install-ref).
## The recording `Console` provider: it keeps exact text chunks for a test to read.
## See [std-console.buffer.decl](../../spec/std/console.md#r-std-console.buffer.decl).
@derive(Debug)
pub struct MemoryConsole:
    lines: List[string]
    error_lines: List[string]

impl MemoryConsole:
    ## Returns an empty recording provider.
    ## See [std-console.buffer.install-ref](../../spec/std/console.md#r-std-console.buffer.install-ref).
    pub fn new() -> *mut MemoryConsole:
        &mut MemoryConsole { lines: [], error_lines: [] }

    # The lines `write_sync` received, in order (r-std-console.buffer.output-text-sync).
    ## The exact text chunks written through `write_sync`, in order.
    ## See [std-console.buffer.output-text-sync](../../spec/std/console.md#r-std-console.buffer.output-text-sync).
    pub fn output(&self) -> List[string]:
        self.lines

    # The lines `write_error_sync` received, in order
    # (r-std-console.buffer.error-text-sync).
    ## The exact text chunks written through `write_error_sync`, in order.
    ## See [std-console.buffer.error-text-sync](../../spec/std/console.md#r-std-console.buffer.error-text-sync).
    pub fn error_output(&self) -> List[string]:
        self.error_lines

# The `&mut MemoryConsole` that `new` returns, installed as the provider,
# records into this object (r-req.ref.share.reference-values).
impl Console for MemoryConsole:
    fn write_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.lines.push(text)
        .Ok(())

    fn write_error_sync(&mut self, text: string) -> Result[void, ConsoleError]:
        self.error_lines.push(text)
        .Ok(())

# `println` (spec/lang/10-modules.md#console) is ordinary std code: it calls
# the covering provider's `write_sync` for the text, then for the newline
# once the text is written. An `.Err` is an ordinary panic.
## Writes `value`'s `Display` text and a line ending to the `Console` provider that covers the call; it panics when the write fails.
## See [module.console.println-two-writes-sync](../../spec/lang/10-modules.md#r-module.console.println-two-writes-sync).
pub fn println[T < Display](value: T) -> void $ Console:
    let console: &mut dyn Console = $.use(Console)
    if console.write_sync(value.to_string()).is_err():
        panic("println: write_sync returned .Err(ConsoleError)")
    if console.write_sync("\n").is_err():
        panic("println: write_sync returned .Err(ConsoleError)")

## Writes Display text without a newline to the covering Console provider; it panics when the write fails.
## See [std-console.print.decl](../../spec/std/console.md#r-std-console.print.decl).
pub fn print[T < Display](value: T) -> void $ Console:
    let console: &mut dyn Console = $.use(Console)
    if console.write_sync("$value").is_err():
        panic("print: write_sync returned .Err(ConsoleError)")

# `eprintln` (spec/std/console.md#standard-error) calls the covering
# provider's `write_error_sync` as `println` calls `write_sync`.
## Like `println`, but it writes the line as error output.
## See [std-console.eprintln.decl](../../spec/std/console.md#r-std-console.eprintln.decl).
pub fn eprintln[T < Display](value: T) -> void $ Console:
    let console: &mut dyn Console = $.use(Console)
    if console.write_error_sync("$value\n").is_err():
        panic("eprintln: write_error_sync returned .Err(ConsoleError)")

# The scripted `ConsoleInput` provider (spec/std/console.md#scripted-input):
# it returns its lines in order, then `.None`.
## The deterministic `ConsoleInput` provider: it answers from a list of lines, with no host access.
## See [std-console.scripted.decl](../../spec/std/console.md#r-std-console.scripted.decl).
@derive(Debug)
pub struct ScriptedInput:
    lines: List[string]
    next: usize

impl ScriptedInput:
    ## Returns the provider that answers `lines` in order, then the end of input.
    ## See [std-console.scripted.new-ref](../../spec/std/console.md#r-std-console.scripted.new-ref).
    pub fn new(lines: List[string]) -> *mut ScriptedInput:
        &mut ScriptedInput { lines: lines, next: 0 }

impl ConsoleInput for ScriptedInput:
    fn read_line!(&mut self) -> Result[string?, ConsoleError]:
        if self.next >= self.lines.len():
            return .Ok(.None)
        line := self.lines[self.next]
        self.next = self.next + 1
        .Ok(.Some(line))

    # The remaining lines, each ended by `\n`
    # (spec/std/console.md#r-std-console.scripted.read-all).
    fn read_all!(&mut self) -> Result[string, ConsoleError]:
        out := StringBuilder::new()
        while self.next < self.lines.len():
            out.push(self.lines[self.next])
            out.push("\n")
            self.next = self.next + 1
        .Ok(out.build())

# The error of a console write or read (spec/lang/10-modules.md#r-module.console.error.variants).
## The console's errors: closed, not granted, or another failure.
## See [module.console.error.variants](../../spec/lang/10-modules.md#r-module.console.error.variants).
@derive(Debug, Eq)
@error
pub enum ConsoleError:
    @error("console closed")
    Closed
    @error("console access to ${subject} is not granted")
    NotGranted(subject: string)
    @error("$message")
    Other(message: string)

# Equality compares the error variant and its payload (r-std-console.error.traits).
