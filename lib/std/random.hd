# std.random: the host capability trait `Random`, its deterministic
# provider `SeededRandom`, and the `Rng` helpers (spec/std/random.md). The
# default profile binds a host `Random` (src/commands/default-profile.ts);
# `std.testing` draws a property test's cases from a `SeededRandom`.
use std.format.DebugWriter
use std.ops.Range

# Draws values from a source of randomness (r-std-random.decl). Both
# methods take `mut self`, so a seeded provider advances its own state
# (r-std-random.mut).
## The host capability to fill bytes from the system random source.
## See [std-random.decl](../../spec/std/random.md#r-std-random.decl).
pub trait Random:
    fn next_u64(mut self) -> u64
    fn fill(mut self, count: usize) -> List[u8]

# The deterministic `Random` (spec/std/random.md#seeded-random): the same
# seed gives the same draws (r-std-random.seeded.same-seed). The generator
# is xoshiro128** 1.0 (Blackman and Vigna): four 32-bit words of state, kept
# in `u64` values masked to 32 bits, so no operation overflows. `new` fills
# the state with SplitMix32 from the seed.
## The deterministic `Random` provider: a seeded generator for tests, with no host access.
## See [std-random.seeded.decl](../../spec/std/random.md#r-std-random.seeded.decl).
pub data SeededRandom:
    s0: u64
    s1: u64
    s2: u64
    s3: u64

impl SeededRandom:
    ## Returns the provider of `seed`; two providers of one seed answer the same.
    ## See [std-random.seeded.new](../../spec/std/random.md#r-std-random.seeded.new).
    pub fn new(seed: u64) -> mut SeededRandom:
        let z: u64 = low32(seed ^ (seed >> 32))
        z = low32(z + 0x9E3779B9)
        a := mix32(z)
        z = low32(z + 0x9E3779B9)
        b := mix32(z)
        z = low32(z + 0x9E3779B9)
        c := mix32(z)
        z = low32(z + 0x9E3779B9)
        SeededRandom { s0: a, s1: b, s2: c, s3: mix32(z) }

    fn next32(mut self) -> u64:
        result := low32(rotl32(low32(self.s1 * 5), 7) * 9)
        t := low32(self.s1 << 9)
        self.s2 = self.s2 ^ self.s0
        self.s3 = self.s3 ^ self.s1
        self.s1 = self.s1 ^ self.s2
        self.s0 = self.s0 ^ self.s3
        self.s2 = self.s2 ^ t
        self.s3 = rotl32(self.s3, 11)
        result

impl Random for SeededRandom:
    fn next_u64(mut self) -> u64:
        high := self.next32()
        (high << 32) | self.next32()

    fn fill(mut self, count: usize) -> List[u8]:
        let bytes: mut List[u8] = []
        while bytes.len() < count:
            bytes.push(u8(self.next32() & 0xFF))
        bytes

# The `Rng` helpers (spec/std/random.md#rng): a generator value that a seed
# starts, with the draws scripts need. Its generator is fixed
# (r-std-random.rng.generator): the xoshiro128** state of `SeededRandom`, so
# a seed gives the same draws in every implementation.
## A random generator: seeded, so its draws repeat for one seed.
## See [std-random.rng.decl](../../spec/std/random.md#r-std-random.rng.decl).
pub data Rng:
    source: mut SeededRandom

impl Rng:
    ## Returns the generator of `seed`.
    ## See [std-random.rng.new](../../spec/std/random.md#r-std-random.rng.new).
    pub fn new(seed: u64) -> mut Rng:
        Rng { source: SeededRandom::new(seed) }

    # The direct constructor that `rng()` uses for its draw
    # (r-std-random.rng.from-random): the spec names no distinct behavior
    # for it, so it builds the generator exactly as `new` does.
    ## Returns the generator of a raw draw, as `rng()` seeds one.
    ## See [std-random.rng.from-random](../../spec/std/random.md#r-std-random.rng.from-random).
    pub fn from_seed(seed: u64) -> mut Rng:
        Rng { source: SeededRandom::new(seed) }

    ## The next random `u64`.
    ## See [std-random.rng.next-u64](../../spec/std/random.md#r-std-random.rng.next-u64).
    pub fn next_u64(mut self) -> u64:
        self.source.next_u64()

    # An integer of `range`, from `start + below(count)`
    # (r-std-random.rng.int.offset). A count of 2^64, the whole `i64` range,
    # is passed as 0.
    ## A random integer of `range`, each with the same chance.
    ## See [std-random.rng.int](../../spec/std/random.md#r-std-random.rng.int).
    pub fn int(mut self, range: Range[i64]) -> i64:
        if range.start > range.end || (range.start == range.end && !range.inclusive):
            panic("std.random: empty range")
        let count: u64 = range.end.abs_diff(range.start)
        if range.inclusive:
            count = if count == 0xFFFFFFFFFFFFFFFF: 0 else: count + 1
        offset := self.below(count)
        if offset > 0x7FFFFFFFFFFFFFFF:
            # Only a negative `start` reaches an offset past the largest i64.
            return (range.start + 0x7FFFFFFFFFFFFFFF) + i64(offset - 0x7FFFFFFFFFFFFFFF)
        range.start + i64(offset)

    # The top 53 bits of a draw, scaled by 2^-53: exact, and below 1.
    ## A random float from 0 up to, not including, 1.
    ## See [std-random.rng.float](../../spec/std/random.md#r-std-random.rng.float).
    pub fn float(mut self) -> f64:
        f64(self.next_u64() >> 11) / 9007199254740992.0

    ## A random `bool`, each value with the same chance.
    ## See [std-random.rng.bool](../../spec/std/random.md#r-std-random.rng.bool).
    pub fn bool(mut self) -> bool:
        (self.next_u64() >> 63) == 1

    ## One of `items`, each with the same chance, or `.None` for an empty list.
    ## See [std-random.rng.choose](../../spec/std/random.md#r-std-random.rng.choose).
    pub fn choose[T](mut self, items: List[T]) -> T?:
        if items.len() == 0:
            return .None
        .Some(items[usize(self.below(u64(items.len())))])

    # Fisher-Yates from the last position down (r-std-random.rng.shuffle.order).
    ## Reorders `items` at random, each permutation with the same chance.
    ## See [std-random.rng.shuffle](../../spec/std/random.md#r-std-random.rng.shuffle).
    pub fn shuffle[T](mut self, items: mut List[T]) -> void:
        let i = items.len()
        while i > 1:
            i = i - 1
            j := usize(self.below(u64(i + 1)))
            held := items[i]
            items[i] = items[j]
            items[j] = held

    # The first `count` steps of Fisher-Yates from the front, on a copy
    # (r-std-random.rng.sample.order).
    ## `count` of `items`, drawn without replacement in random order.
    ## See [std-random.rng.sample](../../spec/std/random.md#r-std-random.rng.sample).
    pub fn sample[T](mut self, items: List[T], count: usize) -> List[T]:
        if count > items.len():
            panic("std.random: sample count above the list length")
        let pool: mut List[T] = []
        for item in items:
            pool.push(item)
        let chosen: mut List[T] = []
        let i: usize = 0
        while i < count:
            j := i + usize(self.below(u64(pool.len() - i)))
            held := pool[i]
            pool[i] = pool[j]
            pool[j] = held
            chosen.push(pool[i])
            i = i + 1
        chosen

    # An unbiased draw below `count` by rejection (r-std-random.rng.below):
    # a draw under 2^64 mod `count` is drawn again, so every remainder has
    # the same number of draws. A `count` of 0 stands for 2^64.
    fn below(mut self, count: u64) -> u64:
        if count == 0:
            return self.next_u64()
        let largest: u64 = 0xFFFFFFFFFFFFFFFF
        threshold := (largest - count + 1) % count
        let x = self.next_u64()
        while x < threshold:
            x = self.next_u64()
        x % count

# An `Rng` that one draw of the `Random` provider seeds (r-std-random.rng.from-random).
## Returns a generator seeded from the `Random` provider that covers the call.
## See [std-random.rng.from-random](../../spec/std/random.md#r-std-random.rng.from-random).
pub fn rng() -> mut Rng $ Random:
    Rng::new($.use(Random).next_u64())

fn low32(x: u64) -> u64:
    x & 0xFFFFFFFF

fn rotl32(x: u64, k: u32) -> u64:
    low32((x << k) | (x >> (32 - k)))

# SplitMix32's output function, MurmurHash3's 32-bit finalizer.
fn mix32(z: u64) -> u64:
    let a: u64 = low32((z ^ (z >> 16)) * 0x85EBCA6B)
    a = low32((a ^ (a >> 13)) * 0xC2B2AE35)
    a ^ (a >> 16)

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for SeededRandom:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("SeededRandom").field("s0", self.s0).field("s1", self.s1).field("s2", self.s2).field("s3", self.s3).finish()

impl Debug for Rng:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Rng").field("source", self.source).finish()
