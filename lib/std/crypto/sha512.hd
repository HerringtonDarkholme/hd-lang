# SHA-512, FIPS 180-4 sections 5.1.2, 5.3.5 and 6.4.
# The streaming/block structure follows Go's crypto/internal/fips140/sha512.
use std.crypto.Digest

## The 64-byte SHA-512 digest of bytes, as FIPS 180-4 defines it.
## See [std-crypto-sha512.hash](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.hash).
pub fn sha512(bytes: List[u8]) -> Digest:
    Sha512::new().update(bytes).finish()

## A SHA-512 computation that accepts its message in chunks.
## See [std-crypto-sha512.streaming](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.streaming).
pub struct Sha512:
    state: List[u64]
    block: List[u8]
    length_low: u64
    length_high: u64
    rounds: List[u64]
    outer: List[u8]

impl Sha512:
    ## Returns a fresh SHA-512 computation.
    ## See [std-crypto-sha512.new](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.new).
    pub fn new() -> *mut Sha512:
        box(
            Sha512 {
                state: [
                    0x6a09e667f3bcc908,
                    0xbb67ae8584caa73b,
                    0x3c6ef372fe94f82b,
                    0xa54ff53a5f1d36f1,
                    0x510e527fade682d1,
                    0x9b05688c2b3e6c1f,
                    0x1f83d9abfb41bd6b,
                    0x5be0cd19137e2179,
                ],
                block: [],
                length_low: 0,
                length_high: 0,
                rounds: round_constants(),
                outer: [],
            },
        )

    ## Returns a fresh HMAC-SHA512 computation under key.
    ## See [std-crypto-sha512.hmac](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.hmac).
    pub fn hmac(key: List[u8]) -> *mut Sha512:
        # RFC 2104: hash an overlong key, then zero-pad to the block size.
        let mut block_key = if key.len() > 128: sha512(key).bytes else: key
        while block_key.len() < 128:
            block_key.push(0)
        let mut inner_pad: List[u8] = []
        let mut outer_pad: List[u8] = []
        for byte in block_key:
            inner_pad.push(byte ^ 0x36)
            outer_pad.push(byte ^ 0x5c)
        hasher := Sha512::new().update(inner_pad)
        hasher.outer = outer_pad
        hasher

    ## Adds bytes to the message and returns the same hasher.
    ## See [std-crypto-sha512.update](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.update).
    pub fn update(*mut self, bytes: List[u8]) -> *mut Sha512:
        let state = self.state
        let mut block = self.block
        let at: usize = 0
        # Fill a previous partial block, then compress full input blocks
        # directly; only the final partial block is copied into the buffer.
        if block.len() > 0:
            while at < bytes.len() && block.len() < 128:
                block.push(bytes[at])
                at += 1
            if block.len() == 128:
                state = compress(state, block, 0, self.rounds)
                block.clear()
        while bytes.len() - at >= 128:
            state = compress(state, bytes, at, self.rounds)
            at += 128
        while at < bytes.len():
            block.push(bytes[at])
            at += 1
        low := self.length_low.wrapping_add(u64(bytes.len()))
        if low < self.length_low:
            self.length_high = self.length_high.wrapping_add(1)
        self.length_low = low
        self.state = state
        self.block = block
        self

    ## Returns the digest so far, leaving the hasher available for more input.
    ## See [std-crypto-sha512.finish](../../../spec/std/crypto-sha512.md#r-std-crypto-sha512.finish).
    pub fn finish(self) -> Digest:
        inner := self.finish_plain()
        if self.outer.len() == 0:
            return inner
        Sha512::new().update(self.outer).update(inner.bytes).finish()

    fn finish_plain(&self) -> Digest:
        let mut last = self.block
        last.push(128)
        while last.len() % 128 != 112:
            last.push(0)
        append_word(&mut last, (self.length_high << 3) | (self.length_low >> 61))
        append_word(&mut last, self.length_low << 3)
        let state = self.state
        let at: usize = 0
        while at < last.len():
            state = compress(state, last, at, self.rounds)
            at += 128
        let mut bytes: List[u8] = []
        for word in state:
            append_word(&mut bytes, word)
        Digest { bytes: bytes }

fn append_word(bytes: &mut List[u8], word: u64) -> void:
    for index in 0..8:
        bytes.push(u8(word >> u32(56 - 8 * index)))

fn rotate_right(word: u64, count: u32) -> u64:
    (word >> count) | (word << (64 - count))

# Eighty rounds and eighty schedule words per fixed 128-byte block.
# All indices and branches depend on public lengths or round counters.
fn compress(state: List[u64], bytes: List[u8], at: usize, rounds: List[u64]) -> List[u64]:
    let mut schedule: List[u64] = []
    for index in 0..16:
        let word: u64 = 0
        for byte in 0..8:
            word = (word << 8) | u64(bytes[at + 8 * index + byte])
        schedule.push(word)
    for index in 16..80:
        low := schedule[index - 15]
        high := schedule[index - 2]
        s0 := rotate_right(low, 1) ^ rotate_right(low, 8) ^ (low >> 7)
        s1 := rotate_right(high, 19) ^ rotate_right(high, 61) ^ (high >> 6)
        schedule.push(
            schedule[index - 16].wrapping_add(s0)
                .wrapping_add(schedule[index - 7])
                .wrapping_add(s1),
        )
    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]
    let f = state[5]
    let g = state[6]
    let h = state[7]
    for index in 0..80:
        sum1 := rotate_right(e, 14) ^ rotate_right(e, 18) ^ rotate_right(e, 41)
        choice := (e & f) ^ (~e & g)
        first := h.wrapping_add(sum1)
            .wrapping_add(choice)
            .wrapping_add(rounds[index])
            .wrapping_add(schedule[index])
        sum0 := rotate_right(a, 28) ^ rotate_right(a, 34) ^ rotate_right(a, 39)
        majority := (a & b) ^ (a & c) ^ (b & c)
        second := sum0.wrapping_add(majority)
        h = g
        g = f
        f = e
        e = d.wrapping_add(first)
        d = c
        c = b
        b = a
        a = first.wrapping_add(second)
    [
        state[0].wrapping_add(a),
        state[1].wrapping_add(b),
        state[2].wrapping_add(c),
        state[3].wrapping_add(d),
        state[4].wrapping_add(e),
        state[5].wrapping_add(f),
        state[6].wrapping_add(g),
        state[7].wrapping_add(h),
    ]

# FIPS 180-4 section 4.2.3: cube-root fractional parts of the first 80 primes.
fn round_constants() -> List[u64]:
    [
        0x428a2f98d728ae22,
        0x7137449123ef65cd,
        0xb5c0fbcfec4d3b2f,
        0xe9b5dba58189dbbc,
