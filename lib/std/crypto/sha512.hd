tests:
    use std.testing.{assert, assert_equal}

    it("FIPS SHA-512 empty, abc and 896-bit messages"):
        assert_equal(
            sha512("".bytes().collect()).to_hex(),
            "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e",
            reason="FIPS SHA-512",
        )
        assert_equal(
            sha512("abc".bytes().collect()).to_hex(),
            "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
            reason="FIPS SHA-512",
        )
        assert_equal(
            sha512(
                "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".bytes(
                )
                    .collect(),
            )
                .to_hex(),
            "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
            reason="FIPS SHA-512",
        )

    it("padding boundaries and every split preserve the digest"):
        # Independent expected hashes from Python hashlib (OpenSSL SHA-512).
        assert_equal(
            sha512([for _ in 0..111 => u8(0x61)]).to_hex(),
            "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2",
            reason="111 bytes",
        )
        assert_equal(
            sha512([for _ in 0..112 => u8(0x61)]).to_hex(),
            "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca",
            reason="112 bytes",
        )
        assert_equal(
            sha512([for _ in 0..127 => u8(0x61)]).to_hex(),
            "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502",
            reason="127 bytes",
        )
        assert_equal(
            sha512([for _ in 0..128 => u8(0x61)]).to_hex(),
            "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321",
            reason="128 bytes",
        )
        assert_equal(
            sha512([for _ in 0..129 => u8(0x61)]).to_hex(),
            "4f681e0bd53cda4b5a2041cc8a06f2eabde44fb16c951fbd5b87702f07aeab611565b19c47fde30587177ebb852e3971bbd8d3fd30da18d71037dfbd98420429",
            reason="129 bytes",
        )
        assert_equal(
            sha512([for _ in 0..255 => u8(0x61)]).to_hex(),
            "d8b5a659e365f704ab114ae7079a8da24fb9997b3052a4a63b37d654652bad6fbdd2b52d737e20a9d5ac3c5831d6afdd32ff737a3dd95269d2793bc2aa850aab",
            reason="255 bytes",
        )
        assert_equal(
            sha512([for _ in 0..256 => u8(0x61)]).to_hex(),
            "6a9169eb662f136d87374070e8828b3e615a7eca32a89446e9225b02832709be095e635c824a2bb70213ba2ea0ababac0809827843992c851903b7ac0c136699",
            reason="256 bytes",
        )
        message := [for index in 0..257 => u8(index)]
        expected := sha512(message)
        for split in 0..258:
            hasher := Sha512::new()
            hasher.update(message.slice(0, split))
            hasher.update(message.slice(split, message.len()))
            assert(hasher.finish() == expected, reason="chunk split")
            assert(hasher.finish() == expected, reason="repeated finish")
            hasher.update([33])
            assert(hasher.finish() != expected, reason="continued input")

    it("RFC 4231 HMAC-SHA512 cases 1 to 7"):
        # RFC case 5 publishes 16 bytes; its full value is also checked
        # against Python hmac/hashlib, as are the boundary-key cases below.
        assert_equal(
            Sha512::hmac([for _ in 0..20 => u8(0x0b)])
                .update("Hi There".bytes().collect())
                .finish()
                .to_hex(),
            "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854",
            reason="RFC 4231 case 1",
        )
        assert_equal(
            Sha512::hmac("Jefe".bytes().collect())
                .update("what do ya want for nothing?".bytes().collect())
                .finish()
                .to_hex(),
            "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737",
            reason="RFC 4231 case 2",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..20 => u8(0xaa)])
                .update([for _ in 0..50 => u8(0xdd)])
                .finish()
                .to_hex(),
            "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb",
            reason="RFC 4231 case 3",
        )
        assert_equal(
            Sha512::hmac([for byte in 1..26 => u8(byte)])
                .update([for _ in 0..50 => u8(0xcd)])
                .finish()
                .to_hex(),
            "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd",
            reason="RFC 4231 case 4",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..20 => u8(0x0c)])
                .update("Test With Truncation".bytes().collect())
                .finish()
                .to_hex(),
            "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b",
            reason="RFC 4231 case 5",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..131 => u8(0xaa)])
                .update("Test Using Larger Than Block-Size Key - Hash Key First".bytes().collect())
                .finish()
                .to_hex(),
            "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598",
            reason="RFC 4231 case 6",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..131 => u8(0xaa)])
                .update(
                    "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.".bytes(
                    )
                        .collect(),
                )
                .finish()
                .to_hex(),
            "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58",
            reason="RFC 4231 case 7",
        )

    it("HMAC block-size boundaries, empty input and non-destructive finish"):
        assert_equal(
            Sha512::hmac([]).finish().to_hex(),
            "b936cee86c9f87aa5d3c6f2e84cb5a4239a5fe50480a6ec66b70ab5b1f4ac6730c6c515421b327ec1d69402e53dfb49ad7381eb067b338fd7b0cb22247225d47",
            reason="empty key and message",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..0 => u8(0x6b)]).update([97, 98, 99]).finish().to_hex(),
            "29689f6b79a8dd686068c2eeae97fd8769ad3ba65cb5381f838358a8045a358ee3ba1739c689c7805e31734fb6072f87261d1256995370d55725cba00d10bdd0",
            reason="0 byte key",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..127 => u8(0x6b)]).update([97, 98, 99]).finish().to_hex(),
            "87d9a86dcd5439d38e60035b542ac8811bc504e73ffb0f4f2fa867bd1ca80163411c25f4dbf6071223b5b775fd32620db214620750cebcb38cf5424a3b5af9f8",
            reason="127 byte key",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..128 => u8(0x6b)]).update([97, 98, 99]).finish().to_hex(),
            "b3327a783059e7fa5af7b4836f7b7d3a9403e96a2cb5fd4dd50a78b3eb9b4e71111fc2286d58ea8f997d4271e709ae184d7d825cbab47c392970b4d84190b9c3",
            reason="128 byte key",
        )
        assert_equal(
            Sha512::hmac([for _ in 0..129 => u8(0x6b)]).update([97, 98, 99]).finish().to_hex(),
            "a1486b47baffa36173ff9d14c6be4ad40a33f1bbd1a226fdf75b884fe56804056571f40130c8aa35001e15a5cbfcd3f8be6c1fc971cb31e0180eb64670e6626c",
            reason="129 byte key",
        )
        key := "Jefe".bytes().collect()
        hasher := Sha512::hmac(key).update("what do ya ".bytes().collect())
        first := hasher.finish()
        assert(hasher.finish() == first, reason="repeat HMAC finish")
        hasher.update("want for nothing?".bytes().collect())
        expected := Sha512::hmac(key)
            .update("what do ya want for nothing?".bytes().collect())
            .finish()
        assert(hasher.finish() == expected, reason="streamed HMAC")
        assert(hasher.finish() != first, reason="HMAC continuation")
