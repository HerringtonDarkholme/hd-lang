type Planes = (u32, u32, u32, u32, u32, u32, u32, u32)

## Why an AES key was rejected.
## See [std-crypto-aes.key-error](../../../spec/std/crypto-aes.md#r-std-crypto-aes.key-error).
@derive(Debug, Eq)
@error
pub enum AesError:
    @error("AES key must contain 16, 24, or 32 bytes; got $length")
    InvalidKeyLength(length: usize)

## An immutable expanded AES key for encryption and decryption.
## See [std-crypto-aes.type](../../../spec/std/crypto-aes.md#r-std-crypto-aes.type).
pub struct Aes:
    keys: List[Planes]

impl Aes:
    ## Expands a 16-, 24-, or 32-byte AES key.
    ## See [std-crypto-aes.new](../../../spec/std/crypto-aes.md#r-std-crypto-aes.new).
    pub fn new(key: List[u8]) -> Result[Aes, AesError]:
        if key.len() != 16 && key.len() != 24 && key.len() != 32:
            return .Err(.InvalidKeyLength(key.len()))
        .Ok(Aes { keys: expand_key(key) })

    ## AES always processes 16-byte blocks.
    ## See [std-crypto-aes.block-size](../../../spec/std/crypto-aes.md#r-std-crypto-aes.block-size).
    pub fn block_size(&self) -> usize:
        16

    ## Encrypts one block, returning a new 16-byte list.
    ## See [std-crypto-aes.encrypt](../../../spec/std/crypto-aes.md#r-std-crypto-aes.encrypt).
    pub fn encrypt_block(&self, block: List[u8]) -> List[u8]:
        if block.len() != 16:
            panic("AES encryption requires exactly 16 bytes")
        encrypt(self.keys, block)

    ## Encrypts sixteen bytes in a caller buffer, starting at offset.
    ## See [std-crypto-aes.encrypt-into](../../../spec/std/crypto-aes.md#r-std-crypto-aes.encrypt-into).
    pub fn encrypt_block_into(&self, block: &mut List[u8], offset: usize) -> void:
        if offset > block.len() || block.len() - offset < 16:
            panic("AES encryption requires sixteen bytes at the given offset")
        state := encrypt_planes(self.keys, read_planes(block, offset, 16))
        for byte in 0..16:
            block[offset + byte] = lane(state, byte)

    ## Decrypts one block, returning a new 16-byte list.
    ## See [std-crypto-aes.decrypt](../../../spec/std/crypto-aes.md#r-std-crypto-aes.decrypt).
    pub fn decrypt_block(&self, block: List[u8]) -> List[u8]:
        if block.len() != 16:
            panic("AES decryption requires exactly 16 bytes")
        decrypt(self.keys, block)

# Fixed scalar tuples keep the complete block state in Wasm locals.
# The only List construction below is the optional value-returning wrapper.
fn read_planes(bytes: &List[u8], offset: usize, count: usize) -> Planes:
    let q0: u32 = 0
    let q1: u32 = 0
    let q2: u32 = 0
    let q3: u32 = 0
    let q4: u32 = 0
    let q5: u32 = 0
    let q6: u32 = 0
    let q7: u32 = 0
    for index in 0..count:
        value := u32(bytes[offset + index])
        shift := u32(index)
        q0 = q0 | (((value >> 0) & 1) << shift)
        q1 = q1 | (((value >> 1) & 1) << shift)
        q2 = q2 | (((value >> 2) & 1) << shift)
        q3 = q3 | (((value >> 3) & 1) << shift)
        q4 = q4 | (((value >> 4) & 1) << shift)
        q5 = q5 | (((value >> 5) & 1) << shift)
        q6 = q6 | (((value >> 6) & 1) << shift)
        q7 = q7 | (((value >> 7) & 1) << shift)
    (q0, q1, q2, q3, q4, q5, q6, q7)

fn planes(bytes: List[u8]) -> Planes:
    read_planes(&bytes, 0, bytes.len())

fn lane(state: Planes, index: usize) -> u8:
    shift := u32(index)
    u8(
        (((state._0 >> shift) & 1) << 0)
        | (((state._1 >> shift) & 1) << 1)
        | (((state._2 >> shift) & 1) << 2)
        | (((state._3 >> shift) & 1) << 3)
        | (((state._4 >> shift) & 1) << 4)
        | (((state._5 >> shift) & 1) << 5)
        | (((state._6 >> shift) & 1) << 6)
        | (((state._7 >> shift) & 1) << 7),
    )

fn unplane(state: Planes, count: usize) -> List[u8]:
    [for index in 0..count => lane(state, index)]

fn substitute(bytes: List[u8], inverse: bool) -> List[u8]:
    unplane(substitute_planes(planes(bytes), inverse), bytes.len())

fn substitute_planes(state: Planes, inverse: bool) -> Planes:
    if inverse:
        return inverse_affine(sbox(inverse_affine(state)))
    sbox(state)

# Inverse affine map across eight scalar planes; only sixteen lanes are active.
fn inverse_affine(state: Planes) -> Planes:
    (
        (state._7 ^ state._5 ^ state._2 ^ 0xffff) & 0xffff,
        (state._0 ^ state._6 ^ state._3) & 0xffff,
        (state._1 ^ state._7 ^ state._4 ^ 0xffff) & 0xffff,
        (state._2 ^ state._0 ^ state._5) & 0xffff,
        (state._3 ^ state._1 ^ state._6) & 0xffff,
        (state._4 ^ state._2 ^ state._7) & 0xffff,
        (state._5 ^ state._3 ^ state._0) & 0xffff,
        (state._6 ^ state._4 ^ state._1) & 0xffff,
    )

# Straight-line AND/XOR/NOT circuit: no secret branch or memory address.
fn sbox(q: Planes) -> Planes:
    x0 := q._7
    x1 := q._6
    x2 := q._5
    x3 := q._4
    x4 := q._3
    x5 := q._2
    x6 := q._1
    x7 := q._0
    y14 := x3 ^ x5
    y13 := x0 ^ x6
    y9 := x0 ^ x3
    y8 := x0 ^ x5
    t0 := x1 ^ x2
    y1 := t0 ^ x7
    y4 := y1 ^ x3
    y12 := y13 ^ y14
    y2 := y1 ^ x0
    y5 := y1 ^ x6
    y3 := y5 ^ y8
    t1 := x4 ^ y12
    y15 := t1 ^ x5
    y20 := t1 ^ x1
    y6 := y15 ^ x7
    y10 := y15 ^ t0
    y11 := y20 ^ y9
    y7 := x7 ^ y11
    y17 := y10 ^ y11
    y19 := y10 ^ y8
    y16 := t0 ^ y11
    y21 := y13 ^ y16
    y18 := x0 ^ y16
    t2 := y12 & y15
    t3 := y3 & y6
    t4 := t3 ^ t2
    t5 := y4 & x7
    t6 := t5 ^ t2
    t7 := y13 & y16
    t8 := y5 & y1
    t9 := t8 ^ t7
    t10 := y2 & y7
    t11 := t10 ^ t7
    t12 := y9 & y11
    t13 := y14 & y17
    t14 := t13 ^ t12
    t15 := y8 & y10
    t16 := t15 ^ t12
    t17 := t4 ^ t14
    t18 := t6 ^ t16
    t19 := t9 ^ t14
    t20 := t11 ^ t16
    t21 := t17 ^ y20
    t22 := t18 ^ y19
    t23 := t19 ^ y21
    t24 := t20 ^ y18
    t25 := t21 ^ t22
    t26 := t21 & t23
    t27 := t24 ^ t26
    t28 := t25 & t27
    t29 := t28 ^ t22
    t30 := t23 ^ t24
    t31 := t22 ^ t26
    t32 := t31 & t30
    t33 := t32 ^ t24
    t34 := t23 ^ t33
    t35 := t27 ^ t33
    t36 := t24 & t35
    t37 := t36 ^ t34
    t38 := t27 ^ t36
    t39 := t29 & t38
    t40 := t25 ^ t39
    t41 := t40 ^ t37
    t42 := t29 ^ t33
    t43 := t29 ^ t40
    t44 := t33 ^ t37
    t45 := t42 ^ t41
    z0 := t44 & y15
    z1 := t37 & y6
    z2 := t33 & x7
    z3 := t43 & y16
    z4 := t40 & y1
    z5 := t29 & y7
    z6 := t42 & y11
    z7 := t45 & y17
    z8 := t41 & y10
    z9 := t44 & y12
    z10 := t37 & y3
    z11 := t33 & y4
    z12 := t43 & y13
    z13 := t40 & y5
    z14 := t29 & y2
    z15 := t42 & y9
    z16 := t45 & y14
    z17 := t41 & y8
    t46 := z15 ^ z16
    t47 := z10 ^ z11
    t48 := z5 ^ z13
    t49 := z9 ^ z10
    t50 := z2 ^ z12
    t51 := z2 ^ z5
    t52 := z7 ^ z8
    t53 := z0 ^ z3
    t54 := z6 ^ z7
    t55 := z16 ^ z17
    t56 := z12 ^ t48
    t57 := t50 ^ t53
    t58 := z4 ^ t46
    t59 := z3 ^ t54
    t60 := t46 ^ t57
    t61 := z14 ^ t57
    t62 := t52 ^ t58
    t63 := t49 ^ t58
    t64 := z4 ^ t59
    t65 := t61 ^ t62
    t66 := z1 ^ t63
    s0 := t59 ^ t63
    s6 := t56 ^ ~t62
    s7 := t48 ^ ~t60
    t67 := t64 ^ t65
    s3 := t53 ^ t66
    s4 := t51 ^ t66
    s5 := t47 ^ t65
    s1 := t64 ^ ~s3
    s2 := t55 ^ ~t67
    (s7, s6, s5, s4, s3, s2, s1, s0)

# FIPS 197 key expansion; the public constructor validates key length.
# Key sizes are public; all key-word substitutions use the Boolean circuit.
fn expand_key(key: List[u8]) -> List[Planes]:
    let mut expanded = key
    rounds := key.len() / 4 + 6
    let rcon: u8 = 1
    while expanded.len() < 16 * (rounds + 1):
        let mut word = expanded.slice(expanded.len() - 4, expanded.len())
        if expanded.len() % key.len() == 0:
            word = substitute([word[1], word[2], word[3], word[0]], false)
            word[0] = word[0] ^ rcon
            rcon = xtime(rcon)
        else if key.len() == 32 && expanded.len() % key.len() == 16:
            word = substitute(word, false)
        for index in 0..4:
            expanded.push(expanded[expanded.len() - key.len()] ^ word[index])
    [for round in 0..(rounds + 1) => planes(expanded.slice(16 * round, 16 * (round + 1)))]

fn xtime(value: u8) -> u8:
    (value << 1) ^ (u8(0).wrapping_sub(value >> 7) & 0x1b)

fn add_key(state: Planes, key: Planes) -> Planes:
    (
        state._0 ^ key._0,
        state._1 ^ key._1,
        state._2 ^ key._2,
        state._3 ^ key._3,
        state._4 ^ key._4,
        state._5 ^ key._5,
        state._6 ^ key._6,
        state._7 ^ key._7,
    )

fn rotate_plane(plane: u32, count: u32) -> u32:
    ((plane >> count) | (plane << (16 - count))) & 0xffff

fn shift_plane(word: u32, first: u32, third: u32) -> u32:
    (
        (word & 0x1111)
        | (rotate_plane(word & 0xffff, first) & 0x2222)
        | (rotate_plane(word & 0xffff, 8) & 0x4444)
        | (rotate_plane(word & 0xffff, third) & 0x8888)
    )

fn shift_rows(state: Planes, inverse: bool) -> Planes:
    first := if inverse: 12u32 else: 4u32
    third := if inverse: 4u32 else: 12u32
    (
        shift_plane(state._0, first, third),
        shift_plane(state._1, first, third),
        shift_plane(state._2, first, third),
        shift_plane(state._3, first, third),
        shift_plane(state._4, first, third),
        shift_plane(state._5, first, third),
        shift_plane(state._6, first, third),
        shift_plane(state._7, first, third),
    )

fn rotate_rows(word: u32) -> u32:
    ((word >> 1) & 0x7777) | ((word << 3) & 0x8888)

fn xtime_planes(q: Planes) -> Planes:
    (q._7, q._0 ^ q._7, q._1, q._2 ^ q._7, q._3 ^ q._7, q._4, q._5, q._6)

fn mixed_word(word: u32) -> u32:
    rotate_rows(word) ^ rotate_rows(rotate_rows(word)) ^ rotate_rows(rotate_rows(rotate_rows(word)))

fn mix_columns(state: Planes, inverse: bool) -> Planes:
    let work = state
    if inverse:
        pairs := (
            work._0 ^ rotate_rows(rotate_rows(work._0)),
            work._1 ^ rotate_rows(rotate_rows(work._1)),
            work._2 ^ rotate_rows(rotate_rows(work._2)),
            work._3 ^ rotate_rows(rotate_rows(work._3)),
            work._4 ^ rotate_rows(rotate_rows(work._4)),
            work._5 ^ rotate_rows(rotate_rows(work._5)),
            work._6 ^ rotate_rows(rotate_rows(work._6)),
            work._7 ^ rotate_rows(rotate_rows(work._7)),
        )
        work = add_key(work, xtime_planes(xtime_planes(pairs)))
    adjacent := xtime_planes(
        (
            work._0 ^ rotate_rows(work._0),
            work._1 ^ rotate_rows(work._1),
            work._2 ^ rotate_rows(work._2),
            work._3 ^ rotate_rows(work._3),
            work._4 ^ rotate_rows(work._4),
            work._5 ^ rotate_rows(work._5),
            work._6 ^ rotate_rows(work._6),
            work._7 ^ rotate_rows(work._7),
        ),
    )
    (
        mixed_word(work._0) ^ adjacent._0,
        mixed_word(work._1) ^ adjacent._1,
        mixed_word(work._2) ^ adjacent._2,
        mixed_word(work._3) ^ adjacent._3,
        mixed_word(work._4) ^ adjacent._4,
        mixed_word(work._5) ^ adjacent._5,
        mixed_word(work._6) ^ adjacent._6,
        mixed_word(work._7) ^ adjacent._7,
    )

fn encrypt_planes(keys: List[Planes], first: Planes) -> Planes:
    let state = add_key(first, keys[0])
    for round in 1..keys.len():
        state = shift_rows(substitute_planes(state, false), false)
        if round + 1 < keys.len():
            state = mix_columns(state, false)
        state = add_key(state, keys[round])
    state

fn encrypt(keys: List[Planes], block: List[u8]) -> List[u8]:
    unplane(encrypt_planes(keys, read_planes(&block, 0, 16)), 16)

fn decrypt(keys: List[Planes], block: List[u8]) -> List[u8]:
    let round = keys.len() - 1
    let state = add_key(read_planes(&block, 0, 16), keys[round])
    while round > 0:
        round -= 1
        state = substitute_planes(shift_rows(state, true), true)
        state = add_key(state, keys[round])
        if round > 0:
            state = mix_columns(state, true)
    unplane(state, 16)

tests:
    use std.encoding.hex.hex_decode

    fn vector(text: string) -> List[u8]:
        match hex_decode(text):
            .Ok(bytes) => bytes
            .Err(error) => panic("invalid published vector: $error")

