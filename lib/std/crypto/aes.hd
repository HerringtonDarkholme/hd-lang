        ]
        for start in 0..16:
            input := [for lane in 0..16 => u8(16 * start + lane)]
            forward := substitute(input, false)
            for lane in 0..16:
                assert_equal(forward[lane], expected[16 * start + lane], reason="FIPS S-box")
            assert_equal(substitute(forward, true), input, reason="inverse S-box")
        for value in 0..256:
            input := [for _ in 0..16 => u8(value)]
            assert_equal(
                substitute(input, false),
                [for _ in 0..16 => expected[value]],
                reason="all lanes",
            )

    it("FIPS 197 AES-128 AES-192 AES-256 encryption and inverse"):
        plain := vector("00112233445566778899aabbccddeeff")
        for (key, ciphertext) in [
            ("000102030405060708090a0b0c0d0e0f", "69c4e0d86a7b0430d8cdb78070b4c55a"),
            (
                "000102030405060708090a0b0c0d0e0f1011121314151617",
                "dda97ca4864cdfe06eaf70a0ec0d7191",
            ),
            (
                "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
                "8ea2b7ca516745bfeafc49904b496089",
            ),
        ]:
            keys := expand_key(vector(key))
            expected := vector(ciphertext)
            assert_equal(encrypt(keys, plain), expected, reason="FIPS encryption")
            assert_equal(decrypt(keys, expected), plain, reason="FIPS inverse")

    it("public AES construction validates key sizes and keeps the expanded key immutable"):
        for length in [0, 1, 15, 17, 23, 25, 31, 33]:
            match Aes::new([for _ in 0..length => u8(0)]):
                .Err(error) =>
                    assert_equal(error, AesError::InvalidKeyLength(length), reason="key length")
                .Ok(_) => panic("accepted invalid AES key length")
        for length in [16, 24, 32]:
            match Aes::new([for index in 0..length => u8(index)]):
                .Err(error) => panic("rejected valid AES key: $error")
                .Ok(cipher) =>
                    assert_equal(cipher.block_size(), 16, reason="AES block size")
                    plain := [for index in 0..16 => u8(index * 17)]
                    before := plain
                    encrypted := cipher.encrypt_block(plain)
                    assert_equal(
                        cipher.decrypt_block(encrypted),
                        before,
                        reason="public round trip",
                    )
                    assert_equal(cipher.encrypt_block(plain), encrypted, reason="key reuse")
                    assert_equal(plain, before, reason="input value unchanged")

    it("caller-buffer AES preserves surrounding bytes and value aliases"):
        plain := vector("00112233445566778899aabbccddeeff")
        for (key, ciphertext) in [
            ("000102030405060708090a0b0c0d0e0f", "69c4e0d86a7b0430d8cdb78070b4c55a"),
            (
                "000102030405060708090a0b0c0d0e0f1011121314151617",
                "dda97ca4864cdfe06eaf70a0ec0d7191",
            ),
            (
                "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
                "8ea2b7ca516745bfeafc49904b496089",
            ),
        ]:
            match Aes::new(vector(key)):
                .Err(error) => panic("valid vector key rejected: $error")
                .Ok(cipher) =>
                    let mut buffer: List[u8] = [9, 9]
                    buffer.extend(plain)
                    buffer.extend([7, 7])
                    before := buffer
                    cipher.encrypt_block_into(&mut buffer, 2)
                    assert_equal(buffer.slice(2, 18), vector(ciphertext), reason="FIPS in-place")
                    assert_equal(buffer.slice(0, 2), [9, 9], reason="prefix unchanged")
                    assert_equal(buffer.slice(18, 20), [7, 7], reason="suffix unchanged")
                    assert_equal(before.slice(2, 18), plain, reason="value alias unchanged")
