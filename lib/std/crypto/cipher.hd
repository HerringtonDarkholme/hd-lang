    struct Counted[B < ?Copy & Block]:
        base: B
        calls: *mut usize

    impl[B < ?Copy & Block] Block for Counted[B]:
        fn block_size(&self) -> usize:
            self.base.block_size()

        fn encrypt_block(&self, bytes: &mut List[u8], offset: usize) -> void:
            *self.calls += 1
            self.base.encrypt_block(bytes, offset)

    it("GCM rejects every changed ciphertext or tag byte before decrypting"):
        calls := box(usize(0))
        base := Counted { base: aes([for _ in 0..16 => u8(0)]), calls: calls }
        cipher := match Gcm::[Counted[Aes]].new(base):
            .Ok(value) => value
            .Err(error) => panic("valid mode rejected: $error")
        nonce := [for _ in 0..12 => u8(0)]
        plain := [for byte in 0..33 => u8(byte)]
        associated := [for byte in 0..17 => u8(byte)]
        sealed := cipher.seal(nonce, plain, associated)
        for at in 0..sealed.len():
            let mut bad = sealed
            bad[at] = bad[at] ^ 1
            *calls = 0
            assert(
                cipher.open(nonce, bad, associated) == .Err(.AuthenticationFailed),
                reason="changed byte",
            )
            assert_equal(*calls, 1, reason="only tag-mask encryption, no plaintext decryption")
        *calls = 0
        assert(
            cipher.open(nonce, [], associated) == .Err(.AuthenticationFailed),
            reason="short sealed message",
        )
        assert_equal(*calls, 0, reason="public length check before cryptography")
        let mut bad_nonce = nonce
        bad_nonce[0] = 1
        assert(
            cipher.open(bad_nonce, sealed, associated) == .Err(.AuthenticationFailed),
            reason="nonce mismatch",
        )
        let mut bad_associated = associated
        bad_associated[0] = bad_associated[0] ^ 1
        assert(
            cipher.open(nonce, sealed, bad_associated) == .Err(.AuthenticationFailed),
            reason="AAD mismatch",
        )

    it("SP 800-38A AES-CTR vectors and every stream split"):
        for (key, iv, plain, expected) in [
            (
                "2b7e151628aed2a6abf7158809cf4f3c",
                "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
                "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710",
                "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee",
            ),
            (
                "8e73b0f7da0e6452c810f32b809079e562f8ead2522c6b7b",
                "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
                "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710",
                "1abc932417521ca24f2b0459fe7e6e0b090339ec0aa6faefd5ccc2c6f4ce8e941e36b26bd1ebc670d1bd1d665620abf74f78a7f6d29809585a97daec58c6b050",
            ),
            (
                "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4",
                "f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
                "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710",
                "601ec313775789a5b7a7f504bbf3d228f443e3ca4d62b59aca84e990cacaf5c52b0930daa23de94ce87017ba2d84988ddfc9c58db67aada613c2dd08457941a6",
            ),
        ]:
            cipher := aes(vector(key))
            iv := vector(iv)
            plain := vector(plain)
            expected := vector(expected)
            assert_equal(
                Ctr::[Aes].new(cipher, iv).xor_key_stream(plain),
                expected,
                reason="NIST CTR",
            )
            assert_equal(
                Ctr::[Aes].new(cipher, iv).xor_key_stream(expected),
                plain,
                reason="CTR reverse",
            )
            for split in 0..(plain.len() + 1):
                stream := Ctr::[Aes].new(cipher, iv)
                assert_equal(stream.xor_key_stream([]), [], reason="empty before")
                let mut actual = stream.xor_key_stream(plain.slice(0, split))
                assert_equal(stream.xor_key_stream([]), [], reason="empty between")
                actual.extend(stream.xor_key_stream(plain.slice(split, plain.len())))
                assert_equal(actual, expected, reason="split stream")
            stream := Ctr::[Aes].new(cipher, iv)
            let mut actual: List[u8] = []
            for byte in plain:
                actual.extend(stream.xor_key_stream([byte]))
            assert_equal(actual, expected, reason="single-byte stream")

    use std.collections.UniqList

    struct ToyBlock:
        width: usize
        key: UniqList[u8]

    fn toy(width: usize) -> ToyBlock:
        let mut key = UniqList::[u8].new()
        key.push(0x5a)
        ToyBlock { width: width, key: key }

    impl Block for ToyBlock:
        fn block_size(&self) -> usize:
            self.width

        fn encrypt_block(&self, bytes: &mut List[u8], offset: usize) -> void:
            for byte in 0..self.width:
                bytes[offset + byte] = bytes[offset + byte] ^ self.key[0]

    it("modes accept non-copy block ciphers and CTR wraps the full counter"):
        iv := [for _ in 0..8 => u8(0xff)]
        stream := Ctr::[ToyBlock].new(toy(8), iv)
        actual := stream.xor_key_stream([for _ in 0..24 => u8(0)])
        let mut expected: List[u8] = [for _ in 0..8 => u8(0xa5)]
        expected.extend([for _ in 0..15 => u8(0x5a)])
        expected.push(0x5b)
        assert_equal(actual, expected, reason="all eight counter bytes wrap")
        assert_equal(iv, [for _ in 0..8 => u8(0xff)], reason="IV value unchanged")
        match Gcm::[ToyBlock].new(toy(16)):
            .Err(error) => panic("valid non-copy block rejected: $error")
            .Ok(cipher) =>
                nonce := [for _ in 0..12 => u8(0)]
                plain := [for byte in 0..33 => u8(byte)]
                associated := [1, 2, 3]
                sealed := cipher.seal(nonce, plain, associated)
                assert(cipher.open(nonce, sealed, associated) == .Ok(plain), reason="non-copy GCM")

    it("GCM validates configuration and supports every Go tag size"):
        zero := [for _ in 0..16 => u8(0)]
        nonce := [for _ in 0..12 => u8(0)]
        plain := [for byte in 0..33 => u8(byte)]
        full := mode(aes(zero), 12, 16).seal(nonce, plain, [])
        for size in 12..17:
            match Gcm::[Aes].with_tag_size(aes(zero), size):
                .Err(error) => panic("valid tag size rejected: $error")
                .Ok(cipher) =>
                    assert_equal(cipher.nonce_size(), 12, reason="default nonce size")
                    assert_equal(cipher.overhead(), size, reason="configured tag size")
                    sealed := cipher.seal(nonce, plain, [])
                    assert_equal(sealed, full.slice(0, plain.len() + size), reason="tag truncation")
                    assert(cipher.open(nonce, sealed, []) == .Ok(plain), reason="custom tag open")
        for size in [0, 4, 8, 11, 17]:
            match Gcm::[Aes].with_tag_size(aes(zero), size):
                .Err(error) =>
                    assert_equal(error, CipherError::InvalidTagSize(size), reason="tag error")
                .Ok(_) => panic("invalid tag size accepted")
        match Gcm::[Aes].with_nonce_size(aes(zero), 0):
            .Err(error) =>
                assert_equal(error, CipherError::InvalidNonceSize(0), reason="zero nonce")
            .Ok(_) => panic("empty nonce accepted")
        match Gcm::[ToyBlock].new(toy(8)):
            .Err(error) =>
                assert_equal(error, CipherError::InvalidBlockSize(8), reason="GCM block width")
            .Ok(_) => panic("GCM accepted a non-128-bit block")
