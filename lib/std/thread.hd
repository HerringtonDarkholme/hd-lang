# std.thread: scoped threads on one heap (spec/std/thread.md). Each
# thread runs a `Send` closure in another instance of the program on the
# same heap (spec/lang/10-modules.md#thread-intrinsics); `scope` waits for
# every thread it started before it returns, so a closure may borrow what
# outlives the scope (ref.frozen.lifetime). This is Rust's
# `std::thread::scope`.
use std.marker.Send
use std.rt.Drop
use std.rt.bytes.panic_with
use std.rt.thread.{abandon, new_block, release, run, run_here, share, take, wait}

## The threads of one `scope` call, whose closures may borrow for `'s`.
## See [std-thread.scope](../../spec/std/thread.md#r-std-thread.scope).
pub struct Scope['s]:
    threads: List[usize]

impl['s] !Copy for Scope['s]

## A thread a `Scope` started, which gives the value its closure returned.
## See [std-thread.join](../../spec/std/thread.md#r-std-thread.join).
pub struct Handle[T < ?Copy & Send]:
    thread: usize

impl[T < ?Copy & Send] !Copy for Handle[T]

## A handle names a block of this heap, so it may go to another thread but never to another memory.
## See [std-thread.handle.send](../../spec/std/thread.md#r-std-thread.handle.send).
impl[T < ?Copy & Send] Send for Handle[T]

## Calls `code` with a new `Scope`, then waits for every thread it started, and gives what `code` returned.
## See [std-thread.scope](../../spec/std/thread.md#r-std-thread.scope).
pub fn scope['s, R < ?Copy](code: fn(&mut Scope['s]) -> R) -> R:
    let mut threads = Scope { threads: [] }
    value := code(&mut threads)
    # Every thread ends before any is reported (std-thread.scope.stopped).
    let stopped = false
    for thread in threads.threads:
        stopped = !wait(thread) || stopped
        release(thread)
    if stopped:
        panic_with("thread-stopped", "a scope's thread stopped before its closure returned")
    value

impl['s] Scope['s]:
    ## Starts a thread that runs `code`, which may borrow for `'s`, and gives its handle.
    ## See [std-thread.spawn](../../spec/std/thread.md#r-std-thread.spawn).
    pub fn spawn[T < ?Copy & Send](&mut self, code: fn() -> T + Send & 's) -> Handle[T]:
        thread := new_block::[T]()
        if !start_thread(thread, run::[T], code):
            run_here::[T](thread)
        share(thread)
        self.threads.push(thread)
        Handle::[T] { thread: thread }

impl[T < ?Copy & Send] Handle[T]:
    ## Waits for the thread to end and gives the value its closure returned.
    ## See [std-thread.join](../../spec/std/thread.md#r-std-thread.join).
    pub fn join(self) -> T:
        if !wait(self.thread):
            panic_with("thread-stopped", "a thread stopped before its closure returned")
        take::[T](self.thread)

impl[T < ?Copy & Send] Drop for Handle[T]:
    # A handle that took its value leaves none to drop here.
    fn drop(&mut self) -> void:
        abandon::[T](self.thread)
        release(self.thread)

@intrinsic("thread_spawn")
# Writes `run` into `block`'s third and fourth words and moves `code` into
# its sixth and seventh, and asks the host for a thread whose instance runs
# `run(block)` on the frame region of the block's first two
# (module.rt.thread.spawn); whether the host started it. The block owns
# the environment's count, so the call here neither runs nor drops `code`.
fn start_thread[T < ?Copy & Send](
    block: usize,
    run: fn(usize) -> void,
    code: fn() -> T + Send,
) -> bool:
    panic("intrinsic")
