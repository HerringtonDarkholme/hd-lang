# std.error: the error trait `Error` (spec/lang/09-traits.md#error-trait),
# its cause chain, the boundary-safe `ErrorReport`, and `ContextError` with
# `Result.context` (spec/std/error.md).
# `Error` is not a prelude name (module.prelude.from-error). It extends
# `Inspectable`, so its users need not import it
# (module.prelude.error-inspectable).
use std.inspect.{Inspectable, downcast_val}
use std.format.DebugWriter
use std.num.ParseNumberError
use std.text.Utf8Error
use std.console.ConsoleError

## The standard error trait: a displayable, inspectable failure that may name its cause.
## See [trait.error.module](../../spec/lang/09-traits.md#r-trait.error.module).
pub trait Error < Display & Inspectable:
    fn cause(self) -> dyn Error?: .None

# The cause-chain helpers are inherent methods of `dyn Error`
# (spec/lang/09-traits.md#r-trait.own.dyn-inherent.form): every error value
# reaches them, and no implementation can override them (r-std-error.chain-methods).
impl dyn Error:
    ## Returns this error first, then its `cause`, then that error's cause, and so on.
    ## See [std-error.chain.method](../../spec/std/error.md#r-std-error.chain.method).
    pub fn chain(self) -> List[dyn Error]:
        let errors: mut List[dyn Error] = [self]
        let next = self.cause()
        while true:
            match next:
                .Some(cause) =>
                    errors.push(cause)
                    next = cause.cause()
                .None =>
                    return errors

    # The last error of `self.chain()` (r-std-error.root-cause).
    ## Returns the last error of the cause chain.
    ## See [std-error.root-cause](../../spec/std/error.md#r-std-error.root-cause).
    pub fn root_cause(self) -> dyn Error:
        errors := self.chain()
        errors[errors.len() - 1]

    # The first error of `self.chain()` whose recorded type is `T`, recovered
    # through `downcast_val`: an enum error comes back as an equal value, and
    # a data error as the same reference (r-std-error.find.value). `T` may be
    # any error type, a value type included, by
    # spec/lang/09-traits.md#r-trait.dyn.safe.method-type-param.
    ## Returns the first error of the cause chain whose type is `T`.
    ## See [std-error.find.first](../../spec/std/error.md#r-std-error.find.first).
    pub fn find[T < Error](self) -> T?:
        for error in self.chain():
            match downcast_val::[T](error):
                .Some(found) => return .Some(found)
                .None => pass
        .None

# A snapshot of an error's message and the messages of its causes
# (r-std-error.report.decl). Its fields are boundary-safe.
## A boundary-safe report of an error: its message and the messages of its causes.
## See [std-error.report.decl](../../spec/std/error.md#r-std-error.report.decl).
pub data ErrorReport:
    ## The error's own message.
    ## See [std-error.report.message](../../spec/std/error.md#r-std-error.report.message).
    pub message: string
    ## The messages of the error's causes, in chain order.
    ## See [std-error.report.causes](../../spec/std/error.md#r-std-error.report.causes).
    pub causes: List[string]

# The text an entry point prints for an `.Err` (r-std-error.report.display):
# the message, then one `caused by: ` line per cause.
impl Display for ErrorReport:
    fn to_string(self) -> string:
        let lines: mut List[string] = [self.message]
        for cause in self.causes:
            lines.push(cause)
        lines.join("\ncaused by: ")

# The error itself, then each `cause` in turn until one is `.None`
# (r-std-error.chain.order).
## Returns `error` first, then the error its `cause` returns, then that error's cause, and so on.
## See [std-error.chain.decl](../../spec/std/error.md#r-std-error.chain.decl).
pub fn chain(error: dyn Error) -> List[dyn Error]:
    error.chain()

# The `Display` text of the error and of each cause that `chain` yields
# after it (r-std-error.report.of).
## Builds the boundary-safe report of `error`: its message, and its causes' messages.
## See [std-error.report.of](../../spec/std/error.md#r-std-error.report.of).
pub fn report_of(error: dyn Error) -> ErrorReport:
    errors := chain(error)
    let causes: mut List[string] = []
    let index: usize = 1
    while index < errors.len():
        causes.push(errors[index].to_string())
        index = index + 1
    ErrorReport { message: error.to_string(), causes: causes }

# The report the host writes to standard error when an entry point returns
# `.Err(error)` and the error's type implements `Error`
# (spec/lang/10-modules.md#r-module.entry.err-render-chain). The checker
# calls it from the entry renderer (checker/entry-error.ts).
fn entry_report(error: dyn Error) -> string:
    report_of(error).to_string()

# The error that `context` wraps around an `.Err`: its text is the message,
# and its cause is the wrapped error (r-std-error.context.type).
## An error that adds a context message over its cause.
## See [std-error.context.type](../../spec/std/error.md#r-std-error.context.type).
pub data ContextError:
    message: string
    error: dyn Error

impl Display for ContextError:
    fn to_string(self) -> string:
        self.message

impl Error for ContextError:
    fn cause(self) -> dyn Error?:
        .Some(self.error)

# The std error types of the prelude-joined modules implement `Error` here,
# so a program that never names `Error` does not join this module
# (r-std-error.std-types.impl). The other modules' error types implement it
# beside their declarations.
impl Error for ParseNumberError
impl Error for Utf8Error
impl Error for ConsoleError

# Wraps an `.Err(e)` in a `ContextError`; `.Ok` passes through
# (r-std-error.context.ok, r-std-error.context.err).
impl[T, E < Error] Result[T, E]:
    ## For an `.Err`, wraps the error with `message` as its context; an `.Ok` is unchanged.
    ## See [std-error.context.decl](../../spec/std/error.md#r-std-error.context.decl).
    pub fn context(self, message: string) -> Result[T, dyn Error]:
        match self:
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(ContextError { message: message, error: error })

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for ErrorReport:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ErrorReport").field("message", self.message).field("causes", self.causes).finish()

# The erased cause has no `Debug`, so its `Display` text stands in for it
# (r-std-error.context.debug).
impl Debug for ContextError:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ContextError").field("message", self.message).field("cause", self.error.to_string()).finish()
