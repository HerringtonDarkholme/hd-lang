# std.error: the error trait `Error` (spec/lang/09-traits.md#error-trait),
# its cause chain, the boundary-safe `ErrorReport`, and `ContextError` with
# `Result.context` (spec/std/error.md).
# `Error` is not a prelude name (module.prelude.from-error). It extends
# `Inspectable`, so its users need not import it
# (module.prelude.error-inspectable).
use std.inspect.{Inspectable}
use std.format.DebugWriter
use std.num.ParseNumberError
use std.text.Utf8Error
use std.console.ConsoleError

pub trait Error < Display & Inspectable & AnyRef:
    fn cause(self) -> Error?: .None

    # The last error of `chain(self)` (r-std-error.root-cause).
    fn root_cause(self) -> Error:
        errors := chain(self)
        errors[errors.len() - 1]

    # The first error of `chain(self)` whose recorded type is `T`, through
    # the `downcast` method, so it is the same reference (r-std-error.find).
    # The specified bound is `T < Error`, which implies `AnyRef` and
    # `Inspectable`. The prototype needs both written out: its dynamic-safety
    # check (src/checker/program-signatures.ts) and its downcast target check
    # (src/checker/expression-inspect.ts) read only a direct bound.
    fn find[T < AnyRef & Inspectable & Error](self) -> T?:
        for error in chain(self):
            match error.downcast::[T]():
                .Some(found) => return .Some(found)
                .None => pass
        .None

# A snapshot of an error's message and the messages of its causes
# (r-std-error.report.decl). Its fields are boundary-safe.
pub data ErrorReport:
    pub message: string
    pub causes: List[string]

# The text an entry point prints for an `.Err` (r-std-error.report.display):
# the message, then one `caused by: ` line per cause.
impl Display for ErrorReport:
    fn to_string(self) -> string:
        let lines: mut List[string] = [self.message]
        for cause in self.causes:
            lines.push(cause)
        lines.join("\ncaused by: ")

# The error itself, then each `cause` in turn until one is `.None`
# (r-std-error.chain.order).
pub fn chain(error: Error) -> List[Error]:
    let errors: mut List[Error] = [error]
    let next = error.cause()
    while true:
        match next:
            .Some(cause) =>
                errors.push(cause)
                next = cause.cause()
            .None =>
                return errors

# The `Display` text of the error and of each cause that `chain` yields
# after it (r-std-error.report.of).
pub fn report_of(error: Error) -> ErrorReport:
    errors := chain(error)
    let causes: mut List[string] = []
    let index: usize = 1
    while index < errors.len():
        causes.push(errors[index].to_string())
        index = index + 1
    ErrorReport { message: error.to_string(), causes: causes }

# The error that `context` wraps around an `.Err`: its text is the message,
# and its cause is the wrapped error (r-std-error.context.type).
pub data ContextError:
    message: string
    error: Error

impl Display for ContextError:
    fn to_string(self) -> string:
        self.message

impl Error for ContextError:
    fn cause(self) -> Error?:
        .Some(self.error)

# The std error types of the prelude-joined modules implement `Error` here,
# so a program that never names `Error` does not join this module
# (r-std-error.std-types.impl). The other modules' error types implement it
# beside their declarations.
impl Error for ParseNumberError
impl Error for Utf8Error
impl Error for ConsoleError

# Wraps an `.Err(e)` in a `ContextError`; `.Ok` passes through
# (r-std-error.context.ok, r-std-error.context.err).
impl[T, E < Error] Result[T, E]:
    pub fn context(self, message: string) -> Result[T, Error]:
        match self:
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(ContextError { message: message, error: error })

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for ErrorReport:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ErrorReport").field("message", self.message).field("causes", self.causes).finish()

# The erased cause has no `Debug`, so its `Display` text stands in for it
# (r-std-error.context.debug).
impl Debug for ContextError:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ContextError").field("message", self.message).field("cause", self.error.to_string()).finish()
