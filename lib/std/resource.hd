# std.resource: the error of a closable runtime handle
# (spec/lang/10-modules.md#closable-handles). An operation whose ordinary error
# type is `E` returns `Result[T, ResourceError[E]]`.
use std.format.DebugWriter
use std.error.Error

## The error of a closable runtime handle: the operation's own error, or `Disposed`.
## See [module.resource.error](../../spec/lang/10-modules.md#r-module.resource.error).
pub enum ResourceError[E]:
    Operation(error: E)
    Disposed

# `Operation(e)` displays as `e`, and `Disposed` as `resource disposed`
# (r-std-error.std-types.resource).
impl[E < Display] Display for ResourceError[E]:
    fn to_string(self) -> string:
        match self:
            .Operation(error) => error.to_string()
            .Disposed => "resource disposed"

impl[E < Error] Error for ResourceError[E]

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl[E < Debug] Debug for ResourceError[E]:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Operation(error) => out.debug_tuple("ResourceError.Operation").named_field("error", error).finish()
            .Disposed => out.write("ResourceError.Disposed")
