# std.regex: regular expressions in the RE2 subset (spec/std/regex.md).
# `Regex::new` parses a pattern into a tree and compiles the tree into a
# program for a Pike VM. The VM runs every thread in step over the text and
# keeps at most one thread per instruction, so a search takes time
# proportional to the program size times the text length, with no
# backtracking (r-std-regex.time.linear). A prefilter taken from the tree
# lets a search start threads only where a match could start and jump over
# the text between.
use std.collections.UniqList
use std.format.DebugWriter
use std.encoding.{Deserialize, Deserializer, ValueKind, member_name}
use std.meta.{Facts, Member, VariantInfo}
use std.rt.{bytes_len, bytes_at, bytes_slice, char_scalar, bytes_index}

# A compiled pattern (r-std-regex.regex.decl-struct). `names[i]` is the name of
# group i, or "" for an unnamed group and for group 0.
## A compiled regular expression: immutable, and every match runs in time linear in the text.
## See [std-regex.regex.decl-struct](../../spec/std/regex.md#r-std-regex.regex.decl-struct).
pub struct Regex:
    text: string
    program: *Program
    filter: Prefilter
    forward: *mut Dfa
    reverse: *mut Dfa
    # The VM a call searches with, kept between calls.
    idle: *mut Vm
    names: List[string]

# Where a match is: byte offsets into the searched text, and its text
# (r-std-regex.match.decl-struct).
## One match of a regex in a text.
## See [std-regex.match.decl-struct](../../spec/std/regex.md#r-std-regex.match.decl-struct).
@derive(Debug, Eq)
pub struct Match:
    ## The byte offset where the match starts.
    ## See [std-regex.match.offsets](../../spec/std/regex.md#r-std-regex.match.offsets).
    pub start: usize
    ## The byte offset one past the match's end.
    ## See [std-regex.match.offsets](../../spec/std/regex.md#r-std-regex.match.offsets).
    pub end: usize
    ## The matched text.
    ## See [std-regex.match.text](../../spec/std/regex.md#r-std-regex.match.text).
    pub text: string

# The groups of one match (r-std-regex.captures.decl-struct): two optional byte
# offsets per group; `.None` means that the group took no part.
## The capture groups of one match: group 0 is the whole match.
## See [std-regex.captures.decl-struct](../../spec/std/regex.md#r-std-regex.captures.decl-struct).
@derive(Debug)
pub struct Captures:
    text: string
    slots: List[usize?]
    names: List[string]

# Pattern errors carry their byte position; decode errors name the match
# or group that could not be decoded (r-std-regex.error.variants-with-decode).
## Why a pattern failed to compile, a match was absent, or a group could not be decoded.
## See [std-regex.error.variants-with-decode](../../spec/std/regex.md#r-std-regex.error.variants-with-decode).
@error
@derive(Debug, Eq)
pub enum RegexError:
    @error("missing closing ) at byte $position")
    MissingParen(position: usize)
    @error("unexpected ) at byte $position")
    UnmatchedParen(position: usize)
    @error("missing closing ] at byte $position")
    MissingBracket(position: usize)
    @error("invalid escape at byte $position")
    BadEscape(position: usize)
    @error("invalid character class range at byte $position")
    BadRange(position: usize)
    @error("missing argument to repetition operator at byte $position")
    NothingToRepeat(position: usize)
    @error("invalid repeat count at byte $position")
    BadRepeat(position: usize)
    @error("unsupported group at byte $position")
    UnsupportedGroup(position: usize)
    @error("invalid named capture at byte $position")
    BadGroupName(position: usize)
    @error("duplicate capture group name at byte $position")
    DuplicateGroupName(position: usize)
    @error("expression too large at byte $position")
    TooLarge(position: usize)
    @error("the regex did not match")
    NoMatch
    @error("missing regex group $name")
    MissingGroup(name: string)
    @error("cannot decode regex group $group as $expected")
    WrongType(group: string, expected: string)

impl Regex:
    ## Compiles `pattern`, or returns the first error it holds.
    ## See [std-regex.regex.new](../../spec/std/regex.md#r-std-regex.regex.new).
    pub fn new(pattern: string) -> Result[Regex, RegexError]:
        source := Pattern::of(pattern)
        let mut names: List[string] = [""]
        parsed := parse_alternation(source, 0, &mut names)?
        if parsed.next < source.chars.len():
            return .Err(RegexError.UnmatchedParen(source.offsets[parsed.next]))
        if program_size(parsed.node) > max_program():
            return .Err(RegexError.TooLarge(0))
        let mut program: List[Inst] = []
        compile(parsed.node, &mut program)
        program.push(Inst.Done)
        # Boxed because every copy of the regex and every search share it.
        lowered := box(lower(program))
        filter := prefilter(parsed.node)
        built := automaton(lowered)
        done := lowered.ops.len() - 1
        forward := new_dfa(built.forward, &built, built.nodes, done, true, filter.literal != "")
        reverse := new_dfa(built.reverse, &built, done, 0, false, false)
        .Ok(
            Regex {
                text: pattern,
                program: lowered,
                filter: filter,
                forward: forward,
                reverse: reverse,
                # Boxed because every copy of the regex shares it between calls.
                idle: box(blank_vm(lowered, filter, forward, reverse)),
                names: names,
            },
        )

    # The pattern as written.
    ## The pattern the regex was compiled from.
    ## See [std-regex.regex.pattern](../../spec/std/regex.md#r-std-regex.regex.pattern).
    pub fn pattern(&self) -> string:
        self.text

    # Whether some part of `text` matches (r-std-regex.is-match). The
    # forward DFA stops at the first match state.
    ## True when the regex matches anywhere in `text`.
    ## See [std-regex.is-match](../../spec/std/regex.md#r-std-regex.is-match).
    pub fn is_match(&self, text: string) -> bool:
        vm := self.take(text, 0, true)
        found := search(vm, 0, true)
        self.give(vm)
        found

    # The leftmost match, and among those that start there, the one the
    # pattern prefers (r-std-regex.find.leftmost-first).
    ## The leftmost match in `text`; of several starting there, the first the pattern's alternation order prefers.
    ## See [std-regex.find](../../spec/std/regex.md#r-std-regex.find).
    pub fn find(&self, text: string) -> Match?:
        vm := self.take(text, 2, true)
        let found: Match? = if locate(vm, 0): .Some(vm.whole()) else: .None
        self.give(vm)
        found

    # Every match, left to right, none overlapping (r-std-regex.find-all).
    ## Every non-overlapping match in `text`, from left to right.
    ## See [std-regex.find-all](../../spec/std/regex.md#r-std-regex.find-all).
    pub fn find_all(&self, text: string) -> List[Match]:
        vm := self.take(text, 2, true)
        let mut found: List[Match] = []
        while advance(vm):
            found.push(vm.whole())
        self.give(vm)
        found

    # The groups of the first match (r-std-regex.captures), on the Pike VM.
    ## The capture groups of the leftmost match, or `.None`.
    ## See [std-regex.captures](../../spec/std/regex.md#r-std-regex.captures).
    pub fn captures(&self, text: string) -> Captures?:
        vm := self.take(text, self.slot_count(), false)
        let found: Captures? = if locate(vm, 0): .Some(vm.groups(self.names)) else: .None
        self.give(vm)
        found

    ## Decodes the first match as a record through its Deserialize implementation.
    ## See [std-regex.decode.regex](../../spec/std/regex.md#r-std-regex.decode.regex).
    pub fn decode[T < Deserialize](self, text: string) -> Result[T, RegexError]:
        match self.captures(text):
            .Some(captures) => captures.decode::[T]()
            .None => .Err(.NoMatch)

    # The groups of each match that `find_all` returns
    # (r-std-regex.captures-all), on the Pike VM.
    ## The capture groups of every non-overlapping match, from left to right.
    ## See [std-regex.captures-all](../../spec/std/regex.md#r-std-regex.captures-all).
    pub fn captures_all(&self, text: string) -> List[Captures]:
        vm := self.take(text, self.slot_count(), false)
        let mut found: List[Captures] = []
        while advance(vm):
            found.push(vm.groups(self.names))
        self.give(vm)
        found

    # `text` with its first match replaced (r-std-regex.replace). The
    # groups come from the Pike VM only when the template names one.
    ## The text with its leftmost match replaced by `replacement`, whose `$` forms expand groups.
    ## See [std-regex.replace](../../spec/std/regex.md#r-std-regex.replace).
    pub fn replace(&self, text: string, replacement: string) -> string:
        template := Pattern::of(replacement)
        vm := self.take(text, self.replace_slots(template), true)
        let replaced = text
        if locate(vm, 0):
            groups := self.groups_of(vm)
            replaced = (
                text.slice(0, vm.start())
                + expand(template, groups)
                + text.slice(vm.end(), text.len())
            )
        self.give(vm)
        replaced

    # `text` with each match that `find_all` returns replaced
    # (r-std-regex.replace-all).
    ## The text with every non-overlapping match replaced by `replacement`, whose `$` forms expand groups.
    ## See [std-regex.replace-all](../../spec/std/regex.md#r-std-regex.replace-all).
    pub fn replace_all(&self, text: string, replacement: string) -> string:
        template := Pattern::of(replacement)
        vm := self.take(text, self.replace_slots(template), true)
        # The pieces are joined once at the end, since appending each to
        # the text so far would copy that text again for every match.
        let mut pieces: List[string] = []
        let last: usize = 0
        while advance(vm):
            pieces.push(text.slice(last, vm.start()))
            pieces.push(expand(template, self.groups_of(vm)))
            last = vm.end()
        self.give(vm)
        pieces.push(text.slice(last, text.len()))
        pieces.join("")

    # The pieces of `text` around each match that `find_all` returns
    # (r-std-regex.split).
    ## The text's pieces between the matches, in order.
    ## See [std-regex.split](../../spec/std/regex.md#r-std-regex.split).
    pub fn split(&self, text: string) -> List[string]:
        vm := self.take(text, 2, true)
        let mut pieces: List[string] = []
        let last: usize = 0
        while advance(vm):
            pieces.push(text.slice(last, vm.start()))
            last = vm.end()
        self.give(vm)
        pieces.push(text.slice(last, text.len()))
        pieces

    # Two slots per group, group 0 included.
    fn slot_count(&self) -> usize:
        2 * self.names.len()

    # The slots a replacement with `template` needs: every group's when
    # the template names a group past 0, else group 0's.
    fn replace_slots(&self, template: Pattern) -> usize:
        if self.names.len() > 1 && names_groups(template): self.slot_count() else: 2

    # The groups of the match `vm` found, as a replacement expands them.
    fn groups_of(&self, vm: &Vm) -> Captures:
        if vm.slot_count > 2: vm.groups(self.names) else: vm.groups([""])

    # The VM for one call on `text`: the regex's own, readied for it, or a
    # new one when a search holds that one. A search calls no code outside
    # this module, so no call starts while another runs today; a call that
    # did, from a task or a later callback, would get its own VM, since
    # `busy` stays set from `take` to `give`.
    fn take(&self, text: string, slot_count: usize, dfa: bool) -> *mut Vm:
        let vm = self.idle
        if vm.busy:
            # Boxed because a call holds its VM by reference, as it holds the shared one.
            vm = box(blank_vm(self.program, self.filter, self.forward, self.reverse))
        ready(vm, text, slot_count)
        vm.busy = true
        vm.dfa = dfa
        vm

    # Hands the VM back, letting go of the text.
    fn give(&self, vm: *mut Vm) -> void:
        vm.busy = false
        vm.text = ""

impl Captures:
    # The number of groups, plus one for the whole match
    # (r-std-regex.captures.len).
    ## The number of capture groups, the whole match included.
    ## See [std-regex.captures.len](../../spec/std/regex.md#r-std-regex.captures.len).
    pub fn len(&self) -> usize:
        self.names.len()

    # Group `index`, or `.None` when it took no part
    # (r-std-regex.captures.get).
    ## The match of group `index`, or `.None` when it took no part or is out of range.
    ## See [std-regex.captures.get](../../spec/std/regex.md#r-std-regex.captures.get).
    pub fn get(&self, index: usize) -> Match?:
        if index >= self.names.len():
            return .None
        match self.slots[2 * index]:
            .None => .None
            .Some(start) =>
                match self.slots[2 * index + 1]:
                    .None => .None
                    .Some(end) =>
                        .Some(Match { start: start, end: end, text: self.text.slice(start, end) })

    # The group named `name` (r-std-regex.captures.name).
    ## The match of the group named `name`, or `.None` when there is no such group or it took no part.
    ## See [std-regex.captures.name](../../spec/std/regex.md#r-std-regex.captures.name).
    pub fn name(&self, name: string) -> Match?:
        if name == "":
            return .None
        let index: usize = 1
        while index < self.names.len():
            if self.names[index] == name:
                return self.get(index)
            index = index + 1
        .None

    ## Decodes this capture set as a record through its Deserialize implementation.
    ## See [std-regex.decode.captures](../../spec/std/regex.md#r-std-regex.decode.captures).
    pub fn decode[T < Deserialize](self) -> Result[T, RegexError]:
        let mut reader = CaptureReader { captures: self }
        T::deserialize(&mut reader)

# The format adapter for one capture set. The root is a record; each
# member positions the scalar reader at the named group's text.
struct CaptureReader:
    captures: Captures
    group: string = "0"
    current: Match? = .None
    record: bool = false
    variant: bool = false
    facts: Facts = Facts { items: [] }

impl CaptureReader:
    fn group_text(&mut self, expected: string) -> Result[string, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid(expected))
        match self.current:
            .Some(found) => .Ok(found.text)
            .None => .Err(.MissingGroup(self.group))

impl Deserializer for CaptureReader:
    type Error = RegexError

    fn peek(&mut self) -> Result[ValueKind, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid("record"))
        .Ok(if self.current.is_some(): .Text else: .Null)

    fn is_null(&mut self) -> Result[bool, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid("record"))
        .Ok(self.current.is_none())

    fn bool(&mut self, expected: string) -> Result[bool, RegexError]:
        match self.group_text(expected)?.parse::[bool]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn int(&mut self, expected: string) -> Result[i64, RegexError]:
        match self.group_text(expected)?.parse::[i64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn uint(&mut self, expected: string) -> Result[u64, RegexError]:
        match self.group_text(expected)?.parse::[u64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn float(&mut self, expected: string) -> Result[f64, RegexError]:
        match self.group_text(expected)?.parse::[f64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn text(&mut self, expected: string) -> Result[string, RegexError]:
        self.group_text(expected)

    fn begin_list(&mut self) -> Result[void, RegexError]:
        .Err(self.invalid("list"))

    fn next_item(&mut self) -> Result[bool, RegexError]:
        .Err(self.invalid("list"))

    fn begin_map(&mut self) -> Result[void, RegexError]:
        .Err(self.invalid("map"))

    fn next_key(&mut self) -> Result[string?, RegexError]:
        .Err(self.invalid("map"))

    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, RegexError]:
        if !self.record:
            if choices.len() == 1 && choices[0].of_data:
                self.record = true
                self.facts = facts
                return .Ok(0)
            return .Err(self.invalid("record"))
        if choices.len() == 1 && choices[0].of_data:
            return .Err(self.invalid("record"))
        name := self.group_text("variant")?
        let index = 0
        while index < choices.len():
            if choices[index].name == name:
                self.variant = true
                return .Ok(index)
            index += 1
        .Err(self.invalid("variant"))

    fn begin_newtype_variant(&mut self) -> Result[void, RegexError]:
        .Err(self.invalid("newtype variant"))

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, RegexError]:
        .Err(self.invalid("tuple variant"))

    fn member(&mut self, m: &Member) -> Result[void, RegexError]:
        name := member_name(m, self.facts)
        if self.variant:
            return .Err(self.invalid("payload-free variant"))
        self.group = name
        let index = 1
        while index < self.captures.names.len():
            if self.captures.names[index] == name:
                self.current = self.captures.get(index)
                return .Ok(())
            index += 1
        .Err(.MissingGroup(name))

    fn end_variant(&mut self) -> Result[void, RegexError]:
        self.variant = false
        .Ok(())

    fn invalid(&mut self, expected: string) -> RegexError:
        .WrongType(self.group, expected)

# The most instructions a compiled pattern may have
# (r-std-regex.error.too-large).
fn max_program() -> usize:
    10000

# The most a counted repetition may count (r-std-regex.repeat.bad-count).
fn max_repeat() -> usize:
    1000

# A pattern split into its characters, with the byte offset of each and
# the pattern's length last.
struct Pattern:
    text: string
    chars: List[char]
    offsets: List[usize]

impl Pattern:
    fn of(text: string) -> Pattern:
        let mut chars: List[char] = []
        let mut offsets: List[usize] = []
        for (offset, c) in text.char_indices():
            chars.push(c)
            offsets.push(offset)
        offsets.push(text.len())
        Pattern { text: text, chars: chars, offsets: offsets }

    # The text from character `start` up to character `end`.
    fn piece(self, start: usize, end: usize) -> string:
        self.text.slice(self.offsets[start], self.offsets[end])

    fn at(self, index: usize) -> char?:
        if index < self.chars.len(): .Some(self.chars[index]) else: .None

    fn has(self, index: usize, c: char) -> bool:
        index < self.chars.len() && self.chars[index] == c

    fn offset(self, index: usize) -> usize:
        self.offsets[index]

# The syntax tree.
enum Node:
    Empty
    Literal(value: char)
    AnyChar
    Class(items: List[ClassItem], negated: bool)
    Begin
    End
    Group(body: *Node, index: usize)
    Concat(items: List[Node])
    Alternate(branches: List[Node])
    Repeat(body: *Node, min: usize, max: usize?, greedy: bool)

# One member of a bracketed class, or a whole `\d`, `\w`, or `\s` class.
enum ClassItem:
    Range(low: char, high: char)
    Digit(negated: bool)
    Word(negated: bool)
    Space(negated: bool)

# A parsed piece and the index of the character after it.
struct Step:
    node: Node
    next: usize

# `a|b|c`: one or more concatenations.
fn parse_alternation(
    source: Pattern,
    start: usize,
    names: &mut List[string],
) -> Result[Step, RegexError]:
    let mut branches: List[Node] = []
    let at = start
    while true:
        branch := parse_concat(source, at, names)?
        branches.push(branch.node)
        at = branch.next
        if source.has(at, '|'):
            at = at + 1
        else:
            break
    if branches.len() == 1:
        return .Ok(Step { node: branches[0], next: at })
    .Ok(Step { node: Node.Alternate(branches), next: at })

# A run of atoms, each with at most one quantifier, up to `|`, `)`, or the
# end.
fn parse_concat(
    source: Pattern,
    start: usize,
    names: &mut List[string],
) -> Result[Step, RegexError]:
    let mut items: List[Node] = []
    let at = start
    while at < source.chars.len():
        c := source.chars[at]
        if c == '|' || c == ')':
            break
        # A quantifier with no atom before it, including one right after
        # another quantifier (r-std-regex.repeat.nothing).
        if quantifier_at(source, at):
            return .Err(RegexError.NothingToRepeat(source.offset(at)))
        atom := parse_atom(source, at, names)?
        repeated := parse_repeat(source, atom)?
        items.push(repeated.node)
        at = repeated.next
    if items.len() == 0:
        return .Ok(Step { node: Node.Empty, next: at })
    if items.len() == 1:
        return .Ok(Step { node: items[0], next: at })
    .Ok(Step { node: Node.Concat(items), next: at })

fn quantifier_at(source: Pattern, at: usize) -> bool:
    match source.at(at):
        .Some(c) =>
            if c == '*' || c == '+' || c == '?':
                return true
            c == '{' && counts_at(source, at).is_some()
        .None => false

# The counts of a well-formed `{m}`, `{m,}`, or `{m,n}` at `at`. Any other
# `{` is a literal (r-std-regex.syntax.brace-literal).
struct Counts:
    min: usize
    max: usize?
    next: usize

fn counts_at(source: Pattern, start: usize) -> Counts?:
    if !source.has(start, '{'):
        return .None
    low := number_at(source, start + 1)?
    if low.next == start + 1:
        return .None
    match source.at(low.next):
        .Some('}') => .Some(Counts { min: low.value, max: .Some(low.value), next: low.next + 1 })
        .Some(',') =>
            high := number_at(source, low.next + 1)?
            if !source.has(high.next, '}'):
                return .None
            if high.next == low.next + 1:
                return .Some(Counts { min: low.value, max: .None, next: high.next + 1 })
            .Some(Counts { min: low.value, max: .Some(high.value), next: high.next + 1 })
        _ => .None

struct Number:
    value: usize
    next: usize

# A run of ASCII digits, held below 100000 so it cannot overflow.
fn number_at(source: Pattern, start: usize) -> Number?:
    let value: usize = 0
    let at = start
    while true:
        match source.at(at):
            .Some(c) =>
                if c < '0' || c > '9':
                    break
                if value < 100000:
                    value = value * 10 + (char_digit(c))
                at = at + 1
            .None => break
    .Some(Number { value: value, next: at })

fn char_digit(c: char) -> usize:
    let value: usize = 0
    for digit in "0123456789".chars():
        if digit == c:
            return value
        value = value + 1
    0

# A quantifier after `atom`, if one follows, with its lazy `?`.
fn parse_repeat(source: Pattern, atom: Step) -> Result[Step, RegexError]:
    at := atom.next
    let min: usize = 0
    let max: usize? = .None
    let next = at + 1
    match source.at(at):
        .Some('*') => pass
        .Some('+') => min = 1
        .Some('?') => max = .Some(1)
        .Some('{') =>
            counts := match counts_at(source, at):
                .Some(found) => found
                .None => return .Ok(atom)
            min = counts.min
            max = counts.max
            next = counts.next
            let bad = min > max_repeat()
            match max:
                .Some(high) =>
                    if high > max_repeat() || high < min:
                        bad = true
                .None => pass
            if bad:
                return .Err(RegexError.BadRepeat(source.offset(at)))
        _ => return .Ok(atom)
    let greedy = true
    if source.has(next, '?'):
        greedy = false
        next = next + 1
    # Boxed because the returned recursive AST node stores its child.
    .Ok(Step { node: Node.Repeat(box(atom.node), min, max, greedy), next: next })

fn parse_atom(source: Pattern, at: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    c := source.chars[at]
    if c == '(':
        return parse_group(source, at, names)
    if c == '[':
        return parse_class(source, at)
    if c == '.':
        return .Ok(Step { node: Node.AnyChar, next: at + 1 })
    if c == '^':
        return .Ok(Step { node: Node.Begin, next: at + 1 })
    if c == '$':
        return .Ok(Step { node: Node.End, next: at + 1 })
    if c == '\\':
        escaped := parse_escape(source, at)?
        node := match escaped.item:
            .Some(item) => Node.Class([item], false)
            .None => Node.Literal(escaped.value)
        return .Ok(Step { node: node, next: at + 2 })
    .Ok(Step { node: Node.Literal(c), next: at + 1 })

# `( )`, `(?: )`, `(?P<name> )`, and `(?<name> )`; any other `(?` is an
# unsupported group (r-std-regex.syntax.group.unsupported). A capture group
# takes the next number when its `(` is read
# (r-std-regex.syntax.group.number).
fn parse_group(source: Pattern, open: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    let start = open + 1
    let capturing = true
    let name = ""
    if source.has(start, '?'):
        let name_start: usize? = .None
        if source.has(start + 1, ':'):
            capturing = false
            start = start + 2
        else if source.has(start + 1, 'P') && source.has(start + 2, '<'):
            name_start = .Some(start + 3)
        else if (
            source.has(start + 1, '<')
            && !source.has(start + 2, '=')
            && !source.has(start + 2, '!')
        ):
            name_start = .Some(start + 2)
        else:
            return .Err(RegexError.UnsupportedGroup(source.offset(open)))
        match name_start:
            .None => pass
            .Some(name_at) =>
                let close = name_at
                while close < source.chars.len() && !source.has(close, '>'):
                    close = close + 1
                if close >= source.chars.len() || !group_name(source, name_at, close):
                    return .Err(RegexError.BadGroupName(source.offset(open)))
                name = source.piece(name_at, close)
                for taken in names:
                    if taken == name:
                        return .Err(RegexError.DuplicateGroupName(source.offset(open)))
                start = close + 1
    index := names.len()
    if capturing:
        names.push(name)
    inner := parse_alternation(source, start, names)?
    if !source.has(inner.next, ')'):
        return .Err(RegexError.MissingParen(source.offset(open)))
    if capturing:
        # Boxed because the returned recursive AST node stores its child.
        return .Ok(Step { node: Node.Group(box(inner.node), index), next: inner.next + 1 })
    .Ok(Step { node: inner.node, next: inner.next + 1 })

# Whether characters `start` to `end` form a group name: an ASCII letter or
# `_`, then ASCII letters, digits, and `_` (r-std-regex.syntax.group.name).
fn group_name(source: Pattern, start: usize, end: usize) -> bool:
    if end <= start:
        return false
    first := source.chars[start]
    if first >= '0' && first <= '9':
        return false
    let at = start
    while at < end:
        if !word_char(source.chars[at]):
            return false
        at = at + 1
    true

# An escape: a Perl class item, or one character.
struct Escape:
    item: ClassItem?
    value: char

fn parse_escape(source: Pattern, at: usize) -> Result[Escape, RegexError]:
    match source.at(at + 1):
        .None => .Err(RegexError.BadEscape(source.offset(at)))
        .Some(e) =>
            if e == 'd' || e == 'D':
                return .Ok(Escape { item: .Some(ClassItem.Digit(e == 'D')), value: e })
            if e == 'w' || e == 'W':
                return .Ok(Escape { item: .Some(ClassItem.Word(e == 'W')), value: e })
            if e == 's' || e == 'S':
                return .Ok(Escape { item: .Some(ClassItem.Space(e == 'S')), value: e })
            if e == 'n':
                return .Ok(Escape { item: .None, value: '\n' })
            if e == 't':
                return .Ok(Escape { item: .None, value: '\t' })
            if e == 'r':
                return .Ok(Escape { item: .None, value: '\r' })
            if ascii_punctuation(e):
                return .Ok(Escape { item: .None, value: e })
            .Err(RegexError.BadEscape(source.offset(at)))

fn ascii_punctuation(c: char) -> bool:
    (
        (c >= '!' && c <= '/')
        || (c >= ':' && c <= '@')
        || (c >= '[' && c <= '`')
        || (c >= '{' && c <= '~')
    )

# `[...]` and `[^...]`. A `]` first is a literal (r-std-regex.syntax.class).
fn parse_class(source: Pattern, open: usize) -> Result[Step, RegexError]:
    let at = open + 1
    let negated = false
    if source.has(at, '^'):
        negated = true
        at = at + 1
    let mut items: List[ClassItem] = []
    let first = true
    while true:
        match source.at(at):
            .None => return .Err(RegexError.MissingBracket(source.offset(open)))
            .Some(c) =>
                if c == ']' && !first:
                    break
        first = false
        low := class_char(source, at)?
        match low.item:
            .Some(item) =>
                if (
                    source.has(low.next, '-')
                    && source.at(low.next + 1).is_some()
                    && !source.has(low.next + 1, ']')
                ):
                    return .Err(RegexError.BadRange(source.offset(at)))
                items.push(item)
                at = low.next
            .None =>
                if (
                    source.has(low.next, '-')
                    && source.at(low.next + 1).is_some()
                    && !source.has(low.next + 1, ']')
                ):
                    high := class_char(source, low.next + 1)?
                    if high.item.is_some() || high.value < low.value:
                        return .Err(RegexError.BadRange(source.offset(at)))
                    items.push(ClassItem.Range(low.value, high.value))
                    at = high.next
                else:
                    items.push(ClassItem.Range(low.value, low.value))
                    at = low.next
    .Ok(Step { node: Node.Class(items, negated), next: at + 1 })

struct ClassChar:
    item: ClassItem?
    value: char
    next: usize

fn class_char(source: Pattern, at: usize) -> Result[ClassChar, RegexError]:
    c := source.chars[at]
    if c == '\\':
        escaped := parse_escape(source, at)?
        return .Ok(ClassChar { item: escaped.item, value: escaped.value, next: at + 2 })
    .Ok(ClassChar { item: .None, value: c, next: at + 1 })

# The VM's instructions, as `compile` writes them; `lower` turns them into
# a `Program`. `Split` tries `first` before `second`. A character is its
# scalar value, and a class is a list of inclusive ranges of scalar values,
# low then high for each.
enum Inst:
    Char(point: i32)
    AnyChar
    Class(ranges: List[i32], negated: bool)
    Begin
    End
    Split(first: usize, second: usize)
    Jump(target: usize)
    Save(slot: usize)
    Done

# How many instructions `compile` emits for `node`, the written-out size
# (r-std-regex.time.size), held at
# max_program() + 1 so it cannot overflow.
fn program_size(node: Node) -> usize:
    match node:
        .Empty => 0
        .Group(body, _) => program_size(*body)
        .Concat(items) =>
            let total: usize = 0
            for item in items:
                total = capped(total + program_size(item))
            total
        .Alternate(branches) =>
            let total: usize = 0
            for branch in branches:
                total = capped(total + program_size(branch) + 2)
            total - 2
        .Repeat(body, min, max, _) =>
            size := program_size(*body)
            match max:
                .None =>
                    if min == 0:
                        return capped(size + 2)
                    capped(scaled(size, min) + 1)
                .Some(high) => capped(scaled(size, min) + scaled(size + 1, high - min))
        _ => 1

fn capped(size: usize) -> usize:
    if size > max_program(): max_program() + 1 else: size

fn scaled(size: usize, count: usize) -> usize:
    if count == 0:
        return 0
    if size > max_program() / count:
        return max_program() + 1
    size * count

fn compile(node: Node, program: &mut List[Inst]) -> void:
    match node:
        .Empty => pass
        .Literal(value) => program.push(Inst.Char(i32(char_scalar(value))))
        .AnyChar => program.push(Inst.AnyChar)
        .Class(items, negated) => program.push(Inst.Class(class_ranges(items), negated))
        .Begin => program.push(Inst.Begin)
        .End => program.push(Inst.End)
        .Group(body, index) =>
            program.push(Inst.Save(2 * index))
            compile(*body, program)
            program.push(Inst.Save(2 * index + 1))
        .Concat(items) =>
            for item in items:
                compile(item, program)
        .Alternate(branches) =>
            # split L1, next; L1: a; jump end; next: split L2, ... ; last
            let mut jumps: List[usize] = []
            let index: usize = 0
            while index < branches.len():
                if index + 1 < branches.len():
                    split := program.len()
                    program.push(Inst.Split(split + 1, 0))
                    compile(branches[index], program)
                    jumps.push(program.len())
                    program.push(Inst.Jump(0))
                    program[split] = Inst.Split(split + 1, program.len())
                else:
                    compile(branches[index], program)
                index = index + 1
            for jump in jumps:
                program[jump] = Inst.Jump(program.len())
        .Repeat(body, min, max, greedy) =>
            let copies: usize = 0
            match max:
                .None =>
                    if min == 0:
                        # loop: split body, out; body; jump loop
                        loop_start := program.len()
                        program.push(Inst.Split(0, 0))
                        compile(*body, program)
                        program.push(Inst.Jump(loop_start))
                        program[loop_start] = choice(loop_start + 1, program.len(), greedy)
                    else:
                        while copies < min - 1:
                            compile(*body, program)
                            copies = copies + 1
                        # last: body; split last, out
                        last := program.len()
                        compile(*body, program)
                        program.push(choice(last, program.len() + 1, greedy))
                .Some(high) =>
                    while copies < min:
                        compile(*body, program)
                        copies = copies + 1
                    # each optional copy: split body, out
                    let mut splits: List[usize] = []
                    while copies < high:
                        splits.push(program.len())
                        program.push(Inst.Split(0, 0))
                        compile(*body, program)
                        copies = copies + 1
                    for split in splits:
                        program[split] = choice(split + 1, program.len(), greedy)

# The instructions as parallel lists that the VM reads by index, so a step
# compares integers instead of matching a variant. `ops[pc]` is the kind:
#
# | op | instruction | `left[pc]` | `right[pc]` |
# | -- | ----------- | ---------- | ----------- |
# | 0 | `Char`, scalar value in `points[pc]` | - | - |
# | 1 | `AnyChar` | - | - |
# | 2 | `Class` | start of its ranges in `ranges` | end of them |
# | 3 | negated `Class` | start of its ranges in `ranges` | end of them |
# | 4 | `Done` | - | - |
# | 5 | `Split` | first | second |
# | 6 | `Jump` | target | - |
# | 7 | `Save` | slot | - |
# | 8 | `Begin` | - | - |
# | 9 | `End` | - | - |
#
# Ops 0 to 4 are the ones a thread waits at for the next character.
#
# The lists are uniquely owned, so a search reads them with no reference
# count or copy-on-write check.
struct Program:
    ops: UniqList[i32]
    left: UniqList[usize]
    right: UniqList[usize]
    points: UniqList[i32]
    ranges: UniqList[i32]

fn lower(program: List[Inst]) -> Program:
    let mut ops = UniqList::[i32].new()
    let mut left = UniqList::[usize].new()
    let mut right = UniqList::[usize].new()
    let mut points = UniqList::[i32].new()
    let mut ranges = UniqList::[i32].new()
    for inst in program:
        let op = +0
        let first: usize = 0
        let second: usize = 0
        let point = +0
        match inst:
            .Char(value) => point = value
            .AnyChar => op = +1
            .Class(bounds, negated) =>
                op = if negated: +3 else: +2
                first = ranges.len()
                for bound in bounds:
                    ranges.push(bound)
                second = ranges.len()
            .Done => op = +4
            .Split(a, b) =>
                op = +5
                first = a
                second = b
            .Jump(target) =>
                op = +6
                first = target
            .Save(slot) =>
                op = +7
                first = slot
            .Begin => op = +8
            .End => op = +9
        ops.push(op)
        left.push(first)
        right.push(second)
        points.push(point)
    Program { ops: ops, left: left, right: right, points: points, ranges: ranges }

# A split that prefers `body` when greedy and `out` when lazy.
fn choice(body: usize, out: usize, greedy: bool) -> Inst:
    if greedy: Inst.Split(body, out) else: Inst.Split(out, body)

# The program as a byte automaton for the lazy DFA, a Thompson NFA over
# bytes as regex-automata's lazy DFA runs (src/hybrid/dfa.rs). Node `pc`
# below the program's length is instruction `pc`. An instruction that reads
# a character becomes a trie of byte ranges over the UTF-8 forms of its
# scalars: its first ranges leave node `pc`, its later ones nodes added
# after the instructions, and its last ones lead to `pc + 1`. Node n's
# edges are those from `at[n]` up to `at[n + 1]`, in priority order: an
# epsilon edge has `lows` -1, and a byte edge reads one byte from `lows`
# to `highs`. `guards[n]` is 1 for `^` and 2 for `$`, which a search
# passes only where they hold. `Save` is an epsilon edge: the DFA finds no
# groups.
struct Graph:
    at: List[usize]
    to: List[usize]
    lows: List[i32]
    highs: List[i32]
    guards: List[i32]

# Both directions of the byte automaton and its byte classes. The reverse
# graph has every edge of the program's nodes turned around, and runs from
# `Done` back to node 0. The forward graph adds the unanchored prefix,
# regex-automata's `(?s-u:.)*?`: node `nodes` tries node 0 first and node
# `nodes + 1` last, which reads any byte and comes back. `classes` maps
# each byte to its class: two bytes share one when no edge tells them
# apart (alphabet.rs, ByteClassSet), and `reps` holds a byte of each class.
struct Automaton:
    forward: Graph
    reverse: Graph
    nodes: usize
    classes: List[usize]
    reps: List[i32]

# Edges in the order they were made, before `graph` groups them by node.
struct Edges:
    from: List[usize]
    to: List[usize]
    lows: List[i32]
    highs: List[i32]

impl Edges:
    fn add(&mut self, from: usize, low: i32, high: i32, to: usize) -> void:
        self.from.push(from)
        self.to.push(to)
        self.lows.push(low)
        self.highs.push(high)

# The program's byte automaton. It costs time and space linear in the
# program's size times the UTF-8 pieces of its classes, a few per range.
fn automaton(program: &Program) -> Automaton:
    ops := &program.ops
    size := ops.len()
    let mut edges = Edges { from: [], to: [], lows: [], highs: [] }
    let mut guards: List[i32] = []
    let count = size
    let pc: usize = 0
    while pc < size:
        op := ops[pc]
        let guard = +0
        if op <= 3:
            count = add_scalars(&mut edges, count, pc, scalar_ranges(program, pc))
        else if op == 5:
            edges.add(pc, -1, -1, program.left[pc])
            edges.add(pc, -1, -1, program.right[pc])
        else if op == 6:
            edges.add(pc, -1, -1, program.left[pc])
        else if op >= 7:
            edges.add(pc, -1, -1, pc + 1)
            if op == 8:
                guard = +1
            else if op == 9:
                guard = +2
        guards.push(guard)
        pc += 1
    guards.resize(count, +0)
    reverse := graph(count, &edges, true, guards)
    # Past byte 0 a pattern that starts with `^` can start no match, and
    # the prefix would only read the rest of the text.
    edges.add(count, -1, -1, 0)
    if restarts(program):
        edges.add(count, -1, -1, count + 1)
    edges.add(count + 1, 0, 255, count)
    guards.push(+0)
    guards.push(+0)
    forward := graph(count + 2, &edges, false, guards)
    # A byte that ends a range ends its class, and so does the one before a
    # range's start.
    let mut ends: List[bool] = []
    ends.resize(256, false)
    let edge: usize = 0
    while edge < edges.lows.len():
        low := edges.lows[edge]
        if low > 0:
            ends[usize(low - 1)] = true
        if low >= 0:
            ends[usize(edges.highs[edge])] = true
        edge += 1
    let mut classes: List[usize] = []
    let mut reps: List[i32] = [+0]
    let byte: usize = 0
    while byte < 256:
        classes.push(reps.len() - 1)
        if ends[byte] && byte < 255:
            reps.push(i32(byte) + 1)
        byte += 1
    Automaton { forward: forward, reverse: reverse, nodes: count, classes: classes, reps: reps }

# The edges grouped by the node they leave, or, `reversed`, by the node
# they enter and turned around, each group in the order the edges were
# made: a stable counting sort.
fn graph(count: usize, edges: &Edges, reversed: bool, guards: List[i32]) -> Graph:
    total := edges.from.len()
    let mut at = zeros(count + 1)
    let edge: usize = 0
    while edge < total:
        owner := if reversed: edges.to[edge] else: edges.from[edge]
        at[owner + 1] += 1
        edge += 1
    let node: usize = 0
    while node < count:
        at[node + 1] += at[node]
        node += 1
    let mut fill = at.slice(0, count)
    let mut to = zeros(total)
    let mut lows: List[i32] = []
    lows.resize(total, +0)
    let mut highs: List[i32] = []
    highs.resize(total, +0)
    edge = 0
    while edge < total:
        let owner = edges.from[edge]
        let target = edges.to[edge]
        if reversed:
            owner = edges.to[edge]
            target = edges.from[edge]
        slot := fill[owner]
        fill[owner] = slot + 1
        to[slot] = target
        lows[slot] = edges.lows[edge]
        highs[slot] = edges.highs[edge]
        edge += 1
    Graph { at: at, to: to, lows: lows, highs: highs, guards: guards }

# Whether a match can start past byte 0: whether instruction 0 reaches,
# without passing a `^`, one that reads a character, ends the match, or
# waits for the end.
fn restarts(program: &Program) -> bool:
    ops := &program.ops
    let mut seen: List[bool] = []
    seen.resize(ops.len(), false)
    let mut stack: List[usize] = [0]
    while stack.len() > 0:
        pc := stack[stack.len() - 1]
        stack.truncate(stack.len() - 1)
        if seen[pc]:
            continue
        seen[pc] = true
        op := ops[pc]
        if op <= 4 || op == 9:
            return true
        if op == 5:
            stack.push(program.right[pc])
        if op == 5 || op == 6:
            stack.push(program.left[pc])
        else if op == 7:
            stack.push(pc + 1)
    false

# The scalars instruction `pc` reads, as sorted, disjoint, inclusive
# ranges, low then high for each, without the surrogates, which no UTF-8
# text holds. A class's ranges are sorted by key, low * 2^21 + high.
fn scalar_ranges(program: &Program, pc: usize) -> List[i32]:
    op := program.ops[pc]
    if op == 0:
        point := program.points[pc]
        return [point, point]
    if op == 1:
        return [+0, +9, +11, +55295, +57344, +1114111]
    let mut keys: List[i64] = []
    let bound = program.left[pc]
    while bound < program.right[pc]:
        keys.push(i64(program.ranges[bound]) * 2097152 + i64(program.ranges[bound + 1]))
        bound += 2
    keys.sort()
    let mut merged: List[i32] = []
    for key in keys:
        low := i32(key / 2097152)
        high := i32(key % 2097152)
        last := merged.len()
        if last > 0 && low <= merged[last - 1] + 1:
            if high > merged[last - 1]:
                merged[last - 1] = high
        else:
            merged.push(low)
            merged.push(high)
    if op == 3:
        let mut outside: List[i32] = []
        let next = +0
        let index: usize = 0
        while index < merged.len():
            if merged[index] > next:
                outside.push(next)
                outside.push(merged[index] - 1)
            next = merged[index + 1] + 1
            index += 2
        if next <= 1114111:
            outside.push(next)
            outside.push(+1114111)
        merged = outside
    let mut scalars: List[i32] = []
    let index: usize = 0
    while index < merged.len():
        low := merged[index]
        high := merged[index + 1]
        if high < 55296 || low > 57343:
            scalars.push(low)
            scalars.push(high)
        else:
            if low < 55296:
                scalars.push(low)
                scalars.push(+55295)
            if high > 57343:
                scalars.push(+57344)
                scalars.push(high)
        index += 2
    scalars

# Adds below node `root` a trie that reads the UTF-8 form of each scalar in
# `ranges` and leads to `root + 1`, numbering its new nodes from `count`,
# and returns the count after them. Each range splits into sequences of
# byte ranges, as regex-syntax's Utf8Sequences splits it: in ascending
# order, so a sequence shares with the one before it a prefix of equal
# ranges or none, and the trie needs only the previous sequence's path
# (regex-automata's Utf8Compiler relies on the same order).
fn add_scalars(edges: &mut Edges, count: usize, root: usize, ranges: List[i32]) -> usize:
    let nodes = count
    let mut last: List[i32] = []
    let mut path: List[usize] = [root]
    let mut pending: List[i32] = []
    let index: usize = 0
    while index < ranges.len():
        pending.push(ranges[index])
        pending.push(ranges[index + 1])
        while pending.len() > 0:
            top := pending.len()
            low := pending[top - 2]
            high := pending[top - 1]
            pending.truncate(top - 2)
            cut := utf8_cut(low, high)
            if cut < high:
                pending.push(cut + 1)
                pending.push(high)
                pending.push(low)
                pending.push(cut)
                continue
            width := usize(scalar_bytes(low))
            let common: usize = 0
            while (
                common + 1 < width
                && 2 * common < last.len()
                && last[2 * common] == utf8_byte(low, width, common)
                && last[2 * common + 1] == utf8_byte(high, width, common)
            ):
                common += 1
            last.truncate(2 * common)
            path.truncate(common + 1)
            let depth = common
            while depth < width:
                lo := utf8_byte(low, width, depth)
                hi := utf8_byte(high, width, depth)
                let target = root + 1
                if depth + 1 < width:
                    target = nodes
                    nodes += 1
                edges.add(path[depth], lo, hi, target)
                last.push(lo)
                last.push(hi)
                path.push(target)
                depth += 1
        index += 2
    nodes

# Where `low..=high` must split for its UTF-8 forms to be one sequence of
# byte ranges: the end of its first part, or `high` when it need not. A
# range splits where the length of the UTF-8 form changes, and where a
# continuation byte's range would not be full (Utf8Sequences::next).
fn utf8_cut(low: i32, high: i32) -> i32:
    for max in [+127, +2047, +65535]:
        if low <= max && max < high:
            return max
    if high <= 127:
        return high
    let shift: u32 = 6
    while shift <= 18:
        mask := (+1 << shift) - 1
        if (low >> shift) != (high >> shift):
            if low & mask != 0:
                return low | mask
            if high & mask != mask:
                return (high >> shift << shift) - 1
        shift += 6
    high

# Byte `index` of the `width`-byte UTF-8 form of scalar `point`.
fn utf8_byte(point: i32, width: usize, index: usize) -> i32:
    if width == 1:
        return point
    if index == 0:
        lead := if width == 2: +192 else if width == 3: +224 else: +240
        return lead | (point >> u32(6 * (width - 1)))
    128 | ((point >> u32(6 * (width - 1 - index))) & 63)

# The prefilter, as RE2 and Rust's `regex` use literal prefilters. Every
# match that starts at byte s holds `literal` at a byte from s + `lo` up
# to s + `hi` (`hi` -1 when there is no bound), unless `literal` is "".
# `firsts` is the set of bytes a match can start with, 256 bits in four
# words, or empty when it would skip too little. A search starts threads
# only where both allow a match to start. That leaves the matches as they
# were: a thread that starts elsewhere never reaches `Done`, and a thread
# that never reaches `Done` changes no other thread's result.
struct Prefilter:
    literal: string
    lo: usize
    hi: i64
    firsts: List[u64]

# What every match of a piece of the tree has, in bytes: at least `min`
# and at most `max` of them (`max` -1 for no bound); `exact`, its text when
# it can match no other; `prefix`, the text it starts with; `literal`, a
# text it holds from `lo` up to `hi` bytes after its start (`hi` -1 for no
# bound), or ""; and `firsts`, the first bytes of its nonempty matches.
# Each claim holds of every match, so a piece that never matches may
# claim anything.
struct Summary:
    min: i64
    max: i64
    exact: string?
    prefix: string
    literal: string
    lo: i64
    hi: i64
    firsts: List[u64]

fn prefilter(node: Node) -> Prefilter:
    summary := summarize(node)
    if summary.min == 0:
        # An empty match holds no literal and has no first byte.
        return Prefilter { literal: "", lo: 0, hi: 0, firsts: [] }
    let firsts: List[u64] = summary.firsts
    if count_bits(firsts) >= 128:
        # A set this full skips too little to pay for testing each byte.
        firsts = []
    Prefilter { literal: summary.literal, lo: usize(summary.lo), hi: summary.hi, firsts: firsts }

fn summarize(node: Node) -> Summary:
    match node:
        .Empty => exact_summary("", no_bytes())
        .Begin => exact_summary("", no_bytes())
        .End => exact_summary("", no_bytes())
        .Literal(value) =>
            text := "$value"
            lead := i32(bytes_at(text, 0))
            let mut firsts: List[u64] = no_bytes()
            add_bytes(&mut firsts, lead, lead)
            exact_summary(text, firsts)
        .AnyChar =>
            # Any scalar but a newline.
            let mut firsts: List[u64] = no_bytes()
            add_bytes(&mut firsts, 0, 9)
            add_bytes(&mut firsts, 11, 127)
            add_bytes(&mut firsts, 192, 255)
            open_summary(1, 4, firsts)
        .Class(items, negated) => class_summary(class_ranges(items), negated)
        .Group(body, _) => summarize(*body)
        .Concat(items) => concat_summary(items)
        .Alternate(branches) => alternate_summary(branches)
        .Repeat(body, min, max, _) => repeat_summary(summarize(*body), min, max)

fn exact_summary(text: string, firsts: List[u64]) -> Summary:
    size := i64(bytes_len(text))
    Summary {
        min: size,
        max: size,
        exact: .Some(text),
        prefix: text,
        literal: text,
        lo: 0,
        hi: 0,
        firsts: firsts,
    }

fn open_summary(min: i64, max: i64, firsts: List[u64]) -> Summary:
    Summary {
        min: min,
        max: max,
        exact: .None,
        prefix: "",
        literal: "",
        lo: 0,
        hi: 0,
        firsts: firsts,
    }

# A class's first bytes are the UTF-8 first bytes of the scalars in its
# ranges. For a negated class they are every first byte but the ASCII
# ones the ranges name, which is all its non-ASCII first bytes and some
# more.
fn class_summary(ranges: List[i32], negated: bool) -> Summary:
    let mut firsts: List[u64] = no_bytes()
    if negated:
        let byte = +0
        while byte < 128:
            if !in_class(ranges, byte):
                add_bytes(&mut firsts, byte, byte)
            byte = byte + 1
        add_bytes(&mut firsts, 192, 255)
        return open_summary(1, 4, firsts)
    let min: i64 = 4
    let max: i64 = 1
    let index: usize = 0
    while index < ranges.len():
        low := ranges[index]
        high := ranges[index + 1]
        if scalar_bytes(low) < min:
            min = scalar_bytes(low)
        if scalar_bytes(high) > max:
            max = scalar_bytes(high)
        if low < 128:
            add_bytes(&mut firsts, low, if high < 127: high else: +127)
        add_leads(&mut firsts, low, high, 128, 2047, 64, 192)
        add_leads(&mut firsts, low, high, 2048, 65535, 4096, 224)
        add_leads(&mut firsts, low, high, 65536, 1114111, 262144, 240)
        index = index + 2
    open_summary(min, max, firsts)

fn in_class(ranges: List[i32], point: i32) -> bool:
    let index: usize = 0
    while index < ranges.len():
        if point >= ranges[index] && point <= ranges[index + 1]:
            return true
        index = index + 2
    false

# The first bytes of the scalars from `low` to `high` that UTF-8 writes
# with the same length, those from `first` to `last`: `base` plus the
# scalar divided by `unit`.
fn add_leads(
    set: &mut List[u64],
    low: i32,
    high: i32,
    first: i32,
    last: i32,
    unit: i32,
    base: i32,
) -> void:
    from := if low > first: low else: first
    to := if high < last: high else: last
    if from <= to:
        add_bytes(set, base + from / unit, base + to / unit)

# The length of a scalar's UTF-8 form.
fn scalar_bytes(point: i32) -> i64:
    if point < 128:
        return 1
    if point < 2048:
        return 2
    if point < 65536: 3 else: 4

# Items in sequence: the starts of the items after the first come later by
# the lengths before them; a run of exact items and the prefix of the item
# after it form one literal.
fn concat_summary(items: List[Node]) -> Summary:
    let min: i64 = 0
    let max: i64 = 0
    let literal = ""
    let lo: i64 = 0
    let hi: i64 = 0
    let mut run: List[string] = []
    let run_lo: i64 = 0
    let run_hi: i64 = 0
    let mut head: List[string] = []
    let open = true
    let exact = true
    let firsts: List[u64] = no_bytes()
    for item in items:
        summary := summarize(item)
        if min == 0:
            firsts = union(firsts, summary.firsts)
        if summary.literal != "" && prefer(summary.literal, plus(max, summary.hi), literal, hi):
            literal = summary.literal
            lo = min + summary.lo
            hi = plus(max, summary.hi)
        match summary.exact:
            .Some(text) =>
                run.push(text)
                if open:
                    head.push(text)
            .None =>
                exact = false
                run.push(summary.prefix)
                joined := run.join("")
                if prefer(joined, run_hi, literal, hi):
                    literal = joined
                    lo = run_lo
                    hi = run_hi
                if open:
                    head.push(summary.prefix)
                    open = false
                run = []
                run_lo = min + summary.min
                run_hi = plus(max, summary.max)
        min = min + summary.min
        max = plus(max, summary.max)
    joined := run.join("")
    if prefer(joined, run_hi, literal, hi):
        literal = joined
        lo = run_lo
        hi = run_hi
    prefix := head.join("")
    let whole: string? = if exact: .Some(prefix) else: .None
    Summary {
        min: min,
        max: max,
        exact: whole,
        prefix: prefix,
        literal: literal,
        lo: lo,
        hi: hi,
        firsts: firsts,
    }

# Alternatives: a literal is required only when every alternative holds
# it, and the alternatives' common prefix is one too.
fn alternate_summary(branches: List[Node]) -> Summary:
    first := summarize(branches[0])
    let min = first.min
    let max = first.max
    let exact = first.exact
    let prefix = first.prefix
    let literal = first.literal
    let lo = first.lo
    let hi = first.hi
    let firsts = first.firsts
    let index: usize = 1
    while index < branches.len():
        other := summarize(branches[index])
        if other.min < min:
            min = other.min
        max = if max < 0 || other.max < 0: -1 else if other.max > max: other.max else: max
        exact = same_text(exact, other.exact)
        prefix = common_prefix(prefix, other.prefix)
        if literal != "" && literal == other.literal:
            if other.lo < lo:
                lo = other.lo
            hi = if hi < 0 || other.hi < 0: -1 else if other.hi > hi: other.hi else: hi
        else:
            literal = ""
        firsts = union(firsts, other.firsts)
        index = index + 1
    if prefer(prefix, 0, literal, hi):
        literal = prefix
        lo = 0
        hi = 0
    Summary {
        min: min,
        max: max,
        exact: exact,
        prefix: prefix,
        literal: literal,
        lo: lo,
        hi: hi,
        firsts: firsts,
    }

fn same_text(left: string?, right: string?) -> string?:
    match left:
        .Some(a) =>
            match right:
                .Some(b) =>
                    if a == b: .Some(a) else: .None
                .None => .None
        .None => .None

# The longest common prefix that ends at a scalar boundary.
fn common_prefix(left: string, right: string) -> string:
    let size: usize = 0
    while (
        size < bytes_len(left)
        && size < bytes_len(right)
        && bytes_at(left, size) == bytes_at(right, size)
    ):
        size = size + 1
    while size > 0 && size < bytes_len(left) && continuation(bytes_at(left, size)):
        size = size - 1
    bytes_slice(left, 0, size)

# A repetition: with at least one copy, the first copy's literal at the
# start, or all the required copies of an exact body.
fn repeat_summary(body: Summary, min: usize, max: usize?) -> Summary:
    low := body.min * i64(min)
    let high: i64 = -1
    match max:
        .Some(count) =>
            if count == 0 || body.max == 0:
                high = 0
            else if body.max > 0:
                high = body.max * i64(count)
        .None =>
            if body.max == 0:
                high = 0
    if min == 0:
        return open_summary(low, high, body.firsts)
    match body.exact:
        .Some(text) =>
            whole := text.repeat(min)
            let exact: string? = .None
            match max:
                .Some(count) =>
                    if count == min:
                        exact = .Some(whole)
                .None => pass
            Summary {
                min: low,
                max: high,
                exact: exact,
                prefix: whole,
                literal: whole,
                lo: 0,
                hi: 0,
                firsts: body.firsts,
            }
        .None =>
            Summary {
                min: low,
                max: high,
                exact: .None,
                prefix: body.prefix,
                literal: body.literal,
                lo: body.lo,
                hi: body.hi,
                firsts: body.firsts,
            }

# Whether `literal`, within `hi` bytes of a match's start, makes a better
# prefilter than `best` within `best_hi`: a bounded place first, since it
# lets a search jump, then the longer.
fn prefer(literal: string, hi: i64, best: string, best_hi: i64) -> bool:
    if literal == "":
        return false
    if best == "":
        return true
    if (hi >= 0) != (best_hi >= 0):
        return hi >= 0
    bytes_len(literal) > bytes_len(best)

# A sum of lengths, -1 when either has no bound.
fn plus(left: i64, right: i64) -> i64:
    if left < 0 || right < 0: -1 else: left + right

fn no_bytes() -> List[u64]:
    [u64(0), u64(0), u64(0), u64(0)]

fn add_bytes(set: &mut List[u64], low: i32, high: i32) -> void:
    let byte = low
    while byte <= high:
        word := usize(byte / 64)
        set[word] = set[word] | (u64(1) << u64(byte % 64))
        byte = byte + 1

fn union(left: List[u64], right: List[u64]) -> List[u64]:
    [left[0] | right[0], left[1] | right[1], left[2] | right[2], left[3] | right[3]]

fn count_bits(set: List[u64]) -> u32:
    let total: u32 = 0
    for word in set:
        total = total + word.count_ones()
    total

fn continuation(byte: u8) -> bool:
    byte >= 128 && byte < 192

# The two thread lists of a search: the instructions reached at one text
# position, as sparse sets (Briggs and Torczon, as RE2 uses them) that keep
# them in the order they were added, so clearing one and testing or adding
# a member each take constant time. Both lists share `dense`, `sparse`, and
# `slots`: the list at `side` 0 uses the first `width` entries and the one
# at `side` `width` the rest, so trading the two lists at each step trades
# two numbers. A list's length is a local of the search. `slots` holds
# `slot_count` slots for each instruction, as byte offsets with -1 for an
# unset slot.
fn has(
    dense: &UniqList[usize],
    sparse: &UniqList[usize],
    side: usize,
    count: usize,
    pc: usize,
) -> bool:
    place := sparse[side + pc]
    place < count && dense[side + place] == pc

fn filled(count: usize) -> List[i64]:
    let mut values: List[i64] = []
    while values.len() < count:
        values.push(-1)
    values

fn uniq_filled(count: usize) -> UniqList[i64]:
    let mut values = UniqList::[i64].with_capacity(count)
    while values.len() < count:
        values.push(-1)
    values

fn uniq_zeros(count: usize) -> UniqList[usize]:
    let mut values = UniqList::[usize].with_capacity(count)
    while values.len() < count:
        values.push(0)
    values

fn zeros(count: usize) -> List[usize]:
    let mut values: List[usize] = []
    while values.len() < count:
        values.push(0)
    values

# The state of the searches of one call: the thread lists, the stack of
# the epsilon walk, and the slots, allocated once and reused by every
# search that call makes. The lists are uniquely owned, so a search reads
# and writes their elements with no reference count. The text is read in place, one UTF-8
# scalar at a time, and every position is a byte offset
# (r-std-regex.find.chars).
struct Vm:
    program: *Program
    text: string
    size: usize
    slot_count: usize
    dense: UniqList[usize]
    sparse: UniqList[usize]
    slots: UniqList[i64]
    # The epsilon walk's stack: an entry of at least 0 is an instruction to
    # visit; an entry -1 - s puts `values` at the same place back into slot s.
    stack: UniqList[i64]
    values: UniqList[i64]
    scratch: UniqList[i64]
    # The slots of the match the last search found.
    found: UniqList[i64]
    # Where the next search of `advance` starts, where the last match
    # ended (-1 before the first), and whether the series is over.
    from: usize
    last_end: i64
    finished: bool
    # The prefilter, whether it has anything to skip with, and the last
    # search for its literal: the first one at or after byte `hit_from` is
    # at byte `hit`, or there is none when `hit` is -1. The literal lets a
    # match start at the bytes from `near_from` to `near_until`.
    filter: Prefilter
    filtered: bool
    # The lazy DFA of each direction.
    forward: *mut Dfa
    reverse: *mut Dfa
    hit_from: usize
    hit: i64
    near_from: i64
    near_until: i64
    # Whether a call is using the VM, and whether the call's searches run
    # on the DFA (all but `captures` and `captures_all`).
    busy: bool
    dfa: bool

# A walk visits each instruction at most once and pushes at most one
# entry for it, so the stack never holds more than width + 1.
fn new_vm(regex: &Regex, text: string, slot_count: usize) -> Vm:
    let mut vm = blank_vm(regex.program, regex.filter, regex.forward, regex.reverse)
    ready(&mut vm, text, slot_count)
    vm

# A VM with the thread lists and stack `program` needs and no slots yet.
fn blank_vm(program: *Program, filter: Prefilter, forward: *mut Dfa, reverse: *mut Dfa) -> Vm:
    width := program.ops.len()
    Vm {
        program: program,
        text: "",
        size: 0,
        slot_count: 0,
        dense: uniq_zeros(2 * width),
        sparse: uniq_zeros(2 * width),
        slots: UniqList::[i64].new(),
        stack: uniq_filled(width + 1),
        values: uniq_filled(width + 1),
        scratch: UniqList::[i64].new(),
        found: UniqList::[i64].new(),
        from: 0,
        last_end: -1,
        finished: false,
        filter: filter,
        filtered: bytes_len(filter.literal) > 0 || filter.firsts.len() > 0,
        forward: forward,
        reverse: reverse,
        hit_from: 1,
        hit: -1,
        near_from: 0,
        near_until: -1,
        busy: false,
        dfa: true,
    }

# Readies `vm` for a call on `text` with `slot_count` slots for each
# thread. The slot lists grow to the most slots a call has asked for and
# never shrink, so a VM reused across calls allocates only when a call
# needs more than any before it.
fn ready(vm: &mut Vm, text: string, slot_count: usize) -> void:
    vm.text = text
    vm.size = bytes_len(text)
    vm.slot_count = slot_count
    need := 2 * vm.program.ops.len() * slot_count
    while vm.slots.len() < need:
        vm.slots.push(-1)
    while vm.scratch.len() < slot_count:
        vm.scratch.push(-1)
    vm.found.truncate(slot_count)
    while vm.found.len() < slot_count:
        vm.found.push(-1)
    vm.from = 0
    vm.last_end = -1
    vm.finished = false
    vm.hit_from = vm.size + 1
    vm.hit = -1
    vm.near_from = 0
    vm.near_until = -1

impl Vm:
    # Where the match found starts and ends; it always has both.
    fn start(&self) -> usize:
        usize(self.found[0])

    fn end(&self) -> usize:
        usize(self.found[1])

    fn whole(&self) -> Match:
        from := self.start()
        to := self.end()
        Match { start: from, end: to, text: bytes_slice(self.text, from, to) }

    # The groups of the match found.
    fn groups(&self, names: List[string]) -> Captures:
        let mut slots: List[usize?] = []
        let slot: usize = 0
        while slot < self.found.len():
            value := self.found[slot]
            if value < 0:
                slots.push(.None)
            else:
                slots.push(.Some(usize(value)))
            slot += 1
        Captures { text: self.text, slots: slots, names: names }

# Runs the next search of a `find_all` series (r-std-regex.find-all.next)
# and leaves the match to report in `found`: after a match the next search
# starts at its end, or one character later when it is empty, and an empty
# match where the last one ended is dropped. False when no match is left.
fn advance(vm: &mut Vm) -> bool:
    while !vm.finished:
        if !locate(vm, vm.from):
            vm.finished = true
            return false
        start := vm.start()
        end := vm.end()
        if start != end:
            vm.from = end
            vm.last_end = i64(end)
            return true
        repeated := vm.last_end == i64(start)
        vm.last_end = i64(end)
        if end == vm.size:
            vm.finished = true
        else:
            vm.from = end + scalar_width(bytes_at(vm.text, end))
        if !repeated:
            return true
    false

# The next match at byte `from` or later, its slots in `vm.found`: on
# the DFA, unless the call wants every group from the Pike VM. A
# replacement that names groups gets them by running the Pike VM again
# from the match's start, which finds the same match: a thread it no
# longer starts before that byte could reach no `Done`, or the match
# would start there (regex-automata's meta engine narrows a capture
# search to the DFA's span the same way).
fn locate(vm: &mut Vm, from: usize) -> bool:
    if !vm.dfa:
        return run(vm, from, false)
    if !search(vm, from, false):
        return false
    if vm.slot_count > 2:
        _ := run(vm, vm.start(), false)
    true

# The Pike VM (r-std-regex.find.leftmost-first): threads in priority
# order, at most one per instruction at each position, starting at byte
# `from`. When it finds a match, it returns true with the match's slots in
# `vm.found`, slot 0 its start and slot 1 its end. With `earliest`, as
# `is_match` asks, it returns true as soon as any thread reaches `Done`.
# A new thread starts only where the prefilter lets a match start, and
# when no thread is alive the search jumps to the next such byte.
fn run(vm: &mut Vm, from: usize, earliest: bool) -> bool:
    # A copy: the calls below change `vm` (r-ref.excl.write).
    program := vm.program
    ops := &program.ops
    points := &program.points
    ranges := &program.ranges
    left := &program.left
    right := &program.right
    text := vm.text
    size := vm.size
    slot_count := vm.slot_count
    done := ops.len() - 1
    filtered := vm.filtered
    # The sides of the current and the next thread list, and the length of
    # the current one.
    let current: usize = 0
    let next: usize = ops.len()
    let count: usize = 0
    let at = from
    if filtered:
        start := next_start(vm, from)
        if start < 0:
            return false
        at = usize(start)
    restart(&mut vm.scratch, slot_count, at)
    count = add_thread(vm, program, current, 0, 0, at)
    if earliest && has(&vm.dense, &vm.sparse, current, count, done):
        return true
    let matched = false
    while true:
        let next_count: usize = 0
        let point: i32 = -1
        let after = at
        if at < size:
            lead := bytes_at(text, at)
            if lead < 128:
                point = i32(lead)
                after = at + 1
            else:
                after = at + scalar_width(lead)
                point = scalar_point(text, at, after, lead)
        let index: usize = 0
        while index < count:
            pc := vm.dense[current + index]
            index = index + 1
            op := ops[pc]
            let step = false
            if op == 0:
                step = point == points[pc]
            else if op == 1:
                step = point >= 0 && point != 10
            else if op == 4:
                # A finished thread cuts off every thread it outranks.
                let slot: usize = 0
                base := (current + pc) * slot_count
                while slot < slot_count:
                    vm.found[slot] = vm.slots[base + slot]
                    slot = slot + 1
                if slot_count > 1:
                    vm.found[1] = i64(at)
                matched = true
                break
            else if op <= 3 && point >= 0:
                let hit = false
                let bound = left[pc]
                end := right[pc]
                while bound < end:
                    if point >= ranges[bound] && point <= ranges[bound + 1]:
                        hit = true
                        break
                    bound = bound + 2
                step = hit != (op == 3)
            if step:
                let slot: usize = 0
                base := (current + pc) * slot_count
                while slot < slot_count:
                    vm.scratch[slot] = vm.slots[base + slot]
                    slot = slot + 1
                next_count = add_thread(vm, program, next, next_count, pc + 1, after)
                if earliest && has(&vm.dense, &vm.sparse, next, next_count, done):
                    return true
        if at >= size:
            break
        at = after
        if !matched:
            let seed = i64(at)
            if filtered:
                seed = start_from(vm, at, next_count > 0)
            if seed >= 0:
                at = usize(seed)
                restart(&mut vm.scratch, slot_count, at)
                next_count = add_thread(vm, program, next, next_count, 0, at)
                if earliest && has(&vm.dense, &vm.sparse, next, next_count, done):
                    return true
            else if next_count == 0:
                break
        else if next_count == 0:
            break
        held := current
        current = next
        next = held
        count = next_count
    matched

# The first byte at or after `at` where the prefilter lets a match start,
# or -1 when none can start there or later. `firsts` holds no UTF-8
# continuation byte, and a literal starts at a scalar boundary, so every
# byte this returns starts a scalar.
fn next_start(vm: &mut Vm, at: usize) -> i64:
    filter := vm.filter
    text := vm.text
    size := vm.size
    width := bytes_len(filter.literal)
    firsts := filter.firsts
    let position = at
    while true:
        if width > 0 && !literal_near(vm, position):
            if position + filter.lo + width > size || vm.hit < 0:
                return -1
            # The next literal is more than `hi` bytes ahead, and a match
            # starts at most that far before it: go there, backed up to
            # the first byte of a scalar.
            let earliest = usize(vm.hit) - usize(filter.hi)
            while continuation(bytes_at(text, earliest)):
                earliest = earliest - 1
            position = earliest
        if firsts.len() == 0:
            return i64(position)
        let next = position
        while next < size:
            byte := bytes_at(text, next)
            if (firsts[usize(byte / 64)] >> u64(byte % 64)) & 1 != 0:
                break
            next = next + 1
        if next >= size:
            return -1
        if next == position || width == 0:
            return i64(next)
        # Past a first byte the literal may now be too far ahead.
        position = next

# Where the search starts its next thread, at byte `at` or later, or -1
# for nowhere. While threads are `alive` it cannot jump over them, so that
# is `at` itself when the prefilter lets a match start there.
fn start_from(vm: &mut Vm, at: usize, alive: bool) -> i64:
    if !alive:
        return next_start(vm, at)
    firsts := vm.filter.firsts
    if firsts.len() > 0:
        if at >= vm.size:
            return -1
        byte := bytes_at(vm.text, at)
        if (firsts[usize(byte / 64)] >> u64(byte % 64)) & 1 == 0:
            return -1
    # A literal with no bound on its place is tested only where the
    # search jumps: testing it at every byte costs more than the threads
    # it saves.
    if vm.filter.hi >= 0 && bytes_len(vm.filter.literal) > 0 && !literal_near(vm, at):
        return -1
    i64(at)

# Whether the prefilter's literal is close enough after byte `at` for a
# match to start there, or may be. Each literal found marks the bytes it
# is close enough to, so most calls need no search. A literal with no
# bound on its place only rejects a text with none ahead: once one is
# found, every byte may start a match, since searching again past each
# one would cost a search per match and could never make the search jump.
fn literal_near(vm: &mut Vm, at: usize) -> bool:
    if i64(at) >= vm.near_from && i64(at) <= vm.near_until:
        return true
    want := at + vm.filter.lo
    if want + bytes_len(vm.filter.literal) > vm.size:
        return false
    if vm.hit_from > want || (vm.hit >= 0 && usize(vm.hit) < want):
        vm.hit_from = want
        vm.hit = find_literal(vm.text, vm.filter.literal, want)
        if vm.hit >= 0:
            if vm.filter.hi < 0:
                vm.near_from = i64(at)
                vm.near_until = i64(vm.size)
            else:
                vm.near_from = vm.hit - vm.filter.hi
                vm.near_until = vm.hit - i64(vm.filter.lo)
    vm.hit >= 0 && (vm.filter.hi < 0 || usize(vm.hit) <= at + usize(vm.filter.hi))

# The first `literal` at or after byte `from`, or -1. A longer literal
# goes to std.text's Two-Way search through `find` on the text from `from`,
# a slice that shares the bytes, unless it is right at `from`. A one-byte
# literal is a plain byte scan, which is what that search does for one
# byte. Both shortcuts save building the searcher on each call.
fn find_literal(text: string, literal: string, from: usize) -> i64:
    size := bytes_len(text)
    width := bytes_len(literal)
    if width == 1:
        at := bytes_index(text, from, bytes_at(literal, 0))
        return if at < size: i64(at) else: -1
    let index: usize = 0
    while (
        index < width
        && from + index < size
        && bytes_at(text, from + index) == bytes_at(literal, index)
    ):
        index = index + 1
    if index == width:
        return i64(from)
    match bytes_slice(text, from, size).find(literal):
        .Some(offset) => i64(from + offset)
        .None => -1

# Sets the scratch slots for a thread that starts at byte `at`.
fn restart(scratch: &mut UniqList[i64], slot_count: usize, at: usize) -> void:
    if slot_count == 0:
        return
    scratch[0] = i64(at)
    let slot: usize = 1
    while slot < slot_count:
        scratch[slot] = -1
        slot = slot + 1

# The byte length of the UTF-8 scalar whose first byte is `lead`.
fn scalar_width(lead: u8) -> usize:
    if lead < 128:
        return 1
    if lead < 224:
        return 2
    if lead < 240: 3 else: 4

# The code point of the scalar from byte `at` up to `after`, whose first
# byte is `lead`, at least 128.
fn scalar_point(text: string, at: usize, after: usize, lead: u8) -> i32:
    let point = i32(lead)
    if lead < 224:
        point = point - 192
    else if lead < 240:
        point = point - 224
    else:
        point = point - 240
    let index = at + 1
    while index < after:
        point = point * 64 + i32(bytes_at(text, index)) - 128
        index = index + 1
    point

# Adds the thread at `start`, with the slots in `vm.scratch`, to the list
# at `side`, which holds `count` threads, following jumps, splits, saves,
# and assertions in priority order at byte `at`, and returns the list's new
# length. An instruction already in the list is not visited again. A save
# sets its slot for the instructions after it and puts the old value back
# after them, so `vm.scratch` is unchanged on return.
fn add_thread(
    vm: &mut Vm,
    program: &Program,
    side: usize,
    count: usize,
    start: usize,
    at: usize,
) -> usize:
    # Borrowed, not copied: a copy of each list would retain and release
    # it on every call, a fifth of a search's time.
    ops := &program.ops
    slot_count := vm.slot_count
    if ops[start] <= 4:
        # A thread that waits for a character, the common case, needs no
        # walk.
        if has(&vm.dense, &vm.sparse, side, count, start):
            return count
        vm.sparse[side + start] = count
        vm.dense[side + count] = start
        base := (side + start) * slot_count
        let slot: usize = 0
        while slot < slot_count:
            vm.slots[base + slot] = vm.scratch[slot]
            slot = slot + 1
        return count + 1
    left := &program.left
    right := &program.right
    size := vm.size
    let length = count
    vm.stack[0] = i64(start)
    let top: usize = 1
    while top > 0:
        top = top - 1
        entry := vm.stack[top]
        if entry < 0:
            vm.scratch[usize(-1 - entry)] = vm.values[top]
            continue
        # Follow the first choice at each step in place; the stack holds
        # only the second choices and the slots to put back.
        let pc = usize(entry)
        while true:
            place := vm.sparse[side + pc]
            if place < length && vm.dense[side + place] == pc:
                break
            vm.sparse[side + pc] = length
            vm.dense[side + length] = pc
            length = length + 1
            op := ops[pc]
            if op <= 4:
                base := (side + pc) * slot_count
                let slot: usize = 0
                while slot < slot_count:
                    vm.slots[base + slot] = vm.scratch[slot]
                    slot = slot + 1
                break
            if op == 5:
                vm.stack[top] = i64(right[pc])
                top = top + 1
                pc = left[pc]
            else if op == 6:
                pc = left[pc]
            else if op == 7:
                slot := left[pc]
                if slot < slot_count:
                    vm.stack[top] = -1 - i64(slot)
                    vm.values[top] = vm.scratch[slot]
                    top = top + 1
                    vm.scratch[slot] = i64(at)
                pc = pc + 1
            else if op == 8:
                if at != 0:
                    break
                pc = pc + 1
            else:
                if at != size:
                    break
                pc = pc + 1
    length

# One direction of the lazy DFA, as regex-automata's hybrid DFA builds one
# (src/hybrid/dfa.rs, Lazy::cache_next_state): a state is the list of
# nodes the search's threads wait at, and its transitions are computed the
# first time a search takes them. The forward DFA keeps a state's nodes in
# priority order and drops those after `accept` (determinize::next drops
# them for leftmost-first), so the last match it sees is the one the Pike
# VM picks; the reverse DFA keeps every thread (MatchKind::All) and sorts
# its nodes. A guard that fails becomes a marker, node `nodes + n`, when it
# may still hold where the search ends: `$` going forward, `^` going back.
#
# The cache: state s's transition on byte class c is
# `trans[s * stride + c]`, holding the next state's code: its row,
# `s * stride`, plus `special()` when the state is dead, a match, or the
# start the prefilter skips from, and `unknown()` before it is computed
# (MoonBit's regex_engine/dfa.mbt marks the entries that stop its scan
# loop the same way). Its nodes are `sets[set_at[s]]` up to
# `sets[set_at[s + 1]]`, and `table` finds a state from its nodes by their
# hash, with linear probing. The tables are uniquely owned lists in the
# DFA's box, so a step reads one with no reference count. A step reads one
# table entry; computing a transition costs time linear in the graph's
# edges out of the state's nodes and in the nodes it reaches. When a new
# state would take the entries in use past `limit`, the cache is cleared,
# once in a search; when it fills again the search gives up and the Pike
# VM runs it (Lazy::try_clear_cache gives up after a set count of clears
# too).
struct Dfa:
    graph: Graph
    nodes: usize
    classes: UniqList[usize]
    reps: List[i32]
    stride: usize
    accept: usize
    forward: bool
    late: i32
    # The nodes of the start states: 0 where the edge guard holds (`^` at
    # byte 0 going forward, `$` at the end going back), 1 elsewhere.
    starts: List[List[usize]]
    tagged: bool
    limit: usize
    cleared: bool
    gave_up: usize
    trans: UniqList[usize]
    flags: UniqList[usize]
    hashes: UniqList[u32]
    sets: UniqList[usize]
    set_at: UniqList[usize]
    table: UniqList[usize]
    start_codes: UniqList[usize]
    # The closure's scratch: a sparse set of the nodes it has visited, and
    # its stack, which never holds more than the graph's edges plus one.
    dense: UniqList[usize]
    sparse: UniqList[usize]
    stack: UniqList[usize]

# A transition not computed yet, and the mark of a state that stops the
# scan loop.
fn unknown() -> usize:
    536870912

fn special() -> usize:
    268435456

# The cache entries a DFA may use: 2^18, a mebibyte of 4-byte entries
# for each direction, half of regex-automata's default two mebibytes.
fn cache_limit() -> usize:
    262144

fn new_dfa(
    graph: Graph,
    built: &Automaton,
    start: usize,
    accept: usize,
    forward: bool,
    tagged: bool,
) -> *mut Dfa:
    count := graph.at.len() - 1
    edges := graph.to.len()
    let mut classes = UniqList::[usize].with_capacity(256)
    for class in built.classes:
        classes.push(class)
    # Boxed because each regex shares its cache across its searches.
    dfa := box(
        Dfa {
            graph: graph,
            nodes: count,
            classes: classes,
            reps: built.reps,
            stride: built.reps.len(),
            accept: accept,
            forward: forward,
            late: if forward: +2 else: +1,
            starts: [],
            tagged: tagged,
            limit: cache_limit(),
            cleared: false,
            gave_up: 0,
            trans: UniqList::[usize].new(),
            flags: UniqList::[usize].new(),
            hashes: UniqList::[u32].new(),
            sets: UniqList::[usize].new(),
            set_at: UniqList::[usize].new(),
            table: uniq_zeros(64),
            start_codes: UniqList::[usize].new(),
            dense: uniq_zeros(count),
            sparse: uniq_zeros(count),
            stack: uniq_zeros(edges + 1),
        }
    )
    for variant in [true, false]:
        let mut set: List[usize] = []
        _ := close(dfa, &mut set, 0, start, forward && variant, !forward && variant)
        if !forward:
            set.sort()
        dfa.starts.push(set)
    reset(dfa)
    dfa

# Empties the cache but for the dead state, state 0, whose list is empty.
fn reset(dfa: *mut Dfa) -> void:
    dfa.trans.clear()
    dfa.flags.clear()
    dfa.hashes.clear()
    dfa.sets.clear()
    dfa.set_at.clear()
    dfa.set_at.push(0)
    let slot: usize = 0
    while slot < dfa.table.len():
        dfa.table[slot] = 0
        slot += 1
    dfa.start_codes.clear()
    dfa.start_codes.push(unknown())
    dfa.start_codes.push(unknown())
    let empty: List[usize] = []
    _ := intern(dfa, &empty)

# Adds to `set` the nodes the threads reach from `node` without reading a
# byte, in priority order, with `seen` nodes visited so far in this step,
# and returns the count visited after. A node is kept when it reads a
# byte, is `accept`, or is a guard's marker. Reaching `accept` going
# forward ends the walk: the threads still on the stack rank below it.
fn close(
    dfa: *mut Dfa,
    set: &mut List[usize],
    seen: usize,
    node: usize,
    begin: bool,
    end: bool,
) -> usize:
    graph := &dfa.graph
    accept := dfa.accept
    let count = seen
    dfa.stack[0] = node
    let top: usize = 1
    while top > 0:
        top -= 1
        here := dfa.stack[top]
        place := dfa.sparse[here]
        if place < count && dfa.dense[place] == here:
            continue
        dfa.sparse[here] = count
        dfa.dense[count] = here
        count += 1
        guard := graph.guards[here]
        if (guard == 1 && !begin) || (guard == 2 && !end):
            if guard == dfa.late:
                set.push(dfa.nodes + here)
            continue
        if here == accept:
            set.push(here)
            if dfa.forward:
                return count
        let reads = false
        let edge = graph.at[here + 1]
        while edge > graph.at[here]:
            edge -= 1
            if graph.lows[edge] < 0:
                dfa.stack[top] = graph.to[edge]
                top += 1
            else:
                reads = true
        if reads && here != accept:
            set.push(here)
    count

# The code of the state whose nodes are `set`, added when it is new, or
# `unknown()` when it does not fit in the cache.
fn intern(dfa: *mut Dfa, set: &List[usize]) -> usize:
    let hash: u32 = 2166136261
    for node in set:
        hash = (hash ^ u32(node)).wrapping_mul(16777619)
    let mask = dfa.table.len() - 1
    let slot = usize(hash) & mask
    while dfa.table[slot] != 0:
        id := dfa.table[slot] - 1
        if dfa.hashes[id] == hash && same(&dfa.sets, dfa.set_at[id], dfa.set_at[id + 1], set):
            return code_of(dfa, id)
        slot = (slot + 1) & mask
    stride := dfa.stride
    if dfa.trans.len() + dfa.sets.len() + dfa.table.len() + set.len() + stride > dfa.limit:
        return unknown()
    id := dfa.hashes.len()
    for node in set:
        dfa.sets.push(node)
    dfa.set_at.push(dfa.sets.len())
    dfa.hashes.push(hash)
    let column: usize = 0
    while column < stride:
        dfa.trans.push(unknown())
        column += 1
    let flag: usize = if set.len() == 0: 4 else: 0
    if set.contains(&dfa.accept):
        flag = flag | 1
    if dfa.tagged && dfa.starts[1] == *set:
        flag = flag | 2
    dfa.flags.push(flag)
    dfa.table[slot] = id + 1
    if 2 * (id + 1) > dfa.table.len():
        # Twice the size, and every state put back in its new place.
        size := 2 * dfa.table.len()
        mask = size - 1
        dfa.table.clear()
        while dfa.table.len() < size:
            dfa.table.push(0)
        let state: usize = 0
        while state <= id:
            let place = usize(dfa.hashes[state]) & mask
            while dfa.table[place] != 0:
                place = (place + 1) & mask
            dfa.table[place] = state + 1
            state += 1
    code_of(dfa, id)

fn code_of(dfa: *mut Dfa, id: usize) -> usize:
    row := id * dfa.stride
    if dfa.flags[id] != 0: row + special() else: row

# Whether `list` from `start` up to `end` holds the nodes of `set`.
fn same(list: &UniqList[usize], start: usize, end: usize, set: &List[usize]) -> bool:
    if end - start != set.len():
        return false
    let index: usize = 0
    while index < set.len():
        if list[start + index] != set[index]:
            return false
        index += 1
    true

# The code of start state `variant`.
fn start_code(dfa: *mut Dfa, variant: usize) -> usize:
    known := dfa.start_codes[variant]
    if known != unknown():
        return known
    set := dfa.starts[variant]
    let found = intern(dfa, &set)
    if found == unknown() && !dfa.cleared:
        reset(dfa)
        dfa.cleared = true
        found = intern(dfa, &set)
    if found != unknown():
        dfa.start_codes[variant] = found
    found

# The code of the state that state `id` goes to on byte class `class`,
# computed and kept, or `unknown()` when the cache gave out.
fn transition(dfa: *mut Dfa, id: usize, class: usize) -> usize:
    # Copies, which share the lists: `close` below changes `dfa`.
    at := dfa.graph.at
    to := dfa.graph.to
    lows := dfa.graph.lows
    highs := dfa.graph.highs
    byte := dfa.reps[class]
    let mut set: List[usize] = []
    let seen: usize = 0
    let index = dfa.set_at[id]
    end := dfa.set_at[id + 1]
    while index < end:
        node := dfa.sets[index]
        index += 1
        if node >= dfa.nodes:
            continue
        let edge = at[node]
        while edge < at[node + 1]:
            low := lows[edge]
            if low >= 0 && byte >= low && byte <= highs[edge]:
                seen = close(dfa, &mut set, seen, to[edge], false, false)
                if dfa.forward && set.len() > 0 && set[set.len() - 1] == dfa.accept:
                    index = end
                    break
            edge += 1
    if !dfa.forward:
        set.sort()
    found := intern(dfa, &set)
    if found == unknown() && !dfa.cleared:
        # The state left is gone with the cache, so the transition is not
        # kept.
        reset(dfa)
        dfa.cleared = true
        return intern(dfa, &set)
    if found != unknown():
        dfa.trans[id * dfa.stride + class] = found
    found

# Whether state `id` reaches `accept` where the search ends, there being
# its markers' guards may hold.
fn ends_matching(dfa: *mut Dfa, id: usize, begin: bool, end: bool) -> bool:
    let mut set: List[usize] = []
    let seen: usize = 0
    let index = dfa.set_at[id]
    while index < dfa.set_at[id + 1]:
        node := dfa.sets[index]
        if node >= dfa.nodes:
            seen = close(dfa, &mut set, seen, node - dfa.nodes, begin, end)
        index += 1
    set.contains(&dfa.accept)

# The end of the leftmost-first match that starts at byte `from` or later,
# -1 when there is none, or -2 when the cache gave out; with `earliest`,
# the end of the first match seen (hybrid/search.rs, find_fwd). Each byte
# costs one table read until a special state, and the prefilter's literal
# moves the search over the text a match cannot start in.
fn forward_end(vm: &mut Vm, from: usize, earliest: bool) -> i64:
    dfa := vm.forward
    dfa.cleared = false
    text := vm.text
    size := vm.size
    let at = from
    if vm.filtered:
        first := next_start(vm, from)
        if first < 0:
            return -1
        at = usize(first)
    let code = start_code(dfa, if at == 0: 0 else: 1)
    stride := dfa.stride
    stop := special()
    let found: i64 = -1
    while code != unknown():
        let row = code
        if code >= stop:
            row = code - stop
            flag := dfa.flags[row / stride]
            if flag & 4 != 0:
                return found
            if flag & 1 != 0:
                found = i64(at)
                if earliest:
                    return found
            else if flag & 2 != 0:
                # A start state with no thread older than itself: nothing
                # is lost by moving on to where the literal allows a match.
                skip := next_start(vm, at)
                if skip < 0:
                    return found
                if usize(skip) > at:
                    at = usize(skip)
        while at < size:
            next := dfa.trans[row + dfa.classes[usize(bytes_at(text, at))]]
            if next >= stop:
                break
            row = next
            at += 1
        if at >= size:
            if found != i64(size) && ends_matching(dfa, row / stride, size == 0, true):
                found = i64(size)
            return found
        class := dfa.classes[usize(bytes_at(text, at))]
        code = dfa.trans[row + class]
        if code == unknown():
            code = transition(dfa, row / stride, class)
        at += 1
    dfa.gave_up += 1
    -2

# The start of the match that ends at byte `end`, scanning back to `from`:
# the reverse DFA keeps every thread, so the last match it sees is the
# leftmost start (hybrid/regex.rs, try_search). -1 when the cache gave out.
fn reverse_start(vm: &mut Vm, from: usize, end: usize) -> i64:
    dfa := vm.reverse
    dfa.cleared = false
    text := vm.text
    let code = start_code(dfa, if end == vm.size: 0 else: 1)
    stride := dfa.stride
    stop := special()
    let found: i64 = -1
    let at = end
    while code != unknown():
        let row = code
        if code >= stop:
            row = code - stop
            flag := dfa.flags[row / stride]
            if flag & 4 != 0:
                return found
            if flag & 1 != 0:
                found = i64(at)
        while at > from:
            next := dfa.trans[row + dfa.classes[usize(bytes_at(text, at - 1))]]
            if next >= stop:
                break
            row = next
            at -= 1
        if at <= from:
            if found != i64(from) && ends_matching(dfa, row / stride, from == 0, from == vm.size):
                found = i64(from)
            return found
        class := dfa.classes[usize(bytes_at(text, at - 1))]
        code = dfa.trans[row + class]
        if code == unknown():
            code = transition(dfa, row / stride, class)
        at -= 1
    dfa.gave_up += 1
    -1

# One search from byte `from`: with `earliest`, whether any match is there,
# as `is_match` asks; otherwise the leftmost-first match's bounds, put in
# `vm.found`. The forward DFA finds the end and the reverse DFA the start,
# and the Pike VM runs the search when either one's cache gives out.
fn search(vm: &mut Vm, from: usize, earliest: bool) -> bool:
    end := forward_end(vm, from, earliest)
    if end == -2:
        return run(vm, from, earliest)
    if end < 0:
        return false
    if earliest:
        return true
    let start = i64(from)
    if usize(end) > from:
        start = reverse_start(vm, from, usize(end))
        if start < 0:
            return run(vm, from, earliest)
    vm.found[0] = start
    vm.found[1] = end
    true

# A reference in a replacement (r-std-regex.replace.expand).
enum Reference:
    Dollar
    Index(value: usize)
    Name(value: string)

struct Found:
    reference: Reference
    next: usize

# The reference that the `$` at `at` starts, if any; any other `$` is
# itself (r-std-regex.replace.literal).
fn reference_at(template: Pattern, at: usize) -> Found?:
    match template.at(at + 1):
        .Some('$') => .Some(Found { reference: Reference.Dollar, next: at + 2 })
        .Some('{') =>
            let close = at + 2
            while close < template.chars.len() && !template.has(close, '}'):
                close = close + 1
            if close >= template.chars.len():
                return .None
            digits := number_at(template, at + 2)?
            if digits.next == close && close > at + 2:
                return .Some(Found { reference: Reference.Index(digits.value), next: close + 1 })
            if group_name(template, at + 2, close):
                return .Some(
                    Found {
                        reference: Reference.Name(template.piece(at + 2, close)),
                        next: close + 1,
                    },
                )
            .None
        _ =>
            digits := number_at(template, at + 1)?
            if digits.next == at + 1:
                return .None
            .Some(Found { reference: Reference.Index(digits.value), next: digits.next })

# `template` with each reference replaced by the text it names
# (r-std-regex.replace.expand). Join pieces once instead of repeatedly
# copying the already-expanded prefix for each reference.
fn expand(template: Pattern, groups: Captures) -> string:
    let mut pieces: List[string] = []
    let literal: usize = 0
    let at: usize = 0
    while at < template.chars.len():
        if !template.has(at, '$'):
            at = at + 1
            continue
        match reference_at(template, at):
            .None => at = at + 1
            .Some(found) =>
                if literal < at:
                    pieces.push(template.piece(literal, at))
                pieces.push(reference_text(found.reference, groups))
                at = found.next
                literal = at
    if literal < template.chars.len():
        pieces.push(template.piece(literal, template.chars.len()))
    pieces.join("")

# Whether `template` refers to a group other than group 0.
fn names_groups(template: Pattern) -> bool:
    let at: usize = 0
    while at < template.chars.len():
        if template.has(at, '$'):
            match reference_at(template, at):
                .Some(found) =>
                    match found.reference:
                        .Index(value) =>
                            if value > 0:
                                return true
                        .Name(_) => return true
                        .Dollar => pass
                    at = found.next
                    continue
                .None => pass
        at += 1
    false

fn reference_text(reference: Reference, groups: Captures) -> string:
    match reference:
        .Dollar => "\$"
        .Index(value) => group_text(groups.get(value))
        .Name(value) => group_text(groups.name(value))

fn group_text(group: Match?) -> string:
    match group:
        .Some(found) => found.text
        .None => ""

# The ranges of scalar values a class's items match. `\d` and `\w` are
# ASCII; `\s` is Unicode White_Space (r-std-regex.syntax.escape.digit,
# r-std-regex.syntax.escape.space).
fn class_ranges(items: List[ClassItem]) -> List[i32]:
    let mut ranges: List[i32] = []
    for item in items:
        match item:
            .Range(low, high) =>
                ranges.push(i32(char_scalar(low)))
                ranges.push(i32(char_scalar(high)))
            .Digit(negated) => push_ranges(&mut ranges, [+48, +57], negated)
            .Word(negated) =>
                push_ranges(&mut ranges, [+48, +57, +65, +90, +95, +95, +97, +122], negated)
            .Space(negated) =>
                push_ranges(
                    &mut ranges,
                    [
                        +9,
                        +13,
                        +32,
                        +32,
                        +133,
                        +133,
                        +160,
                        +160,
                        +5760,
                        +5760,
                        +8192,
                        +8202,
                        +8232,
                        +8233,
                        +8239,
                        +8239,
                        +8287,
                        +8287,
                        +12288,
                        +12288,
                    ],
                    negated,
                )
    ranges

# Pushes the sorted ranges `set`, or, when `negated`, the ranges between
# them up to the largest scalar value.
fn push_ranges(ranges: &mut List[i32], set: List[i32], negated: bool) -> void:
    if !negated:
        for bound in set:
            ranges.push(bound)
        return
    let low = +0
    let index: usize = 0
    while index < set.len():
        if set[index] > low:
            ranges.push(low)
            ranges.push(set[index] - 1)
        low = set[index + 1] + 1
        index = index + 2
    ranges.push(low)
    ranges.push(+1114111)

fn word_char(c: char) -> bool:
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

# `Debug` for this module's types (r-std-format.debug.std-types), written by
# hand with the builder calls that `@derive(Debug)` generates.

# Keep handwritten Debug: show the pattern text and hide compiled instructions.
impl Debug for Regex:
    fn debug(&self, out: *mut DebugWriter) -> void:
        out.debug_struct("Regex").field("pattern", self.text).finish()

tests:
    use std.rt.{char_from_scalar}
    use std.testing.{assert, assert_equal}

    it("byte classes split at each range's ends and nowhere else"):
        regex := match Regex::new("[a-c]x"):
            .Ok(regex) => regex
            .Err(_) => panic("pattern")
        classes := &regex.forward.classes
        assert_equal(classes[usize(char_scalar('a'))], classes[usize(char_scalar('c'))])
        assert(classes[usize(char_scalar('`'))] != classes[usize(char_scalar('a'))])
        assert(classes[usize(char_scalar('c'))] != classes[usize(char_scalar('d'))])
        assert(classes[usize(char_scalar('w'))] != classes[usize(char_scalar('x'))])
        assert(classes[usize(char_scalar('x'))] != classes[usize(char_scalar('y'))])
        assert_equal(classes[0], classes[usize(char_scalar('`'))])
        assert_equal(classes[usize(char_scalar('d'))], classes[usize(char_scalar('w'))])
        assert_equal(classes[255], classes[usize(char_scalar('y'))])
        assert_equal(classes[255], 4)

    it("a multi-byte character's bytes are classes of their own"):
        regex := match Regex::new("é"):
            .Ok(regex) => regex
            .Err(_) => panic("pattern")
        classes := &regex.forward.classes
        assert(classes[0xC3] != classes[0xC2])
        assert(classes[0xC3] != classes[0xC4])
        assert(classes[0xA9] != classes[0xA8])
        assert(classes[0xA9] != classes[0xAA])
        assert_equal(classes[0xC4], classes[0xFF])

    it("a class reads exactly the UTF-8 forms of its scalars"):
        scalar := fn(point: i32) -> string:
            match char_from_scalar(u32(point)):
                .Some(c) => "$c"
                .None => ""
        # Whether the forward graph, from node 0 and with no prefix, reads
        # all of `text` and ends at `Done`: a plain NFA run over its bytes.
        reads := fn(pattern: string, text: string) -> bool:
            regex := match Regex::new(pattern):
                .Ok(regex) => regex
                .Err(_) => return false
            graph := regex.forward.graph
            done := regex.program.ops.len() - 1
            let mut current: List[usize] = [0]
            let at: usize = 0
            while true:
                let mut seen: List[usize] = []
                while current.len() > 0:
                    node := current[current.len() - 1]
                    current.truncate(current.len() - 1)
                    if !seen.contains(&node):
                        seen.push(node)
                        let edge = graph.at[node]
                        while edge < graph.at[node + 1]:
                            if graph.lows[edge] < 0:
                                current.push(graph.to[edge])
                            edge += 1
                if at == bytes_len(text):
                    return seen.contains(&done)
                byte := i32(bytes_at(text, at))
                for node in seen:
                    let edge = graph.at[node]
                    while edge < graph.at[node + 1]:
                        if (
                            graph.lows[edge] >= 0
                            && byte >= graph.lows[edge]
                            && byte <= graph.highs[edge]
                        ):
                            current.push(graph.to[edge])
                        edge += 1
                at += 1
            false
        probes := [
            +0,
            +9,
            +10,
            +11,
            +126,
            +127,
            +128,
            +129,
            +2046,
            +2047,
            +2048,
            +2049,
            +4095,
            +4096,
            +55295,
            +57344,
            +65534,
            +65535,
            +65536,
            +65537,
            +262143,
            +262144,
            +1114110,
            +1114111,
        ]
        bounds := [
            (+128, +1114111),
            (+2049, +65534),
            (+127, +65536),
            (+4097, +262142),
            (+129, +2048),
            (+65537, +1114110),
            (+10, +10),
        ]
        for bound in bounds:
            low := scalar(bound._0)
            high := scalar(bound._1)
            for point in probes:
                inside := point >= bound._0 && point <= bound._1
                text := scalar(point)
                assert_equal(reads("[$low-$high]", text), inside, reason="[$low-$high] on $point")
                assert_equal(
                    reads("[^$low-$high]", text),
                    !inside,
                    reason="[^$low-$high] on $point",
                )
        for point in probes:
            assert_equal(reads(".", scalar(point)), point != 10, reason=". on $point")
        assert(!reads(".", ""))
        assert(!reads(".", "ab"))
        assert(!reads("[^a]", "a"))
        assert(reads("[ab][é€]", "a€"))

    it("the lazy DFA finds what the Pike VM finds from every start"):
        cases := [
            ("a+", "baab"),
            ("a+?", "baab"),
            ("(a|ab)(c|bcd)", "xabcd"),
            ("x*", "axxb"),
            ("^a", "aba"),
            ("a$", "aba"),
            ("^$", ""),
            ("\$", "ab"),
            ("^", "ab"),
            ("b|^a", "ab"),
            ("a|\$", "bab"),
            ("\$a", "a"),
            ("a^b", "ab"),
            ("", "é"),
            ("é+", "aéé😀"),
            ("[^a]+", "aé€b"),
            ("(?:ab)*b", "abab"),
            ("a{2,3}", "aaaaa"),
            ("a{2,}?", "aaaa"),
            ("\\w+@\\w+", "x ab@cd e"),
            ("(é|😀)+€", "é😀€"),
            (".\$|^.", "é\n😀"),
            ("b\$|a+", "aab"),
            ("\\s*\$", "a \n"),
        ]
        for case in cases:
            regex := match Regex::new(case._0):
                .Ok(regex) => regex
                .Err(_) => panic("pattern ${case._0}")
            text := case._1
            for (from, _) in (text + "!").char_indices():
                let mut fast = new_vm(&regex, text, 2)
                let mut slow = new_vm(&regex, text, 2)
                matched := run(&mut slow, from, false)
                assert_equal(search(&mut fast, from, false), matched, reason="${case._0} at $from")
                if matched:
                    assert_equal(fast.found[0], slow.found[0], reason="${case._0} start at $from")
                    assert_equal(fast.found[1], slow.found[1], reason="${case._0} end at $from")
                let mut any = new_vm(&regex, text, 0)
                assert_equal(
                    search(&mut any, from, true),
                    matched,
                    reason="${case._0} any at $from",
                )

    it("a full cache clears once in a search, then the Pike VM runs it"):
        text := "abaababbbaabababbbaaabbabababbaabbbab"
        # The first pattern's forward DFA grows a state for each set of
        # places an `a` was seen at, and the second's reverse DFA does.
        for (pattern, ahead) in [("[ab]*a[ab]{4}", true), ("[ab]{4}a[ab]*", false)]:
            regex := match Regex::new(pattern):
                .Ok(regex) => regex
                .Err(_) => panic("pattern $pattern")
            for limit in [140, 240, 1000]:
                regex.forward.limit = limit
                regex.reverse.limit = limit
                let from: usize = 0
                while from < bytes_len(text):
                    let mut fast = new_vm(&regex, text, 2)
                    let mut slow = new_vm(&regex, text, 2)
                    matched := run(&mut slow, from, false)
                    assert_equal(
                        search(&mut fast, from, false),
                        matched,
                        reason="$pattern at $from",
                    )
                    if matched:
                        assert_equal(fast.found[0], slow.found[0], reason="$pattern at $from")
                        assert_equal(fast.found[1], slow.found[1], reason="$pattern at $from")
                    from += 3
            gave_up := if ahead: regex.forward.gave_up else: regex.reverse.gave_up
            assert(gave_up > 0, reason="$pattern gave up")

    it("the lazy DFA agrees with the Pike VM on generated patterns and texts"):
        # A seeded generator (MINSTD), so each run checks the same cases.
        rng := box::[List[u64]]([u64(20261122)])
        draw := fn(bound: usize) -> usize:
            rng[0] = rng[0] * 48271 % 2147483647
            usize(rng[0] >> 4) % bound
        pick := fn(items: List[string]) -> string: items[draw(items.len())]
        simple := fn() -> string:
            match draw(10):
                0 => "."
                1 => "^"
                2 => "\$"
                3 => pick(["\\d", "\\w", "\\W", "\\s"])
                4 => pick(["[ab]", "[^a]", "[a-é]", "[é-😀]", "[^\\n€]", "[b€]"])
                _ => pick(["a", "b", "é", "€", "😀", "\\n"])
        suffix := fn() -> string:
            lazy := if draw(2) == 0: "?" else: ""
            low := draw(3)
            match draw(10):
                4 => "*" + lazy
                5 => "+" + lazy
                6 => "?" + lazy
                7 => "{$low}" + lazy
                8 => "{$low,}" + lazy
                9 => "{$low,${low + draw(3)}}" + lazy
                _ => ""
        flat := fn() -> string:
            let mut branches: List[string] = []
            count := 1 + draw(2)
            while branches.len() < count:
                let piece = ""
                for _ in 0..draw(4):
                    piece = piece + simple() + suffix()
                branches.push(piece)
            branches.join("|")
        let cases: usize = 0
        while cases < 400:
            let mut branches: List[string] = []
            count := 1 + draw(3)
            while branches.len() < count:
                let piece = ""
                for _ in 0..draw(5):
                    kind := draw(4)
                    atom := if kind == 0:
                        "(" + flat() + ")"
                    else if kind == 1:
                        "(?:" + flat() + ")"
                    else:
                        simple()
                    piece = piece + atom + suffix()
                branches.push(piece)
            pattern := branches.join("|")
            let mut parts: List[string] = []
            for _ in 0..draw(13):
                parts.push(pick(["a", "b", "ab", "é", "€", "😀", "\n", "x"]))
            text := parts.join("")
            regex := match Regex::new(pattern):
                .Ok(regex) => regex
                .Err(error) => panic("pattern $pattern: $error")
            for (from, _) in (text + "!").char_indices():
                let mut fast = new_vm(&regex, text, 2)
                let mut slow = new_vm(&regex, text, 2)
                matched := run(&mut slow, from, false)
                assert_equal(search(&mut fast, from, false), matched, reason="$pattern at $from")
                if matched:
                    assert_equal(fast.found[0], slow.found[0], reason="$pattern start at $from")
                    assert_equal(fast.found[1], slow.found[1], reason="$pattern end at $from")
                let mut any = new_vm(&regex, text, 0)
                assert_equal(search(&mut any, from, true), matched, reason="$pattern any at $from")
            cases += 1

    it("replacements take groups from the Pike VM only when the template names one"):
        regex := match Regex::new("(?P<user>[a-z]+)@([a-z]+)"):
            .Ok(regex) => regex
            .Err(_) => panic("pattern")
        text := "to ann@x and bo@yz."
        assert_equal(regex.replace_all(text, "<\$0>"), "to <ann@x> and <bo@yz>.")
        assert_equal(regex.replace_all(text, "\${user}"), "to ann and bo.")
        assert_equal(regex.replace(text, "\$2-\$1 \$\$"), "to x-ann \$ and bo@yz.")
        assert_equal(regex.replace(text, "\$9"), "to  and bo@yz.")
        assert_equal(regex.replace("none", "\$1"), "none")
        assert_equal(regex.split(text), ["to ", " and ", "."])

    it("a call while the regex's VM is busy searches with a VM of its own"):
        regex := match Regex::new("b+"):
            .Ok(regex) => regex
            .Err(_) => panic("pattern")
        regex.idle.busy = true
        assert_equal(regex.find_all("abbcb").len(), 2)
        assert(regex.idle.busy)
        regex.idle.busy = false
        assert_equal(regex.find("abbcb"), .Some(Match { start: 1, end: 3, text: "bb" }))
