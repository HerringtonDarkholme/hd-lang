# std.regex: regular expressions in the RE2 subset (spec/std/regex.md).
# `Regex::new` parses a pattern into a tree and compiles the tree into a
# program for a Pike VM. The VM runs every thread in step over the text and
# keeps at most one thread per instruction, so a search takes time
# proportional to the program size times the text length, with no
# backtracking (r-std-regex.time.linear). A prefilter taken from the tree
# lets a search start threads only where a match could start and jump over
# the text between.
use std.format.DebugWriter
use std.serde.{Deserialize, Deserializer, ValueKind}
use std.structure.{Facts, Member, VariantInfo}

# A compiled pattern (r-std-regex.regex.decl-struct). `names[i]` is the name of
# group i, or "" for an unnamed group and for group 0.
## A compiled regular expression: immutable, and every match runs in time linear in the text.
## See [std-regex.regex.decl-struct](../../spec/std/regex.md#r-std-regex.regex.decl-struct).
pub struct Regex:
    text: string
    program: Program
    filter: Prefilter
    names: List[string]

# Where a match is: byte offsets into the searched text, and its text
# (r-std-regex.match.decl-struct).
## One match of a regex in a text.
## See [std-regex.match.decl-struct](../../spec/std/regex.md#r-std-regex.match.decl-struct).
@derive(Debug, Eq)
pub struct Match:
    ## The byte offset where the match starts.
    ## See [std-regex.match.offsets](../../spec/std/regex.md#r-std-regex.match.offsets).
    pub start: usize
    ## The byte offset one past the match's end.
    ## See [std-regex.match.offsets](../../spec/std/regex.md#r-std-regex.match.offsets).
    pub end: usize
    ## The matched text.
    ## See [std-regex.match.text](../../spec/std/regex.md#r-std-regex.match.text).
    pub text: string

# The groups of one match (r-std-regex.captures.decl-struct): two optional byte
# offsets per group; `.None` means that the group took no part.
## The capture groups of one match: group 0 is the whole match.
## See [std-regex.captures.decl-struct](../../spec/std/regex.md#r-std-regex.captures.decl-struct).
@derive(Debug)
pub struct Captures:
    text: string
    slots: List[usize?]
    names: List[string]

# Pattern errors carry their byte position; decode errors name the match
# or group that could not be decoded (r-std-regex.error.variants-with-decode).
## Why a pattern failed to compile, a match was absent, or a group could not be decoded.
## See [std-regex.error.variants-with-decode](../../spec/std/regex.md#r-std-regex.error.variants-with-decode).
@error
@derive(Debug, Eq)
pub enum RegexError:
    @error("missing closing ) at byte $position")
    MissingParen(position: usize)
    @error("unexpected ) at byte $position")
    UnmatchedParen(position: usize)
    @error("missing closing ] at byte $position")
    MissingBracket(position: usize)
    @error("invalid escape at byte $position")
    BadEscape(position: usize)
    @error("invalid character class range at byte $position")
    BadRange(position: usize)
    @error("missing argument to repetition operator at byte $position")
    NothingToRepeat(position: usize)
    @error("invalid repeat count at byte $position")
    BadRepeat(position: usize)
    @error("unsupported group at byte $position")
    UnsupportedGroup(position: usize)
    @error("invalid named capture at byte $position")
    BadGroupName(position: usize)
    @error("duplicate capture group name at byte $position")
    DuplicateGroupName(position: usize)
    @error("expression too large at byte $position")
    TooLarge(position: usize)
    @error("the regex did not match")
    NoMatch
    @error("missing regex group $name")
    MissingGroup(name: string)
    @error("cannot decode regex group $group as $expected")
    WrongType(group: string, expected: string)

impl Regex:
    ## Compiles `pattern`, or returns the first error it holds.
    ## See [std-regex.regex.new](../../spec/std/regex.md#r-std-regex.regex.new).
    pub fn new(pattern: string) -> Result[Regex, RegexError]:
        source := Pattern::of(pattern)
        let mut names: List[string] = [""]
        parsed := parse_alternation(source, 0, &mut names)?
        if parsed.next < source.chars.len():
            return .Err(RegexError.UnmatchedParen(source.offsets[parsed.next]))
        if program_size(parsed.node) > max_program():
            return .Err(RegexError.TooLarge(0))
        let mut program: List[Inst] = []
        compile(parsed.node, &mut program)
        program.push(Inst.Done)
        .Ok(Regex { text: pattern, program: lower(program), filter: prefilter(parsed.node), names: names })

    # The pattern as written.
    ## The pattern the regex was compiled from.
    ## See [std-regex.regex.pattern](../../spec/std/regex.md#r-std-regex.regex.pattern).
    pub fn pattern(self) -> string:
        self.text

    # Whether some part of `text` matches (r-std-regex.is-match). The search
    # stops at the first thread that reaches the end of the pattern.
    ## True when the regex matches anywhere in `text`.
    ## See [std-regex.is-match](../../spec/std/regex.md#r-std-regex.is-match).
    pub fn is_match(self, text: string) -> bool:
        vm := new_vm(self, text, 0)
        run(vm, 0, true)

    # The leftmost match, and among those that start there, the one the
    # pattern prefers (r-std-regex.find.leftmost-first).
    ## The leftmost match in `text`; of several starting there, the first the pattern's alternation order prefers.
    ## See [std-regex.find](../../spec/std/regex.md#r-std-regex.find).
    pub fn find(self, text: string) -> Match?:
        vm := new_vm(self, text, 2)
        if run(vm, 0, false): .Some(vm.whole()) else: .None

    # Every match, left to right, none overlapping (r-std-regex.find-all).
    ## Every non-overlapping match in `text`, from left to right.
    ## See [std-regex.find-all](../../spec/std/regex.md#r-std-regex.find-all).
    pub fn find_all(self, text: string) -> List[Match]:
        vm := new_vm(self, text, 2)
        let mut found: List[Match] = []
        while advance(vm):
            found.push(vm.whole())
        found

    # The groups of the first match (r-std-regex.captures).
    ## The capture groups of the leftmost match, or `.None`.
    ## See [std-regex.captures](../../spec/std/regex.md#r-std-regex.captures).
    pub fn captures(self, text: string) -> Captures?:
        vm := new_vm(self, text, self.slot_count())
        if run(vm, 0, false): .Some(vm.groups(self.names)) else: .None

    ## Decodes the first match as a record through its Deserialize implementation.
    ## See [std-regex.decode.regex](../../spec/std/regex.md#r-std-regex.decode.regex).
    pub fn decode[T < Deserialize](self, text: string) -> Result[T, RegexError]:
        match self.captures(text):
            .Some(captures) => captures.decode::[T]()
            .None => .Err(.NoMatch)

    # The groups of each match that `find_all` returns
    # (r-std-regex.captures-all).
    ## The capture groups of every non-overlapping match, from left to right.
    ## See [std-regex.captures-all](../../spec/std/regex.md#r-std-regex.captures-all).
    pub fn captures_all(self, text: string) -> List[Captures]:
        vm := new_vm(self, text, self.slot_count())
        let mut found: List[Captures] = []
        while advance(vm):
            found.push(vm.groups(self.names))
        found

    # `text` with its first match replaced (r-std-regex.replace).
    ## The text with its leftmost match replaced by `replacement`, whose `$` forms expand groups.
    ## See [std-regex.replace](../../spec/std/regex.md#r-std-regex.replace).
    pub fn replace(self, text: string, replacement: string) -> string:
        vm := new_vm(self, text, self.slot_count())
        if !run(vm, 0, false):
            return text
        template := Pattern::of(replacement)
        groups := vm.groups(self.names)
        text.slice(0, vm.start()) + expand(template, groups) + text.slice(vm.end(), text.len())

    # `text` with each match that `find_all` returns replaced
    # (r-std-regex.replace-all).
    ## The text with every non-overlapping match replaced by `replacement`, whose `$` forms expand groups.
    ## See [std-regex.replace-all](../../spec/std/regex.md#r-std-regex.replace-all).
    pub fn replace_all(self, text: string, replacement: string) -> string:
        vm := new_vm(self, text, self.slot_count())
        template := Pattern::of(replacement)
        # The pieces are joined once at the end, since appending each to
        # the text so far would copy that text again for every match.
        let mut pieces: List[string] = []
        let last: usize = 0
        while advance(vm):
            pieces.push(text.slice(last, vm.start()))
            pieces.push(expand(template, vm.groups(self.names)))
            last = vm.end()
        pieces.push(text.slice(last, text.len()))
        pieces.join("")

    # The pieces of `text` around each match that `find_all` returns
    # (r-std-regex.split).
    ## The text's pieces between the matches, in order.
    ## See [std-regex.split](../../spec/std/regex.md#r-std-regex.split).
    pub fn split(self, text: string) -> List[string]:
        vm := new_vm(self, text, 2)
        let mut pieces: List[string] = []
        let last: usize = 0
        while advance(vm):
            pieces.push(text.slice(last, vm.start()))
            last = vm.end()
        pieces.push(text.slice(last, text.len()))
        pieces

    # Two slots per group, group 0 included.
    fn slot_count(self) -> usize:
        2 * self.names.len()

impl Captures:
    # The number of groups, plus one for the whole match
    # (r-std-regex.captures.len).
    ## The number of capture groups, the whole match included.
    ## See [std-regex.captures.len](../../spec/std/regex.md#r-std-regex.captures.len).
    pub fn len(self) -> usize:
        self.names.len()

    # Group `index`, or `.None` when it took no part
    # (r-std-regex.captures.get).
    ## The match of group `index`, or `.None` when it took no part or is out of range.
    ## See [std-regex.captures.get](../../spec/std/regex.md#r-std-regex.captures.get).
    pub fn get(self, index: usize) -> Match?:
        if index >= self.names.len():
            return .None
        match self.slots[2 * index]:
            .None => .None
            .Some(start) =>
                match self.slots[2 * index + 1]:
                    .None => .None
                    .Some(end) => .Some(Match { start: start, end: end, text: self.text.slice(start, end) })

    # The group named `name` (r-std-regex.captures.name).
    ## The match of the group named `name`, or `.None` when there is no such group or it took no part.
    ## See [std-regex.captures.name](../../spec/std/regex.md#r-std-regex.captures.name).
    pub fn name(self, name: string) -> Match?:
        if name == "":
            return .None
        let index: usize = 1
        while index < self.names.len():
            if self.names[index] == name:
                return self.get(index)
            index = index + 1
        .None

    ## Decodes this capture set as a record through its Deserialize implementation.
    ## See [std-regex.decode.captures](../../spec/std/regex.md#r-std-regex.decode.captures).
    pub fn decode[T < Deserialize](self) -> Result[T, RegexError]:
        let mut reader = CaptureReader { captures: self }
        T::deserialize(&mut reader)

# The format adapter for one capture set. The root is a record; each
# member positions the scalar reader at the named group's text.
struct CaptureReader:
    captures: Captures
    group: string = "0"
    current: Match? = .None
    record: bool = false
    variant: bool = false

impl CaptureReader:
    fn group_text(&mut self, expected: string) -> Result[string, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid(expected))
        match self.current:
            .Some(found) => .Ok(found.text)
            .None => .Err(.MissingGroup(self.group))

impl Deserializer for CaptureReader:
    type Error = RegexError

    fn peek(&mut self) -> Result[ValueKind, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid("record"))
        .Ok(if self.current.is_some(): .Text else: .Null)

    fn is_null(&mut self) -> Result[bool, RegexError]:
        if !self.record || self.group == "0":
            return .Err(self.invalid("record"))
        .Ok(self.current.is_none())

    fn bool(&mut self, expected: string) -> Result[bool, RegexError]:
        match self.group_text(expected)?.parse::[bool]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn int(&mut self, expected: string) -> Result[i64, RegexError]:
        match self.group_text(expected)?.parse::[i64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn uint(&mut self, expected: string) -> Result[u64, RegexError]:
        match self.group_text(expected)?.parse::[u64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn float(&mut self, expected: string) -> Result[f64, RegexError]:
        match self.group_text(expected)?.parse::[f64]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(self.invalid(expected))

    fn text(&mut self, expected: string) -> Result[string, RegexError]:
        self.group_text(expected)

    fn begin_list(&mut self) -> Result[void, RegexError]:
        .Err(self.invalid("list"))

    fn next_item(&mut self) -> Result[bool, RegexError]:
        .Err(self.invalid("list"))

    fn begin_map(&mut self) -> Result[void, RegexError]:
        .Err(self.invalid("map"))

    fn next_key(&mut self) -> Result[string?, RegexError]:
        .Err(self.invalid("map"))

    fn begin_variant(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, RegexError]:
        if !self.record:
            if choices.len() == 1 && choices[0].of_data:
                self.record = true
                return .Ok(0)
            return .Err(self.invalid("record"))
        if choices.len() == 1 && choices[0].of_data:
            return .Err(self.invalid("record"))
        name := self.group_text("variant")?
        let index = 0
        while index < choices.len():
            if choices[index].name == name:
                self.variant = true
                return .Ok(index)
            index += 1
        .Err(self.invalid("variant"))

    fn member(&mut self, m: Member) -> Result[void, RegexError]:
        if self.variant:
            return .Err(self.invalid("payload-free variant"))
        self.group = m.name
        let index = 1
        while index < self.captures.names.len():
            if self.captures.names[index] == m.name:
                self.current = self.captures.get(index)
                return .Ok(())
            index += 1
        .Err(.MissingGroup(m.name))

    fn end_variant(&mut self) -> Result[void, RegexError]:
        self.variant = false
        .Ok(())

    fn invalid(&mut self, expected: string) -> RegexError:
        .WrongType(self.group, expected)

# The most instructions a compiled pattern may have
# (r-std-regex.error.too-large).
fn max_program() -> usize:
    10000

# The most a counted repetition may count (r-std-regex.repeat.bad-count).
fn max_repeat() -> usize:
    1000

# A pattern split into its characters, with the byte offset of each and
# the pattern's length last.
struct Pattern:
    text: string
    chars: List[char]
    offsets: List[usize]

impl Pattern:
    fn of(text: string) -> Pattern:
        let mut chars: List[char] = []
        let mut offsets: List[usize] = []
        for (offset, c) in text.char_indices():
            chars.push(c)
            offsets.push(offset)
        offsets.push(text.len())
        Pattern { text: text, chars: chars, offsets: offsets }

    # The text from character `start` up to character `end`.
    fn piece(self, start: usize, end: usize) -> string:
        self.text.slice(self.offsets[start], self.offsets[end])

    fn at(self, index: usize) -> char?:
        if index < self.chars.len(): .Some(self.chars[index]) else: .None

    fn has(self, index: usize, c: char) -> bool:
        index < self.chars.len() && self.chars[index] == c

    fn offset(self, index: usize) -> usize:
        self.offsets[index]

# The syntax tree.
enum Node:
    Empty
    Literal(value: char)
    AnyChar
    Class(items: List[ClassItem], negated: bool)
    Begin
    End
    Group(body: &Node, index: usize)
    Concat(items: List[Node])
    Alternate(branches: List[Node])
    Repeat(body: &Node, min: usize, max: usize?, greedy: bool)

# One member of a bracketed class, or a whole `\d`, `\w`, or `\s` class.
enum ClassItem:
    Range(low: char, high: char)
    Digit(negated: bool)
    Word(negated: bool)
    Space(negated: bool)

# A parsed piece and the index of the character after it.
struct Step:
    node: Node
    next: usize

# `a|b|c`: one or more concatenations.
fn parse_alternation(source: Pattern, start: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    let mut branches: List[Node] = []
    let at = start
    while true:
        branch := parse_concat(source, at, names)?
        branches.push(branch.node)
        at = branch.next
        if source.has(at, '|'):
            at = at + 1
        else:
            break
    if branches.len() == 1:
        return .Ok(Step { node: branches[0], next: at })
    .Ok(Step { node: Node.Alternate(branches), next: at })

# A run of atoms, each with at most one quantifier, up to `|`, `)`, or the
# end.
fn parse_concat(source: Pattern, start: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    let mut items: List[Node] = []
    let at = start
    while at < source.chars.len():
        c := source.chars[at]
        if c == '|' || c == ')':
            break
        # A quantifier with no atom before it, including one right after
        # another quantifier (r-std-regex.repeat.nothing).
        if quantifier_at(source, at):
            return .Err(RegexError.NothingToRepeat(source.offset(at)))
        atom := parse_atom(source, at, names)?
        repeated := parse_repeat(source, atom)?
        items.push(repeated.node)
        at = repeated.next
    if items.len() == 0:
        return .Ok(Step { node: Node.Empty, next: at })
    if items.len() == 1:
        return .Ok(Step { node: items[0], next: at })
    .Ok(Step { node: Node.Concat(items), next: at })

fn quantifier_at(source: Pattern, at: usize) -> bool:
    match source.at(at):
        .Some(c) =>
            if c == '*' || c == '+' || c == '?':
                return true
            c == '{' && counts_at(source, at).is_some()
        .None => false

# The counts of a well-formed `{m}`, `{m,}`, or `{m,n}` at `at`. Any other
# `{` is a literal (r-std-regex.syntax.brace-literal).
struct Counts:
    min: usize
    max: usize?
    next: usize

fn counts_at(source: Pattern, start: usize) -> Counts?:
    if !source.has(start, '{'):
        return .None
    low := number_at(source, start + 1)?
    if low.next == start + 1:
        return .None
    match source.at(low.next):
        .Some('}') => .Some(Counts { min: low.value, max: .Some(low.value), next: low.next + 1 })
        .Some(',') =>
            high := number_at(source, low.next + 1)?
            if !source.has(high.next, '}'):
                return .None
            if high.next == low.next + 1:
                return .Some(Counts { min: low.value, max: .None, next: high.next + 1 })
            .Some(Counts { min: low.value, max: .Some(high.value), next: high.next + 1 })
        _ => .None

struct Number:
    value: usize
    next: usize

# A run of ASCII digits, held below 100000 so it cannot overflow.
fn number_at(source: Pattern, start: usize) -> Number?:
    let value: usize = 0
    let at = start
    while true:
        match source.at(at):
            .Some(c) =>
                if c < '0' || c > '9':
                    break
                if value < 100000:
                    value = value * 10 + (char_digit(c))
                at = at + 1
            .None => break
    .Some(Number { value: value, next: at })

fn char_digit(c: char) -> usize:
    let value: usize = 0
    for digit in "0123456789".chars():
        if digit == c:
            return value
        value = value + 1
    0

# A quantifier after `atom`, if one follows, with its lazy `?`.
fn parse_repeat(source: Pattern, atom: Step) -> Result[Step, RegexError]:
    at := atom.next
    let min: usize = 0
    let max: usize? = .None
    let next = at + 1
    match source.at(at):
        .Some('*') => pass
        .Some('+') => min = 1
        .Some('?') => max = .Some(1)
        .Some('{') =>
            counts := match counts_at(source, at):
                .Some(found) => found
                .None => return .Ok(atom)
            min = counts.min
            max = counts.max
            next = counts.next
            let bad = min > max_repeat()
            match max:
                .Some(high) =>
                    if high > max_repeat() || high < min:
                        bad = true
                .None => pass
            if bad:
                return .Err(RegexError.BadRepeat(source.offset(at)))
        _ => return .Ok(atom)
    let greedy = true
    if source.has(next, '?'):
        greedy = false
        next = next + 1
    .Ok(Step { node: Node.Repeat(&atom.node, min, max, greedy), next: next })

fn parse_atom(source: Pattern, at: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    c := source.chars[at]
    if c == '(':
        return parse_group(source, at, names)
    if c == '[':
        return parse_class(source, at)
    if c == '.':
        return .Ok(Step { node: Node.AnyChar, next: at + 1 })
    if c == '^':
        return .Ok(Step { node: Node.Begin, next: at + 1 })
    if c == '$':
        return .Ok(Step { node: Node.End, next: at + 1 })
    if c == '\\':
        escaped := parse_escape(source, at)?
        node := match escaped.item:
            .Some(item) => Node.Class([item], false)
            .None => Node.Literal(escaped.value)
        return .Ok(Step { node: node, next: at + 2 })
    .Ok(Step { node: Node.Literal(c), next: at + 1 })

# `( )`, `(?: )`, `(?P<name> )`, and `(?<name> )`; any other `(?` is an
# unsupported group (r-std-regex.syntax.group.unsupported). A capture group
# takes the next number when its `(` is read
# (r-std-regex.syntax.group.number).
fn parse_group(source: Pattern, open: usize, names: &mut List[string]) -> Result[Step, RegexError]:
    let start = open + 1
    let capturing = true
    let name = ""
    if source.has(start, '?'):
        let name_start: usize? = .None
        if source.has(start + 1, ':'):
            capturing = false
            start = start + 2
        else if source.has(start + 1, 'P') && source.has(start + 2, '<'):
            name_start = .Some(start + 3)
        else if source.has(start + 1, '<') && !source.has(start + 2, '=') && !source.has(start + 2, '!'):
            name_start = .Some(start + 2)
        else:
            return .Err(RegexError.UnsupportedGroup(source.offset(open)))
        match name_start:
            .None => pass
            .Some(name_at) =>
                let close = name_at
                while close < source.chars.len() && !source.has(close, '>'):
                    close = close + 1
                if close >= source.chars.len() || !group_name(source, name_at, close):
                    return .Err(RegexError.BadGroupName(source.offset(open)))
                name = source.piece(name_at, close)
                for taken in names:
                    if taken == name:
                        return .Err(RegexError.DuplicateGroupName(source.offset(open)))
                start = close + 1
    index := names.len()
    if capturing:
        names.push(name)
    inner := parse_alternation(source, start, names)?
    if !source.has(inner.next, ')'):
        return .Err(RegexError.MissingParen(source.offset(open)))
    if capturing:
        return .Ok(Step { node: Node.Group(&inner.node, index), next: inner.next + 1 })
    .Ok(Step { node: inner.node, next: inner.next + 1 })

# Whether characters `start` to `end` form a group name: an ASCII letter or
# `_`, then ASCII letters, digits, and `_` (r-std-regex.syntax.group.name).
fn group_name(source: Pattern, start: usize, end: usize) -> bool:
    if end <= start:
        return false
    first := source.chars[start]
    if first >= '0' && first <= '9':
        return false
    let at = start
    while at < end:
        if !word_char(source.chars[at]):
            return false
        at = at + 1
    true

# An escape: a Perl class item, or one character.
struct Escape:
    item: ClassItem?
    value: char

fn parse_escape(source: Pattern, at: usize) -> Result[Escape, RegexError]:
    match source.at(at + 1):
        .None => .Err(RegexError.BadEscape(source.offset(at)))
        .Some(e) =>
            if e == 'd' || e == 'D':
                return .Ok(Escape { item: .Some(ClassItem.Digit(e == 'D')), value: e })
            if e == 'w' || e == 'W':
                return .Ok(Escape { item: .Some(ClassItem.Word(e == 'W')), value: e })
            if e == 's' || e == 'S':
                return .Ok(Escape { item: .Some(ClassItem.Space(e == 'S')), value: e })
            if e == 'n':
                return .Ok(Escape { item: .None, value: '\n' })
            if e == 't':
                return .Ok(Escape { item: .None, value: '\t' })
            if e == 'r':
                return .Ok(Escape { item: .None, value: '\r' })
            if ascii_punctuation(e):
                return .Ok(Escape { item: .None, value: e })
            .Err(RegexError.BadEscape(source.offset(at)))

fn ascii_punctuation(c: char) -> bool:
    (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')

# `[...]` and `[^...]`. A `]` first is a literal (r-std-regex.syntax.class).
fn parse_class(source: Pattern, open: usize) -> Result[Step, RegexError]:
    let at = open + 1
    let negated = false
    if source.has(at, '^'):
        negated = true
        at = at + 1
    let mut items: List[ClassItem] = []
    let first = true
    while true:
        match source.at(at):
            .None => return .Err(RegexError.MissingBracket(source.offset(open)))
            .Some(c) =>
                if c == ']' && !first:
                    break
        first = false
        low := class_char(source, at)?
        match low.item:
            .Some(item) =>
                if source.has(low.next, '-') && source.at(low.next + 1).is_some() && !source.has(low.next + 1, ']'):
                    return .Err(RegexError.BadRange(source.offset(at)))
                items.push(item)
                at = low.next
            .None =>
                if source.has(low.next, '-') && source.at(low.next + 1).is_some() && !source.has(low.next + 1, ']'):
                    high := class_char(source, low.next + 1)?
                    if high.item.is_some() || high.value < low.value:
                        return .Err(RegexError.BadRange(source.offset(at)))
                    items.push(ClassItem.Range(low.value, high.value))
                    at = high.next
                else:
                    items.push(ClassItem.Range(low.value, low.value))
                    at = low.next
    .Ok(Step { node: Node.Class(items, negated), next: at + 1 })

struct ClassChar:
    item: ClassItem?
    value: char
    next: usize

fn class_char(source: Pattern, at: usize) -> Result[ClassChar, RegexError]:
    c := source.chars[at]
    if c == '\\':
        escaped := parse_escape(source, at)?
        return .Ok(ClassChar { item: escaped.item, value: escaped.value, next: at + 2 })
    .Ok(ClassChar { item: .None, value: c, next: at + 1 })

# The VM's instructions, as `compile` writes them; `lower` turns them into
# a `Program`. `Split` tries `first` before `second`. A character is its
# scalar value, and a class is a list of inclusive ranges of scalar values,
# low then high for each.
enum Inst:
    Char(point: i32)
    AnyChar
    Class(ranges: List[i32], negated: bool)
    Begin
    End
    Split(first: usize, second: usize)
    Jump(target: usize)
    Save(slot: usize)
    Done

# How many instructions `compile` emits for `node`, the written-out size
# (r-std-regex.time.size), held at
# max_program() + 1 so it cannot overflow.
fn program_size(node: Node) -> usize:
    match node:
        .Empty => 0
        .Group(body, _) => program_size(*body)
        .Concat(items) =>
            let total: usize = 0
            for item in items:
                total = capped(total + program_size(item))
            total
        .Alternate(branches) =>
            let total: usize = 0
            for branch in branches:
                total = capped(total + program_size(branch) + 2)
            total - 2
        .Repeat(body, min, max, _) =>
            size := program_size(*body)
            match max:
                .None =>
                    if min == 0:
                        return capped(size + 2)
                    capped(scaled(size, min) + 1)
                .Some(high) => capped(scaled(size, min) + scaled(size + 1, high - min))
        _ => 1

fn capped(size: usize) -> usize:
    if size > max_program(): max_program() + 1 else: size

fn scaled(size: usize, count: usize) -> usize:
    if count == 0:
        return 0
    if size > max_program() / count:
        return max_program() + 1
    size * count

fn compile(node: Node, program: &mut List[Inst]) -> void:
    match node:
        .Empty => pass
        .Literal(value) => program.push(Inst.Char(i32(char_scalar(value))))
        .AnyChar => program.push(Inst.AnyChar)
        .Class(items, negated) => program.push(Inst.Class(class_ranges(items), negated))
        .Begin => program.push(Inst.Begin)
        .End => program.push(Inst.End)
        .Group(body, index) =>
            program.push(Inst.Save(2 * index))
            compile(*body, program)
            program.push(Inst.Save(2 * index + 1))
        .Concat(items) =>
            for item in items:
                compile(item, program)
        .Alternate(branches) =>
            # split L1, next; L1: a; jump end; next: split L2, ... ; last
            let mut jumps: List[usize] = []
            let index: usize = 0
            while index < branches.len():
                if index + 1 < branches.len():
                    split := program.len()
                    program.push(Inst.Split(split + 1, 0))
                    compile(branches[index], program)
                    jumps.push(program.len())
                    program.push(Inst.Jump(0))
                    program[split] = Inst.Split(split + 1, program.len())
                else:
                    compile(branches[index], program)
                index = index + 1
            for jump in jumps:
                program[jump] = Inst.Jump(program.len())
        .Repeat(body, min, max, greedy) =>
            let copies: usize = 0
            match max:
                .None =>
                    if min == 0:
                        # loop: split body, out; body; jump loop
                        loop_start := program.len()
                        program.push(Inst.Split(0, 0))
                        compile(*body, program)
                        program.push(Inst.Jump(loop_start))
                        program[loop_start] = choice(loop_start + 1, program.len(), greedy)
                    else:
                        while copies < min - 1:
                            compile(*body, program)
                            copies = copies + 1
                        # last: body; split last, out
                        last := program.len()
                        compile(*body, program)
                        program.push(choice(last, program.len() + 1, greedy))
                .Some(high) =>
                    while copies < min:
                        compile(*body, program)
                        copies = copies + 1
                    # each optional copy: split body, out
                    let mut splits: List[usize] = []
                    while copies < high:
                        splits.push(program.len())
                        program.push(Inst.Split(0, 0))
                        compile(*body, program)
                        copies = copies + 1
                    for split in splits:
                        program[split] = choice(split + 1, program.len(), greedy)

# The instructions as parallel lists that the VM reads by index, so a step
# compares integers instead of matching a variant. `ops[pc]` is the kind:
#
# | op | instruction | `left[pc]` | `right[pc]` |
# | -- | ----------- | ---------- | ----------- |
# | 0 | `Char`, scalar value in `points[pc]` | - | - |
# | 1 | `AnyChar` | - | - |
# | 2 | `Class` | start of its ranges in `ranges` | end of them |
# | 3 | negated `Class` | start of its ranges in `ranges` | end of them |
# | 4 | `Done` | - | - |
# | 5 | `Split` | first | second |
# | 6 | `Jump` | target | - |
# | 7 | `Save` | slot | - |
# | 8 | `Begin` | - | - |
# | 9 | `End` | - | - |
#
# Ops 0 to 4 are the ones a thread waits at for the next character.
struct Program:
    ops: List[i32]
    left: List[usize]
    right: List[usize]
    points: List[i32]
    ranges: List[i32]

fn lower(program: List[Inst]) -> Program:
    let mut ops: List[i32] = []
    let mut left: List[usize] = []
    let mut right: List[usize] = []
    let mut points: List[i32] = []
    let mut ranges: List[i32] = []
    for inst in program:
        let op = +0
        let first: usize = 0
        let second: usize = 0
        let point = +0
        match inst:
            .Char(value) => point = value
            .AnyChar => op = +1
            .Class(bounds, negated) =>
                op = if negated: +3 else: +2
                first = ranges.len()
                for bound in bounds:
                    ranges.push(bound)
                second = ranges.len()
            .Done => op = +4
            .Split(a, b) =>
                op = +5
                first = a
                second = b
            .Jump(target) =>
                op = +6
                first = target
            .Save(slot) =>
                op = +7
                first = slot
            .Begin => op = +8
            .End => op = +9
        ops.push(op)
        left.push(first)
        right.push(second)
        points.push(point)
    Program { ops: ops, left: left, right: right, points: points, ranges: ranges }

# A split that prefers `body` when greedy and `out` when lazy.
fn choice(body: usize, out: usize, greedy: bool) -> Inst:
    if greedy: Inst.Split(body, out) else: Inst.Split(out, body)

# The prefilter, as RE2 and Rust's `regex` use literal prefilters. Every
# match that starts at byte s holds `literal` at a byte from s + `lo` up
# to s + `hi` (`hi` -1 when there is no bound), unless `literal` is "".
# `firsts` is the set of bytes a match can start with, 256 bits in four
# words, or empty when it would skip too little. A search starts threads
# only where both allow a match to start. That leaves the matches as they
# were: a thread that starts elsewhere never reaches `Done`, and a thread
# that never reaches `Done` changes no other thread's result.
struct Prefilter:
    literal: string
    lo: usize
    hi: i64
    firsts: List[u64]

# What every match of a piece of the tree has, in bytes: at least `min`
# and at most `max` of them (`max` -1 for no bound); `exact`, its text when
# it can match no other; `prefix`, the text it starts with; `literal`, a
# text it holds from `lo` up to `hi` bytes after its start (`hi` -1 for no
# bound), or ""; and `firsts`, the first bytes of its nonempty matches.
# Each claim holds of every match, so a piece that never matches may
# claim anything.
struct Summary:
    min: i64
    max: i64
    exact: string?
    prefix: string
    literal: string
    lo: i64
    hi: i64
    firsts: List[u64]

fn prefilter(node: Node) -> Prefilter:
    summary := summarize(node)
    if summary.min == 0:
        # An empty match holds no literal and has no first byte.
        return Prefilter { literal: "", lo: 0, hi: 0, firsts: [] }
    let firsts: List[u64] = summary.firsts
    if count_bits(firsts) >= 128:
        # A set this full skips too little to pay for testing each byte.
        firsts = []
    Prefilter { literal: summary.literal, lo: usize(summary.lo), hi: summary.hi, firsts: firsts }

fn summarize(node: Node) -> Summary:
    match node:
        .Empty => exact_summary("", no_bytes())
        .Begin => exact_summary("", no_bytes())
        .End => exact_summary("", no_bytes())
        .Literal(value) =>
            text := "$value"
            lead := i32(bytes_at(text, 0))
            let mut firsts: List[u64] = no_bytes()
            add_bytes(&mut firsts, lead, lead)
            exact_summary(text, firsts)
        .AnyChar =>
            # Any scalar but a newline.
            let mut firsts: List[u64] = no_bytes()
            add_bytes(&mut firsts, 0, 9)
            add_bytes(&mut firsts, 11, 127)
            add_bytes(&mut firsts, 192, 255)
            open_summary(1, 4, firsts)
        .Class(items, negated) => class_summary(class_ranges(items), negated)
        .Group(body, _) => summarize(*body)
        .Concat(items) => concat_summary(items)
        .Alternate(branches) => alternate_summary(branches)
        .Repeat(body, min, max, _) => repeat_summary(summarize(*body), min, max)

fn exact_summary(text: string, firsts: List[u64]) -> Summary:
    size := i64(bytes_len(text))
    Summary { min: size, max: size, exact: .Some(text), prefix: text, literal: text, lo: 0, hi: 0, firsts: firsts }

fn open_summary(min: i64, max: i64, firsts: List[u64]) -> Summary:
    Summary { min: min, max: max, exact: .None, prefix: "", literal: "", lo: 0, hi: 0, firsts: firsts }

# A class's first bytes are the UTF-8 first bytes of the scalars in its
# ranges. For a negated class they are every first byte but the ASCII
# ones the ranges name, which is all its non-ASCII first bytes and some
# more.
fn class_summary(ranges: List[i32], negated: bool) -> Summary:
    let mut firsts: List[u64] = no_bytes()
    if negated:
        let byte = +0
        while byte < 128:
            if !in_class(ranges, byte):
                add_bytes(&mut firsts, byte, byte)
            byte = byte + 1
        add_bytes(&mut firsts, 192, 255)
        return open_summary(1, 4, firsts)
    let min: i64 = 4
    let max: i64 = 1
    let index: usize = 0
    while index < ranges.len():
        low := ranges[index]
        high := ranges[index + 1]
        if scalar_bytes(low) < min:
            min = scalar_bytes(low)
        if scalar_bytes(high) > max:
            max = scalar_bytes(high)
        if low < 128:
            add_bytes(&mut firsts, low, if high < 127: high else: +127)
        add_leads(&mut firsts, low, high, 128, 2047, 64, 192)
        add_leads(&mut firsts, low, high, 2048, 65535, 4096, 224)
        add_leads(&mut firsts, low, high, 65536, 1114111, 262144, 240)
        index = index + 2
    open_summary(min, max, firsts)

fn in_class(ranges: List[i32], point: i32) -> bool:
    let index: usize = 0
    while index < ranges.len():
        if point >= ranges[index] && point <= ranges[index + 1]:
            return true
        index = index + 2
    false

# The first bytes of the scalars from `low` to `high` that UTF-8 writes
# with the same length, those from `first` to `last`: `base` plus the
# scalar divided by `unit`.
fn add_leads(set: &mut List[u64], low: i32, high: i32, first: i32, last: i32, unit: i32, base: i32) -> void:
    from := if low > first: low else: first
    to := if high < last: high else: last
    if from <= to:
        add_bytes(set, base + from / unit, base + to / unit)

# The length of a scalar's UTF-8 form.
fn scalar_bytes(point: i32) -> i64:
    if point < 128:
        return 1
    if point < 2048:
        return 2
    if point < 65536: 3 else: 4

# Items in sequence: the starts of the items after the first come later by
# the lengths before them; a run of exact items and the prefix of the item
# after it form one literal.
fn concat_summary(items: List[Node]) -> Summary:
    let min: i64 = 0
    let max: i64 = 0
    let literal = ""
    let lo: i64 = 0
    let hi: i64 = 0
    let mut run: List[string] = []
    let run_lo: i64 = 0
    let run_hi: i64 = 0
    let mut head: List[string] = []
    let open = true
    let exact = true
    let firsts: List[u64] = no_bytes()
    for item in items:
        summary := summarize(item)
        if min == 0:
            firsts = union(firsts, summary.firsts)
        if summary.literal != "" && prefer(summary.literal, plus(max, summary.hi), literal, hi):
            literal = summary.literal
            lo = min + summary.lo
            hi = plus(max, summary.hi)
        match summary.exact:
            .Some(text) =>
                run.push(text)
                if open:
                    head.push(text)
            .None =>
                exact = false
                run.push(summary.prefix)
                joined := run.join("")
                if prefer(joined, run_hi, literal, hi):
                    literal = joined
                    lo = run_lo
                    hi = run_hi
                if open:
                    head.push(summary.prefix)
                    open = false
                run = []
                run_lo = min + summary.min
                run_hi = plus(max, summary.max)
        min = min + summary.min
        max = plus(max, summary.max)
    joined := run.join("")
    if prefer(joined, run_hi, literal, hi):
        literal = joined
        lo = run_lo
        hi = run_hi
    prefix := head.join("")
    let whole: string? = if exact: .Some(prefix) else: .None
    Summary { min: min, max: max, exact: whole, prefix: prefix, literal: literal, lo: lo, hi: hi, firsts: firsts }

# Alternatives: a literal is required only when every alternative holds
# it, and the alternatives' common prefix is one too.
fn alternate_summary(branches: List[Node]) -> Summary:
    first := summarize(branches[0])
    let min = first.min
    let max = first.max
    let exact = first.exact
    let prefix = first.prefix
    let literal = first.literal
    let lo = first.lo
    let hi = first.hi
    let firsts = first.firsts
    let index: usize = 1
    while index < branches.len():
        other := summarize(branches[index])
        if other.min < min:
            min = other.min
        max = if max < 0 || other.max < 0: -1 else if other.max > max: other.max else: max
        exact = same_text(exact, other.exact)
        prefix = common_prefix(prefix, other.prefix)
        if literal != "" && literal == other.literal:
            if other.lo < lo:
                lo = other.lo
            hi = if hi < 0 || other.hi < 0: -1 else if other.hi > hi: other.hi else: hi
        else:
            literal = ""
        firsts = union(firsts, other.firsts)
        index = index + 1
    if prefer(prefix, 0, literal, hi):
        literal = prefix
        lo = 0
        hi = 0
    Summary { min: min, max: max, exact: exact, prefix: prefix, literal: literal, lo: lo, hi: hi, firsts: firsts }

fn same_text(left: string?, right: string?) -> string?:
    match left:
        .Some(a) =>
            match right:
                .Some(b) => if a == b: .Some(a) else: .None
                .None => .None
        .None => .None

# The longest common prefix that ends at a scalar boundary.
fn common_prefix(left: string, right: string) -> string:
    let size: usize = 0
    while size < bytes_len(left) && size < bytes_len(right) && bytes_at(left, size) == bytes_at(right, size):
        size = size + 1
    while size > 0 && size < bytes_len(left) && continuation(bytes_at(left, size)):
        size = size - 1
    bytes_slice(left, 0, size)

# A repetition: with at least one copy, the first copy's literal at the
# start, or all the required copies of an exact body.
fn repeat_summary(body: Summary, min: usize, max: usize?) -> Summary:
    low := body.min * i64(min)
    let high: i64 = -1
    match max:
        .Some(count) =>
            if count == 0 || body.max == 0:
                high = 0
            else if body.max > 0:
                high = body.max * i64(count)
        .None =>
            if body.max == 0:
                high = 0
    if min == 0:
        return open_summary(low, high, body.firsts)
    match body.exact:
        .Some(text) =>
            whole := text.repeat(min)
            let exact: string? = .None
            match max:
                .Some(count) =>
                    if count == min:
                        exact = .Some(whole)
                .None => pass
            Summary { min: low, max: high, exact: exact, prefix: whole, literal: whole, lo: 0, hi: 0, firsts: body.firsts }
        .None => Summary { min: low, max: high, exact: .None, prefix: body.prefix, literal: body.literal, lo: body.lo, hi: body.hi, firsts: body.firsts }

# Whether `literal`, within `hi` bytes of a match's start, makes a better
# prefilter than `best` within `best_hi`: a bounded place first, since it
# lets a search jump, then the longer.
fn prefer(literal: string, hi: i64, best: string, best_hi: i64) -> bool:
    if literal == "":
        return false
    if best == "":
        return true
    if (hi >= 0) != (best_hi >= 0):
        return hi >= 0
    bytes_len(literal) > bytes_len(best)

# A sum of lengths, -1 when either has no bound.
fn plus(left: i64, right: i64) -> i64:
    if left < 0 || right < 0: -1 else: left + right

fn no_bytes() -> List[u64]:
    [u64(0), u64(0), u64(0), u64(0)]

fn add_bytes(set: &mut List[u64], low: i32, high: i32) -> void:
    let byte = low
    while byte <= high:
        word := usize(byte / 64)
        set[word] = set[word] | (u64(1) << u64(byte % 64))
        byte = byte + 1

fn union(left: List[u64], right: List[u64]) -> List[u64]:
    [left[0] | right[0], left[1] | right[1], left[2] | right[2], left[3] | right[3]]

fn count_bits(set: List[u64]) -> u32:
    let total: u32 = 0
    for word in set:
        total = total + word.count_ones()
    total

fn continuation(byte: u8) -> bool:
    byte >= 128 && byte < 192

# The two thread lists of a search: the instructions reached at one text
# position, as sparse sets (Briggs and Torczon, as RE2 uses them) that keep
# them in the order they were added, so clearing one and testing or adding
# a member each take constant time. Both lists share `dense`, `sparse`, and
# `slots`: the list at `side` 0 uses the first `width` entries and the one
# at `side` `width` the rest, so trading the two lists at each step trades
# two numbers. A list's length is a local of the search. `slots` holds
# `slot_count` slots for each instruction, as byte offsets with -1 for an
# unset slot.
fn has(dense: &List[usize], sparse: &List[usize], side: usize, count: usize, pc: usize) -> bool:
    place := sparse[side + pc]
    place < count && dense[side + place] == pc

fn filled(count: usize) -> List[i64]:
    let mut values: List[i64] = []
    while values.len() < count:
        values.push(-1)
    values

fn zeros(count: usize) -> List[usize]:
    let mut values: List[usize] = []
    while values.len() < count:
        values.push(0)
    values

# The state of the searches of one call: the thread lists, the stack of
# the epsilon walk, and the slots, allocated once and reused by every
# search that call makes. The lists a search writes are new objects that
# the VM holds by reference, so a search reads them into locals once and
# writes their elements in place. The text is read in place, one UTF-8
# scalar at a time, and every position is a byte offset
# (r-std-regex.find.chars).
struct Vm:
    program: Program
    text: string
    size: usize
    slot_count: usize
    dense: &mut List[usize]
    sparse: &mut List[usize]
    slots: &mut List[i64]
    # The epsilon walk's stack: an entry of at least 0 is an instruction to
    # visit; an entry -1 - s puts `values` at the same place back into slot s.
    stack: &mut List[i64]
    values: &mut List[i64]
    scratch: &mut List[i64]
    # The slots of the match the last search found.
    found: &mut List[i64]
    # Where the next search of `advance` starts, where the last match
    # ended (-1 before the first), and whether the series is over.
    from: usize
    last_end: i64
    finished: bool
    # The prefilter, whether it has anything to skip with, and the last
    # search for its literal: the first one at or after byte `hit_from` is
    # at byte `hit`, or there is none when `hit` is -1. The literal lets a
    # match start at the bytes from `near_from` to `near_until`.
    filter: Prefilter
    filtered: bool
    hit_from: usize
    hit: i64
    near_from: i64
    near_until: i64

# A walk visits each instruction at most once and pushes at most one
# entry for it, so the stack never holds more than width + 1.
fn new_vm(regex: Regex, text: string, slot_count: usize) -> &mut Vm:
    program := regex.program
    filter := regex.filter
    width := program.ops.len()
    &mut Vm {
        program: program,
        text: text,
        size: bytes_len(text),
        slot_count: slot_count,
        dense: &mut zeros(2 * width),
        sparse: &mut zeros(2 * width),
        slots: &mut filled(2 * width * slot_count),
        stack: &mut filled(width + 1),
        values: &mut filled(width + 1),
        scratch: &mut filled(slot_count),
        found: &mut filled(slot_count),
        from: 0,
        last_end: -1,
        finished: false,
        filter: filter,
        filtered: bytes_len(filter.literal) > 0 || filter.firsts.len() > 0,
        hit_from: bytes_len(text) + 1,
        hit: -1,
        near_from: 0,
        near_until: -1,
    }

impl Vm:
    # Where the match found starts and ends; it always has both.
    fn start(&self) -> usize:
        usize(self.found[0])

    fn end(&self) -> usize:
        usize(self.found[1])

    fn whole(&self) -> Match:
        from := self.start()
        to := self.end()
        Match { start: from, end: to, text: bytes_slice(self.text, from, to) }

    # The groups of the match found.
    fn groups(&self, names: List[string]) -> Captures:
        let mut slots: List[usize?] = []
        for value in self.found:
            if value < 0:
                slots.push(.None)
            else:
                slots.push(.Some(usize(value)))
        Captures { text: self.text, slots: slots, names: names }

# Runs the next search of a `find_all` series (r-std-regex.find-all.next)
# and leaves the match to report in `found`: after a match the next search
# starts at its end, or one character later when it is empty, and an empty
# match where the last one ended is dropped. False when no match is left.
fn advance(vm: &mut Vm) -> bool:
    while !vm.finished:
        if !run(vm, vm.from, false):
            vm.finished = true
            return false
        start := vm.start()
        end := vm.end()
        if start != end:
            vm.from = end
            vm.last_end = i64(end)
            return true
        repeated := vm.last_end == i64(start)
        vm.last_end = i64(end)
        if end == vm.size:
            vm.finished = true
        else:
            vm.from = end + scalar_width(bytes_at(vm.text, end))
        if !repeated:
            return true
    false

# The Pike VM (r-std-regex.find.leftmost-first): threads in priority
# order, at most one per instruction at each position, starting at byte
# `from`. When it finds a match, it returns true with the match's slots in
# `vm.found`, slot 0 its start and slot 1 its end. With `earliest`, as
# `is_match` asks, it returns true as soon as any thread reaches `Done`.
# A new thread starts only where the prefilter lets a match start, and
# when no thread is alive the search jumps to the next such byte.
fn run(vm: &mut Vm, from: usize, earliest: bool) -> bool:
    program := &vm.program
    ops := program.ops
    points := program.points
    ranges := program.ranges
    left := program.left
    right := program.right
    text := vm.text
    size := vm.size
    slot_count := vm.slot_count
    done := ops.len() - 1
    dense := vm.dense
    sparse := vm.sparse
    slots := vm.slots
    scratch := vm.scratch
    found := vm.found
    filtered := vm.filtered
    # The sides of the current and the next thread list, and the length of
    # the current one.
    let current: usize = 0
    let next: usize = ops.len()
    let count: usize = 0
    let at = from
    if filtered:
        start := next_start(vm, from)
        if start < 0:
            return false
        at = usize(start)
    restart(scratch, slot_count, at)
    count = add_thread(vm, program, current, 0, 0, at)
    if earliest && has(dense, sparse, current, count, done):
        return true
    let matched = false
    while true:
        let next_count: usize = 0
        let point: i32 = -1
        let after = at
        if at < size:
            lead := bytes_at(text, at)
            if lead < 128:
                point = i32(lead)
                after = at + 1
            else:
                after = at + scalar_width(lead)
                point = scalar_point(text, at, after, lead)
        let index: usize = 0
        while index < count:
            pc := dense[current + index]
            index = index + 1
            op := ops[pc]
            let step = false
            if op == 0:
                step = point == points[pc]
            else if op == 1:
                step = point >= 0 && point != 10
            else if op == 4:
                # A finished thread cuts off every thread it outranks.
                let slot: usize = 0
                base := (current + pc) * slot_count
                while slot < slot_count:
                    found[slot] = slots[base + slot]
                    slot = slot + 1
                if slot_count > 1:
                    found[1] = i64(at)
                matched = true
                break
            else if op <= 3 && point >= 0:
                let hit = false
                let bound = left[pc]
                end := right[pc]
                while bound < end:
                    if point >= ranges[bound] && point <= ranges[bound + 1]:
                        hit = true
                        break
                    bound = bound + 2
                step = hit != (op == 3)
            if step:
                let slot: usize = 0
                base := (current + pc) * slot_count
                while slot < slot_count:
                    scratch[slot] = slots[base + slot]
                    slot = slot + 1
                next_count = add_thread(vm, program, next, next_count, pc + 1, after)
                if earliest && has(dense, sparse, next, next_count, done):
                    return true
        if at >= size:
            break
        at = after
        if !matched:
            let seed = i64(at)
            if filtered:
                seed = start_from(vm, at, next_count > 0)
            if seed >= 0:
                at = usize(seed)
                restart(scratch, slot_count, at)
                next_count = add_thread(vm, program, next, next_count, 0, at)
                if earliest && has(dense, sparse, next, next_count, done):
                    return true
            else if next_count == 0:
                break
        else if next_count == 0:
            break
        held := current
        current = next
        next = held
        count = next_count
    matched

# The first byte at or after `at` where the prefilter lets a match start,
# or -1 when none can start there or later. `firsts` holds no UTF-8
# continuation byte, and a literal starts at a scalar boundary, so every
# byte this returns starts a scalar.
fn next_start(vm: &mut Vm, at: usize) -> i64:
    filter := vm.filter
    text := vm.text
    size := vm.size
    width := bytes_len(filter.literal)
    firsts := filter.firsts
    let position = at
    while true:
        if width > 0 && !literal_near(vm, position):
            if position + filter.lo + width > size || vm.hit < 0:
                return -1
            # The next literal is more than `hi` bytes ahead, and a match
            # starts at most that far before it: go there, backed up to
            # the first byte of a scalar.
            let earliest = usize(vm.hit) - usize(filter.hi)
            while continuation(bytes_at(text, earliest)):
                earliest = earliest - 1
            position = earliest
        if firsts.len() == 0:
            return i64(position)
        let next = position
        while next < size:
            byte := bytes_at(text, next)
            if (firsts[usize(byte / 64)] >> u64(byte % 64)) & 1 != 0:
                break
            next = next + 1
        if next >= size:
            return -1
        if next == position || width == 0:
            return i64(next)
        # Past a first byte the literal may now be too far ahead.
        position = next

# Where the search starts its next thread, at byte `at` or later, or -1
# for nowhere. While threads are `alive` it cannot jump over them, so that
# is `at` itself when the prefilter lets a match start there.
fn start_from(vm: &mut Vm, at: usize, alive: bool) -> i64:
    if !alive:
        return next_start(vm, at)
    firsts := vm.filter.firsts
    if firsts.len() > 0:
        if at >= vm.size:
            return -1
        byte := bytes_at(vm.text, at)
        if (firsts[usize(byte / 64)] >> u64(byte % 64)) & 1 == 0:
            return -1
    # A literal with no bound on its place is tested only where the
    # search jumps: testing it at every byte costs more than the threads
    # it saves.
    if vm.filter.hi >= 0 && bytes_len(vm.filter.literal) > 0 && !literal_near(vm, at):
        return -1
    i64(at)

# Whether the prefilter's literal is close enough after byte `at` for a
# match to start there, or may be. Each literal found marks the bytes it
# is close enough to, so most calls need no search. A literal with no
# bound on its place only rejects a text with none ahead: once one is
# found, every byte may start a match, since searching again past each
# one would cost a search per match and could never make the search jump.
fn literal_near(vm: &mut Vm, at: usize) -> bool:
    if i64(at) >= vm.near_from && i64(at) <= vm.near_until:
        return true
    want := at + vm.filter.lo
    if want + bytes_len(vm.filter.literal) > vm.size:
        return false
    if vm.hit_from > want || (vm.hit >= 0 && usize(vm.hit) < want):
        vm.hit_from = want
        vm.hit = find_literal(vm.text, vm.filter.literal, want)
        if vm.hit >= 0:
            if vm.filter.hi < 0:
                vm.near_from = i64(at)
                vm.near_until = i64(vm.size)
            else:
                vm.near_from = vm.hit - vm.filter.hi
                vm.near_until = vm.hit - i64(vm.filter.lo)
    vm.hit >= 0 && (vm.filter.hi < 0 || usize(vm.hit) <= at + usize(vm.filter.hi))

# The first `literal` at or after byte `from`, or -1. A longer literal
# goes to std.text's Two-Way search through `find` on the text from `from`,
# a slice that shares the bytes, unless it is right at `from`. A one-byte
# literal is a plain byte scan, which is what that search does for one
# byte. Both shortcuts save building the searcher on each call.
fn find_literal(text: string, literal: string, from: usize) -> i64:
    size := bytes_len(text)
    width := bytes_len(literal)
    if width == 1:
        byte := bytes_at(literal, 0)
        let at = from
        while at < size:
            if bytes_at(text, at) == byte:
                return i64(at)
            at = at + 1
        return -1
    let index: usize = 0
    while index < width && from + index < size && bytes_at(text, from + index) == bytes_at(literal, index):
        index = index + 1
    if index == width:
        return i64(from)
    match bytes_slice(text, from, size).find(literal):
        .Some(offset) => i64(from + offset)
        .None => -1

# Sets the scratch slots for a thread that starts at byte `at`.
fn restart(scratch: &mut List[i64], slot_count: usize, at: usize) -> void:
    if slot_count == 0:
        return
    scratch[0] = i64(at)
    let slot: usize = 1
    while slot < slot_count:
        scratch[slot] = -1
        slot = slot + 1

# The byte length of the UTF-8 scalar whose first byte is `lead`.
fn scalar_width(lead: u8) -> usize:
    if lead < 128:
        return 1
    if lead < 224:
        return 2
    if lead < 240: 3 else: 4

# The code point of the scalar from byte `at` up to `after`, whose first
# byte is `lead`, at least 128.
fn scalar_point(text: string, at: usize, after: usize, lead: u8) -> i32:
    let point = i32(lead)
    if lead < 224:
        point = point - 192
    else if lead < 240:
        point = point - 224
    else:
        point = point - 240
    let index = at + 1
    while index < after:
        point = point * 64 + i32(bytes_at(text, index)) - 128
        index = index + 1
    point

# Adds the thread at `start`, with the slots in `vm.scratch`, to the list
# at `side`, which holds `count` threads, following jumps, splits, saves,
# and assertions in priority order at byte `at`, and returns the list's new
# length. An instruction already in the list is not visited again. A save
# sets its slot for the instructions after it and puts the old value back
# after them, so `vm.scratch` is unchanged on return.
fn add_thread(vm: &mut Vm, program: &Program, side: usize, count: usize, start: usize, at: usize) -> usize:
    ops := program.ops
    slot_count := vm.slot_count
    dense := vm.dense
    sparse := vm.sparse
    slots := vm.slots
    scratch := vm.scratch
    if ops[start] <= 4:
        # A thread that waits for a character, the common case, needs no
        # walk.
        if has(dense, sparse, side, count, start):
            return count
        sparse[side + start] = count
        dense[side + count] = start
        base := (side + start) * slot_count
        let slot: usize = 0
        while slot < slot_count:
            slots[base + slot] = scratch[slot]
            slot = slot + 1
        return count + 1
    left := program.left
    right := program.right
    size := vm.size
    stack := vm.stack
    values := vm.values
    let length = count
    stack[0] = i64(start)
    let top: usize = 1
    while top > 0:
        top = top - 1
        entry := stack[top]
        if entry < 0:
            scratch[usize(-1 - entry)] = values[top]
            continue
        # Follow the first choice at each step in place; the stack holds
        # only the second choices and the slots to put back.
        let pc = usize(entry)
        while true:
            place := sparse[side + pc]
            if place < length && dense[side + place] == pc:
                break
            sparse[side + pc] = length
            dense[side + length] = pc
            length = length + 1
            op := ops[pc]
            if op <= 4:
                base := (side + pc) * slot_count
                let slot: usize = 0
                while slot < slot_count:
                    slots[base + slot] = scratch[slot]
                    slot = slot + 1
                break
            if op == 5:
                stack[top] = i64(right[pc])
                top = top + 1
                pc = left[pc]
            else if op == 6:
                pc = left[pc]
            else if op == 7:
                slot := left[pc]
                if slot < slot_count:
                    stack[top] = -1 - i64(slot)
                    values[top] = scratch[slot]
                    top = top + 1
                    scratch[slot] = i64(at)
                pc = pc + 1
            else if op == 8:
                if at != 0:
                    break
                pc = pc + 1
            else:
                if at != size:
                    break
                pc = pc + 1
    length

# A reference in a replacement (r-std-regex.replace.expand).
enum Reference:
    Dollar
    Index(value: usize)
    Name(value: string)

struct Found:
    reference: Reference
    next: usize

# The reference that the `$` at `at` starts, if any; any other `$` is
# itself (r-std-regex.replace.literal).
fn reference_at(template: Pattern, at: usize) -> Found?:
    match template.at(at + 1):
        .Some('$') => .Some(Found { reference: Reference.Dollar, next: at + 2 })
        .Some('{') =>
            let close = at + 2
            while close < template.chars.len() && !template.has(close, '}'):
                close = close + 1
            if close >= template.chars.len():
                return .None
            digits := number_at(template, at + 2)?
            if digits.next == close && close > at + 2:
                return .Some(Found { reference: Reference.Index(digits.value), next: close + 1 })
            if group_name(template, at + 2, close):
                return .Some(Found { reference: Reference.Name(template.piece(at + 2, close)), next: close + 1 })
            .None
        _ =>
            digits := number_at(template, at + 1)?
            if digits.next == at + 1:
                return .None
            .Some(Found { reference: Reference.Index(digits.value), next: digits.next })

# `template` with each reference replaced by the text it names
# (r-std-regex.replace.expand). Join pieces once instead of repeatedly
# copying the already-expanded prefix for each reference.
fn expand(template: Pattern, groups: Captures) -> string:
    let mut pieces: List[string] = []
    let literal: usize = 0
    let at: usize = 0
    while at < template.chars.len():
        if !template.has(at, '$'):
            at = at + 1
            continue
        match reference_at(template, at):
            .None => at = at + 1
            .Some(found) =>
                if literal < at:
                    pieces.push(template.piece(literal, at))
                pieces.push(reference_text(found.reference, groups))
                at = found.next
                literal = at
    if literal < template.chars.len():
        pieces.push(template.piece(literal, template.chars.len()))
    pieces.join("")

fn reference_text(reference: Reference, groups: Captures) -> string:
    match reference:
        .Dollar => "\$"
        .Index(value) => group_text(groups.get(value))
        .Name(value) => group_text(groups.name(value))

fn group_text(group: Match?) -> string:
    match group:
        .Some(found) => found.text
        .None => ""

# The ranges of scalar values a class's items match. `\d` and `\w` are
# ASCII; `\s` is Unicode White_Space (r-std-regex.syntax.escape.digit,
# r-std-regex.syntax.escape.space).
fn class_ranges(items: List[ClassItem]) -> List[i32]:
    let mut ranges: List[i32] = []
    for item in items:
        match item:
            .Range(low, high) =>
                ranges.push(i32(char_scalar(low)))
                ranges.push(i32(char_scalar(high)))
            .Digit(negated) => push_ranges(&mut ranges, [+48, +57], negated)
            .Word(negated) => push_ranges(&mut ranges, [+48, +57, +65, +90, +95, +95, +97, +122], negated)
            .Space(negated) => push_ranges(&mut ranges, [+9, +13, +32, +32, +133, +133, +160, +160, +5760, +5760, +8192, +8202, +8232, +8233, +8239, +8239, +8287, +8287, +12288, +12288], negated)
    ranges

# Pushes the sorted ranges `set`, or, when `negated`, the ranges between
# them up to the largest scalar value.
fn push_ranges(ranges: &mut List[i32], set: List[i32], negated: bool) -> void:
    if !negated:
        for bound in set:
            ranges.push(bound)
        return
    let low = +0
    let index: usize = 0
    while index < set.len():
        if set[index] > low:
            ranges.push(low)
            ranges.push(set[index] - 1)
        low = set[index + 1] + 1
        index = index + 2
    ranges.push(low)
    ranges.push(+1114111)

fn word_char(c: char) -> bool:
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

# `Debug` for this module's types (r-std-format.debug.std-types), written by
# hand with the builder calls that `@derive(Debug)` generates.

# Keep handwritten Debug: show the pattern text and hide compiled instructions.
impl Debug for Regex:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("Regex").field("pattern", self.text).finish()

# Primitives (spec/std/README.md#standard-library-primitives). The compiler
# supplies each body. `@intrinsic` is prototype-internal and accepted only
# in lib/std.

@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

# The bytes from offset `start` up to `end`, sharing them in constant time.
@intrinsic("bytes_slice")
fn bytes_slice(text: string, start: usize, end: usize) -> string:
    panic("intrinsic")

# A `char` is its scalar value at run time.
@intrinsic("char_scalar")
fn char_scalar(value: char) -> u32:
    panic("intrinsic")
