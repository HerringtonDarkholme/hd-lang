# std.regex: regular expressions in the RE2 subset (spec/std/regex.md).
# `Regex::new` parses a pattern into a tree and compiles the tree into a
# program for a Pike VM. The VM runs every thread in step over the text and
# keeps at most one thread per instruction, so a search takes time
# proportional to the program size times the text length, with no
# backtracking (r-std-regex.time.linear). The prototype's std loader does
# not list this module yet (src/checker/standard-sources.ts).
use std.format.DebugWriter
use std.error.Error

# A compiled pattern (r-std-regex.regex.decl). `names[i]` is the name of
# group i, or "" for an unnamed group and for group 0.
pub data Regex:
    text: string
    program: List[Inst]
    names: List[string]

# Where a match is: byte offsets into the searched text, and its text
# (r-std-regex.match.decl).
pub data Match:
    pub start: i32
    pub end: i32
    pub text: string

# Why a pattern does not compile (r-std-regex.error.declared).
pub enum RegexErrorKind:
    MissingParen
    UnmatchedParen
    MissingBracket
    BadEscape
    BadRange
    NothingToRepeat
    BadRepeat
    UnsupportedGroup
    BadGroupName
    DuplicateGroupName
    TooLarge

# A kind and the byte offset in the pattern where the problem starts
# (r-std-regex.error.position).
# The groups of one match (r-std-regex.captures.decl): two byte offsets per
# group, -1 for a group that took no part.
pub data Captures:
    text: string
    slots: List[i32]
    names: List[string]

pub data RegexError:
    pub kind: RegexErrorKind
    pub position: i32

impl Regex:
    pub fn new(pattern: string) -> Result[Regex, RegexError]:
        source := Pattern::of(pattern)
        let names: mut List[string] = [""]
        parsed := parse_alternation(source, 0, names)?
        if parsed.next < source.chars.len():
            return .Err(RegexError { kind: .UnmatchedParen, position: source.offsets[parsed.next] })
        if program_size(parsed.node) > max_program():
            return .Err(RegexError { kind: .TooLarge, position: 0 })
        let program: mut List[Inst] = []
        compile(parsed.node, program)
        program.push(Inst.Done)
        .Ok(Regex { text: pattern, program: program, names: names })

    # The pattern as written.
    pub fn pattern(self) -> string:
        self.text

    # Whether some part of `text` matches (r-std-regex.is-match).
    pub fn is_match(self, text: string) -> bool:
        self.find(text).is_some()

    # The leftmost match, and among those that start there, the one the
    # pattern prefers (r-std-regex.find.leftmost-first).
    pub fn find(self, text: string) -> Match?:
        hay := Haystack::of(text)
        match run(self.program, hay, 0, 2):
            .Some(slots) => .Some(hay.match_of(slots[0], slots[1]))
            .None => .None

    # Every match, left to right, none overlapping (r-std-regex.find-all).
    pub fn find_all(self, text: string) -> List[Match]:
        hay := Haystack::of(text)
        let found: mut List[Match] = []
        for slots in all_slots(self.program, hay, 2):
            found.push(hay.match_of(slots[0], slots[1]))
        found

    # The groups of the first match (r-std-regex.captures).
    pub fn captures(self, text: string) -> Captures?:
        hay := Haystack::of(text)
        match run(self.program, hay, 0, self.slot_count()):
            .Some(slots) => .Some(hay.captures_of(slots, self.names))
            .None => .None

    # The groups of each match that `find_all` returns
    # (r-std-regex.captures-all).
    pub fn captures_all(self, text: string) -> List[Captures]:
        hay := Haystack::of(text)
        let found: mut List[Captures] = []
        for slots in all_slots(self.program, hay, self.slot_count()):
            found.push(hay.captures_of(slots, self.names))
        found

    # `text` with its first match replaced (r-std-regex.replace).
    pub fn replace(self, text: string, replacement: string) -> string:
        hay := Haystack::of(text)
        match run(self.program, hay, 0, self.slot_count()):
            .Some(slots) =>
                groups := hay.captures_of(slots, self.names)
                template := Pattern::of(replacement)
                start := hay.offsets[slots[0]]
                end := hay.offsets[slots[1]]
                text.slice(0, start) + expand(template, groups) + text.slice(end, text.len())
            .None => text

    # `text` with each match that `find_all` returns replaced
    # (r-std-regex.replace-all).
    pub fn replace_all(self, text: string, replacement: string) -> string:
        hay := Haystack::of(text)
        template := Pattern::of(replacement)
        let out = ""
        let last = 0
        for slots in all_slots(self.program, hay, self.slot_count()):
            groups := hay.captures_of(slots, self.names)
            start := hay.offsets[slots[0]]
            out = out + text.slice(last, start) + expand(template, groups)
            last = hay.offsets[slots[1]]
        out + text.slice(last, text.len())

    # The pieces of `text` around each match that `find_all` returns
    # (r-std-regex.split).
    pub fn split(self, text: string) -> List[string]:
        hay := Haystack::of(text)
        let pieces: mut List[string] = []
        let last = 0
        for slots in all_slots(self.program, hay, 2):
            pieces.push(text.slice(last, hay.offsets[slots[0]]))
            last = hay.offsets[slots[1]]
        pieces.push(text.slice(last, text.len()))
        pieces

    # Two slots per group, group 0 included.
    fn slot_count(self) -> i32:
        2 * self.names.len()

impl Captures:
    # The number of groups, plus one for the whole match
    # (r-std-regex.captures.len).
    pub fn len(self) -> i32:
        self.names.len()

    # Group `index`, or `.None` when it took no part
    # (r-std-regex.captures.get).
    pub fn get(self, index: i32) -> Match?:
        if index < 0 || index >= self.names.len():
            return .None
        start := self.slots[2 * index]
        end := self.slots[2 * index + 1]
        if start < 0 || end < 0:
            return .None
        .Some(Match { start: start, end: end, text: self.text.slice(start, end) })

    # The group named `name` (r-std-regex.captures.name).
    pub fn name(self, name: string) -> Match?:
        if name == "":
            return .None
        let index = 1
        while index < self.names.len():
            if self.names[index] == name:
                return self.get(index)
            index = index + 1
        .None

# The most instructions a compiled pattern may have
# (r-std-regex.error.too-large).
fn max_program() -> i32:
    10000

# The most a counted repetition may count (r-std-regex.repeat.bad-count).
fn max_repeat() -> i32:
    1000

# A pattern split into its characters, with the byte offset of each and
# the pattern's length last.
data Pattern:
    text: string
    chars: List[char]
    offsets: List[i32]

impl Pattern:
    fn of(text: string) -> Pattern:
        let chars: mut List[char] = []
        let offsets: mut List[i32] = []
        for (offset, c) in text.char_indices():
            chars.push(c)
            offsets.push(offset)
        offsets.push(text.len())
        Pattern { text: text, chars: chars, offsets: offsets }

    # The text from character `start` up to character `end`.
    fn piece(self, start: i32, end: i32) -> string:
        self.text.slice(self.offsets[start], self.offsets[end])

    fn at(self, index: i32) -> char?:
        if index < self.chars.len(): .Some(self.chars[index]) else: .None

    fn has(self, index: i32, c: char) -> bool:
        index < self.chars.len() && self.chars[index] == c

    fn fail(self, kind: RegexErrorKind, index: i32) -> RegexError:
        RegexError { kind: kind, position: self.offsets[index] }

# The syntax tree.
enum Node:
    Empty
    Literal(value: char)
    AnyChar
    Class(items: List[ClassItem], negated: bool)
    Begin
    End
    Group(body: Node, index: i32)
    Concat(items: List[Node])
    Alternate(branches: List[Node])
    Repeat(body: Node, min: i32, max: i32?, greedy: bool)

# One member of a bracketed class, or a whole `\d`, `\w`, or `\s` class.
enum ClassItem:
    Range(low: char, high: char)
    Digit(negated: bool)
    Word(negated: bool)
    Space(negated: bool)

# A parsed piece and the index of the character after it.
data Step:
    node: Node
    next: i32

# `a|b|c`: one or more concatenations.
fn parse_alternation(source: Pattern, start: i32, names: mut List[string]) -> Result[Step, RegexError]:
    let branches: mut List[Node] = []
    let at = start
    while true:
        branch := parse_concat(source, at, names)?
        branches.push(branch.node)
        at = branch.next
        if source.has(at, '|'):
            at = at + 1
        else:
            break
    if branches.len() == 1:
        return .Ok(Step { node: branches[0], next: at })
    .Ok(Step { node: Node.Alternate(branches), next: at })

# A run of atoms, each with at most one quantifier, up to `|`, `)`, or the
# end.
fn parse_concat(source: Pattern, start: i32, names: mut List[string]) -> Result[Step, RegexError]:
    let items: mut List[Node] = []
    let at = start
    while at < source.chars.len():
        c := source.chars[at]
        if c == '|' || c == ')':
            break
        # A quantifier with no atom before it, including one right after
        # another quantifier (r-std-regex.repeat.nothing).
        if quantifier_at(source, at):
            return .Err(source.fail(.NothingToRepeat, at))
        atom := parse_atom(source, at, names)?
        repeated := parse_repeat(source, atom)?
        items.push(repeated.node)
        at = repeated.next
    if items.len() == 0:
        return .Ok(Step { node: Node.Empty, next: at })
    if items.len() == 1:
        return .Ok(Step { node: items[0], next: at })
    .Ok(Step { node: Node.Concat(items), next: at })

fn quantifier_at(source: Pattern, at: i32) -> bool:
    match source.at(at):
        .Some(c) =>
            if c == '*' || c == '+' || c == '?':
                return true
            c == '{' && counts_at(source, at).is_some()
        .None => false

# The counts of a well-formed `{m}`, `{m,}`, or `{m,n}` at `at`. Any other
# `{` is a literal (r-std-regex.syntax.brace-literal).
data Counts:
    min: i32
    max: i32?
    next: i32

fn counts_at(source: Pattern, start: i32) -> Counts?:
    if !source.has(start, '{'):
        return .None
    low := number_at(source, start + 1)?
    if low.next == start + 1:
        return .None
    match source.at(low.next):
        .Some('}') => .Some(Counts { min: low.value, max: .Some(low.value), next: low.next + 1 })
        .Some(',') =>
            high := number_at(source, low.next + 1)?
            if !source.has(high.next, '}'):
                return .None
            if high.next == low.next + 1:
                return .Some(Counts { min: low.value, max: .None, next: high.next + 1 })
            .Some(Counts { min: low.value, max: .Some(high.value), next: high.next + 1 })
        _ => .None

data Number:
    value: i32
    next: i32

# A run of ASCII digits, held below 100000 so it cannot overflow.
fn number_at(source: Pattern, start: i32) -> Number?:
    let value = 0
    let at = start
    while true:
        match source.at(at):
            .Some(c) =>
                if c < '0' || c > '9':
                    break
                if value < 100000:
                    value = value * 10 + (char_digit(c))
                at = at + 1
            .None => break
    .Some(Number { value: value, next: at })

fn char_digit(c: char) -> i32:
    let value = 0
    for digit in "0123456789".chars():
        if digit == c:
            return value
        value = value + 1
    0

# A quantifier after `atom`, if one follows, with its lazy `?`.
fn parse_repeat(source: Pattern, atom: Step) -> Result[Step, RegexError]:
    at := atom.next
    let min = 0
    let max: i32? = .None
    let next = at + 1
    match source.at(at):
        .Some('*') => pass
        .Some('+') => min = 1
        .Some('?') => max = .Some(1)
        .Some('{') =>
            match counts_at(source, at):
                .Some(counts) =>
                    min = counts.min
                    max = counts.max
                    next = counts.next
                    let bad = min > max_repeat()
                    match max:
                        .Some(high) =>
                            if high > max_repeat() || high < min:
                                bad = true
                        .None => pass
                    if bad:
                        return .Err(source.fail(.BadRepeat, at))
                .None => return .Ok(atom)
        _ => return .Ok(atom)
    let greedy = true
    if source.has(next, '?'):
        greedy = false
        next = next + 1
    .Ok(Step { node: Node.Repeat(atom.node, min, max, greedy), next: next })

fn parse_atom(source: Pattern, at: i32, names: mut List[string]) -> Result[Step, RegexError]:
    c := source.chars[at]
    if c == '(':
        return parse_group(source, at, names)
    if c == '[':
        return parse_class(source, at)
    if c == '.':
        return .Ok(Step { node: Node.AnyChar, next: at + 1 })
    if c == '^':
        return .Ok(Step { node: Node.Begin, next: at + 1 })
    if c == '$':
        return .Ok(Step { node: Node.End, next: at + 1 })
    if c == '\\':
        escaped := parse_escape(source, at)?
        node := match escaped.item:
            .Some(item) => Node.Class([item], false)
            .None => Node.Literal(escaped.value)
        return .Ok(Step { node: node, next: at + 2 })
    .Ok(Step { node: Node.Literal(c), next: at + 1 })

# `( )`, `(?: )`, `(?P<name> )`, and `(?<name> )`; any other `(?` is an
# unsupported group (r-std-regex.syntax.group.unsupported). A capture group
# takes the next number when its `(` is read
# (r-std-regex.syntax.group.number).
fn parse_group(source: Pattern, open: i32, names: mut List[string]) -> Result[Step, RegexError]:
    let start = open + 1
    let capturing = true
    let name = ""
    if source.has(start, '?'):
        let name_start = -1
        if source.has(start + 1, ':'):
            capturing = false
            start = start + 2
        else if source.has(start + 1, 'P') && source.has(start + 2, '<'):
            name_start = start + 3
        else if source.has(start + 1, '<') && !source.has(start + 2, '=') && !source.has(start + 2, '!'):
            name_start = start + 2
        else:
            return .Err(source.fail(.UnsupportedGroup, open))
        if name_start >= 0:
            let close = name_start
            while close < source.chars.len() && !source.has(close, '>'):
                close = close + 1
            if close >= source.chars.len() || !group_name(source, name_start, close):
                return .Err(source.fail(.BadGroupName, open))
            name = source.piece(name_start, close)
            for taken in names:
                if taken == name:
                    return .Err(source.fail(.DuplicateGroupName, open))
            start = close + 1
    index := names.len()
    if capturing:
        names.push(name)
    inner := parse_alternation(source, start, names)?
    if !source.has(inner.next, ')'):
        return .Err(source.fail(.MissingParen, open))
    if capturing:
        return .Ok(Step { node: Node.Group(inner.node, index), next: inner.next + 1 })
    .Ok(Step { node: inner.node, next: inner.next + 1 })

# Whether characters `start` to `end` form a group name: an ASCII letter or
# `_`, then ASCII letters, digits, and `_` (r-std-regex.syntax.group.name).
fn group_name(source: Pattern, start: i32, end: i32) -> bool:
    if end <= start:
        return false
    first := source.chars[start]
    if first >= '0' && first <= '9':
        return false
    let at = start
    while at < end:
        if !word_char(source.chars[at]):
            return false
        at = at + 1
    true

# An escape: a Perl class item, or one character.
data Escape:
    item: ClassItem?
    value: char

fn parse_escape(source: Pattern, at: i32) -> Result[Escape, RegexError]:
    match source.at(at + 1):
        .None => .Err(source.fail(.BadEscape, at))
        .Some(e) =>
            if e == 'd' || e == 'D':
                return .Ok(Escape { item: .Some(ClassItem.Digit(e == 'D')), value: e })
            if e == 'w' || e == 'W':
                return .Ok(Escape { item: .Some(ClassItem.Word(e == 'W')), value: e })
            if e == 's' || e == 'S':
                return .Ok(Escape { item: .Some(ClassItem.Space(e == 'S')), value: e })
            if e == 'n':
                return .Ok(Escape { item: .None, value: '\n' })
            if e == 't':
                return .Ok(Escape { item: .None, value: '\t' })
            if e == 'r':
                return .Ok(Escape { item: .None, value: '\r' })
            if ascii_punctuation(e):
                return .Ok(Escape { item: .None, value: e })
            .Err(source.fail(.BadEscape, at))

fn ascii_punctuation(c: char) -> bool:
    (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')

# `[...]` and `[^...]`. A `]` first is a literal (r-std-regex.syntax.class).
fn parse_class(source: Pattern, open: i32) -> Result[Step, RegexError]:
    let at = open + 1
    let negated = false
    if source.has(at, '^'):
        negated = true
        at = at + 1
    let items: mut List[ClassItem] = []
    let first = true
    while true:
        match source.at(at):
            .None => return .Err(source.fail(.MissingBracket, open))
            .Some(c) =>
                if c == ']' && !first:
                    break
        first = false
        low := class_char(source, at)?
        match low.item:
            .Some(item) =>
                if source.has(low.next, '-') && source.at(low.next + 1).is_some() && !source.has(low.next + 1, ']'):
                    return .Err(source.fail(.BadRange, at))
                items.push(item)
                at = low.next
            .None =>
                if source.has(low.next, '-') && source.at(low.next + 1).is_some() && !source.has(low.next + 1, ']'):
                    high := class_char(source, low.next + 1)?
                    if high.item.is_some() || high.value < low.value:
                        return .Err(source.fail(.BadRange, at))
                    items.push(ClassItem.Range(low.value, high.value))
                    at = high.next
                else:
                    items.push(ClassItem.Range(low.value, low.value))
                    at = low.next
    .Ok(Step { node: Node.Class(items, negated), next: at + 1 })

data ClassChar:
    item: ClassItem?
    value: char
    next: i32

fn class_char(source: Pattern, at: i32) -> Result[ClassChar, RegexError]:
    c := source.chars[at]
    if c == '\\':
        escaped := parse_escape(source, at)?
        return .Ok(ClassChar { item: escaped.item, value: escaped.value, next: at + 2 })
    .Ok(ClassChar { item: .None, value: c, next: at + 1 })

# The VM's instructions. `Split` tries `first` before `second`.
enum Inst:
    Char(value: char)
    AnyChar
    Class(items: List[ClassItem], negated: bool)
    Begin
    End
    Split(first: i32, second: i32)
    Jump(target: i32)
    Save(slot: i32)
    Done

# How many instructions `compile` emits for `node`, the written-out size
# (r-std-regex.time.size), held at
# max_program() + 1 so it cannot overflow.
fn program_size(node: Node) -> i32:
    match node:
        .Empty => 0
        .Group(body, _) => program_size(body)
        .Concat(items) =>
            let total = 0
            for item in items:
                total = capped(total + program_size(item))
            total
        .Alternate(branches) =>
            let total = 0
            for branch in branches:
                total = capped(total + program_size(branch) + 2)
            total - 2
        .Repeat(body, min, max, _) =>
            size := program_size(body)
            match max:
                .None =>
                    if min == 0:
                        return capped(size + 2)
                    capped(scaled(size, min) + 1)
                .Some(high) => capped(scaled(size, min) + scaled(size + 1, high - min))
        _ => 1

fn capped(size: i32) -> i32:
    if size > max_program(): max_program() + 1 else: size

fn scaled(size: i32, count: i32) -> i32:
    if count == 0:
        return 0
    if size > max_program() / count:
        return max_program() + 1
    size * count

fn compile(node: Node, program: mut List[Inst]) -> void:
    match node:
        .Empty => pass
        .Literal(value) => program.push(Inst.Char(value))
        .AnyChar => program.push(Inst.AnyChar)
        .Class(items, negated) => program.push(Inst.Class(items, negated))
        .Begin => program.push(Inst.Begin)
        .End => program.push(Inst.End)
        .Group(body, index) =>
            program.push(Inst.Save(2 * index))
            compile(body, program)
            program.push(Inst.Save(2 * index + 1))
        .Concat(items) =>
            for item in items:
                compile(item, program)
        .Alternate(branches) =>
            # split L1, next; L1: a; jump end; next: split L2, ... ; last
            let jumps: mut List[i32] = []
            let index = 0
            while index < branches.len():
                if index + 1 < branches.len():
                    split := program.len()
                    program.push(Inst.Split(split + 1, 0))
                    compile(branches[index], program)
                    jumps.push(program.len())
                    program.push(Inst.Jump(0))
                    program[split] = Inst.Split(split + 1, program.len())
                else:
                    compile(branches[index], program)
                index = index + 1
            for jump in jumps:
                program[jump] = Inst.Jump(program.len())
        .Repeat(body, min, max, greedy) =>
            let copies = 0
            match max:
                .None =>
                    if min == 0:
                        # loop: split body, out; body; jump loop
                        loop_start := program.len()
                        program.push(Inst.Split(0, 0))
                        compile(body, program)
                        program.push(Inst.Jump(loop_start))
                        program[loop_start] = choice(loop_start + 1, program.len(), greedy)
                    else:
                        while copies < min - 1:
                            compile(body, program)
                            copies = copies + 1
                        # last: body; split last, out
                        last := program.len()
                        compile(body, program)
                        program.push(choice(last, program.len() + 1, greedy))
                .Some(high) =>
                    while copies < min:
                        compile(body, program)
                        copies = copies + 1
                    # each optional copy: split body, out
                    let splits: mut List[i32] = []
                    while copies < high:
                        splits.push(program.len())
                        program.push(Inst.Split(0, 0))
                        compile(body, program)
                        copies = copies + 1
                    for split in splits:
                        program[split] = choice(split + 1, program.len(), greedy)

# A split that prefers `body` when greedy and `out` when lazy.
fn choice(body: i32, out: i32, greedy: bool) -> Inst:
    if greedy: Inst.Split(body, out) else: Inst.Split(out, body)

# The searched text split into its characters, with the byte offset of each
# and the text's length last.
data Haystack:
    text: string
    chars: List[char]
    offsets: List[i32]

impl Haystack:
    fn of(text: string) -> Haystack:
        let chars: mut List[char] = []
        let offsets: mut List[i32] = []
        for (offset, c) in text.char_indices():
            chars.push(c)
            offsets.push(offset)
        offsets.push(text.len())
        Haystack { text: text, chars: chars, offsets: offsets }

    # The match from character `start` to character `end`.
    fn match_of(self, start: i32, end: i32) -> Match:
        from := self.offsets[start]
        to := self.offsets[end]
        Match { start: from, end: to, text: self.text.slice(from, to) }

    # The groups of a match, with each slot turned into a byte offset.
    fn captures_of(self, slots: List[i32], names: List[string]) -> Captures:
        let offsets: mut List[i32] = []
        for slot in slots:
            offsets.push(if slot < 0: -1 else: self.offsets[slot])
        Captures { text: self.text, slots: offsets, names: names }

# The slots of every match `find_all` returns (r-std-regex.find-all.next):
# after a match the next search starts at its end, or one character later
# when it is empty, and an empty match where the last one ended is dropped.
fn all_slots(program: List[Inst], hay: Haystack, slot_count: i32) -> List[List[i32]]:
    let found: mut List[List[i32]] = []
    let from = 0
    let last_end = -1
    while from <= hay.chars.len():
        match run(program, hay, from, slot_count):
            .None => break
            .Some(slots) =>
                start := slots[0]
                end := slots[1]
                if start == end:
                    if start != last_end:
                        found.push(slots)
                    from = end + 1
                else:
                    found.push(slots)
                    from = end
                last_end = end
    found

# One step of the epsilon walk in `add_thread`: visit `pc`, or, when `slot`
# is not -1, put `value` back into that slot.
data Frame:
    pc: i32
    slot: i32
    value: i32

# The Pike VM (r-std-regex.find.leftmost-first): threads in priority
# order, at most one per instruction at each position. A thread is its
# instruction; its `slot_count` slots, character indices or -1, sit in
# `table`, one half for the current position and one for the next. The
# search starts at character `from`. The result is the slots of the match,
# with slot 0 its start and slot 1 its end.
fn run(program: List[Inst], hay: Haystack, from: i32, slot_count: i32) -> List[i32]?:
    count := hay.chars.len()
    size := program.len()
    let marks: mut List[i32] = []
    for _ in program:
        marks.push(-1)
    let table: mut List[i32] = []
    let filled = 0
    while filled < 2 * size * slot_count:
        table.push(-1)
        filled = filled + 1
    let scratch: mut List[i32] = []
    while scratch.len() < slot_count:
        scratch.push(-1)
    let stack: mut List[Frame] = []
    let current: mut List[i32] = []
    scratch[0] = from
    add_thread(program, marks, stack, from, current, table, half(from, size, slot_count), scratch, slot_count, 0, from, count)
    let found: mut List[i32] = []
    let index = from
    while true:
        let next: mut List[i32] = []
        generation := index + 1
        here := half(index, size, slot_count)
        there := half(index + 1, size, slot_count)
        for pc in current:
            inst := program[pc]
            # A finished thread cuts off every thread it outranks.
            if inst_done(inst):
                found = []
                let slot = 0
                while slot < slot_count:
                    found.push(table[here + pc * slot_count + slot])
                    slot = slot + 1
                found[1] = index
                break
            if index < count && inst_accepts(inst, hay.chars[index]):
                let slot = 0
                while slot < slot_count:
                    scratch[slot] = table[here + pc * slot_count + slot]
                    slot = slot + 1
                add_thread(program, marks, stack, generation, next, table, there, scratch, slot_count, pc + 1, index + 1, count)
        if index >= count:
            break
        index = index + 1
        if found.len() == 0:
            let slot = 0
            while slot < slot_count:
                scratch[slot] = -1
                slot = slot + 1
            scratch[0] = index
            add_thread(program, marks, stack, generation, next, table, there, scratch, slot_count, 0, index, count)
        else:
            if next.len() == 0:
                break
        current = next
    if found.len() == 0:
        return .None
    .Some(found)

# Where the slots for position `index` start in the table.
fn half(index: i32, size: i32, slot_count: i32) -> i32:
    (index % 2) * size * slot_count

fn inst_done(inst: Inst) -> bool:
    match inst:
        .Done => true
        _ => false

fn inst_accepts(inst: Inst, c: char) -> bool:
    match inst:
        .Char(value) => c == value
        .AnyChar => c != '\n'
        .Class(items, negated) => class_matches(items, negated, c)
        _ => false

# Adds the thread at `pc`, with the slots in `scratch`, to `list`, following
# jumps, splits, saves, and assertions in priority order.
# `marks[pc] == generation` means `pc` is already in `list`. A save sets its
# slot for the instructions after it and puts the old value back after
# them, so `scratch` is unchanged on return.
fn add_thread(program: List[Inst], marks: mut List[i32], stack: mut List[Frame], generation: i32, list: mut List[i32], table: mut List[i32], base: i32, scratch: mut List[i32], slot_count: i32, pc: i32, at: i32, count: i32) -> void:
    let top = 0
    top = push_frame(stack, top, Frame { pc: pc, slot: -1, value: 0 })
    while top > 0:
        top = top - 1
        frame := stack[top]
        if frame.slot >= 0:
            scratch[frame.slot] = frame.value
            continue
        here := frame.pc
        if marks[here] == generation:
            continue
        marks[here] = generation
        match program[here]:
            .Jump(target) => top = push_frame(stack, top, Frame { pc: target, slot: -1, value: 0 })
            .Split(first, second) =>
                top = push_frame(stack, top, Frame { pc: second, slot: -1, value: 0 })
                top = push_frame(stack, top, Frame { pc: first, slot: -1, value: 0 })
            .Save(slot) =>
                if slot < slot_count:
                    top = push_frame(stack, top, Frame { pc: 0, slot: slot, value: scratch[slot] })
                    scratch[slot] = at
                top = push_frame(stack, top, Frame { pc: here + 1, slot: -1, value: 0 })
            .Begin =>
                if at == 0:
                    top = push_frame(stack, top, Frame { pc: here + 1, slot: -1, value: 0 })
            .End =>
                if at == count:
                    top = push_frame(stack, top, Frame { pc: here + 1, slot: -1, value: 0 })
            _ =>
                list.push(here)
                let slot = 0
                while slot < slot_count:
                    table[base + here * slot_count + slot] = scratch[slot]
                    slot = slot + 1

fn push_frame(stack: mut List[Frame], top: i32, frame: Frame) -> i32:
    if top < stack.len():
        stack[top] = frame
    else:
        stack.push(frame)
    top + 1

# A reference in a replacement (r-std-regex.replace.expand).
enum Reference:
    Dollar
    Index(value: i32)
    Name(value: string)

data Found:
    reference: Reference
    next: i32

# The reference that the `$` at `at` starts, if any; any other `$` is
# itself (r-std-regex.replace.literal).
fn reference_at(template: Pattern, at: i32) -> Found?:
    match template.at(at + 1):
        .Some('$') => .Some(Found { reference: Reference.Dollar, next: at + 2 })
        .Some('{') =>
            let close = at + 2
            while close < template.chars.len() && !template.has(close, '}'):
                close = close + 1
            if close >= template.chars.len():
                return .None
            digits := number_at(template, at + 2)?
            if digits.next == close && close > at + 2:
                return .Some(Found { reference: Reference.Index(digits.value), next: close + 1 })
            if group_name(template, at + 2, close):
                return .Some(Found { reference: Reference.Name(template.piece(at + 2, close)), next: close + 1 })
            .None
        _ =>
            digits := number_at(template, at + 1)?
            if digits.next == at + 1:
                return .None
            .Some(Found { reference: Reference.Index(digits.value), next: digits.next })

# `template` with each reference replaced by the text it names
# (r-std-regex.replace.expand).
fn expand(template: Pattern, groups: Captures) -> string:
    let out = ""
    let literal = 0
    let at = 0
    while at < template.chars.len():
        if !template.has(at, '$'):
            at = at + 1
            continue
        match reference_at(template, at):
            .None => at = at + 1
            .Some(found) =>
                out = out + template.piece(literal, at) + reference_text(found.reference, groups)
                at = found.next
                literal = at
    out + template.piece(literal, template.chars.len())

fn reference_text(reference: Reference, groups: Captures) -> string:
    match reference:
        .Dollar => "\$"
        .Index(value) => group_text(groups.get(value))
        .Name(value) => group_text(groups.name(value))

fn group_text(group: Match?) -> string:
    match group:
        .Some(found) => found.text
        .None => ""

fn class_matches(items: List[ClassItem], negated: bool, c: char) -> bool:
    let hit = false
    for item in items:
        if item_matches(item, c):
            hit = true
            break
    hit != negated

# `\d` and `\w` are ASCII; `\s` is Unicode White_Space
# (r-std-regex.syntax.escape.digit, r-std-regex.syntax.escape.space).
fn item_matches(item: ClassItem, c: char) -> bool:
    match item:
        .Range(low, high) => c >= low && c <= high
        .Digit(negated) => (c >= '0' && c <= '9') != negated
        .Word(negated) => word_char(c) != negated
        .Space(negated) => c.is_whitespace() != negated

fn word_char(c: char) -> bool:
    (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'

impl Eq for Match:
    fn eq(self, other: Match) -> bool:
        self.start == other.start && self.end == other.end && self.text == other.text

impl Eq for RegexErrorKind:
    fn eq(self, other: RegexErrorKind) -> bool:
        kind_index(self) == kind_index(other)

fn kind_index(kind: RegexErrorKind) -> i32:
    match kind:
        .MissingParen => 0
        .UnmatchedParen => 1
        .MissingBracket => 2
        .BadEscape => 3
        .BadRange => 4
        .NothingToRepeat => 5
        .BadRepeat => 6
        .UnsupportedGroup => 7
        .BadGroupName => 8
        .DuplicateGroupName => 9
        .TooLarge => 10

impl Eq for RegexError:
    fn eq(self, other: RegexError) -> bool:
        self.kind == other.kind && self.position == other.position

impl Display for RegexErrorKind:
    fn to_string(self) -> string:
        match self:
            .MissingParen => "missing closing )"
            .UnmatchedParen => "unexpected )"
            .MissingBracket => "missing closing ]"
            .BadEscape => "invalid escape"
            .BadRange => "invalid character class range"
            .NothingToRepeat => "missing argument to repetition operator"
            .BadRepeat => "invalid repeat count"
            .UnsupportedGroup => "unsupported group"
            .BadGroupName => "invalid named capture"
            .DuplicateGroupName => "duplicate capture group name"
            .TooLarge => "expression too large"

impl Display for RegexError:
    fn to_string(self) -> string:
        "${self.kind} at byte ${self.position}"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for RegexError

# `Debug` for this module's types (r-std-format.debug.std-types), written by
# hand with the builder calls that `@derive(Debug)` generates.

impl Debug for Regex:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Regex").field("pattern", self.text).finish()

impl Debug for Captures:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Captures").field("text", self.text).field("slots", self.slots).field("names", self.names).finish()

impl Debug for Match:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Match").field("start", self.start).field("end", self.end).field("text", self.text).finish()

impl Debug for RegexErrorKind:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct(match self:
            .MissingParen => "MissingParen"
            .UnmatchedParen => "UnmatchedParen"
            .MissingBracket => "MissingBracket"
            .BadEscape => "BadEscape"
            .BadRange => "BadRange"
            .NothingToRepeat => "NothingToRepeat"
            .BadRepeat => "BadRepeat"
            .UnsupportedGroup => "UnsupportedGroup"
            .BadGroupName => "BadGroupName"
            .DuplicateGroupName => "DuplicateGroupName"
            .TooLarge => "TooLarge"
        ).finish()

impl Debug for RegexError:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("RegexError").field("kind", self.kind).field("position", self.position).finish()
