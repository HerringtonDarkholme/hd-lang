# std.format, the part written in hd (spec/lang/09-traits.md#debug-trait,
# spec/std/format.md).
# The prelude traits `Display` and `Debug`, `DebugWriter`, its builders,
# `debug`, and the standard `Debug` implementations (Testing T48, T53).

use std.function.Tuple
use std.structure.{Structure, Walker, Variant, Field}

# A value's text in string interpolation
# (spec/lang/05-expressions.md#string-interpolation).
pub trait Display:
    fn to_string(self) -> string

pub trait Debug:
    fn debug(self, out: mut DebugWriter) -> void

# The structured writer that `Debug.debug` writes through. An implementation
# describes the value with builder calls, like Rust's `Formatter`; the
# writer chooses the layout. The prototype's writer is always compact:
# `Point { x: 1, y: 2 }`, `Some(1)`, `[1, 2]`, `{"a": 1}`.
pub data DebugWriter:
    text: string

impl DebugWriter:
    # Writes custom text, for a value that no builder fits.
    pub fn write(mut self, text: string) -> void:
        self.text = self.text + text

    # A named value with named fields: `.field(name, value)`, then `.finish()`.
    pub fn debug_struct(mut self, name: string) -> mut DebugStruct:
        self.write(name)
        DebugStruct { out: self, count: 0 }

    # A named value with positional fields: `.field(value)`, then `.finish()`.
    # An empty name describes a tuple, so one field ends with a comma: `(1,)`.
    pub fn debug_tuple(mut self, name: string) -> mut DebugTuple:
        self.write(name)
        DebugTuple { out: self, count: 0, unnamed: name == "" }

    # A sequence: `.entry(value)` per item, then `.finish()`.
    pub fn debug_list(mut self) -> mut DebugList:
        self.write("[")
        DebugList { out: self, count: 0 }

    # Key-value pairs: `.entry(key, value)` per pair, then `.finish()`.
    pub fn debug_map(mut self) -> mut DebugMap:
        self.write("{")
        DebugMap { out: self, count: 0 }

pub data DebugStruct:
    out: mut DebugWriter
    count: i32

impl DebugStruct:
    pub fn field[T < Debug](mut self, name: string, value: T) -> mut DebugStruct:
        self.out.write(if self.count == 0: " { " else: ", ")
        self.out.write(name + ": ")
        value.debug(self.out)
        self.count = self.count + 1
        self

    pub fn finish(mut self) -> void:
        if self.count > 0:
            self.out.write(" }")

pub data DebugTuple:
    out: mut DebugWriter
    count: i32
    unnamed: bool

impl DebugTuple:
    pub fn field[T < Debug](mut self, value: T) -> mut DebugTuple:
        self.out.write(if self.count == 0: "(" else: ", ")
        value.debug(self.out)
        self.count = self.count + 1
        self

    # An unnamed one with no fields is the empty tuple, `()`.
    pub fn finish(mut self) -> void:
        if self.count == 0 && self.unnamed:
            self.out.write("()")
        if self.count == 1 && self.unnamed:
            self.out.write(",")
        if self.count > 0:
            self.out.write(")")

pub data DebugList:
    out: mut DebugWriter
    count: i32

impl DebugList:
    pub fn entry[T < Debug](mut self, value: T) -> mut DebugList:
        if self.count > 0:
            self.out.write(", ")
        value.debug(self.out)
        self.count = self.count + 1
        self

    pub fn finish(mut self) -> void:
        self.out.write("]")

pub data DebugMap:
    out: mut DebugWriter
    count: i32

impl DebugMap:
    pub fn entry[K < Debug, V < Debug](mut self, key: K, value: V) -> mut DebugMap:
        if self.count > 0:
            self.out.write(", ")
        key.debug(self.out)
        self.out.write(": ")
        value.debug(self.out)
        self.count = self.count + 1
        self

    pub fn finish(mut self) -> void:
        self.out.write("}")

# The standard `Debug` implementations (spec/lang/09-traits.md#r-trait.debug.std-impls).
impl Debug for i32:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for i64:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for u8:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for i8:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for i16:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for u16:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for u32:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for u64:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for f32:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for f64:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for bool:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("$self")

impl Debug for char:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("'$self'")

impl Debug for string:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("\"$self\"")

impl[T < Debug] Debug for List[T]:
    fn debug(self, out: mut DebugWriter) -> void:
        let list: mut DebugList = out.debug_list()
        for item in self:
            _ := list.entry(item)
        list.finish()

impl[T < Debug] Debug for T?:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Some(value) => out.debug_tuple("Some").field(value).finish()
            .None => out.write("None")

impl[T < Debug, E < Debug] Debug for Result[T, E]:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Ok(value) => out.debug_tuple("Ok").field(value).finish()
            .Err(error) => out.debug_tuple("Err").field(error).finish()

# `debug(value)` (spec/lang/10-modules.md#r-module.prelude.debug): the text that
# `Debug` writes for `value` (spec/std/format.md#r-std-format.debug.render).
pub fn debug[T < Debug](value: T) -> string:
    let mut out = DebugWriter { text: "" }
    value.debug(out)
    out.text

# Tuple `Debug` (spec/std/format.md#r-std-format.debug.tuple-template):
# `debug_tuple("")`, a field per element, then `finish`, at every size. The
# walker implements `rest`, so a rest element's items are fields too
# (spec/lang/09-traits.md#r-trait.debug.tuples.rest).
impl[T < Tuple] Debug for T by Structure:
    fn debug(self, out: mut DebugWriter) -> void:
        let w: mut DebugFields[T] = DebugFields::[T] { tuple: out.debug_tuple("") }
        _ := Structure::walk(self, w)
        w.tuple.finish()

# The field is public because the prototype checks the instantiated walker
# in the program that uses it.
data DebugFields[S]:
    pub tuple: mut DebugTuple

impl[S] Walker[S] for DebugFields[S]:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Debug](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        _ := self.tuple.field(value)
        .Ok(())

    fn rest[I < Debug](mut self, h: Field[S, List[I]], items: List[I]) -> Result[void, never]:
        for item in items:
            _ := self.tuple.field(item)
        .Ok(())

# Tuple `Display` (spec/lang/05-expressions.md#r-expr.interp.std.tuple.template):
# each element's text, separated by ", ", inside parentheses, at every
# size. One element ends with a comma, as in `(1,)`
# (r-expr.interp.std.tuple.one), and a rest element's items are written
# inline (r-expr.interp.std.tuple.rest-inline).
impl[T < Tuple] Display for T by Structure:
    fn to_string(self) -> string:
        let w: mut TupleText[T] = TupleText::[T] { text: "", count: 0 }
        _ := Structure::walk(self, w)
        if w.count == 1:
            return "(${w.text},)"
        "(${w.text})"

# The fields are public because the prototype checks the instantiated
# walker in the program that uses it.
data TupleText[S]:
    pub text: string
    pub count: i32

impl[S] Walker[S] for TupleText[S]:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Display](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.text = if self.count == 0: "$value" else: "${self.text}, $value"
        self.count = self.count + 1
        .Ok(())

    fn rest[I < Display](mut self, h: Field[S, List[I]], items: List[I]) -> Result[void, never]:
        for item in items:
            self.text = if self.count == 0: "$item" else: "${self.text}, $item"
            self.count = self.count + 1
        .Ok(())
