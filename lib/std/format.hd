impl[A < Display, B < Display, C < Display, D < Display, E < Display, F < Display, G < Display, H < Display, I < Display, J < Display, K < Display, R < Display] Display for (A, B, C, D, E, F, G, H, I, J, K, List[R]...):
    fn to_string(self) -> string:
        tuple_text(["${self._0}", "${self._1}", "${self._2}", "${self._3}", "${self._4}", "${self._5}", "${self._6}", "${self._7}", "${self._8}", "${self._9}", "${self._10}"], self._11)
