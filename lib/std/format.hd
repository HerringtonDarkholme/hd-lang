# std.format, the part written in hd (spec/lang/09-traits.md#debug-trait,
# spec/std/format.md).
# The prelude traits `Display` and `Debug`, `DebugWriter`, its builders,
# `debug`, the standard `Debug` implementations, and `Debug`'s template
# (Testing T48, T53, T54).

use std.function.Tuple
use std.num.Integer
use std.structure.{Structure, UnionType, Walker, Variant, Field}

# A value's text in string interpolation
# (spec/lang/05-expressions.md#string-interpolation).
## The canonical text trait: string interpolation writes a value through it.
## See [expr.interp.display](../../spec/lang/05-expressions.md#r-expr.interp.display).
pub trait Display:
    fn to_string(self) -> string

## The debug-text trait: `debug(value)` and `dbg` write a value through it, field by field.
## See [trait.debug.module](../../spec/lang/09-traits.md#r-trait.debug.module).
pub trait Debug:
    fn debug(self, out: *mut DebugWriter) -> void

# A union's Display forwards directly to its active payload.
struct UnionText[S]:
    pub text: string

impl[S] Walker[S] for UnionText[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Display](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.text = value.to_string()
        .Ok(())

impl[T < UnionType] Display for T by Structure:
    fn to_string(self) -> string:
        let mut w = UnionText::[T] { text: "" }
        _ := Structure::walk(self, &mut w)
        w.text

# The structured writer that `Debug.debug` writes through. An implementation
# describes the value with builder calls, like Rust's `Formatter`; the
# writer chooses the layout. `debug` writes the compact layout:
# `Point { x: 1, y: 2 }`, `Some(1)`, `[1, 2]`, `{"a": 1}`. The writer of
# `dbg` (spec/lang/10-modules.md#large-values) also applies its limits, and
# its pretty layout puts each field or entry on its own line, as Rust's
# `{:#?}` does.
# A struct used as a box, `*mut`: every `debug` of one value writes to the
# one writer (r-std-format.debug.writer-ref).
## What a `Debug` implementation writes to: one of the builders, or custom text.
## See [std-format.debug.writer-ref](../../spec/std/format.md#r-std-format.debug.writer-ref).
pub struct DebugWriter:
    # The pieces written so far, joined once by `text`: appending each to
    # one string would copy the text so far on every write.
    parts: List[string]
    # `dbg`'s limits apply.
    limited: bool
    pretty: bool
    # How many parts the value being written is inside.
    depth: usize
    # The data values, lists and maps being written, to find a cycle.
    active: List[*dyn Any]

impl DebugWriter:
    # Writes custom text, for a value that no builder fits.
    ## Writes custom text, for a value that no builder fits.
    ## See [std-format.debug.builder.write](../../spec/std/format.md#r-std-format.debug.builder.write).
    pub fn write(&mut self, text: string) -> void:
        self.parts.push(text)

    # The text written so far.
    fn text(&self) -> string:
        self.parts.join("")

    # A named value with named fields: `.field(name, value)`, then `.finish()`.
    ## Starts a named value with named fields.
    ## See [std-format.debug.builder.struct](../../spec/std/format.md#r-std-format.debug.builder.struct).
    pub fn debug_struct(*mut self, name: string) -> DebugStruct:
        shown := self.open()
        if shown:
            self.write(name)
        DebugStruct { out: self, count: 0, shown: shown }

    # A named value with positional fields: `.field(value)`, then `.finish()`.
    # An empty name describes a tuple, so one field ends with a comma: `(1,)`.
    ## Starts a named value with positional fields.
    ## See [std-format.debug.builder.tuple](../../spec/std/format.md#r-std-format.debug.builder.tuple).
    pub fn debug_tuple(*mut self, name: string) -> DebugTuple:
        shown := self.open()
        if shown:
            self.write(name)
        DebugTuple { out: self, count: 0, unnamed: name == "", shown: shown }

    # A sequence: `.entry(value)` per item, then `.finish()`.
    ## Starts a sequence.
    ## See [std-format.debug.builder.list](../../spec/std/format.md#r-std-format.debug.builder.list).
    pub fn debug_list(*mut self) -> DebugList:
        shown := self.open()
        DebugList { out: self, count: 0, shown: shown }

    # Key-value pairs: `.entry(key, value)` per pair, then `.finish()`.
    ## Starts key-value pairs.
    ## See [std-format.debug.builder.map](../../spec/std/format.md#r-std-format.debug.builder.map).
    pub fn debug_map(*mut self) -> DebugMap:
        shown := self.open()
        DebugMap { out: self, count: 0, shown: shown }

    # The layout below is the builders', and the printers that the checker
    # generates for `dbg` call it directly (checker/debug-print.ts).

    # Opens a part one level deeper. Under `dbg`'s limits a part deeper than
    # 10 levels writes `…` instead and stays closed, so this returns false
    # (spec/lang/10-modules.md#r-module.dbg.limit.depth).
    fn open(&mut self) -> bool:
        if self.limited && self.depth >= 10:
            self.write("…")
            return false
        self.depth = self.depth + 1
        true

    # The indentation of the current depth, in the pretty layout.
    fn margin(&self) -> string:
        let text = ""
        let level: usize = 0
        while level < self.depth:
            text = text + "    "
            level = level + 1
        text

    # Starts field `name` of a struct part, the `index`-th.
    fn struct_item(&mut self, name: string, index: usize) -> void:
        if self.pretty:
            if index == 0:
                self.write(" {\n")
            self.write(self.margin() + name + ": ")
        else:
            self.write(if index == 0: " { " else: ", ")
            self.write(name + ": ")

    # Starts the `index`-th field of a tuple part.
    fn tuple_item(&mut self, index: usize) -> void:
        if self.pretty:
            if index == 0:
                self.write("(\n")
            self.write(self.margin())
        else:
            self.write(if index == 0: "(" else: ", ")

    # Starts the `index`-th field of a tuple part as the named argument
    # `name=`, as a call writes it.
    fn named_item(&mut self, name: string, index: usize) -> void:
        self.tuple_item(index)
        self.write(name + "=")

    # Starts the `index`-th entry of a list part (`opening` "[") or a map
    # part ("{"). Under `dbg`'s limits an entry past the 100th is left out,
    # so this returns false (spec/lang/10-modules.md#r-module.dbg.limit.entries).
    fn entry_item(&mut self, index: usize, opening: string) -> bool:
        if self.limited && index >= 100:
            return false
        if self.pretty:
            if index == 0:
                self.write(opening + "\n")
            self.write(self.margin())
        else:
            self.write(if index == 0: opening else: ", ")
        true

    # Ends a field or an entry.
    fn end_item(&mut self) -> void:
        if self.pretty:
            self.write(",\n")

    # Closes a struct part that has `count` fields; one without fields is
    # the literal `Name {}`.
    fn struct_close(&mut self, count: usize) -> void:
        self.depth = self.depth - 1
        if count == 0:
            self.write(" {}")
            return
        self.write(if self.pretty: self.margin() + "}" else: " }")

    # Closes a tuple part that has `count` fields; an unnamed one is a tuple.
    fn tuple_close(&mut self, count: usize, unnamed: bool) -> void:
        self.depth = self.depth - 1
        if count == 0:
            if unnamed:
                self.write("()")
            return
        if self.pretty:
            self.write(self.margin() + ")")
            return
        if count == 1 && unnamed:
            self.write(",")
        self.write(")")

    # Closes a list part ("[", "]") or a map part ("{", "}") of `count`
    # entries, naming the ones past the limit (r-module.dbg.limit.entries).
    fn entry_close(&mut self, count: usize, opening: string, closing: string) -> void:
        if count == 0:
            self.depth = self.depth - 1
            self.write(opening + closing)
            return
        if self.limited && count > 100:
            more := count - 100
            if self.pretty:
                self.write(self.margin() + "… $more more\n")
            else:
                self.write(", … $more more")
        self.depth = self.depth - 1
        if self.pretty:
            self.write(self.margin())
        self.write(closing)

    # Starts writing the value a reference refers to: every cycle passes
    # through a reference. A value that is already being written is part of
    # a cycle: this writes `<cycle>` and returns false
    # (spec/lang/10-modules.md#r-module.dbg.cycle.reference).
    fn enter(&mut self, value: *dyn Any) -> bool:
        for seen in self.active:
            if seen is value:
                self.write("<cycle>")
                return false
        self.active.push(value)
        true

    # Ends writing the value that the last `enter` started.
    fn leave(&mut self) -> void:
        _ := self.active.pop()

    # A string's text, cut after 1000 characters under `dbg`'s limits
    # (spec/lang/10-modules.md#r-module.dbg.limit.string).
    fn cut(&self, text: string) -> string:
        if !self.limited || text.len() <= 1000:
            return text
        let count: usize = 0
        for pair in text.char_indices():
            if count == 1000:
                return text.slice(0, pair._0) + "…"
            count = count + 1
        text

## The builder `debug_struct` returns: `field` per field, then `finish`.
## See [std-format.debug.builder.types-value](../../spec/std/format.md#r-std-format.debug.builder.types-value).
@derive(Debug)
pub struct DebugStruct:
    out: *mut DebugWriter
    count: usize
    shown: bool

impl DebugStruct:
    ## Adds one named field.
    ## See [std-format.debug.builder.struct](../../spec/std/format.md#r-std-format.debug.builder.struct).
    pub fn field[T < Debug](&mut self, name: string, value: T) -> &mut DebugStruct:
        self.part(name, value, dbg_nested::[T])

    fn part[T](
        &mut self,
        name: string,
        value: T,
        show: fn(T, *mut DebugWriter) -> void,
    ) -> &mut DebugStruct:
        if self.shown:
            self.out.struct_item(name, self.count)
            show(value, self.out)
            self.out.end_item()
        self.count = self.count + 1
        self

    ## Ends the value the builder writes.
    ## See [std-format.debug.builder.methods-local](../../spec/std/format.md#r-std-format.debug.builder.methods-local).
    pub fn finish(&mut self) -> void:
        if self.shown:
            self.out.struct_close(self.count)

## The builder `debug_tuple` returns: `field` per field, then `finish`.
## See [std-format.debug.builder.types-value](../../spec/std/format.md#r-std-format.debug.builder.types-value).
@derive(Debug)
pub struct DebugTuple:
    out: *mut DebugWriter
    count: usize
    unnamed: bool
    shown: bool

impl DebugTuple:
    ## Adds one positional field.
    ## See [std-format.debug.builder.tuple](../../spec/std/format.md#r-std-format.debug.builder.tuple).
    pub fn field[T < Debug](&mut self, value: T) -> &mut DebugTuple:
        self.part(value, dbg_nested::[T])

    fn part[T](&mut self, value: T, show: fn(T, *mut DebugWriter) -> void) -> &mut DebugTuple:
        if self.shown:
            self.out.tuple_item(self.count)
            show(value, self.out)
            self.out.end_item()
        self.count = self.count + 1
        self

    # A named field, written as the named argument `name=value` that follows
    # the positional fields of a call, as in `Shape.Mixed(1, label="a")`.
    ## Adds a named argument `name=value` after the positional fields.
    ## See [std-format.debug.builder.named-field](../../spec/std/format.md#r-std-format.debug.builder.named-field).
    pub fn named_field[T < Debug](&mut self, name: string, value: T) -> &mut DebugTuple:
        self.named_part(name, value, dbg_nested::[T])

    fn named_part[T](
        &mut self,
        name: string,
        value: T,
        show: fn(T, *mut DebugWriter) -> void,
    ) -> &mut DebugTuple:
        if self.shown:
            self.out.named_item(name, self.count)
            show(value, self.out)
            self.out.end_item()
        self.count = self.count + 1
        self

    # An unnamed one with no fields is the empty tuple, `()`.
    ## Ends the value the builder writes.
    ## See [std-format.debug.builder.methods-local](../../spec/std/format.md#r-std-format.debug.builder.methods-local).
    pub fn finish(&mut self) -> void:
        if self.shown:
            self.out.tuple_close(self.count, self.unnamed)

## The builder `debug_list` returns: `entry` per item, then `finish`.
## See [std-format.debug.builder.types-value](../../spec/std/format.md#r-std-format.debug.builder.types-value).
@derive(Debug)
pub struct DebugList:
    out: *mut DebugWriter
    count: usize
    shown: bool

impl DebugList:
    ## Adds one item.
    ## See [std-format.debug.builder.list](../../spec/std/format.md#r-std-format.debug.builder.list).
    pub fn entry[T < Debug](&mut self, value: T) -> &mut DebugList:
        if self.shown && self.out.entry_item(self.count, "["):
            value.debug(self.out)
            self.out.end_item()
        self.count = self.count + 1
        self

    ## Ends the value the builder writes.
    ## See [std-format.debug.builder.methods-local](../../spec/std/format.md#r-std-format.debug.builder.methods-local).
    pub fn finish(&mut self) -> void:
        if self.shown:
            self.out.entry_close(self.count, "[", "]")

## The builder `debug_map` returns: `entry` per pair, then `finish`.
## See [std-format.debug.builder.types-value](../../spec/std/format.md#r-std-format.debug.builder.types-value).
@derive(Debug)
pub struct DebugMap:
    out: *mut DebugWriter
    count: usize
    shown: bool

impl DebugMap:
    ## Adds one key-value pair.
    ## See [std-format.debug.builder.map](../../spec/std/format.md#r-std-format.debug.builder.map).
    pub fn entry[K < Debug, V < Debug](&mut self, key: K, value: V) -> &mut DebugMap:
        if self.shown && self.out.entry_item(self.count, "{"):
            key.debug(self.out)
            self.out.write(": ")
            value.debug(self.out)
            self.out.end_item()
        self.count = self.count + 1
        self

    ## Ends the value the builder writes.
    ## See [std-format.debug.builder.methods-local](../../spec/std/format.md#r-std-format.debug.builder.methods-local).
    pub fn finish(&mut self) -> void:
        if self.shown:
            self.out.entry_close(self.count, "{", "}")

# Keep handwritten Debug: show only accumulated text, not writer bookkeeping.
impl Debug for DebugWriter:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.debug_struct("DebugWriter").field("text", self.text()).finish()

# The standard `Display` implementations for `string` and the printable
# primitives (spec/lang/05-expressions.md#r-expr.interp.std): an integer's
# decimal digits, with `-` when negative; `true` or `false`; a `char`'s
# one-scalar string; a float's canonical text, which the host writes
# (spec/lang/04-type-system.md#numeric-display).
# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for string:
    fn to_string(self) -> string:
        self

# A reference displays as the value it refers to
# (r-std-format.display.reference), as Rust's `&T` does.
# Keep handwritten Display: delegate through the reference; structural derivation is for its referent.
impl[T < Display] Display for *T:
    fn to_string(self) -> string:
        (*self).to_string()

# Keep handwritten Display: delegate through the reference; structural derivation is for its referent.
impl[T < Display] Display for *mut T:
    fn to_string(self) -> string:
        (*self).to_string()

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for bool:
    fn to_string(self) -> string:
        if self: "true" else: "false"

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for char:
    fn to_string(self) -> string:
        scalar_text(i32(char_scalar(self)))

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for i8:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for i16:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for i32:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for i64:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for u8:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for u16:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for u32:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for usize:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for u64:
    fn to_string(self) -> string:
        format_int(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for f32:
    fn to_string(self) -> string:
        f32_text(self)

# Keep handwritten Display: implement the builtin scalar protocol, which has no derivable declaration.
impl Display for f64:
    fn to_string(self) -> string:
        f64_text(self)

# The one-scalar string of the Unicode scalar value `point`: its UTF-8
# encoding in one to four bytes.
fn scalar_text(point: i32) -> string:
    let mut encoded: List[u8] = []
    if point < 128:
        encoded.push(u8(point))
    else if point < 2048:
        encoded.push(u8(192 + point / 64))
        encoded.push(u8(128 + point % 64))
    else if point < 65536:
        encoded.push(u8(224 + point / 4096))
        encoded.push(u8(128 + point / 64 % 64))
        encoded.push(u8(128 + point % 64))
    else:
        encoded.push(u8(240 + point / 262144))
        encoded.push(u8(128 + point / 4096 % 64))
        encoded.push(u8(128 + point / 64 % 64))
        encoded.push(u8(128 + point % 64))
    string_from_bytes(encoded)

# Primitives (spec/std/README.md#standard-library-primitives). A `char` is
# its scalar value at run time; the host writes a float's text.
# `@intrinsic` is prototype-internal and accepted only in lib/std.

@intrinsic("char_scalar")
fn char_scalar(value: char) -> u32:
    panic("intrinsic")

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# An integer's decimal digits, with `-` when negative: the runtime writes
# them into one buffer.
@intrinsic("format_int")
fn format_int[N < Integer](value: N) -> string:
    panic("intrinsic")

@intrinsic("format_f64")
fn f64_text(value: f64) -> string:
    panic("intrinsic")

@intrinsic("format_f32")
fn f32_text(value: f32) -> string:
    panic("intrinsic")

# The standard `Debug` implementations (spec/lang/09-traits.md#r-trait.debug.std-impls).
# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for i32:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for i64:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for u8:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for i8:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for i16:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for u16:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for u32:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for usize:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for u64:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for f32:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for f64:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for bool:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("$self")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for char:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("'" + escape_char(self, '\'') + "'")

# Keep handwritten Debug: implement the builtin scalar protocol, which has no derivable declaration.
impl Debug for string:
    fn debug(self, out: *mut DebugWriter) -> void:
        out.write("\"" + escape_text(out.cut(self)) + "\"")

# Preserve runs of ordinary string text as slices; allocate fragments only
# for source escapes (r-std-format.debug.source.string). Character literals
# use escape_char directly with their own quote delimiter.
fn escape_text(text: string) -> string:
    let mut pieces: List[string] = []
    let start: usize = 0
    for (at, each) in text.char_indices():
        scalar := char_scalar(each)
        if each == '"' || each == '\\' || each == '$' || scalar < 32 || scalar == 127:
            if start < at:
                pieces.push(text.slice(start, at))
            pieces.push(escape_char(each, '"'))
            # Every escaped character above is one ASCII byte.
            start = at + 1
    if start == 0:
        return text
    if start < text.len():
        pieces.push(text.slice(start, text.len()))
    pieces.join("")

fn escape_char(each: char, quote: char) -> string:
    let scalar = char_scalar(each)
    if each == quote:
        return "\\" + scalar_text(i32(scalar))
    if each == '\\':
        return "\\\\"
    if each == '\n':
        return "\\n"
    if each == '\r':
        return "\\r"
    if each == '\t':
        return "\\t"
    if each == '\0':
        return "\\0"
    if each == '$' && quote == '"':
        return "\\$"
    if scalar < 32 || scalar == 127:
        return "\\u{" + format_int(scalar / 16) + hex_digit(scalar % 16) + "}"
    scalar_text(i32(scalar))

fn hex_digit(digit: u32) -> string:
    if digit < 10:
        return format_int(digit)
    scalar_text(i32(87 + digit))

# Keep handwritten Debug: render logical entries as collection syntax rather than storage fields.
impl[T < Debug] Debug for List[T]:
    fn debug(self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        for item in self:
            _ := list.entry(item)
        list.finish()

# A reference writes the value it refers to, with no trace of the
# reference (r-std-format.debug.reference), so a derived `Debug` prints a
# tree through its `&` links. A cycle runs until the stack is exhausted.
# Keep handwritten Debug: delegate through the reference; structural derivation is for its referent.
impl[T < Debug] Debug for *T:
    fn debug(self, out: *mut DebugWriter) -> void:
        value := *self
        value.debug(out)

# Keep handwritten Debug: delegate through the reference; structural derivation is for its referent.
impl[T < Debug] Debug for *mut T:
    fn debug(self, out: *mut DebugWriter) -> void:
        value := *self
        value.debug(out)

# Keep handwritten Debug: render builtin variants, which have no declaration to decorate.
impl[T < Debug] Debug for T?:
    fn debug(self, out: *mut DebugWriter) -> void:
        match self:
            .Some(value) => out.debug_tuple("Option.Some").field(value).finish()
            .None => out.write("Option.None")

# Keep handwritten Debug: render builtin variants, which have no declaration to decorate.
impl[T < Debug, E < Debug] Debug for Result[T, E]:
    fn debug(self, out: *mut DebugWriter) -> void:
        match self:
            .Ok(value) => out.debug_tuple("Result.Ok").field(value).finish()
            .Err(error) => out.debug_tuple("Result.Err").field(error).finish()

# Keep handwritten Debug: render logical entries as collection syntax rather than storage fields.
impl[K < Debug & Eq & Hash, V < Debug] Debug for Map[K, V]:
    fn debug(self, out: *mut DebugWriter) -> void:
        let mut map = out.debug_map()
        for (key, value) in self:
            _ := map.entry(key, value)
        map.finish()

# `debug(value)` (spec/lang/10-modules.md#r-module.prelude.debug): the text that
# `Debug` writes for `value` (spec/std/format.md#r-std-format.debug.render).
## Returns the text that `Debug` writes for `value`: stable, field by field, multi-line, and consistently indented.
## See [std-format.debug.render](../../spec/std/format.md#r-std-format.debug.render).
pub fn debug[T < Debug](value: T) -> string:
    # Boxed because Debug builder values store the writer in pointer fields.
    out := box(DebugWriter { parts: [], limited: false, pretty: false, depth: 0, active: [] })
    value.debug(out)
    out.text()

# `dbg` (spec/lang/10-modules.md#debug-printing) is an ordinary declaration:
# one signature for every call, of any arity, returning `void`. Only its body
# is intrinsic. The body that the emitter gives it prints nothing, which is
# what a fetched dependency runs (r-module.dbg.dependency). In the user's own
# code the checker swaps in the printing body, the functions below, which
# need each argument's static type and source text (checker/debug-print.ts).
@intrinsic("dbg")
## Prints each value's debug text with its source position, for troubleshooting; the compiler supplies its body.
## See [module.dbg.signature](../../spec/lang/10-modules.md#r-module.dbg.signature).
pub fn dbg[Args < Tuple](values...: Args) -> void:
    panic("intrinsic")

# Writes one `dbg` line to the program's debug output, which is no effect and
# needs no requirement (spec/lang/10-modules.md#r-module.dbg.no-requirement).
@intrinsic("dbg_write")
fn dbg_write(line: string) -> void:
    panic("intrinsic")

fn dbg_writer(pretty: bool) -> DebugWriter:
    DebugWriter { parts: [], limited: true, pretty: pretty, depth: 0, active: [] }

# The text of `value`, written by `show`, after `width` columns of its line:
# compact when the line fits in 80 columns, else pretty
# (spec/lang/10-modules.md#r-module.dbg.layout).
fn dbg_layout[T](width: usize, value: T, show: fn(T, *mut DebugWriter) -> void) -> string:
    # Boxed because Debug builder values store each writer in pointer fields.
    compact := box(dbg_writer(false))
    show(value, compact)
    compact_text := compact.text()
    if width + compact_text.len() <= 80 && !compact_text.contains("\n"):
        return compact_text
    # Boxed because Debug builder values store each writer in pointer fields.
    pretty := box(dbg_writer(true))
    show(value, pretty)
    pretty.text()

# `dbg(x)` where `head` is the line's location and `x`'s source text, and
# `show` the printer the checker generated for `x`'s type.
fn dbg_one[T](head: string, value: T, show: fn(T, *mut DebugWriter) -> void) -> T:
    dbg_write("$head = ${dbg_layout(head.len() + 3, value, show)}")
    value

# `dbg(x)` for a type that implements `Debug` (r-module.dbg.value.debug).
fn dbg_shown[T < Debug](head: string, value: T) -> T:
    dbg_one(head, value, fn(shown: T, out: *mut DebugWriter) -> void: shown.debug(out))

# `dbg(x)` whose value prints as `text`, such as `<T>` for a type parameter.
fn dbg_opaque[T](head: string, value: T, text: string) -> T:
    dbg_write("$head = $text")
    value

# One line of a `dbg` call that has no per-argument source text, or no call
# site at all: `prefix` is the location and `: `, or empty, then the value.
fn dbg_bare_one[T](prefix: string, value: T, show: fn(T, *mut DebugWriter) -> void) -> void:
    dbg_write("$prefix${dbg_layout(prefix.len(), value, show)}")

fn dbg_bare_shown[T < Debug](prefix: string, value: T) -> void:
    dbg_bare_one(prefix, value, fn(shown: T, out: *mut DebugWriter) -> void: shown.debug(out))

fn dbg_bare_opaque[T](prefix: string, value: T, text: string) -> void:
    dbg_write("$prefix$text")

# What every `dbg(...)` call of one or more arguments ends in: the printed
# values, as one value or a tuple of them, which the call then drops, so the
# call has the type `void` (r-module.dbg.signature).
fn dbg_done[T](printed: T) -> void:
    pass

# `dbg()`: its location alone (r-module.dbg.body.site).
fn dbg_here(head: string) -> void:
    dbg_write(head)

# Writes one line to the program's standard output through the runtime, not
# through `Console`, so it needs no requirement. Only the REPL's value line
# uses it.
@intrinsic("repl_write")
fn repl_write(line: string) -> void:
    panic("intrinsic")

# The REPL's value line (spec/cli/command-line.md#r-cli.repl.value): `text`,
# the value as `dbg` prints it, then ` : ` and its type. It goes to standard
# output (r-cli.repl.value.stream), after the input's own output and its `dbg`
# lines, which the host writes to standard error as they come: it holds
# standard output until a `dbg` line flushes it. It needs no requirement.
# The checker calls it for an input that is one expression.
fn repl_value(text: string, ty: string) -> void:
    repl_write("$text : $ty")

# A part whose type implements `Debug`, inside a generated printer.
fn dbg_nested[T < Debug](value: T, out: *mut DebugWriter) -> void:
    value.debug(out)

# Select an ordinary hd printer. Only this private body's type-directed
# selection is compiler supplied; it never renders or traverses a value.
@intrinsic("dbg_printer")
fn dbg_printer[T]() -> fn(T, *mut DebugWriter) -> void:
    panic("intrinsic")

fn dbg_option_printer[T](value: T?, out: *mut DebugWriter) -> void:
    dbg_option(value, out, dbg_printer::[T]())

fn dbg_result_printer[T, E](value: Result[T, E], out: *mut DebugWriter) -> void:
    dbg_result(value, out, dbg_printer::[T](), dbg_printer::[E]())

fn dbg_list_printer[T](value: List[T], out: *mut DebugWriter) -> void:
    dbg_list(value, out, dbg_printer::[T]())

fn dbg_map_printer[K < Eq & Hash, V](value: Map[K, V], out: *mut DebugWriter) -> void:
    dbg_map(value, out, dbg_printer::[K](), dbg_printer::[V]())

fn dbg_ref_printer[T](value: *T, out: *mut DebugWriter) -> void:
    if out.enter(value):
        dbg_printer::[T]()(*value, out)
        out.leave()

fn dbg_never[T](value: T, out: *mut DebugWriter) -> void:
    out.write("never")

fn dbg_handle[T](value: T, out: *mut DebugWriter) -> void:
    out.write("<handle>")

fn dbg_opaque_printer[T](name: string) -> fn(T, *mut DebugWriter) -> void:
    fn(value: T, out: *mut DebugWriter) -> void: out.write("<$name>")

# The built-in composites use selected printers for their parts.
fn dbg_option[E](value: E?, out: *mut DebugWriter, show: fn(E, *mut DebugWriter) -> void) -> void:
    match value:
        .Some(inner) =>
            if out.open():
                out.write("Option.Some")
                out.tuple_item(0)
                show(inner, out)
                out.end_item()
                out.tuple_close(1, false)
        .None => out.write("Option.None")

fn dbg_result[A, B](
    value: Result[A, B],
    out: *mut DebugWriter,
    show_ok: fn(A, *mut DebugWriter) -> void,
    show_err: fn(B, *mut DebugWriter) -> void,
) -> void:
    match value:
        .Ok(inner) =>
            if out.open():
                out.write("Result.Ok")
                out.tuple_item(0)
                show_ok(inner, out)
                out.end_item()
                out.tuple_close(1, false)
        .Err(inner) =>
            if out.open():
                out.write("Result.Err")
                out.tuple_item(0)
                show_err(inner, out)
                out.end_item()
                out.tuple_close(1, false)

# A list is a value, not tracked for cycles (r-module.dbg.cycle.untracked); a
# cycle passes through a reference, which `dbg_ref_printer` tracks.
fn dbg_list[E](
    value: List[E],
    out: *mut DebugWriter,
    show: fn(E, *mut DebugWriter) -> void,
) -> void:
    if out.open():
        let count: usize = 0
        for item in value:
            if out.entry_item(count, "["):
                show(item, out)
                out.end_item()
            count = count + 1
        out.entry_close(count, "[", "]")

fn dbg_map[K < Eq & Hash, V](
    value: Map[K, V],
    out: *mut DebugWriter,
    show_key: fn(K, *mut DebugWriter) -> void,
    show_value: fn(V, *mut DebugWriter) -> void,
) -> void:
    if out.open():
        let count: usize = 0
        for (key, item) in value:
            if out.entry_item(count, "{"):
                show_key(key, out)
                out.write(": ")
                show_value(item, out)
                out.end_item()
            count = count + 1
        out.entry_close(count, "{", "}")

# The REPL's forms of `dbg_one` and `dbg_shown`.
fn dbg_render[T](width: usize, value: T, show: fn(T, *mut DebugWriter) -> void) -> string:
    dbg_layout(width, value, show)

fn dbg_render_shown[T < Debug](width: usize, value: T) -> string:
    dbg_layout(width, value, fn(shown: T, out: *mut DebugWriter) -> void: shown.debug(out))

# This private template is instantiated only by dbg_printer. Unlike Debug's
# opt-in template, its members recursively select a printer without a bound.
trait DbgStructural:
    fn show(self, out: *mut DebugWriter) -> void

impl[T] DbgStructural for T by Structure:
    fn show(self, out: *mut DebugWriter) -> void:
        let mut shape = DebugShape::[T] { name: "", of_data: false, members: 0, positional: 0 }
        _ := Structure::walk(self, &mut shape)
        if shape.of_data && shape.name != "" && shape.positional == 0:
            let mut named = DbgNamed::[T] { fields: out.debug_struct(shape.name) }
            _ := Structure::walk(self, &mut named)
            named.fields.finish()
            return
        name := if shape.of_data: shape.name else: T::name() + "." + shape.name
        if !shape.of_data && shape.members == 0:
            out.write(name)
            return
        let mut fields = DbgFields::[T] { tuple: out.debug_tuple(name) }
        _ := Structure::walk(self, &mut fields)
        fields.tuple.finish()

struct DbgNamed[S]:
    pub fields: DebugStruct

impl[S] Walker[S] for DbgNamed[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        _ := self.fields.part(h.info.name, value, dbg_printer::[F]())
        .Ok(())

struct DbgFields[S]:
    pub tuple: DebugTuple

impl[S] Walker[S] for DbgFields[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        show := dbg_printer::[F]()
        if h.info.positional:
            _ := self.tuple.part(value, show)
        else:
            _ := self.tuple.named_part(h.info.name, value, show)
        .Ok(())

    fn rest[I](&mut self, h: Field[S, List[I]], items: List[I]) -> Result[void, never]:
        show := dbg_printer::[I]()
        for item in items:
            _ := self.tuple.part(item, show)
        .Ok(())

# Derived `Debug` (spec/std/format.md#r-std-format.debug.derive-builders.source):
# the value as hd source writes it. `debug_struct` for a data type, even a
# fieldless one. A variant is written qualified by its enum: the bare
# qualified name without members, else a call that `debug_tuple` builds,
# with positional members first and named ones as `name=value`. A first
# walk reads the variant and counts its members, so the builder is chosen
# before any field is written.
impl[T] Debug for T by Structure:
    fn debug(self, out: *mut DebugWriter) -> void:
        let mut shape = DebugShape::[T] { name: "", of_data: false, members: 0, positional: 0 }
        _ := Structure::walk(self, &mut shape)
        if shape.of_data:
            let mut named = DebugNamed::[T] { fields: out.debug_struct(shape.name) }
            _ := Structure::walk(self, &mut named)
            named.fields.finish()
            return
        qualified := T::name() + "." + shape.name
        if shape.members == 0:
            out.write(qualified)
            return
        let mut fields = DebugFields::[T] { tuple: out.debug_tuple(qualified) }
        _ := Structure::walk(self, &mut fields)
        fields.tuple.finish()

# Union `Debug`: the ordinary enum derivation with `Union._k` case names.
impl[T < UnionType] Debug for T by Structure:
    fn debug(self, out: *mut DebugWriter) -> void:
        let mut shape = DebugShape::[T] { name: "", of_data: false, members: 0, positional: 0 }
        _ := Structure::walk(self, &mut shape)
        qualified := T::name() + "." + shape.name
        let mut fields = DebugFields::[T] { tuple: out.debug_tuple(qualified) }
        _ := Structure::walk(self, &mut fields)
        fields.tuple.finish()

# The value's variant name, and how many of its members are positional.
# The fields are public because the prototype checks the instantiated
# walker in the program that uses it.
struct DebugShape[S]:
    pub name: string
    pub of_data: bool
    pub members: usize
    pub positional: usize

impl[S] Walker[S] for DebugShape[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        self.name = v.info.name
        self.of_data = v.info.of_data
        .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default).
    fn rest[T](&mut self, h: Field[S, List[T]], items: List[T]) -> Result[void, never]:
        self.member(h, items)

    fn member[F](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.members = self.members + 1
        if h.info.positional:
            self.positional = self.positional + 1
        .Ok(())

# Writes each member as a named field.
struct DebugNamed[S]:
    pub fields: DebugStruct

impl[S] Walker[S] for DebugNamed[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Debug` here, as `member` needs `F < Debug`.
    fn rest[T < Debug](&mut self, h: Field[S, List[T]], items: List[T]) -> Result[void, never]:
        self.member(h, items)

    fn member[F < Debug](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        _ := self.fields.field(h.info.name, value)
        .Ok(())

# Tuple `Debug` (spec/std/format.md#r-std-format.debug.tuple-template):
# `debug_tuple("")`, a field per element, then `finish`, at every size. The
# walker implements `rest`, so a rest element's items are fields too
# (spec/lang/09-traits.md#r-trait.debug.tuples.rest).
impl[T < Tuple] Debug for T by Structure:
    fn debug(self, out: *mut DebugWriter) -> void:
        let mut w = DebugFields::[T] { tuple: out.debug_tuple("") }
        _ := Structure::walk(self, &mut w)
        w.tuple.finish()

# Writes each member of a variant or tuple: a positional one as an argument,
# a named one as `name=value`.
# The field is public because the prototype checks the instantiated walker
# in the program that uses it.
struct DebugFields[S]:
    pub tuple: DebugTuple

impl[S] Walker[S] for DebugFields[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Debug](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        if h.info.positional:
            _ := self.tuple.field(value)
        else:
            _ := self.tuple.named_field(h.info.name, value)
        .Ok(())

    fn rest[I < Debug](&mut self, h: Field[S, List[I]], items: List[I]) -> Result[void, never]:
        for item in items:
            _ := self.tuple.field(item)
        .Ok(())

# Tuple `Display` (spec/lang/05-expressions.md#r-expr.interp.std.tuple.template):
# each element's text, separated by ", ", inside parentheses, at every
# size. One element ends with a comma, as in `(1,)`
# (r-expr.interp.std.tuple.one), and a rest element's items are written
# inline (r-expr.interp.std.tuple.rest-inline).
impl[T < Tuple] Display for T by Structure:
    fn to_string(self) -> string:
        let mut w = TupleText::[T] { parts: [] }
        _ := Structure::walk(self, &mut w)
        text := w.parts.join(", ")
        if w.parts.len() == 1:
            return "(${text},)"
        "(${text})"

# Each element's text, joined once at the end, since a rest element can
# hold any number of items. The field is public because the prototype
# checks the instantiated walker in the program that uses it.
struct TupleText[S]:
    pub parts: List[string]

impl[S] Walker[S] for TupleText[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F < Display](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        self.parts.push("$value")
        .Ok(())

    fn rest[I < Display](&mut self, h: Field[S, List[I]], items: List[I]) -> Result[void, never]:
        for item in items:
            self.parts.push("$item")
        .Ok(())

# `never` has no value, so none of these methods ever runs
# (r-std-text.parse.never-traits).
# Keep handwritten Display: this uninhabited builtin has no value or derivable declaration.
impl Display for never:
    fn to_string(self) -> string:
        match self:
            _ => panic("never has no value")

# Keep handwritten Debug: this uninhabited builtin has no value or derivable declaration.
impl Debug for never:
    fn debug(self, out: *mut DebugWriter) -> void:
        match self:
            _ => panic("never has no value")
