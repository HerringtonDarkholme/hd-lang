use std.meta.inline
pub use std.rt.{collection_capacity_sum}
use std.collections.list.list_reserve
use std.collections.sort.{DriftOrder, drift_sort}
use std.format.DebugWriter
use std.ops.FnMut
use std.hash.Hasher
use std.iter.{DoubleEndedIterator, ExactSizeIterator, Rev}
use std.iter.FromIterator
use std.ops.Index
use std.ops.IndexMut
use std.ops.IndexSet
use std.ops.Range
use std.rt.{Drop, unique}
use std.rt.{
    ByteBuffer,
    TextSink,
    bytes_len,
    format_signed,
    format_unsigned,
    panic_with,
    string_from_buffer,
}
use std.rt.{Buffer, Ptr, copy_bytes, load_u8, new_string, size_of, string_bytes}

## A uniquely owned growable list that may hold non-copyable elements.
## See [std-collections.uniq-list.type](../../../spec/std/collections.md#r-std-collections.uniq-list.type).
pub struct UniqList[T < ?Copy]:
    buffer: Buffer[T]
    len: usize

impl[T < ?Copy] !Copy for UniqList[T]

struct DriftByOrd:
    unused: bool

impl[T < ?Copy & Ord] DriftOrder[T] for DriftByOrd:
    @inline
    fn order(&mut self, left: &T, right: &T) -> Ordering:
        left.cmp(right)

struct DriftByFn[F < ?Copy]:
    compare: F

impl[T < ?Copy, F < ?Copy & FnMut(&T, &T) -> Ordering] DriftOrder[T] for DriftByFn[F]:
    fn order(&mut self, left: &T, right: &T) -> Ordering:
        (self.compare)(left, right)

# Orders `(key, value)` pairs by key alone, for `sort_by_key`.
struct DriftByKey:
    unused: bool

impl[K < Ord, T < ?Copy] DriftOrder[(K, T)] for DriftByKey:
    @inline
    fn order(&mut self, left: &(K, T), right: &(K, T)) -> Ordering:
        left._0.cmp(&right._0)

# The list drops the values it holds; its buffer then frees the room.
impl[T < ?Copy] Drop for UniqList[T]:
    fn drop(&mut self) -> void:
        let index: usize = 0
        while index < self.len:
            _ := self.buffer.at(index).read()
            index += 1

# String builders and JSON writers keep these bytes private: no element
# reference can pin their room. This internal trait needs no count check.
impl TextSink for UniqList[u8]:
    @inline(.Always)
    fn append_text(&mut self, text: string) -> void:
        size := bytes_len(text)
        if size == 0:
            return
        destination := self.spare(size)
        copy_bytes(destination.address, string_bytes(text).address, size)
        self.advance(size)

    @inline(.Never)
    fn append_signed(&mut self, value: i64) -> void:
        destination := self.spare(20)
        digits := format_signed(value, destination)
        copy_bytes(destination.address, destination.address + digits._0, digits._1)
        self.advance(digits._1)

    @inline(.Never)
    fn append_unsigned(&mut self, value: u64) -> void:
        destination := self.spare(20)
        digits := format_unsigned(value, destination)
        copy_bytes(destination.address, destination.address + digits._0, digits._1)
        self.advance(digits._1)

impl ByteBuffer for UniqList[u8]:
    @inline(.Never)
    fn push_byte(&mut self, byte: u8) -> void:
        self.spare(1).write(byte)
        self.advance(1)

    @inline(.Always)
    fn spare(&mut self, additional: usize) -> Ptr[u8]:
        if additional > self.buffer.capacity() - self.len:
            self.grow_bytes(additional)
        self.buffer.at(self.len)

    @inline(.Always)
    fn advance(&mut self, count: usize) -> void:
        self.len += count

    fn take_text(&mut self) -> string:
        size := self.len
        self.len = 0
        string_from_buffer(self.buffer.take(), size)

    fn copy_text(&self) -> string:
        out := new_string(self.len)
        copy_bytes(string_bytes(out).address, self.buffer.at(0).address, self.len)
        out

impl UniqList[u8]:
    @inline(.Never)
    fn grow_bytes(&mut self, additional: usize) -> void:
        minimum := collection_capacity_sum(self.len, additional)
        let capacity = self.buffer.capacity()
        if capacity == 0:
            capacity = 4
        while capacity < minimum:
            if capacity > 0x7fff0000:
                capacity = minimum
                break
            capacity *= 2
        self.buffer.grow(capacity)

impl[T < ?Copy] UniqList[T]:
    ## Returns an empty list with no reserved element capacity.
    ## See [std-collections.uniq-list.new](../../../spec/std/collections.md#r-std-collections.uniq-list.new).
    pub fn new() -> UniqList[T]:
        UniqList::[T].with_capacity(0)

    ## Returns an empty list with room for at least `capacity` elements before it grows.
    ## See [std-collections.uniq-list.new](../../../spec/std/collections.md#r-std-collections.uniq-list.new).
    pub fn with_capacity(capacity: usize) -> UniqList[T]:
        UniqList::[T] { buffer: Buffer::[T].new(capacity), len: 0 }

    ## Returns the number of elements in the list.
    ## See [std-collections.uniq-list.len](../../../spec/std/collections.md#r-std-collections.uniq-list.len).
    pub fn len(&self) -> usize:
        self.len

    ## True exactly when the list has no elements.
    ## See [std-collections.uniq-list.len](../../../spec/std/collections.md#r-std-collections.uniq-list.len).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    ## Returns the number of elements the current buffer can hold without growing.
    ## See [std-collections.uniq-list.capacity](../../../spec/std/collections.md#r-std-collections.uniq-list.capacity).
    pub fn capacity(&self) -> usize:
        self.buffer.capacity()

    ## Reserves room for at least `additional` more elements without changing the length.
    ## See [std-collections.uniq-list.reserve](../../../spec/std/collections.md#r-std-collections.uniq-list.reserve).
    pub fn reserve(&mut self, additional: usize) -> void:
        minimum := collection_capacity_sum(self.len, additional)
        if minimum > self.capacity():
            self.buffer.grow(minimum)

    ## Moves every item from `other` onto the end, in iteration order.
    ## See [std-collections.uniq-list.extend](../../../spec/std/collections.md#r-std-collections.uniq-list.extend).
    pub fn extend[I < ?Copy & Iterable[T]](&mut self, other: I) -> void:
        let mut cursor = other.iter()
        while true:
            match cursor.next():
                .Some(item) => self.push(item)
                .None => break

    ## Reverses the order of the elements in place.
    ## See [std-collections.uniq-list.reverse](../../../spec/std/collections.md#r-std-collections.uniq-list.reverse).
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn reverse(&mut self) -> void:
        let left: usize = 0
        let right = self.len
        while left < right:
            right -= 1
            self.swap(left, right)
            left += 1

    ## Moves the suffix starting at `at` into a new list, preserving this list's capacity.
    ## See [std-collections.uniq-list.split-off](../../../spec/std/collections.md#r-std-collections.uniq-list.split-off).
    pub fn split_off(&mut self, at: usize) -> UniqList[T]:
        if at > self.len:
            panic_with("index-out-of-bounds", "uniq list split_off index out of bounds")
        count := self.len - at
        let mut out = UniqList::[T].with_capacity(count)
        if count > 0:
            copy_bytes(out.buffer.at(0).address, self.buffer.at(at).address, count * size_of::[T]())
            self.len = at
            out.len = count
        out

    ## Moves all of `other` after this list's elements, leaving `other` empty with its capacity.
    ## See [std-collections.uniq-list.append](../../../spec/std/collections.md#r-std-collections.uniq-list.append).
    pub fn append(&mut self, other: &mut UniqList[T]) -> void:
        if other.len == 0:
            return
        self.reserve(other.len)
        copy_bytes(
            self.buffer.at(self.len).address,
            other.buffer.at(0).address,
            other.len * size_of::[T](),
        )
        self.len += other.len
        other.len = 0

    ## Borrows the list and moves the selected elements out through a cursor.
    ## See [std-collections.uniq-list.drain](../../../spec/std/collections.md#r-std-collections.uniq-list.drain).
    pub fn drain['a](&'a mut self, range: Range[usize]) -> UniqListDrain[T, 'a]:
        let end = range.end
        if range.inclusive:
            if end >= self.len:
                panic_with("index-out-of-bounds", "uniq list drain range out of bounds")
            end += 1
        if range.start > end || end > self.len:
            panic_with("index-out-of-bounds", "uniq list drain range out of bounds")
        tail := self.len - end
        self.len = range.start
        UniqListDrain { items: .Some(self), at: range.start, end: end, tail: tail, tail_start: end }

    ## Returns a shared reference to the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get-ref](../../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    @inline
    pub fn get_ref['a](&'a self, index: usize) -> (&'a T)?:
        if index >= self.len: .None else: .Some(self.buffer.at(index).as_ref())

    ## Returns a mutable reference to the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get-mut](../../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    @inline
    pub fn get_mut['a](&'a mut self, index: usize) -> (&'a mut T)?:
        if index >= self.len: .None else: .Some(self.buffer.at(index).as_mut())

    ## Returns a shared reference to the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-ref](../../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    pub fn first_ref['a](&'a self) -> (&'a T)?:
        self.get_ref(0)

    ## Returns a mutable reference to the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-mut](../../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    pub fn first_mut['a](&'a mut self) -> (&'a mut T)?:
        self.get_mut(0)

    ## Returns a shared reference to the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-ref](../../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    pub fn last_ref['a](&'a self) -> (&'a T)?:
        size := self.len()
        if size == 0: .None else: self.get_ref(size - 1)

    ## Returns a mutable reference to the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-mut](../../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    pub fn last_mut['a](&'a mut self) -> (&'a mut T)?:
        size := self.len()
        if size == 0: .None else: self.get_mut(size - 1)

    ## Returns a cursor that borrows and yields the list's elements in order.
    ## See [std-collections.uniq-list.iter](../../../spec/std/collections.md#r-std-collections.uniq-list.iter).
    pub fn iter['a](&'a self) -> UniqListIter[T, 'a]:
        UniqListIter { items: self, at: 0, end: self.len }

    ## Returns a reference to the first element for which `test` is true, or `.None`.
    ## See [std-collections.uniq-list.find-ref](../../../spec/std/collections.md#r-std-collections.uniq-list.find-ref).
    pub fn find_ref[F < ?Copy & FnMut(&T) -> bool, 'a](&'a self, mut test: F) -> (&'a T)?:
        let index: usize = 0
        while index < self.len():
            item := self.buffer.at(index).as_ref()
            if test(item):
                return .Some(item)
            index += 1
        .None

    ## True when `test` is true for at least one element, stopping at the first.
    ## See [std-collections.uniq-list.any-all.fn-mut](../../../spec/std/collections.md#r-std-collections.uniq-list.any-all.fn-mut).
    pub fn any[F < ?Copy & FnMut(&T) -> bool](&self, mut test: F) -> bool:
        let index: usize = 0
        while index < self.len():
            if test(self.buffer.at(index).as_ref()):
                return true
            index += 1
        false

    ## True when `test` is true for every element, stopping at the first false.
    ## See [std-collections.uniq-list.any-all.fn-mut](../../../spec/std/collections.md#r-std-collections.uniq-list.any-all.fn-mut).
    pub fn all[F < ?Copy & FnMut(&T) -> bool](&self, mut test: F) -> bool:
        let index: usize = 0
        while index < self.len():
            if !test(self.buffer.at(index).as_ref()):
                return false
            index += 1
        true

    # Moves every element into a larger room.
    fn reserve_for(&mut self, minimum: usize) -> void:
        current := self.buffer.capacity()
        if current >= minimum:
            return
        let capacity = if current == 0: 4 else: current * 2
        while capacity < minimum:
            capacity *= 2
        self.buffer.grow(capacity)

    ## Moves `value` onto the end of the list.
    ## See [std-collections.uniq-list.push](../../../spec/std/collections.md#r-std-collections.uniq-list.push).
    @inline
    pub fn push(&mut self, value: T) -> void:
        size := self.len()
        if self.buffer.capacity() <= size:
            self.reserve_for(size + 1)
        self.buffer.at(size).write(value)
        self.len = size + 1

    ## Moves and returns the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.push](../../../spec/std/collections.md#r-std-collections.uniq-list.push).
    pub fn pop(&mut self) -> T?:
        size := self.len()
        if size == 0:
            return .None
        value := self.buffer.at(size - 1).read()
        self.len = size - 1
        .Some(value)

    ## Moves `value` to `index` and shifts the later elements one place toward the end.
    ## See [std-collections.uniq-list.insert](../../../spec/std/collections.md#r-std-collections.uniq-list.insert).
    pub fn insert(&mut self, index: usize, value: T) -> void:
        size := self.len()
        if index > size:
            panic_with(
                "index-out-of-bounds",
                "uniq list insert index ${index} out of bounds for length ${size}",
            )
        if self.buffer.capacity() <= size:
            self.reserve_for(size + 1)
        if index < size:
            copy_bytes(
                self.buffer.at(index + 1).address,
                self.buffer.at(index).address,
                (size - index) * size_of::[T](),
            )
        self.buffer.at(index).write(value)
        self.len = size + 1

    ## Moves and returns the element at `index`, shifting later elements one place toward the start.
    ## See [std-collections.uniq-list.remove-indexed](../../../spec/std/collections.md#r-std-collections.uniq-list.remove-indexed).
    pub fn remove(&mut self, index: usize) -> T:
        size := self.len()
        if index >= size:
            panic_with(
                "index-out-of-bounds",
                "uniq list remove index ${index} out of bounds for length ${size}",
            )
        removed := self.buffer.at(index).read()
        if index + 1 < size:
            copy_bytes(
                self.buffer.at(index).address,
                self.buffer.at(index + 1).address,
                (size - index - 1) * size_of::[T](),
            )
        self.len = size - 1
        removed

    ## Exchanges the elements at `left` and `right` without copying either one.
    ## See [std-collections.uniq-list.swap](../../../spec/std/collections.md#r-std-collections.uniq-list.swap).
    pub fn swap(&mut self, left: usize, right: usize) -> void:
        size := self.len()
        if left >= size || right >= size:
            panic_with(
                "index-out-of-bounds",
                "uniq list swap indices ${left} and ${right} out of bounds for length ${size}",
            )
        if left == right:
            return
        left_value := self.buffer.at(left).read()
        right_value := self.buffer.at(right).read()
        self.buffer.at(left).write(right_value)
        self.buffer.at(right).write(left_value)

    ## Drops every element at `len` and after; a larger `len` has no effect.
    ## See [std-collections.uniq-list.truncate](../../../spec/std/collections.md#r-std-collections.uniq-list.truncate).
    pub fn truncate(&mut self, len: usize) -> void:
        while self.len() > len:
            index := self.len() - 1
            _ := self.buffer.at(index).read()
            self.len = index

    ## Drops every element, leaving the list empty.
    ## See [std-collections.uniq-list.truncate](../../../spec/std/collections.md#r-std-collections.uniq-list.truncate).
    pub fn clear(&mut self) -> void:
        self.truncate(0)

    ## Keeps the elements for which `keep` is true, in order, and drops the rest.
    ## See [std-collections.uniq-list.retain](../../../spec/std/collections.md#r-std-collections.uniq-list.retain).
    pub fn retain[F < ?Copy & FnMut(&T) -> bool](&mut self, mut keep: F) -> void:
        size := self.len()
        let kept: usize = 0
        let index: usize = 0
        while index < size:
            if keep(self.buffer.at(index).as_ref()):
                if kept != index:
                    value := self.buffer.at(index).read()
                    self.buffer.at(kept).write(value)
                kept += 1
            else:
                _ := self.buffer.at(index).read()
            index += 1
        self.len = kept

    ## Stably sorts the elements in ascending order by `compare`, in place.
    ## See [std-collections.uniq-list.sort](../../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort_by[F < ?Copy & FnMut(&T, &T) -> Ordering](&mut self, compare: F) -> void:
        let mut by = DriftByFn { compare: compare }
        drift_sort(&self.buffer, self.len, &mut by)

    ## Stably sorts the elements by `key(element)`, calling `key` once per element.
    ## See [std-collections.uniq-list.sort](../../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort_by_key[K < Ord, F < ?Copy & FnMut(&T) -> K](&mut self, mut key: F) -> void:
        size := self.len()
        if size == 0:
            return
        keys := Buffer::[K].new(size)
        let index: usize = 0
        while index < size:
            keys.at(index).write(key(self.buffer.at(index).as_ref()))
            index += 1
        let mut keyed = UniqList::[(K, T)].with_capacity(size)
        index = 0
        while index < size:
            keyed.push((keys.at(index).read(), self.buffer.at(index).read()))
            index += 1
        self.len = 0
        let mut compare_key = DriftByKey { unused: false }
        drift_sort(&keyed.buffer, keyed.len, &mut compare_key)
        # Drain by index so each element moves once, with no tail shifts.
        keyed.len = 0
        index = 0
        while index < size:
            let (_, item) = keyed.buffer.at(index).read()
            self.buffer.at(index).write(item)
            index += 1
        self.len = size

impl[T < ?Copy & Eq] UniqList[T]:
    ## True exactly when an element equals `value`.
    ## See [std-collections.uniq-list.contains](../../../spec/std/collections.md#r-std-collections.uniq-list.contains).
    pub fn contains(&self, value: &T) -> bool:
        self.index_of(value).is_some()

    ## Returns the index of the first equal element, or `.None`.
    ## See [std-collections.uniq-list.index-of](../../../spec/std/collections.md#r-std-collections.uniq-list.index-of).
    pub fn index_of(&self, value: &T) -> usize?:
        let index: usize = 0
        while index < self.len:
            if self.buffer.at(index).as_ref().eq(value):
                return .Some(index)
            index += 1
        .None

    ## Removes consecutive equal elements, keeping the first in each run.
    ## See [std-collections.uniq-list.dedup](../../../spec/std/collections.md#r-std-collections.uniq-list.dedup).
    pub fn dedup(&mut self) -> void:
        if self.len < 2:
            return
        let kept: usize = 1
        let index: usize = 1
        while index < self.len:
            if self.buffer.at(kept - 1).as_ref().eq(self.buffer.at(index).as_ref()):
                _ := self.buffer.at(index).read()
            else:
                if kept != index:
                    self.buffer.at(kept).write(self.buffer.at(index).read())
                kept += 1
            index += 1
        self.len = kept

impl[T < Copy] UniqList[T]:
    ## Copies the elements of `items`, in order, into a new uniquely owned list.
    ## See [std-collections.uniq-list.conversion](../../../spec/std/collections.md#r-std-collections.uniq-list.conversion).
    pub fn from_list(items: List[T]) -> UniqList[T]:
        let mut out = UniqList::[T].with_capacity(items.len())
        for item in items:
            out.push(item)
        out

    ## Copies the elements, in order, into a `List`.
    ## See [std-collections.uniq-list.conversion](../../../spec/std/collections.md#r-std-collections.uniq-list.conversion).
    pub fn to_list(&self) -> List[T]:
        let mut out: List[T] = []
        list_reserve(&mut out, self.len())
        let index: usize = 0
        while index < self.len():
            out.push(*self.buffer.at(index).as_ref())
            index += 1
        out

    ## Returns `.Some` of a copy of the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get](../../../spec/std/collections.md#r-std-collections.uniq-list.get).
    @inline
    pub fn get(&self, index: usize) -> T?:
        if index >= self.len: .None else: .Some(*self.buffer.at(index).as_ref())

    ## Returns a copy of the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.first-last](../../../spec/std/collections.md#r-std-collections.uniq-list.first-last).
    pub fn first(&self) -> T?:
        self.get(0)

    ## Returns a copy of the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.first-last](../../../spec/std/collections.md#r-std-collections.uniq-list.first-last).
    pub fn last(&self) -> T?:
        if self.is_empty(): .None else: self.get(self.len() - 1)

impl[T < ?Copy] Index[usize] for UniqList[T]:
    type Out = T
    fn index(&self, key: usize) -> &T:
        if key >= self.len():
            panic_with("index-out-of-bounds", "uniq list index out of bounds")
        self.buffer.at(key).as_ref()

impl[T < ?Copy] IndexMut[usize] for UniqList[T]:
    fn index_mut(&mut self, key: usize) -> &mut T:
        if key >= self.len():
            panic_with("index-out-of-bounds", "uniq list index out of bounds")
        self.buffer.at(key).as_mut()

impl[T < ?Copy] IndexSet[usize, T] for UniqList[T]:
    @inline
    fn index_set(&mut self, key: usize, value: T) -> void:
        if key >= self.len():
            panic_with("index-out-of-bounds", "uniq list index out of bounds")
        previous := self.buffer.at(key).read()
        self.buffer.at(key).write(value)
        _ := previous

impl[T < ?Copy & Ord] UniqList[T]:
    ## Searches a sorted list, returning a matching index or the insertion index.
    ## See [std-collections.uniq-list.binary-search](../../../spec/std/collections.md#r-std-collections.uniq-list.binary-search).
    pub fn binary_search(&self, value: &T) -> Result[usize, usize]:
        let left: usize = 0
        let right = self.len
        while left < right:
            middle := left + (right - left) / 2
            match self.buffer.at(middle).as_ref().cmp(value):
                .Less => left = middle + 1
                .Greater => right = middle
                .Equal => return .Ok(middle)
        .Err(left)

    ## Stably sorts the elements in ascending order by `Ord`, in place.
    ## See [std-collections.uniq-list.sort](../../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort(&mut self) -> void:
        let mut compare = DriftByOrd { unused: false }
        drift_sort(&self.buffer, self.len, &mut compare)

## A cursor that borrows a `UniqList` and yields its elements by reference.
## See [std-collections.uniq-list.iter](../../../spec/std/collections.md#r-std-collections.uniq-list.iter).
pub struct UniqListIter[T < ?Copy, 'a]:
    items: &'a UniqList[T]
    at: usize
    end: usize

impl[T < ?Copy, 'a] Iterator[&'a T] for UniqListIter[T, 'a]:
    fn next(&mut self) -> (&'a T)?:
        at := self.at
        if at >= self.end:
            return .None
        # `end` is the length when the cursor was made, and the shared
        # borrow keeps the list as it was, so `at` is in the list.
        self.at = at + 1
        .Some(self.items.buffer.at(at).as_ref())

## A borrowing cursor that moves a list range out and restores the remaining tail on drop.
## See [std-collections.uniq-list.drain](../../../spec/std/collections.md#r-std-collections.uniq-list.drain).
pub struct UniqListDrain[T < ?Copy, 'a]:
    items: (&'a mut UniqList[T])?
    at: usize
    end: usize
    tail: usize
    tail_start: usize

impl[T < ?Copy, 'a] !Copy for UniqListDrain[T, 'a]

impl[T < ?Copy, 'a] Iterator[T] for UniqListDrain[T, 'a]:
    fn next(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        match self.items:
            .Some(items) =>
                index := self.at
                self.at += 1
                .Some(items.buffer.at(index).read())
            .None => .None

impl[T < ?Copy, 'a] Drop for UniqListDrain[T, 'a]:
    fn drop(&mut self) -> void:
        match self.items:
            .Some(items) =>
                while self.at < self.end:
                    _ := items.buffer.at(self.at).read()
                    self.at += 1
                if self.tail > 0:
                    copy_bytes(
                        items.buffer.at(items.len).address,
                        items.buffer.at(self.tail_start).address,
                        self.tail * size_of::[T](),
                    )
                items.len += self.tail
                self.items = .None
            .None => pass

## The consuming cursor of a `UniqList`; it moves the elements out in order.
## See [std-collections.uniq-list.into-iter](../../../spec/std/collections.md#r-std-collections.uniq-list.into-iter).
pub struct UniqListIntoIter[T < ?Copy]:
    buffer: Buffer[T]
    at: usize
    end: usize

impl[T < ?Copy] !Copy for UniqListIntoIter[T]

# Only the unread range still owns values; Buffer frees the room afterward.
# Use a local index so collector trace passes leave the cursor unchanged.
impl[T < ?Copy] Drop for UniqListIntoIter[T]:
    fn drop(&mut self) -> void:
        let index = self.at
        while index < self.end:
            _ := self.buffer.at(index).read()
            index += 1

impl[T < ?Copy] Iterator[T] for UniqListIntoIter[T]:
    fn next(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        index := self.at
        self.at += 1
        .Some(self.buffer.at(index).read())

impl[T < ?Copy] Iterable[T] for UniqList[T]:
    type IntoIter = UniqListIntoIter[T]
    fn iter(self) -> UniqListIntoIter[T]:
        end := self.len
        UniqListIntoIter::[T] { buffer: self.buffer, at: 0, end: end }

impl[T < ?Copy] FromIterator[T] for UniqList[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> UniqList[T]:
        let mut cursor = items
        let mut out = UniqList::[T].new()
        while true:
            match cursor.next():
                .Some(item) => out.push(item)
                .None => break
        out

impl[T < ?Copy & Eq] Eq for UniqList[T]:
    fn eq(&self, other: &UniqList[T]) -> bool:
        if self.len() != other.len():
            return false
        let index: usize = 0
        while index < self.len():
            if !self.buffer.at(index).as_ref().eq(other.buffer.at(index).as_ref()):
                return false
            index += 1
        true

impl[T < ?Copy & Debug] Debug for UniqList[T]:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        let index: usize = 0
        while index < self.len():
            _ := list.entry(self.buffer.at(index).as_ref())
            index += 1
        list.finish()

impl[T < ?Copy & Hash] Hash for UniqList[T]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(self.len()))
        let index: usize = 0
        while index < self.len():
            self.buffer.at(index).as_ref().hash(state)
            index += 1

impl[T < ?Copy, 'a] DoubleEndedIterator[(&'a T)] for UniqListIter[T, 'a]:
    fn next_back(&mut self) -> (&'a T)?:
        if self.at >= self.end:
            return .None
        self.end -= 1
        .Some(self.items.buffer.at(self.end).as_ref())

impl[T < ?Copy, 'a] ExactSizeIterator[(&'a T)] for UniqListIter[T, 'a]:
    fn len(&self) -> usize:
        self.end - self.at

impl[T < ?Copy, 'a] UniqListIter[T, 'a]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, (&'a T)]:
        DoubleEndedIterator::[_]::rev(self)

impl[T < ?Copy, 'a] DoubleEndedIterator[T] for UniqListDrain[T, 'a]:
    fn next_back(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        match self.items:
            .Some(items) =>
                self.end -= 1
                .Some(items.buffer.at(self.end).read())
            .None => .None

impl[T < ?Copy, 'a] ExactSizeIterator[T] for UniqListDrain[T, 'a]:
    fn len(&self) -> usize:
        self.end - self.at

impl[T < ?Copy, 'a] UniqListDrain[T, 'a]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        DoubleEndedIterator::[T]::rev(self)

impl[T < ?Copy] DoubleEndedIterator[T] for UniqListIntoIter[T]:
    fn next_back(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        self.end -= 1
        .Some(self.buffer.at(self.end).read())

impl[T < ?Copy] ExactSizeIterator[T] for UniqListIntoIter[T]:
    fn len(&self) -> usize:
        self.end - self.at

impl[T < ?Copy] UniqListIntoIter[T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        DoubleEndedIterator::[T]::rev(self)

# A `Send` crossing makes each element or slot in use unique
# (fn.crossing.mode.unique): the buffer is raw memory, which the type's
# fields do not show.
fn unique_uniq_list[T < ?Copy](items: &mut UniqList[T]) -> void:
    let index: usize = 0
    while index < items.len:
        unique(items.buffer.at(index).as_mut())
        index += 1

impl[T] List[T]:
    ## Returns a new list in ascending order by `compare`. The sort is stable.
    ## See [std-collections.access.sorted-by](../../../spec/std/collections.md#r-std-collections.access.sorted-by).
    pub fn sorted_by[F < ?Copy & FnMut(&T, &T) -> Ordering](&self, compare: F) -> List[T]:
        if self.len() <= 1:
            return *self
        let mut sorted = UniqList::[T].from_list(*self)
        sorted.sort_by(compare)
        let mut out: List[T] = []
        list_reserve(&mut out, sorted.len())
        let index: usize = 0
        size := sorted.len
        sorted.len = 0
        while index < size:
            out.push(sorted.buffer.at(index).read())
            index += 1
        out

impl[T < Ord] List[T]:
    # A stable sort in ascending order.
    ## Returns the elements in ascending order by `Ord`.
    ## See [std-collections.helper.sorted](../../../spec/std/collections.md#r-std-collections.helper.sorted).
    pub fn sorted(&self) -> List[T]:
        if self.len() <= 1:
            return *self
        let mut sorted = UniqList::[T].from_list(*self)
        sorted.sort()
        let mut out: List[T] = []
        list_reserve(&mut out, sorted.len())
        let index: usize = 0
        size := sorted.len
        sorted.len = 0
        while index < size:
            out.push(sorted.buffer.at(index).read())
            index += 1
        out
