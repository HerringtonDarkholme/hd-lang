use std.collections.uniq_list.collection_capacity_sum
use std.function.FnMut
use std.iter.FromIterator
use std.ops.Index
use std.ops.IndexMut
use std.ops.IndexSet
use std.rt.map_hash_seed
use std.rt.{Drop, unique}
use std.rt.bytes.panic_with
use std.rt.hash.hash_key
use std.rt.memory.{Buffer, copy_bytes, fill, load_u32, load_u64, size_of, store_u8, store_u32}

enum UniqMapSlot[K < Eq & Hash, V < ?Copy]:
    Deleted
    Occupied(hash: usize, key: K, value: V)

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMapSlot[K, V]

## A uniquely owned hash map whose values may be non-copyable.
## See [std-collections.uniq-map.type](../../../spec/std/collections.md#r-std-collections.uniq-map.type).
pub struct UniqMap[K < Eq & Hash, V < ?Copy]:
    slots: Buffer[UniqMapSlot[K, V]]
    entry_capacity: usize
    size: usize
    # The slots in use from the start, deleted ones included.
    used: usize
    # Growth preserves the seed with the cached bucket hashes.
    seed: u64

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMap[K, V]

# The map drops the slots in use; its buffer then frees the room.
impl[K < Eq & Hash, V < ?Copy] Drop for UniqMap[K, V]:
    fn drop(&mut self) -> void:
        let index: usize = 0
        while index < self.used:
            _ := self.slots.at(index).read()
            index += 1

impl[K < Eq & Hash, V < ?Copy] UniqMap[K, V]:
    ## Returns an empty map.
    ## See [std-collections.uniq-map.new](../../../spec/std/collections.md#r-std-collections.uniq-map.new).
    pub fn new() -> UniqMap[K, V]:
        UniqMap::[K, V].allocate(8)

    ## Returns an empty map with room for at least `capacity` entries before growing.
    ## See [std-collections.uniq-map.with-capacity](../../../spec/std/collections.md#r-std-collections.uniq-map.with-capacity).
    pub fn with_capacity(capacity: usize) -> UniqMap[K, V]:
        UniqMap::[K, V].with_capacity_seeded(capacity, map_hash_seed())

    fn with_capacity_seeded(capacity: usize, seed: u64) -> UniqMap[K, V]:
        let room: usize = 0
        if capacity > 0:
            room = 8
            while room < capacity:
                match room.checked_mul(2):
                    .Some(next) => room = next
                    .None =>
                        panic_with(
                            "heap-exhausted",
                            "uniq map capacity does not fit the address space",
                        )
        # The probe index and slots must fit one buffer, including its header.
        slot_bytes := u64(size_of::[UniqMapSlot[K, V]]())
        index_bytes := u64(room) * 10
        slots := u64(room) + (index_bytes + slot_bytes - 1) / slot_bytes
        if slots * slot_bytes > 0xfffe0000:
            panic_with("heap-exhausted", "uniq map capacity does not fit the heap")
        UniqMap::[K, V].allocate_seeded(room, seed)

    fn allocate(capacity: usize) -> UniqMap[K, V]:
        UniqMap::[K, V].allocate_seeded(capacity, map_hash_seed())

    fn allocate_seeded(capacity: usize, seed: u64) -> UniqMap[K, V]:
        slot_bytes := size_of::[UniqMapSlot[K, V]]()
        index_slots := (capacity / 4 * 40 + slot_bytes - 1) / slot_bytes
        slots := Buffer::[UniqMapSlot[K, V]].new(capacity + index_slots)
        let mut map = UniqMap::[K, V] {
            slots: slots,
            entry_capacity: capacity,
            size: 0,
            used: 0,
            seed: seed,
        }
        map.clear_index()
        map

    ## Returns the number of entries in the map.
    ## See [std-collections.uniq-map.len](../../../spec/std/collections.md#r-std-collections.uniq-map.len).
    pub fn len(&self) -> usize:
        self.size

    ## True exactly when the map has no entries.
    ## See [std-collections.uniq-map.len](../../../spec/std/collections.md#r-std-collections.uniq-map.len).
    pub fn is_empty(&self) -> bool:
        self.size == 0

    ## Returns a shared reference to the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get-ref](../../../spec/std/collections.md#r-std-collections.uniq-map.get-ref).
    pub fn get_ref['a](&'a self, key: K) -> (&'a V)?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_ref():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

    ## Returns a mutable reference to the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get-mut](../../../spec/std/collections.md#r-std-collections.uniq-map.get-mut).
    pub fn get_mut['a](&'a mut self, key: K) -> (&'a mut V)?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_mut():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

    ## Returns a mutable reference to the value for `key`, inserting `default` when absent.
    ## See [std-collections.uniq-map.get-or-insert](../../../spec/std/collections.md#r-std-collections.uniq-map.get-or-insert).
    pub fn get_or_insert['a](&'a mut self, key: K, default: V) -> &'a mut V:
        if self.find_index(key).is_none():
            _ := self.insert(key, default)
        match self.get_mut(key):
            .Some(value) => value
            .None => panic("uniq map inserted key is absent")

    ## Returns a cursor that borrows the map and yields its entries.
    ## See [std-collections.uniq-map.iter](../../../spec/std/collections.md#r-std-collections.uniq-map.iter).
    pub fn iter['a](&'a self) -> UniqMapIter[K, V, 'a]:
        UniqMapIter { items: self, at: 0 }

    ## Returns a cursor that borrows the map and yields its values.
    ## See [std-collections.uniq-map.values](../../../spec/std/collections.md#r-std-collections.uniq-map.values).
    pub fn values['a](&'a self) -> UniqMapValues[K, V, 'a]:
        UniqMapValues { entries: self.iter() }

    ## Reserves room for at least `additional` new entries, preserving every entry.
    ## See [std-collections.uniq-map.reserve](../../../spec/std/collections.md#r-std-collections.uniq-map.reserve).
    pub fn reserve(&mut self, additional: usize) -> void:
        minimum := collection_capacity_sum(self.size, additional)
        if additional <= self.entry_capacity - self.used:
            return
        capacity := if minimum > self.entry_capacity: minimum else: self.entry_capacity
        self.rehash(UniqMap::[K, V].with_capacity_seeded(capacity, self.seed))

    ## Keeps the entries accepted by `keep`, which may change their values in place.
    ## See [std-collections.uniq-map.retain.fn-mut](../../../spec/std/collections.md#r-std-collections.uniq-map.retain.fn-mut).
    pub fn retain[F < ?Copy & FnMut(&K, &mut V) -> bool](&mut self, mut keep: F) -> void:
        was_nonempty := self.size != 0
        let index: usize = 0
        while index < self.used:
            place := self.slots.at(index)
            accepted := match place.as_mut():
                .Occupied(_, key, value) => keep(&key, value)
                .Deleted => true
            if !accepted:
                _ := place.read()
                place.write(.Deleted)
                self.size -= 1
            index += 1
        if was_nonempty && self.size == 0:
            self.seed = map_hash_seed()

    ## Moves each key-value pair into the map; a later equal key replaces the former value.
    ## See [std-collections.uniq-map.extend](../../../spec/std/collections.md#r-std-collections.uniq-map.extend).
    pub fn extend[I < ?Copy & Iterable[(K, V)]](&mut self, other: I) -> void:
        let mut cursor = other.iter()
        while true:
            match cursor.next():
                .Some((key, value)) => _ := self.insert(key, value)
                .None => break

    ## Borrows the map and moves every entry out, retaining its allocation.
    ## See [std-collections.uniq-map.drain](../../../spec/std/collections.md#r-std-collections.uniq-map.drain).
    pub fn drain['a](&'a mut self) -> UniqMapDrain[K, V, 'a]:
        end := self.used
        if self.size != 0:
            self.seed = map_hash_seed()
        self.size = 0
        self.used = 0
        UniqMapDrain { items: .Some(self), at: 0, end: end }

    ## Returns a cursor that borrows the map and yields its keys.
    ## See [std-collections.uniq-map.keys](../../../spec/std/collections.md#r-std-collections.uniq-map.keys).
    pub fn keys['a](&'a self) -> UniqMapKeys[K, V, 'a]:
        UniqMapKeys { entries: self.iter() }

    # The index follows the entries (#1711): a quarter of their capacity
    # in Swiss groups of 40 bytes, so twice the capacity in slots, and a
    # probe always meets an empty one. A group is an 8-byte control word,
    # each byte 0x80 when its slot is empty, else the low 7 bits of its
    # entry's hash, then the 8 slots' u32 entry numbers. The hash's other
    # bits pick the first group. A probe tests the whole control word
    # against the hash's 7 bits at once (Go's `matchH2`,
    # `internal/runtime/maps/group.go`) and loads only matching entries;
    # a group with an empty slot ends it.
    fn index_base(&self) -> usize:
        self.slots.at(self.entry_capacity).address

    # Marks every index slot empty.
    fn clear_index(&mut self) -> void:
        fill(self.index_base(), 128, self.entry_capacity / 4 * 40)

    fn group_mask(&self) -> usize:
        self.entry_capacity / 4 - 1

    # The index of `key`, borrowing every probed slot rather than moving it.
    fn find_index(&self, key: K) -> usize?:
        if self.entry_capacity == 0:
            return .None
        gmask := self.group_mask()
        base := self.index_base()
        hash := usize(hash_key(key, self.seed))
        pattern := u64(hash & 127) * 0x0101010101010101
        let g = (hash >> 7) & gmask
        while true:
            at := base + g * 40
            ctrl := load_u64(at)
            v := ctrl ^ pattern
            let m = v.wrapping_sub(0x0101010101010101) & ~v & 0x8080808080808080
            while m != 0:
                entry := usize(load_u32(at + 8 + (usize(m.trailing_zeros()) >> 3) * 4))
                match self.slots.at(entry).as_ref():
                    .Deleted => pass
                    .Occupied(found_hash, found, _) =>
                        if found_hash == hash && found == key:
                            return .Some(entry)
                m = m & (m - 1)
            if ctrl & 0x8080808080808080 != 0:
                return .None
            g = (g + 1) & gmask

    # Adds one occupied entry to this freshly allocated table's index.
    fn index_entry(&mut self, hash: usize, entry: usize) -> void:
        gmask := self.group_mask()
        base := self.index_base()
        let g = (hash >> 7) & gmask
        while true:
            at := base + g * 40
            empties := load_u64(at) & 0x8080808080808080
            if empties != 0:
                j := usize(empties.trailing_zeros()) >> 3
                store_u8(at + j, u8(hash & 127))
                store_u32(at + 8 + j * 4, u32(entry))
                return
            g = (g + 1) & gmask

    ## Moves `value` into the entry for `key`; returns the replaced value, or `.None` for a new key.
    ## See [std-collections.uniq-map.insert](../../../spec/std/collections.md#r-std-collections.uniq-map.insert).
    pub fn insert(&mut self, key: K, value: V) -> V?:
        if self.used == self.entry_capacity:
            self.grow()
        gmask := self.group_mask()
        base := self.index_base()
        hash := usize(hash_key(key, self.seed))
        pattern := u64(hash & 127) * 0x0101010101010101
        let g = (hash >> 7) & gmask
        while true:
            at := base + g * 40
            ctrl := load_u64(at)
            v := ctrl ^ pattern
            let m = v.wrapping_sub(0x0101010101010101) & ~v & 0x8080808080808080
            while m != 0:
                entry := usize(load_u32(at + 8 + (usize(m.trailing_zeros()) >> 3) * 4))
                match self.slots.at(entry).as_ref():
                    .Deleted => pass
                    .Occupied(found_hash, found, _) =>
                        if found_hash == hash && found == key:
                            place := self.slots.at(entry)
                            match place.read():
                                .Occupied(matched_hash, matched, old) =>
                                    place.write(.Occupied(matched_hash, matched, value))
                                    return .Some(old)
                                .Deleted => panic("uniq map matched a deleted entry")
                m = m & (m - 1)
            empties := ctrl & 0x8080808080808080
            if empties != 0:
                j := usize(empties.trailing_zeros()) >> 3
                entry := self.used
                self.slots.at(entry).write(.Occupied(hash, key, value))
                self.used = entry + 1
                store_u8(at + j, u8(hash & 127))
                store_u32(at + 8 + j * 4, u32(entry))
                self.size += 1
                return .None
            g = (g + 1) & gmask

    fn grow(&mut self) -> void:
        old_capacity := self.entry_capacity
        capacity := if old_capacity == 0:
            8
        else if self.size * 2 < old_capacity:
            old_capacity
        else:
            old_capacity * 2
        self.rehash(UniqMap::[K, V].allocate_seeded(capacity, self.seed))

    fn rehash(&mut self, next: UniqMap[K, V]) -> void:
        let mut next = next
        let index: usize = 0
        while index < self.used:
            let hash: usize? = match self.slots.at(index).as_ref():
                .Occupied(found, _, _) => .Some(found)
                .Deleted => .None
            match hash:
                .Some(found) =>
                    entry := next.used
                    copy_bytes(
                        next.slots.at(entry).address,
                        self.slots.at(index).address,
                        size_of::[UniqMapSlot[K, V]](),
                    )
                    next.used = entry + 1
                    next.index_entry(found, entry)
                    next.size += 1
                .None => pass
            index += 1
        self.used = 0
        *self = next

    ## True exactly when the map has an entry whose key equals `key`.
    ## See [std-collections.uniq-map.contains-key](../../../spec/std/collections.md#r-std-collections.uniq-map.contains-key).
    pub fn contains_key(&self, key: K) -> bool:
        self.find_index(key).is_some()

    ## Removes the entry for `key` and moves out its value, or returns `.None` when absent.
    ## See [std-collections.uniq-map.remove](../../../spec/std/collections.md#r-std-collections.uniq-map.remove).
    pub fn remove(&mut self, key: K) -> V?:
        match self.find_index(key):
            .None => .None
            .Some(index) =>
                place := self.slots.at(index)
                match place.read():
                    .Occupied(_, _, value) =>
                        place.write(.Deleted)
                        self.size -= 1
                        if self.size == 0:
                            self.seed = map_hash_seed()
                        .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")

    ## Removes every entry and drops every value.
    ## See [std-collections.uniq-map.clear](../../../spec/std/collections.md#r-std-collections.uniq-map.clear).
    pub fn clear(&mut self) -> void:
        capacity := self.entry_capacity
        seed := if self.size == 0: self.seed else: map_hash_seed()
        *self = UniqMap::[K, V].allocate_seeded(capacity, seed)

impl[K < Eq & Hash, V < Copy] UniqMap[K, V]:
    ## Returns a copy of the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get](../../../spec/std/collections.md#r-std-collections.uniq-map.get).
    pub fn get(&self, key: K) -> V?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_ref():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

## A cursor that borrows a `UniqMap` and yields its keys and value references.
## See [std-collections.uniq-map.iter](../../../spec/std/collections.md#r-std-collections.uniq-map.iter).
pub struct UniqMapIter[K < Eq & Hash, V < ?Copy, 'a]:
    items: &'a UniqMap[K, V]
    at: usize

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[(K, &'a V)] for UniqMapIter[K, V, 'a]:
    fn next(&mut self) -> (K, &'a V)?:
        while self.at < self.items.used:
            index := self.at
            self.at += 1
            match self.items.slots.at(index).as_ref():
                .Occupied(_, key, value) => return .Some((key, value))
                .Deleted => pass
        .None

## A cursor that borrows a `UniqMap` and yields its keys.
## See [std-collections.uniq-map.keys](../../../spec/std/collections.md#r-std-collections.uniq-map.keys).
pub struct UniqMapKeys[K < Eq & Hash, V < ?Copy, 'a]:
    entries: UniqMapIter[K, V, 'a]

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[K] for UniqMapKeys[K, V, 'a]:
    fn next(&mut self) -> K?:
        match self.entries.next():
            .Some((key, _)) => .Some(key)
            .None => .None

## A cursor that borrows a `UniqMap` and yields references to its values.
## See [std-collections.uniq-map.values](../../../spec/std/collections.md#r-std-collections.uniq-map.values).
pub struct UniqMapValues[K < Eq & Hash, V < ?Copy, 'a]:
    entries: UniqMapIter[K, V, 'a]

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[&'a V] for UniqMapValues[K, V, 'a]:
    fn next(&mut self) -> (&'a V)?:
        match self.entries.next():
            .Some((_, value)) => .Some(value)
            .None => .None

## A borrowing cursor that moves all entries out and drops any unvisited entries.
## See [std-collections.uniq-map.drain](../../../spec/std/collections.md#r-std-collections.uniq-map.drain).
pub struct UniqMapDrain[K < Eq & Hash, V < ?Copy, 'a]:
    items: (&'a mut UniqMap[K, V])?
    at: usize
    end: usize

impl[K < Eq & Hash, V < ?Copy, 'a] !Copy for UniqMapDrain[K, V, 'a]

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[(K, V)] for UniqMapDrain[K, V, 'a]:
    fn next(&mut self) -> (K, V)?:
        match self.items:
            .Some(items) =>
                while self.at < self.end:
                    index := self.at
                    self.at += 1
                    match items.slots.at(index).read():
                        .Occupied(_, key, value) => return .Some((key, value))
                        .Deleted => pass
            .None => pass
        .None

impl[K < Eq & Hash, V < ?Copy, 'a] Drop for UniqMapDrain[K, V, 'a]:
    fn drop(&mut self) -> void:
        match self.items:
            .Some(items) =>
                while self.at < self.end:
                    _ := items.slots.at(self.at).read()
                    self.at += 1
                items.clear_index()
                self.items = .None
            .None => pass

## The consuming cursor of a `UniqMap`; it moves each key and value out.
## See [std-collections.uniq-map.into-iter](../../../spec/std/collections.md#r-std-collections.uniq-map.into-iter).
pub struct UniqMapIntoIter[K < Eq & Hash, V < ?Copy]:
    items: UniqMap[K, V]
    at: usize

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMapIntoIter[K, V]

impl[K < Eq & Hash, V < ?Copy] Iterator[(K, V)] for UniqMapIntoIter[K, V]:
    fn next(&mut self) -> (K, V)?:
        while self.at < self.items.used:
            index := self.at
            self.at += 1
            place := self.items.slots.at(index)
            match place.read():
                .Occupied(_, key, value) =>
                    place.write(.Deleted)
                    self.items.size -= 1
                    return .Some((key, value))
                .Deleted => place.write(.Deleted)
        .None

impl[K < Eq & Hash, V < ?Copy] Iterable[(K, V)] for UniqMap[K, V]:
    type IntoIter = UniqMapIntoIter[K, V]
    fn iter(self) -> UniqMapIntoIter[K, V]:
        UniqMapIntoIter { items: self, at: 0 }

impl[K < Eq & Hash, V < ?Copy] FromIterator[(K, V)] for UniqMap[K, V]:
    fn from_iter[I < ?Copy & Iterator[(K, V)]](items: I) -> UniqMap[K, V]:
        let mut cursor = items
        let mut out = UniqMap::[K, V].new()
        while true:
            match cursor.next():
                .Some((key, value)) => _ := out.insert(key, value)
                .None => break
        out

impl[K < Eq & Hash, V < ?Copy] Index[K] for UniqMap[K, V]:
    type Out = V
    fn index(&self, key: K) -> &V:
        match self.get_ref(key):
            .Some(value) => value
            .None =>
                panic_with("index-out-of-bounds", "uniq map key is absent")
                panic("unreachable after missing-key panic")

impl[K < Eq & Hash, V < ?Copy] IndexMut[K] for UniqMap[K, V]:
    fn index_mut(&mut self, key: K) -> &mut V:
        match self.get_mut(key):
            .Some(value) => value
            .None =>
                panic_with("index-out-of-bounds", "uniq map key is absent")
                panic("unreachable after missing-key panic")

impl[K < Eq & Hash, V < ?Copy] IndexSet[K, V] for UniqMap[K, V]:
    fn index_set(&mut self, key: K, value: V) -> void:
        _ := self.insert(key, value)

fn unique_uniq_map[K < Eq & Hash, V < ?Copy](entries: &mut UniqMap[K, V]) -> void:
    let index: usize = 0
    while index < entries.used:
        unique(entries.slots.at(index).as_mut())
        index += 1
