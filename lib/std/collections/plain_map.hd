# std.collections.plain_map: a copy-on-write hash map over one counted
# block (#2369 step 1), the shape `Map[K, V]` moves to. Not yet `Map`.
#
# The map is one `*MapHead[K, V]`, the builtin map's table (crates/hd_wasm/
# src/map.rs): the entries in the order they were written, each with its
# hash, a removed one's hash `GONE`; and an index of Swiss groups over
# them, twice the entry capacity in slots, so a probe always meets an
# empty slot and runs at a load of at most one half. A group is 8 control
# bytes (`EMPTY`, or a hash's low 7 bits) and 8 `u32` entry numbers; a
# probe tests its 8 bytes at once (hashbrown's portable group, Go's
# `matchH2`) and reads an entry's hash only where its byte matches. The
# tail holds the index, the hashes and the entries, in that order. Full
# entries grow the table: the live entries move in order and the index is
# rebuilt. A copy is a retain; a change of a shared block copies it on a
# cold path. Every empty map shares the static empty block (count 0,
# capacity 0).
use std.meta.inline
use std.ops.FromMapLiteral
use std.rt.{Drop, Ptr, address_of, align_of, alloc_counted, copy_bytes, empty_block, fill, is_unique, load_u32, load_u64, map_hash_seed, needs_drop, size_of, store_u32, store_u8, tail_of}

EMPTY := u8(0x80)
GONE := u32(0xffffffff)
GROUP := usize(40)
LO := u64(0x0101010101010101)
HI := u64(0x8080808080808080)

## A map block's header.
struct MapHead[K, V]:
    len: usize
    # The entries written, removed ones included.
    used: usize
    # The entry capacity: 0, or a power of two of at least 4.
    cap: usize
    spare: usize
    seed: u64
    # Never read: its type names the entries, so the cycle analysis and
    # markers read them as the header's parts.
    entries: Ptr[Slot[K, V]]

impl[K, V] !Copy for MapHead[K, V]

struct Slot[K, V]:
    key: K
    value: V

# The tail's regions for capacity `cap`, from the index's address: the
# hashes after `cap / 4` groups, then the entries at their alignment.
@inline(.Always)
fn hashes_of(index: usize, cap: usize) -> usize:
    index + cap / 4 * GROUP

@inline(.Always)
fn entries_of[K, V](index: usize, cap: usize) -> Ptr[Slot[K, V]]:
    a := align_of::[Slot[K, V]]()
    Ptr::[Slot[K, V]] { address: (hashes_of(index, cap) + cap * 4 + a - 1) & ~(a - 1) }

# Index slot `p` (8 per group) names entry `e`, whose hash is `h`.
@inline(.Always)
fn set_slot(index: usize, p: usize, h: u32, e: usize) -> void:
    at := index + p / 8 * GROUP
    store_u8(at + p % 8, u8(h & 0x7f))
    store_u32(at + 8 + p % 8 * 4, u32(e))

# The first empty index slot on `h`'s probe sequence.
@inline(.Always)
fn first_empty(index: usize, cap: usize, h: u32) -> usize:
    gmask := cap / 4 - 1
    let mut g = usize(h >> 7) & gmask
    while true:
        empties := load_u64(index + g * GROUP) & HI
        if empties != 0:
            return g * 8 + usize(empties.trailing_zeros() >> 3)
        g = (g + 1) & gmask
    0

impl[K, V] Drop for MapHead[K, V]:
    # The block's last release: its live entries go with it, once. The
    # collector's trace runs this glue too.
    fn drop(&mut self) -> void:
        if needs_drop::[Slot[K, V]]() && self.len != 0:
            index := address_of(self) + size_of::[MapHead[K, V]]()
            hashes := hashes_of(index, self.cap)
            entries := entries_of::[K, V](index, self.cap)
            n := self.used
            let mut e: usize = 0
            while e < n:
                if load_u32(hashes + e * 4) != GONE:
                    _ := entries.offset(e).read()
                e += 1

## A copy-on-write hash map over one counted block.
pub struct PlainMap[K < Eq & Hash, V]:
    block: *MapHead[K, V]

impl[K < Eq & Hash, V] PlainMap[K, V]:
    ## An empty map; it allocates nothing.
    pub fn new() -> PlainMap[K, V]:
        PlainMap::[K, V] { block: empty_block::[MapHead[K, V]]() }

    ## An empty map with room for `capacity` entries before it grows.
    pub fn with_capacity(capacity: usize) -> PlainMap[K, V]:
        if capacity == 0:
            return PlainMap::[K, V].new()
        let mut cap: usize = 4
        while cap < capacity:
            cap *= 2
        block := PlainMap::[K, V].alloc(cap, 0, map_hash_seed())
        fill(tail_of(block, 8).address, EMPTY, cap / 4 * GROUP)
        PlainMap::[K, V] { block: block }

    # A block of entry capacity `cap` with `len` live entries and none
    # written; its index is not filled.
    fn alloc(cap: usize, len: usize, seed: u64) -> *MapHead[K, V]:
        alloc_counted::[MapHead[K, V]](
            MapHead::[K, V] { len: len, used: 0, cap: cap, spare: 0, seed: seed, entries: Ptr::[Slot[K, V]] { address: 0 } },
            cap / 4 * GROUP + cap * 4 + align_of::[Slot[K, V]]() + cap * size_of::[Slot[K, V]](),
            8,
        )

    # The header's place: write through it only to a unique block.
    @inline(.Always)
    fn head(&self) -> Ptr[MapHead[K, V]]:
        Ptr::[MapHead[K, V]] { address: self.index() - size_of::[MapHead[K, V]]() }

    @inline(.Always)
    pub fn len(&self) -> usize:
        self.block.len

    @inline(.Always)
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    # The index starts right after the header (its size is a multiple of
    # 8, so the payload's 8 past 16 keeps the groups 8-aligned).
    @inline(.Always)
    fn index(&self) -> usize:
        tail_of(self.block, 8).address

    # `key`'s bucket hash: 31 bits, so no hash is `GONE`.
    @inline(.Always)
    fn hash(&self, key: K) -> u32:
        key.hash_one(self.block.seed) & 0x7fffffff

    # `key`'s entry number below the capacity, or else the capacity plus
    # the first empty index slot on its probe sequence. The capacity is
    # not 0.
    @inline(.Always)
    fn probe(&self, key: K, h: u32) -> usize:
        cap := self.block.cap
        index := self.index()
        hashes := hashes_of(index, cap)
        entries := entries_of::[K, V](index, cap)
        gmask := cap / 4 - 1
        tag := u64(h & 0x7f) * LO
        let mut g = usize(h >> 7) & gmask
        while true:
            at := index + g * GROUP
            ctrl := load_u64(at)
            x := ctrl ^ tag
            let mut bits = x.wrapping_sub(LO) & ~x & HI
            while bits != 0:
                e := usize(load_u32(at + 8 + usize(bits.trailing_zeros() >> 3) * 4))
                if load_u32(hashes + e * 4) == h && entries.offset(e).as_ref().key == key:
                    return e
                bits = bits & bits.wrapping_sub(1)
            empties := ctrl & HI
            if empties != 0:
                return cap + g * 8 + usize(empties.trailing_zeros() >> 3)
            g = (g + 1) & gmask
        0

    ## The value for `key`, a copy, if the map has one.
    pub fn get(&self, key: K) -> V?:
        if self.len() == 0:
            return .None
        e := self.probe(key, self.hash(key))
        if e >= self.block.cap:
            return .None
        .Some(entries_of::[K, V](self.index(), self.block.cap).offset(e).as_ref().value)

    ## Whether the map has a value for `key`.
    pub fn contains_key(&self, key: K) -> bool:
        self.len() != 0 && self.probe(key, self.hash(key)) < self.block.cap

    ## Inserts or replaces; a shared block is copied first. One probe finds
    ## the key's entry or, on a miss, the index slot the new entry takes.
    pub fn insert(&mut self, key: K, value: V) -> void:
        if !is_unique(self.block):
            self.block = PlainMap::[K, V].rebuilt(self.block, false, false)
        h := self.hash(key)
        let mut cap = self.block.cap
        found := self.probe(key, h)
        if found < cap:
            entries_of::[K, V](self.index(), cap).offset(found).as_mut().value = value
            return
        let mut slot = found - cap
        if self.block.used == cap:
            self.block = PlainMap::[K, V].rebuilt(self.block, true, true)
            cap = self.block.cap
            slot = first_empty(self.index(), cap, h)
        index := self.index()
        head := self.head().as_mut()
        e := head.used
        store_u32(hashes_of(index, cap) + e * 4, h)
        entries_of::[K, V](index, cap).offset(e).write(Slot::[K, V] { key: key, value: value })
        set_slot(index, slot, h, e)
        head.used = e + 1
        head.len += 1

    ## Removes `key`'s entry and gives its value, if the map has one. The
    ## entry's hash becomes `GONE`; the next growth drops it.
    pub fn remove(&mut self, key: K) -> V?:
        if self.len() == 0:
            return .None
        e := self.probe(key, self.hash(key))
        if e >= self.block.cap:
            return .None
        if !is_unique(self.block):
            # A copy keeps every entry's number.
            self.block = PlainMap::[K, V].rebuilt(self.block, false, false)
        index := self.index()
        cap := self.block.cap
        store_u32(hashes_of(index, cap) + e * 4, GONE)
        self.head().as_mut().len -= 1
        slot := entries_of::[K, V](index, cap).offset(e).read()
        .Some(slot.value)

    ## A cursor yielding each entry's key and value by copy, in the order
    ## they were written.
    pub fn iter['a](&'a self) -> PlainMapIter[K, V, 'a]:
        index := self.index()
        cap := self.block.cap
        PlainMapIter { map: self, hashes: hashes_of(index, cap), entries: entries_of::[K, V](index, cap), at: 0, end: self.block.used }

    # A unique block in place of `old`, which the caller replaces with it.
    # `grow` moves the live entries in order into a capacity that doubles
    # (at least 4) when at least half of them are live and stays
    # otherwise, and rebuilds the index; else the block is copied as it is
    # (a shared block's copy, every entry keeping its number). Entries
    # move from a unique `old` (`unique`, tested by the caller) and are
    # copied, each taking its own count, from a shared one. The block goes
    # in and out by value, so a caller's loop never lends its map to this
    # cold call.
    @inline(.Never)
    fn rebuilt(old: *MapHead[K, V], grow: bool, unique: bool) -> *MapHead[K, V]:
        olen := old.len
        oused := old.used
        ocap := old.cap
        let mut cap = ocap
        if ocap == 0:
            cap = 4
        else if grow && olen * 2 >= ocap:
            cap = ocap * 2
        seed := if ocap == 0: map_hash_seed() else: old.seed
        size := size_of::[Slot[K, V]]()
        fresh := PlainMap::[K, V].alloc(cap, olen, seed)
        nindex := tail_of(fresh, 8).address
        if ocap == 0:
            fill(nindex, EMPTY, cap / 4 * GROUP)
            return fresh
        oindex := tail_of(old, 8).address
        ohashes := hashes_of(oindex, ocap)
        oentries := entries_of::[K, V](oindex, ocap)
        nhashes := hashes_of(nindex, cap)
        nentries := entries_of::[K, V](nindex, cap)
        let mut used = oused
        if !grow:
            # A copy at the same capacity: the same index, hashes and
            # entry numbers.
            copy_bytes(nindex, oindex, cap / 4 * GROUP + cap * 4)
            if unique || !needs_drop::[Slot[K, V]]():
                copy_bytes(nentries.address, oentries.address, oused * size)
            else:
                let mut e: usize = 0
                while e < oused:
                    if load_u32(ohashes + e * 4) != GONE:
                        nentries.offset(e).write(*oentries.offset(e).as_ref())
                    e += 1
        else:
            fill(nindex, EMPTY, cap / 4 * GROUP)
            used = 0
            let mut e: usize = 0
            while e < oused:
                h := load_u32(ohashes + e * 4)
                if h != GONE:
                    store_u32(nhashes + used * 4, h)
                    if unique:
                        nentries.offset(used).write(oentries.offset(e).read())
                    else:
                        nentries.offset(used).write(*oentries.offset(e).as_ref())
                    set_slot(nindex, first_empty(nindex, cap, h), h, used)
                    used += 1
                e += 1
        Ptr::[MapHead[K, V]] { address: nindex - size_of::[MapHead[K, V]]() }.as_mut().used = used
        if unique:
            # The entries moved: the old block's last release drops none.
            Ptr::[MapHead[K, V]] { address: oindex - size_of::[MapHead[K, V]]() }.as_mut().len = 0
        fresh

impl[K < Eq & Hash, V] FromMapLiteral[K, V] for PlainMap[K, V]:
    @inline(.Always)
    fn with_capacity(capacity: usize) -> PlainMap[K, V]:
        PlainMap::[K, V].with_capacity(capacity)

    @inline(.Always)
    fn insert(&mut self, key: K, value: V) -> void:
        self.insert(key, value)

## A cursor over a `PlainMap`'s entries, in the order they were written.
pub struct PlainMapIter[K < Eq & Hash, V, 'a]:
    map: &'a PlainMap[K, V]
    hashes: usize
    entries: Ptr[Slot[K, V]]
    at: usize
    end: usize

impl[K < Eq & Hash, V, 'a] Iterator[(K, V)] for PlainMapIter[K, V, 'a]:
    fn next(&mut self) -> (K, V)?:
        while self.at < self.end:
            e := self.at
            self.at = e + 1
            if load_u32(self.hashes + e * 4) != GONE:
                slot := self.entries.offset(e).as_ref()
                return .Some((slot.key, slot.value))
        .None
