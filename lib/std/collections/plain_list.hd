# std.collections.plain_list: a copy-on-write list over one counted block
# (#2369 step 1), the shape `List[T]` moves to. Not yet `List`: literals,
# indexing places and patterns still name the builtin.
#
# The list is one `*ListHead[T]`: one word, one hop. The block holds the
# capacity, the length, a word naming `T` and a spare word, then the `T`s
# from payload offset 16, the builtin buffer's layout (crates/hd_wasm/
# DESIGN.md §23.7), so the host ABI can read either. A copy of a list is a
# retain of its block; a change first tests that the block is unique and
# copies it on a cold path otherwise, as Swift's `ContiguousArray`. Every
# empty list shares the static empty block (count 0), so `len` and
# indexing never test for null and the first push takes the cold path.
use std.meta.inline
use std.ops.Index
use std.rt.{Drop, Ptr, address_of, align_of, alloc_counted, copy_bytes, empty_block, is_unique, needs_drop, panic_with, size_of, tail_of}

## A list block's header.
struct ListHead[T]:
    cap: usize
    len: usize
    # Never read: its type names `T`, so the cycle analysis and markers
    # read the tail's values as the header's parts, as `Buffer[T]`'s field.
    elems: Ptr[T]
    spare: usize

impl[T] !Copy for ListHead[T]

# The values' offset from the payload: `tail_of`'s, at `T`'s alignment.
@inline(.Always)
fn elem_offset[T]() -> usize:
    a := align_of::[T]()
    ((8 + size_of::[ListHead[T]]() + a - 1) & ~(a - 1)) - 8

impl[T] Drop for ListHead[T]:
    # The block's last release: its live values go with it, once. The
    # collector's trace runs this glue too, and so visits each value once.
    fn drop(&mut self) -> void:
        if needs_drop::[T]():
            e := Ptr::[T] { address: address_of(self) + elem_offset::[T]() }
            n := self.len
            let mut i: usize = 0
            while i < n:
                _ := e.offset(i).read()
                i += 1

## A copy-on-write list over one counted block.
pub struct PlainList[T]:
    block: *ListHead[T]

impl[T] PlainList[T]:
    ## An empty list; it allocates nothing.
    pub fn new() -> PlainList[T]:
        PlainList::[T] { block: empty_block::[ListHead[T]]() }

    ## An empty list with room for `capacity` values.
    pub fn with_capacity(capacity: usize) -> PlainList[T]:
        if capacity == 0:
            return PlainList::[T].new()
        PlainList::[T] { block: PlainList::[T].alloc(capacity, 0) }

    # A new block with room for at least `want` values and length `len`.
    @inline(.Always)
    fn alloc(want: usize, len: usize) -> *ListHead[T]:
        size := size_of::[T]()
        if want > 0xfffe0000 / (if size == 0: 1 else: size):
            panic_with("heap-exhausted", "a list does not fit the heap")
        head := ListHead::[T] { cap: want, len: len, elems: Ptr::[T] { address: 0 }, spare: 0 }
        alloc_counted::[ListHead[T]](head, want * size, align_of::[T]())

    @inline(.Always)
    fn head(&self) -> Ptr[ListHead[T]]:
        Ptr::[ListHead[T]] { address: tail_of(self.block, 1).address - size_of::[ListHead[T]]() }

    @inline(.Always)
    fn elems(&self) -> Ptr[T]:
        Ptr::[T] { address: tail_of(self.block, align_of::[T]()).address }

    # Reads go through the `*ListHead[T]` itself: a field load the loop
    # passes see (#2368); writes go through `head()`, to a unique block.
    @inline(.Always)
    pub fn len(&self) -> usize:
        self.block.len

    @inline(.Always)
    pub fn capacity(&self) -> usize:
        self.block.cap

    @inline(.Always)
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    ## The value at `index`, a copy.
    @inline(.Always)
    pub fn get(&self, index: usize) -> T:
        if index >= self.len():
            panic_with("index-out-of-bounds", "list index out of bounds")
        *self.elems().offset(index).as_ref()

    ## Moves `value` onto the end: one count load and one length and
    ## capacity compare; growth and the copy of a shared block are cold.
    @inline
    pub fn push(&mut self, value: T) -> void:
        n := self.block.len
        if !is_unique(self.block) || n == self.block.cap:
            self.reserve_slow(n + 1)
        self.elems().offset(n).write(value)
        self.head().as_mut().len = n + 1

    ## Replaces the value at `index`; a shared block is copied first.
    @inline(.Always)
    pub fn set(&mut self, index: usize, value: T) -> void:
        if index >= self.len():
            panic_with("index-out-of-bounds", "list index out of bounds")
        if !is_unique(self.block):
            self.reserve_slow(0)
        at := self.elems().offset(index)
        if needs_drop::[T]():
            _ := at.read()
        at.write(value)

    ## Takes the last value off, if any.
    pub fn pop(&mut self) -> T?:
        n := self.len()
        if n == 0:
            return .None
        if !is_unique(self.block):
            self.reserve_slow(0)
        self.head().as_mut().len = n - 1
        .Some(self.elems().offset(n - 1).read())

    ## Inserts `value` at `index`, moving the later values up one.
    pub fn insert(&mut self, index: usize, value: T) -> void:
        n := self.len()
        if index > n:
            panic_with("index-out-of-bounds", "list insert index out of bounds")
        if !is_unique(self.block) || n == self.capacity():
            self.reserve_slow(n + 1)
        e := self.elems()
        size := size_of::[T]()
        copy_bytes(e.offset(index + 1).address, e.offset(index).address, (n - index) * size)
        e.offset(index).write(value)
        self.head().as_mut().len = n + 1

    ## Removes and gives the value at `index`, moving the later values
    ## down one.
    pub fn remove(&mut self, index: usize) -> T:
        n := self.len()
        if index >= n:
            panic_with("index-out-of-bounds", "list remove index out of bounds")
        if !is_unique(self.block):
            self.reserve_slow(0)
        e := self.elems()
        out := e.offset(index).read()
        copy_bytes(e.offset(index).address, e.offset(index + 1).address, (n - index - 1) * size_of::[T]())
        self.head().as_mut().len = n - 1
        out

    ## Drops the values from `len` on; no effect when the list is shorter.
    pub fn truncate(&mut self, len: usize) -> void:
        n := self.len()
        if len >= n:
            return
        if !is_unique(self.block):
            self.reserve_slow(0)
        # The length first: a value's drop sees the list already short.
        self.head().as_mut().len = len
        if needs_drop::[T]():
            e := self.elems()
            let mut i = len
            while i < n:
                _ := e.offset(i).read()
                i += 1

    ## Room for `additional` more values with no copy or growth.
    pub fn reserve(&mut self, additional: usize) -> void:
        need := self.len() + additional
        if !is_unique(self.block) || need > self.capacity():
            self.reserve_slow(need)

    ## A cursor yielding the values by copy, as `for x in list` does.
    pub fn iter['a](&'a self) -> PlainListIter[T, 'a]:
        start := self.elems()
        PlainListIter { list: self, at: start, end: start.offset(self.len()).address }

    # Makes the block unique with room for `need` values: a unique block
    # grows geometrically (the most of need, twice the capacity, and 4); a
    # shared one is copied at the most of need and the length.
    @inline(.Never)
    fn reserve_slow(&mut self, need: usize) -> void:
        n := self.len()
        cap := self.capacity()
        unique := is_unique(self.block)
        if unique && need <= cap:
            return
        let mut want = n
        if want < need:
            want = need
        if unique:
            if want < cap * 2:
                want = cap * 2
            if want < 4:
                want = 4
        fresh := PlainList::[T].alloc(want, n)
        to := Ptr::[T] { address: tail_of(fresh, align_of::[T]()).address }
        from := self.elems()
        if unique || !needs_drop::[T]():
            copy_bytes(to.address, from.address, n * size_of::[T]())
        else:
            # Each value of a shared block takes its own count.
            let mut i: usize = 0
            while i < n:
                to.offset(i).write(*from.offset(i).as_ref())
                i += 1
        if unique:
            # The values moved: the old block's last release drops none.
            self.head().as_mut().len = 0
        self.block = fresh

impl[T] Index[usize] for PlainList[T]:
    type Out = T
    @inline(.Always)
    fn index(&self, key: usize) -> &T:
        if key >= self.len():
            panic_with("index-out-of-bounds", "list index out of bounds")
        self.elems().offset(key).as_ref()

## A cursor over a `PlainList`: a raw value pointer and its end.
pub struct PlainListIter[T, 'a]:
    list: &'a PlainList[T]
    at: Ptr[T]
    end: usize

impl[T, 'a] Iterator[T] for PlainListIter[T, 'a]:
    @inline(.Always)
    fn next(&mut self) -> T?:
        if self.at.address >= self.end:
            return .None
        v := *self.at.as_ref()
        self.at = self.at.offset(1)
        .Some(v)
