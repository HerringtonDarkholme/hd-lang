use std.meta.inline
use std.collections.list.before
use std.ops.FnMut
use std.iter.MapEntries

# The std `Map` methods beside the language-tier `len`, `get`, and `remove`
# (spec/std/collections.md#map-methods). `keys` and `values` copy into new
# lists, so a later change to the map does not show in them.
impl[K < Eq & Hash, V] Map[K, V]:
    ## Keeps entries selected by `keep`, which may change their values.
    ## See [std-collections.map.retain](../../../spec/std/collections.md#r-std-collections.map.retain).
    pub fn retain[F < ?Copy & FnMut(&K, &mut V) -> bool](&mut self, mut keep: F) -> void:
        for (key, _) in *self:
            if !keep(key, &mut self[*key]):
                _ := self.remove(*key)

    ## Inserts entries in order, replacing values of equal keys.
    ## See [std-collections.map.extend](../../../spec/std/collections.md#r-std-collections.map.extend).
    pub fn extend[I < ?Copy & Iterable[(K, V)]](&mut self, other: I) -> void:
        for (key, value) in other:
            self[key] = value

    ## Empties this map and yields its entries while borrowing it.
    ## See [std-collections.map.drain](../../../spec/std/collections.md#r-std-collections.map.drain).
    pub fn drain['a](&'a mut self) -> MapDrain[K, V, 'a]:
        entries := self.iter()
        for (key, _) in *self:
            _ := self.remove(*key)
        MapDrain { items: self, entries: entries }

    ## Returns a mutable reference to the value for `key`; when the map has no equal key, inserts `default` first.
    ## See [std-collections.map.get-or-insert](../../../spec/std/collections.md#r-std-collections.map.get-or-insert).
    @intrinsic("map_probe")
    pub fn get_or_insert(&mut self, key: K, default: V) -> &mut V:
        panic("intrinsic")

    ## True when the map has an entry for `key`.
    ## See [std-collections.map.contains-key](../../../spec/std/collections.md#r-std-collections.map.contains-key).
    pub fn contains_key(&self, key: K) -> bool:
        match self.get(key):
            .Some(_) => true
            .None => false

    ## A lazy cursor over a snapshot of the map's keys, in iteration order.
    ## See [std-collections.map.keys.cursor](../../../spec/std/collections.md#r-std-collections.map.keys.cursor).
    pub fn keys(&self) -> MapKeys[K, V]:
        MapKeys { entries: self.iter() }

    ## A lazy cursor over a snapshot of the map's values, in iteration order.
    ## See [std-collections.map.values.cursor](../../../spec/std/collections.md#r-std-collections.map.values.cursor).
    pub fn values(&self) -> MapValues[K, V]:
        MapValues { entries: self.iter() }

    ## True exactly when the map has no entries.
    ## See [std-collections.map.is-empty](../../../spec/std/collections.md#r-std-collections.map.is-empty).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

## A snapshot cursor over a map's keys.
## See [std-collections.map.keys.cursor-type](../../../spec/std/collections.md#r-std-collections.map.keys.cursor-type).
pub struct MapKeys[K < Eq & Hash, V]:
    entries: MapEntries[K, V]

impl[K < Eq & Hash, V] Iterator[K] for MapKeys[K, V]:
    fn next(&mut self) -> K?:
        self.entries.next().map(fn(entry: (K, V)) -> K: entry._0)

## A snapshot cursor over a map's values.
## See [std-collections.map.values.cursor-type](../../../spec/std/collections.md#r-std-collections.map.values.cursor-type).
pub struct MapValues[K < Eq & Hash, V]:
    entries: MapEntries[K, V]

impl[K < Eq & Hash, V] Iterator[V] for MapValues[K, V]:
    fn next(&mut self) -> V?:
        self.entries.next().map(fn(entry: (K, V)) -> V: entry._1)

# The entries of a map, and the most frequent ones of a tally
# (spec/std/collections.md#map-methods).
impl[K < Eq & Hash, V] Map[K, V]:
    ## A new list of the `(key, value)` pairs, in the map's iteration order.
    ## See [std-collections.map.entries](../../../spec/std/collections.md#r-std-collections.map.entries).
    pub fn entries(&self) -> List[(K, V)]:
        let mut found: List[(K, V)] = []
        found.reserve(self.len())
        for (key, value) in self:
            found.push((*key, *value))
        found

impl[K < Eq & Hash] Map[K, usize]:
    ## Returns the `n` pairs with the largest counts, largest first; equal counts keep the map's order.
    ## See [std-collections.map.most-common](../../../spec/std/collections.md#r-std-collections.map.most-common).
    pub fn most_common(&self, n: usize) -> List[(K, usize)]:
        self.entries()
            .sorted_by(
                fn(left: &(K, usize), right: &(K, usize)) -> Ordering: right._1.cmp(&left._1)
            )
            .take(n)

## A borrowed cursor over the entries removed by `Map.drain`.
## See [std-collections.map.drain](../../../spec/std/collections.md#r-std-collections.map.drain).
pub struct MapDrain[K < Eq & Hash, V, 'a]:
    items: &'a mut Map[K, V]
    entries: MapEntries[K, V]

impl[K < Eq & Hash, V, 'a] !Copy for MapDrain[K, V, 'a]

impl[K < Eq & Hash, V, 'a] Iterator[(K, V)] for MapDrain[K, V, 'a]:
    fn next(&mut self) -> (K, V)?:
        self.entries.next()

# Standard insertion/clearing names over the existing map operations.
impl[K < Eq & Hash, V] Map[K, V]:
    ## Inserts a value and returns the previous value, if any, without replacing an equal stored key.
    ## See [std-collections.map.insert.value](../../../spec/std/collections.md#r-std-collections.map.insert.value).
    @inline(.Always)
    pub fn insert(&mut self, key: K, value: V) -> V?:
        before := self.len()
        slot := self.get_or_insert(key, value)
        previous := *slot
        *slot = value
        if self.len() == before: .Some(previous) else: .None

    ## Removes all entries from this map, leaving other copies unchanged.
    ## See [std-collections.map.clear.value](../../../spec/std/collections.md#r-std-collections.map.clear.value).
    @inline(.Always)
    pub fn clear(&mut self) -> void:
        if self.len() != 0:
            *self = {}
