# std.collections: inherent `List` methods, `UniqList`, `UniqMap`,
# `ListView`, `Deque`, and `Heap` (spec/std/collections.md).
# `map` is the std method of spec/std/iter.md#list-and-optional-map.
# Each `List` method that does not change its receiver returns a new list.
# `ListView`, `Deque`, `Set`, and `Heap` are struct values copied as a list
# is; a view refers to its list. `UniqList` and `UniqMap` are non-copyable
# structs with one owner. They are generic, so a program that names none of
# them compiles none of their code.
use std.iter.MapEntries
use std.num.Num
use std.iter.FromIterator
use std.ops.Index
use std.ops.IndexSet
use std.ops.Range
use std.format.DebugWriter
use std.hash.{hash_of, Hasher}
use std.rt.bytes.{panic_with}
use std.annotation.inline
use std.rt.Drop
use std.rt.memory.{Buffer, copy, fill, load_u32, size_of, store_u32}

## A uniquely owned growable list that may hold non-copyable elements.
## See [std-collections.uniq-list.type](../../spec/std/collections.md#r-std-collections.uniq-list.type).
pub struct UniqList[T < ?Copy]:
    buffer: Buffer[T]
    len: usize

impl[T < ?Copy] !Copy for UniqList[T]

# The stable driftsort shape from Rust 1.81: long natural runs scheduled by
# powersort, lazy three-way stable quicksort runs, small insertion sorts, and
# merge-sort fallback at the quicksort depth limit. The engine sorts original
# indices so a `?Copy` element stays in its buffer until the final move cycle.
# One logical run in driftsort's powersort merge tree. An unsorted run is
# sorted lazily, only when it meets a natural run or reaches the root.
struct DriftRun:
    start: usize
    len: usize
    sorted: bool

fn drift_less[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    left: usize,
    right: usize,
) -> bool:
    match (by)(items.buffer.at(left).as_ref(), items.buffer.at(right).as_ref()):
        .Less => true
        _ => false

fn drift_insertion_sort[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    start: usize,
    end: usize,
) -> void:
    let index = start + 1
    while index < end:
        value := order[index]
        let hole = index
        while hole > start && drift_less(items, by, value, order[hole - 1]):
            order[hole] = order[hole - 1]
            hole -= 1
        order[hole] = value
        index += 1

fn drift_reverse(order: &mut List[usize], start: usize, end: usize) -> void:
    let left = start
    let right = end
    while left + 1 < right:
        right -= 1
        order.swap(left, right)
        left += 1

# Finds an ascending run, or a strictly descending run which may be reversed
# without changing the order of equal elements.
fn drift_natural_run[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &List[usize],
    start: usize,
) -> (usize, bool):
    if start + 1 >= order.len():
        return (1, false)
    let end = start + 2
    descending := drift_less(items, by, order[start + 1], order[start])
    if descending:
        while end < order.len() && drift_less(items, by, order[end], order[end - 1]):
            end += 1
    else:
        while end < order.len() && !drift_less(items, by, order[end], order[end - 1]):
            end += 1
    (end - start, descending)

# Stable physical merge. Equal elements come from the left run.
fn drift_merge[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    scratch: &mut List[usize],
    start: usize,
    middle: usize,
    end: usize,
) -> void:
    let left = start
    let right = middle
    let out = start
    while out < end:
        let take_right = left == middle
        if !take_right && right < end:
            take_right = drift_less(items, by, order[right], order[left])
        if take_right:
            scratch[out] = order[right]
            right += 1
        else:
            scratch[out] = order[left]
            left += 1
        out += 1
    let index = start
    while index < end:
        order[index] = scratch[index]
        index += 1

fn drift_merge_sort[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    scratch: &mut List[usize],
    start: usize,
    end: usize,
) -> void:
    run := 16
    let at = start
    while at < end:
        stop := at + (if run < end - at: run else: end - at)
        drift_insertion_sort(items, by, order, at, stop)
        at = stop
    let width = run
    while width < end - start:
        at = start
        while at < end:
            middle := at + (if width < end - at: width else: end - at)
            stop := middle + (if width < end - middle: width else: end - middle)
            if middle < stop:
                drift_merge(items, by, order, scratch, at, middle, stop)
            at = stop
        if width >= end - start - width:
            break
        width *= 2

fn drift_log2(value: usize) -> usize:
    let bits: usize = 0
    let rest = value
    while rest > 1:
        rest /= 2
        bits += 1
    bits

# A stable three-way quicksort. It is driftsort's lazy-run engine: equal keys
# form one finished middle partition, which keeps low-cardinality inputs fast.
fn drift_quick_sort[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    scratch: &mut List[usize],
    start: usize,
    end: usize,
    limit: usize,
) -> void:
    size := end - start
    if size <= 16:
        drift_insertion_sort(items, by, order, start, end)
        return
    if limit == 0:
        drift_merge_sort(items, by, order, scratch, start, end)
        return
    pivot := order[start + size / 2]
    let less: usize = 0
    let equal: usize = 0
    let index = start
    while index < end:
        item := order[index]
        class := match (by)(items.buffer.at(item).as_ref(), items.buffer.at(pivot).as_ref()):
            .Less =>
                less += 1
                0
            .Equal =>
                equal += 1
                1
            .Greater => 2
        scratch[index] = item * 3 + class
        index += 1
    if equal == size:
        return
    let less_at = start
    let equal_at = start + less
    let greater_at = equal_at + equal
    index = start
    while index < end:
        encoded := scratch[index]
        item := encoded / 3
        match encoded % 3:
            0 =>
                order[less_at] = item
                less_at += 1
            1 =>
                order[equal_at] = item
                equal_at += 1
            _ =>
                order[greater_at] = item
                greater_at += 1
        index += 1
    drift_quick_sort(items, by, order, scratch, start, start + less, limit - 1)
    drift_quick_sort(items, by, order, scratch, start + less + equal, end, limit - 1)

fn drift_sort_lazy_run[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    scratch: &mut List[usize],
    start: usize,
    end: usize,
) -> void:
    drift_quick_sort(items, by, order, scratch, start, end, 2 * drift_log2(end - start))

fn drift_logical_merge[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    scratch: &mut List[usize],
    left: DriftRun,
    right: DriftRun,
) -> DriftRun:
    if !left.sorted && !right.sorted:
        return DriftRun { start: left.start, len: left.len + right.len, sorted: false }
    if !left.sorted:
        drift_sort_lazy_run(items, by, order, scratch, left.start, left.start + left.len)
    if !right.sorted:
        drift_sort_lazy_run(items, by, order, scratch, right.start, right.start + right.len)
    drift_merge(items, by, order, scratch, left.start, right.start, right.start + right.len)
    DriftRun { start: left.start, len: left.len + right.len, sorted: true }

fn drift_scale_factor(size: usize) -> u64:
    ((1u64 << 62) + u64(size) - 1) / u64(size)

fn drift_merge_depth(left: usize, middle: usize, right: usize, scale: u64) -> u8:
    x := u64(left + middle)
    y := u64(middle + right)
    u8(((scale * x) ^ (scale * y)).leading_zeros())

fn drift_sqrt_approx(size: usize) -> usize:
    shift := (1 + drift_log2(size | 1)) / 2
    ((1usize << shift) + (size >> shift)) / 2

fn drift_create_run[T < ?Copy](
    items: &UniqList[T],
    by: fn(&T, &T) -> Ordering,
    order: &mut List[usize],
    start: usize,
    minimum: usize,
) -> DriftRun:
    remaining := order.len() - start
    if remaining >= minimum:
        let (len, reversed) = drift_natural_run(items, by, order, start)
        if len >= minimum:
            if reversed:
                drift_reverse(order, start, start + len)
            return DriftRun { start: start, len: len, sorted: true }
    DriftRun { start: start, len: if minimum < remaining: minimum else: remaining, sorted: false }

# Driftsort's top-level policy: preserve long natural runs, keep the other
# runs lazy for stable quicksort, and merge them in powersort order.
fn drift_order[T < ?Copy](items: &UniqList[T], by: fn(&T, &T) -> Ordering) -> List[usize]:
    size := items.len()
    let mut order: List[usize] = [for index in 0..size => index]
    if size < 2:
        return order
    let mut scratch = order
    scale := drift_scale_factor(size)
    minimum := if size <= 64 * 64:
        half := size - size / 2
        if half < 64: half else: 64
    else:
        drift_sqrt_approx(size)
    let mut runs: List[DriftRun] = []
    let mut depths: List[u8] = []
    let scan: usize = 0
    let prev = DriftRun { start: 0, len: 0, sorted: true }
    while true:
        next := if scan < size:
            drift_create_run(items, by, &mut order, scan, minimum)
        else:
            DriftRun { start: scan, len: 0, sorted: true }
        depth := if scan < size:
            drift_merge_depth(prev.start, scan, scan + next.len, scale)
        else:
            0u8
        while runs.len() > 1 && depths.last().unwrap_or(0) >= depth:
            left := runs.pop().unwrap_or(DriftRun { start: 0, len: 0, sorted: true })
            _ := depths.pop()
            prev = drift_logical_merge(items, by, &mut order, &mut scratch, left, prev)
        runs.push(prev)
        depths.push(depth)
        if scan >= size:
            break
        scan += next.len
        prev = next
    if !prev.sorted:
        drift_sort_lazy_run(items, by, &mut order, &mut scratch, 0, size)
    order

# The list drops the values it holds; its buffer then frees the room.
impl[T < ?Copy] Drop for UniqList[T]:
    fn drop(&mut self) -> void:
        let index: usize = 0
        while index < self.len:
            _ := self.buffer.at(index).read()
            index += 1

impl[T < ?Copy] UniqList[T]:
    ## Returns an empty list with no reserved element capacity.
    ## See [std-collections.uniq-list.new](../../spec/std/collections.md#r-std-collections.uniq-list.new).
    pub fn new() -> UniqList[T]:
        UniqList::[T].with_capacity(0)

    ## Returns an empty list with room for at least `capacity` elements before it grows.
    ## See [std-collections.uniq-list.new](../../spec/std/collections.md#r-std-collections.uniq-list.new).
    pub fn with_capacity(capacity: usize) -> UniqList[T]:
        UniqList::[T] { buffer: Buffer::[T].new(capacity), len: 0 }

    ## Returns the number of elements in the list.
    ## See [std-collections.uniq-list.len](../../spec/std/collections.md#r-std-collections.uniq-list.len).
    pub fn len(&self) -> usize:
        self.len

    ## True exactly when the list has no elements.
    ## See [std-collections.uniq-list.len](../../spec/std/collections.md#r-std-collections.uniq-list.len).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    ## Returns a shared reference to the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get-ref](../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    @inline
    pub fn get_ref['a](&'a self, index: usize) -> (&'a T)?:
        if index >= self.len: .None else: .Some(self.buffer.at(index).as_ref())

    ## Returns a mutable reference to the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get-mut](../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    @inline
    pub fn get_mut['a](&'a mut self, index: usize) -> (&'a mut T)?:
        if index >= self.len: .None else: .Some(self.buffer.at(index).as_mut())

    ## Returns a shared reference to the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-ref](../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    pub fn first_ref['a](&'a self) -> (&'a T)?:
        self.get_ref(0)

    ## Returns a mutable reference to the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-mut](../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    pub fn first_mut['a](&'a mut self) -> (&'a mut T)?:
        self.get_mut(0)

    ## Returns a shared reference to the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-ref](../../spec/std/collections.md#r-std-collections.uniq-list.get-ref).
    pub fn last_ref['a](&'a self) -> (&'a T)?:
        size := self.len()
        if size == 0: .None else: self.get_ref(size - 1)

    ## Returns a mutable reference to the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.get-mut](../../spec/std/collections.md#r-std-collections.uniq-list.get-mut).
    pub fn last_mut['a](&'a mut self) -> (&'a mut T)?:
        size := self.len()
        if size == 0: .None else: self.get_mut(size - 1)

    ## Returns a cursor that borrows and yields the list's elements in order.
    ## See [std-collections.uniq-list.iter](../../spec/std/collections.md#r-std-collections.uniq-list.iter).
    pub fn iter['a](&'a self) -> UniqListIter[T, 'a]:
        UniqListIter { items: self, at: 0 }

    ## Returns a reference to the first element for which `test` is true, or `.None`.
    ## See [std-collections.uniq-list.find-ref](../../spec/std/collections.md#r-std-collections.uniq-list.find-ref).
    pub fn find_ref['a](&'a self, test: fn(&T) -> bool) -> (&'a T)?:
        let index: usize = 0
        while index < self.len():
            item := self.buffer.at(index).as_ref()
            if test(item):
                return .Some(item)
            index += 1
        .None

    ## True when `test` is true for at least one element, stopping at the first.
    ## See [std-collections.uniq-list.any-all](../../spec/std/collections.md#r-std-collections.uniq-list.any-all).
    pub fn any(&self, test: fn(&T) -> bool) -> bool:
        let index: usize = 0
        while index < self.len():
            if test(self.buffer.at(index).as_ref()):
                return true
            index += 1
        false

    ## True when `test` is true for every element, stopping at the first false.
    ## See [std-collections.uniq-list.any-all](../../spec/std/collections.md#r-std-collections.uniq-list.any-all).
    pub fn all(&self, test: fn(&T) -> bool) -> bool:
        let index: usize = 0
        while index < self.len():
            if !test(self.buffer.at(index).as_ref()):
                return false
            index += 1
        true

    # Panics while a reference into the room counts it, as one reached
    # through a `*T` does: a change of the length would move or drop the
    # element it refers to.
    fn unpinned(&self) -> void:
        if self.buffer.pinned():
            panic_with("collection-pinned", "a uniq list changes its length while an element reference pins it")

    # Moves every element into a larger room.
    fn reserve_for(&mut self, minimum: usize) -> void:
        current := self.buffer.capacity()
        if current >= minimum:
            return
        let capacity = if current == 0: 4 else: current * 2
        while capacity < minimum:
            capacity *= 2
        self.buffer.grow(capacity)

    ## Moves `value` onto the end of the list.
    ## See [std-collections.uniq-list.push](../../spec/std/collections.md#r-std-collections.uniq-list.push).
    pub fn push(&mut self, value: T) -> void:
        self.unpinned()
        size := self.len()
        if self.buffer.capacity() <= size:
            self.reserve_for(size + 1)
        self.buffer.at(size).write(value)
        self.len = size + 1

    ## Moves and returns the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.push](../../spec/std/collections.md#r-std-collections.uniq-list.push).
    pub fn pop(&mut self) -> T?:
        size := self.len()
        if size == 0:
            return .None
        self.unpinned()
        value := self.buffer.at(size - 1).read()
        self.len = size - 1
        .Some(value)

    ## Moves `value` to `index` and shifts the later elements one place toward the end.
    ## See [std-collections.uniq-list.insert](../../spec/std/collections.md#r-std-collections.uniq-list.insert).
    pub fn insert(&mut self, index: usize, value: T) -> void:
        size := self.len()
        if index > size:
            panic_with(
                "index-out-of-bounds",
                "uniq list insert index ${index} out of bounds for length ${size}",
            )
        self.unpinned()
        if self.buffer.capacity() <= size:
            self.reserve_for(size + 1)
        if index < size:
            copy(
                self.buffer.at(index + 1).address,
                self.buffer.at(index).address,
                (size - index) * size_of::[T](),
            )
        self.buffer.at(index).write(value)
        self.len = size + 1

    ## Moves and returns the element at `index`, shifting later elements one place toward the start.
    ## See [std-collections.uniq-list.remove-at](../../spec/std/collections.md#r-std-collections.uniq-list.remove-at).
    pub fn remove_at(&mut self, index: usize) -> T:
        size := self.len()
        if index >= size:
            panic_with(
                "index-out-of-bounds",
                "uniq list remove_at index ${index} out of bounds for length ${size}",
            )
        self.unpinned()
        removed := self.buffer.at(index).read()
        if index + 1 < size:
            copy(
                self.buffer.at(index).address,
                self.buffer.at(index + 1).address,
                (size - index - 1) * size_of::[T](),
            )
        self.len = size - 1
        removed

    ## Exchanges the elements at `left` and `right` without copying either one.
    ## See [std-collections.uniq-list.swap](../../spec/std/collections.md#r-std-collections.uniq-list.swap).
    pub fn swap(&mut self, left: usize, right: usize) -> void:
        size := self.len()
        if left >= size || right >= size:
            panic_with(
                "index-out-of-bounds",
                "uniq list swap indices ${left} and ${right} out of bounds for length ${size}",
            )
        if left == right:
            return
        left_value := self.buffer.at(left).read()
        right_value := self.buffer.at(right).read()
        self.buffer.at(left).write(right_value)
        self.buffer.at(right).write(left_value)

    ## Drops every element at `len` and after; a larger `len` has no effect.
    ## See [std-collections.uniq-list.truncate](../../spec/std/collections.md#r-std-collections.uniq-list.truncate).
    pub fn truncate(&mut self, len: usize) -> void:
        if self.len() > len:
            self.unpinned()
        while self.len() > len:
            index := self.len() - 1
            _ := self.buffer.at(index).read()
            self.len = index

    ## Drops every element, leaving the list empty.
    ## See [std-collections.uniq-list.truncate](../../spec/std/collections.md#r-std-collections.uniq-list.truncate).
    pub fn clear(&mut self) -> void:
        self.truncate(0)

    ## Keeps the elements for which `keep` is true, in order, and drops the rest.
    ## See [std-collections.uniq-list.retain](../../spec/std/collections.md#r-std-collections.uniq-list.retain).
    pub fn retain(&mut self, keep: fn(&T) -> bool) -> void:
        self.unpinned()
        size := self.len()
        let kept: usize = 0
        let index: usize = 0
        while index < size:
            if keep(self.buffer.at(index).as_ref()):
                if kept != index:
                    value := self.buffer.at(index).read()
                    self.buffer.at(kept).write(value)
                kept += 1
            else:
                _ := self.buffer.at(index).read()
            index += 1
        self.len = kept

    ## Stably sorts the elements in ascending order by `compare`, in place.
    ## See [std-collections.uniq-list.sort](../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort_by(&mut self, compare: fn(&T, &T) -> Ordering) -> void:
        size := self.len()
        if size <= 1:
            return
        order := drift_order(self, compare)
        self.reorder(order)

    ## Stably sorts the elements by `key(element)`, calling `key` once per element.
    ## See [std-collections.uniq-list.sort](../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort_by_key[K < Ord](&mut self, key: fn(&T) -> K) -> void:
        size := self.len()
        if size <= 1:
            return
        let mut keyed = UniqList::[(K, usize)].with_capacity(size)
        let index: usize = 0
        while index < size:
            keyed.push((key(self.buffer.at(index).as_ref()), index))
            index += 1
        keyed.sort_by(fn(left: &(K, usize), right: &(K, usize)) -> Ordering: left._0.cmp(&right._0))
        let mut order: List[usize] = []
        for (_, at) in keyed:
            order.push(at)
        self.reorder(order)

    # Inverts driftsort's destination-to-source permutation in place, then
    # follows its cycles with element moves. `size` is an unattainable marker
    # offset because a buffer cannot hold half of usize's range of elements.
    fn reorder(&mut self, order: List[usize]) -> void:
        let mut permutation = order
        size := permutation.len()
        for start in 0..size:
            if permutation[start] >= size:
                continue
            let previous = start
            let current = permutation[start]
            while current != start:
                next := permutation[current]
                permutation[current] = previous + size
                previous = current
                current = next
            permutation[start] = previous + size
        for index in 0..size:
            permutation[index] -= size
        for index in 0..size:
            while permutation[index] != index:
                destination := permutation[index]
                self.swap(index, destination)
                permutation.swap(index, destination)

impl[T < Copy] UniqList[T]:
    ## Copies the elements of `items`, in order, into a new uniquely owned list.
    ## See [std-collections.uniq-list.conversion](../../spec/std/collections.md#r-std-collections.uniq-list.conversion).
    pub fn from_list(items: List[T]) -> UniqList[T]:
        let mut out = UniqList::[T].with_capacity(items.len())
        for item in items:
            out.push(item)
        out

    ## Copies the elements, in order, into a `List`.
    ## See [std-collections.uniq-list.conversion](../../spec/std/collections.md#r-std-collections.uniq-list.conversion).
    pub fn to_list(&self) -> List[T]:
        let mut out: List[T] = []
        let index: usize = 0
        while index < self.len():
            out.push(*self.buffer.at(index).as_ref())
            index += 1
        out

    ## Returns `.Some` of a copy of the element at `index`, or `.None` outside the list.
    ## See [std-collections.uniq-list.get](../../spec/std/collections.md#r-std-collections.uniq-list.get).
    @inline
    pub fn get(&self, index: usize) -> T?:
        if index >= self.len: .None else: .Some(*self.buffer.at(index).as_ref())

    ## Returns a copy of the first element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.first-last](../../spec/std/collections.md#r-std-collections.uniq-list.first-last).
    pub fn first(&self) -> T?:
        self.get(0)

    ## Returns a copy of the last element, or `.None` for an empty list.
    ## See [std-collections.uniq-list.first-last](../../spec/std/collections.md#r-std-collections.uniq-list.first-last).
    pub fn last(&self) -> T?:
        if self.is_empty(): .None else: self.get(self.len() - 1)

enum UniqMapSlot[K < Eq & Hash, V < ?Copy]:
    Deleted
    Occupied(hash: usize, key: K, value: V)

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMapSlot[K, V]

## A uniquely owned hash map whose values may be non-copyable.
## See [std-collections.uniq-map.type](../../spec/std/collections.md#r-std-collections.uniq-map.type).
pub struct UniqMap[K < Eq & Hash, V < ?Copy]:
    slots: Buffer[UniqMapSlot[K, V]]
    entry_capacity: usize
    size: usize
    # The slots in use from the start, deleted ones included.
    used: usize

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMap[K, V]

# The map drops the slots in use; its buffer then frees the room.
impl[K < Eq & Hash, V < ?Copy] Drop for UniqMap[K, V]:
    fn drop(&mut self) -> void:
        let index: usize = 0
        while index < self.used:
            _ := self.slots.at(index).read()
            index += 1

impl[K < Eq & Hash, V < ?Copy] UniqMap[K, V]:
    ## Returns an empty map.
    ## See [std-collections.uniq-map.new](../../spec/std/collections.md#r-std-collections.uniq-map.new).
    pub fn new() -> UniqMap[K, V]:
        UniqMap::[K, V].with_capacity(8)

    fn with_capacity(capacity: usize) -> UniqMap[K, V]:
        slot_bytes := size_of::[UniqMapSlot[K, V]]()
        index_bytes := capacity * 2 * size_of::[usize]()
        index_slots := (index_bytes + slot_bytes - 1) / slot_bytes
        slots := Buffer::[UniqMapSlot[K, V]].new(capacity + index_slots)
        fill(slots.at(capacity).address, 0, index_bytes)
        UniqMap::[K, V] { slots: slots, entry_capacity: capacity, size: 0, used: 0 }

    ## Returns the number of entries in the map.
    ## See [std-collections.uniq-map.len](../../spec/std/collections.md#r-std-collections.uniq-map.len).
    pub fn len(&self) -> usize:
        self.size

    ## True exactly when the map has no entries.
    ## See [std-collections.uniq-map.len](../../spec/std/collections.md#r-std-collections.uniq-map.len).
    pub fn is_empty(&self) -> bool:
        self.size == 0

    ## Returns a shared reference to the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get-ref](../../spec/std/collections.md#r-std-collections.uniq-map.get-ref).
    pub fn get_ref['a](&'a self, key: K) -> (&'a V)?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_ref():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

    ## Returns a mutable reference to the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get-mut](../../spec/std/collections.md#r-std-collections.uniq-map.get-mut).
    pub fn get_mut['a](&'a mut self, key: K) -> (&'a mut V)?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_mut():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

    ## Returns a mutable reference to the value for `key`, inserting `default` when absent.
    ## See [std-collections.uniq-map.get-or-insert](../../spec/std/collections.md#r-std-collections.uniq-map.get-or-insert).
    pub fn get_or_insert['a](&'a mut self, key: K, default: V) -> &'a mut V:
        if self.find_index(key).is_none():
            _ := self.insert(key, default)
        match self.get_mut(key):
            .Some(value) => value
            .None => panic("uniq map inserted key is absent")

    ## Returns a cursor that borrows the map and yields its entries.
    ## See [std-collections.uniq-map.iter](../../spec/std/collections.md#r-std-collections.uniq-map.iter).
    pub fn iter['a](&'a self) -> UniqMapIter[K, V, 'a]:
        UniqMapIter { items: self, at: 0 }

    ## Returns a cursor that borrows the map and yields its keys.
    ## See [std-collections.uniq-map.keys](../../spec/std/collections.md#r-std-collections.uniq-map.keys).
    pub fn keys['a](&'a self) -> UniqMapKeys[K, V, 'a]:
        UniqMapKeys { entries: self.iter() }

    fn index_address(&self, index: usize) -> usize:
        self.slots.at(self.entry_capacity).address + index * size_of::[usize]()

    fn index_value(&self, index: usize) -> usize:
        usize(load_u32(self.index_address(index)))

    fn set_index(&self, index: usize, value: usize) -> void:
        store_u32(self.index_address(index), u32(value))

    fn start(&self, hash: usize) -> usize:
        hash & (self.entry_capacity * 2 - 1)

    # The index of `key`, borrowing every probed slot rather than moving it.
    fn find_index(&self, key: K) -> usize?:
        capacity := self.entry_capacity * 2
        hash := usize(hash_of(key))
        let index = self.start(hash)
        while true:
            entry_plus_one := self.index_value(index)
            if entry_plus_one == 0:
                return .None
            entry := entry_plus_one - 1
            match self.slots.at(entry).as_ref():
                .Deleted => pass
                .Occupied(found_hash, found, _) =>
                    if found_hash == hash && found == key:
                        return .Some(entry)
            index = (index + 1) & (capacity - 1)

    # Adds one occupied entry to this freshly allocated table's compact index.
    fn index_entry(&mut self, hash: usize, entry: usize) -> void:
        capacity := self.entry_capacity * 2
        let index = self.start(hash)
        while true:
            if self.index_value(index) == 0:
                self.set_index(index, entry + 1)
                return
            index = (index + 1) & (capacity - 1)

    ## Moves `value` into the entry for `key`; returns the replaced value, or `.None` for a new key.
    ## See [std-collections.uniq-map.insert](../../spec/std/collections.md#r-std-collections.uniq-map.insert).
    pub fn insert(&mut self, key: K, value: V) -> V?:
        if self.slots.pinned() && self.find_index(key).is_none():
            panic_with("collection-pinned", "a uniq map inserts a key while a value reference pins it")
        if self.used == self.entry_capacity:
            self.grow()
        capacity := self.entry_capacity * 2
        hash := usize(hash_of(key))
        let index = self.start(hash)
        while true:
            entry_plus_one := self.index_value(index)
            if entry_plus_one == 0:
                entry := self.used
                self.slots.at(entry).write(.Occupied(hash, key, value))
                self.used = entry + 1
                self.set_index(index, entry + 1)
                self.size += 1
                return .None
            entry := entry_plus_one - 1
            match self.slots.at(entry).as_ref():
                .Deleted => pass
                .Occupied(found_hash, found, _) =>
                    if found_hash == hash && found == key:
                        place := self.slots.at(entry)
                        match place.read():
                            .Occupied(matched_hash, matched, old) =>
                                place.write(.Occupied(matched_hash, matched, value))
                                return .Some(old)
                            .Deleted => panic("uniq map matched a deleted entry")
            index = (index + 1) & (capacity - 1)

    fn grow(&mut self) -> void:
        old_capacity := self.entry_capacity
        capacity := if self.size * 2 < old_capacity: old_capacity else: old_capacity * 2
        let mut next = UniqMap::[K, V].with_capacity(capacity)
        let index: usize = 0
        while index < self.used:
            let hash: usize? = match self.slots.at(index).as_ref():
                .Occupied(found, _, _) => .Some(found)
                .Deleted => .None
            match hash:
                .Some(found) =>
                    entry := next.used
                    copy(
                        next.slots.at(entry).address,
                        self.slots.at(index).address,
                        size_of::[UniqMapSlot[K, V]](),
                    )
                    next.used = entry + 1
                    next.index_entry(found, entry)
                    next.size += 1
                .None => pass
            index += 1
        self.used = 0
        *self = next

    ## True exactly when the map has an entry whose key equals `key`.
    ## See [std-collections.uniq-map.contains-key](../../spec/std/collections.md#r-std-collections.uniq-map.contains-key).
    pub fn contains_key(&self, key: K) -> bool:
        self.find_index(key).is_some()

    ## Removes the entry for `key` and moves out its value, or returns `.None` when absent.
    ## See [std-collections.uniq-map.remove](../../spec/std/collections.md#r-std-collections.uniq-map.remove).
    pub fn remove(&mut self, key: K) -> V?:
        match self.find_index(key):
            .None => .None
            .Some(index) =>
                if self.slots.pinned():
                    panic_with("collection-pinned", "a uniq map removes a key while a value reference pins it")
                place := self.slots.at(index)
                match place.read():
                    .Occupied(_, _, value) =>
                        place.write(.Deleted)
                        self.size -= 1
                        .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")

    ## Removes every entry and drops every value.
    ## See [std-collections.uniq-map.clear](../../spec/std/collections.md#r-std-collections.uniq-map.clear).
    pub fn clear(&mut self) -> void:
        if self.size > 0 && self.slots.pinned():
            panic_with("collection-pinned", "a uniq map clears its entries while a value reference pins it")
        capacity := self.entry_capacity
        *self = UniqMap::[K, V].with_capacity(capacity)

impl[K < Eq & Hash, V < Copy] UniqMap[K, V]:
    ## Returns a copy of the value for `key`, or `.None` when absent.
    ## See [std-collections.uniq-map.get](../../spec/std/collections.md#r-std-collections.uniq-map.get).
    pub fn get(&self, key: K) -> V?:
        match self.find_index(key):
            .Some(index) =>
                match self.slots.at(index).as_ref():
                    .Occupied(_, _, value) => .Some(value)
                    .Deleted => panic("uniq map found a deleted entry")
            .None => .None

## A cursor that borrows a `UniqMap` and yields its keys and value references.
## See [std-collections.uniq-map.iter](../../spec/std/collections.md#r-std-collections.uniq-map.iter).
pub struct UniqMapIter[K < Eq & Hash, V < ?Copy, 'a]:
    items: &'a UniqMap[K, V]
    at: usize

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[(K, &'a V)] for UniqMapIter[K, V, 'a]:
    fn next(&mut self) -> (K, &'a V)?:
        while self.at < self.items.used:
            index := self.at
            self.at += 1
            match self.items.slots.at(index).as_ref():
                .Occupied(_, key, value) => return .Some((key, value))
                .Deleted => pass
        .None

## A cursor that borrows a `UniqMap` and yields its keys.
## See [std-collections.uniq-map.keys](../../spec/std/collections.md#r-std-collections.uniq-map.keys).
pub struct UniqMapKeys[K < Eq & Hash, V < ?Copy, 'a]:
    entries: UniqMapIter[K, V, 'a]

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[K] for UniqMapKeys[K, V, 'a]:
    fn next(&mut self) -> K?:
        match self.entries.next():
            .Some((key, _)) => .Some(key)
            .None => .None

## The consuming cursor of a `UniqMap`; it moves each key and value out.
## See [std-collections.uniq-map.into-iter](../../spec/std/collections.md#r-std-collections.uniq-map.into-iter).
pub struct UniqMapIntoIter[K < Eq & Hash, V < ?Copy]:
    items: UniqMap[K, V]
    at: usize

impl[K < Eq & Hash, V < ?Copy] !Copy for UniqMapIntoIter[K, V]

impl[K < Eq & Hash, V < ?Copy] Iterator[(K, V)] for UniqMapIntoIter[K, V]:
    fn next(&mut self) -> (K, V)?:
        while self.at < self.items.used:
            index := self.at
            self.at += 1
            place := self.items.slots.at(index)
            match place.read():
                .Occupied(_, key, value) =>
                    place.write(.Deleted)
                    self.items.size -= 1
                    return .Some((key, value))
                .Deleted => place.write(.Deleted)
        .None

impl[K < Eq & Hash, V < ?Copy] Iterable[(K, V)] for UniqMap[K, V]:
    type IntoIter = UniqMapIntoIter[K, V]
    fn iter(self) -> UniqMapIntoIter[K, V]:
        UniqMapIntoIter { items: self, at: 0 }

impl[K < Eq & Hash, V < ?Copy] FromIterator[(K, V)] for UniqMap[K, V]:
    fn from_iter[I < ?Copy & Iterator[(K, V)]](items: I) -> UniqMap[K, V]:
        let mut cursor = items
        let mut out = UniqMap::[K, V].new()
        while true:
            match cursor.next():
                .Some((key, value)) => _ := out.insert(key, value)
                .None => break
        out

impl[T < Copy] Index[usize] for UniqList[T]:
    type Out = T
    fn index(&self, key: usize) -> T:
        if key >= self.len():
            panic_with(
                "index-out-of-bounds",
                "uniq list index ${key} out of bounds for length ${self.len()}",
            )
        *self.buffer.at(key).as_ref()

impl[T < ?Copy & Ord] UniqList[T]:
    ## Stably sorts the elements in ascending order by `Ord`, in place.
    ## See [std-collections.uniq-list.sort](../../spec/std/collections.md#r-std-collections.uniq-list.sort).
    pub fn sort(&mut self) -> void:
        self.sort_by(fn(left: &T, right: &T) -> Ordering: left.cmp(right))

## A cursor that borrows a `UniqList` and yields its elements by reference.
## See [std-collections.uniq-list.iter](../../spec/std/collections.md#r-std-collections.uniq-list.iter).
pub struct UniqListIter[T < ?Copy, 'a]:
    items: &'a UniqList[T]
    at: usize

impl[T < ?Copy, 'a] Iterator[&'a T] for UniqListIter[T, 'a]:
    fn next(&mut self) -> (&'a T)?:
        item := self.items.get_ref(self.at)
        if item.is_some():
            self.at += 1
        item

## The consuming cursor of a `UniqList`; it moves the elements out in order.
## See [std-collections.uniq-list.into-iter](../../spec/std/collections.md#r-std-collections.uniq-list.into-iter).
pub struct UniqListIntoIter[T < ?Copy]:
    items: UniqList[T]

impl[T < ?Copy] !Copy for UniqListIntoIter[T]

impl[T < ?Copy] Iterator[T] for UniqListIntoIter[T]:
    fn next(&mut self) -> T?:
        if self.items.is_empty(): .None else: .Some(self.items.remove_at(0))

impl[T < ?Copy] Iterable[T] for UniqList[T]:
    type IntoIter = UniqListIntoIter[T]
    fn iter(self) -> UniqListIntoIter[T]:
        UniqListIntoIter::[T] { items: self }

impl[T < ?Copy] FromIterator[T] for UniqList[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> UniqList[T]:
        let mut cursor = items
        let mut out = UniqList::[T].new()
        while true:
            match cursor.next():
                .Some(item) => out.push(item)
                .None => break
        out

impl[T < ?Copy & Eq] Eq for UniqList[T]:
    fn eq(&self, other: &UniqList[T]) -> bool:
        if self.len() != other.len():
            return false
        let index: usize = 0
        while index < self.len():
            if !self.buffer.at(index).as_ref().eq(other.buffer.at(index).as_ref()):
                return false
            index += 1
        true

impl[T < ?Copy & Debug] Debug for UniqList[T]:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        let index: usize = 0
        while index < self.len():
            _ := list.entry(self.buffer.at(index).as_ref())
            index += 1
        list.finish()

impl[T < ?Copy & Hash] Hash for UniqList[T]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(self.len()))
        let index: usize = 0
        while index < self.len():
            self.buffer.at(index).as_ref().hash(state)
            index += 1

impl[T] List[T]:
    # `push` is a language-tier intrinsic method of the checker
    # (spec/lang/10-modules.md#built-in-methods). The other mutators are
    # plain hd over it, `list_truncate`, the one shrinking primitive, and
    # `list_extend`, the one bulk append.
    # Removes the last item, or gives `.None` for an empty list
    # (module.method.list-pop).
    ## Removes and returns the last item, or `.None` for an empty list.
    ## See [module.method.list-pop](../../spec/lang/10-modules.md#r-module.method.list-pop).
    pub fn pop(&mut self) -> T?:
        size := self.len()
        if size == 0:
            return .None
        last := self[size - 1]
        list_truncate(self, size - 1)
        .Some(last)

    # Puts `value` at `index` and moves the later items up one place;
    # `index == len()` appends (module.method.list-insert).
    ## Puts `value` at `index` and moves the later items up one place; `index == len()` appends.
    ## See [module.method.list-insert](../../spec/lang/10-modules.md#r-module.method.list-insert).
    pub fn insert(&mut self, index: usize, value: T) -> void:
        size := self.len()
        if index > size:
            panic_with(
                "index-out-of-bounds",
                "list insert index ${index} out of bounds for length ${size}",
            )
        self.push(value)
        let at: usize = size
        while at > index:
            self[at] = self[at - 1]
            at = at - 1
        self[index] = value

    # Removes and returns the item at `index`, moving the later items down
    # one place (module.method.list-remove-at).
    ## Removes and returns the item at `index`, moving the later items down one place.
    ## See [module.method.list-remove-at](../../spec/lang/10-modules.md#r-module.method.list-remove-at).
    pub fn remove_at(&mut self, index: usize) -> T:
        size := self.len()
        if index >= size:
            panic_with(
                "index-out-of-bounds",
                "list remove_at index ${index} out of bounds for length ${size}",
            )
        removed := self[index]
        let at: usize = index
        while at + 1 < size:
            self[at] = self[at + 1]
            at = at + 1
        list_truncate(self, size - 1)
        removed

    # Removes every item (module.method.list-clear).
    ## Removes every item, so `len()` is 0 after it.
    ## See [module.method.list-clear](../../spec/lang/10-modules.md#r-module.method.list-clear).
    pub fn clear(&mut self) -> void:
        list_truncate(self, 0)

    ## Returns a read-only live view of this list. The span cannot outlive the list.
    ## See [std-collections.span.list](../../spec/std/collections.md#r-std-collections.span.list).
    pub fn span['a](&'a self) -> Span[T, 'a]:
        Span { items: self, start: 0, end: self.len() }

    ## Returns a mutable live view of this list. The span cannot outlive the list.
    ## See [std-collections.span-mut.list](../../spec/std/collections.md#r-std-collections.span-mut.list).
    pub fn span_mut['a](&'a mut self) -> SpanMut[T, 'a]:
        SpanMut { items: self, start: 0, end: self.len() }

    # A read-only window on the elements from `start` up to `end`, with no
    # copy (spec/std/collections.md#views).
    ## A read-only window on the elements from `start` up to `end`, with no copy.
    ## See [std-collections.view](../../spec/std/collections.md#r-std-collections.view).
    pub fn view(&self, start: usize, end: usize) -> ListView[T]:
        if end > self.len() || start > end:
            panic_with(
                "index-out-of-bounds",
                "list view start ${start} end ${end} out of bounds for length ${self.len()}",
            )
        ListView::[T] { items: *self, start: start, end: end }

    ## Returns a new list with `transform` applied to each element, in order.
    ## See [std-iter.method.map](../../spec/std/iter.md#r-std-iter.method.map).
    pub fn map[U](&self, transform: fn(&T) -> U) -> List[U]:
        let mut mapped: List[U] = []
        for item in self:
            mapped.push(transform(&item))
        mapped

    ## Returns a new list of the elements for which `keep` is true, in list order.
    ## See [std-collections.access.filter](../../spec/std/collections.md#r-std-collections.access.filter).
    pub fn filter(&self, keep: fn(&T) -> bool) -> List[T]:
        let mut kept: List[T] = []
        for item in self:
            if keep(&item):
                kept.push(item)
        kept

    # The checked read beside `items[i]` (r-std-collections.access.get-copy).
    ## Returns `.Some` of a copy of the element at `index`, or `.None` when `index` is not less than `len()`. It never panics.
    ## See [std-collections.access.get-copy](../../spec/std/collections.md#r-std-collections.access.get-copy).
    pub fn get(&self, index: usize) -> T?:
        if index >= self.len(): .None else: .Some(self[index])

    ## True exactly when the list has no elements.
    ## See [std-collections.access.is-empty](../../spec/std/collections.md#r-std-collections.access.is-empty).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    # The first `count` items, or all of them (r-std-collections.access.take).
    ## Returns a new list of the first `count` elements, or of every element when `count` is at least `len()`.
    ## See [std-collections.access.take](../../spec/std/collections.md#r-std-collections.access.take).
    pub fn take(self, count: usize) -> List[T]:
        let mut kept: List[T] = []
        let index: usize = 0
        while index < count && index < self.len():
            kept.push(self[index])
            index = index + 1
        kept

    # Appends `other`'s items as they were at the call, so
    # `items.extend(items)` doubles the list (r-std-collections.access.extend.self).
    ## Appends each element of `other` to the list, in order, as `push` does.
    ## See [std-collections.access.extend](../../spec/std/collections.md#r-std-collections.access.extend).
    pub fn extend(&mut self, other: List[T]) -> void:
        list_extend(self, other)

    ## Returns a copy of the first element in `.Some`, or `.None` for an empty list.
    ## See [std-collections.access.first-last-copy](../../spec/std/collections.md#r-std-collections.access.first-last-copy).
    pub fn first(&self) -> T?:
        if self.len() == 0: .None else: .Some(self[0])

    ## Returns a copy of the last element in `.Some`, or `.None` for an empty list.
    ## See [std-collections.access.first-last-copy](../../spec/std/collections.md#r-std-collections.access.first-last-copy).
    pub fn last(&self) -> T?:
        if self.len() == 0: .None else: .Some(self[self.len() - 1])

    ## Returns a new list of the elements in reverse order.
    ## See [std-collections.access.reversed](../../spec/std/collections.md#r-std-collections.access.reversed).
    pub fn reversed(self) -> List[T]:
        let mut backwards: List[T] = []
        let index = self.len()
        while index > 0:
            index = index - 1
            backwards.push(self[index])
        backwards

    # Stable insertion-sorted runs, merged with one reusable scratch list.
    ## Returns a new list in ascending order by `compare`. The sort is stable.
    ## See [std-collections.access.sorted-by](../../spec/std/collections.md#r-std-collections.access.sorted-by).
    pub fn sorted_by(&self, compare: fn(&T, &T) -> Ordering) -> List[T]:
        size := self.len()
        if size <= 1:
            return *self
        run := 16
        let mut sorted = *self
        let start: usize = 0
        while start < size:
            end := start + (if run < size - start: run else: size - start)
            let index = start + 1
            while index < end:
                value := sorted[index]
                let hole = index
                while hole > start:
                    match compare(&value, &sorted[hole - 1]):
                        .Less => pass
                        _ => break
                    sorted[hole] = sorted[hole - 1]
                    hole -= 1
                if hole != index:
                    sorted[hole] = value
                index += 1
            start = end
        if size <= run:
            return sorted
        # Copy-on-write provides the output and scratch storage; each pass
        # overwrites every slot before swapping the two lists for reuse.
        let mut scratch = *self
        let width = run
        while width < size:
            start = 0
            while start < size:
                middle := start + (if width < size - start: width else: size - start)
                end := middle + (if width < size - middle: width else: size - middle)
                let left = start
                let right = middle
                let out = start
                while out < end:
                    let take_right = left == middle
                    if !take_right && right < end:
                        take_right = match compare(&sorted[right], &sorted[left]):
                            .Less => true
                            _ => false
                    if take_right:
                        scratch[out] = sorted[right]
                        right += 1
                    else:
                        scratch[out] = sorted[left]
                        left += 1
                    out += 1
                start = end
            previous := sorted
            sorted = scratch
            scratch = previous
            if width >= size - width:
                break
            width *= 2
        sorted

    # In place, by the stable sort `sorted_by` makes.
    ## Sorts the list in ascending order by `compare`, in place. The sort is stable.
    ## See [std-collections.helper.sort-by](../../spec/std/collections.md#r-std-collections.helper.sort-by).
    pub fn sort_by(&mut self, compare: fn(&T, &T) -> Ordering) -> void:
        *self = self.sorted_by(compare)

    # In place, by `sorted_by_key`: `key` is called once per element.
    ## Sorts the list in ascending order of `key(element)` by `Ord`, in place, calling `key` once per element. The sort is stable.
    ## See [std-collections.helper.sort-by-key](../../spec/std/collections.md#r-std-collections.helper.sort-by-key).
    pub fn sort_by_key[K < Ord](&mut self, key: fn(&T) -> K) -> void:
        *self = self.sorted_by_key(key)

    # Keeps the accepted elements in order, then drops the rest from the end.
    ## Keeps the elements for which `keep` is true, in list order, in place; `keep` runs once per element, in order.
    ## See [std-collections.helper.retain](../../spec/std/collections.md#r-std-collections.helper.retain).
    pub fn retain(&mut self, keep: fn(&T) -> bool) -> void:
        size := self.len()
        let kept: usize = 0
        let index: usize = 0
        while index < size:
            item := self[index]
            if keep(&item):
                self[kept] = item
                kept += 1
            index += 1
        while self.len() > kept:
            _ := self.pop()

    ## Exchanges the elements at `a` and `b`; either index out of range panics with `index-out-of-bounds`.
    ## See [std-collections.helper.swap](../../spec/std/collections.md#r-std-collections.helper.swap).
    pub fn swap(&mut self, a: usize, b: usize) -> void:
        held := self[a]
        self[a] = self[b]
        self[b] = held

    # Consecutive pieces of `size` items; the last may be shorter.
    ## Returns read-only views in consecutive pieces of `size` elements; only the last may be shorter.
    ## See [std-collections.list.chunks.views](../../spec/std/collections.md#r-std-collections.list.chunks.views).
    pub fn chunks(&self, size: usize) -> List[ListView[T]]:
        if size == 0:
            panic("chunks: size must be positive")
        let mut pieces: List[ListView[T]] = []
        let start: usize = 0
        while start < self.len():
            remaining := self.len() - start
            width := if size < remaining: size else: remaining
            pieces.push(self.view(start, start + width))
            start = start + width
        pieces

    # Pairs items by position, stopping at the shorter list.
    ## Returns a new list of pairs `(self[i], other[i])` for each index `i` of both lists, stopping at the shorter one.
    ## See [std-collections.access.zip](../../spec/std/collections.md#r-std-collections.access.zip).
    pub fn zip[U](self, other: List[U]) -> List[(T, U)]:
        let mut pairs: List[(T, U)] = []
        let index: usize = 0
        while index < self.len() && index < other.len():
            pairs.push((self[index], other[index]))
            index = index + 1
        pairs

    # The helpers of spec/std/collections.md#list-helpers. Each callback
    # runs in list order, at most once per element.

    # A stable sort by `key(item)`, which is called once per element.
    ## Returns the elements in ascending order of `key(element)` by `Ord`, calling `key` once per element.
    ## See [std-collections.helper.sorted-by-key](../../spec/std/collections.md#r-std-collections.helper.sorted-by-key).
    pub fn sorted_by_key[K < Ord](&self, key: fn(&T) -> K) -> List[T]:
        let mut keyed: List[(K, usize)] = []
        let index: usize = 0
        for item in self:
            keyed.push((key(&item), index))
            index = index + 1
        order := keyed.sorted_by(
            fn(left: &(K, usize), right: &(K, usize)) -> Ordering: left._0.cmp(&right._0)
        )
        let mut sorted: List[T] = []
        for (_, at) in order:
            sorted.push(self[at])
        sorted

    # The elements under each key, keys in the order first seen.
    ## Groups the elements by `key(element)`, each group in list order, keys in first-seen order.
    ## See [std-collections.helper.group-by](../../spec/std/collections.md#r-std-collections.helper.group-by).
    pub fn group_by[K < Eq & Hash](&self, key: fn(&T) -> K) -> Map[K, List[T]]:
        let mut groups: Map[K, List[T]] = {}
        for item in self:
            group := key(&item)
            match groups.get(group):
                .Some(_) => groups[group].push(item)
                .None => groups[group] = [item]
        groups

    # The elements `keep` accepts, then the rest, each in order.
    ## Splits the list into the elements for which `keep` is true and the rest, each in list order.
    ## See [std-collections.helper.partition](../../spec/std/collections.md#r-std-collections.helper.partition).
    pub fn partition(&self, keep: fn(&T) -> bool) -> (List[T], List[T]):
        let mut kept: List[T] = []
        let mut rest: List[T] = []
        for item in self:
            if keep(&item):
                kept.push(item)
            else:
                rest.push(item)
        (kept, rest)

    # Stops at the first element that passes.
    ## True when `test` is true for at least one element, stopping at the first.
    ## See [std-collections.helper.any-all](../../spec/std/collections.md#r-std-collections.helper.any-all).
    pub fn any(&self, test: fn(&T) -> bool) -> bool:
        for item in self:
            if test(&item):
                return true
        false

    # Stops at the first element that fails.
    ## True when `test` is true for every element, stopping at the first false.
    ## See [std-collections.helper.any-all](../../spec/std/collections.md#r-std-collections.helper.any-all).
    pub fn all(&self, test: fn(&T) -> bool) -> bool:
        for item in self:
            if !test(&item):
                return false
        true

    ## Returns a copy of the first element for which `test` is true, in `.Some`, or `.None`.
    ## See [std-collections.helper.find-copy](../../spec/std/collections.md#r-std-collections.helper.find-copy).
    pub fn find(&self, test: fn(&T) -> bool) -> T?:
        let index: usize = 0
        while index < self.len():
            if test(&self[index]):
                return .Some(self[index])
            index = index + 1
        .None

    ## Applies `transform` to each element and concatenates the results, in order.
    ## See [std-collections.helper.flat-map.iterable-owned](../../spec/std/collections.md#r-std-collections.helper.flat-map.iterable-owned).
    pub fn flat_map[U, I < Iterable[U]](self, transform: fn(T) -> I) -> List[U]:
        let mut flat: List[U] = []
        for item in self:
            for part in transform(item):
                flat.push(part)
        flat

    # Every run of `size` consecutive elements, overlapping, in order.
    ## Returns read-only views of every run of `size` consecutive elements, each starting one index later.
    ## See [std-collections.helper.windows.views](../../spec/std/collections.md#r-std-collections.helper.windows.views).
    pub fn windows(self, size: usize) -> List[ListView[T]]:
        if size == 0:
            panic("windows: size must be positive")
        let mut runs: List[ListView[T]] = []
        if size > self.len():
            return runs
        last := self.len() - size
        let start: usize = 0
        while start <= last:
            runs.push(self.view(start, start + size))
            start = start + 1
        runs

impl[T < Eq] List[T]:
    ## True exactly when the list has an element equal to `value`.
    ## See [std-collections.helper.contains](../../spec/std/collections.md#r-std-collections.helper.contains).
    pub fn contains(&self, value: T) -> bool:
        self.index_of(value).is_some()

    # The index of the first element equal to `value`.
    ## Returns the index of the first element equal to `value` by `Eq`, in `.Some`, or `.None`.
    ## See [std-collections.helper.contains](../../spec/std/collections.md#r-std-collections.helper.contains).
    pub fn index_of(&self, value: T) -> usize?:
        let index: usize = 0
        for item in self:
            if item == value:
                return .Some(index)
            index = index + 1
        .None

    # Drops each element equal to the one just before it, as Rust's `Vec::dedup`.
    ## Returns the list with each run of equal neighbours cut to its first element.
    ## See [std-collections.helper.dedup](../../spec/std/collections.md#r-std-collections.helper.dedup).
    pub fn dedup(self) -> List[T]:
        let mut kept: List[T] = []
        for item in self:
            match kept.last():
                .Some(previous) =>
                    if previous != item:
                        kept.push(item)
                .None => kept.push(item)
        kept

# The total of the elements, in order (r-std-collections.helper.sum).
impl[T < Num] List[T]:
    ## Returns the sum of the elements, left to right.
    ## See [std-collections.helper.sum](../../spec/std/collections.md#r-std-collections.helper.sum).
    pub fn sum(self) -> T:
        let total = T::zero()
        for item in self:
            total = total + item
        total

impl[T < Ord] List[T]:
    # A stable sort in ascending order.
    ## Returns the elements in ascending order by `Ord`.
    ## See [std-collections.helper.sorted](../../spec/std/collections.md#r-std-collections.helper.sorted).
    pub fn sorted(&self) -> List[T]:
        self.sorted_by(fn(left: &T, right: &T) -> Ordering: left.cmp(right))

    # A stable sort in ascending order, in place.
    ## Sorts the list in ascending order by `Ord`, in place. The sort is stable.
    ## See [std-collections.helper.sort](../../spec/std/collections.md#r-std-collections.helper.sort).
    pub fn sort(&mut self) -> void:
        *self = self.sorted()

    # The first of the smallest elements.
    ## Returns a copy of the first smallest element by `Ord` in `.Some`, or `.None` for an empty list.
    ## See [std-collections.helper.min-max.copy-first](../../spec/std/collections.md#r-std-collections.helper.min-max.copy-first).
    pub fn min(&self) -> T?:
        if self.len() == 0:
            return .None
        let best: usize = 0
        let index: usize = 1
        while index < self.len():
            if before(self[index], self[best]):
                best = index
            index = index + 1
        .Some(self[best])

    # The first of the largest elements, as Python's `max` gives.
    ## Returns a copy of the first largest element by `Ord` in `.Some`, or `.None` for an empty list.
    ## See [std-collections.helper.min-max.copy-first](../../spec/std/collections.md#r-std-collections.helper.min-max.copy-first).
    pub fn max(&self) -> T?:
        if self.len() == 0:
            return .None
        let best: usize = 0
        let index: usize = 1
        while index < self.len():
            if before(self[best], self[index]):
                best = index
            index = index + 1
        .Some(self[best])

impl[T < Eq & Hash] List[T]:
    ## Returns the list with each element after its first occurrence dropped, in list order.
    ## See [std-collections.helper.unique](../../spec/std/collections.md#r-std-collections.helper.unique).
    pub fn unique(self) -> List[T]:
        let mut seen: Set[T] = Set::new()
        let mut kept: List[T] = []
        for item in self:
            if seen.insert(item):
                kept.push(item)
        kept

# The by-key extremes keep the first of equal keys, as `min` and `max` do
# (r-std-collections.helper.by-key.copy-first).
impl[T] List[T]:
    ## Returns a copy of the first element with the smallest `key` by `Ord` in `.Some`, or `.None` for an empty list.
    ## See [std-collections.helper.by-key.copy-first](../../spec/std/collections.md#r-std-collections.helper.by-key.copy-first).
    pub fn min_by_key[K < Ord](&self, key: fn(&T) -> K) -> T?:
        if self.len() == 0:
            return .None
        let best: usize = 0
        let best_key = key(&self[0])
        let index: usize = 1
        while index < self.len():
            item_key := key(&self[index])
            if before(item_key, best_key):
                best = index
                best_key = item_key
            index = index + 1
        .Some(self[best])

    ## Returns a copy of the first element with the largest `key` by `Ord` in `.Some`, or `.None` for an empty list.
    ## See [std-collections.helper.by-key.copy-first](../../spec/std/collections.md#r-std-collections.helper.by-key.copy-first).
    pub fn max_by_key[K < Ord](&self, key: fn(&T) -> K) -> T?:
        if self.len() == 0:
            return .None
        let best: usize = 0
        let best_key = key(&self[0])
        let index: usize = 1
        while index < self.len():
            item_key := key(&self[index])
            if before(best_key, item_key):
                best = index
                best_key = item_key
            index = index + 1
        .Some(self[best])

# Whether `left` orders before `right`.
fn before[T < Ord](left: T, right: T) -> bool:
    match left.cmp(&right):
        .Less => true
        _ => false

# How many times each element occurs, keys in the order first seen
# (spec/std/collections.md#counts).
## How many times each element occurs, keys in the order first seen.
## See [std-collections.counts.decl](../../spec/std/collections.md#r-std-collections.counts.decl).
pub fn counts[T < Eq & Hash](items: List[T]) -> Map[T, usize]:
    let mut tally: Map[T, usize] = {}
    for item in items:
        *tally.get_or_insert(item, 0) += 1
    tally

# The std `Map` methods beside the language-tier `len`, `get`, and `remove`
# (spec/std/collections.md#map-methods). `keys` and `values` copy into new
# lists, so a later change to the map does not show in them.
impl[K < Eq & Hash, V] Map[K, V]:
    ## Returns a mutable reference to the value for `key`; when the map has no equal key, inserts `default` first.
    ## See [std-collections.map.get-or-insert](../../spec/std/collections.md#r-std-collections.map.get-or-insert).
    @intrinsic("map_probe")
    pub fn get_or_insert(&mut self, key: K, default: V) -> &mut V:
        panic("intrinsic")

    ## True when the map has an entry for `key`.
    ## See [std-collections.map.contains-key](../../spec/std/collections.md#r-std-collections.map.contains-key).
    pub fn contains_key(&self, key: K) -> bool:
        match self.get(key):
            .Some(_) => true
            .None => false

    ## A new list of the keys, in the map's iteration order.
    ## See [std-collections.map.keys.order](../../spec/std/collections.md#r-std-collections.map.keys.order).
    pub fn keys(&self) -> List[K]:
        let mut found: List[K] = []
        for (key, _) in self:
            found.push(key)
        found

    ## A new list of the values, in the map's iteration order.
    ## See [std-collections.map.keys.order](../../spec/std/collections.md#r-std-collections.map.keys.order).
    pub fn values(&self) -> List[V]:
        let mut found: List[V] = []
        for (_, value) in self:
            found.push(value)
        found

    ## True exactly when the map has no entries.
    ## See [std-collections.map.is-empty](../../spec/std/collections.md#r-std-collections.map.is-empty).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

# The entries of a map, and the most frequent ones of a tally
# (spec/std/collections.md#map-methods).
impl[K < Eq & Hash, V] Map[K, V]:
    ## A new list of the `(key, value)` pairs, in the map's iteration order.
    ## See [std-collections.map.entries](../../spec/std/collections.md#r-std-collections.map.entries).
    pub fn entries(&self) -> List[(K, V)]:
        let mut found: List[(K, V)] = []
        for (key, value) in self:
            found.push((key, value))
        found

impl[K < Eq & Hash] Map[K, usize]:
    ## Returns the `n` pairs with the largest counts, largest first; equal counts keep the map's order.
    ## See [std-collections.map.most-common](../../spec/std/collections.md#r-std-collections.map.most-common).
    pub fn most_common(&self, n: usize) -> List[(K, usize)]:
        self.entries()
            .sorted_by(
                fn(left: &(K, usize), right: &(K, usize)) -> Ordering: right._1.cmp(&left._1)
            )
            .take(n)

# A read-only window on a run of a list's elements
# (spec/std/collections.md#views). It holds a copy-on-write snapshot of the
# list value (r-std-collections.view.snapshot): later writes to the list do
# not show through, and a kept view keeps the whole storage alive.
## A read-only window on a run of a list's elements. It holds a snapshot of the list, so later writes to the list do not show through; a kept view keeps the whole storage alive, so copy it with `to_list()`.
## See [std-collections.view.type](../../spec/std/collections.md#r-std-collections.view.type).
@derive(Debug)
pub struct ListView[T]:
    items: List[T]
    start: usize
    end: usize

impl[T] ListView[T]:
    ## Returns the number of elements in the view.
    ## See [std-collections.view.len](../../spec/std/collections.md#r-std-collections.view.len).
    pub fn len(&self) -> usize:
        self.end - self.start

    ## Returns a new list that holds the view's elements in order.
    ## See [std-collections.view.to-list-value](../../spec/std/collections.md#r-std-collections.view.to-list-value).
    pub fn to_list(&self) -> List[T]:
        let mut copy: List[T] = []
        let index = self.start
        while index < self.end:
            copy.push(self.items[index])
            index = index + 1
        copy

impl[T] Index[usize] for ListView[T]:
    type Out = T
    fn index(&self, key: usize) -> T:
        len := self.end - self.start
        if key >= len:
            panic_with(
                "index-out-of-bounds",
                "list view index ${key} out of bounds for length ${len}",
            )
        self.items[self.start + key]

impl[T] Iterable[T] for ListView[T]:
    type IntoIter = ListViewIter[T]
    fn iter(self) -> ListViewIter[T]:
        ListViewIter { view: self, at: self.start }

## The cursor of a view's `iter`: the view's elements in order, each read from the snapshot.
## See [std-collections.view.iter](../../spec/std/collections.md#r-std-collections.view.iter).
pub struct ListViewIter[T]:
    view: ListView[T]
    at: usize

impl[T] Iterator[T] for ListViewIter[T]:
    fn next(&mut self) -> T?:
        if self.at >= self.view.end:
            return .None
        self.at = self.at + 1
        .Some(self.view.items[self.at - 1])

# A read-only live view of a list (spec/std/collections.md#spans). Its
# lifetime keeps the list and its elements live for every read.
## A read-only live view of a list. It borrows the list, so it cannot outlive it.
## See [std-collections.span.type](../../spec/std/collections.md#r-std-collections.span.type).
pub struct Span[T, 'a]:
    items: &'a List[T]
    start: usize
    end: usize

impl[T, 'a] Span[T, 'a]:
    ## Returns the number of elements in the span.
    ## See [std-collections.span.len](../../spec/std/collections.md#r-std-collections.span.len).
    pub fn len(&self) -> usize:
        self.end - self.start

    ## Returns the element at `index` by reference, or `.None` when the index is out of range.
    ## See [std-collections.span.get](../../spec/std/collections.md#r-std-collections.span.get).
    pub fn get(self, index: usize) -> (&'a T)?:
        if index >= self.len(): .None else: .Some(&self.items[self.start + index])

    ## Returns a cursor that yields the span's elements by reference, in order.
    ## See [std-collections.span.iter](../../spec/std/collections.md#r-std-collections.span.iter).
    pub fn iter(self) -> SpanIter[T, 'a]:
        SpanIter { span: self, at: 0 }

    ## Returns the part of this span selected by `range`, without copying elements.
    ## See [std-collections.span.slice](../../spec/std/collections.md#r-std-collections.span.slice).
    pub fn slice(self, range: Range[usize]) -> Span[T, 'a]:
        let stop = range.end
        if range.inclusive:
            if range.end >= self.len():
                panic_with("index-out-of-bounds", "span slice out of bounds")
            stop = stop + 1
        if stop > self.len() || range.start > stop:
            panic_with("index-out-of-bounds", "span slice out of bounds")
        Span { items: self.items, start: self.start + range.start, end: self.start + stop }

impl[T, 'a] Index[usize] for Span[T, 'a]:
    type Out = &'a T
    fn index(&self, key: usize) -> &'a T:
        if key >= self.len():
            panic_with("index-out-of-bounds", "span index out of bounds")
        &self.items[self.start + key]

## A mutable live view of a list. It borrows the list exclusively, so it cannot outlive it.
## See [std-collections.span-mut.type](../../spec/std/collections.md#r-std-collections.span-mut.type).
pub struct SpanMut[T, 'a]:
    items: &'a mut List[T]
    start: usize
    end: usize

impl[T, 'a] SpanMut[T, 'a]:
    ## Returns the number of elements in the span.
    ## See [std-collections.span-mut.len](../../spec/std/collections.md#r-std-collections.span-mut.len).
    pub fn len(&self) -> usize:
        self.end - self.start

    ## Returns a shared reference to the indexed element, or `.None` outside the span.
    ## See [std-collections.span-mut.get](../../spec/std/collections.md#r-std-collections.span-mut.get).
    pub fn get['b](&'b self, index: usize) -> (&'b T)?:
        if index >= self.len(): .None else: .Some(&self.items[self.start + index])

    ## Returns a mutable reference to the indexed element, or `.None` outside the span.
    ## See [std-collections.span-mut.get-mut](../../spec/std/collections.md#r-std-collections.span-mut.get-mut).
    pub fn get_mut['b](&'b mut self, index: usize) -> (&'b mut T)?:
        if index >= self.len(): .None else: .Some(&mut self.items[self.start + index])

    ## Returns the part of this span selected by `range`, without copying elements.
    ## See [std-collections.span-mut.slice](../../spec/std/collections.md#r-std-collections.span-mut.slice).
    pub fn slice_mut['b](&'b mut self, range: Range[usize]) -> SpanMut[T, 'b]:
        let stop = range.end
        if range.inclusive:
            if range.end >= self.len():
                panic_with("index-out-of-bounds", "mutable span slice out of bounds")
            stop = stop + 1
        if stop > self.len() || range.start > stop:
            panic_with("index-out-of-bounds", "mutable span slice out of bounds")
        SpanMut { items: &mut *self.items, start: self.start + range.start, end: self.start + stop }

    ## Exchanges the elements at `left` and `right`.
    ## See [std-collections.span-mut.swap](../../spec/std/collections.md#r-std-collections.span-mut.swap).
    pub fn swap(&mut self, left: usize, right: usize) -> void:
        if left >= self.len() || right >= self.len():
            panic_with("index-out-of-bounds", "mutable span swap index out of bounds")
        value := self.items[self.start + left]
        self.items[self.start + left] = self.items[self.start + right]
        self.items[self.start + right] = value

    ## Replaces every element in the span with `value`.
    ## See [std-collections.span-mut.fill](../../spec/std/collections.md#r-std-collections.span-mut.fill).
    pub fn fill(&mut self, value: T) -> void:
        let index: usize = 0
        while index < self.len():
            self.items[self.start + index] = value
            index = index + 1

# A copy of the element, as `items[i]` reads: `index` borrows the span
# only for the call, so a reference result could outlive a later write.
impl[T, 'a] Index[usize] for SpanMut[T, 'a]:
    type Out = T
    fn index(&self, key: usize) -> T:
        if key >= self.len():
            panic_with("index-out-of-bounds", "mutable span index out of bounds")
        self.items[self.start + key]

impl[T, 'a] IndexSet[usize, T] for SpanMut[T, 'a]:
    fn index_set(&mut self, key: usize, value: T) -> void:
        if key >= self.len():
            panic_with("index-out-of-bounds", "mutable span index out of bounds")
        self.items[self.start + key] = value

## The cursor of a span's `iter`: the span's elements in order, each borrowed from its list.
## See [std-collections.span.cursor](../../spec/std/collections.md#r-std-collections.span.cursor).
pub struct SpanIter[T, 'a]:
    span: Span[T, 'a]
    at: usize

impl[T, 'a] Iterator[&'a T] for SpanIter[T, 'a]:
    fn next(&mut self) -> (&'a T)?:
        if self.at >= self.span.len():
            return .None
        let at = self.at
        self.at = self.at + 1
        self.span.get(at)

# A double-ended queue (spec/std/collections.md#deque): a ring buffer.
# `slots` holds the `count` elements from `head` on, wrapping at its end,
# and every other slot is `.None`. A push into a full buffer first copies
# the elements, front first, into a buffer twice its size, so each push is
# amortized O(1). The prototype has no `List.pop` yet, so a pop clears its slot.
# A deque is a value: a copy shares `slots` until either side changes, as a
# list does (r-std-collections.struct.value).
## A double-ended queue: pushes and pops at both ends, in amortized constant time.
## See [std-collections.deque.collect-surface](../../spec/std/collections.md#r-std-collections.deque.collect-surface).
pub struct Deque[T]:
    slots: List[T?]
    head: usize
    count: usize

impl[T] Deque[T]:
    ## Returns an empty deque.
    ## See [std-collections.deque.order](../../spec/std/collections.md#r-std-collections.deque.order).
    pub fn new() -> Deque[T]:
        Deque::[T] { slots: [], head: 0, count: 0 }

    ## Returns the number of elements.
    ## See [std-collections.deque.len](../../spec/std/collections.md#r-std-collections.deque.len).
    pub fn len(&self) -> usize:
        self.count

    ## True exactly when the deque has no elements.
    ## See [std-collections.deque.len](../../spec/std/collections.md#r-std-collections.deque.len).
    pub fn is_empty(&self) -> bool:
        self.count == 0

    ## Adds `value` after the back.
    ## See [std-collections.deque.push](../../spec/std/collections.md#r-std-collections.deque.push).
    pub fn push_back(&mut self, value: T) -> void:
        self.reserve_one()
        self.slots[self.slot(self.count)] = .Some(value)
        self.count = self.count + 1

    ## Adds `value` before the front.
    ## See [std-collections.deque.push](../../spec/std/collections.md#r-std-collections.deque.push).
    pub fn push_front(&mut self, value: T) -> void:
        self.reserve_one()
        self.head = self.slot(self.slots.len() - 1)
        self.slots[self.head] = .Some(value)
        self.count = self.count + 1

    ## Removes the front element and returns it in `.Some`, or `.None` when the deque is empty.
    ## See [std-collections.deque.pop](../../spec/std/collections.md#r-std-collections.deque.pop).
    pub fn pop_front(&mut self) -> T?:
        if self.count == 0:
            return .None
        value := self.slots[self.head]
        self.slots[self.head] = .None
        self.head = self.slot(1)
        self.count = self.count - 1
        value

    ## Removes the back element and returns it in `.Some`, or `.None` when the deque is empty.
    ## See [std-collections.deque.pop](../../spec/std/collections.md#r-std-collections.deque.pop).
    pub fn pop_back(&mut self) -> T?:
        if self.count == 0:
            return .None
        last := self.slot(self.count - 1)
        value := self.slots[last]
        self.slots[last] = .None
        self.count = self.count - 1
        value

    ## Returns a copy of the front element without removing it, or `.None` when the deque is empty.
    ## See [std-collections.deque.ends-copy](../../spec/std/collections.md#r-std-collections.deque.ends-copy).
    pub fn front(&self) -> T?:
        self.get(0)

    ## Returns a copy of the back element without removing it, or `.None` when the deque is empty.
    ## See [std-collections.deque.ends-copy](../../spec/std/collections.md#r-std-collections.deque.ends-copy).
    pub fn back(&self) -> T?:
        if self.count == 0: .None else: self.get(self.count - 1)

    # The element `index` places from the front; `.None` out of range
    # (r-std-collections.deque.get-copy).
    ## Returns a copy of the element `index` places from the front in `.Some`, so `get(0)` is the front. An `index` that is not less than `len` gives `.None`.
    ## See [std-collections.deque.get-copy](../../spec/std/collections.md#r-std-collections.deque.get-copy).
    pub fn get(&self, index: usize) -> T?:
        if index >= self.count:
            return .None
        self.slots[self.slot(index)]

    # The slot `offset` places after the front, wrapping at the end.
    fn slot(&self, offset: usize) -> usize:
        (self.head + offset) % self.slots.len()

    # Makes room for one more element.
    fn reserve_one(&mut self) -> void:
        capacity := self.slots.len()
        if self.count < capacity:
            return
        let mut grown: List[T?] = []
        let index: usize = 0
        while index < self.count:
            grown.push(self.slots[self.slot(index)])
            index = index + 1
        let size: usize = if capacity < 4: 4 else: capacity * 2
        while grown.len() < size:
            grown.push(.None)
        self.slots = grown
        self.head = 0

# Front to back, over the deque as it was when `iter` was called
# (r-std-collections.deque.iter, r-std-collections.deque.snapshot).
impl[T] Iterable[T] for Deque[T]:
    type IntoIter = DequeIter[T]
    fn iter(self) -> DequeIter[T]:
        DequeIter { deque: self, at: 0 }

## The cursor of a deque's `iter`: its elements front to back.
## See [std-collections.deque.iter](../../spec/std/collections.md#r-std-collections.deque.iter).
pub struct DequeIter[T]:
    deque: Deque[T]
    at: usize

impl[T] Iterator[T] for DequeIter[T]:
    fn next(&mut self) -> T?:
        if self.at >= self.deque.count:
            return .None
        self.at = self.at + 1
        self.deque.get(self.at - 1)

# Collect directly into the ring buffer, in front-to-back order.
# See r-std-collections.deque.collect.
impl[T] FromIterator[T] for Deque[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> Deque[T]:
        let mut cursor = items
        let mut queue: Deque[T] = Deque::new()
        while true:
            match cursor.next():
                .Some(item) => queue.slots.push(.Some(item))
                .None => break
        queue.count = queue.slots.len()
        queue

# Equal lengths and equal elements front to back, as `List`'s `Eq`
# (r-std-collections.deque.eq); the ring layout does not matter.
# Keep handwritten Eq: compare logical elements, independent of ring layout.
impl[T < Eq] Eq for Deque[T]:
    fn eq(&self, other: &Deque[T]) -> bool:
        if self.count != other.count:
            return false
        let index: usize = 0
        while index < self.count:
            if self.get(index) != other.get(index):
                return false
            index = index + 1
        true

# The elements front to back, as `List`'s `Debug` writes them
# (r-std-format.debug.std-types.sequences).
# Keep handwritten Debug: render logical entries as collection syntax rather than storage fields.
impl[T < Debug] Debug for Deque[T]:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        for item in *self:
            _ := list.entry(item)
        list.finish()

# A set of distinct elements in its map's deterministic order
# (spec/std/collections.md#set), plain hd over a `Map` whose values say
# nothing.
## A set holds distinct elements, in the order they were inserted.
## See [std-collections.set.decl](../../spec/std/collections.md#r-std-collections.set.decl).
pub struct Set[T < Eq & Hash]:
    entries: Map[T, bool]

impl[T < Eq & Hash] Set[T]:
    ## Returns an empty set.
    ## See [std-collections.set.distinct](../../spec/std/collections.md#r-std-collections.set.distinct).
    pub fn new() -> Set[T]:
        Set::[T] { entries: {} }

    ## Returns the number of elements.
    ## See [std-collections.set.len](../../spec/std/collections.md#r-std-collections.set.len).
    pub fn len(&self) -> usize:
        self.entries.len()

    ## True exactly when the set has no elements.
    ## See [std-collections.set.len](../../spec/std/collections.md#r-std-collections.set.len).
    pub fn is_empty(&self) -> bool:
        self.entries.len() == 0

    ## True exactly when the set has an element equal to `value`.
    ## See [std-collections.set.contains](../../spec/std/collections.md#r-std-collections.set.contains).
    pub fn contains(&self, value: T) -> bool:
        self.entries.get(value).is_some()

    # Adds `value`, and is true when it was not already there.
    ## Adds `value` and returns `true` when the set has no element equal to it. Otherwise it changes nothing and returns `false`.
    ## See [std-collections.set.insert](../../spec/std/collections.md#r-std-collections.set.insert).
    pub fn insert(&mut self, value: T) -> bool:
        # One probe: an equal element keeps its entry and its place, so the
        # map grows exactly when the element was new.
        before := self.entries.len()
        self.entries[value] = true
        self.entries.len() > before

    # Removes `value`, and is true when it was there.
    ## Removes the element equal to `value` and returns `true`. When there is none, it changes nothing and returns `false`.
    ## See [std-collections.set.remove](../../spec/std/collections.md#r-std-collections.set.remove).
    pub fn remove(&mut self, value: T) -> bool:
        self.entries.remove(value).is_some()

# Over the set as it was when `iter` was called
# (r-std-collections.set.snapshot): the cursor walks a copy of the map.
impl[T < Eq & Hash] Iterable[T] for Set[T]:
    type IntoIter = SetIter[T]
    fn iter(self) -> SetIter[T]:
        let mut entries = self.entries
        SetIter { entries: entries.iter() }

## The cursor of a set's `iter`: its elements in the set's order.
## See [std-collections.set.iter](../../spec/std/collections.md#r-std-collections.set.iter).
pub struct SetIter[T < Eq & Hash]:
    entries: MapEntries[T, bool]

impl[T < Eq & Hash] Iterator[T] for SetIter[T]:
    fn next(&mut self) -> T?:
        match self.entries.next():
            .Some(entry) => .Some(entry._0)
            .None => .None

# A set of the distinct items, in the order each first appears
# (r-std-collections.set.collect).
impl[T < Eq & Hash] FromIterator[T] for Set[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> Set[T]:
        let mut cursor = items
        let mut collected: Set[T] = Set::new()
        while true:
            match cursor.next():
                .Some(item) => _ := collected.insert(item)
                .None => break
        collected

# The same elements, in any order (r-std-collections.set.eq).
# Keep handwritten Eq: compare membership, independent of insertion order.
impl[T < Eq & Hash] Eq for Set[T]:
    fn eq(&self, other: &Set[T]) -> bool:
        if self.len() != other.len():
            return false
        for (item, _) in self.entries:
            if !other.contains(item):
                return false
        true

# One `debug_list` entry per element, in iteration order
# (r-std-format.debug.std-types.set).
# Keep handwritten Debug: render logical entries as collection syntax rather than storage fields.
impl[T < Eq & Hash & Debug] Debug for Set[T]:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        for (item, _) in self.entries:
            _ := list.entry(item)
        list.finish()

# A binary max-heap (spec/std/collections.md#heap), as Rust's `BinaryHeap`.
# `items` holds only live elements in heap order: each parent is at least
# as large as its children at `2 * i + 1` and `2 * i + 2`. Sifting moves
# elements into a hole instead of swapping at every level.
## A max-heap: `pop` and `peek` see a largest element.
## See [std-collections.heap.collect-surface](../../spec/std/collections.md#r-std-collections.heap.collect-surface).
pub struct Heap[T < Ord]:
    items: List[T]

impl[T < Ord] Heap[T]:
    ## Returns an empty heap.
    ## See [std-collections.heap.len](../../spec/std/collections.md#r-std-collections.heap.len).
    pub fn new() -> Heap[T]:
        Heap::[T] { items: [] }

    ## Returns the number of elements.
    ## See [std-collections.heap.len](../../spec/std/collections.md#r-std-collections.heap.len).
    pub fn len(&self) -> usize:
        self.items.len()

    ## True exactly when the heap has no elements.
    ## See [std-collections.heap.len](../../spec/std/collections.md#r-std-collections.heap.len).
    pub fn is_empty(&self) -> bool:
        self.items.len() == 0

    ## Adds `value` to the heap.
    ## See [std-collections.heap.push](../../spec/std/collections.md#r-std-collections.heap.push).
    pub fn push(&mut self, value: T) -> void:
        self.items.push(value)
        last := self.items.len() - 1
        let child = last
        while child > 0:
            parent := (child - 1) / 2
            match self.items[parent].cmp(&value):
                .Less => pass
                _ => break
            self.items[child] = self.items[parent]
            child = parent
        if child != last:
            self.items[child] = value

    # The largest element, removed (r-std-collections.heap.pop).
    ## Removes a largest element by `Ord` and returns it in `.Some`. On an empty heap, it returns `.None`.
    ## See [std-collections.heap.pop](../../spec/std/collections.md#r-std-collections.heap.pop).
    pub fn pop(&mut self) -> T?:
        last := self.items.pop()?
        if self.items.len() == 0:
            return .Some(last)
        top := self.items[0]
        self.sift_down(0, last)
        .Some(top)

    # Restore heap order by moving each larger child into the hole, then
    # placing `value` once at its final position.
    fn sift_down(&mut self, start: usize, value: T) -> void:
        size := self.items.len()
        let parent = start
        while parent < size / 2:
            left := 2 * parent + 1
            let larger = left
            if left + 1 < size:
                match self.items[left].cmp(&self.items[left + 1]):
                    .Less => larger = left + 1
                    _ => pass
            match value.cmp(&self.items[larger]):
                .Less => pass
                _ => break
            self.items[parent] = self.items[larger]
            parent = larger
        self.items[parent] = value

    ## Returns a copy of a largest element without removing it, or `.None` when the heap is empty.
    ## See [std-collections.heap.peek-copy](../../spec/std/collections.md#r-std-collections.heap.peek-copy).
    pub fn peek(&self) -> T?:
        self.items.first()

    # A new list of the elements in ascending order; the heap is unchanged
    # (r-std-collections.heap.sorted).
    ## Returns a new list of every element in ascending order by `Ord`, and leaves the heap unchanged.
    ## See [std-collections.heap.sorted](../../spec/std/collections.md#r-std-collections.heap.sorted).
    pub fn to_sorted_list(&self) -> List[T]:
        self.items.sorted_by(fn(left: &T, right: &T) -> Ordering: left.cmp(right))

# Build in linear comparisons by sifting each non-leaf bottom-up.
# See r-std-collections.heap.collect, r-std-collections.heap.collect.linear.
impl[T < Ord] FromIterator[T] for Heap[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> Heap[T]:
        let mut cursor = items
        let mut heap: Heap[T] = Heap::new()
        while true:
            match cursor.next():
                .Some(item) => heap.items.push(item)
                .None => break
        let parent = heap.items.len() / 2
        while parent > 0:
            parent = parent - 1
            value := heap.items[parent]
            heap.sift_down(parent, value)
        heap

# The elements in heap order, which the spec leaves unspecified
# (r-std-format.debug.std-types.sequences).
# Keep handwritten Debug: render logical entries as collection syntax rather than storage fields.
impl[T < Ord & Debug] Debug for Heap[T]:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        for item in self.items:
            _ := list.entry(item)
        list.finish()

# Primitives. The compiler supplies each body (src/README.md,
# Compiler/library boundary).
# Shrinks `items` to its first `len` elements; `len` is at most the current length, which
# every caller in this file checks.
@intrinsic("list_truncate")
fn list_truncate[T](items: &mut List[T], len: usize) -> void:
    panic("intrinsic")

# Appends `other`'s elements to `items` in one copy, each taking its own
# counts; `other` may be the list `items` refers to.
@intrinsic("list_extend")
fn list_extend[T](items: &mut List[T], other: List[T]) -> void:
    panic("intrinsic")
