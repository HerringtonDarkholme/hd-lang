# std.rt.hint: the inline and cold decorators (r-annot.inline.declared.v2),
# which `std.rt` and then `std.meta` re-export. They are here so the runtime modules that
# use them (`std.rt.bytes`, `std.rt.hash`) read no module of std's
# language layer, whose loop would then join the runtime's unit. Only std
# may import this runtime module (module.rt.std-only). The compiler
# recognizes `inline` and `cold` by their qualified names and checks their
# targets itself (r-annot.inline.targets).
## How the compiler copies calls of a function: `.Auto` prefers a copy,
## `.Always` asks for one at every call, `.Never` copies none.
## See [annot.inline.recognized](../../../spec/lang/14-annotations.md#r-annot.inline.recognized).
pub enum InlineHint:
    Auto
    Always
    Never

## The `@inline` decorator: a bare `@inline` is `@inline(.Auto)`.
## See [annot.inline.recognized](../../../spec/lang/14-annotations.md#r-annot.inline.recognized).
pub fn inline(hint: InlineHint = .Auto) -> InlineHint:
    hint

## Marks a function unlikely to be called: never copied, and called through
## the function table.
## See [annot.inline.cold](../../../spec/lang/14-annotations.md#r-annot.inline.cold).
pub struct Cold: pass

## The `@cold` decorator.
## See [annot.inline.cold](../../../spec/lang/14-annotations.md#r-annot.inline.cold).
pub fn cold() -> Cold:
    Cold {}
