# std.rt.alloc: the heap allocator of the linear-memory runtime
# (crates/hd_wasm/DESIGN.md §23.5 and §23.6), hd over std.rt.memory.
# A runtime module, so only std may use it
# (spec/lang/10-modules.md#r-module.rt.std-only).
#
# Blocks of up to 32 KiB come from 32 size classes. The first 20 use
# one-page spans; medium classes use four-page spans. A larger block is a
# run of whole pages. The page table, one 4-byte entry per heap page, says what each
# page is, so a free needs only the address, and an interior address finds
# the start of its block:
#
#   top 2 bits   low 30 bits           page
#   00           0                     free, or not yet the allocator's
#   01           the class, 1 to 32;   the first page of a class span;
#                0 for a static page   0: static data, the table, or a
#                                      page another part of the program grew
#   10           the run's page count  the first page of a large run
#   11           the run's first page  a later page of a span or run
#
# The table's first 1024 bytes hold each class's list of spans with room,
# the 32-entry size/reciprocal tables and each class's freed list. Entry
# `p` is at table + 1024 + 4 * p. A class span starts with a
# 16-byte header: its free list (u32), the next and previous pages of its
# class's list (u32 each), its live count (u16) and its bump offset in
# units of 16 bytes (u16). Its slots follow from offset 16. A freed slot
# holds the next free slot's address in its first 4 bytes.
#
# A block freed at a known class (`free_class`) goes on its class's freed
# list, one per class, and its page still counts it live; allocation takes
# from that list first. Before the heap takes a page, `reclaim` gives every
# listed block back to its page, so a page whose blocks are all free
# returns to the pool.
use std.rt.cycle.{keep, suspect}
use std.rt.memory.{copy, fill, grow, load_u16, load_u32, load_u64, store_u16, store_u32, store_u64}

PAGE := 65536
LISTS := 1024
FREED := 640
SIZES := 132
RECIPROCALS := 264
SMALL := 0x40000000
RUN := 0x80000000
REST := 0xc0000000
LOW := 0x3fffffff
# A counted object's descriptor-word bits (std.rt.cycle): it takes part in
# cycle collection, and it is in the collector's candidate buffer.
CYCLIC := 0x80000000
BUFFERED := 0x40000000

# Each class's freed list is at FREED + 4 * class.

# The page table's address, 0 until the first allocation.
let table: usize = 0
# How many pages the table has entries for.
let capacity: usize = 0
# The pages below this one have their entries set; the rest are not yet
# the heap's.
let known: usize = 0
# No page below this one is free.
let hint: usize = 0
# A failed search proved there is no run of `miss_size` pages before
# `miss_end`. Larger requests reuse that proof until any page is freed.
let miss_size: usize = 0
let miss_end: usize = 0
# Every address below this one is null or static data, in no block: the
# table's first page, set by the first allocation (0 before it, when no
# address is in a block).
let heap: usize = 0

## Allocates a block of at least `size` bytes and gives its address, which is a multiple of 16; its bytes are not zeroed.
pub fn alloc(size: usize) -> usize:
    if table == 0 && !(threaded() && adopted()):
        start()
    if size > 32768:
        count := (size + PAGE - 1) / PAGE
        reclaim()
        first := take(count)
        set(first, u32(RUN + count))
        let j: usize = 1
        while j < count:
            set(first + j, u32(REST + first))
            j = j + 1
        return first * PAGE
    class := class_of(size)
    freed := usize(load_u32(table + FREED + 4 * class))
    if freed != 0:
        store_u32(table + FREED + 4 * class, load_u32(freed))
        return freed
    let page = head(class)
    if page == 0:
        reclaim()
        page = head(class)
    if page == 0:
        count := span_pages(class)
        page = take(count) * PAGE
        set(page / PAGE, u32(SMALL + class))
        let j: usize = 1
        while j < count:
            set(page / PAGE + j, u32(REST + page / PAGE))
            j = j + 1
        fill(page, 0, 14)
        store_u16(page + 14, 1)
        set_head(class, page)
    free := usize(load_u32(page))
    let slot = free
    if free != 0:
        store_u32(page, load_u32(free))
    else:
        bump := usize(load_u16(page + 14)) * 16
        slot = page + bump
        store_u16(page + 14, u16((bump + class_bytes(class)) / 16))
    store_u16(page + 12, load_u16(page + 12) + 1)
    if full(page, class):
        # A page that fills is its list's head, the page it took from.
        next := usize(load_u32(page + 4))
        set_head(class, next)
        if next != 0:
            store_u32(next + 8, 0)
        store_u32(page + 4, 0)
    slot

# Compiler-private ABI: class is the known size class of size, or zero for
# an ordinary allocation. Table relocation preserves the whole prefix.
pub fn alloc_class(size: usize, class: usize) -> usize:
    if class == 0:
        return alloc(size)
    if table == 0 && !(threaded() && adopted()):
        start()
    freed := usize(load_u32(table + FREED + 4 * class))
    if freed != 0:
        store_u32(table + FREED + 4 * class, load_u32(freed))
        return freed
    let page = head(class)
    if page == 0:
        reclaim()
        page = head(class)
    if page == 0:
        count := span_pages(class)
        page = take(count) * PAGE
        set(page / PAGE, u32(SMALL + class))
        let j: usize = 1
        while j < count:
            set(page / PAGE + j, u32(REST + page / PAGE))
            j = j + 1
        fill(page, 0, 14)
        store_u16(page + 14, 1)
        set_head(class, page)
    free := usize(load_u32(page))
    let slot = free
    if free != 0:
        store_u32(page, load_u32(free))
    else:
        bump := usize(load_u16(page + 14)) * 16
        slot = page + bump
        store_u16(page + 14, u16((bump + class_bytes(class)) / 16))
    store_u16(page + 12, load_u16(page + 12) + 1)
    if full(page, class):
        # A page that fills is its list's head, the page it took from.
        next := usize(load_u32(page + 4))
        set_head(class, next)
        if next != 0:
            store_u32(next + 8, 0)
        store_u32(page + 4, 0)
    slot

# Zero before the first allocation; callers never cache this across an
# allocation or collection, since growing the table can relocate it.
pub fn metadata() -> usize:
    table

## Frees the block at `address`, which `alloc` gave and which is not yet freed; a counted object that is a cycle candidate is left to the collector's next sweep (`std.rt.cycle.keep`).
pub fn free(address: usize) -> void:
    if !keep(address):
        free_block(address)

## Frees the block at `address`, which `alloc` gave and which is not yet freed, as `free` does, for a block the cycle collector never sees.
pub fn free_block(address: usize) -> void:
    let page_number = if threaded(): local_page(address) else: address / PAGE
    let entry = usize(load_u32(table + LISTS + 4 * page_number))
    if entry / SMALL == 3:
        page_number = entry & LOW
        entry = usize(load_u32(table + LISTS + 4 * page_number))
    kind := entry / SMALL
    if kind == 2:
        fill(table + LISTS + 4 * page_number, 0, 4 * (entry & LOW))
        lower_hint(page_number)
    else if kind == 1 && entry != SMALL:
        class := entry & LOW
        page := page_number * PAGE
        was_full := full(page, class)
        store_u32(address, load_u32(page))
        store_u32(page, u32(address))
        live := load_u16(page + 12) - 1
        store_u16(page + 12, live)
        # Small classes cache one head page. Empty medium spans return
        # to the shared pool, so transient classes do not each retain four
        # pages during cycle collection or a mixed-size workload.
        if live == 0 && (class > 20 || head(class) != page):
            if !was_full:
                unlink(page, class)
            fill(table + LISTS + 4 * page_number, 0, 4 * span_pages(class))
            lower_hint(page_number)
        else if was_full:
            next := head(class)
            store_u32(page + 4, u32(next))
            store_u32(page + 8, 0)
            if next != 0:
                store_u32(next + 8, u32(page))
            set_head(class, page)

# Compiler-private ABI, which the backend inlines: address is a live block
# of class, with no buffered candidate bit. It goes on its class's freed
# list, counted by its page until `reclaim`; a thread with no table frees it.
pub fn free_class(address: usize, class: usize) -> void:
    if class == 0 || (threaded() && table == 0):
        free_block(address)
        return
    at := table + FREED + 4 * class
    store_u32(address, load_u32(at))
    store_u32(at, u32(address))

## Gives every block on the classes' freed lists back to its span, which returns to the pool when that was its last live block; only small classes cache an empty head page.
pub fn reclaim() -> void:
    let class: usize = if threaded(): drain() else: 1
    while class <= 32:
        at := table + FREED + 4 * class
        let block = usize(load_u32(at))
        store_u32(at, 0)
        while block != 0:
            next := usize(load_u32(block))
            free_block(block)
            block = next
        class = class + 1

## The address of the block that holds `address`, a block's own address or one inside it; 0 for an address in static data or in no block.
pub fn block_of(address: usize) -> usize:
    let page_number = address / PAGE
    # Before the first allocation `known` is 0 too.
    if page_number >= known:
        return if threaded(): foreign_block(address) else: 0
    let entry = usize(load_u32(table + LISTS + 4 * page_number))
    if entry / SMALL == 3:
        page_number = entry & LOW
        entry = usize(load_u32(table + LISTS + 4 * page_number))
    kind := entry / SMALL
    page := page_number * PAGE
    if kind == 2:
        page
    else if kind == 1 && entry != SMALL && address >= page + 16:
        class := entry & LOW
        index := 4 * (class - 1)
        bytes := usize(load_u32(table + SIZES + index))
        reciprocal := load_u64(table + RECIPROCALS + 2 * index)
        # ceil(2^48 / bytes) is exact for offsets below 2^18: its error
        # is below 2^-30, less than the smallest remainder gap (2^-15).
        # The product stays below 2^62, including the smallest class.
        slot := usize((u64(address - page - 16) * reciprocal) >> 48)
        page + 16 + slot * bytes
    else:
        if threaded(): foreign_block(address) else: 0

# A counted object (crates/hd_wasm/DESIGN.md §23.4) is a block whose
# first 4 bytes are its count; emitted code calls these two with any
# address in the object, as a string view's is. A block of static data has
# no count, so neither changes it.

## Adds one to the count of the block that holds `address`; an address in static data or in no block has no count.
pub fn retain(address: usize) -> void:
    if address < heap:
        return
    block := block_of(address)
    if block != 0:
        store_u32(block, load_u32(block) + 1)

## Adds a count when `address` is a known payload start, eight bytes after its header; null and static zero-count objects are left alone.
pub fn retain_known(address: usize) -> void:
    if address != 0:
        block := address - 8
        count := load_u32(block)
        if count != 0:
            store_u32(block, count + 1)

## Takes one from the count of the block that holds `address` and gives the block when that was its last count, so the caller releases and frees it; else 0. A count left above zero on an object that takes part in cycle collection makes it a candidate (std.rt.cycle); any other object's release is the decrement alone.
pub fn release(address: usize) -> usize:
    if address < heap:
        return 0
    block := block_of(address)
    if block == 0:
        return 0
    count := load_u32(block)
    if count == 1:
        return block
    store_u32(block, count - 1)
    if (usize(load_u32(block + 4)) & CYCLIC) != 0:
        suspect(block)
    0

## Takes a count when `address` is a known payload start, with the same final release and collector behavior as `release`, without finding its block in the page table.
pub fn release_known(address: usize) -> usize:
    if address == 0:
        return 0
    block := address - 8
    count := load_u32(block)
    if count == 0:
        return 0
    if count == 1:
        return block
    store_u32(block, count - 1)
    if (usize(load_u32(block + 4)) & CYCLIC) != 0:
        suspect(block)
    0

## One count more on each counted reference `value` holds. The compiler supplies each instance's body, the retain shim of `T` (`hd_layout::shims`).
@intrinsic("count_retain")
pub fn retain_value[T](value: T) -> void:
    panic("intrinsic")

## One count less on each counted reference `value` holds, after its `Drop` hook. The compiler supplies each instance's body, the release shim of `T`.
@intrinsic("count_release")
pub fn release_value[T](value: T) -> void:
    panic("intrinsic")

## Takes one from the count of the block that holds `address`, as `release` does, in a program where no object takes part in cycle collection: the decrement alone, so nothing links the collector.
pub fn release_acyclic(address: usize) -> usize:
    if address < heap:
        return 0
    block := block_of(address)
    if block == 0:
        return 0
    count := load_u32(block)
    if count == 1:
        return block
    store_u32(block, count - 1)
    0

## Takes a count when `address` is a known payload start, as `release_known` does, in a program where no object takes part in cycle collection.
pub fn release_known_acyclic(address: usize) -> usize:
    if address == 0:
        return 0
    block := address - 8
    count := load_u32(block)
    if count == 0:
        return 0
    if count == 1:
        return block
    store_u32(block, count - 1)
    0

## The bytes of the block at `block`, which `alloc` gave: its size class's, or its run's whole pages.
pub fn block_bytes(block: usize) -> usize:
    let entry = if threaded(): held(block) else: usize(load_u32(table + LISTS + 4 * (block / PAGE)))
    if entry / SMALL == 3:
        entry = usize(load_u32(table + LISTS + 4 * (entry & LOW)))
    if entry / SMALL == 2: (entry & LOW) * PAGE else: class_bytes(entry & LOW)

## The bytes of the block that `alloc(size)` gives: its size class, or whole pages over 32 KiB.
pub fn block_size(size: usize) -> usize:
    if size > 32768:
        return (size + PAGE - 1) / PAGE * PAGE
    if table == 0 && !(threaded() && adopted()):
        start()
    class_bytes(class_of(size))

# The size class of a small block of `size` bytes, 1 to 32.
fn class_of(size: usize) -> usize:
    if size <= 16:
        return 1
    if size <= 128:
        return (size + 15) / 16
    let class: usize = 9
    while class_bytes(class) < size:
        class = class + 1
    class

# The bytes of each block of size class `class`: 16 to 128 in steps of 16,
# then three steps per doubling, about 25% apart, up to 32 KiB, each a
# multiple of 16: 160, 208, 256, 320, 400, 512, ..., 1600, 2048, ..., 25600, 32768.
# Allocation and block_size initialize metadata before class_of; every
# other caller operates on a page already owned by the allocator.
fn class_bytes(class: usize) -> usize:
    usize(load_u32(table + SIZES + 4 * (class - 1)))

# These tables live in the allocator's metadata, not counted objects.
# Growing the page table copies this prefix together with the class heads.
# Initialization runs once. Generate the geometric classes instead of
# growing every allocation helper's transitive code with constant stores.
fn init_classes() -> void:
    let class: usize = 1
    while class <= 32:
        let bytes = 16 * class
        if class > 8:
            group := (class - 9) / 3
            part := (class - 9) % 3
            base := 128 << group
            bytes = if part == 0:
                base * 5 / 4
            else if part == 1:
                (base * 25 / 16 + 15) / 16 * 16
            else:
                base * 2
        store_u32(table + SIZES + 4 * (class - 1), u32(bytes))
        reciprocal := ((1u64 << 48) + u64(bytes) - 1) / u64(bytes)
        store_u64(table + RECIPROCALS + 8 * (class - 1), reciprocal)
        class = class + 1

# Whether the small page at `page` has no room left for a block of `class`.
fn full(page: usize, class: usize) -> bool:
    (
        load_u32(page) == 0
        && usize(load_u16(page + 14)) * 16 + class_bytes(class) > span_pages(class) * PAGE
    )

# The largest slot leaves one eighth of a four-page span unused.
# Small classes retain their one-page geometry and compiler fast paths.
fn span_pages(class: usize) -> usize:
    if class <= 20: 1 else: 4

# Takes the small page at `page` out of its class's list.
fn unlink(page: usize, class: usize) -> void:
    next := usize(load_u32(page + 4))
    previous := usize(load_u32(page + 8))
    if previous != 0:
        store_u32(previous + 4, u32(next))
    else:
        set_head(class, next)
    if next != 0:
        store_u32(next + 8, u32(previous))

fn head(class: usize) -> usize:
    usize(load_u32(table + 4 * class))

fn set_head(class: usize, page: usize) -> void:
    store_u32(table + 4 * class, u32(page))

fn set(page_number: usize, entry: u32) -> void:
    store_u32(table + LISTS + 4 * page_number, entry)

fn lower_hint(page_number: usize) -> void:
    miss_size = 0
    if page_number < hint:
        hint = page_number

# The first allocation's set-up: a page for the table, whose entries mark
# every page the heap had before as static.
fn start() -> void:
    at := grown(1)
    table = at * PAGE
    heap = if threaded(): joined(heap) else: table
    capacity = (PAGE - LISTS) / 4
    init_classes()
    claim(at, 1, u32(SMALL))
    hint = known

# The first of `count` free pages next to each other, first fit; the heap
# grows when none fit. The caller sets their entries.
fn take(count: usize) -> usize:
    let first = hint
    if miss_size != 0 && count >= miss_size && miss_end > first:
        first = miss_end
    let run: usize = 0
    let page_number = first
    while page_number < known && run < count:
        if load_u32(table + LISTS + 4 * page_number) == 0:
            run = run + 1
        else:
            first = page_number + 1
            run = 0
            # Skip only an occupied prefix; an earlier free hole must
            # remain searchable by a later, smaller request.
            if hint == page_number:
                hint = page_number + 1
        page_number = page_number + 1
    if run < count:
        scan_end := known
        miss_size = count
        miss_end = scan_end
        fresh := extend(count)
        # A table move invalidates the proof through lower_hint. Otherwise
        # the newly occupied run extends the same failed-search prefix.
        if miss_size != 0:
            miss_end = fresh + count
        # Table relocation can free an earlier page and lower hint.
        # Preserve it; otherwise no free page preceded the fresh run.
        if hint == scan_end:
            hint = fresh + count
        return fresh
    if first == hint:
        hint = first + count
    first

# Grows the heap by `count` free pages for the allocator and gives the
# first.
fn extend(count: usize) -> usize:
    first := grown(count)
    if first + count > capacity:
        move_table(first + count)
    claim(first, count, 0)
    first

# Moves the table to new pages with room for twice `need` entries, and
# frees its old page.
fn move_table(need: usize) -> void:
    count := (LISTS + 8 * need + PAGE - 1) / PAGE
    first := grown(count)
    copy(first * PAGE, table, LISTS + 4 * known)
    old := table / PAGE
    old_count := (LISTS + 4 * capacity + PAGE - 1) / PAGE
    table = if threaded(): publish(first * PAGE) else: first * PAGE
    capacity = (count * PAGE - LISTS) / 4
    claim(first, count, u32(SMALL))
    claim(old, old_count, if threaded(): u32(SMALL) else: 0)
    lower_hint(old)

# Sets the entries of the `count` pages from `first` to `entry`, and those
# from the last known page up to `first`, which another part of the program
# grew, to static.
fn claim(first: usize, count: usize, entry: u32) -> void:
    let page_number = if threaded(): owns(first, count) else: known
    while page_number < first:
        set(page_number, u32(SMALL))
        page_number = page_number + 1
    let j: usize = 0
    while j < count:
        set(first + j, entry)
        j = j + 1
    if first + count > known:
        known = first + count

# Grows the heap by `count` pages and gives the first.
fn grown(count: usize) -> usize:
    match grow(count):
        .Some(first) => first
        .None => panic_with("heap-exhausted", "an allocation does not fit the heap")

@intrinsic("panic")
fn panic_with(category: string, message: string) -> never:
    panic("intrinsic")

# Threads (module.rt.thread.heap). Each thread's instance allocates from a
# heap of its own: this module's storage, over the pages it grew. The
# registry, which the first allocation grows, says which heap owns each
# page, and holds one record per heap: its state (0 unused, 1 in use, 2
# retired), its table, the blocks other threads freed, then the rest of
# its storage while it is retired; record 0 holds how many heaps exist,
# then `shared_held`. A block that another thread frees goes
# on its owner's list, and the owner gives it back before it takes pages.
# A thread that ends retires its heap, and the next thread to start adopts
# it, so no heap is lost to a thread's end.
# The heap word below static data that holds the registry's address, 1
# while the first allocation makes it.
REGISTRY := 12
RECORD := 32
RECORDS := 1024
REMOTE := 8
# One u16 per page: the record of the heap that grew it, 0 for none.
OWNERS := 32768

# This instance's heap: the owner of its table's first page, 0 before its
# first allocation. It needs no storage, which a program without threads
# would carry too.
fn me() -> usize:
    owner(table)

# The registry's address, which the first call makes.
fn registry() -> usize:
    let at = usize(atomic_load(REGISTRY))
    if at == 0 && atomic_compare_exchange(REGISTRY, 0, 1) == 0:
        at = grown(3) * PAGE
        atomic_store(REGISTRY, u32(at))
        _ := atomic_notify(REGISTRY, u32(0xffffffff))
    while at <= 1:
        _ := atomic_wait(REGISTRY, 1, -1)
        at = usize(atomic_load(REGISTRY))
    at

## The registry's word that `std.rt.checked` counts the program's held blocks in, since a block one thread allocates another may free.
pub fn shared_held() -> usize:
    registry() + 4

# The record of heap `id`.
fn record(id: usize) -> usize:
    registry() + RECORD * id

# Gives this instance a retired heap, and whether there was one. Else it
# records a new heap, whose number `heap` holds until `start` makes the
# heap's table (`joined`).
fn adopted() -> bool:
    at := registry()
    made := usize(atomic_load(at))
    let id: usize = 1
    while id <= made:
        rec := at + RECORD * id
        if atomic_compare_exchange(rec, 2, 1) == 2:
            table = usize(load_u32(rec + 4))
            capacity = usize(load_u32(rec + 12))
            known = usize(load_u32(rec + 16))
            hint = usize(load_u32(rec + 20))
            miss_size = usize(load_u32(rec + 24))
            miss_end = usize(load_u32(rec + 28))
            heap = at
            return true
        id = id + 1
    fresh := usize(atomic_add(at, 1)) + 1
    if fresh >= RECORDS:
        panic_with("heap-exhausted", "an allocation does not fit the heap")
    atomic_store(at + RECORD * fresh, 1)
    heap = fresh
    false

# `start`'s new heap `fresh`: its table's page becomes its, other threads
# read its blocks through the table from now on, and `heap` is the
# registry's address, below every block.
fn joined(fresh: usize) -> usize:
    at := registry()
    store_u16(at + OWNERS + 2 * (table / PAGE), u16(fresh))
    atomic_store(at + RECORD * fresh + 4, u32(table))
    at

## Retires this instance's heap when its thread ends, for the next thread that starts to adopt it with all its blocks.
pub fn retire() -> void:
    if table == 0:
        return
    rec := record(me())
    store_u32(rec + 12, u32(capacity))
    store_u32(rec + 16, u32(known))
    store_u32(rec + 20, u32(hint))
    store_u32(rec + 24, u32(miss_size))
    store_u32(rec + 28, u32(miss_end))
    atomic_store(rec, 2)

# Makes `at` this heap's table, which other threads read its blocks
# through: its first page becomes the heap's, as the table it replaces is.
fn publish(at: usize) -> usize:
    id := me()
    store_u16(registry() + OWNERS + 2 * (at / PAGE), u16(id))
    atomic_store(record(id) + 4, u32(at))
    at

# `claim`'s first page to mark static: the `count` pages from `first`,
# which this instance grew, become its heap's.
fn owns(first: usize, count: usize) -> usize:
    at := registry()
    let j: usize = 0
    while j < count:
        store_u16(at + OWNERS + 2 * (first + j), u16(me()))
        j = j + 1
    known

# The record of the heap that owns `address`'s page, 0 for none.
fn owner(address: usize) -> usize:
    at := usize(atomic_load(REGISTRY))
    if at <= 1: 0 else: usize(load_u16(at + OWNERS + 2 * (address / PAGE)))

# `free_block`'s page of `address`: its own, or else, for a block of
# another heap, page 0 (static data, so nothing more happens) after the
# block goes on that heap's list.
fn local_page(address: usize) -> usize:
    if table == 0 && !adopted():
        start()
    id := owner(address)
    if id == 0 || id == me():
        return address / PAGE
    at := record(id) + REMOTE
    while true:
        head := atomic_load(at)
        store_u32(address, head)
        if atomic_compare_exchange(at, head, u32(address)) == head:
            return 0
    0

# Gives the blocks that other threads freed back to this heap; 1, the
# first class `reclaim` visits.
fn drain() -> usize:
    at := record(me()) + REMOTE
    let block = usize(atomic_load(at))
    while block != 0 && atomic_compare_exchange(at, u32(block), 0) != u32(block):
        block = usize(atomic_load(at))
    while block != 0:
        next := usize(load_u32(block))
        free_block(block)
        block = next
    1

# `block_of` of an address on another heap's page, from that heap's table.
fn foreign_block(address: usize) -> usize:
    id := owner(address)
    if id == 0 || id == me():
        return 0
    at := usize(atomic_load(record(id) + 4))
    let page_number = address / PAGE
    let entry = usize(load_u32(at + LISTS + 4 * page_number))
    if entry / SMALL == 3:
        page_number = entry & LOW
        entry = usize(load_u32(at + LISTS + 4 * page_number))
    kind := entry / SMALL
    page := page_number * PAGE
    if kind == 2:
        page
    else if kind == 1 && entry != SMALL && address >= page + 16:
        index := 4 * ((entry & LOW) - 1)
        bytes := usize(load_u32(at + SIZES + index))
        reciprocal := load_u64(at + RECIPROCALS + 2 * index)
        slot := usize((u64(address - page - 16) * reciprocal) >> 48)
        page + 16 + slot * bytes
    else:
        0

# `block_bytes`'s entry of `block`, a run's or a span's first page's, from
# the table of the heap that holds it.
fn held(block: usize) -> usize:
    if table == 0 && !adopted():
        start()
    id := owner(block)
    at := if id == 0 || id == me(): table else: usize(atomic_load(record(id) + 4))
    entry := usize(load_u32(at + LISTS + 4 * (block / PAGE)))
    if entry / SMALL == 3: usize(load_u32(at + LISTS + 4 * (entry & LOW))) else: entry

# Whether the program may start a thread, a constant of its build
# (module.rt.thread.reachable): every use above folds away without threads.
@intrinsic("threads_reachable")
fn threaded() -> bool:
    panic("intrinsic")

@intrinsic("mem_atomic_load_u32")
fn atomic_load(address: usize) -> u32:
    panic("intrinsic")

@intrinsic("mem_atomic_store_u32")
fn atomic_store(address: usize, value: u32) -> void:
    panic("intrinsic")

@intrinsic("mem_atomic_add_u32")
fn atomic_add(address: usize, value: u32) -> u32:
    panic("intrinsic")

@intrinsic("mem_atomic_cmpxchg_u32")
fn atomic_compare_exchange(address: usize, expected: u32, new: u32) -> u32:
    panic("intrinsic")

@intrinsic("mem_atomic_wait_u32")
fn atomic_wait(address: usize, expected: u32, timeout: i64) -> u32:
    panic("intrinsic")

@intrinsic("mem_atomic_notify")
fn atomic_notify(address: usize, count: u32) -> u32:
    panic("intrinsic")
