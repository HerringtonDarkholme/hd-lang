# std.rt.alloc: the heap allocator of the linear-memory runtime
# (crates/hd_wasm_linear/DESIGN.md §23.5 and §23.6), hd over std.rt.memory.
# A runtime module, so only std may use it
# (spec/lang/10-modules.md#r-module.rt.std-only).
#
# Blocks of up to 2 KiB come from 20 size classes, each served by pages of
# 64 KiB that hold that class alone. A block over 2 KiB is a run of whole
# pages. The page table, one 4-byte entry per heap page, says what each
# page is, so a free needs only the address, and an interior address finds
# the start of its block:
#
#   top 2 bits   low 30 bits           page
#   00           0                     free, or not yet the allocator's
#   01           the class, 1 to 20;   a small page of that class;
#                0 for a static page   0: static data, the table, or a
#                                      page another part of the program grew
#   10           the run's page count  the first page of a large run
#   11           the run's first page  a later page of a large run
#
# The table's first 256 bytes hold each class's list of pages with room
# and the 20-entry size/reciprocal tables. Entry `p` is at table + 256 + 4 * p. A small page starts with a
# 16-byte header: its free list (u32), the next and previous pages of its
# class's list (u32 each), its live count (u16) and its bump offset in
# units of 16 bytes (u16). Its slots follow from offset 16. A freed slot
# holds the next free slot's address in its first 4 bytes.
use std.rt.cycle.{keep, suspect}
use std.rt.memory.{copy, fill, grow, load_u16, load_u32, store_u16, store_u32}

PAGE := 65536
LISTS := 256
SIZES := 84
RECIPROCALS := 164
SMALL := 0x40000000
RUN := 0x80000000
REST := 0xc0000000
LOW := 0x3fffffff
# A counted object's descriptor-word bits (std.rt.cycle): it takes part in
# cycle collection, and it is in the collector's candidate buffer.
CYCLIC := 0x80000000
BUFFERED := 0x40000000

# The allocation total occupies bytes 244..247 of the copied metadata prefix.
# The backend's constant-class fast path increments this word too.
GIVEN := 244

# The page table's address, 0 until the first allocation.
let table: usize = 0
# How many pages the table has entries for.
let capacity: usize = 0
# The pages below this one have their entries set; the rest are not yet
# the heap's.
let known: usize = 0
# No page below this one is free.
let hint: usize = 0
# Every address below this one is null or static data, in no block: the
# table's first page, set by the first allocation (0 before it, when no
# address is in a block).
let heap: usize = 0

## Allocates a block of at least `size` bytes and gives its address, which is a multiple of 16; its bytes are not zeroed.
pub fn alloc(size: usize) -> usize:
    if table == 0:
        start()
    store_u32(table + GIVEN, load_u32(table + GIVEN) + 1)
    if size > 2048:
        count := (size + PAGE - 1) / PAGE
        first := take(count)
        set(first, u32(RUN + count))
        let j: usize = 1
        while j < count:
            set(first + j, u32(REST + first))
            j = j + 1
        return first * PAGE
    class := class_of(size)
    let page = head(class)
    if page == 0:
        page = take(1) * PAGE
        set(page / PAGE, u32(SMALL + class))
        fill(page, 0, 14)
        store_u16(page + 14, 1)
        set_head(class, page)
    free := usize(load_u32(page))
    let slot = free
    if free != 0:
        store_u32(page, load_u32(free))
    else:
        bump := usize(load_u16(page + 14)) * 16
        slot = page + bump
        store_u16(page + 14, u16((bump + class_bytes(class)) / 16))
    store_u16(page + 12, load_u16(page + 12) + 1)
    if full(page, class):
        # A page that fills is its list's head, the page it took from.
        next := usize(load_u32(page + 4))
        set_head(class, next)
        if next != 0:
            store_u32(next + 8, 0)
        store_u32(page + 4, 0)
    slot

# Compiler-private ABI: class is the known size class of size, or zero for
# an ordinary allocation. Table relocation preserves the whole prefix.
pub fn alloc_class(size: usize, class: usize) -> usize:
    if class == 0:
        return alloc(size)
    if table == 0:
        start()
    store_u32(table + GIVEN, load_u32(table + GIVEN) + 1)
    let page = head(class)
    if page == 0:
        page = take(1) * PAGE
        set(page / PAGE, u32(SMALL + class))
        fill(page, 0, 14)
        store_u16(page + 14, 1)
        set_head(class, page)
    free := usize(load_u32(page))
    let slot = free
    if free != 0:
        store_u32(page, load_u32(free))
    else:
        bump := usize(load_u16(page + 14)) * 16
        slot = page + bump
        store_u16(page + 14, u16((bump + class_bytes(class)) / 16))
    store_u16(page + 12, load_u16(page + 12) + 1)
    if full(page, class):
        # A page that fills is its list's head, the page it took from.
        next := usize(load_u32(page + 4))
        set_head(class, next)
        if next != 0:
            store_u32(next + 8, 0)
        store_u32(page + 4, 0)
    slot

# Zero before the first allocation; callers never cache this across an
# allocation or collection, since growing the table can relocate it.
pub fn metadata() -> usize:
    table

## How many blocks `alloc` has given since the program began, so a test can see that some code allocates nothing.
pub fn allocated() -> usize:
    if table == 0: 0 else: usize(load_u32(table + GIVEN))

## Frees the block at `address`, which `alloc` gave and which is not yet freed; a counted object that is a cycle candidate is left to the collector's next sweep (`std.rt.cycle.keep`).
pub fn free(address: usize) -> void:
    if !keep(address):
        free_block(address)

## Frees the block at `address`, which `alloc` gave and which is not yet freed, as `free` does, for a block the cycle collector never sees.
pub fn free_block(address: usize) -> void:
    page_number := address / PAGE
    entry := usize(load_u32(table + LISTS + 4 * page_number))
    kind := entry / SMALL
    if kind == 2:
        fill(table + LISTS + 4 * page_number, 0, 4 * (entry & LOW))
        lower_hint(page_number)
    else if kind == 1 && entry != SMALL:
        class := entry & LOW
        page := page_number * PAGE
        was_full := full(page, class)
        store_u32(address, load_u32(page))
        store_u32(page, u32(address))
        live := load_u16(page + 12) - 1
        store_u16(page + 12, live)
        # An empty page returns to the pool unless it heads its class's
        # list, so a class that frees its last block and allocates again
        # keeps its page.
        if live == 0 && head(class) != page:
            if !was_full:
                unlink(page, class)
            set(page_number, 0)
            lower_hint(page_number)
        else if was_full:
            next := head(class)
            store_u32(page + 4, u32(next))
            store_u32(page + 8, 0)
            if next != 0:
                store_u32(next + 8, u32(page))
            set_head(class, page)

# Compiler-private ABI: address is a live block of class, with no buffered
# candidate bit. The backend handles the head-page case inline.
pub fn free_class(address: usize, class: usize) -> void:
    if class == 0:
        free_block(address)
        return
    page_number := address / PAGE
    page := page_number * PAGE
    was_full := full(page, class)
    store_u32(address, load_u32(page))
    store_u32(page, u32(address))
    live := load_u16(page + 12) - 1
    store_u16(page + 12, live)
    # An empty page returns to the pool unless it heads its class's
    # list, so a class that frees its last block and allocates again
    # keeps its page.
    if live == 0 && head(class) != page:
        if !was_full:
            unlink(page, class)
        set(page_number, 0)
        lower_hint(page_number)
    else if was_full:
        next := head(class)
        store_u32(page + 4, u32(next))
        store_u32(page + 8, 0)
        if next != 0:
            store_u32(next + 8, u32(page))
        set_head(class, page)

## The address of the block that holds `address`, a block's own address or one inside it; 0 for an address in static data or in no block.
pub fn block_of(address: usize) -> usize:
    page_number := address / PAGE
    # Before the first allocation `known` is 0 too.
    if page_number >= known:
        return 0
    entry := usize(load_u32(table + LISTS + 4 * page_number))
    kind := entry / SMALL
    page := page_number * PAGE
    if kind == 2:
        page
    else if kind == 3:
        (entry & LOW) * PAGE
    else if kind == 1 && entry != SMALL && address >= page + 16:
        class := entry & LOW
        index := 4 * (class - 1)
        bytes := usize(load_u32(table + SIZES + index))
        reciprocal := u64(load_u32(table + RECIPROCALS + index))
        # The offset is below 65536. ceil(2^32 / bytes) is therefore an
        # exact quotient multiplier for these 16..2048-byte classes.
        slot := usize((u64(address - page - 16) * reciprocal) >> 32)
        page + 16 + slot * bytes
    else:
        0

# A counted object (crates/hd_wasm_linear/DESIGN.md §23.4) is a block whose
# first 4 bytes are its count; emitted code calls these two with any
# address in the object, as a string view's is. A block of static data has
# no count, so neither changes it.

## Adds one to the count of the block that holds `address`; an address in static data or in no block has no count.
pub fn retain(address: usize) -> void:
    if address < heap:
        return
    block := block_of(address)
    if block != 0:
        store_u32(block, load_u32(block) + 1)

## Adds a count when `address` is a known payload start, eight bytes after its header; null and static zero-count objects are left alone.
pub fn retain_known(address: usize) -> void:
    if address != 0:
        block := address - 8
        count := load_u32(block)
        if count != 0:
            store_u32(block, count + 1)

## Takes one from the count of the block that holds `address` and gives the block when that was its last count, so the caller releases and frees it; else 0. A count left above zero on an object that takes part in cycle collection makes it a candidate (std.rt.cycle); any other object's release is the decrement alone.
pub fn release(address: usize) -> usize:
    if address < heap:
        return 0
    block := block_of(address)
    if block == 0:
        return 0
    count := load_u32(block)
    if count == 1:
        return block
    store_u32(block, count - 1)
    if (usize(load_u32(block + 4)) & CYCLIC) != 0:
        suspect(block)
    0

## Takes a count when `address` is a known payload start, with the same final release and collector behavior as `release`, without finding its block in the page table.
pub fn release_known(address: usize) -> usize:
    if address == 0:
        return 0
    block := address - 8
    count := load_u32(block)
    if count == 0:
        return 0
    if count == 1:
        return block
    store_u32(block, count - 1)
    if (usize(load_u32(block + 4)) & CYCLIC) != 0:
        suspect(block)
    0

## Takes one from the count of the block that holds `address`, as `release` does, in a program where no object takes part in cycle collection: the decrement alone, so nothing links the collector.
pub fn release_acyclic(address: usize) -> usize:
    if address < heap:
        return 0
    block := block_of(address)
    if block == 0:
        return 0
    count := load_u32(block)
    if count == 1:
        return block
    store_u32(block, count - 1)
    0

## Takes a count when `address` is a known payload start, as `release_known` does, in a program where no object takes part in cycle collection.
pub fn release_known_acyclic(address: usize) -> usize:
    if address == 0:
        return 0
    block := address - 8
    count := load_u32(block)
    if count == 0:
        return 0
    if count == 1:
        return block
    store_u32(block, count - 1)
    0

## The bytes of the block at `block`, which `alloc` gave: its size class's, or its run's whole pages.
pub fn block_bytes(block: usize) -> usize:
    entry := usize(load_u32(table + LISTS + 4 * (block / PAGE)))
    if entry / SMALL == 2: (entry & LOW) * PAGE else: class_bytes(entry & LOW)

## The bytes of the block that `alloc(size)` gives: its size class, or whole pages over 2 KiB.
pub fn block_size(size: usize) -> usize:
    if size > 2048:
        return (size + PAGE - 1) / PAGE * PAGE
    if table == 0:
        start()
    class_bytes(class_of(size))

# The size class of a small block of `size` bytes, 1 to 20.
fn class_of(size: usize) -> usize:
    if size <= 16:
        return 1
    if size <= 128:
        return (size + 15) / 16
    let class: usize = 9
    while class_bytes(class) < size:
        class = class + 1
    class

# The bytes of each block of size class `class`: 16 to 128 in steps of 16,
# then three steps per doubling, about 25% apart, up to 2 KiB, each a
# multiple of 16: 160, 208, 256, 320, 400, 512, ..., 1600, 2048.
# Allocation and block_size initialize metadata before class_of; every
# other caller operates on a page already owned by the allocator.
fn class_bytes(class: usize) -> usize:
    usize(load_u32(table + SIZES + 4 * (class - 1)))

# These tables live in the allocator's metadata, not counted objects.
# Growing the page table copies this prefix together with the class heads.
fn init_classes() -> void:
    store_u32(table + SIZES + 0, 16)
    store_u32(table + SIZES + 4, 32)
    store_u32(table + SIZES + 8, 48)
    store_u32(table + SIZES + 12, 64)
    store_u32(table + SIZES + 16, 80)
    store_u32(table + SIZES + 20, 96)
    store_u32(table + SIZES + 24, 112)
    store_u32(table + SIZES + 28, 128)
    store_u32(table + SIZES + 32, 160)
    store_u32(table + SIZES + 36, 208)
    store_u32(table + SIZES + 40, 256)
    store_u32(table + SIZES + 44, 320)
    store_u32(table + SIZES + 48, 400)
    store_u32(table + SIZES + 52, 512)
    store_u32(table + SIZES + 56, 640)
    store_u32(table + SIZES + 60, 800)
    store_u32(table + SIZES + 64, 1024)
    store_u32(table + SIZES + 68, 1280)
    store_u32(table + SIZES + 72, 1600)
    store_u32(table + SIZES + 76, 2048)
    store_u32(table + RECIPROCALS + 0, 268435456)
    store_u32(table + RECIPROCALS + 4, 134217728)
    store_u32(table + RECIPROCALS + 8, 89478486)
    store_u32(table + RECIPROCALS + 12, 67108864)
    store_u32(table + RECIPROCALS + 16, 53687092)
    store_u32(table + RECIPROCALS + 20, 44739243)
    store_u32(table + RECIPROCALS + 24, 38347923)
    store_u32(table + RECIPROCALS + 28, 33554432)
    store_u32(table + RECIPROCALS + 32, 26843546)
    store_u32(table + RECIPROCALS + 36, 20648882)
    store_u32(table + RECIPROCALS + 40, 16777216)
    store_u32(table + RECIPROCALS + 44, 13421773)
    store_u32(table + RECIPROCALS + 48, 10737419)
    store_u32(table + RECIPROCALS + 52, 8388608)
    store_u32(table + RECIPROCALS + 56, 6710887)
    store_u32(table + RECIPROCALS + 60, 5368710)
    store_u32(table + RECIPROCALS + 64, 4194304)
    store_u32(table + RECIPROCALS + 68, 3355444)
    store_u32(table + RECIPROCALS + 72, 2684355)
    store_u32(table + RECIPROCALS + 76, 2097152)

# Whether the small page at `page` has no room left for a block of `class`.
fn full(page: usize, class: usize) -> bool:
    load_u32(page) == 0 && usize(load_u16(page + 14)) * 16 + class_bytes(class) > PAGE

# Takes the small page at `page` out of its class's list.
fn unlink(page: usize, class: usize) -> void:
    next := usize(load_u32(page + 4))
    previous := usize(load_u32(page + 8))
    if previous != 0:
        store_u32(previous + 4, u32(next))
    else:
        set_head(class, next)
    if next != 0:
        store_u32(next + 8, u32(previous))

fn head(class: usize) -> usize:
    usize(load_u32(table + 4 * class))

fn set_head(class: usize, page: usize) -> void:
    store_u32(table + 4 * class, u32(page))

fn set(page_number: usize, entry: u32) -> void:
    store_u32(table + LISTS + 4 * page_number, entry)

fn lower_hint(page_number: usize) -> void:
    if page_number < hint:
        hint = page_number

# The first allocation's set-up: a page for the table, whose entries mark
# every page the heap had before as static.
fn start() -> void:
    at := grown(1)
    table = at * PAGE
    heap = table
    capacity = (PAGE - LISTS) / 4
    init_classes()
    claim(at, 1, u32(SMALL))
    hint = known

# The first of `count` free pages next to each other, first fit; the heap
# grows when none fit. The caller sets their entries.
fn take(count: usize) -> usize:
    let first = hint
    let run: usize = 0
    let page_number = hint
    while page_number < known && run < count:
        if load_u32(table + LISTS + 4 * page_number) == 0:
            run = run + 1
        else:
            first = page_number + 1
            run = 0
        page_number = page_number + 1
    if run < count:
        return extend(count)
    if first == hint:
        hint = first + count
    first

# Grows the heap by `count` free pages for the allocator and gives the
# first.
fn extend(count: usize) -> usize:
    first := grown(count)
    if first + count > capacity:
        move_table(first + count)
    claim(first, count, 0)
    first

# Moves the table to new pages with room for twice `need` entries, and
# frees its old page.
fn move_table(need: usize) -> void:
    count := (LISTS + 8 * need + PAGE - 1) / PAGE
    first := grown(count)
    copy(first * PAGE, table, LISTS + 4 * known)
    old := table / PAGE
    old_count := (LISTS + 4 * capacity + PAGE - 1) / PAGE
    table = first * PAGE
    capacity = (count * PAGE - LISTS) / 4
    claim(first, count, u32(SMALL))
    claim(old, old_count, 0)
    lower_hint(old)

# Sets the entries of the `count` pages from `first` to `entry`, and those
# from the last known page up to `first`, which another part of the program
# grew, to static.
fn claim(first: usize, count: usize, entry: u32) -> void:
    let page_number = known
    while page_number < first:
        set(page_number, u32(SMALL))
        page_number = page_number + 1
    let j: usize = 0
    while j < count:
        set(first + j, entry)
        j = j + 1
    if first + count > known:
        known = first + count

# Grows the heap by `count` pages and gives the first.
fn grown(count: usize) -> usize:
    match grow(count):
        .Some(first) => first
        .None => panic_with("heap-exhausted", "an allocation does not fit the heap")

@intrinsic("panic")
fn panic_with(category: string, message: string) -> never:
    panic("intrinsic")
