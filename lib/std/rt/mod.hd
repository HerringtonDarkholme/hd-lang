# std.rt: compiler-known runtime protocols. A runtime module, so only std
# may use it (spec/lang/10-modules.md#r-module.rt.std-only).
use std.core.Copy

## The standard library's final-release hook. Release glue calls `drop` before releasing the value's fields.
## A hook must not write a place its caller may read later through a by-value snapshot.
## The same restriction covers places protected by a live ordinary reference.
## It may release its own storage. ListDrain, UniqListDrain and UniqMapDrain
## write only the collection they borrow exclusively, apart from their own
## storage; that borrow excludes a live snapshot read of the collection.
## Test hooks may update globals when no caller holds snapshots or live references to those globals.
## The std-only syntactic screen flags direct pointer-field/raw-address writes;
## helper behavior and raw ownership still require review of this invariant.
## See [module.rt.drop.caller-read](../../../spec/lang/10-modules.md#r-module.rt.drop.caller-read).
## See [module.rt.drop.glue](../../../spec/lang/10-modules.md#r-module.rt.drop.glue).
pub trait Drop < ?Copy:
    fn drop(&mut self) -> void

# The private seed bridge shared by Map and UniqMap. The bucket algorithms
# live in std.hash; this runtime leaf exposes no seed sequence to user code.
# See std-hash.map.seed-new and std-hash.map.seed-replay.
@intrinsic("map_hash_seed")
pub fn map_hash_seed() -> u64:
    panic("intrinsic")
