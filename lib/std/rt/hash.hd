# Shared foldhash implementation and compiler-selected bucket entry points.
# Only std may import this runtime module (module.rt.std-only).
use std.core.{Hash, Hasher}
use std.meta.inline
use std.rt.bytes.{bytes_len, bytes_at}
use std.rt.memory.{load_u32, load_u64, string_bytes}

# foldhash 0.2.0 fast, with its non-wide-arithmetic Wasm multiply.
# Port of Orson Peters' foldhash (2024), distributed under Zlib/Apache-2.0/MIT.
# Source: https://github.com/orlp/foldhash/tree/8f878c636fda9c9e93384824ea45e06d03f009f5/src
# Map bucket hashes use the low 32 bits (std-hash.map.foldhash-fast), and
# FoldHasher and hash_of use all 64 with one fixed seed.
