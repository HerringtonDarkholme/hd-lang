# std.rt.bytes: the byte, text and panic primitives that several std
# modules share (spec/std/README.md#standard-library-primitives), each
# declared once. A runtime module, so only std may use it
# (spec/lang/10-modules.md#r-module.rt.std-only), and it uses only std.core
# (spec/lang/10-modules.md#r-module.rt.leaf), so every std module may use it.
# The compiler supplies each body: the byte primitives come from the Wasm
# runtime and the case mappings from the host. Where a body below is hd, it
# defines the result, and the compiler supplies a SIMD128 one (#428).
use std.core.Copy
use std.rt.memory.{Buffer, Ptr, copy, new_string, string_bytes, store_u8}

## The number of bytes in `text`.
@intrinsic("bytes_len")
pub fn bytes_len(text: string) -> usize:
    panic("intrinsic")

## The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
pub fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

## The bytes from offset `start` up to `end`, sharing them in constant time.
@intrinsic("bytes_slice")
pub fn bytes_slice(text: string, start: usize, end: usize) -> string:
    panic("intrinsic")

## The bytes of `left`, then those of `right`, in one new string.
pub fn bytes_concat(left: string, right: string) -> string:
    left_size := bytes_len(left)
    right_size := bytes_len(right)
    result := new_string(left_size + right_size)
    address := string_bytes(result).address
    copy(address, string_bytes(left).address, left_size)
    copy(address + left_size, string_bytes(right).address, right_size)
    result

## Every part's bytes in order, copied once into one new string.
pub fn concat_all(parts: List[string]) -> string:
    let total: usize = 0
    for part in &parts:
        total += bytes_len(*part)
    result := new_string(total)
    let address = string_bytes(result).address
    for part in parts:
        size := bytes_len(part)
        copy(address, string_bytes(part).address, size)
        address += size
    result

## The string of `bytes`, which the caller has checked are UTF-8. It takes over the list's buffer when nothing else holds it, else copies the bytes.
@intrinsic("string_from_bytes")
pub fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# Internal byte storage used only with valid UTF-8 and no outstanding element
# references. `spare` reserves room without changing the initialized length;
# `advance` commits the bytes the caller initialized in that room.
pub trait TextSink < ?Copy:
    fn append_text(&mut self, text: string) -> void
    fn append_signed(&mut self, value: i64) -> void
    fn append_unsigned(&mut self, value: u64) -> void

# A copyable serializer must keep independent output snapshots. Its room is
# an initialized, counted string at the allocation's payload start, with a
# separate used length. Only std can name or mutate this internal storage.
pub struct TextRoom:
    pub room: string
    pub len: usize

pub trait ByteBuffer < ?Copy & TextSink:
    fn push_byte(&mut self, byte: u8) -> void
    fn spare(&mut self, additional: usize) -> Ptr[u8]
    fn advance(&mut self, count: usize) -> void
    fn take_text(&mut self) -> string
    fn copy_text(&self) -> string

## Takes over `len` initialized UTF-8 bytes of this owned raw allocation.
@intrinsic("string_from_bytes")
pub fn string_from_buffer(bytes: Buffer[u8], len: usize) -> string:
    panic("intrinsic")

# Consumes initialized string room from new_string, exposing only the selected initialized bytes.
# Like raw Buffer transfer, this changes ownership metadata, not the bytes.
@intrinsic("string_from_bytes")
pub fn string_prefix(room: string, start: usize, len: usize) -> string:
    panic("intrinsic")

# Primitive aliases share one intrinsic key and write into twenty bytes of room.
@intrinsic("format_int")
pub fn format_signed(value: i64, destination: Ptr[u8]) -> (usize, usize):
    panic("intrinsic")

@intrinsic("format_int")
pub fn format_unsigned(value: u64, destination: Ptr[u8]) -> (usize, usize):
    panic("intrinsic")

# Exact widths and writers for a value interpolation's pre-sized room.
# These are ordinary hd, shared by every integer width after widening.
pub fn unsigned_width(value: u64) -> usize:
    # A balanced search over all twenty decimal widths needs at most five
    # comparisons and no division, for every u64 including zero.
    if value < 10_000_000_000:
        if value < 100_000:
            if value < 1_000:
                if value < 100:
                    if value < 10:
                        return 1
                    return 2
                return 3
            if value < 10_000:
                return 4
            return 5
        if value < 100_000_000:
            if value < 10_000_000:
                if value < 1_000_000:
                    return 6
                return 7
            return 8
        if value < 1_000_000_000:
            return 9
        return 10
    if value < 1_000_000_000_000_000:
        if value < 10_000_000_000_000:
            if value < 1_000_000_000_000:
                if value < 100_000_000_000:
                    return 11
                return 12
            return 13
        if value < 100_000_000_000_000:
            return 14
        return 15
    if value < 1_000_000_000_000_000_000:
        if value < 100_000_000_000_000_000:
            if value < 10_000_000_000_000_000:
                return 16
            return 17
        return 18
    if value < 10_000_000_000_000_000_000:
        return 19
    return 20

pub fn signed_magnitude(value: i64) -> u64:
    if value < 0: u64(-(value + 1)) + 1 else: u64(value)

pub fn signed_width(value: i64) -> usize:
    unsigned_width(signed_magnitude(value)) + (if value < 0: 1 else: 0)

pub fn char_width(value: char) -> usize:
    scalar := char_scalar(value)
    if scalar < 128: 1 else if scalar < 2048: 2 else if scalar < 65536: 3 else: 4

# Writes backwards into exactly `width` bytes. No fixed 20-byte reservation
# or padding store may reach beyond the measured integer's room.
pub fn write_unsigned_sized(value: u64, destination: Ptr[u8], width: usize) -> void:
    let remaining = value
    let at = destination.address + width
    while true:
        at -= 1
        store_u8(at, u8(remaining % 10) + 48)
        remaining /= 10
        if remaining == 0:
            break

pub fn write_signed_sized(value: i64, destination: Ptr[u8], width: usize) -> void:
    write_unsigned_sized(signed_magnitude(value), destination, width)
    if value < 0:
        store_u8(destination.address, 45)

pub fn write_char_sized(value: char, destination: Ptr[u8]) -> void:
    scalar := char_scalar(value)
    at := destination.address
    if scalar < 128:
        store_u8(at, u8(scalar))
    else if scalar < 2048:
        store_u8(at, u8(192 + scalar / 64))
        store_u8(at + 1, u8(128 + scalar % 64))
    else if scalar < 65536:
        store_u8(at, u8(224 + scalar / 4096))
        store_u8(at + 1, u8(128 + scalar / 64 % 64))
        store_u8(at + 2, u8(128 + scalar % 64))
    else:
        store_u8(at, u8(240 + scalar / 262144))
        store_u8(at + 1, u8(128 + scalar / 4096 % 64))
        store_u8(at + 2, u8(128 + scalar / 64 % 64))
        store_u8(at + 3, u8(128 + scalar % 64))

## The lowercase mapping of `text`, from the host.
@intrinsic("string_lower")
pub fn host_lower(text: string) -> string:
    panic("intrinsic")

## The uppercase mapping of `text`, from the host.
@intrinsic("string_upper")
pub fn host_upper(text: string) -> string:
    panic("intrinsic")

## The `char` of a scalar value, or `.None` for a surrogate or a value above `0x10FFFF`. Every caller passes the scalar value of a valid UTF-8 string.
@intrinsic("char_from_scalar")
pub fn char_from_scalar(point: u32) -> char?:
    panic("intrinsic")

## The scalar value of `value`: a `char` is its scalar value at run time.
@intrinsic("char_scalar")
pub fn char_scalar(value: char) -> u32:
    panic("intrinsic")

## The checked runtime panic of `category`, such as `index-out-of-bounds`, showing `message`, or no message when it is empty; it does not return.
@intrinsic("panic")
pub fn panic_with(category: string, message: string) -> void:
    panic("intrinsic")

## The offset of the first byte at or after `from` that equals `byte`, or `bytes_len(text)` when there is none.
@intrinsic("bytes_index")
pub fn bytes_index(text: string, from: usize, byte: u8) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        if bytes_at(text, index) == byte:
            return index
        index = index + 1
    size

## The offset of the first byte at or after `from` in the 256-bit set `w0`, `w1`, `w2`, `w3`, where byte `b` is bit `b % 64` of word `b / 64`, or `bytes_len(text)` when there is none.
@intrinsic("bytes_index_set")
pub fn bytes_index_set(text: string, from: usize, w0: u64, w1: u64, w2: u64, w3: u64) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size:
        byte := u64(bytes_at(text, index))
        word := if byte < 64: w0 else if byte < 128: w1 else if byte < 192: w2 else: w3
        if (word >> (byte % 64)) & 1 == 1:
            return index
        index = index + 1
    size

## The first offset `i` at or after `from` with `i + gap < bytes_len(text)`, byte `i` equal to `first` and byte `i + gap` equal to `last`, or `bytes_len(text)` when there is none.
@intrinsic("bytes_index_pair")
pub fn bytes_index_pair(text: string, from: usize, first: u8, last: u8, gap: usize) -> usize:
    size := bytes_len(text)
    let index = from
    while index < size && gap < size - index:
        if bytes_at(text, index) == first && bytes_at(text, index + gap) == last:
            return index
        index = index + 1
    size

## The offset of the first position where `left` and `right` differ; when one is a prefix of the other, the shorter length, and when they are equal, their common length.
@intrinsic("bytes_mismatch")
pub fn bytes_mismatch(left: string, right: string) -> usize:
    left_size := bytes_len(left)
    right_size := bytes_len(right)
    shorter := if left_size < right_size: left_size else: right_size
    let index: usize = 0
    while index < shorter:
        if bytes_at(left, index) != bytes_at(right, index):
            return index
        index = index + 1
    shorter
