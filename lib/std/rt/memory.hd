# std.rt.memory: the heap's memory intrinsics
# (spec/lang/10-modules.md#memory-intrinsics). The runtime that a
# linear-memory backend runs (the allocator, release, the collector) is hd
# over these. Each declaration is ordinary hd and only its body is the
# compiler's. A runtime module, so only std may use it
# (spec/lang/10-modules.md#r-module.rt.std-only).

@intrinsic("mem_pages")
## The heap's size in pages of 65,536 bytes.
## See [module.rt.memory.pages](../../../spec/lang/10-modules.md#r-module.rt.memory.pages).
pub fn pages() -> usize:
    panic("intrinsic")

@intrinsic("mem_grow")
## Adds `count` zeroed pages at the heap's end and gives the size in pages before them, or `.None` when the heap cannot grow that far.
## See [module.rt.memory.grow](../../../spec/lang/10-modules.md#r-module.rt.memory.grow).
pub fn grow(count: usize) -> Option[usize]:
    panic("intrinsic")

@intrinsic("mem_load_u8")
## The byte at `address`.
## See [module.rt.memory.load](../../../spec/lang/10-modules.md#r-module.rt.memory.load).
pub fn load_u8(address: usize) -> u8:
    panic("intrinsic")

@intrinsic("mem_load_u16")
## The 2 bytes from `address`, least significant first.
## See [module.rt.memory.load](../../../spec/lang/10-modules.md#r-module.rt.memory.load).
pub fn load_u16(address: usize) -> u16:
    panic("intrinsic")

@intrinsic("mem_load_u32")
## The 4 bytes from `address`, least significant first.
## See [module.rt.memory.load](../../../spec/lang/10-modules.md#r-module.rt.memory.load).
pub fn load_u32(address: usize) -> u32:
    panic("intrinsic")

@intrinsic("mem_load_u64")
## The 8 bytes from `address`, least significant first.
## See [module.rt.memory.load](../../../spec/lang/10-modules.md#r-module.rt.memory.load).
pub fn load_u64(address: usize) -> u64:
    panic("intrinsic")

@intrinsic("mem_store_u8")
## Writes `value` at `address`.
## See [module.rt.memory.store](../../../spec/lang/10-modules.md#r-module.rt.memory.store).
pub fn store_u8(address: usize, value: u8) -> void:
    panic("intrinsic")

@intrinsic("mem_store_u16")
## Writes the 2 bytes of `value` from `address`, least significant first.
## See [module.rt.memory.store](../../../spec/lang/10-modules.md#r-module.rt.memory.store).
pub fn store_u16(address: usize, value: u16) -> void:
    panic("intrinsic")

@intrinsic("mem_store_u32")
## Writes the 4 bytes of `value` from `address`, least significant first.
## See [module.rt.memory.store](../../../spec/lang/10-modules.md#r-module.rt.memory.store).
pub fn store_u32(address: usize, value: u32) -> void:
    panic("intrinsic")

@intrinsic("mem_store_u64")
## Writes the 8 bytes of `value` from `address`, least significant first.
## See [module.rt.memory.store](../../../spec/lang/10-modules.md#r-module.rt.memory.store).
pub fn store_u64(address: usize, value: u64) -> void:
    panic("intrinsic")

@intrinsic("mem_copy")
## Copies the `count` bytes from `from` to `to`, as though through a separate buffer, so the two ranges may overlap.
## See [module.rt.memory.copy](../../../spec/lang/10-modules.md#r-module.rt.memory.copy).
pub fn copy(to: usize, from: usize, count: usize) -> void:
    panic("intrinsic")

@intrinsic("mem_fill")
## Sets the `count` bytes from `to` to `byte`.
## See [module.rt.memory.fill](../../../spec/lang/10-modules.md#r-module.rt.memory.fill).
pub fn fill(to: usize, byte: u8, count: usize) -> void:
    panic("intrinsic")

## The address of a value of type `T` in the heap. A copy of a `Ptr[T]` copies the address, never the value.
## See [module.rt.ptr.type](../../../spec/lang/10-modules.md#r-module.rt.ptr.type).
pub struct Ptr[T]:
    ## The address of the value's first byte.
    pub address: usize

impl[T] Ptr[T]:
    ## Moves the value at the address out and gives it; the heap there then holds none.
    ## See [module.rt.ptr.read](../../../spec/lang/10-modules.md#r-module.rt.ptr.read).
    @intrinsic("ptr_read")
    pub fn read(self) -> T: panic("intrinsic")

    ## Writes a copy of `value` at the address, over whatever its bytes held.
    ## See [module.rt.ptr.write](../../../spec/lang/10-modules.md#r-module.rt.ptr.write).
    @intrinsic("ptr_write")
    pub fn write(self, value: T) -> void: panic("intrinsic")

    ## The address `count` values of `T` past this one.
    ## See [module.rt.ptr.offset](../../../spec/lang/10-modules.md#r-module.rt.ptr.offset).
    @intrinsic("ptr_offset")
    pub fn offset(self, count: usize) -> Ptr[T]: panic("intrinsic")

## The number of heap bytes one value of `T` takes.
## See [module.rt.ptr.size-of](../../../spec/lang/10-modules.md#r-module.rt.ptr.size-of).
@intrinsic("ptr_size_of")
pub fn size_of[T]() -> usize:
    panic("intrinsic")
