# std.rt.crossing: the buffers a `Send` crossing takes to another thread
# (spec/lang/07-functions.md#r-fn.crossing.mode.unique). Counts are never
# atomic (module.marker.send.counts), so no counted buffer may be
# reachable from two threads: the crossing reads each capture that may
# hold one into a local of its own, a move at its last use, and calls
# `std.rt.unique` on it, whose body per type calls these walks. A runtime
# module, so only std may use it (spec/lang/10-modules.md#r-module.rt.std-only).
# Cost: a test of each buffer's count, and a copy of each shared one.
use std.core.{Copy, Eq, Hash}
use std.rt.alloc.block_of
use std.rt.bytes.bytes_len
use std.rt.memory.{Ptr, copy, load_u32, new_string, string_bytes}
use std.rt.unique

# A string's bytes in a block another holder counts are copied to a new
# string; a literal's, in static data, have no count to change.
fn unique_string(text: &mut string) -> void:
    at := string_bytes(*text).address
    block := block_of(at)
    if block == 0 || load_u32(block) == 1:
        return
    size := bytes_len(*text)
    own := new_string(size)
    copy(string_bytes(own).address, at, size)
    *text = own

# A list's buffer with another holder is copied, its elements counted
# again. The empty list is the static one, which nothing counts.
fn own_list[T](items: &mut List[T]) -> void:
    size := items.len()
    if size == 0:
        *items = []
    else:
        list_truncate(items, size)

fn unique_list[T](items: &mut List[T]) -> void:
    own_list(items)
    for item in &mut items:
        unique(item)

# A map's table with another holder is copied, its entries counted again:
# a mutable entry loop takes it as its own before its first entry.
fn own_map[K < Eq & Hash, V](entries: &mut Map[K, V]) -> void:
    if entries.len() == 0:
        *entries = {}
    else if load_u32(usize(load_u32(address_of(entries))) - 8) > 1:
        for (_, value) in &mut entries:
            return

# A key is lent only shared, so it is made unique through its address once
# its loan ended; its bytes stay equal, and so does its hash.
fn unique_map[K < Eq & Hash, V](entries: &mut Map[K, V]) -> void:
    own_map(entries)
    for (key, value) in &mut entries:
        unique(Ptr::[K] { address: address_of(key) }.as_mut())
        unique(value)

# Shrinks `items` to its first `len` elements, after it takes its buffer
# as its own.
@intrinsic("list_truncate")
fn list_truncate[T](items: &mut List[T], len: usize) -> void:
    panic("intrinsic")

@intrinsic("mem_ref_address")
fn address_of[T < ?Copy](target: &T) -> usize:
    panic("intrinsic")
