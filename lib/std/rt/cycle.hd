# std.rt.cycle: the cycle collector of the linear-memory runtime
# (crates/hd_wasm_linear/DESIGN.md §23.28), hd over std.rt.memory and
# std.rt.alloc. A runtime module, so only std may use it
# (spec/lang/10-modules.md#r-module.rt.std-only).
#
# Counting frees an object at its last release, but not a ring of objects
# that hold each other. This is synchronous trial deletion (Bacon and
# Rajan, "Concurrent Cycle Collection in Reference Counted Systems",
# ECOOP 2001; docs/future-work/REFCOUNT_RUNTIME.md §7):
#
# 1. A release that leaves a count above zero on an object that takes part
#    makes it a candidate: purple, and in the candidate buffer. Its last
#    release still runs its release glue at once, but its block stays in
#    the buffer with a count of 0 (`keep`), and the next collection frees
#    it, as Bacon and Rajan's release does with a buffered object. So the
#    buffer is a list of addresses that only a collection removes from.
# 2. A collection first frees the candidates whose last count went. It
#    then marks gray from each other candidate, taking one count
#    off each object the gray ones reference; scans, so that an object
#    with a count left, which something outside holds, and all it reaches
#    turn black and get their counts back; and frees what stays white.
#
# An object takes part when the backend decided at its allocation that its
# type can be on a cycle (crates/hd_wasm_linear/DESIGN.md §23.28): its
# descriptor word (the header's second word) has the CYCLIC bit, and its
# block ends with a collector word, which `track` zeroes. The word's low
# 2 bits are the color (black, gray or white) and bit 2 marks a
# suspension frame; neither a release nor a free reads it, as its place
# needs the block's size. The descriptor's BUFFERED bit says whether the
# object is in the buffer. A buffered object is purple except while a
# collection runs, whatever its color bits say. A running frame has stale
# saved slots and is not entered: what it holds counts as held from outside.
# Its candidate stays buffered until a later collection while it is idle.
# Objects that do not take part are never entered; a white object's
# reference to one is released as usual once the white objects are freed.
#
# The backend supplies what only it can: `trace` runs an object's release
# glue while the backend's release hands each reference the glue releases
# to `visit`, `release` is the backend's release of one reference, and
# `free` the runtime's free, which `keep` tells to leave a candidate's
# block to the collector. It calls `collect` before an allocation when
# `due` says the live candidates passed the threshold, or that enough of
# them lost their last count to free them (then it only frees those),
# and when the entry's poll answers, so at idle and before checked mode's
# leak report.
use std.rt.alloc.{alloc, block_bytes, block_of, free_block}
use std.rt.memory.{copy, load_u32, store_u32}

BLACK := 0
GRAY := 1
WHITE := 2
# Purple is the BUFFERED bit, never painted.
COLORS := 4
FRAME := 4
# Counted header (8 bytes) plus task::F_FLAGS (12); ACTIVE | RUNNING.
FRAME_FLAGS := 20
FRAME_RUNNING := 129
# The descriptor word's bits: the object takes part, and it is in the
# candidate buffer.
CYCLIC := 0x80000000
BUFFERED := 0x40000000

# What `visit` does with the references that `trace` finds.
IDLE := 0
MARK := 1
SCAN := 2
RESTORE := 3
COLLECT := 4

# The candidate buffer's first threshold, PHP's fixed buffer size.
FIRST := 10000
# The fewest candidates without counts that make a sweep due.
SWEEP := 64

# The candidate buffer, an array of block addresses (see `push`), where 0
# is a candidate taken out, and how many candidates it holds.
let roots: usize = 0
let candidates: usize = 0
# The work list of a collection's walks: block addresses, a scan's tagged
# with SCAN or RESTORE in their low bits.
let stack: usize = 0
# The white objects of a collection, freed once it has walked them all.
let garbage: usize = 0
# The references from white objects to objects that do not take part,
# released once the white objects are freed.
let later: usize = 0
# What `visit` does now.
let mode: usize = IDLE
# Whether a collection is running.
let collecting = false
# How many candidates make a collection due.
let threshold: usize = FIRST
# The objects the running collection marked gray.
let visited: usize = 0
# How many candidates in the buffer have no count left (`keep`).
let dead: usize = 0
# Whether the next collection only frees those: `due` found the live
# candidates below the threshold.
let sweep_only = false

## Zeroes the collector word of the new object at `block`, which takes part: black, and in no buffer.
pub fn track(block: usize) -> void:
    set_word(block, 0)

## Marks the new object holding `address` as a frame; a collection enters its saved slots only while it is not running.
pub fn opaque(address: usize) -> void:
    set_word(block_of(address), FRAME)

## How many candidates the buffer holds.
pub fn pending() -> usize:
    candidates

## Whether a collection is due: the live candidates passed the threshold, or enough candidates have no count left that freeing them is due.
pub fn due() -> bool:
    # Fewer candidates than SWEEP make neither due, as the threshold is never
    # below FIRST. Emitted code tests this before each allocation, so it
    # stays one compare, and `collection_due` has the rest.
    candidates >= SWEEP && collection_due()

# `due` with SWEEP candidates or more. `sweep_only` is false before it, as
# only a `due` that answers true sets it and the collection that follows
# clears it.
fn collection_due() -> bool:
    if collecting:
        return false
    if candidates - dead >= threshold:
        sweep_only = false
        return true
    # A sweep walks the whole buffer, so it waits for at least as many
    # candidates without counts as live ones: each costs a bounded share,
    # and they hold no more blocks than the live candidates do.
    sweep_only = dead >= SWEEP && dead * 2 >= candidates
    sweep_only

## Makes the object at `block`, which takes part and whose count a release just left above zero, a candidate; one already in the buffer is purple already.
pub fn suspect(block: usize) -> void:
    desc := usize(load_u32(block + 4))
    if (desc & BUFFERED) != 0:
        return
    # A full buffer first closes the gaps a collection left.
    if roots != 0 && length(roots) == usize(load_u32(roots + 4)) && candidates < length(roots):
        compact()
    roots = push(roots, block)
    candidates = candidates + 1
    store_u32(block + 4, u32(desc | BUFFERED))

## Whether the counted object at `block`, which is being freed, is a candidate. A candidate stays in the buffer with a count of 0, and the next collection frees it; any other block is the caller's to free.
pub fn keep(block: usize) -> bool:
    if (usize(load_u32(block + 4)) & BUFFERED) == 0:
        return false
    store_u32(block, 0)
    dead = dead + 1
    true

## While a collection traces an object, takes the reference at `address` that its release glue releases and gives true; else false, so the release goes on as usual.
pub fn visit(address: usize) -> bool:
    if mode == IDLE:
        return false
    block := block_of(address)
    if block == 0:
        return true
    part := takes_part(block)
    if mode == COLLECT:
        if !part:
            later = push(later, address)
        else if color(block) == WHITE:
            paint(block, BLACK)
            garbage = push(garbage, block)
            stack = push(stack, block)
        return true
    if !part:
        return true
    if mode == MARK:
        store_u32(block, load_u32(block) - 1)
        if color(block) != GRAY:
            paint(block, GRAY)
            stack = push(stack, block)
    else if mode == SCAN:
        stack = push(stack, block + SCAN)
    else:
        store_u32(block, load_u32(block) + 1)
        if color(block) != BLACK:
            paint(block, BLACK)
            stack = push(stack, block + RESTORE)
    true

## Frees the candidates whose last count went, then, unless `due` asked for that alone, collects the others' garbage cycles: `trace` runs a block's release glue, `release` releases one reference, and `free` frees a block.
pub fn collect(trace: fn(usize) -> void, release: fn(usize) -> void, free: fn(usize) -> void) -> void:
    if collecting:
        return
    collecting = true
    visited = 0
    sweep(free)
    if sweep_only:
        sweep_only = false
        collecting = false
        return
    n := length(roots)
    let i: usize = 0
    while i < n:
        s := item(roots, i)
        if s != 0 && takes_part(s):
            if color(s) != GRAY:
                mark(s, trace)
            else:
                drop_root(i, s)
        i = i + 1
    i = 0
    while i < n:
        s := item(roots, i)
        if s != 0 && takes_part(s):
            scan(s, trace)
        i = i + 1
    i = 0
    while i < n:
        s := item(roots, i)
        if s != 0 && takes_part(s):
            drop_root(i, s)
            if color(s) == WHITE:
                paint(s, BLACK)
                garbage = push(garbage, s)
                stack = push(stack, s)
                drain(COLLECT, trace)
        i = i + 1
    freed := length(garbage)
    i = 0
    while i < freed:
        free(item(garbage, i))
        i = i + 1
    clear(garbage)
    # A release here may free more and make candidates of others, which
    # stay in the buffer for the next collection.
    i = 0
    while i < length(later):
        release(item(later, i))
        i = i + 1
    clear(later)
    compact()
    # REFCOUNT_RUNTIME.md §7.4: a collection that frees most of what it
    # visited halves the threshold back toward the first; one that frees
    # little doubles it.
    if freed * 2 >= visited:
        threshold = if threshold / 2 > FIRST: threshold / 2 else: FIRST
    else:
        threshold = threshold * 2
    collecting = false

# Marks gray all that candidate `s` reaches, taking one count off each
# object a gray one references.
fn mark(s: usize, trace: fn(usize) -> void) -> void:
    paint(s, GRAY)
    stack = push(stack, s)
    while length(stack) > 0:
        b := pop(stack)
        visited = visited + 1
        mode = MARK
        trace(b)
        mode = IDLE

# Scans what candidate `s` reached: a gray object with a count left is
# held from outside, so it and all it reaches turn black and get their
# counts back; the other gray objects turn white.
fn scan(s: usize, trace: fn(usize) -> void) -> void:
    stack = push(stack, s + SCAN)
    while length(stack) > 0:
        e := pop(stack)
        b := e - e % 16
        if e % 16 == RESTORE:
            mode = RESTORE
            trace(b)
            mode = IDLE
        else if color(b) == GRAY:
            if load_u32(b) > 0:
                paint(b, BLACK)
                stack = push(stack, b + RESTORE)
            else:
                paint(b, WHITE)
                mode = SCAN
                trace(b)
                mode = IDLE

# Traces each block on the stack with `visit` doing `how`.
fn drain(how: usize, trace: fn(usize) -> void) -> void:
    while length(stack) > 0:
        b := pop(stack)
        mode = how
        trace(b)
        mode = IDLE

# Takes candidate `s`, at `i` in the buffer, out of it.
fn drop_root(i: usize, s: usize) -> void:
    set_item(roots, i, 0)
    candidates = candidates - 1
    store_u32(s + 4, u32(usize(load_u32(s + 4)) & ~BUFFERED))

# Frees each candidate whose last count went, before a mark takes counts
# off the others, and moves the rest to the buffer's front.
fn sweep(free: fn(usize) -> void) -> void:
    let j: usize = 0
    let i: usize = 0
    n := length(roots)
    while i < n:
        s := item(roots, i)
        if s != 0:
            if load_u32(s) == 0:
                store_u32(s + 4, u32(usize(load_u32(s + 4)) & ~BUFFERED))
                free(s)
            else:
                set_item(roots, j, s)
                j = j + 1
        i = i + 1
    if roots != 0:
        store_u32(roots, u32(j))
    candidates = j
    dead = 0

# Moves the candidates left to the buffer's front.
fn compact() -> void:
    let j: usize = 0
    let i: usize = 0
    while i < length(roots):
        s := item(roots, i)
        if s != 0:
            set_item(roots, j, s)
            j = j + 1
        i = i + 1
    if roots != 0:
        store_u32(roots, u32(j))
    candidates = j

# Whether the object at `block` takes part: its descriptor has the CYCLIC
# bit and, for a frame, its saved slots are stable.
fn takes_part(block: usize) -> bool:
    (usize(load_u32(block + 4)) & CYCLIC) != 0 && (
        (word(block) & FRAME) == 0 ||
        (usize(load_u32(block + FRAME_FLAGS)) & FRAME_RUNNING) == 0
    )

fn word(block: usize) -> usize:
    usize(load_u32(block + block_bytes(block) - 4))

fn set_word(block: usize, w: usize) -> void:
    store_u32(block + block_bytes(block) - 4, u32(w))

fn color(block: usize) -> usize:
    word(block) % COLORS

fn paint(block: usize, c: usize) -> void:
    w := word(block)
    set_word(block, w - w % COLORS + c)

# An array is a block of the allocator: its length, its capacity, then its
# items, 4 bytes each; 0 is the empty array before its first push. A push
# may move it, so it gives the array's new address.
fn push(array: usize, value: usize) -> usize:
    let at = array
    if at == 0:
        at = alloc(8 + 4 * 64)
        store_u32(at, 0)
        store_u32(at + 4, 64)
    n := usize(load_u32(at))
    cap := usize(load_u32(at + 4))
    if n == cap:
        bigger := alloc(8 + 8 * cap)
        copy(bigger, at, 8 + 4 * cap)
        store_u32(bigger + 4, u32(2 * cap))
        free_block(at)
        at = bigger
    store_u32(at + 8 + 4 * n, u32(value))
    store_u32(at, u32(n + 1))
    at

fn pop(array: usize) -> usize:
    n := usize(load_u32(array)) - 1
    store_u32(array, u32(n))
    item(array, n)

fn length(array: usize) -> usize:
    if array == 0: 0 else: usize(load_u32(array))

fn item(array: usize, i: usize) -> usize:
    usize(load_u32(array + 8 + 4 * i))

fn set_item(array: usize, i: usize, value: usize) -> void:
    store_u32(array + 8 + 4 * i, u32(value))

fn clear(array: usize) -> void:
    if array != 0:
        store_u32(array, 0)

# The collector's free callback runs either during the zero-count sweep,
# when garbage is empty, or over the white objects it just traced. Only
# checked instrumentation calls this; ordinary collection is unchanged.
pub fn freeing_cycles() -> bool:
    length(garbage) != 0
