# std.encoding: bytes as hex and base64 text (spec/std/encoding.md).
use std.format.DebugWriter
use std.error.Error

# Why decoding failed, at a byte offset into the text
# (r-std-encoding.error.position-bytes).
## Why decoding failed: the kind, and the byte position.
## See [std-encoding.error.declared](../../spec/std/encoding.md#r-std-encoding.error.declared).
pub enum DecodeError:
    # A character outside the alphabet.
    InvalidCharacter(position: usize)
    # The text stops inside a unit; `position` is its length.
    InvalidLength(position: usize)
    # A misplaced `=`, or nonzero pad bits in the last symbol.
    InvalidPadding(position: usize)

impl Eq for DecodeError:
    fn eq(self, other: DecodeError) -> bool:
        match (self, other):
            (.InvalidCharacter(left), .InvalidCharacter(right)) => left == right
            (.InvalidLength(left), .InvalidLength(right)) => left == right
            (.InvalidPadding(left), .InvalidPadding(right)) => left == right
            _ => false

impl Display for DecodeError:
    fn to_string(self) -> string:
        match self:
            .InvalidCharacter(position) => "invalid character at position $position"
            .InvalidLength(position) => "invalid length: the text ends at position $position"
            .InvalidPadding(position) => "invalid padding at position $position"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for DecodeError

# Lowercase hex, two digits per byte (r-std-encoding.hex.encode).
## The bytes as lowercase hex text, two digits per byte.
## See [std-encoding.hex.encode](../../spec/std/encoding.md#r-std-encoding.hex.encode).
pub fn hex_encode(bytes: List[u8]) -> string:
    let codes: mut List[u8] = []
    for byte in bytes:
        codes.push(hex_symbol(byte >> 4))
        codes.push(hex_symbol(byte & 15))
    ascii_text(codes)

# Either case; the length is checked first, then each character from the
# left (r-std-encoding.hex.decode.order).
## Reads hex text into bytes, or returns the first error.
## See [std-encoding.hex.decode](../../spec/std/encoding.md#r-std-encoding.hex.decode).
pub fn hex_decode(text: string) -> Result[List[u8], DecodeError]:
    codes := ascii_codes(text)
    size := codes.len()
    if size % 2 != 0:
        return .Err(DecodeError.InvalidLength(size))
    let bytes: mut List[u8] = []
    let index: usize = 0
    while index < size:
        high := hex_value(codes[index])
        if high < 0:
            return .Err(DecodeError.InvalidCharacter(index))
        low := hex_value(codes[index + 1])
        if low < 0:
            return .Err(DecodeError.InvalidCharacter(index + 1))
        bytes.push(u8(high * 16 + low))
        index = index + 2
    .Ok(bytes)

# The four base64 encodings of RFC 4648 sections 4 and 5, after Go's
# `base64.Encoding` values (r-std-encoding.base64.variants).
## A base64 encoding: the standard or URL-safe alphabet, with or without `=` padding.
## See [std-encoding.base64.variants](../../spec/std/encoding.md#r-std-encoding.base64.variants).
pub enum Base64:
    # RFC 4648 section 4, padded.
    Standard
    StandardNoPad
    # RFC 4648 section 5, padded.
    Url
    UrlNoPad

impl Base64:
    # One exact-size buffer of ASCII codes, which `string_from_bytes` turns
    # into the text without a second UTF-8 check
    # (r-std-encoding.base64.encode.groups).
    ## The bytes as text in this encoding.
    ## See [std-encoding.base64.encode](../../spec/std/encoding.md#r-std-encoding.base64.encode).
    pub fn encode(self, bytes: List[u8]) -> string:
        size := bytes.len()
        whole := size / 3
        rest := size - whole * 3
        let length: usize = whole * 4
        if rest != 0:
            length = length + (if self.padded(): 4 else: rest + 1)
        let codes: mut List[u8] = zeroes(length)
        let index: usize = 0
        let at: usize = 0
        while index + 3 <= size:
            group := (i32(bytes[index]) << 16) | (i32(bytes[index + 1]) << 8) | i32(bytes[index + 2])
            codes[at] = self.symbol(group >> 18)
            codes[at + 1] = self.symbol((group >> 12) & 63)
            codes[at + 2] = self.symbol((group >> 6) & 63)
            codes[at + 3] = self.symbol(group & 63)
            index = index + 3
            at = at + 4
        if rest == 1:
            group := i32(bytes[index]) << 16
            codes[at] = self.symbol(group >> 18)
            codes[at + 1] = self.symbol((group >> 12) & 63)
            if self.padded():
                codes[at + 2] = 61
                codes[at + 3] = 61
        else if rest == 2:
            group := (i32(bytes[index]) << 16) | (i32(bytes[index + 1]) << 8)
            codes[at] = self.symbol(group >> 18)
            codes[at + 1] = self.symbol((group >> 12) & 63)
            codes[at + 2] = self.symbol((group >> 6) & 63)
            if self.padded():
                codes[at + 3] = 61
        string_from_bytes(codes)

    # Canonical text only: the length is checked first, then the characters
    # from the left, then the pad bits (r-std-encoding.base64.decode.order).
    # The text is read in place by byte offset, and the result is one
    # buffer of exactly the decoded size.
    ## Reads text in this encoding into bytes, or returns the first error.
    ## See [std-encoding.base64.decode](../../spec/std/encoding.md#r-std-encoding.base64.decode).
    pub fn decode(self, text: string) -> Result[List[u8], DecodeError]:
        size := bytes_len(text)
        let end: usize = size
        if self.padded():
            if size % 4 != 0:
                return .Err(DecodeError.InvalidLength(size))
            # The padding is the run of `=` that ends the text, at most two long.
            if size > 0 && bytes_at(text, size - 1) == 61:
                end = if bytes_at(text, size - 2) == 61: size - 2 else: size - 1
        else if size % 4 == 1:
            return .Err(DecodeError.InvalidLength(size))
        let bytes: mut List[u8] = zeroes(end * 6 / 8)
        let buffer: i32 = 0
        let bits: u32 = 0
        let index: usize = 0
        let at: usize = 0
        while index < end:
            code := bytes_at(text, index)
            if code == 61:
                return .Err(DecodeError.InvalidPadding(index))
            value := self.value(code)
            if value < 0:
                return .Err(DecodeError.InvalidCharacter(index))
            buffer = (buffer << 6) | value
            bits = bits + 6
            if bits >= 8:
                bits = bits - 8
                bytes[at] = u8(buffer >> bits)
                at = at + 1
                buffer = buffer & ((1 << bits) - 1)
            index = index + 1
        # The bits left over are the pad bits, which must be zero.
        if buffer != 0:
            return .Err(DecodeError.InvalidPadding(end - 1))
        .Ok(bytes)

    fn padded(self) -> bool:
        match self:
            .Standard => true
            .StandardNoPad => false
            .Url => true
            .UrlNoPad => false

    fn is_url(self) -> bool:
        match self:
            .Standard => false
            .StandardNoPad => false
            .Url => true
            .UrlNoPad => true

    fn symbol(self, value: i32) -> u8:
        if value < 26:
            u8(65 + value)
        else if value < 52:
            u8(71 + value)
        else if value < 62:
            u8(value - 4)
        else if value == 62:
            if self.is_url(): 45 else: 43
        else:
            if self.is_url(): 95 else: 47

    fn value(self, code: u8) -> i32:
        if code >= 65 && code <= 90:
            i32(code) - 65
        else if code >= 97 && code <= 122:
            i32(code) - 71
        else if code >= 48 && code <= 57:
            i32(code) + 4
        else if code == (if self.is_url(): 45 else: 43):
            62
        else if code == (if self.is_url(): 95 else: 47):
            63
        else:
            -1

impl Eq for Base64:
    fn eq(self, other: Base64) -> bool:
        match (self, other):
            (.Standard, .Standard) => true
            (.StandardNoPad, .StandardNoPad) => true
            (.Url, .Url) => true
            (.UrlNoPad, .UrlNoPad) => true
            _ => false

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        code - 48
    else if code >= 97 && code <= 102:
        code - 87
    else if code >= 65 && code <= 70:
        code - 55
    else:
        -1

# One entry per byte: its code when it is ASCII, and -1 for each byte of
# any other character, so a list index is a byte offset.
fn ascii_codes(text: string) -> List[i32]:
    let codes: mut List[i32] = []
    for byte in text.bytes():
        if byte < 128:
            codes.push(i32(byte))
        else:
            codes.push(-1)
    codes

# A list of `count` zero bytes, written once by index.
fn zeroes(count: usize) -> mut List[u8]:
    let values: mut List[u8] = []
    while values.len() < count:
        values.push(0)
    values

fn ascii_text(codes: List[u8]) -> string:
    match string::from_utf8(codes):
        .Ok(text) => text
        .Err(_) => panic("std.encoding: ASCII codes are valid UTF-8")

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for DecodeError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .InvalidCharacter(position) => out.debug_tuple("DecodeError.InvalidCharacter").named_field("position", position).finish()
            .InvalidLength(position) => out.debug_tuple("DecodeError.InvalidLength").named_field("position", position).finish()
            .InvalidPadding(position) => out.debug_tuple("DecodeError.InvalidPadding").named_field("position", position).finish()

impl Debug for Base64:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Standard => out.write("Base64.Standard")
            .StandardNoPad => out.write("Base64.StandardNoPad")
            .Url => out.write("Base64.Url")
            .UrlNoPad => out.write("Base64.UrlNoPad")

# Primitives: the string's bytes read in place, and a string made of bytes
# that the caller has checked are UTF-8.
@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")
