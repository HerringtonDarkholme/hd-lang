# std.testing, the part written in hd (spec/10-modules.md#standard-testing).
# `assert`, `assert_equal`, `snapshot`, `it_each`, `it_prop`, and
# `it_prop_with` are checked by the compiler; `Choices`, `Arbitrary`, and
# `snapshot_file` are declared here (Testing T53).

# The only source of randomness a generator sees
# (spec/10-modules.md#property-tests). The runner creates each one. The
# prototype has no property-test runner: a `Choices` draws from a fixed
# pseudo-random sequence, and `assume` of a false condition panics.
pub data Choices:
    wide: i64
    narrow: i32

impl Choices:
    fn next_wide(mut self, bound: i64) -> i64:
        self.wide = (self.wide * 1103515245 + 12345) % 2147483648
        if bound <= 0: 0 else: self.wide % bound

    fn next_narrow(mut self, bound: i32) -> i32:
        self.narrow = (self.narrow * 75 + 74) % 65537
        if bound <= 0: 0 else: self.narrow % bound

    pub fn int(mut self, lo: i64, hi: i64) -> i64:
        if hi <= lo: lo else: lo + self.next_wide(hi - lo + 1)

    pub fn float(mut self, lo: f64, hi: f64) -> f64:
        steps := [0.0, 0.25, 0.5, 0.75, 1.0]
        if hi <= lo: lo else: lo + (hi - lo) * steps[self.next_narrow(5)]

    pub fn bool(mut self) -> bool:
        self.next_narrow(2) == 1

    pub fn pick[T](mut self, items: List[T]) -> T:
        items[self.next_narrow(items.len())]

    pub fn list[T](mut self, max: i32, item: fn(mut Choices) -> T) -> List[T]:
        let items: mut List[T] = []
        let count: i32 = self.next_narrow(max + 1)
        while items.len() < count:
            items.append(item(self))
        items

    pub fn string(mut self, max: i32) -> string:
        letters := ["a", "b", "z", " ", "0"]
        let text: string = ""
        let count: i32 = self.next_narrow(max + 1)
        let index: i32 = 0
        while index < count:
            text = text + letters[self.next_narrow(5)]
            index = index + 1
        text

    pub fn assume(mut self, ok: bool) -> void:
        if !ok:
            panic("Choices.assume: the prototype has no property-test runner to discard a case")

    pub fn draw[T < Arbitrary](mut self) -> T:
        T::arbitrary(self)

# A type's default generator (spec/10-modules.md#property-tests).
pub trait Arbitrary:
    fn arbitrary(c: mut Choices) -> Self

# `std` implements `Arbitrary` for the primitives and `string`. The
# prototype has no `List`, `Map`, `T?`, `Result`, or tuple implementations yet.
impl Arbitrary for i64:
    fn arbitrary(c: mut Choices) -> i64: c.int(-1000, 1000)

impl Arbitrary for i32:
    fn arbitrary(c: mut Choices) -> i32: c.next_narrow(2001) - 1000

impl Arbitrary for f64:
    fn arbitrary(c: mut Choices) -> f64: c.float(-1000.0, 1000.0)

impl Arbitrary for bool:
    fn arbitrary(c: mut Choices) -> bool: c.bool()

impl Arbitrary for string:
    fn arbitrary(c: mut Choices) -> string: c.string(16)

# `snapshot_file(text)` (spec/10-modules.md#snapshots) compares `text` with
# the file the runner names from the running test case,
# `<package root>/__snapshots__/<module>/<test-slug>-<n>.snap`. The host
# reads, and on `hd test --update` writes, the file, and returns why it
# differs, or "" when it matches. A missing file fails except on `--update`.
pub fn snapshot_file(text: string) -> void:
    problem := snapshot_file_check(text)
    if problem != "":
        panic(problem)

@intrinsic("snapshot_file_check")
fn snapshot_file_check(text: string) -> string:
    panic("intrinsic")
