# std.testing, the part written in hd (spec/lang/10-modules.md#standard-testing).
# `assert_equal`, `snapshot`, `it_each`, `it_prop`, and `it_prop_with` are
# checked by the compiler; `Choices`, `Arbitrary`, and
# `snapshot_file` are declared here (Testing T53), with the bodies that the
# compiler gives an `it_each`, `it_prop`, or `it_prop_with` test case and
# the runner capabilities they use. `std.testing.arbitrary` is
# `lib/std/testing/arbitrary.hd`.
use std.format.debug
use std.hash.Hash
use std.num.{Float, Integer, parse_i64}
use std.random.{Random, SeededRandom}
use std.structure.{Structure, Variant, Field, Members, Key, Source, SelfRef}
# `std.testing.arbitrary` stays a child module: after `use std.testing` the
# path `testing.arbitrary.x` is an error
# (spec/lang/10-modules.md#r-module.path.no-std-child-import). These re-exports
# are the way to its items.
pub use std.testing.arbitrary.{With, with}
use std.process.Process
use std.time.Duration
use std.format.DebugWriter
use std.path.Path

# The test runner's side of a test case
# (spec/std/testing.md#runner-capabilities). `hd test` binds both host
# capabilities for the body that the compiler gives an `it_each`, `it_prop`,
# or `it_prop_with` test case or a `timeout` option, never for the test
# body itself (src/test-runner.ts).
pub trait TestRunner:
    # The table has `count` rows; the index of the row this case runs.
    fn row(mut self, count: usize) -> usize
    # The case's `timeout`, which the runner checks against the body's run.
    fn report_timeout(mut self, millis: i64) -> void
    # Compares `text` with the case's next snapshot file, and records the
    # file in an update run; "" when it matches or was recorded, else why
    # not (r-std-testing.runner.snapshot-check).
    fn snapshot_check(mut self, text: string) -> string
    # The absolute path of the run's temporary directory, made on the run's
    # first call (r-std-testing.runner.temp-dir).
    fn temp_dir(mut self) -> string

# What a property runner's `start` returns for one case
# (r-std-testing.runner.case-type).
pub data PropertyCase:
    pub example: usize?
    pub seed: i64
    pub size: i32
    pub replay: List[i64]

# The property runner records and shrinks each case's draws
# (src/property-tests.ts); `Choices` replays them.
pub trait PropertyRunner:
    # Reports the caps and the example count, and returns the case to run
    # (r-std-testing.runner.start-case). Once every example has run, the
    # runner ends the case as discarded instead
    # (r-std-testing.runner.examples-done).
    fn start(mut self, cases: usize, shrink: usize, examples: usize) -> PropertyCase
    # Records the case's next draw, a value from 0 to that draw's bound
    # (r-std-testing.runner.record).
    fn record(mut self, value: i64) -> void
    # The `Debug` text of the case's input, for the failure report.
    fn show(mut self, text: string) -> void

# The only source of randomness a generator sees
# (spec/std/testing.md#property-tests). `std.testing` creates each one from
# the case's `PropertyCase` (r-std-testing.choices.from-case). Every member
# draws an integer from 0 to a bound: the draw at position `i` replays
# `replay[i]`, limited to the bound, and every other draw is fresh, from a
# `SeededRandom` that the case's seed starts (r-std-testing.runner.replay,
# r-std-testing.runner.random). Each draw is recorded through the case's
# `PropertyRunner` before it is used (r-std-testing.runner.record-every), so
# the runner can replay and shrink the case. Once a case's draws have spent
# the draw budget, every member returns its simplest value without drawing
# (spec/std/testing.md#draw-budget). The fresh draws of the first generated
# cases take edge values (spec/std/testing.md#edge-values).
pub data Choices:
    runner: mut PropertyRunner
    random: mut Random
    size: i32
    replay: List[i64]
    draws: usize
    # The edge the case's fresh draws take: 0 low, 1 high, 2 zero, 3 none
    # (r-std-testing.edge.plan).
    edge: i64

impl Choices:
    # Whether the draw budget of 256 draws is spent. No public member reads
    # it (r-std-testing.budget.no-api).
    fn spent(self) -> bool:
        self.draws >= 256

    # One recorded draw from 0 to `bound`: the replayed draw at this
    # position, limited to `bound`, else a fresh one. A shrunk draw moves
    # toward 0.
    fn next(mut self, bound: i64) -> i64:
        self.next_edge(bound, 0, self.reach_cap(bound), -1)

    # `next` with the draws that an edge case takes: `low`, `high`, and
    # `zero` are the values of a low, a high, and a zero edge, or -1 for a
    # draw that has none (r-std-testing.edge.plan).
    fn next_edge(mut self, bound: i64, low: i64, high: i64, zero: i64) -> i64:
        index := self.draws
        self.draws = self.draws + 1
        let value: i64 = 0
        if index < self.replay.len():
            value = self.replay[index]
            if value > bound:
                value = bound
            if value < 0:
                value = 0
        else:
            value = self.fresh(bound, low, high, zero)
        self.runner.record(value)
        value

    # A random draw from 0 to `bound`, at most 2^(3 + size), so draws grow
    # from case to case: 0 one time in ten, the top one time in twenty, and
    # else uniform.
    fn fresh(mut self, bound: i64, low: i64, high: i64, zero: i64) -> i64:
        if self.edge == 0 && low >= 0:
            return low
        if self.edge == 1 && high >= 0:
            return high
        if self.edge == 2 && zero >= 0:
            return zero
        cap := self.reach_cap(bound)
        if cap <= 0:
            return 0
        pick := self.random.next_u64() % 20
        if pick < 2:
            return 0
        if pick == 2:
            return cap
        i64((self.random.next_u64() >> 1) % u64(cap + 1))

    # `bound`, limited to the reach that `size` allows.
    fn reach_cap(self, bound: i64) -> i64:
        let reach: i64 = 4611686018427387904
        if self.size < 59:
            reach = i64(1) << u32(3 + self.size)
        if reach < bound: reach else: bound

    # A recorded draw from `lo` to `hi`. A range wider than `i64` picks a
    # half first.
    # Callers pass `lo <= hi`, so `hi - lo` overflows only when `lo` is
    # negative and `hi` is past the largest `i64` plus `lo`.
    fn between(mut self, lo: i64, hi: i64) -> i64:
        let largest: i64 = 9223372036854775807
        if lo >= 0 || hi <= largest + lo:
            # The edge draws are `lo`, `hi`, and 0 when it lies between them.
            zero := if lo <= 0 && hi >= 0 && lo > -largest: -lo else: -1
            return lo + self.next_edge(hi - lo, 0, hi - lo, zero)
        if self.next(1) == 0: self.between(lo, -1) else: self.between(0, hi)

    # An integer from `lo` to `hi`; the simplest is 0, or the bound nearest 0.
    pub fn int[N < Integer](mut self, lo: N, hi: N) -> N:
        if hi <= lo:
            return lo
        zero := N::zero()
        if self.spent():
            return if lo > zero: lo else if hi < zero: hi else: zero
        N::from_i64(self.between(wide(lo), wide(hi)))

    # A finite float from `lo` to `hi`; the simplest is 0.0, or the bound
    # nearest 0.0.
    pub fn float[F < Float](mut self, lo: F, hi: F) -> F:
        if !(lo < hi):
            return lo
        zero := F::zero()
        if self.spent():
            return if lo > zero: lo else if hi < zero: hi else: zero
        steps := F::from_i64(1000000)
        t := F::from_i64(self.next(1000000)) / steps
        value := lo * (F::one() - t) + hi * t
        if value < lo: lo else if value > hi: hi else: value

    pub fn bool(mut self) -> bool:
        if self.spent():
            return false
        self.next(1) == 1

    # One of `items`; earlier items shrink first, and the simplest is the first.
    # An empty list panics (r-std-testing.choices.choose.empty).
    pub fn choose[T](mut self, items: List[T]) -> T:
        if items.len() == 0:
            panic("Choices.choose: no items to choose from")
        if self.spent():
            return items[0]
        items[usize(self.next(i64(items.len() - 1)))]

    pub fn list[T](mut self, max: usize, item: fn(mut Choices) -> T) -> List[T]:
        let items: mut List[T] = []
        if self.spent():
            return items
        let count: usize = usize(self.next(i64(max)))
        while items.len() < count:
            items.push(item(self))
        items

    # At most `max` entries, each key drawn before its value. A key drawn
    # again keeps the later value (r-std-testing.choices.map.duplicate).
    pub fn map[K < Eq & Hash, V](mut self, max: usize, key: fn(mut Choices) -> K, value: fn(mut Choices) -> V) -> Map[K, V]:
        let entries: mut Map[K, V] = {}
        if self.spent():
            return entries
        let count: usize = usize(self.next(i64(max)))
        let index: usize = 0
        while index < count:
            drawn := key(self)
            entries[drawn] = value(self)
            index = index + 1
        entries

    # At most `max_chars` chars (r-std-testing.choices.string-limit).
    pub fn string(mut self, max_chars: usize) -> string:
        if self.spent():
            return ""
        letters := ["a", "b", "z", " ", "0", "\u{E9}", "\u{3C0}", "\u{1F600}"]
        let text: string = ""
        let count: usize = usize(self.next(i64(max_chars)))
        let index: usize = 0
        while index < count:
            text = text + self.choose(letters)
            index = index + 1
        text

    # Picks the value a default 32- or 64-bit integer takes: 8 is the type's
    # smallest, 9 its largest, and anything else a small one. A spent budget
    # picks a small one, the simplest (r-std-testing.edge.int-type).
    fn extreme(mut self) -> i64:
        if self.spent():
            return 0
        self.next_edge(9, 8, 9, 0)

    # A false `ok` discards the case with the discard panic, which the
    # runner reads as a discard before `show`
    # (r-std-testing.runner.discard-panic).
    pub fn assume(mut self, ok: bool) -> void:
        if !ok:
            panic("std.testing: case discarded")

    pub fn draw[T < Arbitrary](mut self) -> T:
        T::arbitrary(self)

    # `list` and `map` with each item drawn by its type's `Arbitrary`. The
    # prototype cannot pass a bound through a function value.
    fn list_of[T < Arbitrary](mut self, max: usize) -> List[T]:
        let items: mut List[T] = []
        if self.spent():
            return items
        let count: usize = usize(self.next(i64(max)))
        while items.len() < count:
            items.push(T::arbitrary(self))
        items

    fn map_of[K < Arbitrary & Eq & Hash, V < Arbitrary](mut self, max: usize) -> Map[K, V]:
        let entries: mut Map[K, V] = {}
        if self.spent():
            return entries
        let count: usize = usize(self.next(i64(max)))
        let index: usize = 0
        while index < count:
            drawn := K::arbitrary(self)
            entries[drawn] = V::arbitrary(self)
            index = index + 1
        entries

# The `i64` value of an integer. A `u64` above the largest `i64` reads as
# the largest `i64`, so the prototype never draws it.
fn wide[N < Integer](n: N) -> i64:
    match parse_i64(n.to_string()):
        .Ok(value) => value
        .Err(_) => 9223372036854775807

# A type's default generator (spec/std/testing.md#property-tests).
pub trait Arbitrary:
    fn arbitrary(c: mut Choices) -> Self

# Derived `Arbitrary` (spec/std/testing.md#derived-arbitrary). The template
# builds the value through an `ArbitrarySource`, which draws each member
# with its `arbitrary.with` generator, or else with its type's `Arbitrary`.
# The typed-derivation pass instantiates it with the `Source`
# implementation below; the prototype joins neither into a program by
# itself, because they name `std.structure` (checker/typed-derivation.ts).
impl[T] Arbitrary for T by Structure:
    fn arbitrary(c: mut Choices) -> T:
        let s: mut ArbitrarySource[T] = ArbitrarySource::[T] { c: c, at: 0 }
        match T::build(s):
            .Ok(value) => value
            # No variant is finite (r-std-testing.arbitrary.derive.no-finite.message).
            .Err(_) => panic("${T::name()} has no finite value")

# The fields are public because the prototype checks the instantiated
# `Source` implementation in the target's module.
data ArbitrarySource[S]:
    pub c: mut Choices
    pub at: usize

# The one way an `ArbitrarySource` fails: every variant is recursive.
data NoFiniteValue: pass

impl[S] Source[S] for ArbitrarySource[S]:
    type Error = NoFiniteValue

    # The simplest choice is the first variant whose `self_ref` is not
    # `.Required`; the others follow in declaration order, and the drawn
    # index picks one, so a spent draw budget picks the simplest
    # (r-std-testing.arbitrary.derive.simplest). With no such variant the
    # type has no finite value (r-std-testing.arbitrary.derive.no-finite,
    # .no-finite.data).
    fn variant(mut self, choices: List[Variant[S]]) -> Result[Variant[S], NoFiniteValue]:
        let simplest = -1
        for v in choices:
            if simplest < 0:
                match v.info.self_ref:
                    .Required => pass
                    _ => simplest = v.info.index
        if simplest < 0:
            return .Err(NoFiniteValue {})
        let ordered: mut List[Variant[S]] = [choices[usize(simplest)]]
        for v in choices:
            if v.info.index != simplest:
                ordered.push(v)
        if ordered.len() == 1:
            return .Ok(ordered[0])
        .Ok(ordered[self.c.int(0, ordered.len() - 1)])

    # The members in declaration order, each once.
    fn next(mut self, members: Members[S]) -> Result[Key[S], NoFiniteValue]:
        if self.at >= members.infos.len():
            return .Ok(members.end())
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    # Every member implements `Arbitrary`, tuned or not
    # (r-std-testing.arbitrary.derive.member-bound). A tuned member draws
    # with the generator of its typed `With[F]` fact, read through the
    # handle (r-std-testing.arbitrary.with.typed-read).
    fn member[F < Arbitrary](mut self, h: Field[S, F], previous: F?) -> Result[F, NoFiniteValue]:
        match h.fact::[With[F]]():
            .None => .Ok(F::arbitrary(self.c))
            .Some(tuned) => .Ok((tuned.gen)(self.c))

    fn missing[F](mut self, h: Field[S, F]) -> Result[F, NoFiniteValue]:
        panic("an arbitrary source names every member")

# `std` implements `Arbitrary` for the primitives, `string`, `List`, `Map`,
# `T?`, `Result`, and pairs and triples (r-std-testing.arbitrary.std).
# The 32- and 64-bit integers draw from -1000 to 1000, or 0 to 1000, and
# now and then the smallest or the largest value of the type
# (r-std-testing.edge.int-type).
impl Arbitrary for i8:
    fn arbitrary(c: mut Choices) -> i8: c.int(-128, 127)

impl Arbitrary for i16:
    fn arbitrary(c: mut Choices) -> i16: c.int(-32768, 32767)

impl Arbitrary for i32:
    fn arbitrary(c: mut Choices) -> i32:
        match c.extreme():
            8 => -2147483648
            9 => 2147483647
            _ => c.int(-1000, 1000)

impl Arbitrary for i64:
    fn arbitrary(c: mut Choices) -> i64:
        match c.extreme():
            8 => -9223372036854775807 - 1
            9 => 9223372036854775807
            _ => c.int(-1000, 1000)

impl Arbitrary for u8:
    fn arbitrary(c: mut Choices) -> u8: c.int(0, 255)

impl Arbitrary for u16:
    fn arbitrary(c: mut Choices) -> u16: c.int(0, 65535)

impl Arbitrary for u32:
    fn arbitrary(c: mut Choices) -> u32:
        match c.extreme():
            8 => 0
            9 => 4294967295
            _ => c.int(0, 1000)

impl Arbitrary for u64:
    fn arbitrary(c: mut Choices) -> u64:
        match c.extreme():
            8 => 0
            9 => 18446744073709551615
            _ => c.int(0, 1000)

# Any `f64`, NaN, both infinities, -0.0, and subnormals included
# (r-std-testing.arbitrary.float). The simplest is 0.0.
impl Arbitrary for f64:
    fn arbitrary(c: mut Choices) -> f64:
        let zero: f64 = 0.0
        match c.int(0, 9):
            5 => zero / zero
            6 => if c.bool(): -1.0 / zero else: 1.0 / zero
            7 => zero * -1.0
            8 => f64(c.int(1, 1000000)) * 4.9406564584124654e-324
            9 => c.float(-1.0, 1.0) * 1.7976931348623157e308
            _ => c.float(-1000.0, 1000.0)

impl Arbitrary for f32:
    fn arbitrary(c: mut Choices) -> f32:
        let zero: f32 = 0.0
        let tiny: f32 = 1.4e-45
        let huge: f32 = 3.4028235e38
        let low: f32 = -1000.0
        let high: f32 = 1000.0
        let unit: f32 = 1.0
        match c.int(0, 9):
            5 => zero / zero
            6 => if c.bool(): -unit / zero else: unit / zero
            7 => zero * -unit
            8 => f32(c.int(1, 1000)) * tiny
            9 => c.float(-unit, unit) * huge
            _ => c.float(low, high)

impl Arbitrary for bool:
    fn arbitrary(c: mut Choices) -> bool: c.bool()

impl Arbitrary for char:
    fn arbitrary(c: mut Choices) -> char: c.choose(['a', 'b', 'z', ' ', '0', '\u{E9}', '\u{3C0}', '\u{1F600}'])

impl Arbitrary for string:
    fn arbitrary(c: mut Choices) -> string: c.string(16)

impl[T < Arbitrary] Arbitrary for List[T]:
    fn arbitrary(c: mut Choices) -> List[T]:
        c.list_of::[T](8)

impl[K < Arbitrary & Eq & Hash, V < Arbitrary] Arbitrary for Map[K, V]:
    fn arbitrary(c: mut Choices) -> Map[K, V]:
        c.map_of::[K, V](8)

# The simplest is `.None` (r-std-testing.budget.simplest.optional).
impl[T < Arbitrary] Arbitrary for T?:
    fn arbitrary(c: mut Choices) -> T?:
        if c.bool(): .Some(T::arbitrary(c)) else: .None

# The simplest is `.Ok` of `T`'s simplest (r-std-testing.budget.simplest.result).
impl[T < Arbitrary, E < Arbitrary] Arbitrary for Result[T, E]:
    fn arbitrary(c: mut Choices) -> Result[T, E]:
        if c.bool(): .Err(E::arbitrary(c)) else: .Ok(T::arbitrary(c))

impl[A < Arbitrary, B < Arbitrary] Arbitrary for (A, B):
    fn arbitrary(c: mut Choices) -> (A, B):
        (A::arbitrary(c), B::arbitrary(c))

impl[A < Arbitrary, B < Arbitrary, C < Arbitrary] Arbitrary for (A, B, C):
    fn arbitrary(c: mut Choices) -> (A, B, C):
        (A::arbitrary(c), B::arbitrary(c), C::arbitrary(c))

# The body of an `it_each` test case (spec/std/testing.md#table-test-rows).
# The runner calls the one test function once per row, each in a fresh
# instance: the function reports the row count to the runner's
# `TestRunner`, which returns the row it selected, and runs `body` with that
# row. With no rows, row 0 panics with `index-out-of-bounds` after the
# runner heard count 0, which it reads as an empty table
# (src/test-runner.ts).
fn each_case![T, R, $Q](rows: List[T], body: fn!(T) -> R $ Q) -> R $ Q + TestRunner:
    index := $.use(TestRunner).row(rows.len())
    body!(rows[index])

# The body of an `it_prop` test case (spec/std/testing.md#property-tests):
# the runner calls it once per generated case, each in a fresh instance
# (src/property-tests.ts). It reports its case and shrink caps and its
# examples to the runner's `PropertyRunner`, takes the example the case
# names or draws the input with `T`'s `Arbitrary` from a fresh `Choices`,
# shows the input's `Debug` text, and runs `prop`
# (r-std-testing.runner.show-before-body).
fn prop_case![T < Arbitrary & Debug, R, $Q](cases: usize, shrink: usize, prop: fn!(T) -> R $ Q, examples: List[T] = []) -> R $ Q + PropertyRunner:
    let mut runner = $.use(PropertyRunner)
    current := runner.start(cases, shrink, examples.len())
    value := match current.example:
        .Some(index) => examples[index]
        .None => choices(runner, current).draw::[T]()
    runner.show(debug(value))
    prop!(value)

# The same for `it_prop_with`, which draws the input with `gen`.
fn prop_with_case![T < Debug, R, $Q](cases: usize, shrink: usize, gen: fn(mut Choices) -> T, prop: fn!(T) -> R $ Q, examples: List[T] = []) -> R $ Q + PropertyRunner:
    let mut runner = $.use(PropertyRunner)
    current := runner.start(cases, shrink, examples.len())
    value := match current.example:
        .Some(index) => examples[index]
        .None => gen(choices(runner, current))
    runner.show(debug(value))
    prop!(value)

# A fresh `Choices` for one generated case, from the `PropertyCase` that
# `start` returned. It holds the runner's provider value, so a generator
# records its draws through it with no requirement row
# (r-std-testing.runner.choices).
fn choices(runner: mut PropertyRunner, current: PropertyCase) -> mut Choices:
    Choices { runner: runner, random: SeededRandom::new(u64(current.seed)), size: current.size, replay: current.replay, draws: 0, edge: edge_plan(current.seed, current.size) }

# The edge of a generated case (r-std-testing.edge.plan): the first four
# cases, those of `size` 0 to 3, take the edge that their seed picks, so
# four consecutive seeds take all three edges and one ordinary case. A
# later case takes none.
fn edge_plan(seed: i64, size: i32) -> i64:
    if size >= 4:
        return 3
    (seed % 4 + 4) % 4

# The body of a timed `it` test case, after `case_timeout`: the written
# body as a closure, so the runner's `TestRunner` covers only the test
# function around it (spec/std/testing.md#runner-capabilities).
fn run_case![R, $Q](body: fn!() -> R $ Q) -> R $ Q:
    body!()

# A test case's `timeout` option, which its test function evaluates first
# (spec/std/testing.md#r-std-testing.option.timeout-at-run). The runner
# fails a body that runs longer (src/test-runner.ts).
fn case_timeout(limit: Duration) -> void $ TestRunner:
    $.use(TestRunner).report_timeout(limit.as_milliseconds())

# A false `condition` is a failed assertion, a checked runtime panic
# (spec/lang/10-modules.md#r-module.testing.assert-panic) that shows
# `reason` (spec/lang/10-modules.md#r-module.testing.shows-reason).
pub fn assert(condition: bool, reason: string) -> void:
    if !condition:
        panic_with("assertion-failed", reason)

# What a checked `assert_equal` or `snapshot` call runs, with `T` the
# readonly type of `actual`; the compiler checks the call itself. A failure
# shows the reason and both values as `debug` renders them
# (spec/lang/10-modules.md#r-module.testing.assert-equal-debug).
fn check_equal[T < Eq & Debug](actual: T, expected: T, reason: string) -> void:
    if actual != expected:
        panic_with("assertion-failed", "${reason}: actual ${debug(actual)}, expected ${debug(expected)}")

# The checked runtime panic of `category`, such as `assertion-failed`,
# showing `message`, or no message when it is empty; it does not return.
@intrinsic("panic")
fn panic_with(category: string, message: string) -> void:
    panic("intrinsic")

# `snapshot_file(text)` (spec/std/testing.md#snapshot-files) compares `text` with
# the file the runner names from the running test case,
# `<package root>/__snapshots__/<module>/<test-slug>-<n>.snap`. The host
# reads, and on `hd test --update` writes, the file, and returns why it
# differs, or "" when it matches. A missing file fails except on `--update`.
# A mismatch or a missing file is a failed assertion (Testing T54), so it
# panics with `assertion-failed`, as `assert_equal` does. The check runs on
# the `TestRunner` provider that covers the call
# (r-std-testing.snapshot-file.runner).
pub fn snapshot_file(text: string) -> void $ TestRunner:
    problem := $.use(TestRunner).snapshot_check(text)
    assert(problem == "", problem)

# What `hd_run!` returns (spec/std/testing.md#running-executables).
pub data RunOutput:
    pub stdout: string
    pub stderr: string
    pub status: i32

# Runs the package's executable or task `name` through the `Process`
# provider that `hd test` binds for an integration test
# (r-std-testing.hd-run.row, r-std-testing.hd-run.task). A name that names
# neither panics (r-std-testing.hd-run.unknown-name), and so
# does one that does not start (r-std-testing.hd-run.start-failure). The
# integration-only check (r-std-testing.hd-run.integration-only) is not
# implemented yet (src/KNOWN_ISSUES.md).
pub fn hd_run!(name: string, args: List[string] = [], stdin: string = "") -> RunOutput $ Process:
    match $.use(Process).run!(name, args, stdin):
        .Ok(output) => RunOutput { stdout: output.stdout, stderr: output.stderr, status: output.status }
        .Err(.NotFound) => panic("hd_run!: the package has no executable or task named '${name}'")
        .Err(error) => panic("hd_run!: '${name}' did not start: ${error}")

# The running test case's own temporary directory, which the runner
# removes once the run ends (spec/std/testing.md#temporary-directories).
pub fn temp_dir() -> Path $ TestRunner:
    Path($.use(TestRunner).temp_dir())

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for PropertyCase:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("PropertyCase").field("example", self.example).field("seed", self.seed).field("size", self.size).field("replay", self.replay).finish()

impl Debug for RunOutput:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("RunOutput").field("stdout", self.stdout).field("stderr", self.stderr).field("status", self.status).finish()
