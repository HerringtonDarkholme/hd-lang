# std.iter: the prelude `Iterator[T]` with its adapters, `FromIterator` and
# its implementations, and the `Iterable` implementations of `List` and
# `Map`. The range types and their `Iterable` implementations
# (spec/lang/06-control-flow.md#range-iteration) are in `std.ops`.
# `Iterator` and `Iterable` are prelude
# names.
#
# `Iterator[T]` is a data type whose private `step` closure yields the next
# item (spec/lang/06-control-flow.md#iteration-protocols), and the adapters are
# its ordinary methods (spec/std/iter.md#iterator-adapters). `filter`,
# `take`, `enumerate`, and `map` return a lazy iterator that pulls from
# `self` only when its own `next` is called; `fold` and `collect` drain
# `self`.
#
# Prototype: the compiler builds `list.iter()` and `map.iter()` as
# `Iterator::from_fn` over its built-in cursor, which keeps the iterator
# invalidation checks, and a `for` loop over a list or map uses that cursor
# directly.

pub data Iterator[T]:
    step: fn() -> T?

impl[T] Iterator[T]:
    pub fn from_fn(step: fn() -> T?) -> mut Iterator[T]:
        Iterator::[T] { step: step }

    pub fn next(mut self) -> T?:
        (self.step)()

    pub fn filter(mut self, keep: fn(T) -> bool) -> mut Iterator[T]:
        Iterator::from_fn(fn() -> T?:
            while true:
                match self.next():
                    .Some(item) =>
                        if keep(item):
                            return .Some(item)
                    .None => return .None
            .None
        )

    pub fn take(mut self, count: i32) -> mut Iterator[T]:
        if count < 0:
            panic("take: count must not be negative")
        let left = count
        Iterator::from_fn(fn() -> T?:
            if left <= 0:
                return .None
            left = left - 1
            self.next()
        )

    pub fn enumerate(mut self) -> mut Iterator[(i32, T)]:
        let index = 0
        Iterator::from_fn(fn() -> (i32, T)?:
            match self.next():
                .Some(item) =>
                    let numbered = (index, item)
                    index = index + 1
                    .Some(numbered)
                .None => .None
        )

    pub fn map[U](mut self, transform: fn(T) -> U) -> mut Iterator[U]:
        Iterator::from_fn(fn() -> U?:
            match self.next():
                .Some(item) => .Some(transform(item))
                .None => .None
        )

    # Skips the first `count` items on its own first `next` call.
    pub fn skip(mut self, count: i32) -> mut Iterator[T]:
        if count < 0:
            panic("skip: count must not be negative")
        let left = count
        Iterator::from_fn(fn() -> T?:
            while left > 0:
                left = left - 1
                match self.next():
                    .Some(_) => pass
                    .None => return .None
            self.next()
        )

    # The items while `keep` holds; the first item it rejects is consumed
    # and dropped, and no item after it is read.
    pub fn take_while(mut self, keep: fn(T) -> bool) -> mut Iterator[T]:
        let open = true
        Iterator::from_fn(fn() -> T?:
            if !open:
                return .None
            match self.next():
                .Some(item) =>
                    if keep(item):
                        return .Some(item)
                    open = false
                    .None
                .None => .None
        )

    # Pairs by position. It calls `other.iter()` once, when `zip` is
    # called. It pulls `self` first and stops when either ends, so `other`
    # is not read past the end of `self`.
    pub fn zip[U, I < Iterable[U]](mut self, other: I) -> mut Iterator[(T, U)]:
        let mut rest = other.iter()
        Iterator::from_fn(fn() -> (T, U)?:
            match self.next():
                .Some(left) =>
                    match rest.next():
                        .Some(right) => .Some((left, right))
                        .None => .None
                .None => .None
        )

    # The items of `self`, then those of `other`. It calls `other.iter()`
    # once, when `chain` is called.
    pub fn chain[I < Iterable[T]](mut self, other: I) -> mut Iterator[T]:
        let mut rest = other.iter()
        let first = true
        Iterator::from_fn(fn() -> T?:
            if first:
                match self.next():
                    .Some(item) => return .Some(item)
                    .None => first = false
            rest.next()
        )

    # The items of each list `transform` returns, in order.
    pub fn flat_map[U](mut self, transform: fn(T) -> List[U]) -> mut Iterator[U]:
        let part: List[U] = []
        let at = 0
        Iterator::from_fn(fn() -> U?:
            while at >= part.len():
                match self.next():
                    .Some(item) =>
                        part = transform(item)
                        at = 0
                    .None => return .None
            at = at + 1
            .Some(part[at - 1])
        )

    # Stops at the first item that passes, leaving the rest unread.
    pub fn any(mut self, test: fn(T) -> bool) -> bool:
        while true:
            match self.next():
                .Some(item) =>
                    if test(item):
                        return true
                .None => break
        false

    # Stops at the first item that fails, leaving the rest unread.
    pub fn all(mut self, test: fn(T) -> bool) -> bool:
        while true:
            match self.next():
                .Some(item) =>
                    if !test(item):
                        return false
                .None => break
        true

    # The first item that passes, leaving the rest unread.
    pub fn find(mut self, test: fn(T) -> bool) -> T?:
        while true:
            match self.next():
                .Some(item) =>
                    if test(item):
                        return .Some(item)
                .None => break
        .None

    # The number of remaining items; it drains `self`.
    pub fn count(mut self) -> i32:
        let found = 0
        while true:
            match self.next():
                .Some(_) => found = found + 1
                .None => break
        found

    pub fn fold[A, $R](mut self, initial: A, step: fn(A, T) -> A $ R) -> A $ R:
        let total = initial
        while true:
            match self.next():
                .Some(item) => total = step(total, item)
                .None => break
        total

    # The target is solved from the expected type or an explicit type
    # argument, and is `List[T]` when nothing determines it
    # (spec/std/iter.md#collect-targets).
    pub fn collect[C < FromIterator[T] = List[T]](mut self) -> C:
        C::from_iter(self)

# A collection built from the items of an iterator. It is not a prelude name.
pub trait FromIterator[T]:
    fn from_iter(items: mut Iterator[T]) -> Self

impl[T] FromIterator[T] for List[T]:
    fn from_iter(items: mut Iterator[T]) -> List[T]:
        let collected: mut List[T] = []
        while true:
            match items.next():
                .Some(item) => collected.push(item)
                .None => break
        collected

# One entry per pair: for an equal key the later value wins, and the key
# keeps its first position (spec/std/iter.md#r-std-iter.collect.map).
impl[K < Eq & Hash, V] FromIterator[(K, V)] for Map[K, V]:
    fn from_iter(items: mut Iterator[(K, V)]) -> Map[K, V]:
        let collected: mut Map[K, V] = {}
        while true:
            match items.next():
                .Some((key, value)) => collected[key] = value
                .None => break
        collected

# `.Ok` of the collection of the `.Ok` payloads, or the first `.Err`, which
# stops the pulling there.
impl[T, E, C < FromIterator[T]] FromIterator[Result[T, E]] for Result[C, E]:
    fn from_iter(items: mut Iterator[Result[T, E]]) -> Result[C, E]:
        let failure: E? = .None
        let mut payloads = Iterator::from_fn(fn() -> T?:
            match items.next():
                .Some(item) =>
                    match item:
                        .Ok(value) => .Some(value)
                        .Err(error) =>
                            failure = .Some(error)
                            .None
                .None => .None
        )
        collected := C::from_iter(payloads)
        match failure:
            .Some(error) => .Err(error)
            .None => .Ok(collected)

# `.Some` of the collection of the `.Some` payloads, or `.None` at the first
# `.None`, which stops the pulling there.
impl[T, C < FromIterator[T]] FromIterator[T?] for C?:
    fn from_iter(items: mut Iterator[T?]) -> C?:
        let missing = false
        let mut payloads = Iterator::from_fn(fn() -> T?:
            match items.next():
                .Some(item) =>
                    match item:
                        .Some(value) => .Some(value)
                        .None =>
                            missing = true
                            .None
                .None => .None
        )
        collected := C::from_iter(payloads)
        if missing: .None else: .Some(collected)

# A value that a `for` loop or a comprehension clause iterates
# (spec/lang/06-control-flow.md#iteration-protocols).
pub trait Iterable[T]:
    fn iter(self) -> mut Iterator[T]

# `Iterator[T]` is not `Iterable[T]`: a loop over a mutable iterator
# advances it directly (spec/lang/06-control-flow.md#r-flow.for.iterator-not-iterable,
# spec/lang/06-control-flow.md#r-flow.for.iterator-direct).

impl[T] Iterable[T] for List[T]:
    fn iter(self) -> mut Iterator[T]:
        self.iter()

impl[K, V] Iterable[(K, V)] for Map[K, V]:
    fn iter(self) -> mut Iterator[(K, V)]:
        self.iter()
