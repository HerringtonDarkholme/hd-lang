# std.iter: user-defined cursors and lazy, named adapter values.
use std.function.Fn
use std.num.Num

## A cursor that yields its next item, or None when exhausted.
pub trait Iterator[T]:
    fn next(&mut self) -> T?

    fn sum[S < Sum[T]](self) -> S:
        S::sum(self)

    fn product[P < Product[T]](self) -> P:
        P::product(self)

    fn by_ref(*mut self) -> ByRef[Self]:
        ByRef { inner: self }

    fn map[U, F < Fn(T) -> U](self, transform: F) -> MapIter[Self, T, U, F]:
        MapIter { source: self, transform: transform }

    fn filter[F < Fn(T) -> bool](self, keep: F) -> Filter[Self, T, F]:
        Filter { source: self, keep: keep }

    fn take(self, count: usize) -> Take[Self, T]:
        Take { source: self, left: count }

    fn enumerate(self) -> Enumerate[Self, T]:
        Enumerate { source: self, index: 0 }

    fn skip(self, count: usize) -> Skip[Self, T]:
        Skip { source: self, left: count }

    fn take_while[F < Fn(T) -> bool](self, keep: F) -> TakeWhile[Self, T, F]:
        TakeWhile { source: self, keep: keep, open: true }

    fn zip[U, J < Iterable[U]](self, other: J) -> Zip[Self, T, U, J]:
        Zip { source: self, rest: other.iter() }

    fn chain[J < Iterable[T]](self, other: J) -> Chain[Self, T, J]:
        Chain { source: self, rest: other.iter(), first: true }

    fn flat_map[U, J < Iterable[U], F < Fn(T) -> J](
        self,
        transform: F,
    ) -> FlatMap[Self, T, U, J, F]:
        FlatMap { source: self, transform: transform, part: .None }

    # Stops at the first item that passes, leaving the rest unread.
    ## True when `test` accepts an item; it stops at the first one.
    ## See [std-iter.adapter.any.value](../../spec/std/iter.md#r-std-iter.adapter.any.value).
    fn any(self, test: fn(T) -> bool) -> bool:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if test(item):
                        return true
                .None => break
        false

    # Stops at the first item that fails, leaving the rest unread.
    ## True when `test` accepts every item; it stops at the first one it rejects.
    ## See [std-iter.adapter.all.value](../../spec/std/iter.md#r-std-iter.adapter.all.value).
    fn all(self, test: fn(T) -> bool) -> bool:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if !test(item):
                        return false
                .None => break
        true

    # The first item that passes, leaving the rest unread.
    ## The first item that `test` accepts, in `.Some`, or `.None`.
    ## See [std-iter.adapter.find.value](../../spec/std/iter.md#r-std-iter.adapter.find.value).
    fn find(self, test: fn(T) -> bool) -> T?:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if test(item):
                        return .Some(item)
                .None => break
        .None

    # The number of remaining items; it drains `self`.
    ## The number of remaining items; it drains the iterator.
    ## See [std-iter.adapter.count.owned-drain](../../spec/std/iter.md#r-std-iter.adapter.count.owned-drain).
    fn count(self) -> usize:
        let mut cursor = self
        let found: usize = 0
        while true:
            match cursor.next():
                .Some(_) => found = found + 1
                .None => break
        found

    ## Folds the remaining items into `initial`: `step(accumulator, item)` per item, in order.
    ## See [std-iter.adapter.fold.value](../../spec/std/iter.md#r-std-iter.adapter.fold.value).
    fn fold[A, $ R](self, initial: A, step: fn(A, T) -> A $ R) -> A $ R:
        let mut cursor = self
        let total = initial
        while true:
            match cursor.next():
                .Some(item) => total = step(total, item)
                .None => break
        total

    # The target is solved from the expected type or an explicit type
    # argument, and is `List[T]` when nothing determines it
    # (spec/std/iter.md#what-collect-builds).
    ## A `C` built from the remaining items of `self`; a list when the target type is not named.
    ## See [std-iter.adapter.collect.value-defaulted](../../spec/std/iter.md#r-std-iter.adapter.collect.value-defaulted).
    fn collect[C < FromIterator[T] = List[T]](self) -> C:
        C::from_iter(self)

## A cursor that borrows another cursor and shares its progress.
pub struct ByRef[I]:
    inner: *mut I

impl[I < Iterator[T], T] Iterator[T] for ByRef[I]:
    fn next(&mut self) -> T?:
        self.inner.next()

## A total built from the items of a cursor.
pub trait Sum[T]:
    fn sum[I < Iterator[T]](items: I) -> Self

impl[T < Num] Sum[T] for T:
    fn sum[I < Iterator[T]](items: I) -> T:
        let mut cursor = items
        let total = T::zero()
        while true:
            match cursor.next():
                .Some(item) => total = total + item
                .None => break
        total

## A product built from the items of a cursor.
pub trait Product[T]:
    fn product[I < Iterator[T]](items: I) -> Self

impl[T < Num] Product[T] for T:
    fn product[I < Iterator[T]](items: I) -> T:
        let mut cursor = items
        let total = T::one()
        while true:
            match cursor.next():
                .Some(item) => total = total * item
                .None => break
        total

impl[T, I < Iterator[T]] Iterator[T] for *mut I:
    fn next(&mut self) -> T?:
        (*self).next()

## A concrete cursor forwarding to an erased iterator reference.
pub struct DynIterator[T]:
    source: *mut dyn Iterator[T]

impl[T] Iterator[T] for DynIterator[T]:
    fn next(&mut self) -> T?:
        self.source.next()

impl[T] dyn Iterator[T]:
    pub fn sum[S < Sum[T]](*mut self) -> S:
        DynIterator { source: self }.sum::[S]()

    pub fn product[P < Product[T]](*mut self) -> P:
        DynIterator { source: self }.product::[P]()

    pub fn by_ref(*mut self) -> DynIterator[T]:
        DynIterator { source: self }

    pub fn map[U, F < Fn(T) -> U](*mut self, transform: F) -> MapIter[DynIterator[T], T, U, F]:
        DynIterator { source: self }.map::[U, F](transform)

    pub fn filter[F < Fn(T) -> bool](*mut self, keep: F) -> Filter[DynIterator[T], T, F]:
        DynIterator { source: self }.filter::[F](keep)

    pub fn take(*mut self, count: usize) -> Take[DynIterator[T], T]:
        DynIterator { source: self }.take(count)

    pub fn enumerate(*mut self) -> Enumerate[DynIterator[T], T]:
        DynIterator { source: self }.enumerate()

    pub fn skip(*mut self, count: usize) -> Skip[DynIterator[T], T]:
        DynIterator { source: self }.skip(count)

    pub fn take_while[F < Fn(T) -> bool](*mut self, keep: F) -> TakeWhile[DynIterator[T], T, F]:
        DynIterator { source: self }.take_while::[F](keep)

    pub fn zip[U, J < Iterable[U]](*mut self, other: J) -> Zip[DynIterator[T], T, U, J]:
        DynIterator { source: self }.zip::[U, J](other)

    pub fn chain[J < Iterable[T]](*mut self, other: J) -> Chain[DynIterator[T], T, J]:
        DynIterator { source: self }.chain::[J](other)

    pub fn flat_map[U, J < Iterable[U], F < Fn(T) -> J](
        *mut self,
        transform: F,
    ) -> FlatMap[DynIterator[T], T, U, J, F]:
        DynIterator { source: self }.flat_map::[U, J, F](transform)

    pub fn any(*mut self, test: fn(T) -> bool) -> bool:
        DynIterator { source: self }.any(test)

    pub fn all(*mut self, test: fn(T) -> bool) -> bool:
        DynIterator { source: self }.all(test)

    pub fn find(*mut self, test: fn(T) -> bool) -> T?:
        DynIterator { source: self }.find(test)

    pub fn count(*mut self) -> usize:
        DynIterator { source: self }.count()

    pub fn fold[A, $ R](*mut self, initial: A, step: fn(A, T) -> A $ R) -> A $ R:
        DynIterator { source: self }.fold::[A](initial, step)

    pub fn collect[C < FromIterator[T] = List[T]](*mut self) -> C:
        DynIterator { source: self }.collect::[C]()

pub struct FromFn[T, F < Fn() -> T? = fn() -> T?]:
    step: F

pub fn from_fn[T, F < Fn() -> T?](step: F) -> FromFn[T, F]:
    FromFn { step: step }

impl[T, F < Fn() -> T?] Iterator[T] for FromFn[T, F]:
    fn next(&mut self) -> T?:
        (self.step)()

pub struct MapIter[I < Iterator[T], T, U, F < Fn(T) -> U = fn(T) -> U]:
    source: I
    transform: F

impl[I < Iterator[T], T, U, F < Fn(T) -> U] Iterator[U] for MapIter[I, T, U, F]:
    fn next(&mut self) -> U?:
        match self.source.next():
            .Some(item) => .Some((self.transform)(item))
            .None => .None

pub struct Filter[I < Iterator[T], T, F < Fn(T) -> bool = fn(T) -> bool]:
    source: I
    keep: F

impl[I < Iterator[T], T, F < Fn(T) -> bool] Iterator[T] for Filter[I, T, F]:
    fn next(&mut self) -> T?:
        while true:
            item := match self.source.next():
                .Some(found) => found
                .None => return .None
            if (self.keep)(item):
                return .Some(item)

pub struct Take[I < Iterator[T], T]:
    source: I
    left: usize

impl[I < Iterator[T], T] Iterator[T] for Take[I, T]:
    fn next(&mut self) -> T?:
        if self.left == 0:
            return .None
        self.left -= 1
        self.source.next()

pub struct Enumerate[I < Iterator[T], T]:
    source: I
    index: usize

impl[I < Iterator[T], T] Iterator[(usize, T)] for Enumerate[I, T]:
    fn next(&mut self) -> (usize, T)?:
        match self.source.next():
            .Some(item) =>
                pair := (self.index, item)
                self.index += 1
                .Some(pair)
            .None => .None

pub struct Skip[I < Iterator[T], T]:
    source: I
    left: usize

impl[I < Iterator[T], T] Iterator[T] for Skip[I, T]:
    fn next(&mut self) -> T?:
        while self.left > 0:
            self.left -= 1
            match self.source.next():
                .Some(_) => pass
                .None => return .None
        self.source.next()

pub struct TakeWhile[I < Iterator[T], T, F < Fn(T) -> bool = fn(T) -> bool]:
    source: I
    keep: F
    open: bool

impl[I < Iterator[T], T, F < Fn(T) -> bool] Iterator[T] for TakeWhile[I, T, F]:
    fn next(&mut self) -> T?:
        if !self.open:
            return .None
        match self.source.next():
            .Some(item) =>
                if (self.keep)(item):
                    return .Some(item)
                self.open = false
                .None
            .None => .None

pub struct Zip[I < Iterator[T], T, U, J < Iterable[U]]:
    source: I
    rest: J::IntoIter

impl[I < Iterator[T], T, U, J < Iterable[U]] Iterator[(T, U)] for Zip[I, T, U, J]:
    fn next(&mut self) -> (T, U)?:
        match self.source.next():
            .Some(left) =>
                match self.rest.next():
                    .Some(right) => .Some((left, right))
                    .None => .None
            .None => .None

pub struct Chain[I < Iterator[T], T, J < Iterable[T]]:
    source: I
    rest: J::IntoIter
    first: bool

impl[I < Iterator[T], T, J < Iterable[T]] Iterator[T] for Chain[I, T, J]:
    fn next(&mut self) -> T?:
        if self.first:
            match self.source.next():
                .Some(item) => return .Some(item)
                .None => self.first = false
        self.rest.next()

pub struct FlatMap[I < Iterator[T], T, U, J < Iterable[U], F < Fn(T) -> J = fn(T) -> J]:
    source: I
    transform: F
    part: J::IntoIter?

impl[I < Iterator[T], T, U, J < Iterable[U], F < Fn(T) -> J] Iterator[U] for FlatMap[I, T, U, J, F]:
    fn next(&mut self) -> U?:
        while true:
            match self.part:
                .Some(cursor) =>
                    let mut inner = cursor
                    found := inner.next()
                    self.part = if found.is_some(): .Some(inner) else: .None
                    if found.is_some():
                        return found
                .None => pass
            item := match self.source.next():
                .Some(found) => found
                .None => return .None
            self.part = .Some((self.transform)(item).iter())

# A collection built from the items of an iterator. It is not a prelude name.
## What `collect` builds: a target that gathers items of `T`.
## See [std-iter.collect.generic-owned-cursor](../../spec/std/iter.md#r-std-iter.collect.generic-owned-cursor).
pub trait FromIterator[T]:
    fn from_iter[I < Iterator[T]](items: I) -> Self

impl[T] FromIterator[T] for List[T]:
    fn from_iter[I < Iterator[T]](items: I) -> List[T]:
        let mut cursor = items
        let mut collected: List[T] = []
        while true:
            match cursor.next():
                .Some(item) => collected.push(item)
                .None => break
        collected

# One entry per pair: for an equal key the later value wins
# (spec/std/iter.md#r-std-iter.collect.map-last).
impl[K < Eq & Hash, V] FromIterator[(K, V)] for Map[K, V]:
    fn from_iter[I < Iterator[(K, V)]](items: I) -> Map[K, V]:
        let mut cursor = items
        let mut collected: Map[K, V] = {}
        while true:
            match cursor.next():
                .Some((key, value)) => collected[key] = value
                .None => break
        collected

struct ResultItems[I, T, E]:
    source: I
    failure: *mut Option[E]

impl[I < Iterator[Result[T, E]], T, E] Iterator[T] for ResultItems[I, T, E]:
    fn next(&mut self) -> T?:
        match self.source.next():
            .Some(item) =>
                match item:
                    .Ok(value) => .Some(value)
                    .Err(error) =>
                        *self.failure = .Some(error)
                        .None
            .None => .None

impl[T, E < 'static, C < FromIterator[T]] FromIterator[Result[T, E]] for Result[C, E]:
    fn from_iter[I < Iterator[Result[T, E]]](items: I) -> Result[C, E]:
        # Boxed because the adapter stores this flag in a pointer field while `from_iter` runs.
        failure := box::[E?](.None)
        payloads := ResultItems { source: items, failure: failure }
        collected := C::from_iter(payloads)
        match *failure:
            .Some(error) => .Err(error)
            .None => .Ok(collected)

struct OptionItems[I, T]:
    source: I
    missing: *mut bool

impl[I < Iterator[T?], T] Iterator[T] for OptionItems[I, T]:
    fn next(&mut self) -> T?:
        match self.source.next():
            .Some(item) =>
                match item:
                    .Some(value) => .Some(value)
                    .None =>
                        *self.missing = true
                        .None
            .None => .None

impl[T, C < FromIterator[T]] FromIterator[T?] for C?:
    fn from_iter[I < Iterator[T?]](items: I) -> C?:
        # Boxed because the adapter stores this flag in a pointer field while `from_iter` runs.
        missing := box(false)
        payloads := OptionItems { source: items, missing: missing }
        collected := C::from_iter(payloads)
        if *missing: .None else: .Some(collected)

# A value that a `for` loop or a comprehension clause iterates
# (spec/lang/06-control-flow.md#iteration-protocols). Its cursor is the
# concrete type the implementation names, as Rust's `IntoIterator::IntoIter`,
# so iterating it needs no trait value.
## What `for` iterates: a type whose `iter` returns its cursor type `IntoIter`, an iterator of its items.
## See [flow.for.iterable.cursor](../../spec/lang/06-control-flow.md#r-flow.for.iterable.cursor).
pub trait Iterable[T]:
    type IntoIter < Iterator[T]
    fn iter(self) -> Self::IntoIter

# Iterator does not imply Iterable: a loop owns a cursor value copy
# or advances a referenced cursor directly (spec/lang/06-control-flow.md#r-flow.for.iterator.iterable-not-implied,
# spec/lang/06-control-flow.md#r-flow.for.iterator.owned-source).

# A list cursor holds a copy of its list; a map cursor keeps a step
# closure over a copy of its map. Both track their own position and
# iterate the collection as `iter` found it
# (spec/lang/06-control-flow.md#r-flow.for.cursor.snapshot).
# `map_steps(entries)(at)` is the first entry from entry number `at` on,
# with its number, or `.None` past the last.
@intrinsic("map_steps")
fn map_steps[K < Eq & Hash, V](entries: Map[K, V]) -> fn(usize) -> (usize, (K, V))?:
    panic("intrinsic")

## The cursor of a list's `iter`: its elements in order.
## See [std-iter.cursor.list](../../spec/std/iter.md#r-std-iter.cursor.list).
pub struct ListIter[T]:
    items: List[T]
    at: usize

impl[T] Iterator[T] for ListIter[T]:
    fn next(&mut self) -> T?:
        if self.at >= self.items.len():
            return .None
        item := self.items[self.at]
        self.at = self.at + 1
        .Some(item)

## The cursor of a map's `iter`: its `(key, value)` entries in iteration order.
## See [std-iter.cursor.map](../../spec/std/iter.md#r-std-iter.cursor.map).
pub struct MapEntries[K < Eq & Hash, V]:
    step: fn(usize) -> (usize, (K, V))?
    at: usize

impl[K < Eq & Hash, V] Iterator[(K, V)] for MapEntries[K, V]:
    fn next(&mut self) -> (K, V)?:
        match (self.step)(self.at):
            .Some((slot, entry)) =>
                self.at = slot + 1
                .Some(entry)
            .None => .None

impl[T] Iterable[T] for List[T]:
    type IntoIter = ListIter[T]
    fn iter(self) -> ListIter[T]:
        ListIter { items: self, at: 0 }

impl[K < Eq & Hash, V] Iterable[(K, V)] for Map[K, V]:
    type IntoIter = MapEntries[K, V]
    fn iter(self) -> MapEntries[K, V]:
        MapEntries { step: map_steps(self), at: 0 }
