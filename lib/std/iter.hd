use std.collections.UniqList
pub use std.core.{ListIter}
use std.rt.{ByteBuffer, char_width, write_char_sized}

# std.iter: user-defined cursors and lazy, named adapter values.
use std.ops.FnMut
use std.num.Num
use std.cmp.{Ord, Ordering}

## A cursor that yields its next item, or None when exhausted.
pub trait Iterator[T < ?Copy] < ?Copy:
    fn next(&mut self) -> T?

    fn sum[S < Sum[T]](self) -> S:
        S::sum(self)

    fn product[P < Product[T]](self) -> P:
        P::product(self)

    fn by_ref(*mut self) -> ByRef[Self]:
        ByRef { inner: self }

    fn map[U < ?Copy, F < FnMut(T) -> U](self, transform: F) -> MapIter[Self, T, U, F]:
        MapIter { source: self, transform: transform }

    fn filter[F < FnMut(&T) -> bool](self, keep: F) -> Filter[Self, T, F]:
        Filter { source: self, keep: keep }

    ## Lazily yields each present result of `transform`, in source order.
    ## See [std-iter.filter-map.value](../../spec/std/iter.md#r-std-iter.filter-map.value).
    fn filter_map[U < ?Copy, F < ?Copy & FnMut(T) -> U?](
        self,
        transform: F,
    ) -> FilterMap[Self, T, U, F]:
        FilterMap { source: self, transform: transform }

    fn take(self, count: usize) -> Take[Self, T]:
        Take { source: self, left: count }

    fn enumerate(self) -> Enumerate[Self, T]:
        Enumerate { source: self, index: 0 }

    fn skip(self, count: usize) -> Skip[Self, T]:
        Skip { source: self, left: count }

    fn take_while[F < FnMut(&T) -> bool](self, keep: F) -> TakeWhile[Self, T, F]:
        TakeWhile { source: self, keep: keep, open: true }

    fn zip[U < ?Copy, J < ?Copy & Iterable[U]](self, other: J) -> Zip[Self, T, U, J]:
        Zip { source: self, rest: other.iter() }

    fn chain[J < ?Copy & Iterable[T]](self, other: J) -> Chain[Self, T, J]:
        Chain { source: self, rest: other.iter(), first: true, last: true }

    fn flat_map[U < ?Copy, J < ?Copy & Iterable[U], F < FnMut(T) -> J](
        self,
        transform: F,
    ) -> FlatMap[Self, T, U, J, F]:
        FlatMap { source: self, transform: transform, part: .None, back: .None, done: false }

    # Stops at the first item that passes, leaving the rest unread.
    ## True when `test` accepts an item; it stops at the first one.
    ## See [std-iter.adapter.any.fn-mut](../../spec/std/iter.md#r-std-iter.adapter.any.fn-mut).
    fn any[F < ?Copy & FnMut(&T) -> bool](self, mut test: F) -> bool:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if test(&item):
                        return true
                .None => break
        false

    # Stops at the first item that fails, leaving the rest unread.
    ## True when `test` accepts every item; it stops at the first one it rejects.
    ## See [std-iter.adapter.all.fn-mut](../../spec/std/iter.md#r-std-iter.adapter.all.fn-mut).
    fn all[F < ?Copy & FnMut(&T) -> bool](self, mut test: F) -> bool:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if !test(&item):
                        return false
                .None => break
        true

    # The first item that passes, leaving the rest unread.
    ## The first item that `test` accepts, in `.Some`, or `.None`.
    ## See [std-iter.adapter.find.fn-mut](../../spec/std/iter.md#r-std-iter.adapter.find.fn-mut).
    fn find[F < ?Copy & FnMut(&T) -> bool](self, mut test: F) -> T?:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) =>
                    if test(&item):
                        return .Some(item)
                .None => break
        .None

    ## The final remaining item, or `.None` when there is none.
    ## See [std-iter.last.value](../../spec/std/iter.md#r-std-iter.last.value).
    fn last(self) -> T?:
        let mut cursor = self
        let found: T? = .None
        while true:
            match cursor.next():
                .Some(item) => found = .Some(item)
                .None => return found

    ## The first matching item's remaining index; keeps this cursor after that item.
    ## See [std-iter.position.value](../../spec/std/iter.md#r-std-iter.position.value).
    fn position[F < ?Copy & FnMut(T) -> bool $ R, $ R](&mut self, mut test: F) -> usize? $ R:
        let index: usize = 0
        while true:
            match self.next():
                .Some(item) =>
                    if test(item):
                        return .Some(index)
                    index += 1
                .None => return .None

    ## Calls `visit` once for each remaining item, in order.
    ## See [std-iter.for-each.value](../../spec/std/iter.md#r-std-iter.for-each.value).
    fn for_each[F < ?Copy & FnMut(T) -> void $ R, $ R](self, mut visit: F) -> void $ R:
        let mut cursor = self
        while true:
            match cursor.next():
                .Some(item) => visit(item)
                .None => return

    # The number of remaining items; it drains `self`.
    ## The number of remaining items; it drains the iterator.
    ## See [std-iter.adapter.count.owned-drain](../../spec/std/iter.md#r-std-iter.adapter.count.owned-drain).
    fn count(self) -> usize:
        let mut cursor = self
        let found: usize = 0
        while true:
            match cursor.next():
                .Some(_) => found = found + 1
                .None => break
        found

    # The trait's `T` is bounded for these two only (`trait.where.clause`),
    # so an iterator of unordered items stays an `Iterator`.
    ## The smallest remaining item, the first of equal ones, or `.None`; it drains the iterator.
    ## See [std-iter.adapter.min.value](../../spec/std/iter.md#r-std-iter.adapter.min.value).
    fn min(self) -> T? where T < Ord:
        let mut cursor = self
        let best = match cursor.next():
            .Some(item) => item
            .None => return .None
        while true:
            match cursor.next():
                .Some(item) =>
                    match item.cmp(&best):
                        .Less => best = item
                        _ => pass
                .None => break
        .Some(best)

    ## The largest remaining item, the last of equal ones, or `.None`; it drains the iterator.
    ## See [std-iter.adapter.max.value](../../spec/std/iter.md#r-std-iter.adapter.max.value).
    fn max(self) -> T? where T < Ord:
        let mut cursor = self
        let best = match cursor.next():
            .Some(item) => item
            .None => return .None
        while true:
            match cursor.next():
                .Some(item) =>
                    match item.cmp(&best):
                        .Less => pass
                        _ => best = item
                .None => break
        .Some(best)

    ## Folds the remaining items into `initial`: `step(accumulator, item)` per item, in order.
    ## See [std-iter.adapter.fold.fn-mut](../../spec/std/iter.md#r-std-iter.adapter.fold.fn-mut).
    fn fold[A, F < ?Copy & FnMut(A, T) -> A $ R, $ R](self, initial: A, mut step: F) -> A $ R:
        let mut cursor = self
        let total = initial
        while true:
            match cursor.next():
                .Some(item) => total = step(total, item)
                .None => break
        total

    # The target is solved from the expected type or an explicit type
    # argument, and is `List[T]` when nothing determines it
    # (spec/std/iter.md#what-collect-builds).
    ## A `C` built from the remaining items of `self`; the target is named by the expected type or the type argument, as `List[_]`.
    ## See [std-iter.adapter.collect.value-target](../../spec/std/iter.md#r-std-iter.adapter.collect.value-target).
    fn collect[C < ?Copy & FromIterator[T]](self) -> C:
        C::from_iter(self)

## A cursor that borrows another cursor and shares its progress.
pub struct ByRef[I < ?Copy]:
    inner: *mut I

impl[I < ?Copy & Iterator[T], T < ?Copy] Iterator[T] for ByRef[I]:
    fn next(&mut self) -> T?:
        self.inner.next()

## A total built from the items of a cursor.
pub trait Sum[T < ?Copy]:
    fn sum[I < ?Copy & Iterator[T]](items: I) -> Self

impl[T < Num] Sum[T] for T:
    fn sum[I < ?Copy & Iterator[T]](items: I) -> T:
        let mut cursor = items
        let total = T::zero()
        while true:
            match cursor.next():
                .Some(item) => total = total + item
                .None => break
        total

## A product built from the items of a cursor.
pub trait Product[T < ?Copy]:
    fn product[I < ?Copy & Iterator[T]](items: I) -> Self

impl[T < Num] Product[T] for T:
    fn product[I < ?Copy & Iterator[T]](items: I) -> T:
        let mut cursor = items
        let total = T::one()
        while true:
            match cursor.next():
                .Some(item) => total = total * item
                .None => break
        total

impl[T < ?Copy, I < ?Copy & Iterator[T]] Iterator[T] for &mut I:
    fn next(&mut self) -> T?:
        Iterator::[T]::next(*self)

impl[T < ?Copy, I < ?Copy & Iterator[T]] Iterator[T] for *mut I:
    fn next(&mut self) -> T?:
        (*self).next()

## A concrete cursor forwarding to an erased iterator reference.
pub struct DynIterator[T < ?Copy]:
    source: *mut dyn Iterator[T]

impl[T < ?Copy] Iterator[T] for DynIterator[T]:
    fn next(&mut self) -> T?:
        self.source.next()

impl[T < ?Copy] dyn Iterator[T]:
    pub fn sum[S < Sum[T]](*mut self) -> S:
        DynIterator { source: self }.sum::[S]()

    pub fn product[P < Product[T]](*mut self) -> P:
        DynIterator { source: self }.product::[P]()

    pub fn by_ref(*mut self) -> DynIterator[T]:
        DynIterator { source: self }

    pub fn map[U < ?Copy, F < FnMut(T) -> U](
        *mut self,
        transform: F,
    ) -> MapIter[DynIterator[T], T, U, F]:
        DynIterator { source: self }.map::[U, F](transform)

    pub fn filter[F < FnMut(&T) -> bool](*mut self, keep: F) -> Filter[DynIterator[T], T, F]:
        DynIterator { source: self }.filter::[F](keep)

    pub fn filter_map[U < ?Copy, F < ?Copy & FnMut(T) -> U?](
        *mut self,
        transform: F,
    ) -> FilterMap[DynIterator[T], T, U, F]:
        DynIterator { source: self }.filter_map::[U, F](transform)

    pub fn take(*mut self, count: usize) -> Take[DynIterator[T], T]:
        DynIterator { source: self }.take(count)

    pub fn enumerate(*mut self) -> Enumerate[DynIterator[T], T]:
        DynIterator { source: self }.enumerate()

    pub fn skip(*mut self, count: usize) -> Skip[DynIterator[T], T]:
        DynIterator { source: self }.skip(count)

    pub fn take_while[F < FnMut(&T) -> bool](*mut self, keep: F) -> TakeWhile[DynIterator[T], T, F]:
        DynIterator { source: self }.take_while::[F](keep)

    pub fn zip[U < ?Copy, J < ?Copy & Iterable[U]](
        *mut self,
        other: J,
    ) -> Zip[DynIterator[T], T, U, J]:
        DynIterator { source: self }.zip::[U, J](other)

    pub fn chain[J < ?Copy & Iterable[T]](*mut self, other: J) -> Chain[DynIterator[T], T, J]:
        DynIterator { source: self }.chain::[J](other)

    pub fn flat_map[U < ?Copy, J < ?Copy & Iterable[U], F < FnMut(T) -> J](
        *mut self,
        transform: F,
    ) -> FlatMap[DynIterator[T], T, U, J, F]:
        DynIterator { source: self }.flat_map::[U, J, F](transform)

    pub fn any[F < ?Copy & FnMut(&T) -> bool](*mut self, test: F) -> bool:
        DynIterator { source: self }.any(test)

    pub fn all[F < ?Copy & FnMut(&T) -> bool](*mut self, test: F) -> bool:
        DynIterator { source: self }.all(test)

    pub fn find[F < ?Copy & FnMut(&T) -> bool](*mut self, test: F) -> T?:
        DynIterator { source: self }.find(test)

    pub fn last(*mut self) -> T?:
        DynIterator { source: self }.last()

    pub fn position[F < ?Copy & FnMut(T) -> bool $ R, $ R](*mut self, test: F) -> usize? $ R:
        let mut cursor = DynIterator { source: self }
        cursor.position(test)

    pub fn for_each[F < ?Copy & FnMut(T) -> void $ R, $ R](*mut self, visit: F) -> void $ R:
        DynIterator { source: self }.for_each(visit)

    pub fn count(*mut self) -> usize:
        DynIterator { source: self }.count()

    pub fn fold[A, F < ?Copy & FnMut(A, T) -> A $ R, $ R](*mut self, initial: A, step: F) -> A $ R:
        DynIterator { source: self }.fold::[A, F](initial, step)

    pub fn collect[C < ?Copy & FromIterator[T]](*mut self) -> C:
        DynIterator { source: self }.collect::[C]()

pub struct FromFn[T < ?Copy, F < FnMut() -> T? = fn() -> T?]:
    step: F

pub fn from_fn[T < ?Copy, F < FnMut() -> T?](step: F) -> FromFn[T, F]:
    FromFn { step: step }

impl[T < ?Copy, F < FnMut() -> T?] Iterator[T] for FromFn[T, F]:
    fn next(&mut self) -> T?:
        (self.step)()

pub struct MapIter[I < ?Copy & Iterator[T], T < ?Copy, U < ?Copy, F < FnMut(T) -> U = fn(T) -> U]:
    source: I
    transform: F

impl[I < ?Copy & Iterator[T], T < ?Copy, U < ?Copy, F < FnMut(T) -> U] Iterator[U] for MapIter[
    I,
    T,
    U,
    F,
]:
    fn next(&mut self) -> U?:
        match self.source.next():
            .Some(item) => .Some((self.transform)(item))
            .None => .None

## A lazy cursor yielding the present results of a value-consuming callback.
pub struct FilterMap[
    I < ?Copy & Iterator[T],
    T < ?Copy,
    U < ?Copy,
    F < ?Copy & FnMut(T) -> U? = fn(T) -> U?,
]:
    source: I
    transform: F

impl[I < ?Copy & Iterator[T], T < ?Copy, U < ?Copy, F < ?Copy & FnMut(T) -> U?] Iterator[
    U,
] for FilterMap[I, T, U, F]:
    fn next(&mut self) -> U?:
        while true:
            item := match self.source.next():
                .Some(value) => value
                .None => return .None
            match (self.transform)(item):
                .Some(value) => return .Some(value)
                .None => pass

pub struct Filter[I < ?Copy & Iterator[T], T < ?Copy, F < FnMut(&T) -> bool = fn(&T) -> bool]:
    source: I
    keep: F

impl[I < ?Copy & Iterator[T], T < ?Copy, F < FnMut(&T) -> bool] Iterator[T] for Filter[I, T, F]:
    fn next(&mut self) -> T?:
        while true:
            item := match self.source.next():
                .Some(found) => found
                .None => return .None
            if (self.keep)(&item):
                return .Some(item)

pub struct Take[I < ?Copy & Iterator[T], T < ?Copy]:
    source: I
    left: usize

impl[I < ?Copy & Iterator[T], T < ?Copy] Iterator[T] for Take[I, T]:
    fn next(&mut self) -> T?:
        if self.left == 0:
            return .None
        self.left -= 1
        self.source.next()

pub struct Enumerate[I < ?Copy & Iterator[T], T < ?Copy]:
    source: I
    index: usize

impl[I < ?Copy & Iterator[T], T < ?Copy] Iterator[(usize, T)] for Enumerate[I, T]:
    fn next(&mut self) -> (usize, T)?:
        match self.source.next():
            .Some(item) =>
                pair := (self.index, item)
                self.index += 1
                .Some(pair)
            .None => .None

pub struct Skip[I < ?Copy & Iterator[T], T < ?Copy]:
    source: I
    left: usize

impl[I < ?Copy & Iterator[T], T < ?Copy] Iterator[T] for Skip[I, T]:
    fn next(&mut self) -> T?:
        while self.left > 0:
            self.left -= 1
            match self.source.next():
                .Some(_) => pass
                .None => return .None
        self.source.next()

pub struct TakeWhile[I < ?Copy & Iterator[T], T < ?Copy, F < FnMut(&T) -> bool = fn(&T) -> bool]:
    source: I
    keep: F
    open: bool

impl[I < ?Copy & Iterator[T], T < ?Copy, F < FnMut(&T) -> bool] Iterator[T] for TakeWhile[I, T, F]:
    fn next(&mut self) -> T?:
        if !self.open:
            return .None
        match self.source.next():
            .Some(item) =>
                if (self.keep)(&item):
                    return .Some(item)
                self.open = false
                .None
            .None => .None

pub struct Zip[I < ?Copy & Iterator[T], T < ?Copy, U < ?Copy, J < ?Copy & Iterable[U]]:
    source: I
    rest: J::IntoIter

impl[I < ?Copy & Iterator[T], T < ?Copy, U < ?Copy, J < ?Copy & Iterable[U]] Iterator[
    (T, U),
] for Zip[I, T, U, J]:
    fn next(&mut self) -> (T, U)?:
        match self.source.next():
            .Some(left) =>
                match self.rest.next():
                    .Some(right) => .Some((left, right))
                    .None => .None
            .None => .None

pub struct Chain[I < ?Copy & Iterator[T], T < ?Copy, J < ?Copy & Iterable[T]]:
    source: I
    rest: J::IntoIter
    first: bool
    last: bool

impl[I < ?Copy & Iterator[T], T < ?Copy, J < ?Copy & Iterable[T]] Iterator[T] for Chain[I, T, J]:
    fn next(&mut self) -> T?:
        if self.first:
            match self.source.next():
                .Some(item) => return .Some(item)
                .None => self.first = false
        if self.last: self.rest.next() else: .None

pub struct FlatMap[
    I < ?Copy & Iterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U],
    F < FnMut(T) -> J = fn(T) -> J,
]:
    source: I
    transform: F
    part: J::IntoIter?
    back: J::IntoIter?
    done: bool

impl[
    I < ?Copy & Iterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U],
    F < FnMut(T) -> J,
] Iterator[U] for FlatMap[I, T, U, J, F]:
    fn next(&mut self) -> U?:
        while true:
            front_item := match self.part.as_mut():
                .Some(inner) => inner.next()
                .None => .None
            if front_item.is_some():
                return front_item
            self.part = .None
            if !self.done:
                match self.source.next():
                    .Some(item) =>
                        self.part = .Some((self.transform)(item).iter())
                        continue
                    .None => self.done = true
            back_item := match self.back.as_mut():
                .Some(inner) => inner.next()
                .None => .None
            if back_item.is_none():
                self.back = .None
            return back_item

# A collection built from the items of an iterator. It is not a prelude name.
## What `collect` builds: a target that gathers items of `T`.
## See [std-iter.collect.generic-noncopy-cursor](../../spec/std/iter.md#r-std-iter.collect.generic-noncopy-cursor).
pub trait FromIterator[T < ?Copy] < ?Copy:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> Self

impl[T] FromIterator[T] for List[T]:
    fn from_iter[I < ?Copy & Iterator[T]](items: I) -> List[T]:
        let mut cursor = items
        let mut collected: List[T] = []
        while true:
            match cursor.next():
                .Some(item) => collected.push(item)
                .None => break
        collected

# One entry per pair: for an equal key the later value wins
# (spec/std/iter.md#r-std-iter.collect.map-last).
impl[K < Eq & Hash, V] FromIterator[(K, V)] for Map[K, V]:
    fn from_iter[I < ?Copy & Iterator[(K, V)]](items: I) -> Map[K, V]:
        let mut cursor = items
        let mut collected: Map[K, V] = {}
        while true:
            match cursor.next():
                .Some((key, value)) => collected[key] = value
                .None => break
        collected

struct ResultItems[I < ?Copy & Iterator[Result[T, E]], T < ?Copy, E < ?Copy]:
    source: I
    failure: *mut Option[E]

impl[I < ?Copy & Iterator[Result[T, E]], T < ?Copy, E < ?Copy] Iterator[T] for ResultItems[I, T, E]:
    fn next(&mut self) -> T?:
        match self.source.next():
            .Some(item) =>
                match item:
                    .Ok(value) => .Some(value)
                    .Err(error) =>
                        *self.failure = .Some(error)
                        .None
            .None => .None

impl[T < ?Copy, E < ?Copy & 'static, C < ?Copy & FromIterator[T]] FromIterator[
    Result[T, E],
] for Result[C, E]:
    fn from_iter[I < ?Copy & Iterator[Result[T, E]]](items: I) -> Result[C, E]:
        # Boxed because the adapter stores this flag in a pointer field while `from_iter` runs.
        failure := box::[E?](.None)
        payloads := ResultItems { source: items, failure: failure }
        collected := C::from_iter(payloads)
        match *failure:
            .Some(error) => .Err(error)
            .None => .Ok(collected)

struct OptionItems[I < ?Copy & Iterator[T?], T < ?Copy]:
    source: I
    missing: *mut bool

impl[I < ?Copy & Iterator[T?], T < ?Copy] Iterator[T] for OptionItems[I, T]:
    fn next(&mut self) -> T?:
        match self.source.next():
            .Some(item) =>
                match item:
                    .Some(value) => .Some(value)
                    .None =>
                        *self.missing = true
                        .None
            .None => .None

impl[T < ?Copy, C < ?Copy & FromIterator[T]] FromIterator[T?] for C?:
    fn from_iter[I < ?Copy & Iterator[T?]](items: I) -> C?:
        # Boxed because the adapter stores this flag in a pointer field while `from_iter` runs.
        missing := box(false)
        payloads := OptionItems { source: items, missing: missing }
        collected := C::from_iter(payloads)
        if *missing: .None else: .Some(collected)

# A value that a `for` loop or a comprehension clause iterates
# (spec/lang/06-control-flow.md#iteration-protocols). Its cursor is the
# concrete type the implementation names, as Rust's `IntoIterator::IntoIter`,
# so iterating it needs no trait value.
## What `for` iterates: a type whose `iter` returns its cursor type `IntoIter`, an iterator of its items.
## See [flow.for.iterable.cursor](../../spec/lang/06-control-flow.md#r-flow.for.iterable.cursor).
pub trait Iterable[T < ?Copy] < ?Copy:
    type IntoIter < Iterator[T]
    fn iter(self) -> Self::IntoIter

# Iterator does not imply Iterable: a loop owns a cursor value copy
# or advances a referenced cursor directly (spec/lang/06-control-flow.md#r-flow.for.iterator.iterable-not-implied,
# spec/lang/06-control-flow.md#r-flow.for.iterator.owned-source).

# A list cursor holds a copy of its list; a map cursor keeps a step
# closure over a copy of its map. Both track their own position and
# iterate the collection as `iter` found it
# (spec/lang/06-control-flow.md#r-flow.for.cursor.snapshot).
# `map_steps(entries)(at)` is the first entry from entry number `at` on,
# with its number, or `.None` past the last.
@intrinsic("map_steps")
fn map_steps[K < Eq & Hash, V](entries: Map[K, V]) -> fn(usize) -> (usize, (K, V))?:
    panic("intrinsic")

## The cursor of a map's `iter`: its `(key, value)` entries in iteration order.
## See [std-iter.cursor.map](../../spec/std/iter.md#r-std-iter.cursor.map).
pub struct MapEntries[K < Eq & Hash, V]:
    step: fn(usize) -> (usize, (K, V))?
    at: usize

impl[K < Eq & Hash, V] Iterator[(K, V)] for MapEntries[K, V]:
    fn next(&mut self) -> (K, V)?:
        found := (self.step)(self.at)
        found.map(fn(item: (usize, (K, V))) -> (K, V):
            self.at = item._0 + 1
            item._1
        )

impl[K < Eq & Hash, V] Iterable[(K, V)] for Map[K, V]:
    type IntoIter = MapEntries[K, V]
    fn iter(self) -> MapEntries[K, V]:
        MapEntries { step: map_steps(self), at: 0 }

## A cursor whose front and back share the same remaining sequence.
pub trait DoubleEndedIterator[T < ?Copy] < ?Copy & Iterator[T]:
    fn next_back(&mut self) -> T?

    ## Reverses the remaining sequence without advancing or buffering it.
    fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

## A cursor with a constant-time exact remaining item count.
pub trait ExactSizeIterator[T < ?Copy] < ?Copy & Iterator[T]:
    fn len(&self) -> usize

## A lazy reversal of a double-ended cursor.
pub struct Rev[I < ?Copy, T < ?Copy]:
    source: I

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy] Iterator[T] for Rev[I, T]:
    fn next(&mut self) -> T?:
        self.source.next_back()

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy] DoubleEndedIterator[T] for Rev[I, T]:
    fn next_back(&mut self) -> T?:
        self.source.next()

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] ExactSizeIterator[
    T,
] for Rev[I, T]:
    fn len(&self) -> usize:
        self.source.len()

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy] DoubleEndedIterator[T] for ByRef[I]:
    fn next_back(&mut self) -> T?:
        self.inner.next_back()

impl[I < ?Copy & ExactSizeIterator[T], T < ?Copy] ExactSizeIterator[T] for ByRef[I]:
    fn len(&self) -> usize:
        self.inner.len()

impl[T < ?Copy, I < ?Copy & DoubleEndedIterator[T]] DoubleEndedIterator[T] for &mut I:
    fn next_back(&mut self) -> T?:
        DoubleEndedIterator::[T]::next_back(*self)

impl[T < ?Copy, I < ?Copy & DoubleEndedIterator[T]] DoubleEndedIterator[T] for *mut I:
    fn next_back(&mut self) -> T?:
        (*self).next_back()

impl[T < ?Copy, I < ?Copy & ExactSizeIterator[T]] ExactSizeIterator[T] for &mut I:
    fn len(&self) -> usize:
        ExactSizeIterator::[T]::len(*self)

impl[T < ?Copy, I < ?Copy & ExactSizeIterator[T]] ExactSizeIterator[T] for *mut I:
    fn len(&self) -> usize:
        (*self).len()

pub struct DynDoubleEndedIterator[T < ?Copy]:
    source: *mut dyn DoubleEndedIterator[T]

impl[T < ?Copy] Iterator[T] for DynDoubleEndedIterator[T]:
    fn next(&mut self) -> T?:
        self.source.next()

impl[T < ?Copy] DoubleEndedIterator[T] for DynDoubleEndedIterator[T]:
    fn next_back(&mut self) -> T?:
        self.source.next_back()

impl[T < ?Copy] dyn DoubleEndedIterator[T]:
    pub fn by_ref(*mut self) -> DynDoubleEndedIterator[T]:
        DynDoubleEndedIterator { source: self }

    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(*mut self) -> Rev[DynDoubleEndedIterator[T], T]:
        Rev { source: DynDoubleEndedIterator { source: self } }

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    U < ?Copy,
    F < FnMut(T) -> U,
] DoubleEndedIterator[U] for MapIter[I, T, U, F]:
    fn next_back(&mut self) -> U?:
        match self.source.next_back():
            .Some(item) => .Some((self.transform)(item))
            .None => .None

impl[I < ?Copy & ExactSizeIterator[T], T < ?Copy, U < ?Copy, F < FnMut(T) -> U] ExactSizeIterator[
    U,
] for MapIter[I, T, U, F]:
    fn len(&self) -> usize:
        self.source.len()

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy, F < FnMut(&T) -> bool] DoubleEndedIterator[
    T,
] for Filter[I, T, F]:
    fn next_back(&mut self) -> T?:
        while true:
            item := match self.source.next_back():
                .Some(value) => value
                .None => return .None
            if (self.keep)(&item):
                return .Some(item)

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    U < ?Copy,
    F < ?Copy & FnMut(T) -> U?,
] DoubleEndedIterator[U] for FilterMap[I, T, U, F]:
    fn next_back(&mut self) -> U?:
        while true:
            item := match self.source.next_back():
                .Some(value) => value
                .None => return .None
            match (self.transform)(item):
                .Some(value) => return .Some(value)
                .None => pass

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] DoubleEndedIterator[
    T,
] for Take[I, T]:
    fn next_back(&mut self) -> T?:
        if self.left == 0:
            return .None
        let trim = self.source.len()
        while trim > self.left:
            _ := self.source.next_back()
            trim -= 1
        self.left -= 1
        self.source.next_back()

impl[I < ?Copy & ExactSizeIterator[T], T < ?Copy] ExactSizeIterator[T] for Take[I, T]:
    fn len(&self) -> usize:
        size := self.source.len()
        if size < self.left: size else: self.left

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] DoubleEndedIterator[
    T,
] for Skip[I, T]:
    fn next_back(&mut self) -> T?:
        if self.source.len() <= self.left:
            return .None
        self.source.next_back()

impl[I < ?Copy & ExactSizeIterator[T], T < ?Copy] ExactSizeIterator[T] for Skip[I, T]:
    fn len(&self) -> usize:
        size := self.source.len()
        if size > self.left: size - self.left else: 0

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] DoubleEndedIterator[
    (usize, T),
] for Enumerate[I, T]:
    fn next_back(&mut self) -> (usize, T)?:
        match self.source.next_back():
            .Some(item) => .Some((self.index + self.source.len(), item))
            .None => .None

impl[I < ?Copy & ExactSizeIterator[T], T < ?Copy] ExactSizeIterator[(usize, T)] for Enumerate[I, T]:
    fn len(&self) -> usize:
        self.source.len()

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    J < ?Copy & Iterable[T, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[T],
] DoubleEndedIterator[T] for Chain[I, T, J]:
    fn next_back(&mut self) -> T?:
        if self.last:
            match self.rest.next_back():
                .Some(item) => return .Some(item)
                .None => self.last = false
        if self.first: self.source.next_back() else: .None

impl[
    I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[U] & ExactSizeIterator[U],
] DoubleEndedIterator[(T, U)] for Zip[I, T, U, J]:
    fn next_back(&mut self) -> (T, U)?:
        let left = self.source.len()
        let right = self.rest.len()
        while left > right:
            _ := self.source.next_back()
            left -= 1
        while right > left:
            _ := self.rest.next_back()
            right -= 1
        match (self.source.next_back(), self.rest.next_back()):
            (.Some(a), .Some(b)) => .Some((a, b))
            _ => .None

impl[
    I < ?Copy & ExactSizeIterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U, IntoIter = R],
    R < ?Copy & ExactSizeIterator[U],
] ExactSizeIterator[(T, U)] for Zip[I, T, U, J]:
    fn len(&self) -> usize:
        left := self.source.len()
        right := self.rest.len()
        if left < right: left else: right

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[U],
    F < FnMut(T) -> J,
] DoubleEndedIterator[U] for FlatMap[I, T, U, J, F]:
    fn next_back(&mut self) -> U?:
        while true:
            back_item := match self.back.as_mut():
                .Some(inner) => inner.next_back()
                .None => .None
            if back_item.is_some():
                return back_item
            self.back = .None
            if !self.done:
                match self.source.next_back():
                    .Some(item) =>
                        self.back = .Some((self.transform)(item).iter())
                        continue
                    .None => self.done = true
            front_item := match self.part.as_mut():
                .Some(inner) => inner.next_back()
                .None => .None
            if front_item.is_none():
                self.part = .None
            return front_item

impl[I < ?Copy] ByRef[I]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev[T < ?Copy](self) -> Rev[Self, T] where I < DoubleEndedIterator[T]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy] Rev[I, T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[T < ?Copy] DynDoubleEndedIterator[T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy, U < ?Copy, F < FnMut(T) -> U] MapIter[
    I,
    T,
    U,
    F,
]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, U]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T], T < ?Copy, F < FnMut(&T) -> bool] Filter[I, T, F]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    U < ?Copy,
    F < ?Copy & FnMut(T) -> U?,
] FilterMap[I, T, U, F]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, U]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] Take[I, T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] Skip[I, T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T], T < ?Copy] Enumerate[I, T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, (usize, T)]:
        Rev { source: self }

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    J < ?Copy & Iterable[T, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[T],
] Chain[I, T, J]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        Rev { source: self }

impl[
    I < ?Copy & DoubleEndedIterator[T] & ExactSizeIterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[U] & ExactSizeIterator[U],
] Zip[I, T, U, J]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, (T, U)]:
        Rev { source: self }

impl[
    I < ?Copy & DoubleEndedIterator[T],
    T < ?Copy,
    U < ?Copy,
    J < ?Copy & Iterable[U, IntoIter = R],
    R < ?Copy & DoubleEndedIterator[U],
    F < FnMut(T) -> J,
] FlatMap[I, T, U, J, F]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, U]:
        Rev { source: self }

## A cursor yielding an optional's payload once, if present.
## See [std-iter.option.iterable-cursor](../../spec/std/iter.md#r-std-iter.option.iterable-cursor).
pub struct OptionIter[T]:
    value: T?

impl[T] Iterator[T] for OptionIter[T]:
    fn next(&mut self) -> T?:
        value := self.value
        self.value = .None
        value

impl[T] Iterable[T] for T?:
    type IntoIter = OptionIter[T]
    fn iter(self) -> OptionIter[T]:
        OptionIter { value: self }

impl[T] DoubleEndedIterator[T] for OptionIter[T]:
    fn next_back(&mut self) -> T?:
        self.next()

impl[T] ExactSizeIterator[T] for OptionIter[T]:
    fn len(&self) -> usize:
        if self.value.is_some(): 1 else: 0

impl[T] OptionIter[T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        DoubleEndedIterator::[T]::rev(self)

# Rust's String::from_iter<char>: encode scalars into one growing UTF-8 buffer.
impl FromIterator[char] for string:
    fn from_iter[I < ?Copy & Iterator[char]](items: I) -> string:
        let mut cursor = items
        let mut output = UniqList::[u8].new()
        while true:
            match cursor.next():
                .Some(value) =>
                    width := char_width(value)
                    write_char_sized(value, output.spare(width))
                    output.advance(width)
                .None => return output.take_text()
