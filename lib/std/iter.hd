# std.iter: the prelude `Iterator[T]` with its adapters, the `Iterable`
# implementations of `List`, `Map`, and `Iterator`, and `range`
# (future-work/STDLIB.md#stditer). `Iterator` is a prelude name; `Iterable`
# is still declared by the compiler.
#
# `Iterator[T]` is a data type whose private `step` closure yields the next
# item (spec/06-control-flow.md#iteration-protocols), and the adapters are
# its ordinary methods (spec/06-control-flow.md#iterator-adapters). `filter`,
# `take`, `enumerate`, and `map` return a lazy iterator that pulls from
# `self` only when its own `next` is called; `fold` and `collect` drain
# `self`.
#
# Prototype: the compiler builds `list.iter()` and `map.iter()` as
# `Iterator::from_fn` over its built-in cursor, which keeps the iterator
# invalidation checks, and a `for` loop over a list or map uses that cursor
# directly.

pub data Iterator[T]:
    step: fn() -> T?

impl[T] Iterator[T]:
    pub fn from_fn(step: fn() -> T?) -> mut Iterator[T]:
        Iterator[T] { step: step }

    pub fn next(mut self) -> T?:
        (self.step)()

    pub fn filter(mut self, keep: fn(T) -> bool) -> mut Iterator[T]:
        Iterator::from_fn(fn() -> T?:
            while true:
                match self.next():
                    .Some(item) =>
                        if keep(item):
                            return .Some(item)
                    .None => return .None
            .None
        )

    pub fn take(mut self, count: i32) -> mut Iterator[T]:
        if count < 0:
            panic("take: count must not be negative")
        let left = count
        Iterator::from_fn(fn() -> T?:
            if left <= 0:
                return .None
            left = left - 1
            self.next()
        )

    pub fn enumerate(mut self) -> mut Iterator[(i32, T)]:
        let index = 0
        Iterator::from_fn(fn() -> (i32, T)?:
            match self.next():
                .Some(item) =>
                    let numbered = (index, item)
                    index = index + 1
                    .Some(numbered)
                .None => .None
        )

    pub fn map[U](mut self, transform: fn(T) -> U) -> mut Iterator[U]:
        Iterator::from_fn(fn() -> U?:
            match self.next():
                .Some(item) => .Some(transform(item))
                .None => .None
        )

    pub fn fold[A, R](mut self, initial: A, step: fn(A, T) -> A $ R) -> A $ R:
        let total = initial
        while true:
            match self.next():
                .Some(item) => total = step(total, item)
                .None => break
        total

    pub fn collect(mut self) -> List[T]:
        let items: mut List[T] = []
        while true:
            match self.next():
                .Some(item) => items.append(item)
                .None => break
        items

# A loop over an iterator continues its traversal
# (spec/06-control-flow.md#r-flow.for.iterator-self).
impl[T] Iterable[T] for Iterator[T]:
    fn iter(self) -> mut Iterator[T]:
        Iterator::from_fn(self.step)

impl[T] Iterable[T] for List[T]:
    fn iter(self) -> mut Iterator[T]:
        self.iter()

impl[K, V] Iterable[(K, V)] for Map[K, V]:
    fn iter(self) -> mut Iterator[(K, V)]:
        self.iter()

# The integers from `start` up to, not including, `end`.
pub fn range(start: i32, end: i32) -> mut Iterator[i32]:
    let next = start
    Iterator::from_fn(fn() -> i32?:
        if next >= end:
            return .None
        next = next + 1
        next - 1
    )
