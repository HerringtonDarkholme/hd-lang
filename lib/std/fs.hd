# std.fs: the host capability traits `FsRead` and `FsWrite`, `FsError`,
# `Entry`, and the deterministic provider `MemoryFs` (spec/std/fs.md). The
# default profile binds the host's file system
# (src/commands/default-profile.ts).
use std.path.Path

## Every file system operation reports one of these errors: `NotFound`, `PermissionDenied`, `AlreadyExists`, `NotADirectory`, `IsADirectory`, `InvalidUtf8`, or `Other`.
## See [std-fs.error.decl-struct](../../spec/std/fs.md#r-std-fs.error.decl-struct).
@error
@derive(Debug, Eq)
pub enum FsError:
    @error("not found: ${path}")
    NotFound(path: Path)
    @error("permission denied: ${path}")
    PermissionDenied(path: Path)
    @error("access to ${path} is not granted")
    NotGranted(path: Path)
    @error("already exists: ${path}")
    AlreadyExists(path: Path)
    @error("not a directory: ${path}")
    NotADirectory(path: Path)
    @error("is a directory: ${path}")
    IsADirectory(path: Path)
    @error("invalid UTF-8: ${path}")
    InvalidUtf8(path: Path)
    @error("$message")
    Other(message: string)

## Whether a file system entry is a file, a directory, or a symlink.
## See [std-fs.error.decl-struct](../../spec/std/fs.md#r-std-fs.error.decl-struct).
@derive(Debug, Eq)
pub enum EntryKind:
    File
    Directory
    Symlink

## The value that describes one file system entry.
## See [std-fs.error.decl-struct](../../spec/std/fs.md#r-std-fs.error.decl-struct).
@derive(Debug, Eq)
pub struct Entry:
    ## The entry's path.
    ## See [std-fs.error.decl-struct](../../spec/std/fs.md#r-std-fs.error.decl-struct).
    pub path: Path
    ## The entry's kind.
    ## See [std-fs.error.decl-struct](../../spec/std/fs.md#r-std-fs.error.decl-struct).
    pub kind: EntryKind
    ## The file's length in bytes.
    ## See [std-fs.entry.size](../../spec/std/fs.md#r-std-fs.entry.size).
    pub size: u64

## The host capability to read from the file system: `read_bytes!`, `read_text!`, `list_dir!`, and `stat!`.
## See [std-fs.read.decl](../../spec/std/fs.md#r-std-fs.read.decl).
pub trait FsRead:
    fn read_bytes!(self, path: Path) -> Result[List[u8], FsError]
    fn read_text!(self, path: Path) -> Result[string, FsError]
    fn list_dir!(self, path: Path) -> Result[List[Entry], FsError]
    fn stat!(self, path: Path) -> Result[Entry?, FsError]

## The host capability to change the file system: `write_bytes!`, `write_text!`, `append_text!`, `create_dir_all!`, `remove!`, and `rename!`.
## See [std-fs.write.decl](../../spec/std/fs.md#r-std-fs.write.decl).
pub trait FsWrite:
    fn write_bytes!(&mut self, path: Path, bytes: List[u8]) -> Result[void, FsError]
    fn write_text!(&mut self, path: Path, text: string) -> Result[void, FsError]
    fn append_text!(&mut self, path: Path, text: string) -> Result[void, FsError]
    fn create_dir_all!(&mut self, path: Path) -> Result[void, FsError]
    fn remove!(&mut self, path: Path) -> Result[void, FsError]
    fn rename!(&mut self, from: Path, to: Path) -> Result[void, FsError]

# Reads a file through the covering `FsRead` provider
# (spec/std/fs.md#r-std-fs.helper.read-text).
## Returns the whole content of the file at `path` as a string.
## See [std-fs.helper.read-text](../../spec/std/fs.md#r-std-fs.helper.read-text).
pub fn read_text!(path: Path) -> Result[string, FsError] $ FsRead:
    $.use(FsRead).read_text!(path)

# Writes a file through the covering `FsWrite` provider
# (spec/std/fs.md#r-std-fs.helper.write-text).
## Creates the file at `path`, or replaces its whole content.
## See [std-fs.helper.write-text](../../spec/std/fs.md#r-std-fs.helper.write-text).
pub fn write_text!(path: Path, text: string) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.write_text!(path, text)

# The remaining helpers each call the covering provider's method of the
# same name (spec/std/fs.md#r-std-fs.helper.read-bytes and its rows).
## Returns the whole content of the file at `path` as bytes.
## See [std-fs.helper.read-bytes](../../spec/std/fs.md#r-std-fs.helper.read-bytes).
pub fn read_bytes!(path: Path) -> Result[List[u8], FsError] $ FsRead:
    $.use(FsRead).read_bytes!(path)

## Returns one `Entry` for each entry of the directory at `path`.
## See [std-fs.helper.list-dir](../../spec/std/fs.md#r-std-fs.helper.list-dir).
pub fn list_dir!(path: Path) -> Result[List[Entry], FsError] $ FsRead:
    $.use(FsRead).list_dir!(path)

## Returns the `Entry` for `path`, or `.None` when nothing is there.
## See [std-fs.helper.stat](../../spec/std/fs.md#r-std-fs.helper.stat).
pub fn stat!(path: Path) -> Result[Entry?, FsError] $ FsRead:
    $.use(FsRead).stat!(path)

## Creates the file at `path` from `bytes`, or replaces its whole content.
## See [std-fs.helper.write-bytes](../../spec/std/fs.md#r-std-fs.helper.write-bytes).
pub fn write_bytes!(path: Path, bytes: List[u8]) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.write_bytes!(path, bytes)

## Adds `text` at the end of the file at `path`, creating the file when there is none.
## See [std-fs.helper.append-text](../../spec/std/fs.md#r-std-fs.helper.append-text).
pub fn append_text!(path: Path, text: string) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.append_text!(path, text)

## Creates the directory at `path` and every missing directory above it.
## See [std-fs.helper.create-dir-all](../../spec/std/fs.md#r-std-fs.helper.create-dir-all).
pub fn create_dir_all!(path: Path) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.create_dir_all!(path)

## Removes the file or the empty directory at `path`.
## See [std-fs.helper.remove](../../spec/std/fs.md#r-std-fs.helper.remove).
pub fn remove!(path: Path) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.remove!(path)

## Moves the entry at `from` to `to`.
## See [std-fs.helper.rename](../../spec/std/fs.md#r-std-fs.helper.rename).
pub fn rename!(from: Path, to: Path) -> Result[void, FsError] $ FsWrite:
    files := $.use(FsWrite)
    files.rename!(from, to)

# Walking and globbing, plain hd over the covering `FsRead` provider
# (spec/std/fs.md#walking-and-globbing).
## Returns every entry below `root`, depth first, each directory's entries ordered by path text and a directory before its contents.
## See [std-fs.walk.order](../../spec/std/fs.md#r-std-fs.walk.order).
pub fn walk!(root: Path) -> Result[List[Entry], FsError] $ FsRead:
    let mut found: List[Entry] = []
    walk_into!(root, &mut found)?
    .Ok(found)

fn walk_into!(dir: Path, found: &mut List[Entry]) -> Result[void, FsError] $ FsRead:
    for entry in sorted_entries!(dir)?:
        found.push(entry)
        if entry.kind == EntryKind.Directory:
            walk_into!(entry.path, found)?
    .Ok(())

fn sorted_entries!(dir: Path) -> Result[List[Entry], FsError] $ FsRead:
    .Ok(list_dir!(dir)?.sorted_by(fn(a: Entry, b: Entry) -> Ordering: "${a.path}".cmp("${b.path}")))

# One piece of a glob component's pattern. Each piece but `Many` matches one
# character (r-std-fs.glob.star, r-std-fs.glob.class).
enum GlobPiece:
    Literal(char)
    One
    Many
    Class(negated: bool, ranges: List[(char, char)])

## Returns the paths that match `pattern`, ordered by path text, with `*`, `?`, `[...]` inside a component and `**` for any number of directories.
## See [std-fs.glob.decl](../../spec/std/fs.md#r-std-fs.glob.decl).
pub fn glob!(pattern: string) -> Result[List[Path], FsError] $ FsRead:
    let mut components: List[string] = []
    for component in pattern.split("/"):
        if component != "":
            components.push(component)
    # Every component is checked before any file system access
    # (r-std-fs.glob.error).
    for component in components:
        match parse_glob_component(component):
            .Ok(_) => pass
            .Err(reason) => return .Err(FsError.Other(message="invalid glob pattern ${pattern}: ${reason}"))
    let mut found: List[Path] = []
    if components.len() > 0:
        glob_from!(if pattern.starts_with("/"): "/" else: "", components, 0, &mut found)?
    let mut texts: List[string] = []
    for path in found:
        texts.push("${path}")
    let sorted = texts.sorted_by(fn(a: string, b: string) -> Ordering: a.cmp(b))
    let mut result: List[Path] = []
    let previous: string? = .None
    for text in sorted:
        if previous != .Some(text):
            result.push(Path(text))
        previous = .Some(text)
    .Ok(result)

fn glob_has_meta(component: string) -> bool:
    component.contains("*") || component.contains("?") || component.contains("[")

# Matches `components[index..]` below the directory `base`, whose text is ""
# for the current directory (r-std-fs.glob.relative).
fn glob_from!(base: string, components: List[string], index: usize, found: &mut List[Path]) -> Result[void, FsError] $ FsRead:
    component := components[index]
    last := index + 1 == components.len()
    if component == "**":
        if !last:
            glob_from!(base, components, index + 1, found)?
        for entry in sorted_entries!(glob_dir(base))?:
            name := entry.path.file_name().unwrap_or("")
            child := Path(base).join(name)
            if last:
                found.push(child)
            if entry.kind == EntryKind.Directory:
                glob_from!("${child}", components, index, found)?
        return .Ok(())
    if !glob_has_meta(component):
        child := Path(base).join(component)
        match stat!(child)?:
            .Some(entry) => glob_step!(entry, "${child}", components, index, found)?
            .None => pass
        return .Ok(())
    pieces := parse_glob_component(component).unwrap_or([])
    for entry in sorted_entries!(glob_dir(base))?:
        name := entry.path.file_name().unwrap_or("")
        if glob_component_matches(pieces, name):
            glob_step!(entry, "${Path(base).join(name)}", components, index, found)?
    .Ok(())

# A matched entry ends the pattern, or is a directory the next component
# looks into; a symlink is never looked into (r-std-fs.glob.symlinks).
fn glob_step!(entry: Entry, text: string, components: List[string], index: usize, found: &mut List[Path]) -> Result[void, FsError] $ FsRead:
    if index + 1 == components.len():
        found.push(Path(text))
    else if entry.kind == EntryKind.Directory:
        glob_from!(text, components, index + 1, found)?
    .Ok(())

fn glob_dir(base: string) -> Path:
    if base == "": Path(".") else: Path(base)

fn parse_glob_component(component: string) -> Result[List[GlobPiece], string]:
    let mut chars: List[char] = []
    for c in component.chars():
        chars.push(c)
    let mut pieces: List[GlobPiece] = []
    let at: usize = 0
    while at < chars.len():
        c := chars[at]
        at = at + 1
        if c == '*':
            pieces.push(.Many)
        else if c == '?':
            pieces.push(.One)
        else if c == '[':
            let negated = false
            if at < chars.len() && chars[at] == '!':
                negated = true
                at = at + 1
            let mut ranges: List[(char, char)] = []
            let closed = false
            while at < chars.len() && !closed:
                low := chars[at]
                if low == ']' && ranges.len() > 0:
                    closed = true
                    at = at + 1
                else if low == ']':
                    return .Err("empty class")
                else if at + 2 < chars.len() && chars[at + 1] == '-' && chars[at + 2] != ']':
                    high := chars[at + 2]
                    if low > high:
                        return .Err("range ${low}-${high} runs backwards")
                    ranges.push((low, high))
                    at = at + 3
                else:
                    ranges.push((low, low))
                    at = at + 1
            if !closed:
                return .Err("unclosed [")
            pieces.push(.Class(negated=negated, ranges=ranges))
        else:
            pieces.push(.Literal(c))
    .Ok(pieces)

fn glob_piece_matches(piece: GlobPiece, c: char) -> bool:
    match piece:
        .Literal(expected) => expected == c
        .One => true
        .Many => false
        .Class(negated, ranges) =>
            let inside = false
            for (low, high) in ranges:
                if c >= low && c <= high:
                    inside = true
            inside != negated

# Greedy matching with one backtrack point, the usual linear scheme for
# patterns whose pieces but `*` take one character.
fn glob_component_matches(pieces: List[GlobPiece], name: string) -> bool:
    let mut chars: List[char] = []
    for c in name.chars():
        chars.push(c)
    let at: usize = 0
    let in_pattern: usize = 0
    let star: usize? = .None
    let mark: usize = 0
    while at < chars.len():
        let is_many = false
        if in_pattern < pieces.len():
            match pieces[in_pattern]:
                .Many => is_many = true
                _ => pass
        if is_many:
            star = .Some(in_pattern)
            mark = at
            in_pattern = in_pattern + 1
        else if in_pattern < pieces.len() && glob_piece_matches(pieces[in_pattern], chars[at]):
            in_pattern = in_pattern + 1
            at = at + 1
        else:
            match star:
                .Some(from) =>
                    in_pattern = from + 1
                    mark = mark + 1
                    at = mark
                .None => return false
    while in_pattern < pieces.len():
        match pieces[in_pattern]:
            .Many => in_pattern = in_pattern + 1
            _ => return false
    true

# The deterministic file system (spec/std/fs.md#memory-file-system). A
# file's key omits empty and dot components, preserving a leading slash.
# A directory is a key that
# `create_dir_all!` made, or the text before a `/` in another key
# (r-std-fs.memory.dirs); `.` is the root (r-std-fs.memory.normalized-root-directory).
## The deterministic `FsRead` and `FsWrite` provider: a file system in memory for unit tests.
## See [std-fs.memory.decl](../../spec/std/fs.md#r-std-fs.memory.decl).
@derive(Debug)
pub struct MemoryFs:
    files: Map[string, List[u8]]
    dirs: List[string]

# Lexical keys only: no host access, symlinks or parent-component resolution.
fn memory_key(path: Path) -> string:
    text := "${path}"
    let mut parts: List[string] = []
    for part in text.split("/"):
        if part != "" && part != ".":
            parts.push(part)
    key := parts.join("/")
    if text.starts_with("/"):
        return "/${key}"
    if key == "": "." else: key

impl MemoryFs:
    # A new object, so the providers installed from it and the test share
    # one file system (r-std-fs.memory.new-ref).
    ## Returns an empty in-memory file system, as a new object behind `&mut`.
    ## See [std-fs.memory.new-ref](../../spec/std/fs.md#r-std-fs.memory.new-ref).
    pub fn new() -> &mut MemoryFs:
        &mut MemoryFs { files: {}, dirs: [] }

    fn file_at(&self, key: string) -> List[u8]?:
        self.files.get(key)

    # A made directory, or a prefix of a file or a made directory.
    fn dir_at(&self, key: string) -> bool:
        if key == "." || key == "/":
            return true
        under := if key == "/": "/" else: "${key}/"
        for made in self.dirs:
            if made == key || made.starts_with(under):
                return true
        for (stored, _) in self.files:
            if stored.starts_with(under):
                return true
        false

    # Whether a file's key is a directory above `key`.
    fn file_above(&self, key: string) -> bool:
        parts := key.split("/")
        let above = ""
        let index: usize = 0
        while index + 1 < parts.len():
            above = if index == 0: parts[0] else: "${above}/${parts[index]}"
            match self.file_at(above):
                .Some(_) => return true
                .None => pass
            index = index + 1
        false

    # The error, if any, of writing a file at `path`.
    fn write_error(&self, path: Path) -> FsError?:
        key := memory_key(path)
        if self.dir_at(key):
            return .Some(FsError.IsADirectory(path=path))
        if self.file_above(key):
            return .Some(FsError.NotADirectory(path=path))
        .None

impl FsRead for MemoryFs:
    fn read_bytes!(self, path: Path) -> Result[List[u8], FsError]:
        key := memory_key(path)
        match self.file_at(key):
            .Some(bytes) => .Ok(bytes)
            .None => if self.dir_at(key): .Err(FsError.IsADirectory(path=path)) else: .Err(FsError.NotFound(path=path))

    fn read_text!(self, path: Path) -> Result[string, FsError]:
        bytes := self.read_bytes!(path)?
        match string::from_utf8(bytes):
            .Ok(text) => .Ok(text)
            .Err(_) => .Err(FsError.InvalidUtf8(path=path))

    # The entries directly inside, ordered by their paths' text
    # (r-std-fs.memory.normalized-list-order).
    fn list_dir!(self, path: Path) -> Result[List[Entry], FsError]:
        key := memory_key(path)
        match self.file_at(key):
            .Some(_) => return .Err(FsError.NotADirectory(path=path))
            .None => pass
        if !self.dir_at(key):
            return .Err(FsError.NotFound(path=path))
        under := if key == ".": "" else if key == "/": "/" else: "${key}/"
        let mut names: List[string] = []
        for made in self.dirs:
            match made.strip_prefix(under):
                .Some(rest) => names.push(rest.split("/")[0])
                .None => pass
        for (stored, _) in self.files:
            match stored.strip_prefix(under):
                .Some(rest) => names.push(rest.split("/")[0])
                .None => pass
        let mut entries: List[Entry] = []
        let mut seen: Map[string, bool] = {}
        for name in names.sorted_by(fn(a: string, b: string) -> Ordering: a.cmp(b)):
            # The root itself is not one of its children.
            if name == "." || name == "":
                continue
            match seen.get(name):
                .Some(_) => pass
                .None =>
                    seen[name] = true
                    match self.stat!(Path("${under}${name}"))?:
                        .Some(entry) => entries.push(entry)
                        .None => pass
        .Ok(entries)

    fn stat!(self, path: Path) -> Result[Entry?, FsError]:
        key := memory_key(path)
        match self.file_at(key):
            .Some(bytes) => .Ok(.Some(Entry { path: path, kind: EntryKind.File, size: u64(bytes.len()) }))
            .None => if self.dir_at(key): .Ok(.Some(Entry { path: path, kind: EntryKind.Directory, size: 0 })) else: .Ok(.None)

impl FsWrite for MemoryFs:
    fn write_bytes!(&mut self, path: Path, bytes: List[u8]) -> Result[void, FsError]:
        match self.write_error(path):
            .Some(error) => return .Err(error)
            .None => pass
        self.files[memory_key(path)] = bytes
        .Ok(())

    fn write_text!(&mut self, path: Path, text: string) -> Result[void, FsError]:
        self.write_bytes!(path, text.to_utf8())

    fn append_text!(&mut self, path: Path, text: string) -> Result[void, FsError]:
        match self.write_error(path):
            .Some(error) => return .Err(error)
            .None => pass
        key := memory_key(path)
        let mut joined: List[u8] = []
        match self.file_at(key):
            .Some(old) =>
                for byte in old:
                    joined.push(byte)
            .None => pass
        for byte in text.to_utf8():
            joined.push(byte)
        self.files[key] = joined
        .Ok(())

    fn create_dir_all!(&mut self, path: Path) -> Result[void, FsError]:
        key := memory_key(path)
        match self.file_at(key):
            .Some(_) => return .Err(FsError.NotADirectory(path=path))
            .None => pass
        if self.file_above(key):
            return .Err(FsError.NotADirectory(path=path))
        # Records `path` and every directory above it, so each outlives
        # the removal of what is inside it.
        parts := key.split("/")
        let level = ""
        let index: usize = 0
        while index < parts.len():
            level = if index == 0: parts[0] else: "${level}/${parts[index]}"
            let known = level == ""
            for made in self.dirs:
                if made == level:
                    known = true
            if !known:
                self.dirs.push(level)
            index = index + 1
        .Ok(())

    fn remove!(&mut self, path: Path) -> Result[void, FsError]:
        key := memory_key(path)
        match self.file_at(key):
            .Some(_) =>
                _ := self.files.remove(key)
                return .Ok(())
            .None => pass
        if !self.dir_at(key):
            return .Err(FsError.NotFound(path=path))
        if self.list_dir!(path)?.len() > 0:
            return .Err(FsError.Other(message="directory not empty: ${path}"))
        let mut kept: List[string] = []
        for made in self.dirs:
            if made != key:
                kept.push(made)
        self.dirs = kept
        .Ok(())

    # Moves the file or directory at `from`, with every key under it
    # (r-std-fs.memory.rename).
    fn rename!(&mut self, from: Path, to: Path) -> Result[void, FsError]:
        source := memory_key(from)
        target := memory_key(to)
        if !self.dir_at(source):
            match self.file_at(source):
                .Some(bytes) =>
                    match self.write_error(to):
                        .Some(error) => return .Err(error)
                        .None => pass
                    _ := self.files.remove(source)
                    self.files[target] = bytes
                    return .Ok(())
                .None => return .Err(FsError.NotFound(path=from))
        match self.file_at(target):
            .Some(_) => return .Err(FsError.NotADirectory(path=to))
            .None => pass
        if self.file_above(target):
            return .Err(FsError.NotADirectory(path=to))
        under := "${source}/"
        let mut moved: List[(string, List[u8])] = []
        for (stored, bytes) in self.files:
            if stored.starts_with(under):
                moved.push((stored, bytes))
        for (stored, bytes) in moved:
            _ := self.files.remove(stored)
            self.files["${target}${stored.slice(source.len(), stored.len())}"] = bytes
        let mut renamed: List[string] = []
        for made in self.dirs:
            if made == source || made.starts_with(under):
                renamed.push("${target}${made.slice(source.len(), made.len())}")
            else:
                renamed.push(made)
        self.dirs = renamed
        .Ok(())
