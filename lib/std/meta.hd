# std.meta: what the compiler knows about code, in five parts below:
# the domain markers, function facts and the inline and cold decorators,
# runtime type identity, typed derivation's structure, and the call site
# of a `@track_caller` function.
use std.format.{Debug, DebugWriter}
use std.hash.Hasher
use std.rt.{address_of, Ptr}

# std.meta: the markers that say what may cross into another execution
# domain (spec/lang/10-modules.md#markers). The compiler answers `Send`,
# `Sync` and `Wire` from a type's parts, as it answers `Copy`; only std
# implements them.

## A trait with no members that says what may cross into one kind of domain.
## A trait that names it as a supertrait is a marker.
## See [module.marker.definition](../../spec/lang/10-modules.md#r-module.marker.definition).
pub trait Marker < ?Copy

## A value that may be copied, moved or lent to another thread of the same memory.
## See [module.marker.send](../../spec/lang/10-modules.md#r-module.marker.send).
pub trait Send < Marker

## A value that threads may read at once: it holds no counted buffer, so
## reading it changes no count.
## See [module.marker.sync](../../spec/lang/10-modules.md#r-module.marker.sync).
pub trait Sync < Marker

## A value that crosses into separate memory as a self-contained tree.
## See [module.marker.wire](../../spec/lang/10-modules.md#r-module.marker.wire).
pub trait Wire < Marker

# std.meta: function facts (spec/lang/14-annotations.md#function-facts),
# the target kinds (#target-kinds), and the inline and cold decorators
# (#inline-and-cold). `facts_of`, `Target`, `Annotate`, `annotate`,
# `InlineHint`, `inline`, `Cold`, and `cold` are imported, not prelude names
# (r-annot.facts-of.declared, r-annot.target.declarations,
# r-annot.inline.declared.v2).

# The facts that decorators attach to the module-level function `f`, in
# source order, as a `std.meta.Facts` (r-annot.facts-of.result.compiler-decorators.v2). The
# compiler checks that the argument names such a function, without
# evaluating it, and lowers each call to that function's facts, so this body
# never runs.
@intrinsic("facts_of")
## The facts attached to the module-level function `f`; a compiler intrinsic.
## See [annot.facts-of.declared](../../spec/lang/14-annotations.md#r-annot.facts-of.declared).
pub fn facts_of[F](f: F) -> Facts:
    panic("intrinsic")

# The kinds of target a decorator value attaches to (r-annot.target.kind.fn
# and the rows after it); a newtype is `.Newtype` (Decorators D10).
## The kind of declaration a fact value may be attached to.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
@derive(Debug)
pub enum Target:
    Fn
    Data
    Enum
    Newtype
    Field
    Variant
    Param
    Trait
    Impl
    Method

# A fact on a fact type that limits its values to the listed kinds
# (r-annot.target.limit). The compiler recognizes this type by its qualified
# name, and it limits itself to data types and enums (r-annot.target.bootstrap).
@annotate(.Data, .Enum)
## The fact that limits a fact type's values to targets of the listed kinds.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
@derive(Debug)
pub struct Annotate:
    ## The target kinds the fact type allows.
    ## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
    pub kinds: List[Target]

# `T`, when written as in `@annotate::[F](.Field)` or
# `@annotate::[fn(T) -> R](.Fn)`, is a pattern over the fact type's own
# parameters that describes its target's type, which makes it a typed fact
# type (r-annot.typed-fact.declare, r-annot.typed-fact.pattern). The compiler
# reads it and checks each value (src/checker/typed-facts.ts). When omitted,
# it takes the default `Any`, and the fact type is untyped
# (r-annot.typed-fact.untyped.reference-values).
## The `@annotate` decorator: it attaches an `Annotate` fact listing the target `kinds`.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
pub fn annotate[T = &dyn Any](kinds...: List[Target]) -> Annotate:
    Annotate { kinds: kinds }

# The inline and cold decorators (r-annot.inline.declared.v2). The
# compiler recognizes `inline` and `cold` by their qualified names and
# checks their targets itself (r-annot.inline.targets).
## How the compiler copies calls of a function: `.Auto` prefers a copy,
## `.Always` asks for one at every call, `.Never` copies none.
## See [annot.inline.recognized](../../spec/lang/14-annotations.md#r-annot.inline.recognized).
pub enum InlineHint:
    Auto
    Always
    Never

## The `@inline` decorator: a bare `@inline` is `@inline(.Auto)`.
## See [annot.inline.recognized](../../spec/lang/14-annotations.md#r-annot.inline.recognized).
pub fn inline(hint: InlineHint = .Auto) -> InlineHint:
    hint

## Marks a function unlikely to be called: never copied, and called through
## the function table.
## See [annot.inline.cold](../../spec/lang/14-annotations.md#r-annot.inline.cold).
pub struct Cold: pass

## The `@cold` decorator.
## See [annot.inline.cold](../../spec/lang/14-annotations.md#r-annot.inline.cold).
pub fn cold() -> Cold:
    Cold {}

# std.meta, the part written in hd: runtime type identity
# (spec/lang/09-traits.md#runtime-type-identity). Importing any `std.meta`
# name, or `std.error.Error`, declares these under their standard names
# (checker/standard-traits.ts); aliases are not supported. The compiler
# implements the sealed `Inspectable` for every type, and supplies the
# inherent `downcast_ref` and `downcast_mut` methods, so its dictionary holds
# `runtime_type` alone. `TypeId::of` is declared below; only its body is the
# compiler's.

## The sealed trait of types with a runtime identity, which the compiler supplies.
## See [module.prelude.inspect-reference-api](../../spec/lang/10-modules.md#r-module.prelude.inspect-reference-api).
pub trait Inspectable < ?Copy:
    fn runtime_type(&self) -> TypeId

impl dyn Inspectable:
    ## Recovers the original shared reference when its concrete type is `T`.
    @intrinsic("downcast_ref")
    pub fn downcast_ref[T < ?Copy & Inspectable](&self) -> (&T)?:
        panic("intrinsic")

    ## Recovers the original mutable reference when its concrete type is `T`.
    @intrinsic("downcast_mut")
    pub fn downcast_mut[T < ?Copy & Inspectable](&mut self) -> (&mut T)?:
        panic("intrinsic")

# One canonical descriptor per identity in the compiled program. The
# compiler keeps its key and printable name in static storage; TypeId
# carries only the descriptor's address, with no owned string counts.
struct TypeInfo:
    key: string
    name: string

## The runtime identity of an inspectable type.
## See [module.prelude.inspect-reference-api](../../spec/lang/10-modules.md#r-module.prelude.inspect-reference-api).
pub struct TypeId:
    info: Ptr[TypeInfo]

# Its descriptor is static storage that no count reaches, so threads may
# share a `TypeId` though `TypeInfo` holds strings
# (`module.marker.explicit.only`); it is never `Wire`: an address means
# nothing in another memory.
impl Send for TypeId

impl Sync for TypeId

impl TypeId:
    ## The `TypeId` of `T`.
    @intrinsic("type_id_of")
    pub fn of[T < Inspectable]() -> TypeId:
        panic("intrinsic")

# Keep handwritten Eq: descriptor identity ignores the descriptive name.
impl Eq for TypeId:
    fn eq(&self, other: &TypeId) -> bool:
        self.info.address == other.info.address

# The descriptor address is deterministic within a build, as TypeId's
# equality and hash promise. It is not a cross-build or boundary tag.
impl Hash for TypeId:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        self.info.address.hash(state)

# Keep handwritten Display: display only the descriptive type name; this is not an Error.
impl Display for TypeId:
    fn to_string(&self) -> string:
        self.info.as_ref().name

# Keep the existing key/name debug representation instead of exposing
# the private descriptor address.
impl Debug for TypeId:
    fn debug(&self, out: *mut DebugWriter) -> void:
        info := self.info.as_ref()
        let mut record = out.debug_struct("TypeId")
        record.field("key", info.key)
        record.field("name", info.name)
        record.finish()

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): a `@derive` on a std
# declaration has no effect in the prototype.

# std.meta, the part written in hd
# (spec/lang/14-annotations.md#the-stdmeta-module): the handles, facts,
# and member information that typed derivation passes to a template, and
# the protocol traits `Walker`, `Describer`, and `Source`
# (#walkers-describers-and-sources). The compiler supplies `Structure` and
# the traversals, and fills the `hd_` fields.
#
# Resolution seeds the items the compiler supplies here, `Structure` among
# them (crates/hd_resolve/src/seed.rs); the rest is an ordinary std module.
# The handle declarations name their parameters `HdS` and `HdF`: the
# prototype cannot infer an inherent method's parameters from a receiver
# whose type arguments are the caller's parameters of the same names.

# A member's or variant's facts. The prototype holds `Inspectable` values
# rather than `Any`.
## The facts attached to one type, member, variant, or module-level function, in source order.
## See [annot.structure.reference-facts](../../spec/lang/14-annotations.md#r-annot.structure.reference-facts).
pub struct Facts:
    ## The fact values.
    ## See [annot.structure.reference-facts](../../spec/lang/14-annotations.md#r-annot.structure.reference-facts).
    pub items: List[*dyn Inspectable]

impl Facts:
    ## Returns the fact whose concrete type is `F`, or `.None`.
    ## See [annot.structure.find-exact](../../spec/lang/14-annotations.md#r-annot.structure.find-exact).
    pub fn find[F < Inspectable](self) -> F?:
        for item in self.items:
            match item.downcast_ref::[F]():
                .Some(found) => return .Some(*found)
                .None => pass
        .None

## What the compiler tells a template about one member: name, position, facts, doc comment, and shape.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub struct Member:
    ## The member's declared name.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub name: string
    ## The member's position in its type.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub position: usize
    ## The member's facts.
    ## See [annot.structure.reference-facts](../../spec/lang/14-annotations.md#r-annot.structure.reference-facts).
    pub facts: Facts
    ## The member's doc comment, in `.Some`, or `.None`.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub doc: string?
    ## Whether the member is embedded.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub embedded: bool
    ## Whether the member is positional.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub positional: bool
    ## How the member's type refers to the type being derived, which the compiler computes.
    ## See [annot.structure.self-ref-field](../../spec/lang/14-annotations.md#r-annot.structure.self-ref-field).
    pub self_ref: SelfRef

# The prototype leaves `shared` empty.
## What the compiler tells a template about one variant.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub struct VariantInfo:
    ## The variant's name.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub name: string
    ## The variant's index in its enum.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub index: usize
    ## The variant's facts.
    ## See [annot.structure.reference-facts](../../spec/lang/14-annotations.md#r-annot.structure.reference-facts).
    pub facts: Facts
    ## The variant's doc comment, in `.Some`, or `.None`.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub doc: string?
    ## The owning type's documentation, identical for all its variants.
    pub type_doc: string? = .None
    ## Whether the variant belongs to a data type.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub of_data: bool
    ## The variant's number of positional payload members.
    ## See [annot.variant.member-counts](../../spec/lang/14-annotations.md#r-annot.variant.member-counts).
    pub positional: usize = 0
    ## The variant's number of named payload members.
    ## See [annot.variant.member-counts](../../spec/lang/14-annotations.md#r-annot.variant.member-counts).
    pub named: usize = 0
    ## The positional payload members included in this derivation's view.
    ## See [annot.variant.included-positional](../../spec/lang/14-annotations.md#r-annot.variant.included-positional).
    pub included_positional: usize = 0
    ## The facts the variants share.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub shared: List[(string, *dyn Inspectable)]
    ## How the variant's fields refer to the type being derived, which the compiler computes.
    ## See [annot.structure.self-ref-field](../../spec/lang/14-annotations.md#r-annot.structure.self-ref-field).
    pub self_ref: SelfRef

## How a member or variant refers to the type being derived: `Absent`, `Optional`, or `Required`.
## See [annot.structure.self-ref-enum](../../spec/lang/14-annotations.md#r-annot.structure.self-ref-enum).
@derive(Debug)
pub enum SelfRef:
    Absent
    Optional
    Required

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): a `@derive` on a std
# declaration has no effect in the prototype.

# A member's handle: a shared, read-only reference to the member's
# record, which the compiler builds once per instance in static data, so a
# handle is one address that no count changes.
## A member's handle: a reference to its `FieldRecord`, which holds its `Member` information plus the calls a template needs.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub type Field[HdS < ?Copy, HdF < ?Copy] = *FieldRecord[HdS, HdF]

## What a member's handle refers to: its `Member` information plus the calls a template needs.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub struct FieldRecord[HdS < ?Copy, HdF < ?Copy]:
    ## The member's information.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub info: Member
    hd_get: fn(&HdS) -> &HdF
    hd_has_default: bool
    hd_default: fn() -> HdF?

impl[HdS < ?Copy, HdF < ?Copy] FieldRecord[HdS, HdF]:
    ## Reads the member's value from `s`.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub fn get['a](&self, s: &'a HdS) -> &'a HdF:
        (self.hd_get)(s)

    ## Whether the member has a default value.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub fn has_default(&self) -> bool:
        self.hd_has_default

    ## The member's default value, in `.Some`, or `.None`.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub fn default(&self) -> HdF?:
        (self.hd_default)()

    ## The member's fact whose concrete type is `HdM`, or `.None`.
    ## See [annot.structure.find-exact](../../spec/lang/14-annotations.md#r-annot.structure.find-exact).
    pub fn fact[HdM < Inspectable](&self) -> HdM?:
        self.info.facts.find::[HdM]()

# A variant's handle, a member key and a member directory are, like a
# member's handle, shared read-only references to records that the
# compiler builds once per instance in static data.
## A variant's handle: a reference to its `VariantRecord`, which holds its `VariantInfo` plus the check that a value holds it.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub type Variant[HdS < ?Copy] = *VariantRecord[HdS]

## What a variant's handle refers to: its `VariantInfo` plus the check that a value holds it.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub struct VariantRecord[HdS < ?Copy]:
    ## The variant's information.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub info: VariantInfo
    hd_holds: fn(&HdS) -> bool

impl[HdS < ?Copy] VariantRecord[HdS]:
    ## Whether `s` holds this variant.
    ## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
    pub fn holds(&self, s: &HdS) -> bool:
        (self.hd_holds)(s)

# The compiler builds each directory's record once, in static data, so
# its address is its id, as a `TypeId` is its descriptor's address.
## A found member's key: a reference to its `KeyRecord`.
## See [annot.structure.members.key-entry](../../spec/lang/14-annotations.md#r-annot.structure.members.key-entry).
pub type Key[HdS < ?Copy] = *KeyRecord[HdS]

## What a member's key refers to: the member's information and target type.
## See [annot.structure.members.key-entry](../../spec/lang/14-annotations.md#r-annot.structure.members.key-entry).
pub struct KeyRecord[HdS < ?Copy]:
    pub info: Member
    hd_type: fn(HdS) -> bool

## The members of the type being derived: a reference to their `MembersRecord`.
## See [annot.structure.members.at-option](../../spec/lang/14-annotations.md#r-annot.structure.members.at-option).
pub type Members[HdS < ?Copy] = *MembersRecord[HdS]

# `hd_keys[k]` is the key of `infos[k]`.
## What a member directory refers to: the members, which a template looks up by position or by a match.
## See [annot.structure.members.at-option](../../spec/lang/14-annotations.md#r-annot.structure.members.at-option).
pub struct MembersRecord[HdS < ?Copy]:
    ## The members' information, in order.
    ## See [annot.structure.members.at-option](../../spec/lang/14-annotations.md#r-annot.structure.members.at-option).
    pub infos: List[Member]
    hd_keys: List[Key[HdS]]

impl[HdS < ?Copy] MembersRecord[HdS]:
    ## The directory's id: one `usize` per member directory in the program, the same at every use of it, which a reader keys its per-type tables by.
    ## See [annot.structure.members.id](../../spec/lang/14-annotations.md#r-annot.structure.members.id).
    pub fn id(&self) -> usize:
        address_of(self)

    ## The key of the member at `position`, or `.None`.
    ## See [annot.structure.members.at-option](../../spec/lang/14-annotations.md#r-annot.structure.members.at-option).
    pub fn at(&self, position: usize) -> Key[HdS]?:
        if position < self.infos.len() && self.infos[position].position == position:
            return .Some(self.hd_keys[position])
        let k: usize = 0
        while k < self.infos.len():
            if self.infos[k].position == position:
                return .Some(self.hd_keys[k])
            k += 1
        .None

    ## The key of the first member that `matches` accepts, or `.None`.
    ## See [annot.structure.members.find-option](../../spec/lang/14-annotations.md#r-annot.structure.members.find-option).
    pub fn find(&self, matches: fn(Member) -> bool) -> Key[HdS]?:
        let k: usize = 0
        while k < self.infos.len():
            if matches(self.infos[k]):
                return .Some(self.hd_keys[k])
            k += 1
        .None

# Generated `walk` calls `rest` for a rest member; the default calls
# `member` with the list (annot.walk.rest, annot.walk.rest.default).
# `walk`, `describe` and `build` take the walker, describer or source as
# `&mut`, and each protocol method takes `&mut self`
# (annot.structure.protocol-ref), so a struct walker changes in place.
## The protocol that walks a value variant and member by member.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub trait Walker[S < ?Copy] < ?Copy:
    type Error
    fn data_variant(&mut self, v: Variant[S]) -> Result[void, Self::Error]:
        self.variant(v)
    fn variant(&mut self, v: Variant[S]) -> Result[void, Self::Error]
    fn data_member[F < ?Copy](&mut self, h: Field[S, F], value: &F) -> Result[void, Self::Error]:
        self.member(h, value)
    fn member[F < ?Copy](&mut self, h: Field[S, F], value: &F) -> Result[void, Self::Error]
    fn rest[T](&mut self, h: Field[S, List[T]], items: &List[T]) -> Result[void, Self::Error]:
        self.member(h, items)

## The protocol that describes a type variant and member by member, without a value.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub trait Describer[S < ?Copy] < ?Copy:
    type Error
    fn variant(&mut self, v: Variant[S]) -> Result[void, Self::Error]
    fn member[F < ?Copy](&mut self, h: Field[S, F]) -> Result[void, Self::Error]

## The protocol that builds a value: it chooses a variant and supplies each member.
## See [annot.structure.decl](../../spec/lang/14-annotations.md#r-annot.structure.decl).
pub trait Source[S < ?Copy] < ?Copy:
    type Error
    fn data_variant(&mut self, choice: Variant[S]) -> Result[Variant[S], Self::Error]:
        self.variant([choice])
    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], Self::Error]
    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, Self::Error]
    fn data_member[F](&mut self, h: Field[S, F], previous: F?) -> Result[F, Self::Error]:
        self.member(h, previous)
    fn member[F](&mut self, h: Field[S, F], previous: F?) -> Result[F, Self::Error]
    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, Self::Error]

# A fact on a source implementation: generated `build` fills each member
# that declares a default from it and never offers that member to the
# source, so its type owes the source's `member` bound nothing
# (r-annot.impl-fact.fills-defaults). The compiler recognizes
# `fills_defaults` by its qualified name.
## A source implementation's fact: `build` fills each member that declares a default from that default.
## See [annot.impl-fact.fills-defaults](../../spec/lang/14-annotations.md#r-annot.impl-fact.fills-defaults).
@annotate(.Impl)
pub struct FillsDefaults: pass

## Marks a source implementation whose `build` fills each member that declares a default from it.
## See [annot.impl-fact.fills-defaults.decl](../../spec/lang/14-annotations.md#r-annot.impl-fact.fills-defaults.decl).
pub fn fills_defaults() -> FillsDefaults:
    FillsDefaults {}

# A fact on a walker, describer or source implementation: in a derivation
# whose template passes it, a member whose known facts hold a value of
# type `F` is omitted, as `= pass` omits it, so its type owes that
# derivation's bounds nothing (r-annot.impl-fact.skips). The compiler
# recognizes `skips` by its qualified name and reads its type argument.
## A walker's, describer's, or source's fact: a member that carries a fact of type `F` is omitted.
## See [annot.impl-fact.skips](../../spec/lang/14-annotations.md#r-annot.impl-fact.skips).
@annotate(.Impl)
pub struct Skips[F]: pass

## Marks a walker, describer, or source implementation that omits each member carrying a fact of type `F`.
## See [annot.impl-fact.skips.decl](../../spec/lang/14-annotations.md#r-annot.impl-fact.skips.decl).
pub fn skips[F]() -> Skips[F]:
    Skips::[F] {}

# std.meta: the call site of a `@track_caller` function
# (spec/lang/07-functions.md#call-site-locations).
#
# A `@track_caller` function that reads its call site (fn.caller.reads) gets
# one hidden argument, a `string` constant that is the call site's record
# (fn.caller.record). Its fields are separated
# by U+001F: the root-package bit, the line, the column and the file, then
# seven fields for each argument when the record holds argument texts: the
# start line and column, the end line and column, the name of a named
# argument or nothing, the source text, and the name of the function a
# positional argument names or nothing (for `dbg`'s `<fn name(..)>`). The
# record is static data; only an accessor reads it, at run time.

## Where a call begins in source: the file as diagnostics name it, and the
## 1-based line and column, counted in characters.
## See [fn.caller.location](../../spec/lang/07-functions.md#r-fn.caller.location).
pub struct Location:
    pub file: string
    pub line: u32
    pub column: u32
    # Whether the call site is in the user's own code (fn.caller.root-package).
    root: bool

impl Location:
    ## The location of the call of the enclosing `@track_caller` function.
    ## See [fn.caller.accessor.location](../../spec/lang/07-functions.md#r-fn.caller.accessor.location).
    @intrinsic("caller_location")
    pub fn caller() -> Location:
        panic("intrinsic")

    ## The source text and span of each argument of the call of the
    ## enclosing `@track_caller` function; empty when they are unknown.
    ## See [fn.caller.accessor.args](../../spec/lang/07-functions.md#r-fn.caller.accessor.args).
    @intrinsic("caller_args")
    pub fn caller_args() -> List[CallArg]:
        panic("intrinsic")

    ## Whether the call site is in the user's own code.
    ## See [fn.caller.root-package](../../spec/lang/07-functions.md#r-fn.caller.root-package).
    pub fn in_root_package(self) -> bool:
        self.root

## One argument of a call: its source text, where it starts and ends, and
## its name when it is a named argument.
## See [fn.caller.accessor.args](../../spec/lang/07-functions.md#r-fn.caller.accessor.args).
pub struct CallArg:
    pub text: string
    pub start: Location
    pub end: Location
    ## See [fn.caller.accessor.args.name](../../spec/lang/07-functions.md#r-fn.caller.accessor.args.name).
    pub name: string?

# A decimal field of a record, which the compiler writes.
fn site_number(text: string) -> u32:
    let value: u32 = 0
    for c in text.chars():
        value = value * 10 + c.to_u32() - '0'.to_u32()
    value

# What `Location::caller()` is, given the record.
fn site_location(record: string) -> Location:
    fields := record.split("\u{1f}")
    Location {
        file: fields[3],
        line: site_number(fields[1]),
        column: site_number(fields[2]),
        root: fields[0] == "1",
    }

# What `Location::caller_args()` is, given the record.
fn site_args(record: string) -> List[CallArg]:
    fields := record.split("\u{1f}")
    file := fields[3]
    root := fields[0] == "1"
    let mut args: List[CallArg] = []
    let at: usize = 4
    while at + 7 <= fields.len():
        start := Location {
            file: file,
            line: site_number(fields[at]),
            column: site_number(fields[at + 1]),
            root: root,
        }
        end := Location {
            file: file,
            line: site_number(fields[at + 2]),
            column: site_number(fields[at + 3]),
            root: root,
        }
        let name: string? = .None
        if fields[at + 4] != "":
            name = .Some(fields[at + 4])
        args.push(CallArg { text: fields[at + 5], start: start, end: end, name: name })
        at = at + 7
    args

# `text`, how `dbg` prints a function value, `<fn(..)>`, with the name of the
# function that argument `at` of the call names, if it names one
# (spec/lang/10-modules.md#r-module.dbg.value.function). `debug_texts` calls
# it for each element of a function type. Cost: one split of the record.
fn site_function_text(record: string, at: usize, text: string) -> string:
    fields := record.split("\u{1f}")
    field := 4 + at * 7 + 6
    if field >= fields.len() || fields[field] == "" || !text.starts_with("<fn"):
        return text
    "<fn ${fields[field]}${text.slice(3, text.len())}"
