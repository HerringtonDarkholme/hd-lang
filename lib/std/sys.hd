# std.sys, the part written in hd (spec/std/sys.md): the host capability
# trait Sys, its error, and the map-backed ScriptedSys provider. A live
# provider that reads the host system is host-bound; this file holds only
# the declarations and ScriptedSys, which never touches the host.

## The error of a system read.
## See [std-sys.error.decl](../../spec/std/sys.md#system-reads).
@error
@derive(Debug, Eq)
pub enum SysError:
    @error("sys access to ${name} is not granted")
    NotGranted(name: string)
    @error("sys access to ${name} is not supported")
    Unsupported(name: string)

## The host capability to read four facts about the host system.
## See [std-sys.decl](../../spec/std/sys.md#r-std-sys.decl).
pub trait Sys:
    fn os(self) -> Result[string, SysError]
    fn arch(self) -> Result[string, SysError]
    fn hostname(self) -> Result[string, SysError]
    fn cpu_count(self) -> Result[u32, SysError]

## The deterministic Sys provider: every read answers from a map.
## See [std-sys.map.decl](../../spec/std/sys.md#r-std-sys.map.decl).
pub struct ScriptedSys:
    values: Map[string, string]

impl ScriptedSys:
    ## Returns the provider whose methods read the value of the key that is the method's name.
    ## See [std-sys.map.new](../../spec/std/sys.md#r-std-sys.map.new).
    pub fn new(values: Map[string, string]) -> ScriptedSys:
        ScriptedSys { values: values }

impl Sys for ScriptedSys:
    fn os(self) -> Result[string, SysError]:
        match self.values.get("os"):
            .Some(text) => .Ok(text)
            .None => .Err(SysError.Unsupported("os"))

    fn arch(self) -> Result[string, SysError]:
        match self.values.get("arch"):
            .Some(text) => .Ok(text)
            .None => .Err(SysError.Unsupported("arch"))

    fn hostname(self) -> Result[string, SysError]:
        match self.values.get("hostname"):
            .Some(text) => .Ok(text)
            .None => .Err(SysError.Unsupported("hostname"))

    fn cpu_count(self) -> Result[u32, SysError]:
        match self.values.get("cpu_count"):
            .Some(text) => match text.parse::[u32]():
                .Ok(count) => .Ok(count)
                .Err(_) => .Err(SysError.Unsupported("cpu_count"))
            .None => .Err(SysError.Unsupported("cpu_count"))
