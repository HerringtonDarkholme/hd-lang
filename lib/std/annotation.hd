# std.annotation: function facts (spec/lang/14-annotations.md#function-facts),
# the target kinds (#target-kinds), and the inline and cold decorators
# (#inline-and-cold). `facts_of`, `Target`, `Annotate`, `annotate`,
# `InlineHint`, `inline`, `Cold`, and `cold` are imported, not prelude names
# (r-annot.facts-of.declared, r-annot.target.declarations,
# r-annot.inline.declared).
use std.structure.Facts

# The facts that decorators attach to the module-level function `f`, in
# source order, as a `std.structure.Facts` (r-annot.facts-of.result.compiler-decorators). The
# compiler checks that the argument names such a function, without
# evaluating it, and lowers each call to that function's facts, so this body
# never runs.
@intrinsic("facts_of")
## The facts attached to the module-level function `f`; a compiler intrinsic.
## See [annot.facts-of.declared](../../spec/lang/14-annotations.md#r-annot.facts-of.declared).
pub fn facts_of[F](f: F) -> Facts:
    panic("intrinsic")

# The kinds of target a decorator value attaches to (r-annot.target.kind.fn
# and the rows after it); a newtype is `.Newtype` (Decorators D10).
## The kind of declaration a fact value may be attached to.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
@derive(Debug)
pub enum Target:
    Fn
    Data
    Enum
    Newtype
    Field
    Variant
    Param
    Trait
    Impl
    Method

# A fact on a fact type that limits its values to the listed kinds
# (r-annot.target.limit). The compiler recognizes this type by its qualified
# name, and it limits itself to data types and enums (r-annot.target.bootstrap).
@annotate(.Data, .Enum)
## The fact that limits a fact type's values to targets of the listed kinds.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
@derive(Debug)
pub struct Annotate:
    ## The target kinds the fact type allows.
    ## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
    pub kinds: List[Target]

# `T`, when written as in `@annotate::[F](.Field)` or
# `@annotate::[fn(T) -> R](.Fn)`, is a pattern over the fact type's own
# parameters that describes its target's type, which makes it a typed fact
# type (r-annot.typed-fact.declare, r-annot.typed-fact.pattern). The compiler
# reads it and checks each value (src/checker/typed-facts.ts). When omitted,
# it takes the default `Any`, and the fact type is untyped
# (r-annot.typed-fact.untyped.reference-values).
## The `@annotate` decorator: it attaches an `Annotate` fact listing the target `kinds`.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
pub fn annotate[T = &dyn Any](kinds...: List[Target]) -> Annotate:
    Annotate { kinds: kinds }

# How the compiler inlines a function. The compiler recognizes `inline` and
# `cold` by their qualified names and reads `inline`'s argument as written,
# so `facts_of` leaves their lines out (r-annot.inline.recognized,
# r-annot.inline.argument).
## How the compiler copies calls of a function: `.Auto` prefers a copy,
## `.Always` asks for one at every call, `.Never` copies none.
## See [annot.inline.recognized](../../spec/lang/14-annotations.md#r-annot.inline.recognized).
@derive(Eq)
@annotate(.Fn, .Method)
pub enum InlineHint:
    Auto
    Always
    Never

## The `@inline` decorator: a bare `@inline` is `@inline(.Auto)`.
## See [annot.inline.recognized](../../spec/lang/14-annotations.md#r-annot.inline.recognized).
pub fn inline(hint: InlineHint = .Auto) -> InlineHint:
    hint

## Marks a function unlikely to be called: never copied, and called through
## the function table.
## See [annot.inline.cold](../../spec/lang/14-annotations.md#r-annot.inline.cold).
@annotate(.Fn, .Method)
pub struct Cold: pass

## The `@cold` decorator.
## See [annot.inline.cold](../../spec/lang/14-annotations.md#r-annot.inline.cold).
pub fn cold() -> Cold:
    Cold {}
