# std.annotation: function facts (spec/lang/14-annotations.md#function-facts) and
# the target kinds (#target-kinds). `facts_of`, `Target`, `Annotate`, and
# `annotate` are imported, not prelude names (r-annot.facts-of.declared,
# r-annot.target.declarations).
use std.format.DebugWriter

# The facts that decorators attach to the module-level function `f`, in
# source order, as a `std.structure.Facts` (r-annot.facts-of.result). The
# compiler checks that the argument names such a function, without
# evaluating it, and lowers each call to that function's facts
# (src/checker/function-facts.ts), so this body never runs and the call has
# type `Facts`. The written result is `Any` because the modules that use
# `std.annotation`, such as `std.ops`, do not declare `std.structure`.
@intrinsic("facts_of")
## The facts attached to the module-level function `f`; a compiler intrinsic.
## See [annot.facts-of.declared](../../spec/lang/14-annotations.md#r-annot.facts-of.declared).
pub fn facts_of[F](f: F) -> dyn Any:
    panic("intrinsic")

# The kinds of target a decorator value attaches to (r-annot.target.kind.fn
# and the rows after it); a newtype is `.Newtype` (Decorators D10).
## The kind of declaration a fact value may be attached to.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
pub enum Target:
    Fn
    Data
    Enum
    Newtype
    Field
    Variant
    Param
    Trait
    Impl
    Method

# A fact on a fact type that limits its values to the listed kinds
# (r-annot.target.limit). The compiler recognizes this type by its qualified
# name, and it limits itself to data types and enums (r-annot.target.bootstrap).
@annotate(.Data, .Enum)
## The fact that limits a fact type's values to targets of the listed kinds.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
pub data Annotate:
    ## The target kinds the fact type allows.
    ## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
    pub kinds: List[Target]

# `T`, when written as in `@annotate::[F](.Field)` or
# `@annotate::[fn(T) -> R](.Fn)`, is a pattern over the fact type's own
# parameters that describes its target's type, which makes it a typed fact
# type (r-annot.typed-fact.declare, r-annot.typed-fact.pattern). The compiler
# reads it and checks each value (src/checker/typed-facts.ts). When omitted,
# it takes the default `Any`, and the fact type is untyped
# (r-annot.typed-fact.untyped).
## The `@annotate` decorator: it attaches an `Annotate` fact listing the target `kinds`.
## See [annot.target.declarations](../../spec/lang/14-annotations.md#r-annot.target.declarations).
pub fn annotate[T = dyn Any](kinds...: List[Target]) -> Annotate:
    Annotate { kinds: kinds }

# The derived builder calls, written by hand because `@derive` does not
# run inside lib/std (r-std-format.debug.std-types).
impl Debug for Target:
    fn debug(self, out: mut DebugWriter) -> void:
        name := match self:
            .Fn => "Target.Fn"
            .Data => "Target.Data"
            .Enum => "Target.Enum"
            .Newtype => "Target.Newtype"
            .Field => "Target.Field"
            .Variant => "Target.Variant"
            .Param => "Target.Param"
            .Trait => "Target.Trait"
            .Impl => "Target.Impl"
            .Method => "Target.Method"
        out.write(name)

impl Debug for Annotate:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Annotate").field("kinds", self.kinds).finish()
