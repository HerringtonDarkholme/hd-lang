# std.annotation: the shape surface (the former Common Shape Representation, removed from the spec in batch 42)
# and the target kinds (#target-kinds). Every shape name here is a prelude
# name; `Target`, `Annotate`, and `annotate` are imported
# (r-annot.target.declarations). `shape` and `shape_of` are compiler
# intrinsics: the checker lowers `shape::[T]()` and `shape_of(f)` to generated
# builders over these declarations (src/checker/shapes.ts), so they are not
# declared here. `ShapeMetadata` is sealed; the generated code gives each
# concrete shape type its `metadata::[M]()` lookup.

# An opaque identity the compiler allocates. The prototype numbers the
# declarations of the one module it compiles.
pub data DeclarationId:
    pub value: i32

pub data SourcePosition:
    pub file: string
    pub line: i32
    pub column: i32

pub enum DeclarationKind:
    Data
    Enum
    Function
    Field
    Variant
    Parameter

pub enum PrimitiveKind:
    Bool
    Signed(bits: i32)
    Unsigned(bits: i32)
    Float(bits: i32)
    Char
    String
    Void
    Never

pub enum TypeShape:
    Primitive(kind: PrimitiveKind)
    Optional(inner: TypeShape)
    List(element: TypeShape)
    Map(key: TypeShape, value: TypeShape)
    Tuple(elements: List[TypeShape])
    Named(decl: DeclarationId, args: List[TypeShape])
    Newtype(decl: DeclarationId, base: TypeShape)
    Mut(inner: TypeShape)
    Trait(decl: DeclarationId, args: List[TypeShape])
    Any
    Suspend(result: TypeShape)
    Fn(
        params: List[TypeShape],
        result: TypeShape,
        suspending: bool,
        requirements: List[TypeShape],
    )

pub data FieldShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub position: i32
    pub doc: string?
    pub field_type: TypeShape

pub data DataShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub doc: string?
    pub field_list: List[FieldShape]

pub data VariantShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub position: i32
    pub doc: string?
    pub payload: List[FieldShape]

pub data EnumShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub doc: string?
    pub variant_list: List[VariantShape]

pub data ParamShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub position: i32
    pub doc: string?
    pub param_type: TypeShape
    pub has_default: bool

pub data FnShape:
    pub id: DeclarationId
    pub name: string
    pub qualified_name: string
    pub source: SourcePosition
    pub doc: string?
    pub params: List[ParamShape]
    pub result: TypeShape
    pub suspending: bool
    pub requirements: List[TypeShape]

pub trait ShapeMetadata:
    fn metadata[reified M](self) -> M?

impl TypeShape:
    pub fn is_optional(self) -> bool:
        match self:
            .Optional(_) => true
            _ => false

# The kinds of target a decorator value attaches to (r-annot.target.kind.fn
# and the rows after it); a newtype is `.Newtype` (Decorators D10).
pub enum Target:
    Fn
    Data
    Enum
    Newtype
    Field
    Variant
    Param
    Trait
    Impl
    Method

# A fact on a fact type that limits its values to the listed kinds
# (r-annot.target.limit). The compiler recognizes this type by its qualified
# name, and it limits itself to data types and enums (r-annot.target.bootstrap).
@annotate(.Data, .Enum)
pub data Annotate:
    pub kinds: List[Target]

# `T`, when written as in `@annotate::[F](.Field)`, names the fact type's
# parameter that stands for its target's type, which makes it a typed fact
# type (r-annot.typed-fact.declare). The compiler reads it and checks each
# value (src/checker/typed-facts.ts). When omitted, it takes the default
# `Any`, and the fact type is untyped (r-annot.typed-fact.untyped).
pub fn annotate[T = Any](kinds...: List[Target]) -> Annotate:
    Annotate { kinds: kinds }
