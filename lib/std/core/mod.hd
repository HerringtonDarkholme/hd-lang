use std.num.Num
use std.ops.Tuple
use std.meta.inline
use std.rt.{FoldHasher, hash_integer, hash_string}
use std.meta.{Structure, UnionType, Walker, Variant, Field}
use std.iter.{DoubleEndedIterator, ExactSizeIterator, Iterable, Iterator, Rev}
use std.ops.{FromListLiteral, Index, IndexMut, IndexSet}
use std.rt.{Drop, Ptr, address_of, align_of, alloc_counted, copy_bytes, empty_block, is_unique, make_unique, needs_drop, panic_with, size_of, tail_of}

# std.core: the language's core declarations
# (spec/lang/10-modules.md#core-layer). The compiler supplies the
# primitives, `Map`, `Option`, `Result`, the `Any` traits, `panic`
# and `box` (hd_resolve::seed). The traits below are the ones those
# declarations name: `List[T < Copy]` and `Map[K < Eq & Hash, V]`.
# `std.ops`, `std.cmp` and `std.hash` re-export them. Other dependencies
# follow the ordinary module import rules.

# The compiler-known marker for a value that copies
# (spec/lang/13-values-and-references.md#copy). A prelude name.
## Marks a type whose values copy. The compiler answers it from the type's structure: every type is `Copy` but a `&mut T`, a type declared `impl !Copy`, a type parameter declared `?Copy`, and a type that holds one by value. A type parameter is `Copy` unless it is declared `?Copy`. No code implements it.
## See [ref.copy.marker](../../../spec/lang/13-values-and-references.md#r-ref.copy.marker).
pub trait Copy:
    pass

## The one equality trait: `==` and `!=` invoke its `eq`, which must be reflexive.
## See [trait.cmp.equality](../../../spec/lang/09-traits.md#r-trait.cmp.equality).
pub trait Eq < ?Copy:
    fn eq(&self, other: &Self) -> bool

## A sink that hashes the bytes written to it; its methods change it through `&mut self`.
## See [trait.hash.generic-hasher](../../../spec/lang/09-traits.md#r-trait.hash.generic-hasher).
pub trait Hasher:
    fn write(&mut self, bytes: List[u8]) -> void

    ## Writes the byte `value`.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u8(&mut self, value: u8) -> void:
        self.write([value])

    ## Writes the 2 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u16(&mut self, value: u16) -> void:
        self.write(unsigned_bytes(u64(value), 2))

    ## Writes the 4 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u32(&mut self, value: u32) -> void:
        self.write(unsigned_bytes(u64(value), 4))

    ## Writes the 8 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u64(&mut self, value: u64) -> void:
        self.write(unsigned_bytes(value, 8))

    ## Writes the 4 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_usize(&mut self, value: usize) -> void:
        self.write(unsigned_bytes(u64(value), 4))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i8(&mut self, value: i8) -> void:
        self.write_u8(u8(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i16(&mut self, value: i16) -> void:
        self.write_u16(u16(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i32(&mut self, value: i32) -> void:
        self.write_u32(u32(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i64(&mut self, value: i64) -> void:
        self.write_u64(u64(value))

    ## Writes the UTF-8 bytes of `text`, with no length, as `write` would.
    ## See [trait.hash.typed-methods](../../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_str(&mut self, text: string) -> void:
        self.write(text.to_utf8())

## A type whose values write their hash bytes to a `Hasher`; a map key needs it with `Eq`.
## See [trait.hash.module](../../../spec/lang/09-traits.md#r-trait.hash.module).
pub trait Hash < ?Copy:
    fn hash[H < Hasher](&self, state: &mut H) -> void
    ## A 32-bit hash of this value under `seed`, for a hash table's buckets:
    ## by default the seeded default hasher's digest of `hash`'s bytes.
    ## Integers and strings override it with a one-step hash.
    ## See [trait.hash.hash-one](../../../spec/lang/09-traits.md#r-trait.hash.hash-one).
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        let mut state = FoldHasher::with_seed(seed)
        self.hash(&mut state)
        u32(state.finish())

## The number of bytes in `text`.
@intrinsic("bytes_len")
pub fn bytes_len(text: string) -> usize:
    panic("intrinsic")

## The offset of the first differing byte, or the shorter length when one string is a prefix of the other.
@intrinsic("bytes_mismatch")
pub fn bytes_mismatch(left: string, right: string) -> usize:
    panic("intrinsic")

## The scalar value of `value`: a `char` is its scalar value at run time.
@intrinsic("char_scalar")
pub fn char_scalar(value: char) -> u32:
    panic("intrinsic")

fn unsigned_bytes(value: u64, count: usize) -> List[u8]:
    let mut bytes: List[u8] = []
    let rest = value
    let index: usize = 0
    while index < count:
        bytes.push(u8(rest & 255))
        rest = rest >> 8
        index = index + 1
    bytes

impl string:
    # A copy of the bytes, in one sized allocation and one copy.
    ## Returns the string's bytes as a new list.
    ## See [std-text.utf8.round-trip](../../../spec/std/text.md#r-std-text.utf8.round-trip).
    @intrinsic("string_to_bytes")
    pub fn to_utf8(self) -> List[u8]:
        panic("intrinsic")

# Equality and order of the primitives (spec/lang/05-expressions.md#r-expr.eq.std,
# #r-expr.ord.std). The number types, `char`, and `bool` compare through
# intrinsic methods (spec/lang/09-traits.md#intrinsic-methods), whose bodies
# the compiler supplies, so no body is written with the operator it
# implements. Floats follow IEEE 754: NaN is unequal to itself and
# unordered, and they have no `Ord` (#r-expr.eq.float, #r-expr.ord.total).
# Characters order by scalar value (#r-expr.ord.std.char-scalar), and
# `bool` has `Eq` only.
# Keep handwritten Eq: implement the builtin scalar protocol, which has no derivable declaration.
impl[N < Num] Eq for N:
    @intrinsic
    fn eq(&self, other: &N) -> bool

# Keep handwritten Eq: implement the builtin scalar protocol, which has no derivable declaration.
impl Eq for char:
    @intrinsic
    fn eq(&self, other: &char) -> bool

# Keep handwritten Eq: implement the builtin scalar protocol, which has no derivable declaration.
impl Eq for bool:
    @intrinsic
    fn eq(&self, other: &bool) -> bool

# Strings are hd over their bytes, not intrinsics, and order by byte
# (#r-expr.ord.std.string-bytes).
# Keep handwritten Eq: implement the builtin scalar protocol, which has no derivable declaration.
impl Eq for string:
    fn eq(&self, other: &string) -> bool:
        self.len() == other.len() && bytes_mismatch(*self, *other) == self.len()

# Equality and order of the built-in composites
# (spec/lang/05-expressions.md#r-expr.eq.std, #r-expr.ord.std). `==`, `<`, and
# the other comparison operators call these through `Eq.eq` and
# `PartialOrd.partial_cmp`. Tuples compare through the tuple templates
# at the end of this module.

# Lists are equal when they have the same length and equal elements in order.
# Keep handwritten Eq: compare logical entries rather than backing storage.
impl[T < Eq] Eq for List[T]:
    fn eq(&self, other: &List[T]) -> bool:
        if self.len() != other.len():
            return false
        let index: usize = 0
        while index < self.len():
            if self[index] != other[index]:
                return false
            index = index + 1
        true

# Keep handwritten Eq: compare the builtin variants, which have no derivable declaration.
impl[T < ?Copy & Eq] Eq for T?:
    fn eq(&self, other: &Self) -> bool:
        match self:
            .Some(left) =>
                match other:
                    .Some(right) => left.eq(right)
                    .None => false
            .None =>
                match other:
                    .Some(_) => false
                    .None => true

# A reference is equal to another when the values they refer to are, so a
# derived `Eq` compares through a reference field
# (r-std-cmp.ref.eq-noncopy). `==` written between two references is
# an error (lang/13 ref.identity.no-equality): a generic `==` and a derived
# `Eq` reach this impl.
# Keep handwritten Eq: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Eq] Eq for *T:
    fn eq(&self, other: &Self) -> bool:
        *(*self) == *(*other)

# Keep handwritten Eq: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Eq] Eq for *mut T:
    fn eq(&self, other: &Self) -> bool:
        *(*self) == *(*other)

# Keep handwritten Eq: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Eq] Eq for &T:
    fn eq(&self, other: &Self) -> bool:
        *(*self) == *(*other)

# Keep handwritten Eq: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Eq] Eq for &mut T:
    fn eq(&self, other: &Self) -> bool:
        *(*self) == *(*other)

# Keep handwritten Eq: compare the builtin variants, which have no derivable declaration.
impl[T < ?Copy & Eq, E < ?Copy & Eq] Eq for Result[T, E]:
    fn eq(&self, other: &Result[T, E]) -> bool:
        match self:
            .Ok(left) =>
                match other:
                    .Ok(right) => left.eq(right)
                    .Err(_) => false
            .Err(left) =>
                match other:
                    .Err(right) => left.eq(right)
                    .Ok(_) => false

# Maps are equal when they have the same keys, each with an equal value, in
# any order (spec/lang/05-expressions.md#r-expr.eq.map-order).
# Keep handwritten Eq: compare logical entries rather than backing storage.
impl[K < Eq & Hash, V < Eq] Eq for Map[K, V]:
    fn eq(&self, other: &Map[K, V]) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in self:
            found := match other.get(*key):
                .Some(hit) => hit
                .None => return false
            if found != value:
                return false
        true

# Derived `Eq` (spec/std/cmp.md#derived-equality): `self` and `other` are
# equal when they hold the same variant and every member of `self` equals
# the same member of `other`. The walk stops at the first difference.
impl[T < ?Copy] Eq for T by Structure:
    fn eq(&self, other: &T) -> bool:
        let mut w = EqualWalker::[T] { other: other }
        match Structure::walk(self, &mut w):
            .Ok(_) => true
            .Err(_) => false

# Union `Eq`: the ordinary enum derivation over the active positional case.
impl[T < ?Copy & UnionType] Eq for T by Structure:
    fn eq(&self, other: &T) -> bool:
        let mut w = EqualWalker::[T] { other: other }
        match Structure::walk(self, &mut w):
            .Ok(_) => true
            .Err(_) => false

# The fields are public because the prototype checks the instantiated
# walker in the deriving module. A walk's `.Err` only stops it.
struct EqualWalker[S < ?Copy, 'a]:
    pub other: &'a S

impl['a, S < ?Copy] Walker[S] for EqualWalker[S, 'a]:
    type Error = bool

    fn variant(&mut self, v: Variant[S]) -> Result[void, bool]:
        if v.holds(self.other):
            return .Ok(())
        .Err(false)

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Eq` here, as `member` needs `F < Eq`.
    fn rest[T < Eq](&mut self, h: Field[S, List[T]], items: &List[T]) -> Result[void, bool]:
        self.member(h, items)

    fn member[F < ?Copy & Eq](&mut self, h: Field[S, F], value: &F) -> Result[void, bool]:
        if value.eq(h.get(self.other)):
            return .Ok(())
        .Err(false)

# Tuple comparison (spec/std/cmp.md#tuple-comparison): the derived walkers,
# element by element, in order, at every size. A tuple has one variant, so
# no walk reads `other`'s variant index. A rest element compares as its
# list (r-std-cmp.tuple.rest).
impl[T < ?Copy & Tuple] Eq for T by Structure:
    fn eq(&self, other: &T) -> bool:
        let mut w = EqualWalker::[T] { other: other }
        match Structure::walk(self, &mut w):
            .Ok(_) => true
            .Err(_) => false

# `never` has no value, so `eq` never runs (r-std-text.parse.never-traits).
# Keep handwritten Eq: this uninhabited builtin has no value or derivable declaration.
impl Eq for never:
    fn eq(&self, other: &never) -> bool:
        match *self:
            _ => panic("never has no value")

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for string:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(bytes_len(*self)))
        state.write_str(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_string(*self, seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for char:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        char_scalar(*self).hash(state)

# An optional writes the tag byte 0 for `.None`, or 1 and then its payload.
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < ?Copy & Hash] Hash for T?:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        match self:
            .None => state.write_u8(0)
            .Some(value) =>
                state.write_u8(1)
                value.hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for *T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for *mut T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for &T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for &mut T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# A result writes the tag byte 0 and then its `.Ok` payload, or 1 and then
# its `.Err` payload (spec/std/hash.md#r-std-hash.bytes.result).
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < ?Copy & Hash, E < ?Copy & Hash] Hash for Result[T, E]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        match self:
            .Ok(value) =>
                state.write_u8(0)
                value.hash(state)
            .Err(error) =>
                state.write_u8(1)
                error.hash(state)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for bool:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let byte: u8 = 0
        if *self:
            byte = 1
        state.write_u8(byte)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i8:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i8(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(u8(*self)), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i16:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i16(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(u16(*self)), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i32:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i32(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(u32(*self)), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i64:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i64(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(*self), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u8:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u8(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(*self), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u16:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u16(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(*self), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u32:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u32(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(*self), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for usize:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_usize(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(u64(*self), seed)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u64:
    @inline(.Always)
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(*self)
    @inline(.Always)
    fn hash_one(&self, seed: u64) -> u32:
        hash_integer(*self, seed)

# A list hashes its length as a `u64`, then each item in order
# (spec/std/hash.md#list-hashing), so equal lists hash the same.
# Keep handwritten Hash: hash the logical length and entries, not backing storage.
impl[T < Hash] Hash for List[T]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(self.len()))
        for item in self:
            item.hash(state)

# Derived `Hash` (spec/std/hash.md#derived-hashing): an enum's variant index
# as a `u32`, then each member in declaration order.
impl[T < ?Copy] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# Union `Hash`: the ordinary enum derivation, including the active case index.
impl[T < ?Copy & UnionType] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# The field is public because the prototype checks the instantiated walker
# in the deriving module.
struct HashWalker[S < ?Copy, H < Hasher, 'a]:
    pub state: &'a mut H

impl['a, S < ?Copy, H < Hasher] Walker[S] for HashWalker[S, H, 'a]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        if !v.info.of_data:
            u32(v.info.index).hash(&mut *self.state)
        .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Hash` here, as `member` needs `F < Hash`.
    fn rest[T < Hash](&mut self, h: Field[S, List[T]], items: &List[T]) -> Result[void, never]:
        self.member(h, items)

    fn member[F < ?Copy & Hash](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        value.hash(&mut *self.state)
        .Ok(())

# Tuple hashing (spec/std/hash.md#tuple-hashing): each element in order, at
# every size. A rest element hashes as its `List`, so a rest tuple is
# hashable when its rest's items are (r-std-hash.tuple.rest-list).
impl[T < ?Copy & Tuple] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# `List[T]`, a copy-on-write list over one counted block (#2369). The list
# is one `*ListHead[T]`: one word, one hop. The block holds the capacity,
# the length, a word naming `T` and a spare word, then the `T`s from
# payload offset 16 (crates/hd_wasm/DESIGN.md §23.7), the layout the host
# ABI and the runtime's own lists use. A copy of a list is a retain of its
# block; a change first tests that the block is unique and copies it on a
# cold path otherwise, as Swift's `ContiguousArray`. Every empty list
# shares the static empty block (count 0), so `len` and indexing never
# test for null and the first push takes the cold path. The other list
# methods are std.collections.list's.
## A list block's header.
struct ListHead[T]:
    cap: usize
    len: usize
    # Never read: its type names `T`, so the cycle analysis and markers
    # read the tail's values as the header's parts, as `Buffer[T]`'s field.
    elems: Ptr[T]
    spare: usize

impl[T] !Copy for ListHead[T]

# The values' offset from the payload: `tail_of`'s, at `T`'s alignment.
@inline(.Always)
fn elem_offset[T]() -> usize:
    a := align_of::[T]()
    ((8 + size_of::[ListHead[T]]() + a - 1) & ~(a - 1)) - 8

impl[T] Drop for ListHead[T]:
    # The block's last release: its live values go with it, once. The
    # collector's trace runs this glue too, and so visits each value once.
    fn drop(&mut self) -> void:
        if needs_drop::[T]():
            e := Ptr::[T] { address: address_of(self) + elem_offset::[T]() }
            n := self.len
            let mut i: usize = 0
            while i < n:
                _ := e.offset(i).read()
                i += 1

# A bounds test's cold arm, out of line: a test site is one call with no
# arguments, as the builtin list's `rt:panic`, rather than four message
# words and an index pushed at every site (lane 297 issue 2).
@inline(.Never)
fn out_of_bounds() -> never:
    panic_never("index-out-of-bounds", "list index out of bounds")

# `std.rt.panic_with` at its `never` type, as `std.rt.alloc` declares it.
@intrinsic("panic")
fn panic_never(category: string, message: string) -> never:
    panic("intrinsic")

## A copy-on-write list over one counted block.
pub struct List[T]:
    block: *ListHead[T]

impl[T] List[T]:
    # An empty list; it allocates nothing.
    fn new() -> List[T]:
        List::[T] { block: empty_block::[ListHead[T]]() }

    ## Returns an empty list with room for at least `capacity` elements.
    ## See [std-collections.list.with-capacity](../../../spec/std/collections.md#r-std-collections.list.with-capacity).
    pub fn with_capacity(capacity: usize) -> List[T]:
        if capacity == 0:
            return List::[T].new()
        List::[T] { block: List::[T].alloc(capacity, 0) }

    # A new block with room for at least `want` values and length `len`:
    # one call, as the builtin list's `rt:list_buf`, so a caller carries
    # no size check of its own.
    @inline(.Never)
    fn alloc(want: usize, len: usize) -> *ListHead[T]:
        size := size_of::[T]()
        if want > 0xfffe0000 / (if size == 0: 1 else: size):
            panic_with("heap-exhausted", "a list does not fit the heap")
        head := ListHead::[T] { cap: want, len: len, elems: Ptr::[T] { address: 0 }, spare: 0 }
        alloc_counted::[ListHead[T]](head, want * size, align_of::[T]())

    @inline(.Always)
    fn head(&self) -> Ptr[ListHead[T]]:
        List::[T].head_of(self.block)

    # The header of `block`, to write through.
    @inline(.Always)
    fn head_of(block: *ListHead[T]) -> Ptr[ListHead[T]]:
        Ptr::[ListHead[T]] { address: tail_of(block, 1).address - size_of::[ListHead[T]]() }

    @inline(.Always)
    fn elems(&self) -> Ptr[T]:
        Ptr::[T] { address: tail_of(self.block, align_of::[T]()).address }

    # Reads go through the `*ListHead[T]` itself: a field load the loop
    # passes see (#2368); writes go through `head()`, to a unique block.
    @inline(.Always)
    pub fn len(&self) -> usize:
        self.block.len

    @inline(.Always)
    fn capacity(&self) -> usize:
        self.block.cap

    ## True exactly when the list has no elements.
    ## See [std-collections.access.is-empty](../../../spec/std/collections.md#r-std-collections.access.is-empty).
    @inline(.Always)
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    # The checked read beside `items[i]` (r-std-collections.access.get-copy).
    ## Returns `.Some` of a copy of the element at `index`, or `.None` when `index` is not less than `len()`. It never panics.
    ## See [std-collections.access.get-copy](../../../spec/std/collections.md#r-std-collections.access.get-copy).
    @inline(.Always)
    pub fn get(&self, index: usize) -> T?:
        if index >= self.len(): .None else: .Some(*self.elems().offset(index).as_ref())

    # `push` is the built-in list push over the block (#2369): the
    # checker reads `xs.push(v)` as `ListPush`, whose uniqueness test the
    # ownership passes hoist out of a loop, and the backend grows the block
    # as it grows a list's buffer, the same layout.

    # Replaces the value at `index`; a shared block is copied first.
    @inline(.Always)
    fn set(&mut self, index: usize, value: T) -> void:
        if index >= self.len():
            out_of_bounds()
        make_unique(self)
        at := self.elems().offset(index)
        if needs_drop::[T]():
            _ := at.read()
        at.write(value)

    ## Removes and returns the last item, or `.None` for an empty list.
    ## See [module.method.list-pop](../../../spec/lang/10-modules.md#r-module.method.list-pop).
    pub fn pop(&mut self) -> T?:
        n := self.len()
        if n == 0:
            return .None
        make_unique(self)
        self.head().as_mut().len = n - 1
        .Some(self.elems().offset(n - 1).read())

    ## Puts `value` at `index` and moves the later items up one place; `index == len()` appends.
    ## See [module.method.list-insert](../../../spec/lang/10-modules.md#r-module.method.list-insert).
    pub fn insert(&mut self, index: usize, value: T) -> void:
        n := self.len()
        if index > n:
            panic_with("index-out-of-bounds", "list insert index ${index} out of bounds for length ${n}")
        if !is_unique(self.block) || n == self.capacity():
            self.block = List::[T].grown(self.block, n + 1, is_unique(self.block))
        e := self.elems()
        size := size_of::[T]()
        copy_bytes(e.offset(index + 1).address, e.offset(index).address, (n - index) * size)
        e.offset(index).write(value)
        self.head().as_mut().len = n + 1

    ## Removes and returns the item at `index`, moving the later items down one place.
    ## See [module.method.list-remove-indexed](../../../spec/lang/10-modules.md#r-module.method.list-remove-indexed).
    pub fn remove(&mut self, index: usize) -> T:
        n := self.len()
        if index >= n:
            panic_with("index-out-of-bounds", "list remove index ${index} out of bounds for length ${n}")
        make_unique(self)
        e := self.elems()
        out := e.offset(index).read()
        copy_bytes(e.offset(index).address, e.offset(index + 1).address, (n - index - 1) * size_of::[T]())
        self.head().as_mut().len = n - 1
        out

    ## Removes elements after `len`; a greater length has no effect.
    ## See [std-collections.list.truncate](../../../spec/std/collections.md#r-std-collections.list.truncate).
    pub fn truncate(&mut self, len: usize) -> void:
        n := self.len()
        if len >= n:
            return
        make_unique(self)
        # The length first: a value's drop sees the list already short.
        self.head().as_mut().len = len
        if needs_drop::[T]():
            e := self.elems()
            let mut i = len
            while i < n:
                _ := e.offset(i).read()
                i += 1

    ## Reserves room for `additional` elements without changing the length.
    ## See [std-collections.list.reserve](../../../spec/std/collections.md#r-std-collections.list.reserve).
    pub fn reserve(&mut self, additional: usize) -> void:
        need := self.len() + additional
        if !is_unique(self.block) || need > self.capacity():
            self.block = List::[T].grown(self.block, need, is_unique(self.block))

    ## Removes every item, so `len()` is 0 after it.
    ## See [module.method.list-clear](../../../spec/lang/10-modules.md#r-module.method.list-clear).
    pub fn clear(&mut self) -> void:
        self.truncate(0)

    # Appends `other`'s items as they were at the call, so
    # `items.extend(items)` doubles the list (r-std-collections.access.extend.self).
    ## Appends each element of `other` to the list, in order, as `push` does.
    ## See [std-collections.access.extend](../../../spec/std/collections.md#r-std-collections.access.extend).
    pub fn extend(&mut self, other: List[T]) -> void:
        m := other.len()
        if m == 0:
            return
        n := self.len()
        self.reserve(m)
        to := self.elems().offset(n)
        from := other.elems()
        if needs_drop::[T]():
            # Each value takes its own count: `other` keeps its own.
            let mut i: usize = 0
            while i < m:
                to.offset(i).write(*from.offset(i).as_ref())
                i += 1
        else:
            copy_bytes(to.address, from.address, m * size_of::[T]())
        self.head().as_mut().len = n + m

    # A unique block with room for `need` values in place of `old`, which
    # the caller replaces with it: a unique `old` (`unique`, tested by the
    # caller before this call's copy of it) grows geometrically (the most
    # of need and twice the capacity plus 4) and its values move; a shared
    # one is copied at the most of need and the length. The block goes in
    # and out by value, so a caller's loop never lends its list to this
    # cold call and keeps the block in a local.
    @inline(.Never)
    fn grown(old: *ListHead[T], need: usize, unique: bool) -> *ListHead[T]:
        n := old.len
        cap := old.cap
        let mut want = n
        if want < need:
            want = need
        if unique && want < cap * 2 + 4:
            # The builtin's growth: with the block's 24 bytes before the
            # values, 8-byte values fill a block of a power of two less 8.
            want = cap * 2 + 4
        fresh := List::[T].alloc(want, n)
        to := Ptr::[T] { address: tail_of(fresh, align_of::[T]()).address }
        from := Ptr::[T] { address: tail_of(old, align_of::[T]()).address }
        if unique || !needs_drop::[T]():
            copy_bytes(to.address, from.address, n * size_of::[T]())
        else:
            # Each value of a shared block takes its own count.
            let mut i: usize = 0
            while i < n:
                to.offset(i).write(*from.offset(i).as_ref())
                i += 1
        if unique:
            # The values moved: the old block's last release drops none.
            List::[T].head_of(old).as_mut().len = 0
        fresh

## A list literal's builder: the block, with its length and capacity in
## fields rather than only in the block, so once inlined they are locals.
## A literal of N values is then one allocation, N stores and one length
## store, as the builtin list's: each push's room test compares two known
## numbers and folds. A push past the capacity (a spread with no count)
## grows the block on the cold path. The block's own length is written
## when it grows and when the list is built, so a builder dropped before
## `build` leaks its values instead of dropping them twice.
pub struct ListBuilder[T]:
    block: *ListHead[T]
    len: usize
    cap: usize

impl[T] FromListLiteral[T] for List[T]:
    type Builder = ListBuilder[T]

    @inline(.Always)
    fn builder(capacity: usize) -> ListBuilder[T]:
        block := if capacity == 0: empty_block::[ListHead[T]]() else: List::[T].alloc(capacity, 0)
        ListBuilder { block: block, len: 0, cap: capacity }

    @inline(.Always)
    fn push(builder: &mut ListBuilder[T], value: T) -> void:
        n := builder.len
        if n == builder.cap:
            # A static empty block (capacity 0) is copied, a full one grown.
            if n != 0:
                List::[T].head_of(builder.block).as_mut().len = n
            builder.block = List::[T].grown(builder.block, n + 1, n != 0)
            builder.cap = builder.block.cap
        Ptr::[T] { address: tail_of(builder.block, align_of::[T]()).address }.offset(n).write(value)
        builder.len = n + 1

    @inline(.Always)
    fn build(builder: ListBuilder[T]) -> List[T]:
        if builder.len != 0:
            List::[T].head_of(builder.block).as_mut().len = builder.len
        List::[T] { block: builder.block }

impl[T] Index[usize] for List[T]:
    type Out = T
    @inline(.Always)
    fn index(&self, key: usize) -> &T:
        if key >= self.len():
            out_of_bounds()
        self.elems().offset(key).as_ref()

# `&mut xs[i]`, a field write and a compound assignment through `xs[i]`:
# the element's loan borrows the whole list (the receiver is `&mut self`),
# as Rust's `Vec`, so no push or other change can move the block under it.
impl[T] IndexMut[usize] for List[T]:
    @inline(.Always)
    fn index_mut(&mut self, key: usize) -> &mut T:
        if key >= self.len():
            out_of_bounds()
        make_unique(self)
        self.elems().offset(key).as_mut()

# `xs[i] = v`: `set`, which drops the value it replaces.
impl[T] IndexSet[usize, T] for List[T]:
    @inline(.Always)
    fn index_set(&mut self, key: usize, value: T) -> void:
        self.set(key, value)

## The cursor of a list's `iter`: its elements in order. It holds the
## list, so its block stays alive while it yields the values by copy.
## See [std-iter.cursor.list](../../../spec/std/iter.md#r-std-iter.cursor.list).
pub struct ListIter[T]:
    list: List[T]
    at: usize
    end: usize

impl[T] Iterable[T] for List[T]:
    type IntoIter = ListIter[T]
    @inline(.Always)
    fn iter(self) -> ListIter[T]:
        n := self.len()
        ListIter { list: self, at: 0, end: n }

impl[T] Iterator[T] for ListIter[T]:
    @inline(.Always)
    fn next(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        v := *self.list.elems().offset(self.at).as_ref()
        self.at += 1
        .Some(v)

impl[T] ExactSizeIterator[T] for ListIter[T]:
    @inline(.Always)
    fn len(&self) -> usize:
        self.end - self.at

impl[T] DoubleEndedIterator[T] for ListIter[T]:
    @inline(.Always)
    fn next_back(&mut self) -> T?:
        if self.at >= self.end:
            return .None
        self.end -= 1
        .Some(*self.list.elems().offset(self.end).as_ref())

impl[T] ListIter[T]:
    ## Reverses the remaining sequence without advancing or buffering it.
    ## See [std-iter.double-ended.rev](../../../spec/std/iter.md#r-std-iter.double-ended.rev).
    pub fn rev(self) -> Rev[Self, T]:
        DoubleEndedIterator::[T]::rev(self)

