## Applies one statically dispatched rule. Concrete built-in facts contain only rule data.
pub trait Rule[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void

## Strings count Unicode scalars; collections count elements or entries.
pub trait HasLength:
    fn length(&self) -> usize

impl HasLength for string:
    fn length(&self) -> usize:
        self.chars().count()

impl[T] HasLength for List[T]:
    fn length(&self) -> usize:
        self.len()

impl[K < Eq & Hash, V] HasLength for Map[K, V]:
    fn length(&self) -> usize:
        self.len()

impl[T < HasLength] HasLength for T?:
    fn length(&self) -> usize:
        match self:
            .Some(value) => value.length()
            .None => 0

@annotate::[F](.Field)
pub struct Range[F]:
    low: F
    high: F
    message: string?

impl[F < Validate] Rule[F] for Range[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        if !valid_bounds(&self.low, &self.high, context):
            return
        low := value.partial_cmp_of(&self.low)
        high := value.partial_cmp_of(&self.high)
        match (low, high):
            (.Ok(.Some(.Less)), _) =>
                context.reject(
                    "range",
                    rule_message(self.message, "must be within the allowed range"),
                )
            (_, .Ok(.Some(.Greater))) =>
                context.reject(
                    "range",
                    rule_message(self.message, "must be within the allowed range"),
                )
            (.Ok(.Some(_)), .Ok(.Some(_))) => pass
            _ => context.definition("range requires ordered values")

@annotate::[F](.Field)
pub struct Min[F]:
    bound: F
    message: string?

impl[F < Validate] Rule[F] for Min[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match value.partial_cmp_of(&self.bound):
            .Ok(.Some(.Less)) =>
                context.reject("min", rule_message(self.message, "must not be below the minimum"))
            .Ok(.Some(_)) => pass
            _ => context.definition("min requires ordered values")

@annotate::[F](.Field)
pub struct Max[F]:
    bound: F
    message: string?

impl[F < Validate] Rule[F] for Max[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match value.partial_cmp_of(&self.bound):
            .Ok(.Some(.Greater)) =>
                context.reject("max", rule_message(self.message, "must not exceed the maximum"))
            .Ok(.Some(_)) => pass
            _ => context.definition("max requires ordered values")

@derive(Debug, Eq)
@annotate::[F](.Field)
pub struct Length[F]:
    minimum: usize
    maximum: usize
    message: string?

impl[F < Validate] Rule[F] for Length[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        if self.minimum > self.maximum:
            context.definition("length minimum exceeds maximum")
            return
        match value.length_of():
            .Some(size) =>
                if size < self.minimum || size > self.maximum:
                    context.reject("length", rule_message(self.message, "has the wrong length"))
            .None => context.definition("length requires a value with length")

@annotate::[F](.Field)
pub struct MinLength[F]:
    minimum: usize
    message: string?

impl[F < Validate] Rule[F] for MinLength[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match value.length_of():
            .Some(size) =>
                if size < self.minimum:
                    context.reject("min-length", rule_message(self.message, "is too short"))
            .None => context.definition("min_length requires a value with length")

@annotate::[F](.Field)
pub struct MaxLength[F]:
    maximum: usize
    message: string?

impl[F < Validate] Rule[F] for MaxLength[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match value.length_of():
            .Some(size) =>
                if size > self.maximum:
                    context.reject("max-length", rule_message(self.message, "is too long"))
            .None => context.definition("max_length requires a value with length")

@annotate::[F](.Field)
pub struct ByteLength[F]:
    minimum: usize
    maximum: usize
    message: string?

impl[F < Validate] Rule[F] for ByteLength[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        if self.minimum > self.maximum:
            context.definition("byte_length minimum exceeds maximum")
            return
        match value.text_of():
            .Some(text) =>
                size := text.len()
                if size < self.minimum || size > self.maximum:
                    context.reject(
                        "byte-length",
                        rule_message(self.message, "has the wrong byte length"),
                    )
            .None => context.definition("byte_length requires text")

@annotate::[F](.Field)
pub struct Pattern[F]:
    source: string
    message: string?

impl[F < Validate] Rule[F] for Pattern[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        text := match value.text_of():
            .Some(text) => text
            .None =>
                context.definition("pattern requires text")
                return
        regex := match Regex::new(self.source):
            .Ok(regex) => regex
            .Err(error) =>
                context.definition("invalid pattern: $error")
                return
        if !regex.is_match(text):
            context.reject(
                "pattern",
                rule_message(self.message, "does not match the required pattern"),
            )

@annotate::[F](.Field)
pub struct Email[F]:
    message: string?

impl[F < Validate] Rule[F] for Email[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        text := match value.text_of():
            .Some(text) => text
            .None =>
                context.definition("email requires text")
                return
        regex := Regex::new(
            r"^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$",
        )
            .expect("the WHATWG email grammar compiles")
        if !regex.is_match(text):
            context.reject("email", rule_message(self.message, "must be a valid email address"))

@annotate::[F](.Field)
pub struct Url[F]:
    message: string?

impl[F < Validate] Rule[F] for Url[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        text := match value.text_of():
            .Some(text) => text
            .None =>
                context.definition("url requires text")
                return
        if HttpUrl::parse(text).is_err():
            context.reject("url", rule_message(self.message, "must be an absolute HTTP URL"))

@annotate::[F](.Field)
pub struct Uuid[F]:
    message: string?

impl[F < Validate] Rule[F] for Uuid[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        text := match value.text_of():
            .Some(text) => text
            .None =>
                context.definition("uuid requires text")
                return
        regex := Regex::new(
            r"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$",
        )
            .expect("the UUID grammar compiles")
        if !regex.is_match(text):
            context.reject("uuid", rule_message(self.message, "must be a UUID"))

@annotate::[F](.Field)
pub struct OneOf[F]:
    values: List[F]
    message: string?

impl[F < Validate] Rule[F] for OneOf[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        for allowed in self.values:
            match value.equal_to(&allowed):
                .Some(true) => return
                .Some(false) => pass
                .None =>
                    context.definition("one_of requires comparable values")
                    return
        context.reject("one-of", rule_message(self.message, "is not one of the allowed values"))

@annotate::[F](.Field)
pub struct Unique[F]:
    message: string?

impl[F < Validate] Rule[F] for Unique[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match value.unique_items():
            .Some(true) => pass
            .Some(false) =>
                context.reject("unique", rule_message(self.message, "must contain unique values"))
            .None => context.definition("unique requires comparable values")

@annotate::[F](.Field)
pub struct Check[F]:
    test: fn(&F) -> Result[void, Problem]
    message: string?

impl[F] Rule[F] for Check[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void:
        match (self.test)(value):
            .Ok(_) => pass
            .Err(problem) => context.reject(problem.code, self.message.unwrap_or(problem.message))

fn valid_bounds[F < Validate](low: &F, high: &F, context: &mut ValidationContext) -> bool:
    match low.partial_cmp_of(high):
        .Ok(.Some(.Less)) => true
        .Ok(.Some(.Equal)) => true
        .Ok(.Some(.Greater)) =>
            context.definition("range minimum exceeds maximum")
            false
        _ =>
            context.definition("range requires ordered bounds")
            false

fn rule_message(message: string?, fallback: string) -> string:
    message.unwrap_or(fallback)

fn apply_member_facts[S, F < Validate](
    value: &F,
    field: Field[S, F],
    context: &mut ValidationContext,
) -> void:
    match field.fact::[Range[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Min[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Max[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Length[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[MinLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[MaxLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[ByteLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Pattern[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Email[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Url[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Uuid[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[OneOf[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Unique[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Check[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass

fn apply_optional_facts[S, F < Validate](
    value: &F,
    field: Field[S, F?],
    context: &mut ValidationContext,
) -> void:
    match field.fact::[Range[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Min[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Max[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Length[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[MinLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[MaxLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[ByteLength[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Pattern[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Email[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Url[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Uuid[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[OneOf[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Unique[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass
    match field.fact::[Check[F]]():
        .Some(rule) => run_rule(&rule, value, context)
        .None => pass

fn run_rule[F, R < Rule[F]](rule: &R, value: &F, context: &mut ValidationContext) -> void:
    if context.begin():
        rule.apply(value, context)

## An inclusive lower and upper bound.
pub fn range[F < PartialOrd](low: F, high: F, message: string? = .None) -> Range[F]:
    Range::[F] { low: low, high: high, message: message }

## An inclusive lower bound.
pub fn min[F < PartialOrd](bound: F, message: string? = .None) -> Min[F]:
    Min::[F] { bound: bound, message: message }

## An inclusive upper bound.
pub fn max[F < PartialOrd](bound: F, message: string? = .None) -> Max[F]:
    Max::[F] { bound: bound, message: message }

## An inclusive character or collection length range.
pub fn length[F < HasLength](minimum: usize, maximum: usize, message: string? = .None) -> Length[F]:
    Length::[F] { minimum: minimum, maximum: maximum, message: message }

## An inclusive minimum character or collection length.
pub fn min_length[F < HasLength](minimum: usize, message: string? = .None) -> MinLength[F]:
    MinLength::[F] { minimum: minimum, message: message }

## An inclusive maximum character or collection length.
pub fn max_length[F < HasLength](maximum: usize, message: string? = .None) -> MaxLength[F]:
    MaxLength::[F] { maximum: maximum, message: message }

## An inclusive UTF-8 byte-length range.
pub fn byte_length(minimum: usize, maximum: usize, message: string? = .None) -> ByteLength[string]:
    ByteLength::[string] { minimum: minimum, maximum: maximum, message: message }

## A regular expression that must match the text.
pub fn pattern(source: string, message: string? = .None) -> Pattern[string]:
    Pattern::[string] { source: source, message: message }

## A WHATWG HTML valid email address.
pub fn email(message: string? = .None) -> Email[string]:
    Email::[string] { message: message }

## An absolute HTTP(S) URL accepted by `std.http.Url.parse`.
pub fn url(message: string? = .None) -> Url[string]:
    Url::[string] { message: message }

## A hyphenated 8-4-4-4-12 hexadecimal UUID.
pub fn uuid(message: string? = .None) -> Uuid[string]:
    Uuid::[string] { message: message }

## Membership in the listed values.
pub fn one_of[F < Eq](values: List[F], message: string? = .None) -> OneOf[F]:
    OneOf::[F] { values: values, message: message }

## No two list elements compare equal.
pub fn unique[F < Eq & Hash & Validate](message: string? = .None) -> Unique[List[F]]:
    Unique::[List[F]] { message: message }

## A custom field check; it runs after every built-in fact on the field.
pub fn check[F](test: fn(&F) -> Result[void, Problem], message: string? = .None) -> Check[F]:
    Check::[F] { test: test, message: message }
