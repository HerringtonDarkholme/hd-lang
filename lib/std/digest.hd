# std.digest: the SHA-256 hash of bytes, per FIPS 180-4
# (spec/std/digest.md). The prototype's std loader does not list this
# module yet (src/checker/standard-sources.ts).
use std.encoding.hex_encode

# The 32-byte SHA-256 digest of `bytes` (r-std-digest.sha256).
## The 32-byte SHA-256 digest of `bytes`, as FIPS 180-4 defines it.
## See [std-digest.sha256](../../spec/std/digest.md#r-std-digest.sha256).
pub fn sha256(bytes: List[u8]) -> Digest:
    Sha256::new().update(bytes).finish()

# A SHA-256 computation that takes its input in pieces (r-std-digest.sha256.decl-struct).
# The fields are the eight state words, the bytes of the partial block
# (always fewer than 64 between calls), the message length in bytes, and
# the constants the rounds reuse. `outer` is empty for a plain hasher;
# `hmac` sets it to the key block XOR 0x5c, which `finish` hashes ahead of
# the inner digest (RFC 2104). A hasher is used behind `&mut`.
## A SHA-256 computation fed in pieces: `update` adds bytes and `finish` returns the digest.
## See [std-digest.sha256.decl-struct](../../spec/std/digest.md#r-std-digest.sha256.decl-struct).
pub struct Sha256:
    state: List[u32]
    block: List[u8]
    length: u64
    rounds: List[u32]
    outer: List[u8]

impl Sha256:
    # A new object, so `update` calls chain on it (r-std-digest.sha256.new-ref).
    ## Returns a hasher that has seen no bytes, a new object that `update` changes.
    ## See [std-digest.sha256.new-ref](../../spec/std/digest.md#r-std-digest.sha256.new-ref).
    pub fn new() -> &mut Sha256:
        &mut Sha256 { state: initial_state(), block: [], length: 0, rounds: round_constants(), outer: [] }

    ## Returns a hasher whose `finish` gives HMAC-SHA256 of the message under `key`.
    ## See [std-digest.hmac-ref](../../spec/std/digest.md#r-std-digest.hmac-ref).
    pub fn hmac(key: List[u8]) -> &mut Sha256:
        # A key longer than the 64-byte block is hashed first; a shorter one
        # is padded with zeros to the block (RFC 2104, section 2).
        let mut block_key: List[u8] = []
        if key.len() > 64:
            for byte in sha256(key).bytes:
                block_key.push(byte)
        else:
            for byte in key:
                block_key.push(byte)
        while block_key.len() < 64:
            block_key.push(0)
        let mut inner_pad: List[u8] = []
        let mut outer_pad: List[u8] = []
        for byte in block_key:
            inner_pad.push(byte ^ 0x36)
            outer_pad.push(byte ^ 0x5c)
        hasher := Sha256::new().update(inner_pad)
        hasher.outer = outer_pad
        hasher

    # The block and the state change in locals and are stored once, so a
    # write through the reference happens once per call, not once per byte.
    ## Adds `bytes` to the message and returns the hasher, so calls chain.
    ## See [std-digest.sha256.update-ref](../../spec/std/digest.md#r-std-digest.sha256.update-ref).
    pub fn update(&mut self, bytes: List[u8]) -> &mut Sha256:
        let mut block = self.block
        let state = self.state
        rounds := self.rounds
        for byte in bytes:
            block.push(byte)
            if block.len() == 64:
                state = compress(state, block, 0, rounds)
                block.clear()
        self.length = self.length.wrapping_add(u64(bytes.len()))
        self.block = block
        self.state = state
        self

    ## Returns the digest of every byte added so far, or the HMAC-SHA256 under the key of `hmac`. The hasher is unchanged, so it can take more bytes.
    ## See [std-digest.sha256.finish](../../spec/std/digest.md#r-std-digest.sha256.finish).
    pub fn finish(self) -> Digest:
        inner := self.finish_plain()
        if self.outer.len() == 0:
            return inner
        Sha256::new().update(self.outer).update(inner.bytes).finish()

    # The digest of the bytes hashed so far, ignoring any HMAC key.
    fn finish_plain(&self) -> Digest:
        let state = self.state
        # The partial block, a 1 bit, zeros up to 56 bytes past a multiple of
        # 64, then the message length in bits as a big-endian u64 (FIPS
        # 180-4, section 5.1.1). At most two blocks.
        let mut last: List[u8] = []
        for byte in self.block:
            last.push(byte)
        last.push(128)
        while last.len() % 64 != 56:
            last.push(0)
        bits := self.length << 3
        for index in 0..8:
            last.push(u8(bits >> u32(56 - 8 * index)))
        let at: usize = 0
        while at < last.len():
            state = compress(state, last, at, self.rounds)
            at = at + 64
        let mut digest: List[u8] = []
        for word in state:
            digest.push(u8(word >> 24))
            digest.push(u8(word >> 16))
            digest.push(u8(word >> 8))
            digest.push(u8(word))
        Digest { bytes: digest }

# The initial hash value: the first 32 bits of the fractional parts of the
# square roots of the first eight primes (FIPS 180-4, section 5.3.3).
fn initial_state() -> List[u32]:
    [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]

# `state` with the 64 bytes of `block` from `at` folded in (FIPS 180-4,
# section 6.2.2). The message schedule is a local list built per block.
fn compress(state: List[u32], block: List[u8], at: usize, rounds: List[u32]) -> List[u32]:
    let mut schedule: List[u32] = []
    for t in usize(0)..usize(16):
        index := at + 4 * t
        schedule.push((u32(block[index]) << 24) | (u32(block[index + 1]) << 16) | (u32(block[index + 2]) << 8) | u32(block[index + 3]))
    for t in usize(16)..usize(64):
        low := schedule[t - 15]
        high := schedule[t - 2]
        s0 := rotate_right(low, 7) ^ rotate_right(low, 18) ^ (low >> 3)
        s1 := rotate_right(high, 17) ^ rotate_right(high, 19) ^ (high >> 10)
        schedule.push(schedule[t - 16].wrapping_add(s0).wrapping_add(schedule[t - 7]).wrapping_add(s1))
    let a = state[0]
    let b = state[1]
    let c = state[2]
    let d = state[3]
    let e = state[4]
    let f = state[5]
    let g = state[6]
    let h = state[7]
    for t in usize(0)..usize(64):
        sum1 := rotate_right(e, 6) ^ rotate_right(e, 11) ^ rotate_right(e, 25)
        choice := (e & f) ^ (~e & g)
        first := h.wrapping_add(sum1).wrapping_add(choice).wrapping_add(rounds[t]).wrapping_add(schedule[t])
        sum0 := rotate_right(a, 2) ^ rotate_right(a, 13) ^ rotate_right(a, 22)
        majority := (a & b) ^ (a & c) ^ (b & c)
        second := sum0.wrapping_add(majority)
        h = g
        g = f
        f = e
        e = d.wrapping_add(first)
        d = c
        c = b
        b = a
        a = first.wrapping_add(second)
    [state[0].wrapping_add(a), state[1].wrapping_add(b), state[2].wrapping_add(c), state[3].wrapping_add(d), state[4].wrapping_add(e), state[5].wrapping_add(f), state[6].wrapping_add(g), state[7].wrapping_add(h)]

# A hash result: the bytes of a digest (r-std-digest.digest-value).
## The result of a hash, as bytes. Compare digests with `==`, which takes the same time wherever they differ.
## See [std-digest.digest-value](../../spec/std/digest.md#r-std-digest.digest-value).
pub struct Digest:
    pub bytes: List[u8]

impl Digest:
    ## The digest as lowercase hex text, two digits per byte.
    ## See [std-digest.digest.to-hex](../../spec/std/digest.md#r-std-digest.digest.to-hex).
    pub fn to_hex(self) -> string:
        hex_encode(self.bytes)

# Constant time over the bytes (r-std-digest.digest.eq): the loop never
# exits early and no branch reads a byte value. The lengths are compared
# first, because a length is not secret.
# Keep handwritten Eq: compare equal-length byte arrays in constant time.
impl Eq for Digest:
    fn eq(self, other: Digest) -> bool:
        if self.bytes.len() != other.bytes.len():
            return false
        let difference: u8 = 0
        for index in 0..self.bytes.len():
            difference = difference | (self.bytes[index] ^ other.bytes[index])
        difference == 0

fn rotate_right(word: u32, count: u32) -> u32:
    (word >> count) | (word << (32 - count))

# The first 32 bits of the fractional parts of the cube roots of the first
# 64 primes (FIPS 180-4, section 4.2.2).
fn round_constants() -> List[u32]:
    [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
