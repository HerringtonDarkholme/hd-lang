# std.time: `Duration` and its literal suffixes, the host capability
# `Clock` with `Timestamp` and `Instant`, and the
# deterministic `ManualClock`, and the UTC `Date` with RFC 3339 text
# (spec/std/time.md).
# A `Duration` is a whole, non-negative number of
# milliseconds in an `i64` (r-std-time.suffix.std.duration,
# r-std-time.duration.non-negative), as Rust's `std::time::Duration` is
# never negative. Every way to build one is checked, so the field is never
# below zero. Its public API is
# `milliseconds`, `seconds`, `as_milliseconds`, `checked_sub`, and
# `saturating_sub` (r-std-time.suffix.std.duration-api); the `millis`
# field is the prototype's own. Each unit constructor and suffix checks its
# scaling before it multiplies, so an overflow panics in every build
# (r-std-time.duration.seconds-overflow, r-std-time.suffix.std.call-overflow).
# Each suffix is a function marked `@num_suffix` (r-std-time.suffix.std.constructors).
# `Duration` has no `Neg`, so `-5s` is a type error (r-std-time.duration.no-neg).
use std.format.DebugWriter
use std.error.Error
use std.text.{Parse, StringBuilder}
use std.ops.{Add, Sub, num_suffix}
use std.encoding.{Serialize, Deserialize, Serializer, Deserializer}
use std.collections.Heap
use std.ops.defer
use std.rt.{WaitCell, wait_cell, wait_signal, idle_hook}
use std.rt.{panic_with}

## A distance in time, as a count of whole milliseconds, never negative.
## See [std-time.suffix.std.duration](../../spec/std/time.md#r-std-time.suffix.std.duration).
pub struct Duration:
    millis: i64

impl Duration:
    ## Returns a `Duration` of that many milliseconds. A negative count panics.
    ## See [std-time.duration.negative-count](../../spec/std/time.md#r-std-time.duration.negative-count).
    pub fn milliseconds(count: i64) -> Duration:
        if count < 0:
            panic("Duration::milliseconds with a negative count: ${count}")
        Duration { millis: count }

    ## Returns a `Duration` of that many seconds. A negative count panics.
    ## See [std-time.duration.negative-count](../../spec/std/time.md#r-std-time.duration.negative-count).
    pub fn seconds(count: i64) -> Duration:
        if count < 0:
            panic("Duration::seconds with a negative count: ${count}")
        Duration { millis: unit_millis(count, 1000) }

    ## The duration minus `rhs`, or `.None` when `rhs` is the longer one.
    ## See [std-time.duration.checked-sub](../../spec/std/time.md#r-std-time.duration.checked-sub).
    pub fn checked_sub(self, rhs: Duration) -> Duration?:
        if rhs.millis > self.millis:
            return .None
        .Some(Duration { millis: self.millis - rhs.millis })

    ## The duration minus `rhs`, or zero when `rhs` is the longer one.
    ## See [std-time.duration.saturating-sub](../../spec/std/time.md#r-std-time.duration.saturating-sub).
    pub fn saturating_sub(self, rhs: Duration) -> Duration:
        if rhs.millis > self.millis:
            return Duration { millis: 0 }
        Duration { millis: self.millis - rhs.millis }

    ## The milliseconds since the origin that the instant holds.
    ## See [std-time.instant.as-milliseconds](../../spec/std/time.md#r-std-time.instant.as-milliseconds).
    pub fn as_milliseconds(self) -> i64:
        self.millis

# Go's `time.ParseDuration` text, such as `1h30m` or `250ms`
# (r-std-time.duration.parse).
impl Parse for Duration:
    type Error = ParseTimeError

    fn parse(text: string) -> Result[Duration, ParseTimeError]:
        parse_duration_text(text)

# `count` units of `unit` milliseconds each, for a `count` and a `unit`
# that are not negative. A product past the `i64` range panics with integer
# overflow in every build, where a release build's `*` would wrap it, maybe
# below zero (r-std-time.duration.seconds-overflow).
fn unit_millis(count: i64, unit: i64) -> i64:
    if count > 9223372036854775807 / unit:
        panic_with("integer-overflow", "integer overflow")
    count * unit

# Adds a non-negative duration to a signed time point, checked in every build.
# Duration bounds delay to 0..=MAX, so the comparison's subtraction cannot overflow.
# (r-std-time.timestamp.add.checked-overflow; r-std-time.manual.sleep.deadline-overflow).
fn add_duration_to_point(point: i64, duration: Duration) -> i64:
    delay := duration.as_milliseconds()
    if point > 9223372036854775807 - delay:
        panic_with("integer-overflow", "integer overflow")
    point + delay

# The sum of the milliseconds, and a sum past the `i64` range panics with
# integer overflow in every build (r-std-time.duration.add,
# r-std-time.duration.add-overflow). Both sides are not negative, so the
# bound `i64::MAX - self` never overflows.
impl Add for Duration:
    type Out = Duration
    fn add(self, rhs: Duration) -> Duration:
        if rhs.millis > 9223372036854775807 - self.millis:
            panic_with("integer-overflow", "integer overflow")
        Duration { millis: self.millis + rhs.millis }

# `-` panics when `rhs` is the longer duration, in every build, as Rust's
# `Duration` does (r-std-time.duration.sub-difference).
impl Sub for Duration:
    type Out = Duration
    fn sub(self, rhs: Duration) -> Duration:
        match self.checked_sub(rhs):
            .Some(difference) => difference
            .None => panic("Duration subtraction underflow: ${self} - ${rhs}")

# Go's `time.Duration.String`, in hd's units (r-std-time.duration.text):
# `h`, `min`, then `s` with the milliseconds as a fraction, and every
# component below the largest one written, even when zero; under one
# second, `ms`; zero is `0s`.
# Keep handwritten Display: keep canonical time text rather than an Error message.
impl Display for Duration:
    fn to_string(&self) -> string:
        millis := self.millis
        if millis == 0:
            return "0s"
        let text = ""
        if millis < 1000:
            return "${millis}ms"
        hours := millis / 3600000
        minutes := (millis % 3600000) / 60000
        seconds := (millis % 60000) / 1000
        fraction := millis % 1000
        if hours > 0:
            text = text + "${hours}h"
        if hours > 0 || minutes > 0:
            text = text + "${minutes}min"
        text = text + "${seconds}"
        if fraction > 0:
            text = text + "." + fraction_digits(fraction)
        text + "s"

# The milliseconds `1` to `999` as the decimal digits after the point,
# without trailing zeros (r-std-time.duration.text.fraction).
fn fraction_digits(fraction: i64) -> string:
    if fraction % 100 == 0:
        return "${fraction / 100}"
    if fraction % 10 == 0:
        tenths := fraction / 10
        if tenths < 10:
            return "0${tenths}"
        return "${tenths}"
    if fraction < 10:
        return "00${fraction}"
    if fraction < 100:
        return "0${fraction}"
    "${fraction}"

# Keep handwritten Debug: keep the duration/time text instead of structural fields.
impl Debug for Duration:
    fn debug(&self, out: *mut DebugWriter) -> void:
        out.write(self.to_string())

# Durations compare by their milliseconds (r-std-time.duration.eq-ord).

# Keep handwritten Eq: deriving Eq alone conflicts with the existing order impls.
impl Eq for Duration:
    fn eq(&self, other: &Duration) -> bool:
        self.millis == other.millis

impl PartialOrd for Duration:
    fn partial_cmp(&self, other: &Duration) -> Ordering?:
        .Some(self.millis.cmp(&other.millis))

impl Ord for Duration:
    fn cmp(&self, other: &Duration) -> Ordering:
        self.millis.cmp(&other.millis)

@num_suffix
## The `ms` suffix: a `Duration` of that many milliseconds, as in `250ms`.
## See [std-time.suffix.std.ms](../../spec/std/time.md#r-std-time.suffix.std.ms).
pub fn ms(count: i64) -> Duration:
    Duration::milliseconds(count)

@num_suffix
## The `s` suffix: a `Duration` of that many seconds, as in `5s`.
## See [std-time.suffix.std.s](../../spec/std/time.md#r-std-time.suffix.std.s).
pub fn s(count: i64) -> Duration:
    Duration::seconds(count)

@num_suffix
## A `Duration` of `count` minutes; the `90min` literal uses this constructor.
## See [std-time.suffix.std.minutes](../../spec/std/time.md#r-std-time.suffix.std.minutes).
pub fn minutes(count: i64) -> Duration:
    if count < 0:
        panic("minutes with a negative count: ${count}")
    Duration { millis: unit_millis(count, 60000) }

@num_suffix
## The `h` suffix: a `Duration` of that many hours, as in `2h`.
## See [std-time.suffix.std.h](../../spec/std/time.md#r-std-time.suffix.std.h).
pub fn h(count: i64) -> Duration:
    if count < 0:
        panic("h with a negative count: ${count}")
    Duration { millis: unit_millis(count, 3600000) }

# The host capability that reads time and waits (spec/std/time.md#clock).
# `sleep!` takes `&mut self`, so a provider may advance its own time and
# `$.use(Clock)` is a `&mut dyn Clock` (r-std-time.clock.mut-ref.reference-values).
## The host capability to read the clock and to wait: `now`, `monotonic`, and `sleep!`.
## See [std-time.clock.decl-ref](../../spec/std/time.md#r-std-time.clock.decl-ref).
pub trait Clock:
    fn now(self) -> Timestamp
    fn monotonic(self) -> Instant
    fn sleep!(&mut self, duration: Duration) -> void

# The current time of the covering `Clock` provider
# (spec/std/time.md#r-std-time.helper.now).
## Returns the current wall-clock time as a `Timestamp`.
## See [std-time.helper.now](../../spec/std/time.md#r-std-time.helper.now).
pub fn now() -> Timestamp $ Clock:
    $.use(Clock).now()

# The covering provider's monotonic reading
# (spec/std/time.md#r-std-time.helper.monotonic).
## Returns the current reading of the monotonic clock as an `Instant`.
## See [std-time.helper.monotonic](../../spec/std/time.md#r-std-time.helper.monotonic).
pub fn monotonic() -> Instant $ Clock:
    $.use(Clock).monotonic()

# The time from `since` to the provider's monotonic reading now
# (spec/std/time.md#r-std-time.helper.elapsed).
## Returns the time that has passed on the monotonic clock since `since`.
## See [std-time.helper.elapsed](../../spec/std/time.md#r-std-time.helper.elapsed).
pub fn elapsed(since: Instant) -> Duration $ Clock:
    $.use(Clock).monotonic().since(since)

# Waits `duration` on the covering `Clock` provider
# (spec/std/time.md#r-std-time.helper.sleep).
## Completes once `duration` has passed on the clock.
## See [std-time.helper.sleep](../../spec/std/time.md#r-std-time.helper.sleep).
pub fn sleep!(duration: Duration) -> void $ Clock:
    clock := $.use(Clock)
    clock.sleep!(duration)

# Whole milliseconds since the Unix epoch, in UTC (r-std-time.timestamp.decl).
## A point in UTC time, held as whole milliseconds since the Unix epoch.
## See [std-time.timestamp.decl](../../spec/std/time.md#r-std-time.timestamp.decl).
pub struct Timestamp:
    millis: i64

impl Timestamp:
    ## Returns the timestamp that holds `millis` milliseconds since the Unix epoch.
    ## See [std-time.timestamp.api-calendar](../../spec/std/time.md#r-std-time.timestamp.api-calendar).
    pub fn from_unix_milliseconds(millis: i64) -> Timestamp:
        Timestamp { millis: millis }

    # The inverse of `from_unix_milliseconds` (r-std-time.timestamp.unix-milliseconds).
    ## The milliseconds since the Unix epoch that the timestamp holds.
    ## See [std-time.timestamp.unix-milliseconds](../../spec/std/time.md#r-std-time.timestamp.unix-milliseconds).
    pub fn unix_milliseconds(self) -> i64:
        self.millis

    ## The time from `earlier` to the timestamp, or `.None` when `earlier` is the later one.
    ## See [std-time.timestamp.checked-since](../../spec/std/time.md#r-std-time.timestamp.checked-since).
    pub fn checked_since(self, earlier: Timestamp) -> Duration?:
        checked_millis_since(self.millis, earlier.millis)

    # Zero when `earlier` is the later one (r-std-time.timestamp.since-saturating).
    ## The time from `earlier` to the timestamp, or zero when `earlier` is the later one.
    ## See [std-time.timestamp.since-saturating](../../spec/std/time.md#r-std-time.timestamp.since-saturating).
    pub fn since(self, earlier: Timestamp) -> Duration:
        millis_since(self.millis, earlier.millis)

    # The UTC calendar date (r-std-time.date.of-timestamp).
    ## The calendar day of the timestamp in UTC.
    ## See [std-time.timestamp.api-calendar](../../spec/std/time.md#r-std-time.timestamp.api-calendar).
    pub fn date(self) -> Date:
        civil_from_days(self.days())

    # `YYYY-MM-DDTHH:MM:SSZ`, with `.mmm` before the `Z` when the
    # milliseconds are not zero (r-std-time.rfc3339.text).
    ## The timestamp as RFC 3339 text in UTC.
    ## See [std-time.timestamp.api-calendar](../../spec/std/time.md#r-std-time.timestamp.api-calendar).
    pub fn to_rfc3339(self) -> string:
        civil := civil_from_days(self.days())
        let clock = self.millis % 86400000
        if clock < 0:
            clock = clock + 86400000
        let text = civil.to_iso8601()
        text = (
            text
            + "T"
            + zero_padded(clock / 3600000, 2)
            + ":"
            + zero_padded(clock / 60000 % 60, 2)
            + ":"
            + zero_padded(clock / 1000 % 60, 2)
        )
        if clock % 1000 != 0:
            text = text + "." + zero_padded(clock % 1000, 3)
        text + "Z"

    ## The timestamp in UTC, using a strftime layout.
    ## See [std-time.format.utc](../../spec/std/time.md#r-std-time.format.utc).
    pub fn format(self, layout: string) -> string:
        self.to_datetime(UtcOffset::utc()).format(layout)

    ## Splits this millisecond timestamp into calendar fields at a fixed offset.
    ## See [std-time.datetime.to-datetime](../../spec/std/time.md#r-std-time.datetime.to-datetime).
    pub fn to_datetime(self, offset: UtcOffset) -> DateTime:
        if offset.seconds < -86399 || offset.seconds > 86399:
            panic("invalid UTC offset: ${offset.seconds}")
        let seconds = self.millis / 1000
        let fraction = self.millis % 1000
        if fraction < 0:
            seconds -= 1
            fraction += 1000
        datetime_from_seconds(seconds, u32(fraction) * 1000000, offset)

    # Whole days since the epoch, rounded toward negative infinity, so the
    # time of day is never negative. Adjusting the truncated quotient and
    # remainder, never multiplying back, keeps the most negative timestamp
    # in range.
    fn days(self) -> i64:
        let whole = self.millis / 86400000
        if self.millis % 86400000 < 0:
            whole = whole - 1
        whole

# Moves the time by the duration, with checked `i64` addition
# (r-std-time.timestamp.add).
impl Add[Duration] for Timestamp:
    type Out = Timestamp
    fn add(self, rhs: Duration) -> Timestamp:
        Timestamp { millis: add_duration_to_point(self.millis, rhs) }

# RFC 3339 text, the text `Display` writes (r-std-time.rfc3339.parse).
impl Parse for Timestamp:
    type Error = ParseTimeError

    fn parse(text: string) -> Result[Timestamp, ParseTimeError]:
        parse_byte_codes(byte_codes(text))

# The RFC 3339 text, as Go's `Time.String` (r-std-time.timestamp.display).
# Keep handwritten Display: keep canonical time text rather than an Error message.
impl Display for Timestamp:
    fn to_string(&self) -> string:
        self.to_rfc3339()

# A `Timestamp` debugs as its RFC 3339 text
# (r-std-format.debug.std-types.time).
# Keep handwritten Debug: keep the duration/time text instead of structural fields.
impl Debug for Timestamp:
    fn debug(&self, out: *mut DebugWriter) -> void:
        out.write(self.to_rfc3339())

# Keep handwritten Eq: deriving Eq alone conflicts with the existing order impls.
impl Eq for Timestamp:
    fn eq(&self, other: &Timestamp) -> bool:
        self.millis == other.millis

impl PartialOrd for Timestamp:
    fn partial_cmp(&self, other: &Timestamp) -> Ordering?:
        .Some(self.millis.cmp(&other.millis))

impl Ord for Timestamp:
    fn cmp(&self, other: &Timestamp) -> Ordering:
        self.millis.cmp(&other.millis)

# A calendar date in the proleptic Gregorian calendar, with astronomical
# year numbering: year 0 is 1 BC (spec/std/time.md#dates).
## A calendar day in UTC, in the proleptic Gregorian calendar.
## See [std-time.date.decl-struct](../../spec/std/time.md#r-std-time.date.decl-struct).
@derive(Debug, Eq)
pub struct Date:
    ## The year, with a year 0.
    ## See [std-time.date.decl-struct](../../spec/std/time.md#r-std-time.date.decl-struct).
    pub year: i32
    ## The month, from 1 to 12.
    ## See [std-time.date.decl-struct](../../spec/std/time.md#r-std-time.date.decl-struct).
    pub month: i32
    ## The day of the month.
    ## See [std-time.date.decl-struct](../../spec/std/time.md#r-std-time.date.decl-struct).
    pub day: i32

impl Date:
    # `YYYY-MM-DD`, the year as in RFC 3339 text (r-std-time.date.iso8601).
    ## The date as ISO 8601 text, as `2026-10-17`.
    ## See [std-time.date.iso8601](../../spec/std/time.md#r-std-time.date.iso8601).
    pub fn to_iso8601(self) -> string:
        (
            year_digits(self.year)
            + "-"
            + zero_padded(i64(self.month), 2)
            + "-"
            + zero_padded(i64(self.day), 2)
        )

## A fixed number of seconds east of UTC.
## See [std-time.offset.decl](../../spec/std/time.md#r-std-time.offset.decl).
@derive(Debug, Eq)
pub struct UtcOffset:
    pub seconds: i32

impl UtcOffset:
    ## The zero offset, with no local-zone lookup.
    ## See [std-time.offset.utc](../../spec/std/time.md#r-std-time.offset.utc).
    pub fn utc() -> UtcOffset:
        UtcOffset { seconds: 0 }

    ## A fixed offset strictly less than one day in either direction.
    ## See [std-time.offset.from-seconds](../../spec/std/time.md#r-std-time.offset.from-seconds).
    pub fn from_seconds(seconds: i32) -> Result[UtcOffset, TimeError]:
        if seconds < -86399 || seconds > 86399:
            return .Err(.InvalidField("offset"))
        .Ok(UtcOffset { seconds: seconds })

## A weekday in Monday-first order.
## See [std-time.weekday.decl](../../spec/std/time.md#r-std-time.weekday.decl).
@derive(Debug, Eq)
pub enum Weekday:
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday

## A broken-down time in the proleptic Gregorian calendar.
## See [std-time.datetime.decl](../../spec/std/time.md#r-std-time.datetime.decl).
@derive(Debug, Eq)
pub struct DateTime:
    pub year: i32
    pub month: u8
    pub day: u8
    pub hour: u8
    pub minute: u8
    pub second: u8
    pub nanosecond: u32
    pub offset: UtcOffset
    pub zone: string? = .None

impl DateTime:
    ## Parses a broken-down time using a strftime layout.
    ## See [std-time.datetime.parse](../../spec/std/time.md#r-std-time.datetime.parse).
    pub fn parse(text: string, layout: string) -> Result[DateTime, ParseTimeError]:
        parse_datetime(text, layout)

    ## Converts these fields to whole Unix milliseconds, flooring the fraction.
    ## See [std-time.datetime.floor-milliseconds](../../spec/std/time.md#r-std-time.datetime.floor-milliseconds).
    pub fn to_timestamp(self) -> Result[Timestamp, TimeError]:
        self.validate()?
        day := days_from_civil(i64(self.year), i64(self.month), i64(self.day))
        millis := (
            i64(self.hour) * 3600000
            + i64(self.minute) * 60000
            + i64(self.second) * 1000
            + i64(self.nanosecond / 1000000)
        )
        calendar_timestamp(day, millis, self.offset)

    ## The weekday of this calendar date, with Monday first.
    ## See [std-time.datetime.weekday](../../spec/std/time.md#r-std-time.datetime.weekday).
    pub fn weekday(self) -> Weekday:
        day := match self.calendar_day():
            .Some(day) => day
            .None => panic("invalid DateTime calendar date")
        match positive_remainder(day + 3, 7):
            0 => .Monday
            1 => .Tuesday
            2 => .Wednesday
            3 => .Thursday
            4 => .Friday
            5 => .Saturday
            _ => .Sunday

    ## The ordinal day of the year, starting at one.
    ## See [std-time.datetime.day-of-year](../../spec/std/time.md#r-std-time.datetime.day-of-year).
    pub fn day_of_year(self) -> u16:
        day := match self.calendar_day():
            .Some(day) => day
            .None => panic("invalid DateTime calendar date")
        u16(day - days_from_civil(i64(self.year), 1, 1) + 1)

    ## Formats these fields using the fixed C-locale strftime directives.
    ## See [std-time.format.strftime](../../spec/std/time.md#r-std-time.format.strftime).
    pub fn format(self, layout: string) -> string:
        match self.validate():
            .Err(error) => panic("invalid DateTime: $error")
            .Ok(_) => pass
        format_datetime(self, layout)

    fn validate(self) -> Result[void, TimeError]:
        if self.month < 1 || self.month > 12:
            return .Err(.InvalidField("month"))
        if self.day < 1 || i64(self.day) > days_in_month(i64(self.year), i64(self.month)):
            return .Err(.InvalidField("day"))
        if self.hour > 23:
            return .Err(.InvalidField("hour"))
        if self.minute > 59:
            return .Err(.InvalidField("minute"))
        if self.second > 59:
            return .Err(.InvalidField("second"))
        if self.nanosecond > 999999999:
            return .Err(.InvalidField("nanosecond"))
        if self.offset.seconds < -86399 || self.offset.seconds > 86399:
            return .Err(.InvalidField("offset"))
        .Ok(())

    # Validation precedes Hinnant's arithmetic: the conversion deliberately
    # accepts no overflowing month or day to normalize into another date.
    fn calendar_day(self) -> i64?:
        if self.month < 1 || self.month > 12:
            return .None
        if self.day < 1 || i64(self.day) > days_in_month(i64(self.year), i64(self.month)):
            return .None
        .Some(days_from_civil(i64(self.year), i64(self.month), i64(self.day)))

## Why calendar components cannot be converted to a timestamp.
## See [std-time.time-error.decl](../../spec/std/time.md#r-std-time.time-error.decl).
@error
@derive(Debug, Eq)
pub enum TimeError:
    @error("invalid time field $field")
    InvalidField(field: string)
    @error("timestamp is outside the i64 millisecond range")
    OutOfRange
    @error("$message")
    Other(message: string)

# Convert a local day and within-day millisecond count after applying an
# offset. Split first, so neither i64 timestamp endpoint is lost to an
# intermediate multiplication. Callers choose the fractional precision.
fn calendar_timestamp(
    day: i64,
    local_millis: i64,
    offset: UtcOffset,
) -> Result[Timestamp, TimeError]:
    clock := local_millis - i64(offset.seconds) * 1000
    utc_day := day + clock / 86400000 - (if clock % 86400000 < 0: 1 else: 0)
    remainder := positive_remainder(clock, 86400000)
    minimum := -9223372036854775807 - 1
    maximum := 9223372036854775807
    minimum_day := minimum / 86400000 - 1
    maximum_day := maximum / 86400000
    minimum_tail := positive_remainder(minimum, 86400000)
    if utc_day < minimum_day || utc_day > maximum_day:
        return .Err(.OutOfRange)
    if utc_day == minimum_day:
        if remainder < minimum_tail:
            return .Err(.OutOfRange)
        return .Ok(Timestamp { millis: minimum + (remainder - minimum_tail) })
    if utc_day == maximum_day && remainder > maximum % 86400000:
        return .Err(.OutOfRange)
    .Ok(Timestamp { millis: utc_day * 86400000 + remainder })

# Hinnant's ISO week computation reduces to a weekday and one year boundary.
# The year is widened before arithmetic so ISO years just outside i32 still format.
fn iso_weeks(year: i64) -> i64:
    january := positive_remainder(days_from_civil(year, 1, 1) + 3, 7)
    leap := year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
    if january == 3 || (january == 2 && leap): 53 else: 52

fn iso_year_week(value: DateTime) -> (i64, i64):
    day := days_from_civil(i64(value.year), i64(value.month), i64(value.day))
    ordinal := day - days_from_civil(i64(value.year), 1, 1) + 1
    weekday := positive_remainder(day + 3, 7)
    week := (ordinal - weekday + 9) / 7
    if week < 1:
        year := i64(value.year) - 1
        return (year, iso_weeks(year))
    if week > iso_weeks(i64(value.year)):
        return (i64(value.year) + 1, 1)
    (i64(value.year), week)

fn expanded_year(year: i64) -> string:
    if year < 0: "-" + zero_padded(-year, 4) else: zero_padded(year, 4)

fn time_offset(offset: UtcOffset) -> string:
    seconds := i64(offset.seconds)
    magnitude := if seconds < 0: -seconds else: seconds
    sign := if seconds < 0: "-" else: "+"
    prefix := sign + zero_padded(magnitude / 3600, 2) + zero_padded(magnitude / 60 % 60, 2)
    if magnitude % 60 == 0: prefix else: prefix + zero_padded(magnitude % 60, 2)

# Composite expansion has fixed depth one. Both scans and the output builder
# are linear in layout/output bytes, independent of calendar year magnitude.
fn format_datetime(value: DateTime, layout: string) -> string:
    expanded := match time_layout(layout):
        .Ok(expanded) => expanded
        .Err(error) => panic(time_layout_error(layout, error))
    day := days_from_civil(i64(value.year), i64(value.month), i64(value.day))
    weekday := positive_remainder(day + 3, 7)
    ordinal := day - days_from_civil(i64(value.year), 1, 1) + 1
    let (iso_year, iso_week) = iso_year_week(value)
    year := i64(value.year)
    hour := i64(value.hour)
    twelve := if hour % 12 == 0: 12 else: hour % 12
    out := StringBuilder::new()
    let pending = false
    for c in expanded.chars():
        if !pending:
            if c == '%':
                pending = true
            else:
                out.push_char(c)
            continue
        pending = false
        piece := match c:
            'Y' => year_digits(value.year)
            'y' => zero_padded(positive_remainder(year, 100), 2)
            'C' =>
                century := (year - positive_remainder(year, 100)) / 100
                if century < 0: "$century" else: zero_padded(century, 2)
            'm' => zero_padded(i64(value.month), 2)
            'd' => zero_padded(i64(value.day), 2)
            'e' =>
                if value.day < 10: " ${value.day}" else: "${value.day}"
            'H' => zero_padded(hour, 2)
            'k' =>
                if hour < 10: " $hour" else: "$hour"
            'I' => zero_padded(twelve, 2)
            'l' =>
                if twelve < 10: " $twelve" else: "$twelve"
            'M' => zero_padded(i64(value.minute), 2)
            'S' => zero_padded(i64(value.second), 2)
            'f' => zero_padded(i64(value.nanosecond / 1000), 6)
            'a' => weekday_names(false)[usize(weekday)]
            'A' => weekday_names(true)[usize(weekday)]
            'b' => month_names(false)[usize(value.month) - 1]
            'h' => month_names(false)[usize(value.month) - 1]
            'B' => month_names(true)[usize(value.month) - 1]
            'p' =>
                if hour < 12: "AM" else: "PM"
            'j' => zero_padded(ordinal, 3)
            'u' => "${weekday + 1}"
            'w' => "${(weekday + 1) % 7}"
            'U' => zero_padded((ordinal + 6 - (weekday + 1) % 7) / 7, 2)
            'W' => zero_padded((ordinal + 6 - weekday) / 7, 2)
            'G' => expanded_year(iso_year)
            'g' => zero_padded(positive_remainder(iso_year, 100), 2)
            'V' => zero_padded(iso_week, 2)
            's' =>
                "${day * 86400 + hour * 3600 + i64(value.minute) * 60 + i64(value.second) - i64(value.offset.seconds)}"
            'z' => time_offset(value.offset)
            'Z' =>
                value.zone.unwrap_or(if value.offset.seconds == 0: "UTC" else: "")
            'n' => "\n"
            't' => "\t"
            '%' => "%"
            # ruled out: time_layout accepts only these primitive directives.
            _ => panic("invalid expanded time directive %$c")
        out.push(piece)
    out.build()

# Truncating integer division needs one remainder correction before a date
# before the epoch can be split into a day and a nonnegative time of day.
fn positive_remainder(value: i64, modulus: i64) -> i64:
    remainder := value % modulus
    if remainder < 0: remainder + modulus else: remainder

# Split before adding the offset: adding seconds to the entire timestamp
# could overflow at i64::MIN/MAX even when the resulting date is valid.
fn datetime_from_seconds(seconds: i64, nanosecond: u32, offset: UtcOffset) -> DateTime:
    remainder := positive_remainder(seconds, 86400)
    day := seconds / 86400 - (if seconds % 86400 < 0: 1 else: 0)
    local := remainder + i64(offset.seconds)
    local_remainder := positive_remainder(local, 86400)
    local_day := day + local / 86400 - (if local % 86400 < 0: 1 else: 0)
    date := civil_from_days(local_day)
    DateTime {
        year: date.year,
        month: u8(date.month),
        day: u8(date.day),
        hour: u8(local_remainder / 3600),
        minute: u8(local_remainder / 60 % 60),
        second: u8(local_remainder % 60),
        nanosecond: nanosecond,
        offset: offset,
    }

# Expand only the fixed C-locale composite directives. Their replacements
# contain primitives, so expansion has no input-controlled recursion or retry.
fn time_layout(layout: string) -> Result[string, ParseTimeError]:
    out := StringBuilder::new()
    let position: usize = 0
    let pending = false
    for c in layout.chars():
        if pending:
            replacement := match c:
                'c' => "%a %b %e %H:%M:%S %Y"
                'D' => "%m/%d/%y"
                'F' => "%Y-%m-%d"
                'r' => "%I:%M:%S %p"
                'R' => "%H:%M"
                'T' => "%H:%M:%S"
                'x' => "%m/%d/%y"
                'X' => "%H:%M:%S"
                _ => ""
            if !replacement.is_empty():
                out.push(replacement)
            else:
                if !"aAbBCdeGghHIjklmMnpsStUuVwWyYzZf%".contains("$c"):
                    return .Err(.InvalidCharacter(position - 1))
                out.push_char('%')
                out.push_char(c)
            pending = false
        else if c == '%':
            pending = true
        else:
            out.push_char(c)
        position = position + "$c".len()
    if pending:
        return .Err(.TooShort(layout.len()))
    .Ok(out.build())

fn time_layout_error(layout: string, error: ParseTimeError) -> string:
    match error:
        .InvalidCharacter(position) =>
            let mut chars = layout.slice(position, layout.len()).chars()
            _ := chars.next()
            directive := match chars.next():
                .Some(c) => "%$c"
                .None => "%"
            "unknown time format directive $directive at byte $position"
        .TooShort(position) => "incomplete time format directive % at byte ${position - 1}"
        _ => "invalid time format: $error"

# One forward cursor in the input, independent of the number of fields.
# Numeric fields have bounded widths; names use fixed C-locale tables.
struct TimeInput:
    text: string
    position: usize

impl TimeInput:
    fn number(&mut self, width: usize, minimum: i64, maximum: i64) -> Result[i64, ParseTimeError]:
        start := self.position
        let value: i64 = 0
        while self.position < self.text.len() && self.position - start < width:
            byte := self.text[self.position]
            if byte < 48 || byte > 57:
                break
            digit := i64(byte - 48)
            if value > (9223372036854775807 - digit) / 10:
                return .Err(.OutOfRange(start))
            value = value * 10 + digit
            self.position += 1
        if self.position == start:
            return .Err(self.mismatch())
        if value < minimum || value > maximum:
            return .Err(.OutOfRange(start))
        .Ok(value)

    fn exact_number(&mut self, width: usize, maximum: i64) -> Result[i64, ParseTimeError]:
        start := self.position
        value := self.number(width, 0, maximum)?
        if self.position - start != width:
            return .Err(self.mismatch())
        .Ok(value)

    fn signed(&mut self, width: usize, minimum: i64, maximum: i64) -> Result[i64, ParseTimeError]:
        start := self.position
        let negative = false
        if self.position < self.text.len():
            sign := self.text[self.position]
            if sign == 45 || sign == 43:
                negative = sign == 45
                self.position += 1
        # Accumulate negatively, allowing the magnitude of i64::MIN.
        digits := self.position
        let value: i64 = 0
        while self.position < self.text.len() && self.position - digits < width:
            byte := self.text[self.position]
            if byte < 48 || byte > 57:
                break
            digit := i64(byte - 48)
            if value < (-9223372036854775807 - 1 + digit) / 10:
                return .Err(.OutOfRange(start))
            value = value * 10 - digit
            self.position += 1
        if self.position == digits:
            return .Err(self.mismatch())
        if !negative:
            if value == -9223372036854775807 - 1:
                return .Err(.OutOfRange(start))
            value = -value
        if value < minimum || value > maximum:
            return .Err(.OutOfRange(start))
        .Ok(value)

    fn mismatch(&self) -> ParseTimeError:
        if self.position == self.text.len():
            .TooShort(self.position)
        else:
            .InvalidCharacter(self.position)

    fn spaces(&mut self) -> void:
        while self.position < self.text.len():
            byte := self.text[self.position]
            if byte != 32 && (byte < 9 || byte > 13):
                break
            self.position += 1

    fn name(&mut self, names: List[string]) -> Result[usize, ParseTimeError]:
        let index: usize = 0
        for name in names:
            end := self.position + name.len()
            if end <= self.text.len():
                let offset: usize = 0
                let matches = true
                while offset < name.len():
                    actual := i32(self.text[self.position + offset])
                    expected := i32(name[offset])
                    folded_actual := if actual >= 65 && actual <= 90: actual + 32 else: actual
                    folded_expected := if expected >= 65 && expected <= 90:
                        expected + 32
                    else:
                        expected
                    if folded_actual != folded_expected:
                        matches = false
                        break
                    offset += 1
                if matches:
                    self.position = end
                    return .Ok(index)
            index += 1
        .Err(self.mismatch())

fn month_names(full: bool) -> List[string]:
    if full:
        [
            "January",
            "February",
            "March",
            "April",
            "May",
            "June",
            "July",
            "August",
            "September",
            "October",
            "November",
            "December",
        ]
    else:
        ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

fn weekday_names(full: bool) -> List[string]:
    if full:
        ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    else:
        ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]

# Intrinsic widths disambiguate adjoining numeric directives, as in chrono.
# Delimited years retain hd's existing expanded signed/unsigned year text.
fn next_time_number(layout: string, position: usize) -> bool:
    (
        position + 1 < layout.len()
        && layout[position] == 37
        && "YCymdeHkIlMSfjuwUWGgVs".contains(layout.slice(position + 1, position + 2))
    )

fn parse_datetime(text: string, layout: string) -> Result[DateTime, ParseTimeError]:
    expanded := match time_layout(layout):
        .Ok(expanded) => expanded
        .Err(error) => return .Err(.Other(time_layout_error(layout, error)))
    let mut input = TimeInput { text: text, position: 0 }
    let mut result = DateTime {
        year: 1900,
        month: 1,
        day: 1,
        hour: 0,
        minute: 0,
        second: 0,
        nanosecond: 0,
        offset: UtcOffset { seconds: 0 },
    }
    let century: i64? = .None
    let short_year: i64? = .None
    let iso_year: i64? = .None
    let iso_week: i64? = .None
    let week: i64? = .None
    let week_monday = false
    let weekday: i64? = .None
    let ordinal: i64? = .None
    let epoch: i64? = .None
    let twelve_hour = false
    let pm = false
    let day_position: usize = 0
    let century_position: usize = 0
    let ordinal_position: usize = 0
    let iso_week_position: usize = 0
    let epoch_position: usize = 0
    let position: usize = 0
    while position < expanded.len():
        byte := expanded[position]
        position += 1
        if byte != 37:
            if byte == 32 || (byte >= 9 && byte <= 13):
                input.spaces()
            else:
                if input.position == text.len() || text[input.position] != byte:
                    return .Err(input.mismatch())
                input.position += 1
            continue
        directive := expanded[position]
        position += 1
        start := input.position
        match directive:
            89 =>
                result.year = i32(
                    input.signed(
                        if next_time_number(expanded, position): 4 else: 10,
                        -2147483648,
                        2147483647,
                    )?
                )
            121 => short_year = .Some(input.number(2, 0, 99)?)
            67 =>
                century_position = start
                century = .Some(
                    input.signed(
                        if next_time_number(expanded, position): 2 else: 8,
                        -21474837,
                        21474836,
                    )?
                )
            109 => result.month = u8(input.number(2, 1, 12)?)
            100 =>
                day_position = start
                result.day = u8(input.number(2, 1, 31)?)
            101 =>
                input.spaces()
                day_position = input.position
                result.day = u8(input.number(2, 1, 31)?)
            72 => result.hour = u8(input.number(2, 0, 23)?)
            107 =>
                input.spaces()
                result.hour = u8(input.number(2, 0, 23)?)
            73 =>
                twelve_hour = true
                result.hour = u8(input.number(2, 1, 12)?)
            108 =>
                input.spaces()
                twelve_hour = true
                result.hour = u8(input.number(2, 1, 12)?)
            77 => result.minute = u8(input.number(2, 0, 59)?)
            83 => result.second = u8(input.number(2, 0, 59)?)
            102 =>
                let fraction = input.number(6, 0, 999999)?
                let digits = input.position - start
                while digits < 9:
                    fraction *= 10
                    digits += 1
                result.nanosecond = u32(fraction)
            98 => result.month = u8(input.name(month_names(false))? + 1)
            104 => result.month = u8(input.name(month_names(false))? + 1)
            66 => result.month = u8(input.name(month_names(true))? + 1)
            97 => weekday = .Some(i64(input.name(weekday_names(false))?))
            65 => weekday = .Some(i64(input.name(weekday_names(true))?))
            112 => pm = input.name(["AM", "PM"])? == 1
            106 =>
                ordinal_position = start
                ordinal = .Some(input.number(3, 1, 366)?)
            117 => weekday = .Some(input.number(1, 1, 7)? - 1)
            119 => weekday = .Some((input.number(1, 0, 6)? + 6) % 7)
            85 =>
                week = .Some(input.number(2, 0, 53)?)
                week_monday = false
            87 =>
                week = .Some(input.number(2, 0, 53)?)
                week_monday = true
            71 =>
                iso_year = .Some(
                    input.signed(
                        if next_time_number(expanded, position): 4 else: 10,
                        -2147483649,
                        2147483648,
                    )?
                )
            103 =>
                value := input.number(2, 0, 99)?
                iso_year = .Some(if value <= 68: 2000 + value else: 1900 + value)
            86 =>
                iso_week_position = start
                iso_week = .Some(input.number(2, 1, 53)?)
            115 =>
                epoch_position = start
                epoch = .Some(input.signed(19, -9223372036854775807 - 1, 9223372036854775807)?)
            122 =>
                if input.position < text.len() && text[input.position] == 90:
                    input.position += 1
                    result.offset = UtcOffset { seconds: 0 }
                else:
                    if (
                        input.position == text.len()
                        || (text[input.position] != 43 && text[input.position] != 45)
                    ):
                        return .Err(input.mismatch())
                    negative := text[input.position] == 45
                    input.position += 1
                    hours := input.exact_number(2, 23)?
                    colon := input.position < text.len() && text[input.position] == 58
                    if colon:
                        input.position += 1
                    minutes := input.exact_number(2, 59)?
                    let seconds: i64 = 0
                    if colon && input.position < text.len() && text[input.position] == 58:
                        input.position += 1
                        seconds = input.exact_number(2, 59)?
                    else if (
                        !colon
                        && input.position < text.len()
                        && text[input.position] >= 48
                        && text[input.position] <= 57
                    ):
                        seconds = input.exact_number(2, 59)?
                    offset := hours * 3600 + minutes * 60 + seconds
                    result.offset = UtcOffset { seconds: i32(if negative: -offset else: offset) }
            90 =>
                _ := input.name(["UTC", "GMT", "Z"])?
                result.zone = .Some(text.slice(start, input.position))
            110 => input.spaces()
            116 => input.spaces()
            37 =>
                if input.position == text.len() || text[input.position] != 37:
                    return .Err(input.mismatch())
                input.position += 1
            _ => return .Err(.InvalidCharacter(position - 1))
    if input.position < text.len():
        return .Err(input.mismatch())
    match short_year:
        .Some(value) =>
            year := match century:
                .Some(base) => base * 100 + value
                .None =>
                    if value <= 68: 2000 + value else: 1900 + value
            if year < -2147483648 || year > 2147483647:
                return .Err(.OutOfRange(century_position))
            result.year = i32(year)
        .None =>
            match century:
                .Some(base) =>
                    year := base * 100
                    if year < -2147483648 || year > 2147483647:
                        return .Err(.OutOfRange(century_position))
                    result.year = i32(year)
                .None => pass
    if twelve_hour:
        result.hour = result.hour % 12 + (if pm: 12 else: 0)
    let calendar: i64? = .None
    match iso_week:
        .Some(value) =>
            let (year, selected_weekday) = match (iso_year, weekday):
                (.Some(year), .Some(selected)) => (year, selected)
                _ => return .Err(.Other("ISO week requires an ISO year and weekday"))
            first := days_from_civil(year, 1, 4)
            first_monday := first - positive_remainder(first + 3, 7)
            next := days_from_civil(year + 1, 1, 4)
            next_monday := next - positive_remainder(next + 3, 7)
            day := first_monday + (value - 1) * 7 + selected_weekday
            if day >= next_monday:
                return .Err(.OutOfRange(iso_week_position))
            calendar = .Some(day)
        .None =>
            if iso_year.is_some():
                return .Err(.Other("ISO year requires an ISO week and weekday"))
    if calendar.is_none():
        match ordinal:
            .Some(value) =>
                first := days_from_civil(i64(result.year), 1, 1)
                if value > days_from_civil(i64(result.year) + 1, 1, 1) - first:
                    return .Err(.OutOfRange(ordinal_position))
                calendar = .Some(first + value - 1)
            .None =>
                match week:
                    .Some(value) =>
                        match weekday:
                            .Some(selected_weekday) =>
                                first := days_from_civil(i64(result.year), 1, 1)
                                shift := if week_monday: 3 else: 4
                                first_weekday := positive_remainder(first + shift, 7)
                                selected := positive_remainder(
                                    selected_weekday + (if week_monday: 0 else: 1),
                                    7,
                                )
                                delta := if value == 0:
                                    selected - first_weekday
                                else:
                                    (
                                        positive_remainder(7 - first_weekday, 7)
                                        + (value - 1) * 7
                                        + selected
                                    )
                                calendar = .Some(first + delta)
                            .None => pass
                    .None => pass
    match calendar:
        .Some(day) =>
            if (
                day < days_from_civil(-2147483648, 1, 1)
                || day > days_from_civil(2147483647, 12, 31)
            ):
                return .Err(.Other("calendar date is outside the i32 year range"))
            date := civil_from_days(day)
            result.year = date.year
            result.month = u8(date.month)
            result.day = u8(date.day)
        .None => pass
    match epoch:
        .Some(value) =>
            # DateTime's i32 year bounds are narrower than i64 seconds.
            minimum := days_from_civil(-2147483648, 1, 1) * 86400 - i64(result.offset.seconds)
            maximum := (
                days_from_civil(2147483647, 12, 31) * 86400
                + 86399
                - i64(result.offset.seconds)
            )
            if value < minimum || value > maximum:
                return .Err(.OutOfRange(epoch_position))
            zone := result.zone
            result = datetime_from_seconds(value, result.nanosecond, result.offset)
            result.zone = zone
        .None => pass
    if result.calendar_day().is_none():
        return .Err(.OutOfRange(day_position))
    .Ok(result)

# Why time text did not parse (spec/std/time.md#time-parse-errors): one error
# for RFC 3339 timestamps and duration text.
## Why time text failed to parse: the kind, and the byte position.
## See [std-time.parse-error.declared-other](../../spec/std/time.md#r-std-time.parse-error.declared-other).
@error
@derive(Debug, Eq)
pub enum ParseTimeError:
    # A character that the grammar does not allow at its place.
    @error("invalid character at position $position")
    InvalidCharacter(position: usize)
    # A field or total whose value is not allowed.
    @error("value out of range at position $position")
    OutOfRange(position: usize)
    # The text ends early; `position` is its length.
    @error("the text ends at position $position, before the value is complete")
    TooShort(position: usize)
    # Duration text: a number with no unit after it.
    @error("missing unit at position $position")
    MissingUnit(position: usize)
    # Duration text: letters after a number that name no unit.
    @error("unknown unit at position $position")
    UnknownUnit(position: usize)
    # Duration text: a component that is not a whole number of milliseconds.
    @error("not a whole number of milliseconds at position $position")
    Inexact(position: usize)
    @error("$message")
    Other(message: string)

# Howard Hinnant's `civil_from_days`: the date `day` days after
# 1970-01-01. An era is 400 years, 146097 days, and each year in it starts
# on March 1, so the leap day falls at the end.
fn civil_from_days(day: i64) -> Date:
    shifted := day + 719468
    era := (if shifted >= 0: shifted else: shifted - 146096) / 146097
    of_era := shifted - era * 146097
    year_of_era := (of_era - of_era / 1460 + of_era / 36524 - of_era / 146096) / 365
    of_year := of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    from_march := (5 * of_year + 2) / 153
    month := if from_march < 10: from_march + 3 else: from_march - 9
    let year = year_of_era + era * 400
    if month <= 2:
        year = year + 1
    Date { year: i32(year), month: i32(month), day: i32(of_year - (153 * from_march + 2) / 5 + 1) }

# Hinnant's `days_from_civil`, the inverse of `civil_from_days`.
fn days_from_civil(year: i64, month: i64, day: i64) -> i64:
    march_year := if month <= 2: year - 1 else: year
    era := (if march_year >= 0: march_year else: march_year - 399) / 400
    year_of_era := march_year - era * 400
    from_march := if month > 2: month - 3 else: month + 9
    of_year := (153 * from_march + 2) / 5 + day - 1
    era * 146097 + year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + of_year - 719468

fn days_in_month(year: i64, month: i64) -> i64:
    if month == 2:
        leap := year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
        return if leap: 29 else: 28
    if month == 4 || month == 6 || month == 9 || month == 11:
        return 30
    31

# A non-negative number in at least `width` digits.
fn zero_padded(value: i64, width: usize) -> string:
    let text = "$value"
    while text.len() < width:
        text = "0" + text
    text

# At least four digits, with `-` before a negative year.
fn year_digits(year: i32) -> string:
    if year < 0:
        return "-" + zero_padded(-i64(year), 4)
    zero_padded(i64(year), 4)

# One code per byte: the ASCII code, or -1 for a byte of any other
# character, so an index is a byte offset (r-std-time.parse-error.position-bytes).
fn byte_codes(text: string) -> List[i32]:
    let mut codes: List[i32] = []
    for byte in text.bytes():
        if byte < 128:
            codes.push(i32(byte))
        else:
            codes.push(-1)
    codes

# Where `shape` stops matching the codes from `start`: `d` is a digit,
# `T` is `T` or `t`, and any other character is itself. It is the index
# of the first mismatch, or the index after the shape when all match.
fn rfc3339_reach(codes: List[i32], start: usize, shape: string) -> usize:
    let index = start
    for need in shape.bytes():
        if index >= codes.len():
            return index
        code := codes[index]
        fits := if need == 100:
            code >= 48 && code <= 57
        else if need == 84:
            code == 84 || code == 116
        else:
            code == i32(need)
        if !fits:
            return index
        index = index + 1
    index

# The error at `index`, where the shape stopped matching.
fn rfc3339_mismatch(codes: List[i32], index: usize) -> ParseTimeError:
    if index >= codes.len():
        return ParseTimeError.TooShort(codes.len())
    ParseTimeError.InvalidCharacter(index)

# The value of the `width` digits from `start`, which the shape checked.
fn rfc3339_value(codes: List[i32], start: usize, width: usize) -> i64:
    let value: i64 = 0
    let index = start
    while index < start + width:
        value = value * 10 + i64(codes[index] - 48)
        index = index + 1
    value

# RFC 3339 `date-time`. Each field's range is checked once its digits
# match, before any later mismatch, so the first error from the left wins
# (r-std-time.parse-error.order).
fn parse_byte_codes(codes: List[i32]) -> Result[Timestamp, ParseTimeError]:
    reach := rfc3339_reach(codes, 0, "dddd-dd-ddTdd:dd:dd")
    # year, month, day, hour, minute, second
    let mut parts: List[i64] = []
    let starts: List[usize] = [0, 5, 8, 11, 14, 17]
    for start in starts:
        let width: usize = if start == 0: 4 else: 2
        if reach < start + width:
            return .Err(rfc3339_mismatch(codes, reach))
        value := rfc3339_value(codes, start, width)
        parts.push(value)
        let high: i64 = 59
        if start == 0:
            high = 9999
        else if start == 5:
            high = 12
        else if start == 8:
            high = days_in_month(parts[0], parts[1])
        else if start == 11:
            high = 23
        if value > high || (value == 0 && (start == 5 || start == 8)):
            return .Err(ParseTimeError.OutOfRange(start))
    let index: usize = 19
    let fraction: i64 = 0
    if index < codes.len() && codes[index] == 46:
        index = index + 1
        start := index
        while index < codes.len() && codes[index] >= 48 && codes[index] <= 57:
            if index - start < 3:
                fraction = fraction * 10 + i64(codes[index] - 48)
            index = index + 1
        if index == start:
            return .Err(rfc3339_mismatch(codes, index))
        let read = index - start
        while read < 3:
            fraction = fraction * 10
            read = read + 1
    if index >= codes.len():
        return .Err(ParseTimeError.TooShort(codes.len()))
    zone := codes[index]
    let offset: i64 = 0
    if zone == 90 || zone == 122:
        index = index + 1
    else if zone == 43 || zone == 45:
        zone_reach := rfc3339_reach(codes, index + 1, "dd:dd")
        if zone_reach < index + 3:
            return .Err(rfc3339_mismatch(codes, zone_reach))
        hours := rfc3339_value(codes, index + 1, 2)
        if hours > 23:
            return .Err(ParseTimeError.OutOfRange(index + 1))
        if zone_reach < index + 6:
            return .Err(rfc3339_mismatch(codes, zone_reach))
        minutes := rfc3339_value(codes, index + 4, 2)
        if minutes > 59:
            return .Err(ParseTimeError.OutOfRange(index + 4))
        offset = (hours * 60 + minutes) * 60000
        if zone == 45:
            offset = -offset
        index = index + 6
    else:
        return .Err(ParseTimeError.InvalidCharacter(index))
    if index < codes.len():
        return .Err(ParseTimeError.InvalidCharacter(index))
    local := (
        days_from_civil(parts[0], parts[1], parts[2]) * 86400000
        + parts[3] * 3600000
        + parts[4] * 60000
        + parts[5] * 1000
        + fraction
    )
    .Ok(Timestamp { millis: local - offset })

# Whole milliseconds since an origin that the provider chooses
# (r-std-time.instant.decl).
## A reading of the monotonic clock, for measuring intervals.
## See [std-time.instant.decl](../../spec/std/time.md#r-std-time.instant.decl).
pub struct Instant:
    millis: i64

impl Instant:
    ## Returns the instant that holds `millis` milliseconds since the provider's origin.
    ## See [std-time.instant.api-milliseconds](../../spec/std/time.md#r-std-time.instant.api-milliseconds).
    pub fn from_milliseconds(millis: i64) -> Instant:
        Instant { millis: millis }

    # The inverse of `from_milliseconds` (r-std-time.instant.as-milliseconds).
    pub fn as_milliseconds(self) -> i64:
        self.millis

    ## The time from `earlier` to the instant, or `.None` when `earlier` is the later one.
    ## See [std-time.instant.checked-since](../../spec/std/time.md#r-std-time.instant.checked-since).
    pub fn checked_since(self, earlier: Instant) -> Duration?:
        checked_millis_since(self.millis, earlier.millis)

    ## The time from `earlier` to the instant, or zero when `earlier` is the later one.
    ## See [std-time.instant.since](../../spec/std/time.md#r-std-time.instant.since).
    pub fn since(self, earlier: Instant) -> Duration:
        millis_since(self.millis, earlier.millis)

# The span from `earlier` to `later`, or `.None` when `earlier` is later or
# the span does not fit in `i64` milliseconds.
fn checked_millis_since(later: i64, earlier: i64) -> Duration?:
    if earlier > later:
        return .None
    match later.checked_sub(earlier):
        .Some(span) => .Some(Duration { millis: span })
        .None => .None

# The span from `earlier` to `later`: zero when `earlier` is later, and the
# longest duration when the span does not fit.
fn millis_since(later: i64, earlier: i64) -> Duration:
    if earlier > later:
        return Duration { millis: 0 }
    Duration { millis: later.saturating_sub(earlier) }

# An `Instant` debugs as its milliseconds, as `Instant(5ms)`
# (r-std-format.debug.std-types.time).
# Keep handwritten Debug: keep the duration/time text instead of structural fields.
impl Debug for Instant:
    fn debug(&self, out: *mut DebugWriter) -> void:
        out.write("Instant(${self.millis}ms)")

# Keep handwritten Eq: deriving Eq alone conflicts with the existing order impls.
impl Eq for Instant:
    fn eq(&self, other: &Instant) -> bool:
        self.millis == other.millis

impl PartialOrd for Instant:
    fn partial_cmp(&self, other: &Instant) -> Ordering?:
        .Some(self.millis.cmp(&other.millis))

impl Ord for Instant:
    fn cmp(&self, other: &Instant) -> Ordering:
        self.millis.cmp(&other.millis)

# The deterministic `Clock` (spec/std/time.md#manual-clock). Virtual time
# moves only when every task waits: then it jumps to the earliest pending
# deadline, as tokio's paused clock does, so concurrent sleeps overlap
# (r-std-time.manual.sleep.idle).
#
# A clock's state is its `Timeline`, shared by every copy of the clock.
# Each pending sleep has a `Due` entry in the timeline's `due`, a min-heap
# by deadline and then start order, which shares the sleep's `Pending`
# state: its own wait cell and whether it still waits. A timeline with a
# pending sleep is in `idle_clocks`. When every task waits, the runtime
# runs the idle hook, `advance_clocks`: each listed timeline moves to its
# earliest live deadline and signals the cells of the sleeps that are due.
# No task has to run for the time to move, so a `block_on` nested in a task
# advances a clock that a blocked outer task also sleeps on. A sleep that
# ends or is cancelled is no longer live; its entry is dropped when it
# reaches the top, and a timeline with no live sleep leaves `idle_clocks`.
# Cost: O(log n) heap work per sleep in the n pending sleeps of its clock,
# one cell, and one wake when it is due; an idle point does O(1) work per
# waiting clock plus the sleeps it readies, and wakes nothing else.
## The deterministic `Clock` provider: virtual time that a test advances.
## See [std-time.manual.decl-ref](../../spec/std/time.md#r-std-time.manual.decl-ref).
pub struct ManualClock:
    timeline: *mut Timeline

# The current time in milliseconds, the pending sleeps, the next start
# order, and whether the timeline is in `idle_clocks`, with its link.
struct Timeline:
    current: i64
    due: Heap[Due]
    next: u64
    listed: bool
    next_idle: *mut Timeline?

# A pending sleep's deadline in milliseconds, its start order, and its
# state. The order is reversed, so `Heap`'s largest is the earliest
# deadline, and the first started among equal ones.
struct Due:
    deadline: i64
    seq: u64
    sleep: *mut Pending

# A sleep's wait cell, and whether the sleep still waits.
struct Pending:
    cell: *mut WaitCell
    live: bool

impl Eq for Due:
    fn eq(&self, other: &Due) -> bool:
        self.deadline == other.deadline && self.seq == other.seq

impl PartialOrd for Due:
    fn partial_cmp(&self, other: &Due) -> Ordering?:
        .Some(self.cmp(other))

impl Ord for Due:
    fn cmp(&self, other: &Due) -> Ordering:
        match other.deadline.cmp(&self.deadline):
            .Equal => other.seq.cmp(&self.seq)
            order => order

# The timelines that have a pending sleep, linked through `next_idle`.
# Its init stores a constant that only a ManualClock sleep overwrites, so a
# program that sleeps on no ManualClock runs no init for it.
let mut idle_clocks: *mut Timeline? = .None

# The idle hook (std.rt.wait): advances every listed timeline once, and
# unlinks the timelines that no longer have a live sleep.
fn advance_clocks() -> void:
    let mut previous: *mut Timeline? = .None
    let mut at = idle_clocks
    while true:
        match at:
            .None => return
            .Some(timeline) =>
                next := timeline.next_idle
                if timeline.advance():
                    previous = .Some(timeline)
                else:
                    timeline.listed = false
                    timeline.next_idle = .None
                    match previous:
                        .None => idle_clocks = next
                        .Some(kept) => kept.next_idle = next
                at = next

impl Timeline:
    # The earliest live pending sleep, after dropping the dead entries above it.
    fn earliest(&mut self) -> Due?:
        while true:
            top := self.due.peek()?
            if top.sleep.live:
                return .Some(top)
            _ := self.due.pop()
        .None

    # At an idle point: move the time to the earliest live deadline and
    # wake every sleep that is due. True when a live sleep remains.
    fn advance(&mut self) -> bool:
        first := match self.earliest():
            .Some(due) => due
            .None => return false
        if first.deadline > self.current:
            self.current = first.deadline
        while true:
            match self.earliest():
                .Some(due) =>
                    if due.deadline > self.current:
                        return true
                    _ := self.due.pop()
                    due.sleep.live = false
                    wait_signal(due.sleep.cell)
                .None => return false
        false

    # Waits until the current time reaches `deadline`.
    fn wait!(timeline: *mut Timeline, deadline: i64) -> void:
        seq := timeline.next
        timeline.next = seq + 1
        cell := wait_cell()
        sleep := box(Pending { cell: cell, live: true })
        timeline.due.push(Due { deadline: deadline, seq: seq, sleep: sleep })
        if !timeline.listed:
            timeline.listed = true
            timeline.next_idle = idle_clocks
            idle_clocks = .Some(timeline)
        idle_hook(advance_clocks)
        defer(fn() -> void: sleep.live = false)
        while timeline.current < deadline:
            let woken: Suspend[void] = wait_frame(cell)
            woken!()

impl ManualClock:
    ## Returns a `ManualClock` whose current time starts at `start`.
    ## See [std-time.manual.decl-ref](../../spec/std/time.md#r-std-time.manual.decl-ref).
    pub fn new(start: Timestamp) -> *mut ManualClock:
        # Boxed because the returned clock is installed as a provider and advanced later.
        timeline := box(
            Timeline {
                current: start.millis,
                due: Heap::new(),
                next: 0,
                listed: false,
                next_idle: .None,
            },
        )
        box(ManualClock { timeline: timeline })

# A frame that completes once `cell` is signalled after the call
# (std.rt.wait).
@intrinsic("task_wait_frame")
fn wait_frame(cell: *mut WaitCell) -> Suspend[void]:
    panic("intrinsic")

# `ManualClock` debugs as its current time, its only state that a reader
# sees; the pending sleeps are the scheduler's.
impl Debug for ManualClock:
    fn debug(&self, out: *mut DebugWriter) -> void:
        out.debug_struct("ManualClock").field("current", self.now()).finish()

impl Clock for ManualClock:
    fn now(self) -> Timestamp:
        Timestamp::from_unix_milliseconds(self.timeline.current)

    # The monotonic origin is the Unix epoch (r-std-time.manual.monotonic).
    fn monotonic(self) -> Instant:
        Instant::from_milliseconds(self.timeline.current)

    # A zero duration leaves the time as it is and returns at once
    # (r-std-time.manual.sleep.zero). Otherwise the sleep waits until
    # the time reaches its deadline (r-std-time.manual.sleep.idle).
    fn sleep!(&mut self, duration: Duration) -> void:
        if duration.as_milliseconds() == 0:
            return
        deadline := add_duration_to_point(self.timeline.current, duration)
        Timeline::wait!(self.timeline, deadline)

# `Duration` and `Instant` serialize to every format, and so to the host
# boundary, as their whole milliseconds; a `Timestamp` serializes as its
# RFC 3339 text (r-std-time.serde.impls, r-std-time.serde.int-form,
# r-std-time.serde.text-form).
# Keep handwritten Serialize: keep the canonical text wire format instead of a field object.
impl Serialize for Duration:
    fn regular() -> bool:
        true

    fn serialize[W < Serializer](&self, out: &mut W) -> Result[void, W::Error]:
        out.int(self.millis)

# Keep handwritten Deserialize: keep the canonical text wire format instead of a field object.
impl Deserialize for Duration:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Duration, R::Error]:
        match input.peek()?:
            .Text =>
                text := input.text("Duration")?
                match Duration::parse(text):
                    .Ok(duration) => .Ok(duration)
                    .Err(_) => .Err(input.invalid("Duration"))
            _ =>
                millis := input.int("Duration")?
                if millis < 0:
                    return .Err(input.invalid("Duration"))
                .Ok(Duration { millis: millis })

# Keep handwritten Serialize: keep the canonical text wire format instead of a field object.
impl Serialize for Timestamp:
    fn regular() -> bool:
        true

    fn serialize[W < Serializer](&self, out: &mut W) -> Result[void, W::Error]:
        out.text(self.to_rfc3339())

# Keep handwritten Deserialize: keep the canonical text wire format instead of a field object.
impl Deserialize for Timestamp:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Timestamp, R::Error]:
        text := input.text("Timestamp")?
        match Timestamp::parse(text):
            .Ok(stamp) => .Ok(stamp)
            .Err(_) => .Err(input.invalid("Timestamp"))

# Keep handwritten Serialize: keep the millisecond scalar wire format instead of a field object.
impl Serialize for Instant:
    fn regular() -> bool:
        true

    fn serialize[W < Serializer](&self, out: &mut W) -> Result[void, W::Error]:
        out.int(self.millis)

# Keep handwritten Deserialize: keep the millisecond scalar wire format instead of a field object.
impl Deserialize for Instant:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Instant, R::Error]:
        .Ok(Instant { millis: input.int("Instant")? })

# A unit's scale: its milliseconds per unit, and how many units make one
# millisecond (1 for a unit of a millisecond or more).
fn duration_unit_scale(unit: string) -> (i64, i64)?:
    match unit:
        "h" => .Some((3600000, 1))
        "m" => .Some((60000, 1))
        "min" => .Some((60000, 1))
        "s" => .Some((1000, 1))
        "ms" => .Some((1, 1))
        "us" => .Some((1, 1000))
        "\u{b5}s" => .Some((1, 1000))
        "\u{3bc}s" => .Some((1, 1000))
        "ns" => .Some((1, 1000000))
        _ => .None

fn power_of_ten(places: usize) -> i64:
    let value: i64 = 1
    let count: usize = 0
    while count < places:
        value = value * 10
        count = count + 1
    value

fn is_digit_code(code: i32) -> bool:
    code >= 48 && code <= 57

# Go's `time.ParseDuration` at millisecond resolution
# (r-std-time.duration.parse). A `-` sign is not allowed, as no duration is
# negative (r-std-time.duration.parse.no-sign).
fn parse_duration_text(text: string) -> Result[Duration, ParseTimeError]:
    codes := byte_codes(text)
    size := codes.len()
    let index: usize = 0
    if index < size && codes[index] == 43:
        index = index + 1
    if index >= size:
        return .Err(ParseTimeError.TooShort(size))
    if index + 1 == size && codes[index] == 48:
        return .Ok(Duration { millis: 0 })
    let limit: i64 = 9223372036854775807
    let total: i64 = 0
    while index < size:
        start := index
        let whole: i64 = 0
        let overflow = false
        while index < size && is_digit_code(codes[index]):
            digit := i64(codes[index] - 48)
            if whole > 922337203685477580 || (whole == 922337203685477580 && digit > 7):
                overflow = true
            else:
                whole = whole * 10 + digit
            index = index + 1
        if index == start:
            return .Err(ParseTimeError.InvalidCharacter(index))
        let fraction: i64 = 0
        let places: usize = 0
        let inexact = false
        if index < size && codes[index] == 46:
            index = index + 1
            first := index
            while index < size && is_digit_code(codes[index]):
                index = index + 1
            if index == first:
                if index >= size:
                    return .Err(ParseTimeError.TooShort(size))
                return .Err(ParseTimeError.InvalidCharacter(index))
            let last = index
            while last > first && codes[last - 1] == 48:
                last = last - 1
            if last - first > 11:
                inexact = true
            else:
                fraction = rfc3339_value(codes, first, last - first)
                places = last - first
        unit_start := index
        while index < size && !is_digit_code(codes[index]) && codes[index] != 46:
            index = index + 1
        if index == unit_start:
            return .Err(ParseTimeError.MissingUnit(index))
        scale := match duration_unit_scale(text.slice(unit_start, index)):
            .Some(found) => found
            .None => return .Err(ParseTimeError.UnknownUnit(unit_start))
        if overflow:
            return .Err(ParseTimeError.OutOfRange(start))
        multiplier := scale._0
        divisor := scale._1
        let component: i64 = 0
        if divisor > 1:
            if inexact || fraction != 0 || whole % divisor != 0:
                return .Err(ParseTimeError.Inexact(start))
            component = whole / divisor
        else:
            if inexact:
                return .Err(ParseTimeError.Inexact(start))
            scaled := fraction * multiplier
            scale_down := power_of_ten(places)
            if scaled % scale_down != 0:
                return .Err(ParseTimeError.Inexact(start))
            if whole > limit / multiplier:
                return .Err(ParseTimeError.OutOfRange(start))
            part := scaled / scale_down
            if whole * multiplier > limit - part:
                return .Err(ParseTimeError.OutOfRange(start))
            component = whole * multiplier + part
        if component > limit - total:
            return .Err(ParseTimeError.OutOfRange(start))
        total = total + component
    .Ok(Duration { millis: total })
