# std.time: `Duration` and its literal suffixes, the host capability
# `Clock` with `Timestamp` and `Instant`, and the
# deterministic `ManualClock`, and the UTC `Date` with RFC 3339 text
# (spec/std/time.md).
# A `Duration` is a whole number of
# milliseconds in an `i64` (r-std-time.suffix.std.duration), and its public API is
# `milliseconds`, `seconds`, and `as_milliseconds` (r-std-time.suffix.std.duration-api);
# the `millis` field is the prototype's own. Each suffix scales its literal by
# checked `i64` multiplication, so an overflow panics (r-std-time.suffix.std.overflow).
# Each suffix is a function marked `@num_suffix` (r-std-time.suffix.std.fn).
# `-5s` is the ordinary negation `-(5s)`, so `Duration` implements `Neg`
# (r-std-time.suffix.std.duration-neg).
use std.format.DebugWriter
use std.error.Error
use std.text.Parse
use std.ops.{Add, Neg, Sub, num_suffix}
use std.serde.{Serialize, Deserialize, Serializer, Deserializer}

## A distance in time, as a count of whole milliseconds, positive or negative.
## See [std-time.suffix.std.duration](../../spec/std/time.md#r-std-time.suffix.std.duration).
pub data Duration:
    millis: i64

impl Duration:
    ## Returns a `Duration` of that many milliseconds.
    ## See [std-time.suffix.std.duration-api](../../spec/std/time.md#r-std-time.suffix.std.duration-api).
    pub fn milliseconds(count: i64) -> Duration:
        Duration { millis: count }

    ## Returns a `Duration` of that many seconds.
    ## See [std-time.suffix.std.duration-api](../../spec/std/time.md#r-std-time.suffix.std.duration-api).
    pub fn seconds(count: i64) -> Duration:
        Duration { millis: count * 1000 }

    ## The milliseconds since the origin that the instant holds.
    ## See [std-time.instant.as-milliseconds](../../spec/std/time.md#r-std-time.instant.as-milliseconds).
    pub fn as_milliseconds(self) -> i64:
        self.millis

# Go's `time.ParseDuration` text, such as `1h30m` or `250ms`
# (r-std-time.duration.parse).
impl Parse for Duration:
    type Error = ParseTimeError

    fn parse(text: string) -> Result[Duration, ParseTimeError]:
        parse_duration_text(text)

impl Neg for Duration:
    type Out = Duration
    fn neg(self) -> Duration:
        Duration { millis: -self.millis }

# Checked `i64` arithmetic on the milliseconds, so an overflow panics
# (r-std-time.duration.add, r-std-time.duration.overflow).
impl Add for Duration:
    type Out = Duration
    fn add(self, rhs: Duration) -> Duration:
        Duration { millis: self.millis + rhs.millis }

impl Sub for Duration:
    type Out = Duration
    fn sub(self, rhs: Duration) -> Duration:
        Duration { millis: self.millis - rhs.millis }

# Go's `time.Duration.String`, in hd's units (r-std-time.duration.text):
# `h`, `min`, then `s` with the milliseconds as a fraction, and every
# component below the largest one written, even when zero; under one
# second, `ms`; zero is `0s`. Each component is taken from the signed
# milliseconds by truncating division, and only that small component is
# negated, so the most negative duration does not overflow
# (r-std-time.duration.text.min-value).
impl Display for Duration:
    fn to_string(self) -> string:
        millis := self.millis
        if millis == 0:
            return "0s"
        let text = ""
        if millis < 0:
            text = "-"
        if millis > -1000 && millis < 1000:
            return "${text}${magnitude(millis)}ms"
        hours := magnitude(millis / 3600000)
        minutes := magnitude((millis % 3600000) / 60000)
        seconds := magnitude((millis % 60000) / 1000)
        fraction := magnitude(millis % 1000)
        if hours > 0:
            text = text + "${hours}h"
        if hours > 0 || minutes > 0:
            text = text + "${minutes}min"
        text = text + "${seconds}"
        if fraction > 0:
            text = text + "." + fraction_digits(fraction)
        text + "s"

# The absolute value of one component, which is far from the `i64` limits.
fn magnitude(value: i64) -> i64:
    if value < 0:
        return -value
    value

# The milliseconds `1` to `999` as the decimal digits after the point,
# without trailing zeros (r-std-time.duration.text.fraction).
fn fraction_digits(fraction: i64) -> string:
    if fraction % 100 == 0:
        return "${fraction / 100}"
    if fraction % 10 == 0:
        tenths := fraction / 10
        if tenths < 10:
            return "0${tenths}"
        return "${tenths}"
    if fraction < 10:
        return "00${fraction}"
    if fraction < 100:
        return "0${fraction}"
    "${fraction}"

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.
# A `Duration` debugs as its `Display` text, as `250ms`
# (r-std-format.debug.std-types.time).
impl Debug for Duration:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write(self.to_string())

# Durations compare by their milliseconds (r-std-time.duration.eq-ord).
impl Eq for Duration:
    fn eq(self, other: Duration) -> bool:
        self.millis == other.millis

impl PartialOrd for Duration:
    fn partial_cmp(self, other: Duration) -> Ordering?:
        .Some(self.millis.cmp(other.millis))

impl Ord for Duration:
    fn cmp(self, other: Duration) -> Ordering:
        self.millis.cmp(other.millis)

@num_suffix
## The `ms` suffix: a `Duration` of that many milliseconds, as in `250ms`.
## See [std-time.suffix.std.ms](../../spec/std/time.md#r-std-time.suffix.std.ms).
pub fn ms(count: i64) -> Duration:
    Duration::milliseconds(count)

@num_suffix
## The `s` suffix: a `Duration` of that many seconds, as in `5s`.
## See [std-time.suffix.std.s](../../spec/std/time.md#r-std-time.suffix.std.s).
pub fn s(count: i64) -> Duration:
    Duration::seconds(count)

@num_suffix
## The `min` suffix: a `Duration` of that many minutes, as in `90min`.
## See [std-time.suffix.std.min](../../spec/std/time.md#r-std-time.suffix.std.min).
pub fn min(count: i64) -> Duration:
    Duration::seconds(count * 60)

@num_suffix
## The `h` suffix: a `Duration` of that many hours, as in `2h`.
## See [std-time.suffix.std.h](../../spec/std/time.md#r-std-time.suffix.std.h).
pub fn h(count: i64) -> Duration:
    Duration::seconds(count * 3600)

# The host capability that reads time and waits (spec/std/time.md#clock).
# `sleep!` takes `mut self`, so a provider may advance its own time
# (r-std-time.clock.mut).
## The host capability to read the clock and to wait: `now`, `monotonic`, and `sleep!`.
## See [std-time.clock.decl](../../spec/std/time.md#r-std-time.clock.decl).
pub trait Clock:
    fn now(self) -> Timestamp
    fn monotonic(self) -> Instant
    fn sleep!(mut self, duration: Duration) -> void

# The current time of the covering `Clock` provider
# (spec/std/time.md#r-std-time.helper.now).
## Returns the current wall-clock time as a `Timestamp`.
## See [std-time.helper.now](../../spec/std/time.md#r-std-time.helper.now).
pub fn now() -> Timestamp $ Clock:
    $.use(Clock).now()

# The covering provider's monotonic reading
# (spec/std/time.md#r-std-time.helper.monotonic).
## Returns the current reading of the monotonic clock as an `Instant`.
## See [std-time.helper.monotonic](../../spec/std/time.md#r-std-time.helper.monotonic).
pub fn monotonic() -> Instant $ Clock:
    $.use(Clock).monotonic()

# The time from `since` to the provider's monotonic reading now
# (spec/std/time.md#r-std-time.helper.elapsed).
## Returns the time that has passed on the monotonic clock since `since`.
## See [std-time.helper.elapsed](../../spec/std/time.md#r-std-time.helper.elapsed).
pub fn elapsed(since: Instant) -> Duration $ Clock:
    $.use(Clock).monotonic().since(since)

# Waits `duration` on the covering `Clock` provider
# (spec/std/time.md#r-std-time.helper.sleep).
## Completes once `duration` has passed on the clock.
## See [std-time.helper.sleep](../../spec/std/time.md#r-std-time.helper.sleep).
pub fn sleep!(duration: Duration) -> void $ Clock:
    let mut clock = $.use(Clock)
    clock.sleep!(duration)

# Whole milliseconds since the Unix epoch, in UTC (r-std-time.timestamp.decl).
## A point in UTC time, held as whole milliseconds since the Unix epoch.
## See [std-time.timestamp.decl](../../spec/std/time.md#r-std-time.timestamp.decl).
pub data Timestamp:
    millis: i64

impl Timestamp:
    ## Returns the timestamp that holds `millis` milliseconds since the Unix epoch.
    ## See [std-time.timestamp.api-milliseconds](../../spec/std/time.md#r-std-time.timestamp.api-milliseconds).
    pub fn from_unix_milliseconds(millis: i64) -> Timestamp:
        Timestamp { millis: millis }

    # The inverse of `from_unix_milliseconds` (r-std-time.timestamp.unix-milliseconds).
    ## The milliseconds since the Unix epoch that the timestamp holds.
    ## See [std-time.timestamp.unix-milliseconds](../../spec/std/time.md#r-std-time.timestamp.unix-milliseconds).
    pub fn unix_milliseconds(self) -> i64:
        self.millis

    # Negative when `earlier` is the later one (r-std-time.timestamp.since).
    ## The time from `earlier` to the timestamp, negative when `earlier` is the later one.
    ## See [std-time.timestamp.since](../../spec/std/time.md#r-std-time.timestamp.since).
    pub fn since(self, earlier: Timestamp) -> Duration:
        Duration::milliseconds(self.millis - earlier.millis)

    # The UTC calendar date (r-std-time.date.of-timestamp).
    ## The calendar day of the timestamp in UTC.
    ## See [std-time.timestamp.api-milliseconds](../../spec/std/time.md#r-std-time.timestamp.api-milliseconds).
    pub fn date(self) -> Date:
        civil_from_days(self.days())

    # `YYYY-MM-DDTHH:MM:SSZ`, with `.mmm` before the `Z` when the
    # milliseconds are not zero (r-std-time.rfc3339.text).
    ## The timestamp as RFC 3339 text in UTC.
    ## See [std-time.timestamp.api-milliseconds](../../spec/std/time.md#r-std-time.timestamp.api-milliseconds).
    pub fn to_rfc3339(self) -> string:
        civil := civil_from_days(self.days())
        let clock = self.millis % 86400000
        if clock < 0:
            clock = clock + 86400000
        let text = civil.to_iso8601()
        text = text + "T" + zero_padded(clock / 3600000, 2) + ":" + zero_padded(clock / 60000 % 60, 2) + ":" + zero_padded(clock / 1000 % 60, 2)
        if clock % 1000 != 0:
            text = text + "." + zero_padded(clock % 1000, 3)
        text + "Z"

    # The layout with each `%` specifier replaced (r-std-time.format).
    ## The timestamp as text in UTC, laid out by `%Y %m %d %H %M %S %z %%`.
    ## See [std-time.format](../../spec/std/time.md#r-std-time.format).
    pub fn format(self, layout: string) -> string:
        date := self.date()
        let clock = self.millis % 86400000
        if clock < 0:
            clock = clock + 86400000
        let text = ""
        let pending = false
        for c in layout.chars():
            if !pending:
                if c == '%':
                    pending = true
                else:
                    text = text + "$c"
                continue
            pending = false
            piece := match c:
                'Y' => year_digits(date.year)
                'm' => zero_padded(i64(date.month), 2)
                'd' => zero_padded(i64(date.day), 2)
                'H' => zero_padded(clock / 3600000, 2)
                'M' => zero_padded(clock / 60000 % 60, 2)
                'S' => zero_padded(clock / 1000 % 60, 2)
                'z' => "+0000"
                '%' => "%"
                _ => "%$c"
            text = text + piece
        if pending:
            text = text + "%"
        text

    # Whole days since the epoch, rounded toward negative infinity, so the
    # time of day is never negative. Adjusting the truncated quotient and
    # remainder, never multiplying back, keeps the most negative timestamp
    # in range.
    fn days(self) -> i64:
        let whole = self.millis / 86400000
        if self.millis % 86400000 < 0:
            whole = whole - 1
        whole

# Moves the time by the duration, with checked `i64` addition
# (r-std-time.timestamp.add).
impl Add[Duration] for Timestamp:
    type Out = Timestamp
    fn add(self, rhs: Duration) -> Timestamp:
        Timestamp { millis: self.millis + rhs.as_milliseconds() }

# RFC 3339 text, the text `Display` writes (r-std-time.rfc3339.parse).
impl Parse for Timestamp:
    type Error = ParseTimeError

    fn parse(text: string) -> Result[Timestamp, ParseTimeError]:
        parse_byte_codes(byte_codes(text))

# The RFC 3339 text, as Go's `Time.String` (r-std-time.timestamp.display).
impl Display for Timestamp:
    fn to_string(self) -> string:
        self.to_rfc3339()

# A `Timestamp` debugs as its RFC 3339 text
# (r-std-format.debug.std-types.time).
impl Debug for Timestamp:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write(self.to_rfc3339())

impl Eq for Timestamp:
    fn eq(self, other: Timestamp) -> bool:
        self.millis == other.millis

impl PartialOrd for Timestamp:
    fn partial_cmp(self, other: Timestamp) -> Ordering?:
        .Some(self.millis.cmp(other.millis))

impl Ord for Timestamp:
    fn cmp(self, other: Timestamp) -> Ordering:
        self.millis.cmp(other.millis)

# A calendar date in the proleptic Gregorian calendar, with astronomical
# year numbering: year 0 is 1 BC (spec/std/time.md#dates).
## A calendar day in UTC, in the proleptic Gregorian calendar.
## See [std-time.date.decl](../../spec/std/time.md#r-std-time.date.decl).
pub data Date:
    ## The year, with a year 0.
    ## See [std-time.date.decl](../../spec/std/time.md#r-std-time.date.decl).
    pub year: i32
    ## The month, from 1 to 12.
    ## See [std-time.date.decl](../../spec/std/time.md#r-std-time.date.decl).
    pub month: i32
    ## The day of the month.
    ## See [std-time.date.decl](../../spec/std/time.md#r-std-time.date.decl).
    pub day: i32

impl Date:
    # `YYYY-MM-DD`, the year as in RFC 3339 text (r-std-time.date.iso8601).
    ## The date as ISO 8601 text, as `2026-10-17`.
    ## See [std-time.date.iso8601](../../spec/std/time.md#r-std-time.date.iso8601).
    pub fn to_iso8601(self) -> string:
        year_digits(self.year) + "-" + zero_padded(i64(self.month), 2) + "-" + zero_padded(i64(self.day), 2)

impl Eq for Date:
    fn eq(self, other: Date) -> bool:
        self.year == other.year && self.month == other.month && self.day == other.day

impl Debug for Date:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Date").field("year", self.year).field("month", self.month).field("day", self.day).finish()

# Why time text did not parse (spec/std/time.md#time-parse-errors): one error
# for RFC 3339 timestamps and duration text.
## Why time text failed to parse: the kind, and the byte position.
## See [std-time.parse-error.declared](../../spec/std/time.md#r-std-time.parse-error.declared).
pub enum ParseTimeError:
    # A character that the grammar does not allow at its place.
    InvalidCharacter(position: usize)
    # A field or total whose value is not allowed.
    OutOfRange(position: usize)
    # The text ends early; `position` is its length.
    TooShort(position: usize)
    # Duration text: a number with no unit after it.
    MissingUnit(position: usize)
    # Duration text: letters after a number that name no unit.
    UnknownUnit(position: usize)
    # Duration text: a component that is not a whole number of milliseconds.
    Inexact(position: usize)

impl Eq for ParseTimeError:
    fn eq(self, other: ParseTimeError) -> bool:
        match (self, other):
            (.InvalidCharacter(left), .InvalidCharacter(right)) => left == right
            (.OutOfRange(left), .OutOfRange(right)) => left == right
            (.TooShort(left), .TooShort(right)) => left == right
            (.MissingUnit(left), .MissingUnit(right)) => left == right
            (.UnknownUnit(left), .UnknownUnit(right)) => left == right
            (.Inexact(left), .Inexact(right)) => left == right
            _ => false

impl Display for ParseTimeError:
    fn to_string(self) -> string:
        match self:
            .InvalidCharacter(position) => "invalid character at position $position"
            .OutOfRange(position) => "value out of range at position $position"
            .TooShort(position) => "the text ends at position $position, before the value is complete"
            .MissingUnit(position) => "missing unit at position $position"
            .UnknownUnit(position) => "unknown unit at position $position"
            .Inexact(position) => "not a whole number of milliseconds at position $position"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for ParseTimeError

impl Debug for ParseTimeError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .InvalidCharacter(position) => out.debug_tuple("ParseTimeError.InvalidCharacter").named_field("position", position).finish()
            .OutOfRange(position) => out.debug_tuple("ParseTimeError.OutOfRange").named_field("position", position).finish()
            .TooShort(position) => out.debug_tuple("ParseTimeError.TooShort").named_field("position", position).finish()
            .MissingUnit(position) => out.debug_tuple("ParseTimeError.MissingUnit").named_field("position", position).finish()
            .UnknownUnit(position) => out.debug_tuple("ParseTimeError.UnknownUnit").named_field("position", position).finish()
            .Inexact(position) => out.debug_tuple("ParseTimeError.Inexact").named_field("position", position).finish()

# Howard Hinnant's `civil_from_days`: the date `day` days after
# 1970-01-01. An era is 400 years, 146097 days, and each year in it starts
# on March 1, so the leap day falls at the end.
fn civil_from_days(day: i64) -> Date:
    shifted := day + 719468
    era := (if shifted >= 0: shifted else: shifted - 146096) / 146097
    of_era := shifted - era * 146097
    year_of_era := (of_era - of_era / 1460 + of_era / 36524 - of_era / 146096) / 365
    of_year := of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    from_march := (5 * of_year + 2) / 153
    month := if from_march < 10: from_march + 3 else: from_march - 9
    let year = year_of_era + era * 400
    if month <= 2:
        year = year + 1
    Date { year: i32(year), month: i32(month), day: i32(of_year - (153 * from_march + 2) / 5 + 1) }

# Hinnant's `days_from_civil`, the inverse of `civil_from_days`.
fn days_from_civil(year: i64, month: i64, day: i64) -> i64:
    march_year := if month <= 2: year - 1 else: year
    era := (if march_year >= 0: march_year else: march_year - 399) / 400
    year_of_era := march_year - era * 400
    from_march := if month > 2: month - 3 else: month + 9
    of_year := (153 * from_march + 2) / 5 + day - 1
    era * 146097 + year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + of_year - 719468

fn days_in_month(year: i64, month: i64) -> i64:
    if month == 2:
        leap := year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
        return if leap: 29 else: 28
    if month == 4 || month == 6 || month == 9 || month == 11:
        return 30
    31

# A non-negative number in at least `width` digits.
fn zero_padded(value: i64, width: usize) -> string:
    let text = "$value"
    while text.len() < width:
        text = "0" + text
    text

# At least four digits, with `-` before a negative year.
fn year_digits(year: i32) -> string:
    if year < 0:
        return "-" + zero_padded(-i64(year), 4)
    zero_padded(i64(year), 4)

# One code per byte: the ASCII code, or -1 for a byte of any other
# character, so an index is a byte offset (r-std-time.parse-error.position-bytes).
fn byte_codes(text: string) -> List[i32]:
    let codes: mut List[i32] = []
    for byte in text.bytes():
        if byte < 128:
            codes.push(i32(byte))
        else:
            codes.push(-1)
    codes

# Where `shape` stops matching the codes from `start`: `d` is a digit,
# `T` is `T` or `t`, and any other character is itself. It is the index
# of the first mismatch, or the index after the shape when all match.
fn rfc3339_reach(codes: List[i32], start: usize, shape: string) -> usize:
    let index = start
    for need in shape.bytes():
        if index >= codes.len():
            return index
        code := codes[index]
        fits := if need == 100: code >= 48 && code <= 57 else if need == 84: code == 84 || code == 116 else: code == i32(need)
        if !fits:
            return index
        index = index + 1
    index

# The error at `index`, where the shape stopped matching.
fn rfc3339_mismatch(codes: List[i32], index: usize) -> ParseTimeError:
    if index >= codes.len():
        return ParseTimeError.TooShort(codes.len())
    ParseTimeError.InvalidCharacter(index)

# The value of the `width` digits from `start`, which the shape checked.
fn rfc3339_value(codes: List[i32], start: usize, width: usize) -> i64:
    let value: i64 = 0
    let index = start
    while index < start + width:
        value = value * 10 + i64(codes[index] - 48)
        index = index + 1
    value

# RFC 3339 `date-time`. Each field's range is checked once its digits
# match, before any later mismatch, so the first error from the left wins
# (r-std-time.parse-error.order).
fn parse_byte_codes(codes: List[i32]) -> Result[Timestamp, ParseTimeError]:
    reach := rfc3339_reach(codes, 0, "dddd-dd-ddTdd:dd:dd")
    # year, month, day, hour, minute, second
    let parts: mut List[i64] = []
    let starts: List[usize] = [0, 5, 8, 11, 14, 17]
    for start in starts:
        let width: usize = if start == 0: 4 else: 2
        if reach < start + width:
            return .Err(rfc3339_mismatch(codes, reach))
        value := rfc3339_value(codes, start, width)
        parts.push(value)
        let high: i64 = 59
        if start == 0:
            high = 9999
        else if start == 5:
            high = 12
        else if start == 8:
            high = days_in_month(parts[0], parts[1])
        else if start == 11:
            high = 23
        if value > high || (value == 0 && (start == 5 || start == 8)):
            return .Err(ParseTimeError.OutOfRange(start))
    let index: usize = 19
    let fraction: i64 = 0
    if index < codes.len() && codes[index] == 46:
        index = index + 1
        start := index
        while index < codes.len() && codes[index] >= 48 && codes[index] <= 57:
            if index - start < 3:
                fraction = fraction * 10 + i64(codes[index] - 48)
            index = index + 1
        if index == start:
            return .Err(rfc3339_mismatch(codes, index))
        let read = index - start
        while read < 3:
            fraction = fraction * 10
            read = read + 1
    if index >= codes.len():
        return .Err(ParseTimeError.TooShort(codes.len()))
    zone := codes[index]
    let offset: i64 = 0
    if zone == 90 || zone == 122:
        index = index + 1
    else if zone == 43 || zone == 45:
        zone_reach := rfc3339_reach(codes, index + 1, "dd:dd")
        if zone_reach < index + 3:
            return .Err(rfc3339_mismatch(codes, zone_reach))
        hours := rfc3339_value(codes, index + 1, 2)
        if hours > 23:
            return .Err(ParseTimeError.OutOfRange(index + 1))
        if zone_reach < index + 6:
            return .Err(rfc3339_mismatch(codes, zone_reach))
        minutes := rfc3339_value(codes, index + 4, 2)
        if minutes > 59:
            return .Err(ParseTimeError.OutOfRange(index + 4))
        offset = (hours * 60 + minutes) * 60000
        if zone == 45:
            offset = -offset
        index = index + 6
    else:
        return .Err(ParseTimeError.InvalidCharacter(index))
    if index < codes.len():
        return .Err(ParseTimeError.InvalidCharacter(index))
    local := days_from_civil(parts[0], parts[1], parts[2]) * 86400000 + parts[3] * 3600000 + parts[4] * 60000 + parts[5] * 1000 + fraction
    .Ok(Timestamp { millis: local - offset })

# Whole milliseconds since an origin that the provider chooses
# (r-std-time.instant.decl).
## A reading of the monotonic clock, for measuring intervals.
## See [std-time.instant.decl](../../spec/std/time.md#r-std-time.instant.decl).
pub data Instant:
    millis: i64

impl Instant:
    ## Returns the instant that holds `millis` milliseconds since the provider's origin.
    ## See [std-time.instant.api-milliseconds](../../spec/std/time.md#r-std-time.instant.api-milliseconds).
    pub fn from_milliseconds(millis: i64) -> Instant:
        Instant { millis: millis }

    # The inverse of `from_milliseconds` (r-std-time.instant.as-milliseconds).
    pub fn as_milliseconds(self) -> i64:
        self.millis

    ## The time from `earlier` to the instant.
    ## See [std-time.instant.api-milliseconds](../../spec/std/time.md#r-std-time.instant.api-milliseconds).
    pub fn since(self, earlier: Instant) -> Duration:
        Duration::milliseconds(self.millis - earlier.millis)

# An `Instant` debugs as its milliseconds, as `Instant(5ms)`
# (r-std-format.debug.std-types.time).
impl Debug for Instant:
    fn debug(self, out: mut DebugWriter) -> void:
        out.write("Instant(${self.millis}ms)")

impl Eq for Instant:
    fn eq(self, other: Instant) -> bool:
        self.millis == other.millis

impl PartialOrd for Instant:
    fn partial_cmp(self, other: Instant) -> Ordering?:
        .Some(self.millis.cmp(other.millis))

impl Ord for Instant:
    fn cmp(self, other: Instant) -> Ordering:
        self.millis.cmp(other.millis)

# The helpers `now` and `sleep!` (r-std-time.helper.now) are not written
# yet: the prototype's std loader renames every top-level name textually
# (src/checker/standard-library.ts), so a helper cannot share the name of
# the `Clock` method it calls.

# The deterministic `Clock` (spec/std/time.md#manual-clock): its current
# time is its whole state. Virtual time advances only by `sleep!`, which
# returns at once (r-std-time.manual.sleep).
## The deterministic `Clock` provider: virtual time that a test advances.
## See [std-time.manual.decl](../../spec/std/time.md#r-std-time.manual.decl).
pub data ManualClock:
    current: Timestamp

impl ManualClock:
    ## Returns a `ManualClock` whose current time starts at `start`.
    ## See [std-time.manual.decl](../../spec/std/time.md#r-std-time.manual.decl).
    pub fn new(start: Timestamp) -> mut ManualClock:
        ManualClock { current: start }

impl Debug for ManualClock:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ManualClock").field("current", self.current).finish()

impl Clock for ManualClock:
    fn now(self) -> Timestamp:
        self.current

    # The monotonic origin is the Unix epoch (r-std-time.manual.monotonic).
    fn monotonic(self) -> Instant:
        Instant::from_milliseconds(self.current.millis)

    # A negative duration panics, and a zero one leaves the time as it is
    # (r-std-time.clock.sleep.negative, r-std-time.manual.sleep.zero).
    fn sleep!(mut self, duration: Duration) -> void:
        step := duration.as_milliseconds()
        if step < 0:
            panic("sleep! with a negative duration: ${duration}")
        self.current = Timestamp::from_unix_milliseconds(self.current.millis + step)

# `Duration` and `Instant` serialize to every format, and so to the host
# boundary, as their whole milliseconds; a `Timestamp` serializes as its
# RFC 3339 text (r-std-time.serde.impls, r-std-time.serde.int-form,
# r-std-time.serde.text-form).
impl Serialize for Duration:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        out.int(self.millis)

impl Deserialize for Duration:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Duration, R::Error]:
        match input.peek()?:
            .Text =>
                text := input.text("Duration")?
                match Duration::parse(text):
                    .Ok(duration) => .Ok(duration)
                    .Err(_) => .Err(input.invalid("Duration"))
            _ => .Ok(Duration { millis: input.int("Duration")? })

impl Serialize for Timestamp:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        out.text(self.to_rfc3339())

impl Deserialize for Timestamp:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Timestamp, R::Error]:
        text := input.text("Timestamp")?
        match Timestamp::parse(text):
            .Ok(stamp) => .Ok(stamp)
            .Err(_) => .Err(input.invalid("Timestamp"))

impl Serialize for Instant:
    fn serialize[W < Serializer](self, out: mut W) -> Result[void, W::Error]:
        out.int(self.millis)

impl Deserialize for Instant:
    fn deserialize[R < Deserializer](input: mut R) -> Result[Instant, R::Error]:
        .Ok(Instant { millis: input.int("Instant")? })

# A unit's scale: its milliseconds per unit, and how many units make one
# millisecond (1 for a unit of a millisecond or more).
fn duration_unit_scale(unit: string) -> (i64, i64)?:
    match unit:
        "h" => .Some((3600000, 1))
        "m" => .Some((60000, 1))
        "min" => .Some((60000, 1))
        "s" => .Some((1000, 1))
        "ms" => .Some((1, 1))
        "us" => .Some((1, 1000))
        "\u{b5}s" => .Some((1, 1000))
        "\u{3bc}s" => .Some((1, 1000))
        "ns" => .Some((1, 1000000))
        _ => .None

fn power_of_ten(places: usize) -> i64:
    let value: i64 = 1
    let count: usize = 0
    while count < places:
        value = value * 10
        count = count + 1
    value

fn is_digit_code(code: i32) -> bool:
    code >= 48 && code <= 57

# Go's `time.ParseDuration` at millisecond resolution
# (r-std-time.duration.parse). The total is summed as a non-positive
# number, whose range holds the most negative duration, so the text of
# every duration parses back (r-std-time.duration.parse.round-trip).
fn parse_duration_text(text: string) -> Result[Duration, ParseTimeError]:
    codes := byte_codes(text)
    size := codes.len()
    let index: usize = 0
    let negative = false
    if index < size && (codes[index] == 43 || codes[index] == 45):
        negative = codes[index] == 45
        index = index + 1
    if index >= size:
        return .Err(ParseTimeError.TooShort(size))
    if index + 1 == size && codes[index] == 48:
        return .Ok(Duration { millis: 0 })
    let limit: i64 = -9223372036854775807
    if negative:
        limit = limit - 1
    let total: i64 = 0
    while index < size:
        start := index
        let whole: i64 = 0
        let overflow = false
        while index < size && is_digit_code(codes[index]):
            digit := i64(codes[index] - 48)
            if whole < -922337203685477580 || (whole == -922337203685477580 && digit > 8):
                overflow = true
            else:
                whole = whole * 10 - digit
            index = index + 1
        if index == start:
            return .Err(ParseTimeError.InvalidCharacter(index))
        let fraction: i64 = 0
        let places: usize = 0
        let inexact = false
        if index < size && codes[index] == 46:
            index = index + 1
            first := index
            while index < size && is_digit_code(codes[index]):
                index = index + 1
            if index == first:
                if index >= size:
                    return .Err(ParseTimeError.TooShort(size))
                return .Err(ParseTimeError.InvalidCharacter(index))
            let last = index
            while last > first && codes[last - 1] == 48:
                last = last - 1
            if last - first > 11:
                inexact = true
            else:
                fraction = rfc3339_value(codes, first, last - first)
                places = last - first
        unit_start := index
        while index < size && !is_digit_code(codes[index]) && codes[index] != 46:
            index = index + 1
        if index == unit_start:
            return .Err(ParseTimeError.MissingUnit(index))
        scale := match duration_unit_scale(text.slice(unit_start, index)):
            .Some(found) => found
            .None => return .Err(ParseTimeError.UnknownUnit(unit_start))
        if overflow:
            return .Err(ParseTimeError.OutOfRange(start))
        multiplier := scale._0
        divisor := scale._1
        let component: i64 = 0
        if divisor > 1:
            if inexact || fraction != 0 || whole % divisor != 0:
                return .Err(ParseTimeError.Inexact(start))
            component = whole / divisor
        else:
            if inexact:
                return .Err(ParseTimeError.Inexact(start))
            scaled := fraction * multiplier
            scale_down := power_of_ten(places)
            if scaled % scale_down != 0:
                return .Err(ParseTimeError.Inexact(start))
            if whole < limit / multiplier:
                return .Err(ParseTimeError.OutOfRange(start))
            part := scaled / scale_down
            if whole * multiplier < limit + part:
                return .Err(ParseTimeError.OutOfRange(start))
            component = whole * multiplier - part
        if component < limit - total:
            return .Err(ParseTimeError.OutOfRange(start))
        total = total + component
    if negative:
        return .Ok(Duration { millis: total })
    .Ok(Duration { millis: -total })
