# std.time: `Duration` and its literal suffixes (spec/std/time.md,
# future-work/archive/STDLIB.md#stdtime). A `Duration` is a whole number of
# milliseconds in an `i64` (r-std-time.suffix.std.duration), and its public API is
# `milliseconds`, `seconds`, and `as_milliseconds` (r-std-time.suffix.std.duration-api);
# the `millis` field is the prototype's own. Each suffix scales its literal by
# checked `i64` multiplication, so an overflow panics (r-std-time.suffix.std.overflow).
# Each suffix is a function marked `@num_suffix` (r-std-time.suffix.std.fn).
# `-5s` is the ordinary negation `-(5s)`, so `Duration` implements `Neg`
# (r-std-time.suffix.std.duration-neg).
use std.ops.{Neg, num_suffix}

pub data Duration:
    millis: i64

impl Duration:
    pub fn milliseconds(count: i64) -> Duration:
        Duration { millis: count }

    pub fn seconds(count: i64) -> Duration:
        Duration { millis: count * 1000 }

    pub fn as_milliseconds(self) -> i64:
        self.millis

impl Neg for Duration:
    type Out = Duration
    fn neg(self) -> Duration:
        Duration { millis: -self.millis }

@num_suffix
pub fn ms(count: i64) -> Duration:
    Duration::milliseconds(count)

@num_suffix
pub fn s(count: i64) -> Duration:
    Duration::seconds(count)

@num_suffix
pub fn min(count: i64) -> Duration:
    Duration::seconds(count * 60)

@num_suffix
pub fn h(count: i64) -> Duration:
    Duration::seconds(count * 3600)
