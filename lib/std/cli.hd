# std.cli: a mutable declaration builder and private parsed results.
use std.cmp.max
use std.format.DebugWriter
use std.error.Error
use std.host.Args
use std.text.{Parse, StringBuilder}
use std.process.ExitCode
use std.console.eprintln

@derive(Eq)
pub enum ArgKind:
    Flag
    Option
    Positional

## One declaration. Options take a value, flags do not, and positionals follow declaration order.
@derive(Debug)
pub struct Arg:
    pub name: string
    pub kind: ArgKind = .Option
    pub short: char? = .None
    pub help: string = ""
    pub required: bool = false

## A command line's declarations, changed in place through its mutable reference.
pub struct ArgParser:
    program: string
    about: string
    declarations: List[Arg]
    options: Map[string, usize]
    names: Map[string, bool]
    positional_slots: List[usize]

impl ArgParser:
    pub fn new(program: string, about: string = "") -> &mut ArgParser:
        &mut ArgParser { program: program, about: about, declarations: [], options: {}, names: {}, positional_slots: [] }

    pub fn arg(&mut self, arg: Arg) -> &mut ArgParser:
        if self.names.get(arg.name).is_some():
            panic("std.cli: argument ${arg.name} declared twice")
        index := self.declarations.len()
        if arg.kind == .Positional:
            if arg.short.is_some():
                panic("std.cli: a positional has no short option")
            self.positional_slots.push(index)
        else:
            long := "--${arg.name}"
            match arg.short:
                .Some(short) =>
                    written := "-${short}"
                    if self.options.get(written).is_some():
                        panic("std.cli: short option ${written} declared twice")
                    self.options[written] = index
                .None => pass
            self.options[long] = index
        self.names[arg.name] = true
        self.declarations.push(arg)
        self

    pub fn parse(&self, arguments: List[string]) -> Result[Parsed, CliError]:
        let mut flags: Map[string, bool] = {}
        let mut values: Map[string, string] = {}
        let mut positionals: List[string] = []
        let only_positionals = false
        let index: usize = 0
        while index < arguments.len():
            argument := arguments[index]
            index = index + 1
            if only_positionals || argument == "-" || !argument.starts_with("-"):
                if positionals.len() < self.positional_slots.len():
                    slot := self.positional_slots[positionals.len()]
                    values[self.declarations[slot].name] = argument
                positionals.push(argument)
                continue
            if argument == "--":
                only_positionals = true
                continue
            let written = argument
            let attached: string? = .None
            if argument.starts_with("--"):
                match argument.split_once("="):
                    .Some((before, after)) =>
                        written = before
                        attached = .Some(after)
                    .None => pass
            slot := match self.options.get(written):
                .None => return .Err(CliError.UnknownOption(written))
                .Some(found) => found
            option := self.declarations[slot]
            if option.kind == .Flag:
                if attached.is_some():
                    return .Err(CliError.UnexpectedValue(option.name))
                flags[option.name] = true
            else:
                match attached:
                    .Some(value) => values[option.name] = value
                    .None =>
                        if index >= arguments.len():
                            return .Err(CliError.MissingValue(option.name))
                        values[option.name] = arguments[index]
                        index = index + 1
        # Preserve the declared help flag's old behavior until #501 supplies automatic help.
        if !flags.get("help").unwrap_or(false):
            for arg in self.declarations:
                if arg.required:
                    present := if arg.kind == .Flag: flags.get(arg.name).unwrap_or(false) else: values.get(arg.name).is_some()
                    if !present:
                        return .Err(CliError.MissingArgument(argument_name(arg)))
        .Ok(Parsed { present_flags: flags, option_values: values, position_values: positionals })

    pub fn parse_args(&self) -> Result[Parsed, CliError] $ Args:
        self.parse($.use(Args).list())

    pub fn usage(&self) -> string:
        text := StringBuilder::new().push("usage: ").push(self.program)
        if self.options.len() > 0:
            text.push(" [options]")
        for slot in self.positional_slots:
            arg := self.declarations[slot]
            text.push(" ")
            if !arg.required: text.push("[")
            text.push("<").push(arg.name).push(">")
            if !arg.required: text.push("]")
        if self.about != "":
            text.push("\n\n").push(self.about)
        let mut terms: List[string] = []
        let width: usize = 0
        for arg in self.declarations:
            term := argument_term(arg)
            terms.push(term)
            width = max(width, term.chars().count())
        if self.positional_slots.len() > 0:
            text.push("\n\narguments:")
            for slot in self.positional_slots:
                write_entry(text, terms[slot], self.declarations[slot].help, width)
        if self.options.len() > 0:
            text.push("\n\noptions:")
            for (slot, arg) in self.declarations.iter().enumerate():
                if arg.kind != .Positional:
                    write_entry(text, terms[slot], arg.help, width)
        text.build()

fn argument_name(arg: Arg) -> string:
    if arg.kind == .Positional: "<${arg.name}>" else: "--${arg.name}"

fn argument_term(arg: Arg) -> string:
    if arg.kind == .Positional:
        return arg.name
    suffix := if arg.kind == .Option: " <value>" else: ""
    match arg.short:
        .Some(short) => "-${short}, --${arg.name}${suffix}"
        .None => "    --${arg.name}${suffix}"

fn write_entry(text: &mut StringBuilder, term: string, help: string, width: usize) -> void:
    text.push("\n  ").push(term)
    if help != "":
        text.push("".pad_end(width - term.chars().count(), ' ')).push("  ").push(help)

@derive(Eq)
pub struct Parsed:
    present_flags: Map[string, bool]
    option_values: Map[string, string]
    position_values: List[string]

impl Parsed:
    ## A copy of every positional in input order, including extra positionals.
    pub fn positionals(self) -> List[string]: self.position_values

    ## True when the flag `name` was present.
    ## See [std-cli.parsed.flag-presence](../../spec/std/cli.md#r-std-cli.parsed.flag-presence).
    pub fn flag(self, name: string) -> bool:
        self.present_flags.get(name).unwrap_or(false)

    ## The value of the option `name`, in `.Some`, or `.None` when it was absent.
    ## See [std-cli.parsed.named-value](../../spec/std/cli.md#r-std-cli.parsed.named-value).
    pub fn value(self, name: string) -> string?:
        self.option_values.get(name)

    # `value` read as a `T` (r-std-cli.parsed.value-as).
    ## The value of the option `name` read as a `T`: `.None` when absent, an error naming the option when unreadable.
    ## See [std-cli.parsed.value-as](../../spec/std/cli.md#r-std-cli.parsed.value-as).
    pub fn value_as[T < Parse[Error = E], E < Display](self, name: string) -> Result[T?, CliError]:
        text := match self.option_values.get(name):
            .Some(found) => found
            .None => return .Ok(.None)
        match T::parse(text):
            .Ok(value) => .Ok(.Some(value))
            .Err(error) => .Err(CliError.InvalidValue(name, error.to_string()))

# Why `parse` failed (r-std-cli.error.required-argument).
## Why parsing failed: an unknown option, a missing value or positional, an unexpected value, or a value that does not read as its type.
## There is no help-request variant: a program that declares a `help` flag reads it from `Parsed` (std-cli.error.help-required).
## See [std-cli.error.required-argument](../../spec/std/cli.md#r-std-cli.error.required-argument).
@error
@derive(Debug, Eq)
pub enum CliError:
    @error("unknown option ${text}")
    UnknownOption(text: string)
    @error("option --${name} needs a value")
    MissingValue(name: string)
    @error("flag --${name} takes no value")
    UnexpectedValue(name: string)
    @error("missing argument ${name}")
    MissingArgument(name: string)
    @error("invalid value for --${name}: ${reason}")
    InvalidValue(name: string, reason: string)

# The exit status of a command-line failure belongs to `CliError`, not to
# `Error` (r-std-cli.error.exit-code); `main` calls `exit` itself.
impl CliError:
    ## The status a command line exits with for this error: 2, a usage error.
    ## See [std-cli.error.exit-code](../../spec/std/cli.md#r-std-cli.error.exit-code).
    pub fn exit_code(self) -> ExitCode:
        ExitCode(2)

    ## Writes this error's text as a line of error output, then returns `exit_code()`.
    ## See [std-cli.error.exit](../../spec/std/cli.md#r-std-cli.error.exit).
    pub fn exit(self) -> ExitCode $ Console:
        eprintln(self)
        self.exit_code()

# Keep handwritten Debug: show declarations as arguments and omit lookup indexes.
impl Debug for ArgParser:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("ArgParser").field("program", self.program).field("about", self.about).field("arguments", self.declarations).finish()

# Keep handwritten Debug: keep public-facing field labels instead of private storage names.
impl Debug for Parsed:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("Parsed").field("flags", self.present_flags).field("values", self.option_values).field("positionals", self.position_values).finish()

# Keep handwritten Debug: empty tuple builders apply dbg depth limits to these variants.
impl Debug for ArgKind:
    fn debug(self, out: &mut DebugWriter) -> void:
        match self:
            .Flag => out.debug_tuple("ArgKind.Flag").finish()
            .Option => out.debug_tuple("ArgKind.Option").finish()
            .Positional => out.debug_tuple("ArgKind.Positional").finish()
