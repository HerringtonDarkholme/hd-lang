# std.cli: a mutable declaration builder and private parsed results.
use std.cmp.max
use std.format.DebugWriter
use std.error.Error
use std.host.Args
use std.text.{Parse, StringBuilder}
use std.process.ExitCode
use std.console.eprintln
use std.structure.{Structure, Describer, Source, Variant, Field, Members, Key}
use std.path.Path
use std.time.Duration
use std.annotation.annotate

@derive(Eq)
pub enum ArgKind:
    Flag
    Option
    Positional

## One declaration. Options take a value, flags do not, and positionals follow declaration order.
@derive(Debug)
pub struct Arg:
    pub name: string
    pub kind: ArgKind = .Option
    pub short: char? = .None
    pub help: string = ""
    pub required: bool = false
    pub choices: List[string] = []
    pub repeated: bool = false

## A command line's declarations, changed in place through its mutable reference.
pub struct ArgParser:
    program: string
    about: string
    declarations: List[Arg]
    options: Map[string, usize]
    names: Map[string, bool]
    positional_slots: List[usize]
    commands: Map[string, ArgParser]
    declaration_error: CliError? = .None
    command_required: bool = true
    command_field: string? = .None

impl ArgParser:
    pub fn new(program: string, about: string = "") -> &mut ArgParser:
        parser := &mut ArgParser { program: program, about: about, declarations: [], options: {}, names: {}, positional_slots: [], commands: {} }
        parser.arg(Arg { name: "help", kind: .Flag, short: 'h', help: "Print this help." })

    pub fn arg(&mut self, arg: Arg) -> &mut ArgParser:
        if self.names.get(arg.name).is_some():
            panic("std.cli: argument ${arg.name} declared twice")
        index := self.declarations.len()
        if arg.kind == .Positional:
            if self.commands.len() > 0: panic("std.cli: a parser with commands takes no positionals")
            if arg.short.is_some():
                panic("std.cli: a positional has no short option")
            if !self.positional_slots.is_empty():
                previous := self.declarations[self.positional_slots[self.positional_slots.len() - 1]]
                if previous.repeated:
                    panic("std.cli: positional ${arg.name} cannot follow repeated positional ${previous.name}")
            self.positional_slots.push(index)
        else:
            long := "--${arg.name}"
            match arg.short:
                .Some(short) =>
                    written := "-${short}"
                    if self.options.get(written).is_some():
                        panic("std.cli: short option ${written} declared twice")
                    self.options[written] = index
                .None => pass
            self.options[long] = index
        self.names[arg.name] = true
        self.declarations.push(arg)
        self

    ## Adds a command's parser by value; its options belong only to that command.
    pub fn command(&mut self, name: string, parser: ArgParser) -> &mut ArgParser:
        if self.positional_slots.len() > 0: panic("std.cli: a parser with positionals takes no commands")
        if self.commands.get(name).is_some(): panic("std.cli: command $name declared twice")
        self.commands[name] = parser
        self

    # Typed parsers take Args.program at the root and retain that scope in
    # every command's help, including commands nested in payload records.
    fn set_program(&mut self, program: string) -> void:
        self.program = program
        for (name, child) in self.commands:
            let mut scoped = child
            scoped.set_program("$program $name")
            self.commands[name] = scoped

    pub fn parse(&self, arguments: List[string]) -> Result[Parsed, CliError]:
        self.parse_from(arguments, 0)

    # Pass the input and its offset without copying the tail at every level.
    fn parse_from(&self, arguments: List[string], start: usize) -> Result[Parsed, CliError]:
        match self.declaration_error:
            .Some(error) => return .Err(error)
            .None => pass
        let mut flags: Map[string, bool] = {}
        let mut flag_counts: Map[string, usize] = {}
        let mut values: Map[string, string] = {}
        let mut histories: Map[string, &mut List[string]] = {}
        let mut positionals: List[string] = []
        let only_positionals = false
        let mut selected: List[(string, Parsed)] = []
        let index = start
        while index < arguments.len():
            argument := arguments[index]
            index = index + 1
            if !only_positionals && (argument == "-h" || argument == "--help"):
                return .Err(CliError.Help(self.usage()))
            if only_positionals || argument == "-" || !argument.starts_with("-"):
                if self.commands.len() > 0:
                    parser := match self.commands.get(argument):
                        .Some(parser) => parser
                        .None => return .Err(CliError.UnknownCommand(argument))
                    selected.push((argument, parser.parse_from(arguments, index)?))
                    break
                if positionals.len() < self.positional_slots.len():
                    slot := self.positional_slots[positionals.len()]
                    store_value(self.declarations[slot], argument, &mut values, &mut histories)?
                else if !self.positional_slots.is_empty():
                    slot := self.positional_slots[self.positional_slots.len() - 1]
                    if self.declarations[slot].repeated:
                        store_value(self.declarations[slot], argument, &mut values, &mut histories)?
                positionals.push(argument)
                continue
            if argument == "--":
                only_positionals = true
                continue
            let written = argument
            let attached: string? = .None
            if argument.starts_with("--"):
                match argument.split_once("="):
                    .Some((before, after)) =>
                        written = before
                        attached = .Some(after)
                    .None => pass
            slot := match self.options.get(written):
                .None => return .Err(CliError.UnknownOption(written))
                .Some(found) => found
            option := self.declarations[slot]
            if option.kind == .Flag:
                if attached.is_some():
                    return .Err(CliError.UnexpectedValue(option.name))
                flags[option.name] = true
                if option.repeated:
                    flag_counts[option.name] = flag_counts.get(option.name).unwrap_or(0) + 1
            else:
                match attached:
                    .Some(value) => store_value(option, value, &mut values, &mut histories)?
                    .None =>
                        if index >= arguments.len():
                            return .Err(CliError.MissingValue(option.name))
                        store_value(option, arguments[index], &mut values, &mut histories)?
                        index = index + 1
        if self.commands.len() > 0 && self.command_required && selected.is_empty(): return .Err(CliError.MissingCommand)
        for arg in self.declarations:
            if arg.required:
                present := if arg.kind == .Flag: flags.get(arg.name).unwrap_or(false) else: values.get(arg.name).is_some()
                if !present:
                    return .Err(CliError.MissingArgument(argument_name(arg)))
        .Ok(Parsed { present_flags: flags, option_values: values, value_histories: histories, position_values: positionals, selected_command: selected, flag_counts: flag_counts, command_field: self.command_field })

    pub fn parse_args(&self) -> Result[Parsed, CliError] $ Args:
        self.parse($.use(Args).list())

    pub fn usage(&self) -> string:
        text := StringBuilder::new().push("usage: ").push(self.program)
        if self.options.len() > 0:
            text.push(" [options]")
        if self.commands.len() > 0:
            text.push(if self.command_required: " <command>" else: " [<command>]")
        for slot in self.positional_slots:
            arg := self.declarations[slot]
            text.push(" ")
            if !arg.required: text.push("[")
            text.push("<").push(arg.name).push(">")
            if !arg.required: text.push("]")
        if self.about != "":
            text.push("\n\n").push(self.about)
        if self.commands.len() > 0:
            text.push("\n\ncommands:")
            let command_width: usize = 0
            for (name, _) in self.commands: command_width = max(command_width, name.chars().count())
            for (name, parser) in self.commands:
                text.push("\n  ").push(name)
                if parser.about != "":
                    text.push("".pad_end(command_width - name.chars().count(), ' ')).push("  ").push(parser.about)
        let mut terms: List[string] = []
        let width: usize = 0
        for arg in self.declarations:
            term := argument_term(arg)
            terms.push(term)
            width = max(width, term.chars().count())
        if self.positional_slots.len() > 0:
            text.push("\n\narguments:")
            for slot in self.positional_slots:
                write_entry(text, terms[slot], self.declarations[slot], width)
        if self.options.len() > 0:
            text.push("\n\noptions:")
            let mut declarations = self.declarations.iter().enumerate()
            for (slot, arg) in declarations:
                if arg.kind != .Positional && arg.name != "help":
                    write_entry(text, terms[slot], arg, width)
            help_slot := self.options.get("--help").expect("automatic help declaration")
            write_entry(text, terms[help_slot], self.declarations[help_slot], width)
        text.build()

fn argument_name(arg: Arg) -> string:
    if arg.kind == .Positional: "<${arg.name}>" else: "--${arg.name}"

fn argument_term(arg: Arg) -> string:
    if arg.kind == .Positional:
        return arg.name
    suffix := if arg.kind == .Option: " <value>" else: ""
    match arg.short:
        .Some(short) => "-${short}, --${arg.name}${suffix}"
        .None => "    --${arg.name}${suffix}"

fn write_entry(text: &mut StringBuilder, term: string, arg: Arg, width: usize) -> void:
    text.push("\n  ").push(term)
    if arg.help != "" || !arg.choices.is_empty():
        text.push("".pad_end(width - term.chars().count(), ' ')).push("  ").push(arg.help)
        if !arg.choices.is_empty():
            if arg.help != "": text.push(" ")
            text.push("[choices: ").push(arg.choices.join(", ")).push("]")

# Repeated values append through a private shared buffer while parsing;
# Parsed exposes copies, so no caller can mutate a parsed result through it.
fn store_value(arg: Arg, value: string, values: &mut Map[string, string], histories: &mut Map[string, &mut List[string]]) -> Result[void, CliError]:
    if !arg.repeated && values.get(arg.name).is_some():
        return .Err(CliError.InvalidValue(arg.name, "argument cannot be repeated"))
    if !arg.choices.is_empty() && !arg.choices.contains(value):
        return .Err(CliError.InvalidValue(arg.name, "expected ${arg.choices.join(" or ")}, got $value"))
    if arg.repeated:
        match histories.get(arg.name):
            .Some(buffer) => buffer.push(value)
            .None => histories[arg.name] = &mut [value]
    values[arg.name] = value
    .Ok(())

@derive(Eq)
pub struct Parsed:
    present_flags: Map[string, bool]
    option_values: Map[string, string]
    value_histories: Map[string, &mut List[string]]
    position_values: List[string]
    selected_command: List[(string, Parsed)]
    flag_counts: Map[string, usize] = {}
    one_name: string? = .None
    one_index: usize = 0
    command_field: string? = .None

impl Parsed:
    ## The selected command and a copy of its parsed arguments, when present.
    pub fn command(self) -> (string, Parsed)?: self.selected_command.get(0)

    ## A copy of every positional in input order, including extra positionals.
    pub fn positionals(self) -> List[string]: self.position_values

    ## True when the flag `name` was present.
    ## See [std-cli.parsed.flag-presence](../../spec/std/cli.md#r-std-cli.parsed.flag-presence).
    pub fn flag(self, name: string) -> bool:
        if self.one_name.is_some() && self.one_name != .Some(name):
            return false
        self.present_flags.get(name).unwrap_or(false)

    ## The value of the option `name`, in `.Some`, or `.None` when it was absent.
    ## See [std-cli.parsed.named-value](../../spec/std/cli.md#r-std-cli.parsed.named-value).
    pub fn value(self, name: string) -> string?:
        match self.one_name:
            .Some(selected) =>
                if name != selected:
                    return .None
                match self.value_histories.get(name):
                    .Some(values) => return values.get(self.one_index)
                    .None =>
                        if self.one_index > 0:
                            return .None
            .None => pass
        self.option_values.get(name)

    ## A copy of every value of the named option or positional, in argument order.
    pub fn values(self, name: string) -> List[string]:
        if self.one_name.is_some():
            return self.value(name).map(fn(value): [value]).unwrap_or([])
        match self.value_histories.get(name):
            .Some(buffer) => *buffer
            .None =>
                match self.option_values.get(name):
                    .Some(value) => [value]
                    .None => []

    # One field's presence and an O(1) view of one repeated value; the
    # source maps stay shared and every public list accessor returns a copy.
    fn has(self, name: string) -> bool:
        if self.one_name.is_some() && self.one_name != .Some(name):
            return false
        self.flag(name) || self.value(name).is_some() || (self.command_field == .Some(name) && !self.selected_command.is_empty())

    fn count(self, name: string) -> usize:
        if self.one_name.is_some():
            return if self.has(name): 1 else: 0
        match self.value_histories.get(name):
            .Some(values) => return values.len()
            .None => pass
        match self.flag_counts.get(name):
            .Some(count) => return count
            .None => pass
        if self.has(name): 1 else: 0

    fn nth(self, name: string, index: usize) -> Parsed:
        at := if self.one_name == .Some(name): self.one_index + index else: index
        Parsed { ...self, one_name: .Some(name), one_index: at }

    # `value` read as a `T` (r-std-cli.parsed.value-as).
    ## The value of the option `name` read as a `T`: `.None` when absent, an error naming the option when unreadable.
    ## See [std-cli.parsed.value-as](../../spec/std/cli.md#r-std-cli.parsed.value-as).
    pub fn value_as[T < Parse[Error = E], E < Display](self, name: string) -> Result[T?, CliError]:
        text := match self.value(name):
            .Some(found) => found
            .None => return .Ok(.None)
        match T::parse(text):
            .Ok(value) => .Ok(.Some(value))
            .Err(error) => .Err(CliError.InvalidValue(name, error.to_string()))

# Why `parse` failed (r-std-cli.error.required-argument).
## Why parsing failed: an unknown option, a missing value or positional, an unexpected value, or a value that does not read as its type.
## Help holds the command's usage text and stops parsing immediately.
## See [std-cli.error.required-argument](../../spec/std/cli.md#r-std-cli.error.required-argument).
@error
@derive(Debug, Eq)
pub enum CliError:
    @error("unknown option ${text}")
    UnknownOption(text: string)
    @error("option --${name} needs a value")
    MissingValue(name: string)
    @error("flag --${name} takes no value")
    UnexpectedValue(name: string)
    @error("missing argument ${name}")
    MissingArgument(name: string)
    @error("invalid value for --${name}: ${reason}")
    InvalidValue(name: string, reason: string)
    @error("unknown command $text")
    UnknownCommand(text: string)
    @error("missing command")
    MissingCommand
    @error("$usage")
    Help(usage: string)

# The exit status of a command-line failure belongs to `CliError`, not to
# `Error` (r-std-cli.error.exit-code-help); `main` calls `exit` itself.
impl CliError:
    ## Help exits successfully; a usage error exits with status 2.
    ## See [std-cli.error.exit-code-help](../../spec/std/cli.md#r-std-cli.error.exit-code-help).
    pub fn exit_code(self) -> ExitCode:
        match self:
            .Help(_) => ExitCode(0)
            _ => ExitCode(2)

    ## Writes help to stdout or a usage error to stderr, then returns its status.
    ## See [std-cli.error.exit-help](../../spec/std/cli.md#r-std-cli.error.exit-help).
    pub fn exit(self) -> ExitCode $ Console:
        match self:
            .Help(usage) => println(usage)
            _ => eprintln(self)
        self.exit_code()

# Keep handwritten Debug: show declarations as arguments and omit lookup indexes.
impl Debug for ArgParser:
    fn debug(self, out: &mut DebugWriter) -> void:
        fields := out.debug_struct("ArgParser").field("program", self.program).field("about", self.about).field("arguments", self.declarations)
        if self.commands.len() > 0: fields.field("commands", self.commands)
        fields.finish()

# Keep handwritten Debug: keep public-facing field labels instead of private storage names.
impl Debug for Parsed:
    fn debug(self, out: &mut DebugWriter) -> void:
        fields := out.debug_struct("Parsed").field("flags", self.present_flags).field("values", self.option_values).field("positionals", self.position_values)
        if !self.selected_command.is_empty(): fields.field("command", self.command())
        fields.finish()

# Keep handwritten Debug: empty tuple builders apply dbg depth limits to these variants.
impl Debug for ArgKind:
    fn debug(self, out: &mut DebugWriter) -> void:
        match self:
            .Flag => out.debug_tuple("ArgKind.Flag").finish()
            .Option => out.debug_tuple("ArgKind.Option").finish()
            .Positional => out.debug_tuple("ArgKind.Positional").finish()

## A type read from command-line declarations and parsed values.
## See [std-cli.typed.trait](../../spec/std/cli.md#r-std-cli.typed.trait).
pub trait Cli:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void
    fn read(parsed: Parsed, arg: Arg) -> Result[Self, CliError]

    fn parser() -> &mut ArgParser:
        parser := ArgParser::new("")
        Self::declare(parser, Arg { name: "", required: true })
        parser

    fn parse(arguments: List[string]) -> Result[Self, CliError]:
        parser := Self::parser()
        Self::read(parser.parse(arguments)?, Arg { name: "", required: true })

    fn parse_args() -> Result[Self, CliError] $ Args:
        parser := Self::parser()
        host := $.use(Args)
        parser.set_program(host.program())
        Self::read(parser.parse(host.list())?, Arg { name: "", required: true })

## A field's short option spelling; its long name stays unchanged.
## See [std-cli.short.fact](../../spec/std/cli.md#r-std-cli.short.fact).
@annotate::[F](.Field)
pub struct Short[F < Cli]:
    pub letter: char

## Declares a short option for a CLI-readable field.
## See [std-cli.short.constructor](../../spec/std/cli.md#r-std-cli.short.constructor).
pub fn short[F < Cli](letter: char) -> Short[F]:
    Short::[F] { letter: letter }

## Marks a CLI-readable field as positional.
## See [std-cli.positional.fact](../../spec/std/cli.md#r-std-cli.positional.fact).
@annotate::[F](.Field)
pub struct Positional[F < Cli]: pass

## Declares a positional field, in declaration order.
## See [std-cli.positional.constructor](../../spec/std/cli.md#r-std-cli.positional.constructor).
pub fn positional[F < Cli]() -> Positional[F]:
    Positional::[F] {}

impl[T] Cli for T by Structure:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void:
        if arg.name.is_empty():
            parser.program = cli_name(T::name())
        let mut describer = CliDescriber::[T] { parser: parser, arg: arg, record: false, choices: [], choice_help: [], payload: false, commands: [], current: .None, variant_name: "", members: 0, valid_shape: true }
        _ := T::describe(&mut describer)
        if !describer.record:
            if describer.payload:
                describer.finish_variant()
                binding := scalar_arg(arg).name
                if arg.short.is_some():
                    parser.declaration_error = .Some(.InvalidValue(binding, "subcommand field `$binding` cannot have a short option"))
                    return
                if arg.kind == .Positional:
                    parser.declaration_error = .Some(.InvalidValue(binding, "subcommand field `$binding` cannot be a positional value"))
                    return
                if arg.repeated:
                    parser.declaration_error = .Some(.InvalidValue(binding, "a subcommand field cannot be repeated"))
                    return
                match parser.command_field:
                    .Some(previous) =>
                        if previous != binding:
                            parser.declaration_error = .Some(.InvalidValue(binding, "command fields `$previous` and `$binding` cannot share a parser"))
                            return
                    .None => pass
                parser.command_field = .Some(binding)
                parser.command_required = arg.required
                for (name, child) in describer.commands:
                    child.set_program("${parser.program} $name")
                    _ := parser.command(name, *child)
            else:
                let help = arg.help
                if !describer.choice_help.is_empty():
                    if help != "": help += "\n"
                    help += describer.choice_help.join("\n")
                declare_scalar(parser, Arg { ...arg, help: help, choices: describer.choices }, cli_name(T::name()))

    fn read(parsed: Parsed, arg: Arg) -> Result[T, CliError]:
        let mut source = CliSource::[T] { parsed: parsed, arg: arg, at: 0, command_payload: false }
        T::build(&mut source)

struct CliDescriber[S]:
    pub parser: &mut ArgParser
    pub arg: Arg
    pub record: bool
    pub choices: List[string]
    pub choice_help: List[string]
    pub payload: bool
    pub commands: List[(string, &mut ArgParser)]
    pub current: Option[&mut ArgParser]
    pub variant_name: string
    pub members: usize
    pub valid_shape: bool

impl[S] CliDescriber[S]:
    fn finish_variant(&mut self) -> void:
        if !self.valid_shape && self.parser.declaration_error.is_none():
            name := cli_name(self.variant_name)
            self.parser.declaration_error = .Some(.InvalidValue(name, "subcommand variant `${self.variant_name}` must be unit or have exactly one unnamed Cli payload"))

impl[S] Describer[S] for CliDescriber[S]:
    type Error = never

    fn variant(&mut self, variant: Variant[S]) -> Result[void, never]:
        self.finish_variant()
        self.record = variant.info.of_data
        if self.arg.name.is_empty() && (self.record || self.choices.is_empty()):
            match variant.info.type_doc:
                .Some(doc) =>
                    if self.parser.about == "": self.parser.about = doc
                    else if self.parser.about != doc: self.parser.about += "\n\n$doc"
                .None => pass
        if self.record:
            if !self.arg.name.is_empty() && self.parser.declaration_error.is_none():
                self.parser.declaration_error = .Some(.InvalidValue(self.arg.name, "record field `${self.arg.name}` is not supported; subcommands are an enum"))
        else:
            name := cli_name(variant.info.name)
            self.choices.push(name)
            match variant.info.doc:
                .Some(doc) => self.choice_help.push("    $name: $doc")
                .None => pass
            child := ArgParser::new(name)
            child.about = variant.info.doc.unwrap_or("")
            self.commands.push((name, child))
            self.current = .Some(child)
            self.variant_name = variant.info.name
            self.members = 0
            self.valid_shape = true
        .Ok(())

    fn member[F < Cli](&mut self, field: Field[S, F]) -> Result[void, never]:
        if self.record:
            if self.arg.name.is_empty():
                F::declare(self.parser, cli_arg(field))
        else:
            self.payload = true
            self.members += 1
            if self.members == 1 && field.info.positional:
                F::declare(self.current.expect("a command parser"), Arg { name: "", required: true })
            else:
                self.valid_shape = false
        .Ok(())

struct CliSource[S]:
    pub parsed: Parsed
    pub arg: Arg
    pub at: usize
    pub command_payload: bool

impl[S] Source[S] for CliSource[S]:
    type Error = CliError

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], CliError]:
        if choices.len() == 1 && choices[0].info.of_data:
            return .Ok(choices[0])
        arg := scalar_arg(self.arg)
        if self.parsed.command_field == .Some(arg.name):
            let (name, child) = match self.parsed.command():
                .Some(command) => command
                .None => return .Err(.MissingCommand)
            for choice in choices:
                if cli_name(choice.info.name) == name:
                    self.parsed = child
                    self.command_payload = true
                    return .Ok(choice)
            return .Err(.UnknownCommand(name))
        value := match self.parsed.value(arg.name):
            .Some(value) => value
            .None => return .Err(.MissingArgument(argument_name(arg)))
        let mut names: List[string] = []
        for choice in choices:
            name := cli_name(choice.info.name)
            if name == value:
                return .Ok(choice)
            names.push(name)
        .Err(.InvalidValue(arg.name, "expected ${names.join(" or ")}, got $value"))

    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, CliError]:
        if self.at >= members.infos.len():
            return .Ok(.None)
        info := members.infos[self.at]
        self.at += 1
        .Ok(members.at(info.position))

    fn member[F < Cli](&mut self, field: Field[S, F], previous: F?) -> Result[F, CliError]:
        if self.command_payload:
            return F::read(self.parsed, Arg { name: "", required: true })
        arg := cli_arg(field)
        if field.has_default() && !self.parsed.has(arg.name):
            return .Ok(field.default().expect("a declared default"))
        F::read(self.parsed, arg)

    fn missing[F](&mut self, field: Field[S, F]) -> Result[F, CliError]:
        panic("std.cli: the source names every member")

fn cli_arg[S, F < Cli](field: Field[S, F]) -> Arg:
    kind := if field.fact::[Positional[F]]().is_some(): ArgKind.Positional else: ArgKind.Option
    Arg { name: cli_name(field.info.name), help: field.info.doc.unwrap_or(""), required: !field.has_default(), kind: kind, short: field.fact::[Short[F]]().map(fn(fact): fact.letter) }

fn cli_name(name: string) -> string:
    out := StringBuilder::new()
    let first = true
    for character in name.chars():
        text := character.to_string()
        if character == '_':
            out.push("-")
        else if text.len() == 1 && text >= "A" && text <= "Z":
            if !first:
                out.push("-")
            out.push(text.lower())
        else:
            out.push(text)
        first = false
    out.build()

fn scalar_arg(arg: Arg) -> Arg:
    if arg.name.is_empty():
        return Arg { ...arg, name: "value", kind: .Positional }
    if arg.kind == .Positional:
        return arg
    Arg { ...arg, kind: .Option }

fn declare_scalar(parser: &mut ArgParser, arg: Arg, name: string) -> void:
    if arg.name.is_empty():
        parser.program = name
    _ := parser.arg(scalar_arg(arg))

fn read_scalar[T < Parse[Error = E], E < Display](parsed: Parsed, arg: Arg) -> Result[T, CliError]:
    declared := scalar_arg(arg)
    match parsed.value_as::[T](declared.name)?:
        .Some(value) => .Ok(value)
        .None => .Err(.MissingArgument(argument_name(declared)))

impl Cli for bool:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void:
        if arg.name.is_empty() || arg.kind == .Positional:
            declare_scalar(parser, arg, "bool")
        else:
            _ := parser.arg(Arg { ...arg, kind: .Flag, required: false })

    fn read(parsed: Parsed, arg: Arg) -> Result[bool, CliError]:
        if arg.name.is_empty() || arg.kind == .Positional:
            return read_scalar::[bool](parsed, arg)
        .Ok(parsed.flag(arg.name))

impl[T < Cli] Cli for T?:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void:
        T::declare(parser, Arg { ...arg, required: false })

    fn read(parsed: Parsed, arg: Arg) -> Result[T?, CliError]:
        name := scalar_arg(arg).name
        if !parsed.has(name):
            return .Ok(.None)
        .Ok(.Some(T::read(parsed, arg)?))

impl[T < Cli] Cli for List[T]:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void:
        T::declare(parser, Arg { ...arg, repeated: true, required: false })

    fn read(parsed: Parsed, arg: Arg) -> Result[List[T], CliError]:
        name := scalar_arg(arg).name
        let mut values: List[T] = []
        for index in 0..parsed.count(name):
            values.push(T::read(parsed.nth(name, index), arg)?)
        .Ok(values)

impl Cli for string:
    fn declare(parser: &mut ArgParser, arg: Arg) -> void:
        declare_scalar(parser, arg, "string")

    fn read(parsed: Parsed, arg: Arg) -> Result[string, CliError]:
        read_scalar::[string](parsed, arg)

impl Cli for char:
