# std.inspect, the part written in hd: runtime type identity
# (spec/lang/09-traits.md#runtime-type-identity). Importing any `std.inspect`
# name, or `std.error.Error`, declares these under their standard names
# (checker/standard-traits.ts); aliases are not supported. The compiler
# implements the sealed `Inspectable` for every type, and supplies the
# `downcast` methods and `downcast_val`, so the trait's dictionary holds
# `runtime_type` alone. `TypeId::of` is declared below; only its body is the
# compiler's.

use std.format.DebugWriter

## The sealed trait of types with a runtime identity, which the compiler supplies.
## See [module.prelude.inspect](../../spec/lang/10-modules.md#r-module.prelude.inspect).
pub trait Inspectable:
    fn runtime_type(self) -> TypeId

# `key` is the type's identity, which `Eq` compares; `name` is its canonical
# printable name (trait.typeid.name), which `Display` prints. Two types of
# different identity can print alike, as two packages that share a name do.
## The runtime identity of an inspectable type.
## See [module.prelude.inspect](../../spec/lang/10-modules.md#r-module.prelude.inspect).
pub data TypeId:
    key: string
    name: string

impl TypeId:
    ## The `TypeId` of `T`.
    @intrinsic("type_id_of")
    pub fn of[T < Inspectable]() -> TypeId: panic("intrinsic")

impl Eq for TypeId:
    fn eq(self, other: TypeId) -> bool: self.key == other.key

impl Display for TypeId:
    fn to_string(self) -> string: self.name

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): a `@derive` on a std
# declaration has no effect in the prototype.
impl Debug for TypeId:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("TypeId").field("key", self.key).field("name", self.name).finish()
