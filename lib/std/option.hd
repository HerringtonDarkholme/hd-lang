use std.error.{Error, message}
pub use std.iter.{OptionIter}
# std.option: inherent methods on `T?` (spec/std/option.md).
# `map` is the std method of spec/std/iter.md#list-and-optional-map.
use std.meta.inline
use std.ops.FnMut

impl[T < ?Copy] T?:
    ## `.Some` of `transform(value)` for a `.Some`, and `.None` for a `.None`.
    ## See [std-iter.option.map.fn-mut](../../spec/std/iter.md#r-std-iter.option.map.fn-mut).
    pub fn map[U, F < ?Copy & FnMut(T) -> U](self, mut transform: F) -> U?:
        match self:
            .Some(value) => .Some(transform(value))
            .None => .None

    ## For a `.Some`, `transform(value)`; for a `.None`, `.None`.
    ## See [std-option.and-then](../../spec/std/option.md#r-std-option.and-then).
    pub fn and_then[U](self, transform: fn(T) -> U?) -> U?:
        match self:
            .Some(value) => transform(value)
            .None => .None

    ## The value of a `.Some`, and `fallback` for a `.None`.
    ## See [std-option.unwrap-or](../../spec/std/option.md#r-std-option.unwrap-or).
    pub fn unwrap_or(self, fallback: T) -> T:
        match self:
            .Some(value) => value
            .None => fallback

    ## The optional itself for a `.Some`, and `other` for a `.None`.
    ## See [std-option.or](../../spec/std/option.md#r-std-option.or).
    pub fn or(self, other: T?) -> T?:
        match self:
            .Some(_) => self
            .None => other

    ## `.Ok` of the value for a `.Some`, and `.Err` of `error` for a `.None`.
    ## See [std-option.ok-or](../../spec/std/option.md#r-std-option.ok-or).
    pub fn ok_or[E](self, error: E) -> Result[T, E]:
        match self:
            .Some(value) => .Ok(value)
            .None => .Err(error)

    ## True for a `.Some`.
    ## See [std-option.is-some](../../spec/std/option.md#r-std-option.is-some).
    pub fn is_some(&self) -> bool:
        match self:
            .Some(_) => true
            .None => false

    ## True for a `.None`.
    ## See [std-option.is-none](../../spec/std/option.md#r-std-option.is-none).
    pub fn is_none(&self) -> bool:
        match self:
            .Some(_) => false
            .None => true

    ## `.Some` of a reference to the value of a `.Some`, and `.None` for a `.None`; the optional stays in place.
    ## See [std-option.as-ref](../../spec/std/option.md#r-std-option.as-ref).
    pub fn as_ref(&self) -> (&T)?:
        match self:
            .Some(value) => .Some(value)
            .None => .None

    ## `.Some` of a writable reference to the value of a `.Some`, and `.None` for a `.None`.
    ## See [std-option.as-mut](../../spec/std/option.md#r-std-option.as-mut).
    pub fn as_mut(&mut self) -> (&mut T)?:
        match self:
            .Some(value) => .Some(value)
            .None => .None

    ## The value of a `.Some`; for a `.None` it panics, showing `message`.
    ## See [std-option.expect](../../spec/std/option.md#r-std-option.expect).
    pub fn expect(self, message: string) -> T:
        match self:
            .Some(value) => value
            .None => panic(message)

# A copy of the referred-to payload (STDLIB_REFERENCES slice 2).
impl['a, T] (&'a T)?:
    ## `.Some` of a copy of the value a `.Some` refers to, and `.None` for a `.None`.
    ## See [std-option.copied](../../spec/std/option.md#r-std-option.copied).
    @inline(.Always)
    pub fn copied(self) -> T?:
        match self:
            .Some(value) => .Some(*value)
            .None => .None

# Established lazy fallbacks and filtering (#2283).
impl[T < ?Copy] T?:
    ## The payload of `.Some`; panics with `explicit-panic` for `.None`.
    ## See [std-option.unwrap.value](../../spec/std/option.md#r-std-option.unwrap.value).
    pub fn unwrap(self) -> T:
        match self:
            .Some(value) => value
            .None => panic("called `Option::unwrap()` on a `None` value")

    ## The payload, or one call of `fallback` for `.None`.
    ## See [std-option.unwrap-or-else.value](../../spec/std/option.md#r-std-option.unwrap-or-else.value).
    pub fn unwrap_or_else[F < ?Copy & FnMut() -> T $ R, $ R](self, mut fallback: F) -> T $ R:
        match self:
            .Some(value) => value
            .None => fallback()

    ## The optional itself, or one call of `fallback` for `.None`.
    ## See [std-option.or-else.value](../../spec/std/option.md#r-std-option.or-else.value).
    pub fn or_else[F < ?Copy & FnMut() -> T? $ R, $ R](self, mut fallback: F) -> T? $ R:
        match self:
            .Some(_) => self
            .None => fallback()

    ## Keeps a present payload only when `predicate` accepts its reference.
    ## See [std-option.filter.value](../../spec/std/option.md#r-std-option.filter.value).
    pub fn filter[F < ?Copy & FnMut(&T) -> bool $ R, $ R](self, mut predicate: F) -> T? $ R:
        match self:
            .Some(value) =>
                if predicate(&value): .Some(value) else: .None
            .None => .None

impl[T] T?:
    ## `.Ok` of the value for a `.Some`, and `.Err` of `message(text)` for a `.None`.
    ## See [std-option.context.reference-result](../../spec/std/option.md#r-std-option.context.reference-result).
    pub fn context(self, text: string) -> Result[T, *dyn Error]:
        match self:
            .Some(value) => .Ok(value)
            .None => .Err(message(text))
