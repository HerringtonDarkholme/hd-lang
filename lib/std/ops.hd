# std.ops: the literal-suffix marker (spec/05-expressions.md#literal-suffixes).
# A suffix function is one marked `@num_suffix`; the compiler recognizes
# `std.ops.NumSuffix` by its qualified name (r-expr.suffix.marker), and
# `@annotate(.Fn)` limits the marker to functions (r-expr.suffix.marker.module).
use std.annotation.annotate

@annotate(.Fn)
pub data NumSuffix: pass

pub fn num_suffix() -> NumSuffix:
    NumSuffix {}
