impl Index[RangeTo[u16]] for string:
    type Out = string
    fn index(self, key: RangeTo[u16]) -> string: slice_string(self, 0, u64(key.end), key.inclusive)

impl[T] Index[RangeTo[u16]] for List[T]:
    type Out = mut List[T]
    fn index(self, key: RangeTo[u16]) -> mut List[T]: slice_list(self, 0, u64(key.end), key.inclusive)

impl Index[Range[usize]] for string:
    type Out = string
    fn index(self, key: Range[usize]) -> string: slice_string(self, u64(key.start), u64(key.end), key.inclusive)

impl[T] Index[Range[usize]] for List[T]:
    type Out = mut List[T]
