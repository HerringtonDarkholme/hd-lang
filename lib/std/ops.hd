# std.ops: the literal-suffix and string-prefix markers
# (spec/05-expressions.md#literal-suffixes, #prefixed-strings).
# A suffix function is one marked `@num_suffix`, and a prefix function one
# marked `@str_prefix`; the compiler recognizes `std.ops.NumSuffix`,
# `std.ops.StrPrefix`, and `std.ops.Template` by their qualified names
# (r-expr.suffix.marker, r-expr.prefix.marker), and `@annotate(.Fn)` limits
# each marker to functions (r-expr.suffix.marker.module,
# r-expr.prefix.marker.module).
use std.annotation.annotate

@annotate(.Fn)
pub data NumSuffix: pass

pub fn num_suffix() -> NumSuffix:
    NumSuffix {}

@annotate(.Fn)
pub data StrPrefix: pass

pub fn str_prefix() -> StrPrefix:
    StrPrefix {}

# The argument of a prefix function: the `n + 1` raw text pieces around the
# `n` interpolated values (r-expr.prefix.template).
pub data Template[T]:
    pub raw_parts: List[string]
    pub values: List[T]

# The raw pieces joined with the values' `Display` text, in order
# (future-work/STDLIB.md#stdops; the specification names only `r`).
pub fn interpolate[T < Display](t: Template[T]) -> string:
    let joined = t.raw_parts[0]
    let index = 0
    while index < t.values.len():
        joined = joined + t.values[index].to_string() + t.raw_parts[index + 1]
        index = index + 1
    joined

# The standard raw-text prefix (r-expr.prefix.std.r): no escape is processed.
@str_prefix
pub fn r(t: Template[Display]) -> string:
    interpolate(t)

# The text with each escape sequence replaced by its meaning, or `.None`
# when it holds an invalid one (future-work/STDLIB.md#stdops,
# spec/01-lexical-structure.md#escape-sequences).
pub fn process_escapes(text: string) -> string?:
    scalars := text.split("")
    let processed = ""
    let index = 0
    while index < scalars.len():
        current := scalars[index]
        if current != "\\":
            processed = processed + current
            index = index + 1
            continue
        if index + 1 >= scalars.len():
            return .None
        escaped := scalars[index + 1]
        index = index + 2
        if escaped == "u":
            match unicode_escape(scalars, index):
                .Some(found) =>
                    processed = processed + found.text
                    index = found.end
                .None =>
                    return .None
            continue
        match simple_escape(escaped):
            .Some(meaning) =>
                processed = processed + meaning
            .None =>
                return .None
    .Some(processed)

# The meaning of a simple escape. The carriage return is written `\u{d}`
# because the std loader renames every bare word equal to a top-level name.
fn simple_escape(escaped: string) -> string?:
    match escaped:
        "\\" => .Some("\\")
        "\"" => .Some("\"")
        "'" => .Some("'")
        "n" => .Some("\n")
        "r" => .Some("\u{d}")
        "t" => .Some("\t")
        "0" => .Some("\0")
        "\$" => .Some("\$")
        _ => .None

data EscapedScalar:
    text: string
    end: i32

# `{` hex digits `}` after `\u`, starting at `start`: one to six digits
# naming a Unicode scalar value (spec/01-lexical-structure.md#r-lex.escape.unicode).
fn unicode_escape(scalars: List[string], start: i32) -> EscapedScalar?:
    if start >= scalars.len() || scalars[start] != "{":
        return .None
    let point = 0
    let digits = 0
    let index = start + 1
    while index < scalars.len() && scalars[index] != "}":
        match "0123456789abcdef".find(scalars[index].lower()):
            .Some(value) =>
                if digits == 6 || scalars[index].len() != 1:
                    return .None
                point = point * 16 + value
                digits = digits + 1
            .None =>
                return .None
        index = index + 1
    if index >= scalars.len() || digits == 0 || point > 1114111 || (point >= 55296 && point <= 57343):
        return .None
    .Some(EscapedScalar { text: scalar_text(point), end: index + 1 })

@intrinsic("string_from_scalar")
fn scalar_text(point: i32) -> string:
    panic("intrinsic")
