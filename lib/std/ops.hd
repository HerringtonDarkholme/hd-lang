# Range iteration (spec/lang/06-control-flow.md#range-iteration): one
# implementation over every integer type, with a concrete cursor, so a
# range's `iter` needs no trait value and a range of open literals has one
# cursor type. Each `iter()` starts from the start bound
# (r-flow.for.range.fresh). A `Range` stops before its end, or after it
# when `inclusive`, so `a..=b` never steps past `b`. An `a..` cursor steps
# only when asked for its next item, so asking past the largest value is
# the checked `integer-overflow` panic (r-flow.for.range.from-overflow).

## The cursor of a range's `iter`: the integers from its start up to its end.
## See [flow.for.range.cursor](../../spec/lang/06-control-flow.md#r-flow.for.range.cursor).
pub struct RangeIter[T]:
    at: T
    end: T
    inclusive: bool
    done: bool

## The cursor of an `a..` range's `iter`: the integers from its start on, with no end.
## See [flow.for.range.cursor](../../spec/lang/06-control-flow.md#r-flow.for.range.cursor).
pub struct RangeFromIter[T]:
    at: T
    started: bool

impl[T < Integer] Iterable[T] for Range[T]:
    type IntoIter = RangeIter[T]
    fn iter(self) -> RangeIter[T]:
        done := self.start > self.end || (self.start == self.end && !self.inclusive)
        RangeIter { at: self.start, end: self.end, inclusive: self.inclusive, done: done }

impl[T < Integer] Iterator[T] for RangeIter[T]:
    fn next(&mut self) -> T?:
        if self.done:
            return .None
        value := self.at
        if value == self.end:
            self.done = true
        else:
            self.at = value + T::one()
            if self.at == self.end && !self.inclusive:
                self.done = true
        .Some(value)

impl[T < Integer] Iterable[T] for RangeFrom[T]:
    type IntoIter = RangeFromIter[T]
    fn iter(self) -> RangeFromIter[T]:
        RangeFromIter { at: self.start, started: false }

impl[T < Integer] Iterator[T] for RangeFromIter[T]:
    fn next(&mut self) -> T?:
        if self.started:
            self.at = self.at + T::one()
        self.started = true
        .Some(self.at)

# The primitive implementations (spec/lang/05-expressions.md#primitive-implementations).
# Each method is intrinsic: the compiler supplies its body, one per
# operation, and specializes it for each type
# (spec/lang/09-traits.md#intrinsic-methods). An operator on primitive
# operands calls these methods, so no body is written with the operator it
# implements.
impl[N < Num] Add for N:
    type Out = N
    @intrinsic
    fn add(self, rhs: N) -> N

impl[N < Num] Sub for N:
    type Out = N
