# Range iteration (spec/lang/06-control-flow.md#range-iteration): one
# implementation per integer type. Each `iter()` starts from the start
# bound (r-flow.for.range.fresh). An `a..` iterator steps only when asked
# for its next item, so asking past the largest value is the checked
# `integer-overflow` panic (r-flow.for.range.from-overflow).

impl Iterable[i8] for Range[i8]:
    fn iter(self) -> mut Iterator[i8]:
        let next = self.start
        end := self.end
        Iterator::from_fn(fn() -> i8?:
            if next >= end:
                return .None
            value := next
            next = next + 1
            .Some(value)
        )

impl Iterable[i8] for RangeInclusive[i8]:
    fn iter(self) -> mut Iterator[i8]:
        let next = self.start
        end := self.end
        let done = next > end
        Iterator::from_fn(fn() -> i8?:
            if done:
                return .None
            value := next
            if value == end:
                done = true
            else:
                next = next + 1
            .Some(value)
