# The primitive implementations (spec/lang/05-expressions.md#primitive-implementations).
# Each body is the built-in operator on primitive operands, so it behaves as
# that operator does, including checked overflow and its panics
# (r-expr.op.std.intrinsic). The loader declares a trait's primitive
# implementations only for a program that names the trait.

impl Add[i8] for i8:
    type Out = i8
    fn add(self, rhs: i8) -> i8: self + rhs

impl Sub[i8] for i8:
    type Out = i8
    fn sub(self, rhs: i8) -> i8: self - rhs

impl Mul[i8] for i8:
    type Out = i8
    fn mul(self, rhs: i8) -> i8: self * rhs

impl Div[i8] for i8:
    type Out = i8
    fn div(self, rhs: i8) -> i8: self / rhs

impl Rem[i8] for i8:
    type Out = i8
    fn rem(self, rhs: i8) -> i8: self % rhs

