# Range iteration (spec/lang/06-control-flow.md#range-iteration): one
# implementation per integer type. Each `iter()` starts from the start
# bound (r-flow.for.range.fresh). A `Range` stops before its end, or after
# it when `inclusive`, so `a..=b` never steps past `b`. An `a..` iterator
# steps only when asked for its next item, so asking past the largest value
# is the checked `integer-overflow` panic (r-flow.for.range.from-overflow).

impl Iterable[i8] for Range[i8]:
    fn iter(self) -> mut Iterator[i8]:
        let next = self.start
        end := self.end
        inclusive := self.inclusive
        let done = next > end || (next == end && !inclusive)
        Iterator::from_fn(fn() -> i8?:
            if done:
                return .None
            value := next
            if value == end:
                done = true
            else:
                next = next + 1
                if next == end && !inclusive:
                    done = true
            .Some(value)
        )

impl Iterable[i8] for RangeFrom[i8]:
    fn iter(self) -> mut Iterator[i8]:
        let next = self.start
        let started = false
        Iterator::from_fn(fn() -> i8?:
            if started:
                next = next + 1
            started = true
            .Some(next)
        )

impl Iterable[i16] for Range[i16]:
    fn iter(self) -> mut Iterator[i16]:
        let next = self.start
        end := self.end
        inclusive := self.inclusive
        let done = next > end || (next == end && !inclusive)
        Iterator::from_fn(fn() -> i16?:
            if done:
                return .None
            value := next
            if value == end:
                done = true
            else:
                next = next + 1
                if next == end && !inclusive:
                    done = true
            .Some(value)
        )

impl Iterable[i16] for RangeFrom[i16]:
    fn iter(self) -> mut Iterator[i16]:
        let next = self.start
        let started = false
        Iterator::from_fn(fn() -> i16?:
            if started:
                next = next + 1
            started = true
            .Some(next)
        )

