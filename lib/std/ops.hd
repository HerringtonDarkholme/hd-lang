# std.ops: the operator and index traits, the range types with their
# slicing and iteration implementations, the stdlib `Default` trait
# (spec/std/ops.md), and the literal-suffix and string-prefix markers
# (spec/lang/05-expressions.md#literal-suffixes, #prefixed-strings) and
# `Template`. The raw-text prefix `r` and the prefix helpers `interpolate`,
# `process_escapes`, and `EscapeError` are in `std.text` (Literal Suffixes
# L20, L22).
# A suffix function is one marked `@num_suffix`, and a prefix function one
# marked `@str_prefix`; the compiler recognizes `std.ops.NumSuffix`,
# `std.ops.StrPrefix`, and `std.ops.Template` by their qualified names
# (r-expr.literal-fn.marker), and `@annotate::[F](.Fn)` limits
# each marker to functions (r-expr.literal-fn.fn-only).
use std.annotation.annotate
use std.function.{FnMut, Tuple}
use std.hash.Hash
use std.num.{Num, Integer, Float}
use std.structure.{Structure, Source, Variant, Field, Members, Key, fills_defaults}

# Both markers are typed fact types (r-annot.typed-fact.declare), so a
# marker on `fn ms(n: i64) -> Millis` checks like
# `let f: NumSuffix[fn(i64) -> Millis] = num_suffix()`: the signatures below
# hold every shape constraint, and `Q` takes any requirement row
# (r-expr.literal-fn.row).
@annotate::[F](.Fn)
## The marker a suffix function carries, written `@num_suffix`.
## See [expr.literal-fn.marker](../../spec/lang/05-expressions.md#r-expr.literal-fn.marker).
@derive(Debug)
pub struct NumSuffix[F]: pass

## Returns the `@num_suffix` marker for a suffix function of that signature.
## See [expr.literal-fn.fn-only](../../spec/lang/05-expressions.md#r-expr.literal-fn.fn-only).
pub fn num_suffix[N < Num, R, $ Q]() -> NumSuffix[fn(N) -> R $ Q]:
    NumSuffix::[fn(N) -> R $ Q] {}

@annotate::[F](.Fn)
## The marker a prefix function carries, written `@str_prefix`.
## See [expr.literal-fn.marker](../../spec/lang/05-expressions.md#r-expr.literal-fn.marker).
@derive(Debug)
pub struct StrPrefix[F]: pass

## Returns the `@str_prefix` marker for a prefix function of that signature.
## See [expr.literal-fn.fn-only](../../spec/lang/05-expressions.md#r-expr.literal-fn.fn-only).
pub fn str_prefix[T, R, $ Q]() -> StrPrefix[fn(Template[T]) -> R $ Q]:
    StrPrefix::[fn(Template[T]) -> R $ Q] {}

# The argument of a prefix function: the `n + 1` raw text pieces around the
# `n` interpolated values (r-expr.prefix.template).
## The pieces of a string prefix's literal: the raw parts and the values between them, which the compiler recognizes by its qualified name.
## See [expr.literal-fn.marker](../../spec/lang/05-expressions.md#r-expr.literal-fn.marker).
@derive(Debug)
pub struct Template[T]:
    ## The literal's raw text pieces, in order.
    ## See [expr.literal-fn.fn-only](../../spec/lang/05-expressions.md#r-expr.literal-fn.fn-only).
    pub raw_parts: List[string]
    ## The interpolated values between the raw parts, in order.
    ## See [expr.literal-fn.fn-only](../../spec/lang/05-expressions.md#r-expr.literal-fn.fn-only).
    pub values: List[T]

# The operator traits (spec/lang/05-expressions.md#operator-traits). An operator
# on a primitive operand never searches them; any other operand calls the
# left operand's implementation (r-expr.op.desugar).
## The trait of the `+` operator: `a + b` is the call `Add::add(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Add[Rhs = Self]:
    type Out
    fn add(self, rhs: Rhs) -> Self::Out

## The trait of the binary `-` operator: `a - b` is the call `Sub::sub(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Sub[Rhs = Self]:
    type Out
    fn sub(self, rhs: Rhs) -> Self::Out

## The trait of the `*` operator: `a * b` is the call `Mul::mul(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Mul[Rhs = Self]:
    type Out
    fn mul(self, rhs: Rhs) -> Self::Out

## The trait of the `/` operator: `a / b` is the call `Div::div(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Div[Rhs = Self]:
    type Out
    fn div(self, rhs: Rhs) -> Self::Out

## The trait of the `%` operator: `a % b` is the call `Rem::rem(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Rem[Rhs = Self]:
    type Out
    fn rem(self, rhs: Rhs) -> Self::Out

## The trait of the unary `-` operator: `-a` is the call `Neg::neg(a)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Neg:
    type Out
    fn neg(self) -> Self::Out

## The trait of the `&` operator: `a & b` is the call `BitAnd::bitand(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait BitAnd[Rhs = Self]:
    type Out
    fn bit_and(self, rhs: Rhs) -> Self::Out

## The trait of the `|` operator: `a | b` is the call `BitOr::bitor(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait BitOr[Rhs = Self]:
    type Out
    fn bit_or(self, rhs: Rhs) -> Self::Out

## The trait of the `^` operator: `a ^ b` is the call `BitXor::bitxor(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait BitXor[Rhs = Self]:
    type Out
    fn bit_xor(self, rhs: Rhs) -> Self::Out

## The trait of the `!` operator: `!a` is the call `Not::not(a)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Not:
    type Out
    fn not(self) -> Self::Out

## The trait of the `<<` operator: `a << b` is the call `Shl::shl(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Shl[Rhs = Self]:
    type Out
    fn shl(self, rhs: Rhs) -> Self::Out

## The trait of the `>>` operator: `a >> b` is the call `Shr::shr(a, b)`.
## See [expr.op.trait.std](../../spec/lang/05-expressions.md#r-expr.op.trait.std).
pub trait Shr[Rhs = Self]:
    type Out
    fn shr(self, rhs: Rhs) -> Self::Out

# `r[k]` and `r[k] = v` on a type other than `List`, `Map`, and `string`
# (spec/lang/05-expressions.md#index-traits).
## The trait of reading `r[k]`: for a receiver that is not a list, map, or string, it is the call `Index::[K]::index(r, k)`.
## See [expr.index.trait.std-ref](../../spec/lang/05-expressions.md#r-expr.index.trait.std-ref).
pub trait Index[K]:
    type Out
    fn index(self, key: K) -> Self::Out

## The trait of assigning `r[k] = v`: it is the call `IndexSet::[K, V]::index_set(r, k, v)`.
## See [expr.index.trait.std-ref](../../spec/lang/05-expressions.md#r-expr.index.trait.std-ref).
pub trait IndexSet[K, V]:
    fn index_set(&mut self, key: K, value: V) -> void

# `v()` and `v() = x` on a value that is not a function: a callable value
# reads through `Apply` and, when it also implements `Update`, stores
# through it (spec/lang/05-expressions.md#callable-values). Neither takes a key.
## The trait of calling a value: `v()` is the call `Apply::apply(v)`.
## See [expr.call.apply.std-ref](../../spec/lang/05-expressions.md#r-expr.call.apply.std-ref).
pub trait Apply:
    type Out
    fn apply(self) -> Self::Out

## The trait of assigning to a call: `v() = x` is the call `Update::[V]::update(v, x)`.
## See [expr.call.apply.std-ref](../../spec/lang/05-expressions.md#r-expr.call.apply.std-ref).
pub trait Update[V]:
    fn update(&mut self, value: V) -> void

# A `using` binding disposes its value at scope exit through this trait
# (spec/lang/06-control-flow.md#using-bindings). It is not a prelude name;
# `using` needs no import.
## A value that releases what it holds synchronously when a `using` binding of it ends. `dispose` is best-effort and reports nothing. Its cleanup may require the row `R`, which defaults to the empty row.
## See [flow.using.disposable.row](../../spec/lang/06-control-flow.md#r-flow.using.disposable.row).
pub trait Disposable[$ R = $ ()]:
    fn dispose(&mut self) -> void $ R

# A `using!` binding disposes its value at scope exit through this trait
# (spec/lang/06-control-flow.md#using-bindings). It is not a prelude name;
# `using!` needs no import.
## A value that releases what it holds when a `using!` binding of it ends. `dispose!` may suspend, is best-effort, and reports nothing. Its cleanup may require the row `R`, which defaults to the empty row.
## See [flow.using.async-disposable.row](../../spec/lang/06-control-flow.md#r-flow.using.async-disposable.row).
pub trait AsyncDisposable[$ R = $ ()]:
    fn dispose!(&mut self) -> void $ R

# A scope guard turns a synchronous callback into explicit `using` cleanup.
# It is ordinary standard-library code over `Disposable`.
## A guard that runs `action` when a `using` binding of it ends. The action may require `R` and may capture references of lifetime `'a`.
## See [std-ops.scope-guard.type.generic](../../spec/std/ops.md#r-std-ops.scope-guard.type.generic).
pub struct ScopeGuard[F < FnMut() -> void $ R & 'a, $ R, 'a]:
    action: F

## Builds a scope guard whose cleanup runs `action`.
## See [std-ops.scope-guard.on-exit.generic](../../spec/std/ops.md#r-std-ops.scope-guard.on-exit.generic).
pub fn on_exit[F < FnMut() -> void $ R & 'a, $ R, 'a](action: F) -> ScopeGuard[F, $ R, 'a]:
    ScopeGuard { action: action }

impl[$ R, 'a, F < FnMut() -> void $ R & 'a] Disposable[$ R] for ScopeGuard[F, $ R, 'a]:
    fn dispose(&mut self) -> void $ R:
        (self.action)()

# The built-in implementations (spec/lang/05-expressions.md#built-in-implementations).
# Each body is the built-in indexing of its type, with its checks and
# panics: `Map`'s `index` returns `V` and panics on a missing key
# (spec/lang/05-expressions.md#r-expr.index.map.read-value).
impl[T] Index[usize] for List[T]:
    type Out = T
    fn index(self, key: usize) -> T:
        self[key]

impl[T] IndexSet[usize, T] for List[T]:
    fn index_set(&mut self, key: usize, value: T) -> void:
        self[key] = value

impl[K < Eq & Hash, V] Index[K] for Map[K, V]:
    type Out = V
    fn index(self, key: K) -> V:
        self[key]

impl[K < Eq & Hash, V] IndexSet[K, V] for Map[K, V]:
    fn index_set(&mut self, key: K, value: V) -> void:
        self[key] = value

impl Index[usize] for string:
    type Out = u8
    fn index(self, key: usize) -> u8:
        self[key]

# The range types (spec/lang/05-expressions.md#range-expressions). A range
# expression builds one of them with no `use`, but they are not prelude
# names (r-expr.range.not-prelude). `a..b` and `a..=b` are both a `Range`,
# and `..b` and `..=b` both a `RangeTo`; `inclusive` tells them apart
# (r-expr.range.inclusive-field).
## The range `a..b` or `a..=b`: a lower and an upper bound.
## See [expr.range.declared.struct](../../spec/lang/05-expressions.md#r-expr.range.declared.struct).
@derive(Debug, Eq)
pub struct Range[T]:
    ## The range's lower bound.
    ## See [expr.range.value.fields](../../spec/lang/05-expressions.md#r-expr.range.value.fields).
    pub start: T
    ## The range's upper bound.
    ## See [expr.range.value.fields](../../spec/lang/05-expressions.md#r-expr.range.value.fields).
    pub end: T
    ## True for the `..=` form, false for the `..` form.
    ## See [expr.range.inclusive-field](../../spec/lang/05-expressions.md#r-expr.range.inclusive-field).
    pub inclusive: bool

## The range `a..`: a lower bound and no end.
## See [expr.range.declared.struct](../../spec/lang/05-expressions.md#r-expr.range.declared.struct).
@derive(Debug, Eq)
pub struct RangeFrom[T]:
    ## The range's lower bound.
    ## See [expr.range.value.fields](../../spec/lang/05-expressions.md#r-expr.range.value.fields).
    pub start: T

## The range `..b` or `..=b`: an upper bound and no start.
## See [expr.range.declared.struct](../../spec/lang/05-expressions.md#r-expr.range.declared.struct).
@derive(Debug, Eq)
pub struct RangeTo[T]:
    ## The range's upper bound.
    ## See [expr.range.value.fields](../../spec/lang/05-expressions.md#r-expr.range.value.fields).
    pub end: T
    ## True for the `..=` form, false for the `..` form.
    ## See [expr.range.inclusive-field](../../spec/lang/05-expressions.md#r-expr.range.inclusive-field).
    pub inclusive: bool

## The range `..`: the whole extent.
## See [expr.range.declared.struct](../../spec/lang/05-expressions.md#r-expr.range.declared.struct).
@derive(Debug, Eq)
pub struct RangeFull: pass

# The range types compare field by field (r-std-ops.range.eq.range).

# The exclusive end of a slice, checked against the container length.
fn slice_stop(size: usize, start: u64, end: u64, inclusive: bool) -> usize:
    let stop = end
    if inclusive:
        if end >= u64(size):
            panic_with("index-out-of-bounds", "slice out of bounds")
        stop = end + 1
    if stop > u64(size) || start > stop:
        panic_with("index-out-of-bounds", "slice out of bounds")
    usize(stop)

# A string slice shares its bytes and checks scalar boundaries.
fn slice_string(text: string, start: u64, end: u64, inclusive: bool) -> string:
    stop := slice_stop(text.len(), start, end, inclusive)
    text.slice(usize(start), stop)

# A list slice copies the selected elements.
fn slice_list[T](items: List[T], start: u64, end: u64, inclusive: bool) -> List[T]:
    stop := slice_stop(items.len(), start, end, inclusive)
    let mut copy: List[T] = []
    let index = usize(start)
    while index < stop:
        copy.push(items[index])
        index = index + 1
    copy

# The checked runtime panic of `category`, such as `index-out-of-bounds`,
# showing `message`, or no message when it is empty; it does not return.
@intrinsic("panic")
fn panic_with(category: string, message: string) -> void:
    panic("intrinsic")

# Slicing (spec/lang/05-expressions.md#built-in-implementations): one
# implementation per range type, with unsigned bounds, for
# `string` and `List`.
impl Index[RangeFull] for string:
    type Out = string
    fn index(self, key: RangeFull) -> string:
        self

impl[T] Index[RangeFull] for List[T]:
    type Out = List[T]
    fn index(self, key: RangeFull) -> List[T]:
        slice_list(self, 0, u64(self.len()), false)

impl Index[Range[u8]] for string:
    type Out = string
    fn index(self, key: Range[u8]) -> string:
        slice_string(self, u64(key.start), u64(key.end), key.inclusive)

impl[T] Index[Range[u8]] for List[T]:
    type Out = List[T]
    fn index(self, key: Range[u8]) -> List[T]:
        slice_list(self, u64(key.start), u64(key.end), key.inclusive)

impl Index[RangeFrom[u8]] for string:
    type Out = string
    fn index(self, key: RangeFrom[u8]) -> string:
        slice_string(self, u64(key.start), u64(self.len()), false)

impl[T] Index[RangeFrom[u8]] for List[T]:
    type Out = List[T]
    fn index(self, key: RangeFrom[u8]) -> List[T]:
        slice_list(self, u64(key.start), u64(self.len()), false)

impl Index[RangeTo[u8]] for string:
    type Out = string
    fn index(self, key: RangeTo[u8]) -> string:
        slice_string(self, 0, u64(key.end), key.inclusive)

impl[T] Index[RangeTo[u8]] for List[T]:
    type Out = List[T]
    fn index(self, key: RangeTo[u8]) -> List[T]:
        slice_list(self, 0, u64(key.end), key.inclusive)

impl Index[Range[u16]] for string:
    type Out = string
    fn index(self, key: Range[u16]) -> string:
        slice_string(self, u64(key.start), u64(key.end), key.inclusive)

impl[T] Index[Range[u16]] for List[T]:
    type Out = List[T]
    fn index(self, key: Range[u16]) -> List[T]:
        slice_list(self, u64(key.start), u64(key.end), key.inclusive)

impl Index[RangeFrom[u16]] for string:
    type Out = string
    fn index(self, key: RangeFrom[u16]) -> string:
        slice_string(self, u64(key.start), u64(self.len()), false)

impl[T] Index[RangeFrom[u16]] for List[T]:
    type Out = List[T]
    fn index(self, key: RangeFrom[u16]) -> List[T]:
        slice_list(self, u64(key.start), u64(self.len()), false)

impl Index[RangeTo[u16]] for string:
    type Out = string
    fn index(self, key: RangeTo[u16]) -> string:
        slice_string(self, 0, u64(key.end), key.inclusive)

impl[T] Index[RangeTo[u16]] for List[T]:
    type Out = List[T]
    fn index(self, key: RangeTo[u16]) -> List[T]:
        slice_list(self, 0, u64(key.end), key.inclusive)

impl Index[Range[usize]] for string:
    type Out = string
    fn index(self, key: Range[usize]) -> string:
        slice_string(self, u64(key.start), u64(key.end), key.inclusive)

impl[T] Index[Range[usize]] for List[T]:
    type Out = List[T]
    fn index(self, key: Range[usize]) -> List[T]:
        slice_list(self, u64(key.start), u64(key.end), key.inclusive)

impl Index[RangeFrom[usize]] for string:
    type Out = string
    fn index(self, key: RangeFrom[usize]) -> string:
