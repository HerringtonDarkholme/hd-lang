# `string + string` concatenates (r-expr.op.std.string-add). It is hd over
# the string's bytes, not an intrinsic: interpolation joins the two texts.
impl Add[string] for string:
    type Out = string
    fn add(self, rhs: string) -> string:
        "$self$rhs"

# `Default`: a type's default value (spec/std/ops.md#default-trait). It is
# not a prelude name; code imports it as `use std.ops.Default`.
## A type's default value, which `T::default()` returns.
## See [std-ops.default.trait](../../spec/std/ops.md#r-std-ops.default.trait).
pub trait Default:
    fn default() -> Self

# The standard implementations (spec/std/ops.md#standard-implementations).

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for i8:
    fn default() -> i8:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for i16:
    fn default() -> i16:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for i32:
    fn default() -> i32:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for i64:
    fn default() -> i64:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for u8:
    fn default() -> u8:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for u16:
    fn default() -> u16:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for u32:
    fn default() -> u32:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for usize:
    fn default() -> usize:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for u64:
    fn default() -> u64:
        0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for f32:
    fn default() -> f32:
        0.0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for f64:
    fn default() -> f64:
        0.0

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for bool:
    fn default() -> bool:
        false

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl Default for string:
    fn default() -> string:
        ""

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl[T] Default for List[T]:
    fn default() -> List[T]:
        []

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl[K < Eq & Hash, V] Default for Map[K, V]:
    fn default() -> Map[K, V]:
        {}

# Keep handwritten Default: construct the builtin zero/empty value, which has no derivable declaration.
impl[T] Default for T?:
    fn default() -> T?:
        .None

# Tuple `Default` (spec/std/ops.md#r-std-ops.default.std.tuple-template):
# each element's default, at every size. A rest element is one `List[T]`
# member, whose default is empty, so its `T` needs no `Default`
# (r-std-ops.default.std.rest-any).
impl[T < Tuple] Default for T by Structure:
    fn default() -> T:
        let mut s = DefaultSource::[T] { at: 0 }
        match T::build(&mut s):
            .Ok(value) => value
            .Err(_) => panic("a tuple's default never fails")

# Derived `Default` (spec/std/ops.md#derived-default): each member's
# declared default, else its own type's default
# (r-std-ops.default.derive.data.declared), and for an enum the variant
# marked `@default`
# (r-std-ops.default.derive.enum). The compiler checks that a derived enum
# marks exactly one variant (r-std-ops.default.derive.one-variant).
impl[T] Default for T by Structure:
    fn default() -> T:
        let mut s = DefaultSource::[T] { at: 0 }
        match T::build(&mut s):
            .Ok(value) => value
            .Err(_) => panic("a derived default never fails")

# The `@default` variant marker's fact type and marker function
# (r-std-ops.default.derive.marker): `@default` on a variant attaches
# `default()`.
@annotate(.Variant)
## The `@default` variant marker's fact type: `@default` on a variant attaches `default()`.
## See [std-ops.default.derive.marker](../../spec/std/ops.md#r-std-ops.default.derive.marker).
@derive(Debug)
pub struct DefaultVariant: pass

## The marker function of `@default`: it attaches a `DefaultVariant` fact to the variant.
## See [std-ops.default.derive.marker](../../spec/std/ops.md#r-std-ops.default.derive.marker).
pub fn default() -> DefaultVariant:
    DefaultVariant {}

# Names each member in order and gives it its type's default. Its
# `fills_defaults()` fact makes `build` fill a member that declares a
# default from that default without offering it here, so that member's
# type needs no `Default` (r-std-ops.default.derive.data.declared,
# r-std-ops.default.derive.member-bound.declared). The field is public
# because the prototype checks the instantiated source in the program
# that uses it.
struct DefaultSource[S]:
    pub at: usize

@fills_defaults()
impl[S] Source[S] for DefaultSource[S]:
    type Error = never

    # A tuple or a data type offers one choice. An enum's choice is the
    # variant whose facts hold a `DefaultVariant`.
    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], never]:
        for choice in choices:
            match choice.info.facts.find::[DefaultVariant]():
                .Some(_) => return .Ok(choice)
                .None => pass
        .Ok(choices[0])

    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, never]:
        if self.at >= members.infos.len():
            return .Ok(.None)
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    fn member[F < Default](&mut self, h: Field[S, F], previous: F?) -> Result[F, never]:
        .Ok(F::default())

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, never]:
        panic("the default source names every member")
