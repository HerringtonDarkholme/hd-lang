# std.ops: the operator and index traits, the range types with their
# slicing and iteration implementations, the stdlib `Default` trait
# (spec/std/ops.md), and the literal-suffix and string-prefix markers
# (spec/lang/05-expressions.md#literal-suffixes, #prefixed-strings) and
# `Template`. The raw-text prefix `r` and the prefix helpers `interpolate`,
# `process_escapes`, and `EscapeError` are in `std.text` (Literal Suffixes
# L20, L22).
# A suffix function is one marked `@num_suffix`, and a prefix function one
# marked `@str_prefix`; the compiler recognizes `std.ops.NumSuffix`,
# `std.ops.StrPrefix`, and `std.ops.Template` by their qualified names
# (r-expr.literal-fn.marker), and `@annotate::[F](.Fn)` limits
# each marker to functions (r-expr.literal-fn.fn-only).
use std.annotation.annotate
use std.hash.Hash
use std.num.Num
use std.function.Tuple
use std.structure.{Structure, Source, Variant, Field, Members, Key}

# Both markers are typed fact types (r-annot.typed-fact.declare), so a
# marker on `fn ms(n: i64) -> Millis` checks like
# `let f: NumSuffix[fn(i64) -> Millis] = num_suffix()`: the signatures below
# hold every shape constraint, and `Q` takes any requirement row
# (r-expr.literal-fn.row).
@annotate::[F](.Fn)
pub data NumSuffix[F]: pass

pub fn num_suffix[N < Num, R, $Q]() -> NumSuffix[fn(N) -> R $ Q]:
    NumSuffix::[fn(N) -> R $ Q] {}

@annotate::[F](.Fn)
pub data StrPrefix[F]: pass

pub fn str_prefix[T, R, $Q]() -> StrPrefix[fn(Template[T]) -> R $ Q]:
    StrPrefix::[fn(Template[T]) -> R $ Q] {}

# The argument of a prefix function: the `n + 1` raw text pieces around the
# `n` interpolated values (r-expr.prefix.template).
pub data Template[T]:
    pub raw_parts: List[string]
    pub values: List[T]

# The operator traits (spec/lang/05-expressions.md#operator-traits). An operator
# on a primitive operand never searches them; any other operand calls the
# left operand's implementation (r-expr.op.desugar).
pub trait Add[Rhs = Self]:
    type Out
    fn add(self, rhs: Rhs) -> Self::Out

pub trait Sub[Rhs = Self]:
    type Out
    fn sub(self, rhs: Rhs) -> Self::Out

pub trait Mul[Rhs = Self]:
    type Out
    fn mul(self, rhs: Rhs) -> Self::Out

pub trait Div[Rhs = Self]:
    type Out
    fn div(self, rhs: Rhs) -> Self::Out

pub trait Rem[Rhs = Self]:
    type Out
    fn rem(self, rhs: Rhs) -> Self::Out

pub trait Neg:
    type Out
    fn neg(self) -> Self::Out

pub trait BitAnd[Rhs = Self]:
    type Out
    fn bit_and(self, rhs: Rhs) -> Self::Out

pub trait BitOr[Rhs = Self]:
    type Out
    fn bit_or(self, rhs: Rhs) -> Self::Out

pub trait BitXor[Rhs = Self]:
    type Out
    fn bit_xor(self, rhs: Rhs) -> Self::Out

pub trait Not:
    type Out
    fn not(self) -> Self::Out

pub trait Shl[Rhs = Self]:
    type Out
    fn shl(self, rhs: Rhs) -> Self::Out

pub trait Shr[Rhs = Self]:
    type Out
    fn shr(self, rhs: Rhs) -> Self::Out

# `r[k]` and `r[k] = v` on a type other than `List`, `Map`, and `string`
# (spec/lang/05-expressions.md#index-traits).
pub trait Index[K]:
    type Out
    fn index(self, key: K) -> Self::Out

pub trait IndexSet[K, V]:
    fn index_set(mut self, key: K, value: V) -> void

# `v()` and `v() = x` on a value that is not a function: a callable value
# reads through `Apply` and, when it also implements `Update`, stores
# through it (spec/lang/05-expressions.md#callable-values). Neither takes a key.
pub trait Apply:
    type Out
    fn apply(self) -> Self::Out

pub trait Update[V]:
    fn update(mut self, value: V) -> void

# The built-in implementations (spec/lang/05-expressions.md#built-in-implementations).
# Each body is the built-in indexing of its type, with its checks and
# panics: `Map`'s `index` returns `V` and panics on a missing key
# (spec/lang/05-expressions.md#r-expr.index.map.read-value).
impl[T] Index[i32] for List[T]:
    type Out = T
    fn index(self, key: i32) -> T: self[key]

impl[T] IndexSet[i32, T] for List[T]:
    fn index_set(mut self, key: i32, value: T) -> void:
        self[key] = value

impl[K < Eq & Hash, V] Index[K] for Map[K, V]:
    type Out = V
    fn index(self, key: K) -> V: self[key]

impl[K < Eq & Hash, V] IndexSet[K, V] for Map[K, V]:
    fn index_set(mut self, key: K, value: V) -> void:
        self[key] = value

impl Index[i32] for string:
    type Out = u8
    fn index(self, key: i32) -> u8: self[key]

# The range types (spec/lang/05-expressions.md#range-expressions). A range
# expression builds one of them with no `use`, but they are not prelude
# names (r-expr.range.not-prelude).
pub data Range[T]:
    pub start: T
    pub end: T

pub data RangeFrom[T]:
    pub start: T

pub data RangeTo[T]:
    pub end: T

pub data RangeInclusive[T]:
    pub start: T
    pub end: T

pub data RangeToInclusive[T]:
    pub end: T

pub data RangeFull: pass

# The end offset of the slice of `size` items from `start` up to `end`, or
# through `end` when `inclusive`. A negative offset, an offset past `size`,
# or a start after the end is the checked panic `index-out-of-bounds`
# (spec/lang/05-expressions.md#slicing). A `u64` bound past the largest
# `i64` wraps to a negative one, so it panics too.
fn slice_stop(size: i32, start: i64, end: i64, inclusive: bool) -> i32:
    let stop = end
    if inclusive:
        if end < 0 || end >= i64(size):
            panic_with("index-out-of-bounds", "")
        stop = end + 1
    if start < 0 || stop < 0 || stop > i64(size) || start > stop:
        panic_with("index-out-of-bounds", "")
    i32(stop)

# A string slice: the bytes at the selected offsets, which must be scalar
# boundaries (r-expr.index.slice.string), sharing them as `slice` does.
fn slice_string(text: string, start: i64, end: i64, inclusive: bool) -> string:
    stop := slice_stop(text.len(), start, end, inclusive)
    text.slice(i32(start), stop)

# A list slice: a new list of the selected elements (r-expr.index.slice.list).
fn slice_list[T](items: List[T], start: i64, end: i64, inclusive: bool) -> mut List[T]:
    stop := slice_stop(items.len(), start, end, inclusive)
    let copy: mut List[T] = []
    let index = i32(start)
    while index < stop:
        copy.append(items[index])
        index = index + 1
    copy

# The checked runtime panic of `category`, such as `index-out-of-bounds`,
# showing `message`, or no message when it is empty; it does not return.
@intrinsic("panic")
fn panic_with(category: string, message: string) -> void:
    panic("intrinsic")

# Slicing (spec/lang/05-expressions.md#built-in-implementations): one
# implementation per range type and integer type, for `string` and `List`.
impl Index[RangeFull] for string:
    type Out = string
    fn index(self, key: RangeFull) -> string: self

impl[T] Index[RangeFull] for List[T]:
    type Out = mut List[T]
    fn index(self, key: RangeFull) -> mut List[T]: slice_list(self, 0, i64(self.len()), false)

impl Index[Range[i8]] for string:
    type Out = string
    fn index(self, key: Range[i8]) -> string: slice_string(self, i64(key.start), i64(key.end), false)

