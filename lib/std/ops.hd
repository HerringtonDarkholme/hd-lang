# The primitive implementations (spec/lang/05-expressions.md#primitive-implementations).
# Each method is intrinsic: the compiler supplies its body, one per
# operation, and specializes it for each type
# (spec/lang/09-traits.md#intrinsic-methods). An operator on primitive
# operands calls these methods, so no body is written with the operator it
# implements.
impl[N < Num] Add for N:
    type Out = N
    @intrinsic
    fn add(self, rhs: N) -> N

impl[N < Num] Sub for N:
    type Out = N
    @intrinsic
    fn sub(self, rhs: N) -> N

impl[N < Num] Mul for N:
    type Out = N
    @intrinsic
    fn mul(self, rhs: N) -> N

impl[N < Num] Div for N:
    type Out = N
    @intrinsic
    fn div(self, rhs: N) -> N

impl[N < Num] Rem for N:
    type Out = N
    @intrinsic
    fn rem(self, rhs: N) -> N

# `Neg` for the signed integers and the floats (r-expr.op.std.neg).
impl Neg for i8:
    type Out = i8
    @intrinsic
    fn neg(self) -> i8

impl Neg for i16:
    type Out = i16
    @intrinsic
    fn neg(self) -> i16

impl Neg for i32:
    type Out = i32
    @intrinsic
    fn neg(self) -> i32

impl Neg for i64:
    type Out = i64
    @intrinsic
    fn neg(self) -> i64

impl[F < Float] Neg for F:
    type Out = F
    @intrinsic
    fn neg(self) -> F

impl[N < Integer] BitAnd for N:
    type Out = N
    @intrinsic
    fn bit_and(self, rhs: N) -> N

impl[N < Integer] BitOr for N:
    type Out = N
    @intrinsic
    fn bit_or(self, rhs: N) -> N

impl[N < Integer] BitXor for N:
    type Out = N
    @intrinsic
    fn bit_xor(self, rhs: N) -> N

impl[N < Integer] Not for N:
    type Out = N
    @intrinsic
    fn not(self) -> N

# A shift's count is a `u32` (r-expr.shift.count-u32, r-expr.op.std.shift-u32).
impl[N < Integer] Shl[u32] for N:
    type Out = N
    @intrinsic
    fn shl(self, rhs: u32) -> N

impl[N < Integer] Shr[u32] for N:
    type Out = N
    @intrinsic
    fn shr(self, rhs: u32) -> N

# `string + string` concatenates (r-expr.op.std.string-add). It is hd over
# the string's bytes, not an intrinsic: interpolation joins the two texts.
impl Add[string] for string:
    type Out = string
    fn add(self, rhs: string) -> string: "$self$rhs"

# `Default`: a type's default value (spec/std/ops.md#default-trait). It is
# not a prelude name; code imports it as `use std.ops.Default`.
pub trait Default:
    fn default() -> Self

# The standard implementations (spec/std/ops.md#standard-implementations).

impl Default for i8:
    fn default() -> i8: 0

impl Default for i16:
    fn default() -> i16: 0

impl Default for i32:
    fn default() -> i32: 0

impl Default for i64:
    fn default() -> i64: 0

impl Default for u8:
    fn default() -> u8: 0

impl Default for u16:
    fn default() -> u16: 0

impl Default for u32:
    fn default() -> u32: 0

impl Default for usize:
    fn default() -> usize: 0

impl Default for u64:
    fn default() -> u64: 0

impl Default for f32:
    fn default() -> f32: 0.0

impl Default for f64:
    fn default() -> f64: 0.0

impl Default for bool:
    fn default() -> bool: false

impl Default for string:
    fn default() -> string: ""

impl[T] Default for List[T]:
    fn default() -> List[T]: []

impl[K < Eq & Hash, V] Default for Map[K, V]:
    fn default() -> Map[K, V]: {}

impl[T] Default for T?:
    fn default() -> T?: .None

# Tuple `Default` (spec/std/ops.md#r-std-ops.default.std.tuple-template):
# each element's default, at every size. A rest element is one `List[T]`
# member, whose default is empty, so its `T` needs no `Default`
# (r-std-ops.default.std.rest-any).
impl[T < Tuple] Default for T by Structure:
    fn default() -> T:
        let s: mut DefaultSource[T] = DefaultSource::[T] { at: 0 }
        match T::build(s):
            .Ok(value) => value
            .Err(_) => panic("a tuple's default never fails")

# Derived `Default` (spec/std/ops.md#derived-default): each member's
# declared default, else its own type's default
# (r-std-ops.default.derive.data.declared), and for an enum the variant
# marked `@default`
# (r-std-ops.default.derive.enum). The compiler checks that a derived enum
# marks exactly one variant (r-std-ops.default.derive.one-variant).
impl[T] Default for T by Structure:
    fn default() -> T:
        let s: mut DefaultSource[T] = DefaultSource::[T] { at: 0 }
        match T::build(s):
            .Ok(value) => value
            .Err(_) => panic("a derived default never fails")

# The `@default` variant marker's fact type and marker function
# (r-std-ops.default.derive.marker): `@default` on a variant attaches
# `default()`.
@annotate(.Variant)
pub data DefaultVariant: pass

pub fn default() -> DefaultVariant:
    DefaultVariant {}

# The derived builder calls, written by hand because `@derive` does not
# run inside lib/std (r-std-format.debug.std-types).
impl Debug for DefaultVariant:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("DefaultVariant").finish()

# Names each member in order and gives it its declared default, or its
# type's default when it declares none. The field is
# public because the prototype checks the instantiated source in the
# program that uses it.
data DefaultSource[S]:
    pub at: usize

impl[S] Source[S] for DefaultSource[S]:
    type Error = never

    # A tuple or a data type offers one choice. An enum's choice is the
    # variant whose facts hold a `DefaultVariant`.
    fn variant(mut self, choices: List[Variant[S]]) -> Result[Variant[S], never]:
        for choice in choices:
            match choice.info.facts.find::[DefaultVariant]():
                .Some(_) => return .Ok(choice)
                .None => pass
        .Ok(choices[0])

    fn next(mut self, members: Members[S]) -> Result[Key[S], never]:
        if self.at >= members.infos.len():
            return .Ok(members.end())
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    fn member[F < Default](mut self, h: Field[S, F], previous: F?) -> Result[F, never]:
        match h.default():
            .Some(value) => .Ok(value)
            .None => .Ok(F::default())

    fn missing[F](mut self, h: Field[S, F]) -> Result[F, never]:
        panic("the default source names every member")
