    let low: usize = 0
    let high = names.len()
    while low < high:
        mid := low + (high - low) / 2
        if names[mid] < name:
            low = mid + 1
        else:
            high = mid
    if low == names.len() || names[low] != name:
        return .None
    text := data[low]
    let mut at: usize = 0
    let previous = -1
    let mut out: List[i32] = []
    while at < bytes_len(text):
        first := read_number(text, &mut at)
        width := read_number(text, &mut at)
        start := previous + 1 + first
        previous = start + width
        out.push(start)
        out.push(previous)
    .Some(out)

