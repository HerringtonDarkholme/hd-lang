# std.contract.

## Panics unless `condition` returns true.
## See [std-contract.require.decl](../../spec/std/contract.md#r-std-contract.require.decl).
@cfg(.Debug)
pub fn require(message: string = "requirement failed", condition: fn() -> bool) -> void:
    if !condition():
        panic(message)

@cfg(.Release)
pub fn require(message: string = "requirement failed", condition: fn() -> bool) -> void:
    pass
