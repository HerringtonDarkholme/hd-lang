# std.host: the host capability traits `Args` and `Env`, their helpers, and
# the deterministic providers `ScriptedArgs` and `ScriptedEnv` (spec/std/host.md).
# The default profile binds a host `Args` and `Env`
# (src/commands/default-profile.ts).
use std.format.DebugWriter
use std.error.Error
use std.text.Parse

## The host capability to read the process's arguments.
## See [std-host.args.decl](../../spec/std/host.md#r-std-host.args.decl).
pub trait Args:
    fn program(self) -> string
    fn list(self) -> List[string]

## The host capability to read the process's environment variables.
## See [std-host.env.decl](../../spec/std/host.md#r-std-host.env.decl).
pub trait Env:
    fn get(self, name: string) -> string?
    fn names(self) -> List[string]

## The process's arguments, the program name first.
## See [std-host.args.helper](../../spec/std/host.md#r-std-host.args.helper).
pub fn args() -> List[string] $ Args:
    $.use(Args).list()

## The value of the environment variable `name`, in `.Some`, or `.None` when it is not set.
## See [std-host.env.helper](../../spec/std/host.md#r-std-host.env.helper).
pub fn env(name: string) -> string? $ Env:
    $.use(Env).get(name)

# `env` read as a `T` (r-std-host.env-as.decl): an unset variable is
# `.Ok(.None)`, and one that `T::parse` refuses is an `EnvError` that names
# it and carries the parse error's `Display` text.
## The value of the environment variable `name` read as a `T`: `.None` when unset, an error naming the variable when unreadable.
## See [std-host.env-as.decl](../../spec/std/host.md#r-std-host.env-as.decl).
pub fn env_as[T < Parse[Error = E], E < Display](name: string) -> Result[T?, EnvError] $ Env:
    text := match $.use(Env).get(name):
        .Some(found) => found
        .None => return .Ok(.None)
    match T::parse(text):
        .Ok(value) => .Ok(.Some(value))
        .Err(error) => .Err(EnvError.InvalidValue(name, error.to_string()))

## Why `env_as` failed: the variable's text could not be read as the requested type.
## See [std-host.env-as.error](../../spec/std/host.md#r-std-host.env-as.error).
pub enum EnvError:
    InvalidValue(name: string, reason: string)

impl Eq for EnvError:
    fn eq(self, other: EnvError) -> bool:
        match (self, other):
            (.InvalidValue(a, reason), .InvalidValue(b, other_reason)) => a == b && reason == other_reason

impl Display for EnvError:
    fn to_string(self) -> string:
        match self:
            .InvalidValue(name, reason) => "invalid value for ${name}: ${reason}"

# A std error type implements `Error` (r-std-error.std-types.impl).
impl Error for EnvError

# The deterministic `Args` (spec/std/host.md#map-providers):
# it returns the program name and the arguments it was made with.
## The deterministic `Args` provider: a fixed list of arguments, with no host access.
## See [std-host.map-args.decl](../../spec/std/host.md#r-std-host.map-args.decl).
pub data ScriptedArgs:
    program: string
    values: List[string]

impl ScriptedArgs:
    ## Returns the provider whose arguments are `program` then `values`.
    ## See [std-host.map-args.new](../../spec/std/host.md#r-std-host.map-args.new).
    pub fn new(program: string, values: List[string]) -> ScriptedArgs:
        ScriptedArgs { program: program, values: values }

impl Args for ScriptedArgs:
    fn program(self) -> string:
        self.program

    fn list(self) -> List[string]:
        self.values

# The deterministic `Env`: its map is the whole environment, and `names`
# lists the map's keys in its iteration order (r-std-host.map-env.names.order).
## The deterministic `Env` provider: a fixed map of variables, with no host access.
## See [std-host.map-env.decl](../../spec/std/host.md#r-std-host.map-env.decl).
pub data ScriptedEnv:
    values: Map[string, string]

impl ScriptedEnv:
    ## Returns the provider that answers from `values`.
    ## See [std-host.map-env.new](../../spec/std/host.md#r-std-host.map-env.new).
    pub fn new(values: Map[string, string]) -> ScriptedEnv:
        ScriptedEnv { values: values }

impl Env for ScriptedEnv:
    fn get(self, name: string) -> string?:
        self.values.get(name)

    fn names(self) -> List[string]:
        let found: mut List[string] = []
        for (key, _) in self.values:
            found.push(key)
        found

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.source): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for ScriptedArgs:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ScriptedArgs").field("program", self.program).field("values", self.values).finish()

impl Debug for ScriptedEnv:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("ScriptedEnv").field("values", self.values).finish()

impl Debug for EnvError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .InvalidValue(name, reason) => out.debug_tuple("EnvError.InvalidValue").named_field("name", name).named_field("reason", reason).finish()
