# std.host: the host capability traits `Args`, `Env`, and `Sys`, their helpers,
# the deterministic providers `ScriptedArgs`, `ScriptedEnv`, and `ScriptedSys`, and the
# host wire format of private-field boundary types
# (spec/std/host.md).
# The default profile binds host `Args`, `Env`, and `Sys`
# (src/commands/default-profile.ts).
use std.error.Error
use std.serde.{Deserialize, Deserializer, ValueKind}
use std.structure.{Facts, Member, VariantInfo}
use std.text.Parse

## The host capability to read the process's arguments.
## See [std-host.args.decl](../../spec/std/host.md#r-std-host.args.decl).
pub trait Args:
    fn program(self) -> string
    fn list(self) -> List[string]

## The host capability to read the process's environment variables.
## See [std-host.env.decl](../../spec/std/host.md#r-std-host.env.decl).
pub trait Env:
    fn get(self, name: string) -> string?
    fn names(self) -> List[string]

## The process's arguments after the program name.
## See [std-host.args.helper](../../spec/std/host.md#r-std-host.args.helper).
pub fn args() -> List[string] $ Args:
    $.use(Args).list()

## The value of the environment variable `name`, in `.Some`, or `.None` when it is not set.
## See [std-host.env.helper](../../spec/std/host.md#r-std-host.env.helper).
pub fn env(name: string) -> string? $ Env:
    $.use(Env).get(name)

# `env` read as a `T` (r-std-host.env-as.shared-error-signature): an unset variable is
# `.Ok(.None)`, and one that `T::parse` refuses is a `HostError` that names
# it and carries the parse error's `Display` text.
## The value of the environment variable `name` read as a `T`: `.None` when unset, an error naming the variable when unreadable.
## See [std-host.env-as.shared-error-signature](../../spec/std/host.md#r-std-host.env-as.shared-error-signature).
pub fn env_as[T < Parse[Error = E], E < Display](name: string) -> Result[T?, HostError] $ Env:
    text := match $.use(Env).get(name):
        .Some(found) => found
        .None => return .Ok(.None)
    match T::parse(text):
        .Ok(value) => .Ok(.Some(value))
        .Err(error) => .Err(HostError.InvalidValue(name, error.to_string()))

## Reads a record from its declared environment variables through Deserialize.
## See [std-host.env-decode.prefix-decl](../../spec/std/host.md#r-std-host.env-decode.prefix-decl).
pub fn env_decode[T < Deserialize](prefix: string = "") -> Result[T, HostError] $ Env:
    let mut reader = EnvReader { vars: $.use(Env), prefix: prefix }
    T::deserialize(&mut reader)

# A flat environment format: root record, named members, and scalar text
# or a comma-separated list for each member. The default Deserialize source
# supplies declared defaults after is_absent reports an unset variable.
struct EnvReader:
    vars: *dyn Env
    prefix: string
    record: bool = false
    positioned: bool = false
    name: string = ""
    current: string? = .None
    items: List[string] = []
    at: usize = 0
    in_list: bool = false

impl EnvReader:
    fn root_error(&self) -> HostError:
        .Other("env_decode needs a struct with named fields")

    fn read_text(&mut self, expected: string) -> Result[string, HostError]:
        if !self.record || !self.positioned:
            return .Err(self.root_error())
        match self.current:
            .Some(text) => .Ok(text)
            .None => .Err(HostError.Missing(self.name))

    fn parse[T < Parse[Error = E], E < Display](
        &mut self,
        expected: string,
    ) -> Result[T, HostError]:
        text := self.read_text(expected)?
        match T::parse(text):
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(HostError.InvalidValue(self.name, error.to_string()))

impl Deserializer for EnvReader:
    type Error = HostError

    fn peek(&mut self) -> Result[ValueKind, HostError]:
        if !self.record || !self.positioned:
            return .Err(self.root_error())
        .Ok(if self.current.is_some(): .Text else: .Null)

    fn is_null(&mut self) -> Result[bool, HostError]:
        if !self.record || !self.positioned:
            return .Err(self.root_error())
        .Ok(self.current.is_none())

    fn is_absent(&mut self) -> bool:
        self.current.is_none()

    fn bool(&mut self, expected: string) -> Result[bool, HostError]:
        self.parse::[bool](expected)

    fn int(&mut self, expected: string) -> Result[i64, HostError]:
        self.parse::[i64](expected)

    fn uint(&mut self, expected: string) -> Result[u64, HostError]:
        self.parse::[u64](expected)

    fn float(&mut self, expected: string) -> Result[f64, HostError]:
        self.parse::[f64](expected)

    fn text(&mut self, expected: string) -> Result[string, HostError]:
        self.read_text(expected)

    fn begin_list(&mut self) -> Result[void, HostError]:
        if self.in_list:
            return .Err(self.invalid("a scalar list item"))
        text := self.read_text("list")?
        self.items = if text == "": [] else: text.split(",")
        self.at = 0
        self.in_list = true
        .Ok(())

    fn next_item(&mut self) -> Result[bool, HostError]:
        if !self.in_list:
            return .Err(self.invalid("list"))
        if self.at >= self.items.len():
            self.in_list = false
            return .Ok(false)
        self.current = .Some(self.items[self.at])
        self.at += 1
        .Ok(true)

    fn begin_map(&mut self) -> Result[void, HostError]:
        .Err(self.invalid("a scalar or list"))

    fn next_key(&mut self) -> Result[string?, HostError]:
        .Err(self.invalid("a scalar or list"))

    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, HostError]:
        if self.record:
            return .Err(self.invalid("a scalar or list"))
        if choices.len() != 1 || !choices[0].of_data || choices[0].name == "":
            return .Err(self.root_error())
        self.record = true
        .Ok(0)

    fn begin_newtype_variant(&mut self) -> Result[void, HostError]:
        .Err(self.invalid("a newtype variant"))

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, HostError]:
        .Err(self.invalid("a tuple variant"))

    fn member(&mut self, m: &Member) -> Result[void, HostError]:
        if m.positional:
            return .Err(self.root_error())
        self.name = self.prefix + m.name.upper()
        self.positioned = true
        self.current = self.vars.get(self.name)
        self.items = []
        self.at = 0
        self.in_list = false
        .Ok(())

    fn end_variant(&mut self) -> Result[void, HostError]:
        .Ok(())

    fn invalid(&mut self, expected: string) -> HostError:
        if !self.record || !self.positioned:
            return self.root_error()
        if self.current.is_none():
            return .Missing(self.name)
        .InvalidValue(self.name, "expected $expected")

## Why a host read failed, including a variable that could not be parsed.
## See [std-host.error.typed-env-decl](../../spec/std/host.md#r-std-host.error.typed-env-decl).
@error
@derive(Debug, Eq)
pub enum HostError:
    @error("sys access to ${subject} is not granted")
    NotGranted(subject: string)
    @error("sys access to ${name} is not supported")
    Unsupported(name: string)
    @error("$message")
    Other(message: string)
    @error("invalid value for ${name}: ${reason}")
    InvalidValue(name: string, reason: string)
    @error("missing environment variable $name")
    Missing(name: string)

# The deterministic `Args` (spec/std/host.md#map-providers):
# it returns the program name and the arguments it was made with.
## The deterministic `Args` provider: a fixed list of arguments, with no host access.
## See [std-host.map-args.decl](../../spec/std/host.md#r-std-host.map-args.decl).
@derive(Debug)
pub struct ScriptedArgs:
    program: string
    values: List[string]

impl ScriptedArgs:
    ## Returns the provider whose arguments are `program` then `values`.
    ## See [std-host.map-args.new](../../spec/std/host.md#r-std-host.map-args.new).
    pub fn new(program: string, values: List[string]) -> ScriptedArgs:
        ScriptedArgs { program: program, values: values }

impl Args for ScriptedArgs:
    fn program(self) -> string:
        self.program

    fn list(self) -> List[string]:
        self.values

# The deterministic `Env`: its map is the whole environment, and `names`
# lists the map's keys in its iteration order (r-std-host.map-env.names.order).
## The deterministic `Env` provider: a fixed map of variables, with no host access.
## See [std-host.map-env.decl](../../spec/std/host.md#r-std-host.map-env.decl).
@derive(Debug)
pub struct ScriptedEnv:
    values: Map[string, string]

impl ScriptedEnv:
    ## Returns the provider that answers from `values`.
    ## See [std-host.map-env.new](../../spec/std/host.md#r-std-host.map-env.new).
    pub fn new(values: Map[string, string]) -> ScriptedEnv:
        ScriptedEnv { values: values }

impl Env for ScriptedEnv:
    fn get(self, name: string) -> string?:
        self.values.get(name)

    fn names(self) -> List[string]:
        let mut found: List[string] = []
        for (key, _) in self.values:
            found.push(*key)
        found

## The host capability to read four facts about the host system.
## See [std-host.sys.decl](../../spec/std/host.md#r-std-host.sys.decl).
pub trait Sys:
    fn os(self) -> Result[string, HostError]
    fn arch(self) -> Result[string, HostError]
    fn hostname(self) -> Result[string, HostError]
    fn cpu_count(self) -> Result[u32, HostError]

## The deterministic Sys provider: every read answers from a map.
## See [std-host.sys.map.decl](../../spec/std/host.md#r-std-host.sys.map.decl).
pub struct ScriptedSys:
    values: Map[string, string]

impl ScriptedSys:
    ## Returns the provider whose methods read the value of the key that is the method's name.
    ## See [std-host.sys.map.new](../../spec/std/host.md#r-std-host.sys.map.new).
    pub fn new(values: Map[string, string]) -> ScriptedSys:
        ScriptedSys { values: values }

impl Sys for ScriptedSys:
    fn os(self) -> Result[string, HostError]:
        match self.values.get("os"):
            .Some(text) => .Ok(text)
            .None => .Err(HostError.Unsupported("os"))

    fn arch(self) -> Result[string, HostError]:
        match self.values.get("arch"):
            .Some(text) => .Ok(text)
            .None => .Err(HostError.Unsupported("arch"))

    fn hostname(self) -> Result[string, HostError]:
        match self.values.get("hostname"):
            .Some(text) => .Ok(text)
            .None => .Err(HostError.Unsupported("hostname"))

    fn cpu_count(self) -> Result[u32, HostError]:
        match self.values.get("cpu_count"):
            .Some(text) =>
                match text.parse::[u32]():
                    .Ok(count) => .Ok(count)
                    .Err(_) => .Err(HostError.Unsupported("cpu_count"))
            .None => .Err(HostError.Unsupported("cpu_count"))

# The host wire format (spec/lang/10-modules.md#r-module.boundary.serialize.exact,
# #r-module.boundary.deserialize.exact). A data type with a field that is not
# `pub` crosses a runtime profile's host boundary as the text these write and
# read; the compiler calls them at each such type, like any other call. A
# profile's own host reads that text as JSON; a package host reads a flat typed
# token stream of it, which keeps integer and float kinds apart and does not
# multiply nesting depth. A value that does not deserialize is the
# `host-contract` panic the caller sees. These stay last so they change no
# existing item ID.
use std.json.{Json, JsonError, JsonObject, Number, to_json, from_json, encode, decode}
use std.serde.Serialize

@intrinsic("panic")
fn contract_panic(category: string, message: string) -> never:
    panic("intrinsic")

fn host_encode[T < Serialize](value: T) -> string:
    encode(value)

fn host_decode[T < Deserialize](text: string) -> T:
    match decode::[T](text):
        .Ok(value) => value
        .Err(_) => contract_panic("host-contract", "a host boundary value does not deserialize")

fn package_encode[T < Serialize](value: T) -> string:
    let mut pending: List[Json] = [to_json(value)]
    let mut tokens: List[Json] = []
    while !pending.is_empty():
        item := pending.pop().expect("pending value")
        match item:
            .Null => tokens.push(.Array([.Text("n")]))
            .Bool(value) => tokens.push(.Array([.Text("b"), .Bool(value)]))
            .Text(value) => tokens.push(.Array([.Text("s"), .Text(value)]))
            .Number(value) =>
                match value.as_i64():
                    .Some(integer) => tokens.push(.Array([.Text("i"), .Text("$integer")]))
                    .None =>
                        match value.as_u64():
                            .Some(integer) => tokens.push(.Array([.Text("u"), .Text("$integer")]))
                            .None =>
                                bits := value.as_f64().expect("number").to_bits()
                                let text = bits.to_radix(16)
                                while text.len() < 16:
                                    text = "0" + text
                                tokens.push(.Array([.Text("f"), .Text(text)]))
            .Array(items) =>
                tokens.push(.Array([.Text("a"), .Number(Number::from_u64(u64(items.len())))]))
                let at = items.len()
                while at > 0:
                    at = at - 1
                    pending.push(items[at])
            .Object(fields) =>
                tokens.push(.Array([.Text("o"), .Number(Number::from_u64(u64(fields.len())))]))
                keys := fields.keys()
                let at = keys.len()
                while at > 0:
                    at = at - 1
                    key := keys[at]
                    pending.push(fields.get(key).expect("object key"))
                    pending.push(.Text(key))
    encode(tokens)

fn package_decode[T < Deserialize](text: string) -> T:
    match package_read::[T](text):
        .Ok(value) => value
        .Err(_) => contract_panic("host-contract", "a host boundary value does not deserialize")

fn package_error() -> JsonError:
    .WrongType(path="$", expected="a package host value")

fn package_read[T < Deserialize](text: string) -> Result[T, JsonError]:
    tokens := decode::[List[Json]](text)?
    let mut values: List[Json] = []
    let at = tokens.len()
    while at > 0:
        at = at - 1
        token := tokens[at]
        tag := token.at(0).and_then(fn(v): v.as_text()).ok_or(package_error())?
        match token:
            .Array(items) =>
                expected := if tag == "n": 1 else: 2
                if items.len() != expected:
                    return .Err(package_error())
            _ => return .Err(package_error())
        match tag:
            "n" => values.push(.Null)
            "b" =>
                value := token.at(1).and_then(fn(v): v.as_bool()).ok_or(package_error())?
                values.push(.Bool(value))
            "s" =>
                value := token.at(1).and_then(fn(v): v.as_text()).ok_or(package_error())?
                values.push(.Text(value))
            "i" =>
                value := token.at(1).and_then(fn(v): v.as_text()).ok_or(package_error())?
                number := value.parse::[i64]().map_err(fn(_error): package_error())?
                values.push(.Number(Number::from_i64(number)))
            "u" =>
                value := token.at(1).and_then(fn(v): v.as_text()).ok_or(package_error())?
                number := value.parse::[u64]().map_err(fn(_error): package_error())?
                values.push(.Number(Number::from_u64(number)))
            "f" =>
                value := token.at(1).and_then(fn(v): v.as_text()).ok_or(package_error())?
                if value.len() != 16:
                    return .Err(package_error())
                bits := u64::parse_radix(value, 16).map_err(fn(_error): package_error())?
                number := Number::from_f64(f64::from_bits(bits)).ok_or(package_error())?
                values.push(.Number(number))
            "a" =>
                count := token.at(1).and_then(fn(v): v.as_u64()).ok_or(package_error())?
                if count > u64(values.len()):
                    return .Err(package_error())
                let mut items: List[Json] = []
                let left = count
                while left > 0:
                    items.push(values.pop().ok_or(package_error())?)
                    left = left - 1
                values.push(.Array(items))
            "o" =>
                count := token.at(1).and_then(fn(v): v.as_u64()).ok_or(package_error())?
                if count > u64(values.len() / 2):
                    return .Err(package_error())
                let mut fields = JsonObject::new()
                let left = count
                while left > 0:
                    key := values.pop().and_then(fn(v): v.as_text()).ok_or(package_error())?
                    value := values.pop().ok_or(package_error())?
                    if fields.contains_key(key):
                        return .Err(package_error())
                    fields.set(key, value)
                    left = left - 1
                values.push(.Object(fields))
            _ => return .Err(package_error())
    if values.len() != 1:
        return .Err(package_error())
    from_json::[T](values.pop().ok_or(package_error())?)
