# std.testing.arbitrary: the one fact that derived `Arbitrary` reads
# (spec/std/testing.md#derived-arbitrary). The prototype has no std
# submodules, so this is `std.arbitrary`, which code does not import by that
# name: `use std.testing.arbitrary` makes each `arbitrary.with(gen)` a call of
# `with` under its hidden name (checker/arbitrary-module.ts). The template of
# `Arbitrary` in `std.testing` reads a member's `With[F]` through its handle.
use std.annotation.annotate
use std.testing.Choices

# A typed fact type (r-std-testing.arbitrary.with.module-typed): on a member
# of type `X`, `arbitrary.with(gen)` checks like
# `let f: With[X] = with(gen)`, so `gen` must draw `X`
# (r-std-testing.arbitrary.with.checked).
@annotate::[F](.Field)
pub data With[F]:
    pub gen: fn(mut Choices) -> F

pub fn with[F](gen: fn(mut Choices) -> F) -> With[F]:
    With::[F] { gen: gen }
