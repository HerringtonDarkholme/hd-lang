    type Error = TryFromIntError

    fn try_from(value: i16) -> Result[i8, TryFromIntError]:
        if value < i16(i8::min_value()) || value > i16(i8::max_value()):
            return .Err(TryFromIntError {})
        .Ok(i8(value))

