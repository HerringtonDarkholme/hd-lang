# std.net, the part written in hd (spec/std/net.md): the host capability
# trait Net, its error, the socket handle traits, Datagram, and the
# deterministic providers ScriptedNet, ScriptedStream, ScriptedListener,
# and ScriptedUdp. Sockets are traits, so declaring them is plain hd; a
# live socket provider that opens real connections is host-bound.
use std.convert.From
use std.task.TimedOut
use std.format.DebugWriter
use std.ops.Disposable
use std.time.Duration

## Every failure of a lookup or a socket, as one error enum.
## See [std-net.error.decl](../../spec/std/net.md#net-errors).
@error
@derive(Debug, Eq)
pub enum NetError:
    @error("net access to ${address} is not granted")
    NotGranted(address: string)
    @error("invalid net address: ${address}")
    InvalidAddress(address: string)
    @error("net lookup of ${host} failed")
    Dns(host: string)
    @error("net connection to ${address} refused")
    Refused(address: string)
    @error("the net operation timed out")
    Timeout
    @error("the socket is closed")
    Closed
    @error("$message")
    Other(message: string)

# A socket is a handle behind a trait value reference, `&mut dyn
# TcpStream` (r-std-net.handles.decl-ref): each copy of the reference
# reaches the one socket.
# A composed deadline has the same error as the operation it bounds.
impl From[TimedOut] for NetError:
    fn from(error: TimedOut) -> NetError:
        .Timeout

## The host capability trait: DNS lookup, TCP, and UDP.
## See [std-net.trait.decl-composed](../../spec/std/net.md#r-std-net.trait.decl-composed).
pub trait Net:
    fn lookup!(&mut self, host: string) -> Result[List[string], NetError]
    fn connect!(&mut self, host: string, port: u16) -> Result[&mut dyn TcpStream, NetError]
    fn listen!(&mut self, host: string, port: u16) -> Result[&mut dyn TcpListener, NetError]
    fn bind_udp!(&mut self, host: string, port: u16) -> Result[&mut dyn UdpSocket, NetError]

## Resolves `host` through the covering `Net` provider.
## See [std-net.helper.lookup.decl](../../spec/std/net.md#r-std-net.helper.lookup.decl).
pub fn lookup!(host: string) -> Result[List[string], NetError] $ Net:
    $.use(Net).lookup!(host)

## Connects through the covering `Net` provider.
## See [std-net.helper.connect.decl](../../spec/std/net.md#r-std-net.helper.connect.decl).
pub fn connect!(host: string, port: u16) -> Result[&mut dyn TcpStream, NetError] $ Net:
    $.use(Net).connect!(host, port)

## Listens through the covering `Net` provider.
## See [std-net.helper.listen.decl](../../spec/std/net.md#r-std-net.helper.listen.decl).
pub fn listen!(host: string, port: u16) -> Result[&mut dyn TcpListener, NetError] $ Net:
    $.use(Net).listen!(host, port)

## Binds a UDP socket through the covering `Net` provider.
## See [std-net.helper.bind-udp.decl](../../spec/std/net.md#r-std-net.helper.bind-udp.decl).
pub fn bind_udp!(host: string, port: u16) -> Result[&mut dyn UdpSocket, NetError] $ Net:
    $.use(Net).bind_udp!(host, port)

## A TCP stream: a closable handle that a `using` binding disposes.
## See [std-net.handles.decl-ref](../../spec/std/net.md#r-std-net.handles.decl-ref).
pub trait TcpStream < Disposable:
    fn read!(&mut self, max: usize) -> Result[List[u8], NetError]
    fn write!(&mut self, bytes: List[u8]) -> Result[void, NetError]
    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]
    fn set_nodelay(&mut self, enabled: bool) -> Result[void, NetError]
    fn set_keepalive(&mut self, idle: Duration?) -> Result[void, NetError]
    fn close(&mut self) -> Result[void, NetError]

## A TCP listener: a closable handle that a `using` binding disposes.
## See [std-net.handles.decl-ref](../../spec/std/net.md#r-std-net.handles.decl-ref).
pub trait TcpListener < Disposable:
    fn accept!(&mut self) -> Result[&mut dyn TcpStream, NetError]
    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]
    fn local_address(self) -> Result[(string, u16), NetError]
    fn close(&mut self) -> Result[void, NetError]

## One UDP datagram with its sender.
## See [std-net.handles.decl-ref](../../spec/std/net.md#r-std-net.handles.decl-ref).
@derive(Debug, Eq)
pub struct Datagram:
    pub bytes: List[u8]
    pub host: string
    pub port: u16

## A UDP socket: a closable handle that a `using` binding disposes.
## See [std-net.handles.decl-ref](../../spec/std/net.md#r-std-net.handles.decl-ref).
pub trait UdpSocket < Disposable:
    fn send_to!(&mut self, host: string, port: u16, bytes: List[u8]) -> Result[void, NetError]
    fn receive!(&mut self, max: usize) -> Result[Datagram, NetError]
    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]
    fn local_address(self) -> Result[(string, u16), NetError]
    fn close(&mut self) -> Result[void, NetError]

# The deterministic providers (spec/std/net.md#scripted-net). Every
# handle is a new object behind `&mut`, so the handle that ScriptedNet hands
# to the code under test is the one the test holds and checks. A scripted call never
# waits: past the end of its script it fails at once with a message that
# names what ran out.

## A scripted TCP stream: it returns its chunks in order and records what is written.
## See [std-net.scripted.decl](../../spec/std/net.md#r-std-net.scripted.decl).
pub struct ScriptedStream:
    reads: List[List[u8]]
    next: usize
    offset: usize
    ended: bool
    error: NetError?
    failed: bool
    bytes: List[u8]
    bound: Duration?
    nodelay_on: bool
    keepalive_idle: Duration?
    closed: bool

impl ScriptedStream:
    ## Returns a stream that returns the chunks of `reads` in order, one per `read!`.
    ## See [std-net.scripted.new-ref](../../spec/std/net.md#r-std-net.scripted.new-ref).
    pub fn new(reads: List[List[u8]]) -> &mut ScriptedStream:
        &mut ScriptedStream { reads: reads, next: 0, offset: 0, ended: false, error: .None, failed: false, bytes: [], bound: .None, nodelay_on: false, keepalive_idle: .None, closed: false }

    ## Returns a stream that returns the chunks of `reads`, then fails every `read!` and `write!` with `error`.
    ## See [std-net.scripted.failing](../../spec/std/net.md#r-std-net.scripted.failing).
    pub fn failing(reads: List[List[u8]], error: NetError) -> &mut ScriptedStream:
        &mut ScriptedStream { reads: reads, next: 0, offset: 0, ended: false, error: .Some(error), failed: false, bytes: [], bound: .None, nodelay_on: false, keepalive_idle: .None, closed: false }

    ## Every byte written to the stream, in order.
    ## See [std-net.scripted.write](../../spec/std/net.md#r-std-net.scripted.write).
    pub fn written(&self) -> List[u8]:
        self.bytes

    ## The timeout that `set_timeout` stored last, or `.None` before any call.
    ## See [std-net.scripted.timeout](../../spec/std/net.md#r-std-net.scripted.timeout).
    pub fn timeout(&self) -> Duration?:
        self.bound

    ## Whether `set_nodelay` last turned nodelay on; `false` before any call.
    ## See [std-net.scripted.options](../../spec/std/net.md#r-std-net.scripted.options).
    pub fn nodelay(&self) -> bool:
        self.nodelay_on

    ## The idle time `set_keepalive` stored last, or `.None` before any call or after `.None`.
    ## See [std-net.scripted.options](../../spec/std/net.md#r-std-net.scripted.options).
    pub fn keepalive(&self) -> Duration?:
        self.keepalive_idle

    ## Whether the stream is closed.
    ## See [std-net.scripted.closed-error](../../spec/std/net.md#r-std-net.scripted.closed-error).
    pub fn is_closed(&self) -> bool:
        self.closed

impl TcpStream for ScriptedStream:
    # The front chunk, split at `max`; an empty chunk ends the stream for
    # good (r-std-net.scripted.read-max, r-std-net.scripted.eof).
    fn read!(&mut self, max: usize) -> Result[List[u8], NetError]:
        if self.closed:
            return .Err(.Closed)
        if self.ended:
            return .Ok([])
        if self.next < self.reads.len():
            chunk := self.reads[self.next]
            if chunk.is_empty():
                self.ended = true
                return .Ok([])
            let mut out: List[u8] = []
            while self.offset < chunk.len() && out.len() < max:
                out.push(chunk[self.offset])
                self.offset = self.offset + 1
            if self.offset == chunk.len():
                self.next = self.next + 1
                self.offset = 0
            return .Ok(out)
        match self.error:
            .Some(error) =>
                self.failed = true
                .Err(error)
            .None => .Err(.Other("ScriptedStream has no more reads"))

    fn write!(&mut self, bytes: List[u8]) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        if self.failed:
            match self.error:
                .Some(error) => return .Err(error)
                .None => pass
        for byte in bytes:
            self.bytes.push(byte)
        .Ok(())

    # A scripted call never waits, so the bound is only stored
    # (r-std-net.scripted.timeout).
    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.bound = timeout
        .Ok(())

    # Like a timeout, an option is only stored (r-std-net.scripted.options).
    fn set_nodelay(&mut self, enabled: bool) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.nodelay_on = enabled
        .Ok(())

    fn set_keepalive(&mut self, idle: Duration?) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.keepalive_idle = idle
        .Ok(())

    fn close(&mut self) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.closed = true
        .Ok(())

# Disposing closes the handle; it is best-effort, so a closed one stays
# closed (r-std-net.scripted.dispose).
impl Disposable for ScriptedStream:
    fn dispose!(&mut self) -> void:
        self.closed = true

## A scripted TCP listener: it accepts its streams in order.
## See [std-net.scripted.decl](../../spec/std/net.md#r-std-net.scripted.decl).
pub struct ScriptedListener:
    connections: List[&mut ScriptedStream]
    next: usize
    error: NetError?
    bound: Duration?
    address: (string, u16)?
    closed: bool

impl ScriptedListener:
    ## Returns a listener that accepts the streams of `connections` in order.
    ## See [std-net.scripted.new-ref](../../spec/std/net.md#r-std-net.scripted.new-ref).
    pub fn new(connections: List[&mut ScriptedStream]) -> &mut ScriptedListener:
        &mut ScriptedListener { connections: connections, next: 0, error: .None, bound: .None, address: .None, closed: false }

    ## Returns a listener that accepts the streams of `connections`, then fails every `accept!` with `error`.
    ## A test scripts an `accept!` that times out with `NetError.Timeout`.
    pub fn failing(connections: List[&mut ScriptedStream], error: NetError) -> &mut ScriptedListener:
        &mut ScriptedListener { connections: connections, next: 0, error: .Some(error), bound: .None, address: .None, closed: false }

    ## The timeout that `set_timeout` stored last, or `.None` before any call.
    ## See [std-net.scripted.timeout](../../spec/std/net.md#r-std-net.scripted.timeout).
    pub fn timeout(&self) -> Duration?:
        self.bound

    ## Makes `local_address()` return `.Ok((host, port))`.
    ## See [std-net.scripted.local-address](../../spec/std/net.md#r-std-net.scripted.local-address).
    pub fn set_local_address(&mut self, host: string, port: u16) -> void:
        self.address = .Some((host, port))

    ## Whether the listener is closed.
    ## See [std-net.scripted.closed-error](../../spec/std/net.md#r-std-net.scripted.closed-error).
    pub fn is_closed(&self) -> bool:
        self.closed

impl TcpListener for ScriptedListener:
    fn accept!(&mut self) -> Result[&mut dyn TcpStream, NetError]:
        if self.closed:
            return .Err(.Closed)
        if self.next >= self.connections.len():
            return match self.error:
                .Some(error) => .Err(error)
                .None => .Err(.Other("ScriptedListener has no more connections"))
        stream := self.connections[self.next]
        self.next = self.next + 1
        .Ok(stream)

    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.bound = timeout
        .Ok(())

    fn local_address(self) -> Result[(string, u16), NetError]:
        if self.closed:
            return .Err(.Closed)
        match self.address:
            .Some(address) => .Ok(address)
            .None => .Err(.Other("ScriptedListener has no local address"))

    fn close(&mut self) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.closed = true
        .Ok(())

# Disposing closes the handle; it is best-effort, so a closed one stays
# closed (r-std-net.scripted.dispose).
impl Disposable for ScriptedListener:
    fn dispose!(&mut self) -> void:
        self.closed = true

## A scripted UDP socket: it receives its datagrams in order and records what is sent.
## See [std-net.scripted.decl](../../spec/std/net.md#r-std-net.scripted.decl).
pub struct ScriptedUdp:
    incoming: List[Datagram]
    next: usize
    error: NetError?
    outgoing: List[Datagram]
    bound: Duration?
    address: (string, u16)?
    closed: bool

impl ScriptedUdp:
    ## Returns a socket that receives the datagrams of `incoming` in order.
    ## See [std-net.scripted.new-ref](../../spec/std/net.md#r-std-net.scripted.new-ref).
    pub fn new(incoming: List[Datagram]) -> &mut ScriptedUdp:
        &mut ScriptedUdp { incoming: incoming, next: 0, error: .None, outgoing: [], bound: .None, address: .None, closed: false }

    ## Returns a socket that receives the datagrams of `incoming`, then fails every `receive!` with `error`; `send_to!` still works.
    ## A test scripts a `receive!` that times out with `NetError.Timeout`.
    pub fn failing(incoming: List[Datagram], error: NetError) -> &mut ScriptedUdp:
        &mut ScriptedUdp { incoming: incoming, next: 0, error: .Some(error), outgoing: [], bound: .None, address: .None, closed: false }

    ## The timeout that `set_timeout` stored last, or `.None` before any call.
    ## See [std-net.scripted.timeout](../../spec/std/net.md#r-std-net.scripted.timeout).
    pub fn timeout(&self) -> Duration?:
        self.bound

    ## Makes `local_address()` return `.Ok((host, port))`.
    ## See [std-net.scripted.local-address](../../spec/std/net.md#r-std-net.scripted.local-address).
    pub fn set_local_address(&mut self, host: string, port: u16) -> void:
        self.address = .Some((host, port))

    ## Every datagram sent, with its destination, in order.
    ## See [std-net.scripted.udp](../../spec/std/net.md#r-std-net.scripted.udp).
    pub fn sent(&self) -> List[Datagram]:
        self.outgoing

    ## Whether the socket is closed.
    ## See [std-net.scripted.closed-error](../../spec/std/net.md#r-std-net.scripted.closed-error).
    pub fn is_closed(&self) -> bool:
        self.closed

impl UdpSocket for ScriptedUdp:
    fn send_to!(&mut self, host: string, port: u16, bytes: List[u8]) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.outgoing.push(Datagram { bytes: bytes, host: host, port: port })
        .Ok(())

    fn receive!(&mut self, max: usize) -> Result[Datagram, NetError]:
        if self.closed:
            return .Err(.Closed)
        if self.next >= self.incoming.len():
            return match self.error:
                .Some(error) => .Err(error)
                .None => .Err(.Other("ScriptedUdp has no more datagrams"))
        datagram := self.incoming[self.next]
        self.next = self.next + 1
        .Ok(Datagram { bytes: datagram.bytes.take(max), host: datagram.host, port: datagram.port })

    fn set_timeout(&mut self, timeout: Duration?) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.bound = timeout
        .Ok(())

    fn local_address(self) -> Result[(string, u16), NetError]:
        if self.closed:
            return .Err(.Closed)
        match self.address:
            .Some(address) => .Ok(address)
            .None => .Err(.Other("ScriptedUdp has no local address"))

    fn close(&mut self) -> Result[void, NetError]:
        if self.closed:
            return .Err(.Closed)
        self.closed = true
        .Ok(())

# Disposing closes the handle; it is best-effort, so a closed one stays
# closed (r-std-net.scripted.dispose).
impl Disposable for ScriptedUdp:
    fn dispose!(&mut self) -> void:
        self.closed = true

# One entry of a connect queue: a stream to return or an error.
enum ScriptedConnection:
    Stream(stream: &mut ScriptedStream)
    Failure(error: NetError)

## The deterministic `Net` provider: it answers from what the test added, records every call, and opens no socket.
## See [std-net.scripted.decl](../../spec/std/net.md#r-std-net.scripted.decl).
pub struct ScriptedNet:
    hosts: Map[string, List[string]]
    connections: Map[string, List[ScriptedConnection]]
    listeners: Map[string, List[&mut ScriptedListener]]
    sockets: Map[string, List[&mut ScriptedUdp]]
    calls: List[string]

impl ScriptedNet:
    ## Returns a provider with nothing scripted.
    ## See [std-net.scripted.new-ref](../../spec/std/net.md#r-std-net.scripted.new-ref).
    pub fn new() -> &mut ScriptedNet:
        &mut ScriptedNet { hosts: {}, connections: {}, listeners: {}, sockets: {}, calls: [] }

    ## Answers each `lookup!(host)` with `addresses`.
    ## See [std-net.scripted.setup-ref](../../spec/std/net.md#r-std-net.scripted.setup-ref).
    pub fn add_host(&mut self, host: string, addresses: List[string]) -> void:
        self.hosts[host] = addresses

    ## Queues `stream` for one `connect!` of `address` (`host:port`).
    ## See [std-net.scripted.setup-ref](../../spec/std/net.md#r-std-net.scripted.setup-ref).
    pub fn add_connection(&mut self, address: string, stream: &mut ScriptedStream) -> void:
        self.queue_connection(address, .Stream(stream))

    ## Queues `error` for one `connect!` of `address` (`host:port`).
    ## See [std-net.scripted.setup-ref](../../spec/std/net.md#r-std-net.scripted.setup-ref).
    pub fn fail_connection(&mut self, address: string, error: NetError) -> void:
        self.queue_connection(address, .Failure(error))

    ## Queues `listener` for one `listen!` of `address` (`host:port`).
    ## See [std-net.scripted.setup-ref](../../spec/std/net.md#r-std-net.scripted.setup-ref).
    pub fn add_listener(&mut self, address: string, listener: &mut ScriptedListener) -> void:
        match self.listeners.get(address):
            .Some(_) => self.listeners[address].push(listener)
            .None => self.listeners[address] = [listener]

    ## Queues `socket` for one `bind_udp!` of `address` (`host:port`).
    ## See [std-net.scripted.setup-ref](../../spec/std/net.md#r-std-net.scripted.setup-ref).
    pub fn add_udp(&mut self, address: string, socket: &mut ScriptedUdp) -> void:
        match self.sockets.get(address):
            .Some(_) => self.sockets[address].push(socket)
            .None => self.sockets[address] = [socket]

    ## The address of every call, in order, the failed ones included; a lookup records the host alone.
    ## See [std-net.scripted.received-connect](../../spec/std/net.md#r-std-net.scripted.received-connect).
    pub fn received(&self) -> List[string]:
        self.calls

    # One connect of `host:port`: it records the address and takes the next
    # entry of the address's queue (r-std-net.scripted.queue).
    fn take_connection(&mut self, host: string, port: u16) -> Result[&mut dyn TcpStream, NetError]:
        address := "${host}:${port}"
        self.calls.push(address)
        match self.connections.get(address):
            .Some(queue) if !queue.is_empty() =>
                match self.connections[address].remove_at(0):
                    .Stream(stream) => .Ok(stream)
                    .Failure(error) => .Err(error)
            _ => .Err(.Refused(address))

    fn queue_connection(&mut self, address: string, entry: ScriptedConnection) -> void:
        match self.connections.get(address):
            .Some(_) => self.connections[address].push(entry)
            .None => self.connections[address] = [entry]

impl Net for ScriptedNet:
    fn lookup!(&mut self, host: string) -> Result[List[string], NetError]:
        self.calls.push(host)
        match self.hosts.get(host):
            .Some(addresses) => .Ok(addresses)
            .None => .Err(.Dns(host))

    fn connect!(&mut self, host: string, port: u16) -> Result[&mut dyn TcpStream, NetError]:
        self.take_connection(host, port)

    fn listen!(&mut self, host: string, port: u16) -> Result[&mut dyn TcpListener, NetError]:
        address := "${host}:${port}"
        self.calls.push(address)
        match self.listeners.get(address):
            .Some(queue) if !queue.is_empty() => .Ok(self.listeners[address].remove_at(0))
            _ => .Err(.Refused(address))

    fn bind_udp!(&mut self, host: string, port: u16) -> Result[&mut dyn UdpSocket, NetError]:
        address := "${host}:${port}"
        self.calls.push(address)
        match self.sockets.get(address):
            .Some(queue) if !queue.is_empty() => .Ok(self.sockets[address].remove_at(0))
            _ => .Err(.Refused(address))

# Keep handwritten Debug: label bytes as written and omit pending read state.
impl Debug for ScriptedStream:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("ScriptedStream").field("reads", self.reads).field("written", self.bytes).field("closed", self.closed).finish()

# Keep handwritten Debug: omit consumed-connection bookkeeping.
impl Debug for ScriptedListener:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("ScriptedListener").field("connections", self.connections).field("closed", self.closed).finish()

# Keep handwritten Debug: label outgoing as sent and omit read bookkeeping.
impl Debug for ScriptedUdp:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("ScriptedUdp").field("incoming", self.incoming).field("sent", self.outgoing).field("closed", self.closed).finish()

# Keep handwritten Debug: keep positional payloads instead of declared named fields.
impl Debug for ScriptedConnection:
    fn debug(self, out: &mut DebugWriter) -> void:
        match self:
            .Stream(stream) => out.debug_tuple("ScriptedConnection.Stream").field(stream).finish()
            .Failure(error) => out.debug_tuple("ScriptedConnection.Failure").field(error).finish()

# Keep handwritten Debug: label calls as requested and omit internal cursors.
impl Debug for ScriptedNet:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.debug_struct("ScriptedNet").field("hosts", self.hosts).field("connections", self.connections).field("listeners", self.listeners).field("sockets", self.sockets).field("requested", self.calls).finish()
