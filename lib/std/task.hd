# std.task, the part written in hd (spec/std/task.md). The `Suspend`
# protocol, `block_on`, `all!`, and `race!` are compiler intrinsics
# (spec/lang/11-requirements-and-suspension.md#standard-combinators). The
# compiler provides `all!` and `Waker` by name; `all!` has no written
# signature (r-req.combinator.all-typing).
use std.task.all
use std.error.Error
use std.convert.From
use std.ops.Disposable
use std.time.{Clock, Duration, Instant, sleep}

## A configuration that wraps work and declares the resulting type.
## See [std-task.layer.decl](../../spec/std/task.md#r-std-task.layer.decl).
pub trait Layer[W]:
    type Wrapped
    fn wrap(self, work: W) -> Self::Wrapped

impl[W] Layer[W] for ():
    type Wrapped = W
    fn wrap(self, work: W) -> W:
        work

impl[W, I < Layer[W], O < Layer[I::Wrapped]] Layer[W] for (I, O):
    type Wrapped = O::Wrapped
    fn wrap(self, work: W) -> O::Wrapped:
        self._1.wrap(self._0.wrap(work))

## Wraps work with a policy and invokes the returned function once.
## See [std-task.apply.decl](../../spec/std/task.md#r-std-task.apply.decl).
pub fn apply![T, U, $ R, $ S, P < Layer[fn!() -> T $ R, Wrapped = fn!() -> U $ S]](
    policy: P,
    work: fn!() -> T $ R,
) -> U $ S:
    wrapped := policy.wrap(work)
    wrapped!()

# The first child to complete wins, and the others are cancelled
# (r-req.combinator.race-losers-disposed). Its plain signature types every call
# (r-req.combinator.race-signature). The prototype writes the call in hd:
# it drives the frame that `race_frame` builds, whose polling body is the
# compiler's.
## Drives the tasks together and returns the first one's value; the losers are cancelled. A compiler intrinsic.
## See [req.combinator.race-signature](../../spec/lang/11-requirements-and-suspension.md#r-req.combinator.race-signature).
pub fn race![T](tasks...: List[mut Suspend[T]]) -> T:
    let frame: mut Suspend[T] = race_frame(tasks)
    frame!()

# How a `block_on` drive ended (spec/std/task.md#block-on).
## How a `block_on` drive ended: `Completed` with the suspension's value, or `Cancelled` or `Abandoned` when the suspension was cancelled and its cleanup ran to its end or was cut short.
## See [std-task.block-on.decl](../../spec/std/task.md#r-std-task.block-on.decl).
pub enum BlockOn[T]:
    Completed(T)
    Cancelled
    Abandoned

# The synchronous driver (r-req.drive.block-on.signature). The compiler
# supplies the body: it polls `s` and waits in the host while `s` is
# pending. A cancelled `s` is driven on until its cleanup has ended
# (r-req.drive.block-on.cancelled).
## Drives `s` from code that does not suspend, and returns how the drive ended. A compiler intrinsic.
## See [req.drive.block-on.signature](../../spec/lang/11-requirements-and-suspension.md#r-req.drive.block-on.signature).
@intrinsic("block_on")
pub fn block_on[T](s: mut Suspend[T]) -> BlockOn[T]:
    panic("intrinsic")

# How a job's cleanup ended (spec/std/task.md#cleanup-end). A kept
# `.Abandoned` comes from the job's frame.
## How a job's cleanup ended: `Finished` when it ran to its end, `Abandoned` when a part of it was cut short.
## See [std-task.cleanup-end.decl](../../spec/std/task.md#r-std-task.cleanup-end.decl).
@derive(Debug, Eq)
pub enum CleanupEnd:
    Finished
    Abandoned

# The `Suspend[T]` protocol's `cancel!` (r-req.cancel.bang). The job's
# frame holds its one cleanup; each call waits on it through a cleanup
# frame, whose polling body is the compiler's, so any number of calls
# share the cleanup and none restarts it (r-req.cancel.shared).
impl[T] Suspend[T]:
    ## Stops the job, waits until its cleanup has ended, and returns how it ended.
    ## See [req.cancel.bang](../../spec/lang/11-requirements-and-suspension.md#r-req.cancel.bang).
    pub fn cancel!(mut self) -> CleanupEnd:
        let cleanup: mut Suspend[bool] = cleanup_frame(self)
        if cleanup!(): .Abandoned else: .Finished

    ## Stops the job and unwinds it at once: its `defer` blocks run, and each `dispose!` is cut short at its suspension point.
    ## See [req.abandon.unwind](../../spec/lang/11-requirements-and-suspension.md#r-req.abandon.unwind).
    pub fn abandon(mut self) -> void:
        abandon_task(self)

# The cleanup frame of `cancel!`. Each poll starts the task's cleanup or
# continues it, and the frame completes once the task no longer unwinds:
# at once for a cold task, which is only marked cancelled, and for a
# completed or cancelled one. It completes with whether the cleanup was
# cut short (r-req.abandon.result). Cancelling the frame continues the
# cleanup too, so a cancelled waiter folds it into its own
# (r-req.cancel.nested).
@intrinsic("task_cleanup_frame")
fn cleanup_frame[T](task: mut Suspend[T]) -> mut Suspend[bool]:
    panic("intrinsic")

# `abandon()`: runs the task's own cancel synchronously, in a mode in
# which every waiting `dispose!` it reaches is killed at its suspension
# point instead of waited for (r-req.abandon.unwind). The compiler
# supplies the body.
@intrinsic("task_abandon")
fn abandon_task[T](task: mut Suspend[T]) -> void:
    panic("intrinsic")

# The polling frame of `race!`. Each poll polls the unfinished tasks in
# order. The first to complete is the result, and the frame then cancels
# every other task, in order, before it completes. Cancelling the frame
# cancels every task (r-req.combinator.cancel-children).
@intrinsic("task_race_frame")
fn race_frame[T](tasks: List[mut Suspend[T]]) -> mut Suspend[T]:
    panic("intrinsic")

# The homogeneous list frame. It keeps each result at its child's index
# and visits the waker tree's ready set, without a nested all! per child.
# The fixed-arity all! expression has a separate tuple lowering.
@intrinsic("task_all_frame")
fn all_frame[T](tasks: List[mut Suspend[T]]) -> mut Suspend[List[T]]:
    panic("intrinsic")

# The private flat engine of map_all!. Calling a worker without ! keeps
# it cold until the frame polls it, in list order.
fn all_list![T, $ R](tasks: List[fn!() -> T $ R]) -> List[T] $ R:
    let mut pending: List[mut Suspend[T]] = []
    for task in tasks:
        pending.push(task())
    let frame: mut Suspend[List[T]] = all_frame(pending)
    frame!()

# Whether `result` is an `.Err` that `when` accepts.
fn should_retry[T, E](result: Result[T, E], when: fn(E) -> bool) -> bool:
    match result:
        .Ok(_) => false
        .Err(error) => when(error)

## How many times to try, how long to wait, and the wait's cap.
## See [std-task.backoff.decl.defaults](../../spec/std/task.md#r-std-task.backoff.decl.defaults).
@derive(Eq)
pub struct Backoff:
    pub attempts: usize = 3
    pub initial: Duration = 100ms
    pub factor: u32 = 2
    pub max: Duration = 10s

## Retries with the policy's delays until success, a rejected error, or the final attempt.
## See [std-task.policy.retry.layer](../../spec/std/task.md#r-std-task.policy.retry.layer).
fn retry_work![T, E, $ R](
    policy: Backoff,
    when: fn(E) -> bool = fn(error: E): true,
    attempt: fn!() -> Result[T, E] $ R,
) -> Result[T, E] $ R + Clock:
    let result = attempt!()
    let tries: usize = 1
    let delay = if policy.initial > policy.max: policy.max else: policy.initial
    while tries < policy.attempts && should_retry(result, when):
        clock := $.use(Clock)
        clock.sleep!(delay)
        result = attempt!()
        tries = tries + 1
        factor := i64(policy.factor)
        cap := policy.max.as_milliseconds()
        millis := delay.as_milliseconds()
        # Check the cap before multiplying, including a factor of zero.
        delay = if factor != 0 && millis > cap / factor:
            policy.max
        else:
            Duration::milliseconds(millis * factor)
    result

# The error of `timeout!` when the limit passes first, with how the work's
# cleanup ended (spec/std/task.md#timeout).
## The error when a TimeLimit deadline wins; cleanup says how the work’s cleanup ended.
## See [std-task.timeout.fields-value](../../spec/std/task.md#r-std-task.timeout.fields-value).
@derive(Debug, Eq)
pub struct TimedOut:
    pub limit: Duration
    pub cleanup: CleanupEnd

## Converts a timeout to itself without changing its limit or cleanup outcome.
## See [std-task.policy.timed-out.from-self](../../spec/std/task.md#r-std-task.policy.timed-out.from-self).
impl From[TimedOut] for TimedOut:
    fn from(value: TimedOut) -> TimedOut:
        value

## A deadline configuration; wrapping Result work adds Clock and converts TimedOut into its error type.
## See [std-task.policy.time-limit.decl](../../spec/std/task.md#r-std-task.policy.time-limit.decl).
pub struct TimeLimit:
    limit: Duration
    cleanup: Duration? = .None

## See [std-task.policy.time-limit.layer](../../spec/std/task.md#r-std-task.policy.time-limit.layer).
impl[T, E < From[TimedOut], $ R] Layer[fn!() -> Result[T, E] $ R] for TimeLimit:
    type Wrapped = fn!() -> Result[T, E] $ R + Clock
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
        fn!() -> Result[T, E] $ R + Clock:
            timeout_result!(self.limit, cleanup=self.cleanup, work=work)

## A retry configuration whose error type is selected when work is applied.
## See [std-task.policy.retry.decl](../../spec/std/task.md#r-std-task.policy.retry.decl).
pub struct Retry:
    backoff: Backoff

## See [std-task.policy.retry.layer](../../spec/std/task.md#r-std-task.policy.retry.layer).
impl[T, E, $ R] Layer[fn!() -> Result[T, E] $ R] for Retry:
    type Wrapped = fn!() -> Result[T, E] $ R + Clock
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
        fn!() -> Result[T, E] $ R + Clock: retry_work!(self.backoff, attempt=work)

## A retry configuration with a predicate for one concrete error type.
## See [std-task.policy.selective-retry.decl](../../spec/std/task.md#r-std-task.policy.selective-retry.decl).
pub struct SelectiveRetry[E]:
    backoff: Backoff
    when: fn(E) -> bool

impl Retry:
    ## Selects which errors allow another attempt.
    ## See [std-task.policy.retry.when](../../spec/std/task.md#r-std-task.policy.retry.when).
    pub fn when[E](self, predicate: fn(E) -> bool) -> SelectiveRetry[E]:
        SelectiveRetry { backoff: self.backoff, when: predicate }

## See [std-task.policy.selective-retry.layer](../../spec/std/task.md#r-std-task.policy.selective-retry.layer).
impl[T, E, $ R] Layer[fn!() -> Result[T, E] $ R] for SelectiveRetry[E]:
    type Wrapped = fn!() -> Result[T, E] $ R + Clock
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
        fn!() -> Result[T, E] $ R + Clock: retry_work!(self.backoff, when=self.when, attempt=work)

## A backup configuration that retains its concrete work function and row.
## See [std-task.policy.fallback.decl](../../spec/std/task.md#r-std-task.policy.fallback.decl).
pub struct Fallback[F]:
    other: F

## See [std-task.policy.fallback.layer](../../spec/std/task.md#r-std-task.policy.fallback.layer).
impl[T, E, $ R, $ S] Layer[fn!() -> Result[T, E] $ R] for Fallback[fn!() -> Result[T, E] $ S]:
    type Wrapped = fn!() -> Result[T, E] $ R + S
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + S):
        fn!() -> Result[T, E] $ R + S:
            match work!():
                .Ok(value) => .Ok(value)
                .Err(_) => (self.other)!()

## A marker converted into the work's error type when a guard refuses it.
## See [std-task.policy.circuit-open.decl](../../spec/std/task.md#r-std-task.policy.circuit-open.decl).
pub struct CircuitOpen: pass

## Caller-owned state for a consecutive-failure circuit breaker.
## See [std-task.policy.breaker.decl](../../spec/std/task.md#r-std-task.policy.breaker.decl).
pub struct Breaker:
    pub failures: usize
    pub limit: usize
    pub calls: usize

## A guard retaining shared mutable breaker state across applications.
## See [std-task.policy.guard.decl](../../spec/std/task.md#r-std-task.policy.guard.decl).
pub struct Guard:
    state: *mut Breaker

## See [std-task.policy.guard.layer](../../spec/std/task.md#r-std-task.policy.guard.layer).
impl[T, E < From[CircuitOpen], $ R] Layer[fn!() -> Result[T, E] $ R] for Guard:
    type Wrapped = fn!() -> Result[T, E] $ R
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R):
        fn!() -> Result[T, E] $ R:
            if self.state.failures >= self.state.limit:
                return .Err(E::from(CircuitOpen {}))
            self.state.calls += 1
            result := work!()
            self.state.failures = if result.is_ok(): 0 else: self.state.failures + 1
            result

## A delay configuration for racing an immediate invocation against a later copy.
## See [std-task.policy.hedge.decl](../../spec/std/task.md#r-std-task.policy.hedge.decl).
pub struct Hedge:
    delay: Duration

## See [std-task.policy.hedge.layer](../../spec/std/task.md#r-std-task.policy.hedge.layer).
impl[T, E, $ R] Layer[fn!() -> Result[T, E] $ R] for Hedge:
    type Wrapped = fn!() -> Result[T, E] $ R + Clock
    fn wrap(self, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
        fn!() -> Result[T, E] $ R + Clock: race!(work(), late_copy(work, self.delay))

fn late_copy![T, E, $ R](
    work: fn!() -> Result[T, E] $ R,
    delay: Duration,
) -> Result[T, E] $ R + Clock:
    sleep!(delay)
    work!()

## Builds a retry configuration without acquiring a provider.
## See [std-task.policy.retry.builder](../../spec/std/task.md#r-std-task.policy.retry.builder).
pub fn retry(backoff: Backoff) -> Retry:
    Retry { backoff: backoff }

## Builds a deadline configuration without starting work.
## See [std-task.policy.timeout.builder](../../spec/std/task.md#r-std-task.policy.timeout.builder).
pub fn timeout(limit: Duration, cleanup: Duration? = .None) -> TimeLimit:
    TimeLimit { limit: limit, cleanup: cleanup }

## Places a deadline outside an inner policy.
## See [std-task.policy.with-timeout.builder](../../spec/std/task.md#r-std-task.policy.with-timeout.builder).
pub fn with_timeout[I](limit: Duration, inner: I, cleanup: Duration? = .None) -> (I, TimeLimit):
    (inner, timeout(limit, cleanup=cleanup))

## Places a backup outside an inner policy without starting work.
## See [std-task.policy.fallback.builder](../../spec/std/task.md#r-std-task.policy.fallback.builder).
pub fn fallback[F, I](other: F, inner: I) -> (I, Fallback[F]):
    (inner, Fallback { other: other })

## Builds a guard retaining the caller's shared mutable breaker state.
## See [std-task.policy.guard.builder](../../spec/std/task.md#r-std-task.policy.guard.builder).
pub fn guarded(state: *mut Breaker) -> Guard:
    Guard { state: state }

## Builds a hedge configuration without acquiring a clock or starting work.
## See [std-task.policy.hedge.builder](../../spec/std/task.md#r-std-task.policy.hedge.builder).
pub fn hedged(delay: Duration) -> Hedge:
    Hedge { delay: delay }

# The limit, and a note when the cleanup was cut short
# (r-std-task.timeout.display).
# Keep handwritten Display: choose the message from cleanup state, not a fixed field template.
impl Display for TimedOut:
    fn to_string(self) -> string:
        match self.cleanup:
            .Finished => "timed out after ${self.limit}"
            .Abandoned => "timed out after ${self.limit}, cleanup abandoned"

impl Error for TimedOut

# Races `work` against a sleep of `limit` on the covering `Clock`, work
# first, so work that finishes on its first poll wins a tie. `race!` cancels
# the loser and waits for its cleanup (spec/std/task.md#timeout). The
# work runs as the cold suspension `job`, so that after the race its kept
# cleanup result says how the cleanup ended (r-req.cancel.kept).
#
# With a `cleanup` bound, a third child comes first: it never completes,
# and its `using` binding holds the bound. Whatever cancels the race first,
# the limit (the race cancels its losers) or a cancel of `timeout!` (the
# race cancels every child), cancels it before the work, so its dispose
# fixes the deadline at that moment. The dispose is shielded, so a later
# cancel only continues it and never moves the deadline. It runs beside
# the work's cleanup, waits for it, and abandons the work once the
# deadline passes (r-std-task.policy.time-limit.cleanup-deadline).
## Runs `work` and returns its value, or `.Err(TimedOut)` when `limit` passes first; `cleanup` bounds the wait for the work's cleanup.
## See [std-task.policy.time-limit.layer](../../spec/std/task.md#r-std-task.policy.time-limit.layer).
fn timeout_value![T, $ R](
    limit: Duration,
    cleanup: Duration? = .None,
    work: fn!() -> T $ R,
) -> Result[T, TimedOut] $ R + Clock:
    let job: mut Suspend[T] = work()
    let end = match cleanup:
        .None => race!(timeout_work(job), timeout_expire(limit))
        .Some(bound) => race!(timeout_bound(job, bound), timeout_work(job), timeout_expire(limit))
    match end:
        .Done(value) => .Ok(value)
        .Expired => .Err(TimedOut { limit: limit, cleanup: job.cancel!() })

## Returns the work's Result directly, converting a timeout into its error type.
## See [std-task.policy.time-limit.layer](../../spec/std/task.md#r-std-task.policy.time-limit.layer).
fn timeout_result![T, E < From[TimedOut], $ R](
    limit: Duration,
    cleanup: Duration? = .None,
    work: fn!() -> Result[T, E] $ R,
) -> Result[T, E] $ R + Clock:
    match timeout_value!(limit, cleanup=cleanup, work=work):
        .Ok(result) => result
        .Err(error) => .Err(E::from(error))

# Which child of `timeout!`'s race completed first.
enum TimeoutEnd[T]:
    Done(T)
    Expired

fn timeout_work![T](job: mut Suspend[T]) -> TimeoutEnd[T]:
    .Done(job!())

fn timeout_expire![T](limit: Duration) -> TimeoutEnd[T] $ Clock:
    sleep!(limit)
    .Expired

# The bound's child: it waits until the race cancels it, and its dispose
# bounds the work's cleanup.
fn timeout_bound![T](job: mut Suspend[T], cleanup: Duration) -> TimeoutEnd[T] $ Clock:
    using bound = CleanupBound { job: job, cleanup: cleanup, clock: $.use(Clock) }
    let forever: mut Suspend[TimeoutEnd[T]] = pending_frame()
    forever!()

# The cleanup bound of `timeout!`: the work, the bound, and the clock that
# measures it.
struct CleanupBound[T]:
    job: mut Suspend[T]
    cleanup: Duration
    clock: *mut dyn Clock

# Runs when the work is first cancelled, so the deadline is `cleanup`
# from now. It waits for the work's cleanup, and abandons the work once
# the deadline passes first. Only a sleep is raced, so the wait is
# cooperative: a cleanup that is computing is never interrupted
# (r-std-task.timeout.cleanup-cooperative). A finished work's cleanup has
# ended, so its `cancel!()` wins at once.
impl[T] Disposable for CleanupBound[T]:
    fn dispose!(&mut self) -> void:
        started := self.clock.monotonic()
        _ := race!(self.job.cancel(), cleanup_deadline(self.job, self.clock, self.cleanup, started))

# Abandons `job` once `cleanup` has passed since `started`: at once when
# it already has, so a bound of 0 abandons whatever still waits
# (r-std-task.timeout.cleanup-zero).
fn cleanup_deadline![T](
    job: mut Suspend[T],
    clock: &mut dyn Clock,
    cleanup: Duration,
    started: Instant,
) -> CleanupEnd:
    spent := clock.monotonic().as_milliseconds() - started.as_milliseconds()
    if spent < cleanup.as_milliseconds():
        clock.sleep!(Duration::milliseconds(cleanup.as_milliseconds() - spent))
    job.abandon()
    .Abandoned

# A suspension that never completes: each poll answers Pending and
# registers no wake, and a cancel only marks it cancelled. The compiler
# supplies it, since every suspension hd code can build completes once a
# host operation or a child does, and a `ManualClock` sleep never waits.
@intrinsic("task_pending_frame")
fn pending_frame[T]() -> mut Suspend[T]:
    panic("intrinsic")

# Runs `work` on every item with at most `limit` calls in flight and
# returns the values in item order (spec/std/task.md#map-all). It starts
# `limit` workers, as one `all_list!`; each takes the next unstarted index
# when its previous item completes, which is a sliding window. A bang
# call is the only yield point (r-req.schedule.yield-points), so the
# shared counter needs no lock.
## Runs `work` on every item, at most `limit` at a time, and returns the values in item order.
## See [std-task.map-all.decl](../../spec/std/task.md#r-std-task.map-all.decl).
pub fn map_all![T, U, $ R](items: List[T], limit: usize, work: fn!(T) -> U $ R) -> List[U] $ R:
    # The workers share the slots and the cursor, so both are boxed.
    slots := box::[List[U?]]([])
    for _ in items:
        slots.push(.None)
    cursor := box(Cursor { next: 0 })
    let mut workers: List[fn!() -> void $ R] = []
    width := if limit < 1: 1 else: limit
    let count: usize = 0
    while count < width && count < items.len():
        workers.push(fn!() -> void $ R: map_all_worker!(items, work, slots, cursor))
        count = count + 1
    all_list!(workers)
    let mut values: List[U] = []
    for slot in *slots:
        match slot:
            .Some(value) => values.push(value)
            .None => panic("map_all!: an item finished without a value")
    values

# The next index no worker has taken.
struct Cursor:
    next: usize

fn map_all_worker![T, U, $ R](
    items: List[T],
    work: fn!(T) -> U $ R,
    slots: &mut List[U?],
    cursor: &mut Cursor,
) -> void $ R:
    while cursor.next < items.len():
        index := cursor.next
        cursor.next = index + 1
        slots[index] = .Some(work!(items[index]))
