# std.task, the part written in hd (spec/std/task.md). The `Suspend`
# protocol, `block_on`, `all!`, and `race!` are compiler intrinsics
# (spec/lang/11-requirements-and-suspension.md#standard-combinators). The
# compiler provides `all!` and `Waker` by name; `all!` has no written
# signature (r-req.combinator.all-typing).
use std.task.all
use std.error.Error
use std.ops.Disposable
use std.time.{Clock, Duration, Instant, sleep}

# The first child to complete wins, and the others are cancelled
# (r-req.combinator.race-losers-disposed). Its plain signature types every call
# (r-req.combinator.race-signature). The prototype writes the call in hd:
# it drives the frame that `race_frame` builds, whose polling body is the
# compiler's.
## Drives the tasks together and returns the first one's value; the losers are cancelled. A compiler intrinsic.
## See [req.combinator.race-signature](../../spec/lang/11-requirements-and-suspension.md#r-req.combinator.race-signature).
pub fn race![T](tasks...: List[mut Suspend[T]]) -> T:
    let frame: mut Suspend[T] = race_frame(tasks)
    frame!()

# How a `block_on` drive ended (spec/std/task.md#block-on).
## How a `block_on` drive ended: `Completed` with the suspension's value, or `Cancelled` or `Abandoned` when the suspension was cancelled and its cleanup ran to its end or was cut short.
## See [std-task.block-on.decl](../../spec/std/task.md#r-std-task.block-on.decl).
pub enum BlockOn[T]:
    Completed(T)
    Cancelled
    Abandoned

# The synchronous driver (r-req.drive.block-on.signature). The compiler
# supplies the body: it polls `s` and waits in the host while `s` is
# pending. A cancelled `s` is driven on until its cleanup has ended
# (r-req.drive.block-on.cancelled).
## Drives `s` from code that does not suspend, and returns how the drive ended. A compiler intrinsic.
## See [req.drive.block-on.signature](../../spec/lang/11-requirements-and-suspension.md#r-req.drive.block-on.signature).
@intrinsic("block_on")
pub fn block_on[T](s: mut Suspend[T]) -> BlockOn[T]:
    panic("intrinsic")

# How a job's cleanup ended (spec/std/task.md#cleanup-end). A kept
# `.Abandoned` comes from the job's frame.
## How a job's cleanup ended: `Finished` when it ran to its end, `Abandoned` when a part of it was cut short.
## See [std-task.cleanup-end.decl](../../spec/std/task.md#r-std-task.cleanup-end.decl).
@derive(Debug, Eq)
pub enum CleanupEnd:
    Finished
    Abandoned

# The `Suspend[T]` protocol's `cancel!` (r-req.cancel.bang). The job's
# frame holds its one cleanup; each call waits on it through a cleanup
# frame, whose polling body is the compiler's, so any number of calls
# share the cleanup and none restarts it (r-req.cancel.shared).
impl[T] Suspend[T]:
    ## Stops the job, waits until its cleanup has ended, and returns how it ended.
    ## See [req.cancel.bang](../../spec/lang/11-requirements-and-suspension.md#r-req.cancel.bang).
    pub fn cancel!(mut self) -> CleanupEnd:
        let cleanup: mut Suspend[bool] = cleanup_frame(self)
        if cleanup!(): .Abandoned else: .Finished

    ## Stops the job and unwinds it at once: its `defer` blocks run, and each `dispose!` is cut short at its suspension point.
    ## See [req.abandon.unwind](../../spec/lang/11-requirements-and-suspension.md#r-req.abandon.unwind).
    pub fn abandon(mut self) -> void:
        abandon_task(self)

# The cleanup frame of `cancel!`. Each poll starts the task's cleanup or
# continues it, and the frame completes once the task no longer unwinds:
# at once for a cold task, which is only marked cancelled, and for a
# completed or cancelled one. It completes with whether the cleanup was
# cut short (r-req.abandon.result). Cancelling the frame continues the
# cleanup too, so a cancelled waiter folds it into its own
# (r-req.cancel.nested).
@intrinsic("task_cleanup_frame")
fn cleanup_frame[T](task: mut Suspend[T]) -> mut Suspend[bool]:
    panic("intrinsic")

# `abandon()`: runs the task's own cancel synchronously, in a mode in
# which every waiting `dispose!` it reaches is killed at its suspension
# point instead of waited for (r-req.abandon.unwind). The compiler
# supplies the body.
@intrinsic("task_abandon")
fn abandon_task[T](task: mut Suspend[T]) -> void:
    panic("intrinsic")

# The polling frame of `race!`. Each poll polls the unfinished tasks in
# order. The first to complete is the result, and the frame then cancels
# every other task, in order, before it completes. Cancelling the frame
# cancels every task (r-req.combinator.cancel-children).
@intrinsic("task_race_frame")
fn race_frame[T](tasks: List[mut Suspend[T]]) -> mut Suspend[T]:
    panic("intrinsic")

# The polling frame of `all!`, which the checker builds for each call
# (src/checker/expression-suspensions.ts) and types as
# `mut Suspend[(X_1, ..., X_n)]`; `T` and the written result are never
# used. Each poll polls, in order, the tasks that have not completed and
# keeps each result; the frame completes with the results as a tuple once
# every task has (r-req.schedule.all-unfinished, .all-completed).
# Cancelling the frame cancels every unfinished task
# (r-req.combinator.cancel-children).
@intrinsic("task_all_frame")
fn all_frame[T](tasks: List[mut Suspend[T]]) -> mut Suspend[List[T]]:
    panic("intrinsic")

# Runs every task as one `all!` and returns the results in input order
# (spec/std/task.md#all-list).
## Drives the tasks together and returns their values in list order, as `all!` does for a fixed list.
## See [std-task.all-list](../../spec/std/task.md#r-std-task.all-list).
pub fn all_list![T, $R](tasks: List[fn!() -> T $ R]) -> List[T] $ R:
    let mut results: List[T] = []
    all_list_from!(tasks, 0, &mut results)
    results.reversed()

# The tasks from `start` on, as `all!` of the task at `start` and a cold
# call for the rest, which pushes the results last task first. Nested this
# way, the `all!` frames poll the unfinished tasks in input order and
# cancel them together, as one `all!` of every task would.
fn all_list_from![T, $R](tasks: List[fn!() -> T $ R], start: usize, results: &mut List[T]) -> void $ R:
    if start >= tasks.len():
        return
    task := tasks[start]
    let (value, _) = all!(task(), all_list_from(tasks, start + 1, results))
    results.push(value)

# Calls `attempt` one call after another until it returns `.Ok` or an
# `.Err` that `when` rejects, at most `times` times, and returns the last
# result. A `times` below 1 counts as 1 (spec/std/task.md#retry). The
# attempt's row `R` is the call's row. `when` defaults to retrying every
# error (r-std-task.combinator.retry.when-default).
## Calls `attempt` until it succeeds, hits an error `when` rejects, or runs out of tries, and returns the last outcome.
## See [std-task.combinator.retry.loop](../../spec/std/task.md#r-std-task.combinator.retry.loop).
pub fn retry![T, E, $R](times: usize, when: fn(E) -> bool = fn(error: E): true, attempt: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R:
    let result = attempt!()
    let tries: usize = 1
    while tries < times && should_retry(result, when):
        result = attempt!()
        tries = tries + 1
    result

# Whether `result` is an `.Err` that `when` accepts.
fn should_retry[T, E](result: Result[T, E], when: fn(E) -> bool) -> bool:
    match result:
        .Ok(_) => false
        .Err(error) => when(error)

# The retry policy of `retry_with!` (spec/std/task.md#retry-with-backoff):
# how many calls, the first delay, the multiplier, and the cap.
## How many times to try, how long to wait, and the wait's cap.
## See [std-task.backoff.decl-value](../../spec/std/task.md#r-std-task.backoff.decl-value).
@derive(Eq)
pub struct Backoff:
    pub attempts: usize
    pub initial: Duration
    pub factor: i32
    pub max: Duration

# As `retry!`, but waits on the covering `Clock` between attempts with a
# growing delay (spec/std/task.md#retry-with-backoff). The attempt's row
# `R` is the call's row; the `Clock` row is the sleep's.
## Retries with growing delays, and returns the last outcome.
## See [std-task.retry-with.decl-when](../../spec/std/task.md#r-std-task.retry-with.decl-when).
pub fn retry_with![T, E, $R](backoff: Backoff, when: fn(E) -> bool = fn(error: E): true, attempt: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + Clock:
    let result = attempt!()
    let tries: usize = 1
    let delay = backoff.initial
    while tries < backoff.attempts && should_retry(result, when):
        clock := $.use(Clock)
        clock.sleep!(delay)
        result = attempt!()
        tries = tries + 1
        grown := Duration::milliseconds(delay.as_milliseconds() * i64(backoff.factor))
        delay = if grown > backoff.max: backoff.max else: grown
    result

# The error of `timeout!` when the limit passes first, with how the work's
# cleanup ended (spec/std/task.md#timeout).
## The error of `timeout!`: the work did not finish within `limit`, and `cleanup` says how its cleanup ended.
## See [std-task.timeout.fields-value](../../spec/std/task.md#r-std-task.timeout.fields-value).
@derive(Debug, Eq)
pub struct TimedOut:
    pub limit: Duration
    pub cleanup: CleanupEnd

# The limit, and a note when the cleanup was cut short
# (r-std-task.timeout.display).
# Keep handwritten Display: choose the message from cleanup state, not a fixed field template.
impl Display for TimedOut:
    fn to_string(self) -> string:
        match self.cleanup:
            .Finished => "timed out after ${self.limit}"
            .Abandoned => "timed out after ${self.limit}, cleanup abandoned"

impl Error for TimedOut

# Races `work` against a sleep of `limit` on the covering `Clock`, work
# first, so work that finishes on its first poll wins a tie. `race!` cancels
# the loser and waits for its cleanup (spec/std/task.md#timeout). The
# work runs as the cold suspension `job`, so that after the race its kept
# cleanup result says how the cleanup ended (r-req.cancel.kept).
#
# With a `cleanup` bound, a third child comes first: it never completes,
# and its `using` binding holds the bound. Whatever cancels the race first,
# the limit (the race cancels its losers) or a cancel of `timeout!` (the
# race cancels every child), cancels it before the work, so its dispose
# fixes the deadline at that moment. The dispose is shielded, so a later
# cancel only continues it and never moves the deadline. It runs beside
# the work's cleanup, waits for it, and abandons the work once the
# deadline passes (r-std-task.timeout.cleanup-deadline).
## Runs `work` and returns its value, or `.Err(TimedOut)` when `limit` passes first; `cleanup` bounds the wait for the work's cleanup.
## See [std-task.timeout.decl-cleanup](../../spec/std/task.md#r-std-task.timeout.decl-cleanup).
pub fn timeout![T, $R](limit: Duration, cleanup: Duration? = .None, work: fn!() -> T $ R) -> Result[T, TimedOut] $ R + Clock:
    let job: mut Suspend[T] = work()
    let end = match cleanup:
        .None => race!(timeout_work(job), timeout_expire(limit))
        .Some(bound) => race!(timeout_bound(job, bound), timeout_work(job), timeout_expire(limit))
    match end:
        .Done(value) => .Ok(value)
        .Expired => .Err(TimedOut { limit: limit, cleanup: job.cancel!() })

# Which child of `timeout!`'s race completed first.
enum TimeoutEnd[T]:
    Done(T)
    Expired

fn timeout_work![T](job: mut Suspend[T]) -> TimeoutEnd[T]:
    .Done(job!())

fn timeout_expire![T](limit: Duration) -> TimeoutEnd[T] $ Clock:
    sleep!(limit)
    .Expired

# The bound's child: it waits until the race cancels it, and its dispose
# bounds the work's cleanup.
fn timeout_bound![T](job: mut Suspend[T], cleanup: Duration) -> TimeoutEnd[T] $ Clock:
    using bound = CleanupBound { job: job, cleanup: cleanup, clock: $.use(Clock) }
    let forever: mut Suspend[TimeoutEnd[T]] = pending_frame()
    forever!()

# The cleanup bound of `timeout!`: the work, the bound, and the clock that
# measures it.
struct CleanupBound[T]:
    job: mut Suspend[T]
    cleanup: Duration
    clock: &mut dyn Clock

# Runs when the work is first cancelled, so the deadline is `cleanup`
# from now. It waits for the work's cleanup, and abandons the work once
# the deadline passes first. Only a sleep is raced, so the wait is
# cooperative: a cleanup that is computing is never interrupted
# (r-std-task.timeout.cleanup-cooperative). A finished work's cleanup has
# ended, so its `cancel!()` wins at once.
impl[T] Disposable for CleanupBound[T]:
    fn dispose!(&mut self) -> void:
        started := self.clock.monotonic()
        _ := race!(self.job.cancel(), cleanup_deadline(self.job, self.clock, self.cleanup, started))

# Abandons `job` once `cleanup` has passed since `started`: at once when
# it already has, so a bound of 0 abandons whatever still waits
# (r-std-task.timeout.cleanup-zero).
fn cleanup_deadline![T](job: mut Suspend[T], clock: &mut dyn Clock, cleanup: Duration, started: Instant) -> CleanupEnd:
    spent := clock.monotonic().as_milliseconds() - started.as_milliseconds()
    if spent < cleanup.as_milliseconds():
        clock.sleep!(Duration::milliseconds(cleanup.as_milliseconds() - spent))
    job.abandon()
    .Abandoned

# A suspension that never completes: each poll answers Pending and
# registers no wake, and a cancel only marks it cancelled. The compiler
# supplies it, since every suspension hd code can build completes once a
# host operation or a child does, and a `ManualClock` sleep never waits.
@intrinsic("task_pending_frame")
fn pending_frame[T]() -> mut Suspend[T]:
    panic("intrinsic")

# Runs `work` on every item with at most `limit` calls in flight and
# returns the values in item order (spec/std/task.md#map-all). It starts
# `limit` workers, as one `all_list!`; each takes the next unstarted index
# when its previous item completes, which is a sliding window. A bang
# call is the only yield point (r-req.schedule.yield-points), so the
# shared counter needs no lock.
## Runs `work` on every item, at most `limit` at a time, and returns the values in item order.
## See [std-task.map-all.decl](../../spec/std/task.md#r-std-task.map-all.decl).
pub fn map_all![T, U, $R](items: List[T], limit: usize, work: fn!(T) -> U $ R) -> List[U] $ R:
    # The workers share the slots and the cursor, so both are new objects
    # behind `&mut`.
    let mut empty: List[U?] = []
    for _ in items:
        empty.push(.None)
    slots := &mut empty
    cursor := &mut Cursor { next: 0 }
    let mut workers: List[fn!() -> void $ R] = []
    width := if limit < 1: 1 else: limit
    let count: usize = 0
    while count < width && count < items.len():
        workers.push(fn!() -> void $ R: map_all_worker!(items, work, slots, cursor))
        count = count + 1
    all_list!(workers)
    let mut values: List[U] = []
    for slot in *slots:
        match slot:
            .Some(value) => values.push(value)
            .None => panic("map_all!: an item finished without a value")
    values

# The next index no worker has taken.
struct Cursor:
    next: usize

fn map_all_worker![T, U, $R](items: List[T], work: fn!(T) -> U $ R, slots: &mut List[U?], cursor: &mut Cursor) -> void $ R:
    while cursor.next < items.len():
        index := cursor.next
        cursor.next = index + 1
        slots[index] = .Some(work!(items[index]))
