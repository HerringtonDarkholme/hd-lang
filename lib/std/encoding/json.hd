# std.encoding.json: the untyped JSON value, its parser, and its writers, and
# typed JSON over the `std.encoding` opt-in: `to_json`, `from_json`,
# `encode`, `encode_pretty`, and `decode` (spec/std/json.md).
use std.format.DebugWriter
use std.iter.ListIter
use std.error.Error
use std.meta.cold
use std.encoding.{
    Serialize,
    Deserialize,
    Serializer,
    Deserializer,
    MapKeyValue,
    ValueKind,
    EnumTagging,
    member_name,
    Skip,
}
use std.meta.{VariantInfo, Member, Facts}
use std.rt.{string_bytes}
use std.rt.{
    bytes_len,
    bytes_at,
    bytes_slice,
    concat_all,
    string_from_bytes,
    TextSink,
    TextRoom,
    bytes_index,
    bytes_index_set,
}

fn map_key_text(key: MapKeyValue) -> string:
    match key:
        .Bool(value) => "$value"
        .Int(value) => "$value"
        .Uint(value) => "$value"
        .Text(value) => value

@cold
fn enum_tagging(facts: Facts) -> EnumTagging?:
    facts.find::[EnumTagging]()

# One JSON value (r-std-json.value.decl). An object keeps its members in
# insertion order (r-std-json.object.order).
## A JSON value: `null`, `Bool`, `Number`, `Text`, `Array`, or `Object`.
## See [std-json.value.decl](../../../spec/std/json.md#r-std-json.value.decl).
@derive(Debug, Eq)
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: Number)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: JsonObject)

# Stable member slots for indexed objects; deletion leaves a vacant slot
# until at least half the slots are vacant. A trailing metadata slot is
# present only after deletion or when serialization needs duplicate links. Keeping
# it in the existing COW buffer does not widen JsonObject or every Json.
enum ObjectEntry:
    Member(key: string, value: Json)
    Removed
    Metadata(live: usize, next: Map[usize, usize])

## The members of a JSON object, in insertion order.
## See [std-json.object.decl-struct](../../../spec/std/json.md#r-std-json.object.decl-struct).
pub struct JsonObject:
    entries: List[ObjectEntry]
    index: Map[string, usize]

impl JsonObject:
    ## Returns an object with no members.
    ## See [std-json.object.new-value](../../../spec/std/json.md#r-std-json.object.new-value).
    pub fn new() -> JsonObject:
        JsonObject { entries: [], index: {} }

    ## Returns the number of members.
    ## See [std-json.object.len](../../../spec/std/json.md#r-std-json.object.len).
    pub fn len(&self) -> usize:
        if self.index.is_empty():
            return self.entries.len()
        match self.entries[self.entries.len() - 1]:
            .Metadata(live, _) => live
            _ => self.entries.len()

    ## True exactly when the object has no members.
    ## See [std-json.object.len](../../../spec/std/json.md#r-std-json.object.len).
    pub fn is_empty(&self) -> bool:
        self.len() == 0

    ## The value of `key`, or `.None` when the object has no such key.
    ## See [std-json.object.get](../../../spec/std/json.md#r-std-json.object.get).
    pub fn get(&self, key: string) -> Json?:
        match self.position(key):
            .Some(at) => self.value_at(at)
            .None => .None

    ## True exactly when the object has the key.
    ## See [std-json.object.get](../../../spec/std/json.md#r-std-json.object.get).
    pub fn contains_key(&self, key: string) -> bool:
        self.position(key).is_some()

    ## Sets `key` to `value`. A new key goes last, and an existing key keeps its place.
    ## See [std-json.object.set-ref](../../../spec/std/json.md#r-std-json.object.set-ref).
    pub fn set(&mut self, key: string, value: Json) -> void:
        match self.position(key):
            .Some(at) => self.entries[at] = .Member(key, value)
            .None =>
                let at = self.entries.len()
                if self.has_metadata():
                    metadata := self.take_metadata()
                    at = self.entries.len()
                    self.entries.push(.Member(key, value))
                    self.entries.push(.Metadata(metadata._0 + 1, metadata._1))
                else:
                    self.entries.push(.Member(key, value))
                if !self.index.is_empty(): self.index[key] = at else if at >= 8: self.index_dense()

    ## Removes `key` and returns its value, or `.None` when the object has no such key. The other members keep their order.
    ## See [std-json.object.remove-ref](../../../spec/std/json.md#r-std-json.object.remove-ref).
    pub fn remove(&mut self, key: string) -> Json?:
        # A duplicate-preserving tree writer can construct a dense, large
        # object without an index. Pay for that index once before deletion.
        if self.index.is_empty() && self.entries.len() > 8:
            self.index_dense()
        match self.position(key):
            .None => .None
            .Some(at) =>
                # The existing unindexed representation has at most eight
                # members. Its bounded shift retains the reusable buffer,
                # avoiding metadata and allocations for small-object churn.
                if self.index.is_empty():
                    return match self.entries.remove(at):
                        .Member(_, value) => .Some(value)
                        _ => .None
                removed := self.value_at(at)
                metadata := self.take_metadata()
                live := metadata._0 - 1
                let mut next = metadata._1
                self.entries[at] = .Removed
                if !self.index.is_empty():
                    match next.remove(at):
                        .Some(following) => self.index[key] = following
                        .None => _ := self.index.remove(key)
                slots := self.entries.len()
                self.entries.push(.Metadata(live, next))
                if slots - live > live:
                    self.compact()
                removed

    # Entry cursors use physical slots; normalize only a map reader that
    # exposes numerical item positions, so its paths count live members.
    fn has_holes(&self) -> bool:
        if self.entries.is_empty():
            return false
        match self.entries[self.entries.len() - 1]:
            .Metadata(live, _) => self.entries.len() - 1 > live
            _ => false

    fn has_metadata(&self) -> bool:
        if self.entries.is_empty():
            return false
        match self.entries[self.entries.len() - 1]:
            .Metadata(_, _) => true
            _ => false

    # Move the successor map out before editing it, preserving its uniqueness.
    fn take_metadata(&mut self) -> (usize, Map[usize, usize]):
        match self.entries.pop():
            .Some(.Metadata(live, next)) => (live, next)
            .Some(entry) =>
                self.entries.push(entry)
                (self.entries.len(), {})
            .None => (0, {})

    fn value_at(&self, at: usize) -> Json?:
        match self.entries[at]:
            .Member(_, value) => .Some(value)
            _ => .None

    fn entry_at(&self, at: usize) -> (string, Json)?:
        match self.entries[at]:
            .Member(key, value) => .Some((key, value))
            _ => .None

    # An ordinary unindexed object has at most eight dense member slots.
    # A tree writer may also supply a larger dense object; remove indexes it
    # before mutation, while read-only traversal retains its original cost.
    fn position(&self, key: string) -> usize?:
        if !self.index.is_empty():
            return self.index.get(key)
        let at: usize = 0
        while at < self.entries.len():
            match self.entries[at]:
                .Member(found, _) =>
                    if found == key:
                        return .Some(at)
                _ => pass
            at += 1
        .None

    # All callers supply dense Member slots: promotion, first deletion of a
    # tree-writer object, or compaction. One reverse pass gives each key its
    # first slot and each duplicate its successor. A deletion updates only
    # that key's head.
    fn index_dense(&mut self) -> void:
        let mut index: Map[string, usize] = {}
        let mut next: Map[usize, usize] = {}
        let live: usize = 0
        let at = self.entries.len()
        while at > 0:
            at -= 1
            match self.entries[at]:
                .Member(key, _) =>
                    match index.get(key):
                        .Some(following) => next[at] = following
                        .None => pass
                    index[key] = at
                    live += 1
                _ => pass
        if !next.is_empty():
            self.entries.push(.Metadata(live, next))
        self.index = index

    fn from_entries(entries: List[ObjectEntry]) -> JsonObject:
        JsonObject { entries: entries, index: {} }

    # The dead slots pay for this scan and index rebuild. The replacement
    # drops the old buffer, so retained storage follows live member count.
    fn compact(&mut self) -> void:
        let mut entries: List[ObjectEntry] = []
        for entry in self.entries:
            match entry:
                .Member(_, _) => entries.push(entry)
                _ => pass
        let mut object = JsonObject::from_entries(entries)
        if object.entries.len() > 8:
            object.index_dense()
        *self = object

    ## The keys, in insertion order.
    ## See [std-json.object.order](../../../spec/std/json.md#r-std-json.object.order).
    pub fn keys(&self) -> List[string]:
        let mut keys: List[string] = []
        for entry in self.entries:
            match entry:
                .Member(key, _) => keys.push(key)
                _ => pass
        keys

## A cursor over the members of a JSON object, in insertion order.
pub struct JsonObjectIter:
    source: ListIter[ObjectEntry]

impl Iterator[(string, Json)] for JsonObjectIter:
    fn next(&mut self) -> (string, Json)?:
        while true:
            match self.source.next():
                .Some(.Member(key, value)) => return .Some((key, value))
                .Some(_) => pass
                .None => return .None

impl Iterable[(string, Json)] for JsonObject:
    type IntoIter = JsonObjectIter
    fn iter(self) -> JsonObjectIter:
        JsonObjectIter { source: self.entries.iter() }

# The same members, in any order (r-std-json.value.eq.object).
# Keep handwritten Eq: compare keys and values, independent of entry order.
impl Eq for JsonObject:
    fn eq(&self, other: &JsonObject) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in *self:
            match other.get(key):
                .Some(found) =>
                    if found != value:
                        return false
                .None => return false
        true

# What a `Number` holds: an integer below zero, an integer from zero up, or
# a finite float. Normalized, so one integer has one representation
# (r-std-json.number.repr).
@derive(Eq)
enum NumberRepr:
    Negative(value: i64)
    NonNegative(value: u64)
    Float(value: f64)

# A JSON number that keeps 64-bit integers exact, modeled on
# `serde_json::Number` (r-std-json.number.decl-struct).
## A JSON number, exact for 64-bit integers: integers in the `i64` and `u64` ranges are exact, and every other number is an `f64`.
## See [std-json.number.decl-struct](../../../spec/std/json.md#r-std-json.number.decl-struct).
@derive(Eq)
pub struct Number:
    repr: NumberRepr

impl Number:
    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.i64](../../../spec/std/json.md#r-std-json.number.constructors.i64).
    pub fn from_i64(value: i64) -> Number:
        if value < 0:
            return Number { repr: NumberRepr.Negative(value) }
        Number { repr: NumberRepr.NonNegative(u64(value)) }

    ## Returns the integer `value` as a `Number`.
    ## See [std-json.number.constructors.u64](../../../spec/std/json.md#r-std-json.number.constructors.u64).
    pub fn from_u64(value: u64) -> Number:
        Number { repr: NumberRepr.NonNegative(value) }

    ## Returns the float `value` as a `Number`, or `.None` for a NaN or an infinity.
    ## See [std-json.number.constructors.f64](../../../spec/std/json.md#r-std-json.number.constructors.f64).
    pub fn from_f64(value: f64) -> Number?:
        if !value.is_finite():
            return .None
        .Some(Number { repr: NumberRepr.Float(value) })

    ## The integer when it is in the `i64` range, and `.None` for a float.
    ## See [std-json.number.accessors.i64](../../../spec/std/json.md#r-std-json.number.accessors.i64).
    pub fn as_i64(&self) -> i64?:
        match self.repr:
            .Negative(value) => .Some(value)
            .NonNegative(value) =>
                if value < sign_limit(): .Some(i64(value)) else: .None
            .Float(_) => .None

    ## The integer when it is from zero up, and `.None` for a negative integer or a float.
    ## See [std-json.number.accessors.u64](../../../spec/std/json.md#r-std-json.number.accessors.u64).
    pub fn as_u64(&self) -> u64?:
        match self.repr:
            .NonNegative(value) => .Some(value)
            _ => .None

    ## `.Some` of the float, or of the integer converted to the nearest `f64`.
    ## See [std-json.number.accessors.f64](../../../spec/std/json.md#r-std-json.number.accessors.f64).
    pub fn as_f64(&self) -> f64?:
        match self.repr:
            .Negative(value) => .Some(f64(value))
            .NonNegative(value) => .Some(f64(value))
            .Float(value) => .Some(value)

# Keep handwritten Display: render the represented number without its private enum wrapper.
impl Display for Number:
    fn to_string(&self) -> string:
        match self.repr:
            .Negative(value) => "$value"
            .NonNegative(value) => "$value"
            .Float(value) => "$value"

impl Json:
    # JSON text with two-space indentation (r-std-json.value.pretty).
    ## The pretty text of the value: each item of an array and each entry of an object on its own line, indented by two spaces for each level of nesting.
    ## See [std-json.value.pretty](../../../spec/std/json.md#r-std-json.value.pretty).
    pub fn pretty(&self) -> string:
        let mut out = TextRoom::new()
        render(*self, &mut out, true, 0)
        out.take_text()

    ## The value of `key` when the value is an `Object` with that key.
    ## See [std-json.value.accessors.get](../../../spec/std/json.md#r-std-json.value.accessors.get).
    pub fn get(&self, key: string) -> Json?:
        match self:
            .Object(fields) => fields.get(key)
            _ => .None

    ## The item at `index` when the value is an `Array` and `index` is from 0 up to its length.
    ## See [std-json.value.accessors.at-index](../../../spec/std/json.md#r-std-json.value.accessors.at-index).
    pub fn at(&self, index: usize) -> Json?:
        match self:
            .Array(items) =>
                if index < items.len(): .Some(items[index]) else: .None
            _ => .None

    ## The string of a `Text` value.
    ## See [std-json.value.accessors.text](../../../spec/std/json.md#r-std-json.value.accessors.text).
    pub fn as_text(&self) -> string?:
        match self:
            .Text(value) => .Some(value)
            _ => .None

    ## The value of a `Bool`.
    ## See [std-json.value.accessors.bool](../../../spec/std/json.md#r-std-json.value.accessors.bool).
    pub fn as_bool(&self) -> bool?:
        match self:
            .Bool(value) => .Some(value)
            _ => .None

    ## `true` exactly for `Null`.
    ## See [std-json.value.accessors.null](../../../spec/std/json.md#r-std-json.value.accessors.null).
    pub fn is_null(&self) -> bool:
        match self:
            .Null => true
            _ => false

    ## The integer of a `Number` that is an integer in the `i64` range; a float, even `1.0`, gives `.None`.
    ## See [std-json.value.accessors.i64](../../../spec/std/json.md#r-std-json.value.accessors.i64).
    pub fn as_i64(&self) -> i64?:
        match self:
            .Number(value) => value.as_i64()
            _ => .None

    ## The integer of a `Number` that is an integer from zero up in the `u64` range; a float gives `.None`.
    ## See [std-json.value.accessors.u64](../../../spec/std/json.md#r-std-json.value.accessors.u64).
    pub fn as_u64(&self) -> u64?:
        match self:
            .Number(value) => value.as_u64()
            _ => .None

    ## The `f64` of any `Number`, an integer converted to the nearest `f64`.
    ## See [std-json.value.accessors.f64](../../../spec/std/json.md#r-std-json.value.accessors.f64).
    pub fn as_f64(&self) -> f64?:
        match self:
            .Number(value) => value.as_f64()
            _ => .None

    # RFC 6901: `""` is the value itself, and every other pointer is `/`
    # and a token for each step (r-std-json.pointer.syntax). A token is cut
    # at the next `/` and decoded at once; `/` and `~` are ASCII, so every
    # cut is on a scalar boundary.
    ## The value at the JSON Pointer `path` (RFC 6901), such as `/db/pool/0`, or `.None` when no value is there.
    ## See [std-json.pointer](../../../spec/std/json.md#r-std-json.pointer).
    pub fn pointer(&self, path: string) -> Json?:
        size := bytes_len(path)
        if size == 0:
            return .Some(*self)
        if bytes_at(path, 0) != 47:
            return .None
        let current = *self
        let start: usize = 1
        while start <= size:
            end := bytes_index(path, start, 47)
            match pointer_step(current, pointer_token(path, start, end)):
                .Some(next) => current = next
                .None => return .None
            start = end + 1
        .Some(current)

# One pointer step: an object's member named `token`, or an array's item
# at the index `token` writes (r-std-json.pointer.step).
fn pointer_step(value: Json, token: string) -> Json?:
    match value:
        .Object(fields) => fields.get(token)
        .Array(items) =>
            match pointer_index(token, items.len()):
                .Some(index) => .Some(items[index])
                .None => .None
        _ => .None

# The index that `token` writes when it is below `len`: base-ten digits,
# with no sign and no leading zero (r-std-json.pointer.index).
fn pointer_index(token: string, len: usize) -> usize?:
    size := bytes_len(token)
    if size == 0 || (size > 1 && bytes_at(token, 0) == 48):
        return .None
    let value: usize = 0
    let at: usize = 0
    while at < size:
        byte := bytes_at(token, at)
        if byte < 48 || byte > 57:
            return .None
        value = value * 10 + usize(byte - 48)
        if value >= len:
            return .None
        at = at + 1
    .Some(value)

# The token from `start` up to `end` of `path`, with `~1` read as `/` and
# `~0` as `~`; any other `~` stays as written (r-std-json.pointer.escapes).
fn pointer_token(path: string, start: usize, end: usize) -> string:
    let mut parts: List[string] = []
    let plain = start
    let at = start
    while at + 1 < end:
        if bytes_at(path, at) == 126:
            next := bytes_at(path, at + 1)
            if next == 48 || next == 49:
                if at > plain:
                    parts.push(bytes_slice(path, plain, at))
                parts.push(if next == 48: "~" else: "/")
                at = at + 2
                plain = at
                continue
        at = at + 1
    if parts.len() == 0:
        return bytes_slice(path, start, end)
    if plain < end:
        parts.push(bytes_slice(path, plain, end))
    concat_all(parts)

# Compact JSON text (r-std-json.display.compact).
# Keep handwritten Display: render JSON syntax rather than an Error message.
impl Display for Json:
    fn to_string(&self) -> string:
        let mut out = TextRoom::new()
        render(*self, &mut out, false, 0)
        out.take_text()

# The text is appended to one byte buffer. Every piece is valid UTF-8 (a
# literal, a number's text, or a run of a string cut next to an ASCII
# byte), so the text needs no check.
fn render(value: Json, out: &mut TextRoom, spaced: bool, depth: usize) -> void:
    match value:
        .Null => TextSink::append_text(out, "null")
        .Bool(flag) =>
            TextSink::append_text(out, if flag: "true" else: "false")
        .Number(number) =>
            match number.repr:
                .Negative(value) => TextSink::append_signed(out, value)
                .NonNegative(value) => TextSink::append_unsigned(out, value)
                .Float(value) => TextSink::append_text(out, "$value")
        .Text(text) => push_quoted(out, text)
        .Array(items) =>
            if items.len() == 0:
                TextSink::append_text(out, "[]")
                return
            TextSink::append_text(out, "[")
            let first = true
            for item in items:
                if !first:
                    TextSink::append_text(out, ",")
                first = false
                line_break(out, spaced, depth + 1)
                render(item, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            TextSink::append_text(out, "]")
        .Object(fields) =>
            if fields.len() == 0:
                TextSink::append_text(out, "{}")
                return
            TextSink::append_text(out, "{")
            let first = true
            for entry in fields:
                if !first:
                    TextSink::append_text(out, ",")
                first = false
                line_break(out, spaced, depth + 1)
                push_quoted(out, entry._0)
                TextSink::append_text(out, if spaced: ": " else: ":")
                render(entry._1, out, spaced, depth + 1)
            line_break(out, spaced, depth)
            TextSink::append_text(out, "}")

fn line_break(out: &mut TextRoom, spaced: bool, depth: usize) -> void:
    if !spaced:
        return
    TextSink::append_text(out, "\n")
    if depth > 0:
        TextSink::append_text(out, "  ".repeat(depth))

fn push_quoted(out: &mut TextRoom, text: string) -> void:
    TextSink::append_text(out, "\"")
    push_escaped(out, text)
    TextSink::append_text(out, "\"")

# Each `bytes_index_set(text, from, 0x0000_0004_FFFF_FFFF, 0x1000_0000,
# 0, 0)` below finds the next byte a JSON string escapes: a control byte
# below 0x20 (bits 0-31), `"` (bit 34) or `\` (bit 92). The words are
# literal at each call, so the backend sees a constant set.
# The inside of a quoted string: `"` and `\` escaped, the control
# characters below U+0020 as `\b`, `\f`, `\n`, `\r`, `\t`, or `\u00XX` with
# lowercase hex, and every other scalar value as itself
# (r-std-json.display.text). Each run of bytes that needs no escape goes in
# whole, as a slice that shares the string's bytes; an escaped byte is
# ASCII, so every run starts and ends on a scalar boundary.
fn push_escaped(out: &mut TextRoom, text: string) -> void:
    size := bytes_len(text)
    let plain: usize = 0
    let index = bytes_index_set(text, 0, 0x0000_0004_FFFF_FFFF, 0x1000_0000, 0, 0)
    while index < size:
        if index > plain:
            TextSink::append_text(out, bytes_slice(text, plain, index))
        TextSink::append_text(out, escape_text(bytes_at(text, index)))
        plain = index + 1
        index = bytes_index_set(text, plain, 0x0000_0004_FFFF_FFFF, 0x1000_0000, 0, 0)
    if plain == 0:
        if size > 0:
            TextSink::append_text(out, text)
    else if plain < size:
        TextSink::append_text(out, bytes_slice(text, plain, size))

fn escape_text(byte: u8) -> string:
    match byte:
        34 => "\\\""
        92 => "\\\\"
        8 => "\\b"
        12 => "\\f"
        10 => "\\n"
        13 => "\\r"
        9 => "\\t"
        _ =>
            let mut bytes: List[u8] = [92, 117, 48, 48]
            bytes.push(hex_symbol(byte >> 4))
            bytes.push(hex_symbol(byte & 15))
            string_from_bytes(bytes)

fn hex_symbol(value: u8) -> u8:
    if value < 10: 48 + value else: 87 + value

# Keep the duplicate-only display path from adding a string literal to every
# program that reaches serde through another std module. The existing missing
# field message supplies the common suffix; only a linked DuplicateField
# display builds the distinct prefix.
fn duplicate_field_message(path: string) -> string:
    source := "missing field at $path".to_utf8()
    let mut bytes: List[u8] = [100, 117, 112, 108, 105, 99, 97, 116, 101]
    for index in 7..source.len():
        bytes.push(source[index])
    string_from_bytes(bytes)

# Why parsing failed, at a byte offset into the text (r-std-json.error.position-bytes), or why
# decoding failed, at a path such as `$.users[2].name`
# (r-std-json.error.variants.v2).
## The error that `parse` and `decode` return: seven parse errors at a byte position, and four decode errors at a path.
## See [std-json.error.variants.v2](../../../spec/std/json.md#r-std-json.error.variants.v2).
@error
@derive(Debug, Eq)
pub enum JsonError:
    # The text stops inside a value; `position` is its length.
    @error("unexpected end of text at position $position")
    UnexpectedEnd(position: usize)
    # A character the grammar does not allow there.
    @error("unexpected character at position $position")
    UnexpectedCharacter(position: usize)
    # A bad escape; `position` is its backslash.
    @error("invalid escape at position $position")
    InvalidEscape(position: usize)
    # A `\u` surrogate with no partner; `position` is its backslash.
    @error("lone surrogate escape at position $position")
    LoneSurrogate(position: usize)
    # A raw control character inside a string.
    @error("control character in a string at position $position")
    ControlCharacter(position: usize)
    # A number past the finite f64 range; `position` is its first character.
    @error("number out of range at position $position")
    NumberOutOfRange(position: usize)
    # An array or object nested deeper than 128 levels; `position` is its
    # opening bracket.
    @error("nesting too deep at position $position")
    NestingTooDeep(position: usize)
    # A value of the wrong kind, or a number out of the type's range;
    # `expected` names what the decoder reads (r-std-json.error.kind.type).
    @error("expected $expected at $path")
    WrongType(path: string, expected: string)
    # An object without a key that its type needs.
    @error("missing field at $path")
    MissingField(path: string)
    # A field whose representation requires one occurrence appears more than once.
    @error("${duplicate_field_message(path)}")
    DuplicateField(path: string)
    # A variant name that the enum does not declare.
    @error("unknown variant \"$name\" at $path")
    UnknownVariant(path: string, name: string)

# Strict RFC 8259 text to a `Json` (r-std-json.parse).
## Reads one JSON text, strictly as RFC 8259 defines it, and returns `.Ok` of the value or `.Err` of the first error.
## See [std-json.parse](../../../spec/std/json.md#r-std-json.parse).
pub fn parse(text: string) -> Result[Json, JsonError]:
    parser := &mut Parser { text: text, size: bytes_len(text), at: 0 }
    value := parser.value(0)?
    parser.skip_space()
    if parser.at < parser.size:
        return .Err(JsonError.UnexpectedCharacter(parser.at))
    .Ok(value)

# A recursive descent over the input's own bytes, read through `bytes_at`;
# `at` is the offset of the next byte to read. A string with no escape is
# a slice of the input, which shares its bytes: the input is a valid string
# and the slice starts and ends next to a quote, so it needs no check.
#
struct Parser:
    text: string
    size: usize
    at: usize

impl Parser:
    # Checks one value and moves past it, retaining nothing. `depth` is
    # the number of brackets already open around it, which `parse` limits
    # to 128; the recursion is bounded by that limit, not by the input.
    fn validate(&mut self, depth: usize) -> Result[void, JsonError]:
        self.skip_space()
        start := self.at
        if start >= self.size:
            return .Err(self.unexpected(start))
        byte := bytes_at(self.text, start)
        if byte == 34:
            _ := self.validate_string()?
            return .Ok(())
        if byte == 116:
            return self.validate_word("true")
        if byte == 102:
            return self.validate_word("false")
        if byte == 110:
            return self.validate_word("null")
        if byte == 45 || is_digit(byte):
            return self.validate_number()
        if byte != 91 && byte != 123:
            return .Err(self.unexpected(start))
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(start))
        object := byte == 123
        let close: u8 = if object: 125 else: 93
        self.at = start + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == close:
            self.at = self.at + 1
            return .Ok(())
        while true:
            if object:
                key := self.at
                if key >= self.size || bytes_at(self.text, key) != 34:
                    return .Err(self.unexpected(key))
                _ := self.validate_string()?
                self.skip_space()
                if self.at >= self.size || bytes_at(self.text, self.at) != 58:
                    return .Err(self.unexpected(self.at))
                self.at = self.at + 1
            self.validate(depth + 1)?
            self.skip_space()
            index := self.at
            if index < self.size:
                next := bytes_at(self.text, index)
                if next == close:
                    self.at = index + 1
                    return .Ok(())
                if next == 44:
                    self.at = index + 1
                    if object:
                        self.skip_space()
                    continue
            return .Err(self.unexpected(index))
        .Ok(())

    # The decoded key whose opening quote is at `quote`.
    fn key_at(&mut self, quote: usize) -> Result[string, JsonError]:
        self.at = quote
        self.string()

    # Whether the key whose opening quote is at `quote` decodes to `name`.
    # The bytes compare in place; only a key with an escape is decoded.
    fn key_is(&mut self, quote: usize, name: string) -> Result[bool, JsonError]:
        size := bytes_len(name)
        start := quote + 1
        let offset: usize = 0
        while offset <= size:
            byte := bytes_at(self.text, start + offset)
            if byte == 92:
                return .Ok(self.key_at(quote)? == name)
            if byte == 34:
                return .Ok(offset == size)
            if offset == size || byte != bytes_at(name, offset):
                return .Ok(false)
            offset = offset + 1
        .Ok(false)

    # Syntax-only scalar readers retain no Json, Number, or decoded string.
    fn validate_word(&mut self, word: string) -> Result[void, JsonError]:
        size := self.size
        let offset: usize = 0
        while offset < bytes_len(word):
            index := self.at + offset
            if index >= size || bytes_at(self.text, index) != bytes_at(word, offset):
                return .Err(self.unexpected(index))
            offset = offset + 1
        self.at = self.at + offset
        .Ok(())

    # Whether the string had no escape.
    fn validate_string(&mut self) -> Result[bool, JsonError]:
        size := self.size
        let index = self.at + 1
        let plain = true
        while true:
            index = bytes_index_set(self.text, index, 0x0000_0004_FFFF_FFFF, 0x1000_0000, 0, 0)
            if index >= size:
                return .Err(JsonError.UnexpectedEnd(index))
            byte := bytes_at(self.text, index)
            if byte == 34:
                self.at = index + 1
                return .Ok(plain)
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            plain = false
            backslash := index
            if index + 1 >= size:
                return .Err(JsonError.UnexpectedEnd(index + 1))
            escaped := bytes_at(self.text, index + 1)
            index = index + 2
            if escaped == 117:
                unit := self.hex4(index)
                if unit == -2:
                    return .Err(JsonError.UnexpectedEnd(size))
                if unit < 0:
                    return .Err(JsonError.InvalidEscape(backslash))
                index = index + 4
                if unit >= 56320 && unit <= 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                if unit >= 55296 && unit <= 56319:
                    low := if (
                        index + 1 < size
                        && bytes_at(self.text, index) == 92
                        && bytes_at(self.text, index + 1) == 117
                    ):
                        self.hex4(index + 2)
                    else:
                        -1
                    if low < 56320 || low > 57343:
                        return .Err(JsonError.LoneSurrogate(backslash))
                    index = index + 6
            else if (
                escaped != 34
                && escaped != 92
                && escaped != 47
                && escaped != 98
                && escaped != 102
                && escaped != 110
                && escaped != 114
                && escaped != 116
            ):
                return .Err(JsonError.InvalidEscape(backslash))

    fn validate_number(&mut self) -> Result[void, JsonError]:
        size := self.size
        start := self.at
        let index = start
        if bytes_at(self.text, index) == 45:
            index = index + 1
        if index >= size:
            return .Err(self.unexpected(index))
        first := bytes_at(self.text, index)
        if first == 48:
            index = index + 1
        else if first >= 49 && first <= 57:
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        else:
            return .Err(self.unexpected(index))
        let floating = false
        if index < size && bytes_at(self.text, index) == 46:
            floating = true
            index = index + 1
            if index >= size || !is_digit(bytes_at(self.text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        if index < size && (bytes_at(self.text, index) == 101 || bytes_at(self.text, index) == 69):
            floating = true
            index = index + 1
            if (
                index < size
                && (bytes_at(self.text, index) == 43 || bytes_at(self.text, index) == 45)
            ):
                index = index + 1
            if index >= size || !is_digit(bytes_at(self.text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(self.text, index)):
                index = index + 1
        # At most 19 digits fit within the integer representations; larger
        # integers and floats still use the shared range/finite checks.
        if floating || index - start > 19:
            _ := self.number()?
        self.at = index
        .Ok(())

    # The error for a byte that cannot continue the text at `offset`.
    fn unexpected(&self, offset: usize) -> JsonError:
        if offset >= self.size:
            return JsonError.UnexpectedEnd(offset)
        JsonError.UnexpectedCharacter(offset)

    fn skip_space(&mut self) -> void:
        size := self.size
        let index = self.at
        while index < size:
            byte := bytes_at(self.text, index)
            if byte != 32 && byte != 9 && byte != 10 && byte != 13:
                break
            index = index + 1
        self.at = index

    # The value after any whitespace at `at`.
    fn value(&mut self, depth: usize) -> Result[Json, JsonError]:
        self.skip_space()
        index := self.at
        if index >= self.size:
            return .Err(JsonError.UnexpectedEnd(index))
        byte := bytes_at(self.text, index)
        if byte == 34:
            return .Ok(Json.Text(self.string()?))
        if byte == 123:
            return self.object(depth)
        if byte == 91:
            return self.array(depth)
        if byte == 116:
            return self.word("true", Json.Bool(true))
        if byte == 102:
            return self.word("false", Json.Bool(false))
        if byte == 110:
            return self.word("null", Json.Null)
        if byte == 45 || (byte >= 48 && byte <= 57):
            return self.number()
        .Err(JsonError.UnexpectedCharacter(index))

    fn word(&mut self, word: string, value: Json) -> Result[Json, JsonError]:
        text := self.text
        size := bytes_len(word)
        let index = self.at
        let offset: usize = 0
        while offset < size:
            if index >= self.size || bytes_at(text, index) != bytes_at(word, offset):
                return .Err(self.unexpected(index))
            index = index + 1
            offset = offset + 1
        self.at = index
        .Ok(value)

    # The array whose `[` is at `at`.
    fn array(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut items: List[Json] = []
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 93:
            self.at = self.at + 1
            return .Ok(Json.Array(items))
        while true:
            items.push(self.value(depth + 1)?)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    continue
                if byte == 93:
                    self.at = index + 1
                    return .Ok(Json.Array(items))
            return .Err(self.unexpected(index))

    # The object whose `{` is at `at`.
    fn object(&mut self, depth: usize) -> Result[Json, JsonError]:
        open := self.at
        if depth >= 128:
            return .Err(JsonError.NestingTooDeep(open))
        let mut fields = JsonObject::new()
        self.at = open + 1
        self.skip_space()
        if self.at < self.size && bytes_at(self.text, self.at) == 125:
            self.at = self.at + 1
            return .Ok(Json.Object(fields))
        while true:
            quote := self.at
            if quote >= self.size || bytes_at(self.text, quote) != 34:
                return .Err(self.unexpected(quote))
            key := self.string()?
            self.skip_space()
            colon := self.at
            if colon >= self.size || bytes_at(self.text, colon) != 58:
                return .Err(self.unexpected(colon))
            self.at = colon + 1
            found := self.value(depth + 1)?
            fields.set(key, found)
            self.skip_space()
            index := self.at
            if index < self.size:
                byte := bytes_at(self.text, index)
                if byte == 44:
                    self.at = index + 1
                    self.skip_space()
                    continue
                if byte == 125:
                    self.at = index + 1
                    return .Ok(Json.Object(fields))
            return .Err(self.unexpected(index))

    # The string whose opening quote is at `at`: a slice of the input when
    # it has no escape.
    fn string(&mut self) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        start := self.at + 1
        index := bytes_index_set(text, start, 0x0000_0004_FFFF_FFFF, 0x1000_0000, 0, 0)
        if index >= size:
            return .Err(JsonError.UnexpectedEnd(index))
        byte := bytes_at(text, index)
        if byte == 34:
            self.at = index + 1
            return .Ok(bytes_slice(text, start, index))
        if byte == 92:
            return self.escaped(start, index)
        .Err(JsonError.ControlCharacter(index))

    # The rest of a string that starts at `start` and has its first escape
    # at `index`. Each run between escapes is a slice of the input, each
    # escape the text it stands for, and the pieces are joined once.
    fn escaped(&mut self, start: usize, first: usize) -> Result[string, JsonError]:
        text := self.text
        size := self.size
        let mut parts: List[string] = []
        let plain = start
        let index = first
        while true:
            index = bytes_index_set(text, index, 0x0000_0004_FFFF_FFFF, 0x1000_0000, 0, 0)
            if index >= size:
                return .Err(JsonError.UnexpectedEnd(index))
            byte := bytes_at(text, index)
            if byte == 34:
                if index > plain:
                    parts.push(bytes_slice(text, plain, index))
                self.at = index + 1
                return .Ok(concat_all(parts))
            if byte < 32:
                return .Err(JsonError.ControlCharacter(index))
            if index > plain:
                parts.push(bytes_slice(text, plain, index))
            backslash := index
            if index + 1 >= size:
                return .Err(JsonError.UnexpectedEnd(index + 1))
            escaped := bytes_at(text, index + 1)
            index = index + 2
            if escaped == 34:
                parts.push("\"")
            else if escaped == 92:
                parts.push("\\")
            else if escaped == 47:
                parts.push("/")
            else if escaped == 98:
                parts.push("\u{8}")
            else if escaped == 102:
                parts.push("\u{c}")
            else if escaped == 110:
                parts.push("\n")
            else if escaped == 114:
                parts.push("\r")
            else if escaped == 116:
                parts.push("\t")
            else if escaped == 117:
                unit := self.hex4(index)
                if unit == -2:
                    return .Err(JsonError.UnexpectedEnd(size))
                if unit < 0:
                    return .Err(JsonError.InvalidEscape(backslash))
                index = index + 4
                let point = unit
                if unit >= 56320 && unit <= 57343:
                    return .Err(JsonError.LoneSurrogate(backslash))
                if unit >= 55296 && unit <= 56319:
                    low := if (
                        index + 1 < size
                        && bytes_at(text, index) == 92
                        && bytes_at(text, index + 1) == 117
                    ):
                        self.hex4(index + 2)
                    else:
                        -1
                    if low < 56320 || low > 57343:
                        return .Err(JsonError.LoneSurrogate(backslash))
                    point = 65536 + (unit - 55296) * 1024 + (low - 56320)
                    index = index + 6
                parts.push(scalar_text(point))
            else:
                return .Err(JsonError.InvalidEscape(backslash))
            plain = index

    # The value of the four hex digits at `at`, -1 when one is not a hex
    # digit, or -2 when the text ends first.
    fn hex4(&self, at: usize) -> i32:
        let value: i32 = 0
        let offset: usize = 0
        while offset < 4:
            if at + offset >= self.size:
                return -2
            digit := hex_value(i32(bytes_at(self.text, at + offset)))
            if digit < 0:
                return -1
            value = value * 16 + digit
            offset = offset + 1
        value

    # The number that starts at `at`: `-`? then `0` or a nonzero digit and
    # digits. An integer in the i64 or u64 range is exact; `-0` is the float
    # -0.0, as in serde_json. A fraction, an exponent, or an integer past
    # both ranges is the float that `f64` parsing gives
    # (r-std-json.parse.number.float-via-parse).
    fn number(&mut self) -> Result[Json, JsonError]:
        text := self.text
        size := self.size
        start := self.at
        let index = start
        negative := bytes_at(text, index) == 45
        if negative:
            index = index + 1
        if index >= size:
            return .Err(self.unexpected(index))
        let magnitude: u64 = 0
        let overflow = false
        first := bytes_at(text, index)
        if first == 48:
            index = index + 1
        else if first >= 49 && first <= 57:
            while index < size && is_digit(bytes_at(text, index)):
                digit := u64(bytes_at(text, index) - 48)
                if magnitude > (u64_max() - digit) / 10:
                    overflow = true
                else:
                    magnitude = magnitude * 10 + digit
                index = index + 1
        else:
            return .Err(self.unexpected(index))
        let exotic = false
        # The digits as one integer `significand` while it stays at most
        # 2^53, and the power of ten that scales it, for `exact_float`.
        let significand = magnitude
        let exact = !overflow && magnitude <= exact_limit()
        let scale: i64 = 0
        if index < size && bytes_at(text, index) == 46:
            index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            while index < size && is_digit(bytes_at(text, index)):
                if exact:
                    significand = significand * 10 + u64(bytes_at(text, index) - 48)
                    scale = scale - 1
                    exact = significand <= exact_limit()
                index = index + 1
            exotic = true
        if index < size && (bytes_at(text, index) == 101 || bytes_at(text, index) == 69):
            index = index + 1
            let below = false
            if index < size && (bytes_at(text, index) == 43 || bytes_at(text, index) == 45):
                below = bytes_at(text, index) == 45
                index = index + 1
            if index >= size || !is_digit(bytes_at(text, index)):
                return .Err(self.unexpected(index))
            let power: i64 = 0
            while index < size && is_digit(bytes_at(text, index)):
                if power < 1000:
                    power = power * 10 + i64(bytes_at(text, index) - 48)
                index = index + 1
            scale = if below: scale - power else: scale + power
            exotic = true
        self.at = index
        if exotic && exact && scale >= -22 && scale <= 22:
            value := exact_float(significand, scale)
            signed := if negative: -value else: value
            return .Ok(Json.Number(Number { repr: NumberRepr.Float(signed) }))
        if exotic || overflow || (negative && magnitude > sign_limit()):
            return float_number(text, start, index)
        if !negative:
            return .Ok(Json.Number(Number::from_u64(magnitude)))
        if magnitude == 0:
            match Number::from_f64(-0.0):
                .Some(zero) => return .Ok(Json.Number(zero))
                .None => return float_number(text, start, index)
        if magnitude == sign_limit():
            return .Ok(Json.Number(Number::from_i64(-9223372036854775808)))
        .Ok(Json.Number(Number::from_i64(-i64(magnitude))))

fn is_digit(byte: u8) -> bool:
    byte >= 48 && byte <= 57

fn hex_value(code: i32) -> i32:
    if code >= 48 && code <= 57:
        return code - 48
    if code >= 97 && code <= 102:
        return code - 87
    if code >= 65 && code <= 70:
        return code - 55
    -1

# The UTF-8 text of a scalar value, which is never a surrogate.
fn scalar_text(point: i32) -> string:
    let mut out: List[u8] = []
    if point < 128:
        out.push(u8(point))
    else if point < 2048:
        out.push(u8(192 + (point >> 6)))
        out.push(u8(128 + (point & 63)))
    else if point < 65536:
        out.push(u8(224 + (point >> 12)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    else:
        out.push(u8(240 + (point >> 18)))
        out.push(u8(128 + ((point >> 12) & 63)))
        out.push(u8(128 + ((point >> 6) & 63)))
        out.push(u8(128 + (point & 63)))
    string_from_bytes(out)

# 2^63, the first u64 past the i64 range, and the largest u64.
fn sign_limit() -> u64:
    9223372036854775808

fn u64_max() -> u64:
    18446744073709551615

# 2^53: every integer up to it is an exact `f64`.
fn exact_limit() -> u64:
    9007199254740992

# The `f64` nearest `significand * 10^scale`, ties to even, for a
# significand of at most 2^53 and a scale in [-22, 22]: both factors are
# exact `f64` values, so one correctly rounded multiply or divide gives
# the correctly rounded result (Clinger's fast path, as in Rust's
# `dec2flt` and Go's `atof64exact`).
fn exact_float(significand: u64, scale: i64) -> f64:
    let power = 1.0
    let k: i64 = if scale < 0: -scale else: scale
    while k > 0:
        power = power * 10.0
        k = k - 1
    if scale < 0: f64(significand) / power else: f64(significand) * power

# The float of the number text from `start` up to `end`, which the caller
# has read to the end of its grammar; past the f64 range it is a
# `NumberOutOfRange` at `start` (r-std-json.parse.number.nonfinite-parse-result).
fn float_number(text: string, start: usize, end: usize) -> Result[Json, JsonError]:
    # Name the string method explicitly beside this module's JSON parse entry.
    value := match string::parse::[f64](bytes_slice(text, start, end)):
        .Ok(found) => found
        .Err(_) => panic("std.encoding.json: a JSON number is valid f64 text")
    match Number::from_f64(value):
        .Some(number) => .Ok(Json.Number(number))
        .None => .Err(JsonError.NumberOutOfRange(start))

# Keep handwritten Debug: hide the representation variant behind Number(value).
impl Debug for Number:
    fn debug(&self, out: *mut DebugWriter) -> void:
        match self.repr:
            .Negative(value) => out.debug_tuple("Number").field(value).finish()
            .NonNegative(value) => out.debug_tuple("Number").field(value).finish()
            .Float(value) => out.debug_tuple("Number").field(value).finish()

# One `debug_list` entry per member, in insertion order.
# Keep handwritten Debug: render entries as a list rather than storage fields.
impl Debug for JsonObject:
    fn debug(&self, out: *mut DebugWriter) -> void:
        let mut list = out.debug_list()
        for entry in *self:
            _ := list.entry(entry)
        list.finish()

# ---------------------------------------------------------------------------
# Typed JSON (spec/std/json.md#typed-json): JSON as a format that reads the
# `std.encoding` opt-in. `to_json` writes a value through `JsonWriter`,
# `encode` writes its text through `TextWriter`, and `from_json` reads one
# through `JsonReader`.

# The `Json` of a value (r-std-json.to-json).
## The `Json` that `value`'s `serialize` writes.
## See [std-json.to-json](../../../spec/std/json.md#r-std-json.to-json).
pub fn to_json[T < Serialize](value: T) -> Json:
    writer := &mut JsonWriter {
        result: Json.Null,
        pending: "",
        keys: [],
        values: [],
        frames: [],
        no_facts: Facts { items: [] },
    }
    match value.serialize(writer):
        .Ok(_) => writer.result
        .Err(_) => panic("std.encoding.json: the JSON writer never fails")

# The value that a `Json` describes, or the first decode error
# (r-std-json.from-json).
## The `T` that `T::deserialize` reads from `value`, or the first error it finds.
## See [std-json.from-json](../../../spec/std/json.md#r-std-json.from-json).
pub fn from_json[T < Deserialize](value: Json) -> Result[T, JsonError]:
    let mut reader = JsonReader::new(value)
    T::deserialize(&mut reader)

# The compact text of a value's `Json` (r-std-json.encode). `TextWriter`
# writes that text during the walk, with no `Json` in between; a walk it
# does not write directly goes through the tree, which defines the text.
## The compact JSON text of `value`, with no whitespace outside strings.
## See [std-json.encode](../../../spec/std/json.md#r-std-json.encode).
pub fn encode[T < Serialize](value: T) -> string:
    let mut writer = TextWriter::new(false)
    writer.trusted = T::regular()
    _ := value.serialize(&mut writer)
    # A regular walk is written whole (r-std-serde.regular); the
    # constant answer drops the tree path from the instance.
    if T::regular():
        return writer.out.take_text()
    match writer.finish():
        .Some(text) => text
        .None => encode_fallback(value)

# The pretty text of a value's `Json` (r-std-json.encode-pretty), written
# by `TextWriter` in its spaced layout, or through the tree as `encode`
# falls back.
## The pretty JSON text of `value`: `to_json(value).pretty()`.
## See [std-json.encode-pretty](../../../spec/std/json.md#r-std-json.encode-pretty).
pub fn encode_pretty[T < Serialize](value: T) -> string:
    let mut writer = TextWriter::new(true)
    writer.trusted = T::regular()
    _ := value.serialize(&mut writer)
    # A regular walk is written whole (r-std-serde.regular); the
    # constant answer drops the tree path from the instance.
    if T::regular():
        return writer.out.take_text()
    match writer.finish():
        .Some(text) => text
        .None => encode_pretty_fallback(value)

# Read the text once through the typed deserializer (r-std-json.decode.direct.v2).
## Reads a typed value from JSON text in one pass.
## See [std-json.decode.direct.v2](../../../spec/std/json.md#r-std-json.decode.direct.v2).
pub fn decode[T < Deserialize](text: string) -> Result[T, JsonError]:
    # One pass: the key-loop reader reads the text in order, and the
    # derived walk takes the keys in any order. Only a failed or unfinished
    # read goes on: a syntax error anywhere in the text wins over the
    # reader's error (r-std-json.decode.parse-error.v2), so that path checks
    # the whole text once. A hand-written `deserialize` that leaves values
    # or containers unread still gets its value when the text is valid.
    let mut stream = StreamReader::new(text)
    let mut result = T::deserialize(&mut stream)
    match result:
        .Ok(_) =>
            if stream.finish():
                return result
        .Err(_) => pass
    let mut parser = Parser { text: text, size: bytes_len(text), at: 0 }
    parser.validate(0)?
    parser.skip_space()
    if parser.at != parser.size:
        return .Err(parser.unexpected(parser.at))
    result

# `Json` writes and reads itself (r-std-json.std.json).
# Keep handwritten Serialize: write the JSON value itself, not an externally tagged enum.
impl Serialize for Json:
    fn regular() -> bool:
        true

    fn serialize[W < Serializer](&self, out: &mut W) -> Result[void, W::Error]:
        match *self:
            .Null => out.null()
            .Bool(flag) => out.bool(flag)
            .Number(number) =>
                match number.repr:
                    .Negative(found) => out.int(found)
                    .NonNegative(found) => out.uint(found)
                    .Float(found) => out.float(found)
            .Text(text) => out.text(text)
            .Array(items) =>
                out.begin_list(items.len())?
                for item in items:
                    item.serialize(out)?
                out.end_list()
            .Object(fields) =>
                out.begin_map(fields.len())?
                for entry in fields:
                    out.key(entry._0)?
                    entry._1.serialize(out)?
                out.end_map()

# Keep handwritten Deserialize: read the JSON value itself, not an externally tagged enum.
impl Deserialize for Json:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Json, R::Error]:
        match input.peek()?:
            .Null =>
                _ := input.is_null()?
                .Ok(Json.Null)
            .Bool => .Ok(Json.Bool(input.bool("bool")?))
            .Int => .Ok(Json.Number(Number::from_i64(input.int("i64")?)))
            .Uint => .Ok(Json.Number(Number::from_u64(input.uint("u64")?)))
            .Float =>
                found := input.float("f64")?
                match Number::from_f64(found):
                    .Some(number) => .Ok(Json.Number(number))
                    .None => .Ok(Json.Null)
            .Text => .Ok(Json.Text(input.text("string")?))
            .List =>
                input.begin_list()?
                let mut items: List[Json] = []
                while input.next_item()?:
                    items.push(Json::deserialize(input)?)
                .Ok(Json.Array(items))
            .Map =>
                input.begin_map()?
                let mut fields = JsonObject::new()
                while true:
                    match input.next_key()?:
                        .Some(key) => fields.set(key, Json::deserialize(input)?)
                        .None => break
                .Ok(Json.Object(fields))

# One open list, map, or variant of the writer: its kind, where its items
# start in `values`, the key it goes under in its own container, and a
# variant's name and form.
struct OpenFrame:
    pub kind: i32
    pub start: usize
    pub key: string
    pub name: string
    pub of_data: bool
    pub facts: Facts

# Builds the `Json` of one value. The items of every open container sit on
# one stack, `values`, each beside its key in `keys`; closing a container
# replaces its items with its value (r-std-json.derive.to-json.data-included-members).
struct JsonWriter:
    pub result: Json
    pub pending: string
    pub keys: List[string]
    pub values: List[Json]
    pub frames: List[OpenFrame]
    # The facts of a list or a map frame, and of a member with no frame,
    # made once per writer.
    pub no_facts: Facts

impl JsonWriter:
    fn put(&mut self, value: Json) -> Result[void, never]:
        if self.frames.len() == 0:
            self.result = value
        else:
            self.keys.push(self.pending)
            self.values.push(value)
        .Ok(())

    fn open(&mut self, kind: i32, name: string, of_data: bool, facts: Facts) -> Result[void, never]:
        self.frames.push(
            OpenFrame {
                kind: kind,
                start: self.values.len(),
                key: self.pending,
                name: name,
                of_data: of_data,
                facts: facts,
            },
        )
        .Ok(())

    fn open_tagged(&mut self, name: string, facts: Facts, form: i32) -> Result[void, never]:
        self.open(4 + form, name, false, facts)

    # The innermost frame, its items, and its keys, popped.
    fn close(&mut self) -> (OpenFrame, List[string], List[Json]):
        frame := match self.frames.pop():
            .Some(found) => found
            .None => panic("std.encoding.json: a close without an open container")
        let mut keys: List[string] = []
        let mut values: List[Json] = []
        let index = frame.start
        while index < self.values.len():
            keys.push(self.keys[index])
            values.push(self.values[index])
            index = index + 1
        while self.values.len() > frame.start:
            _ := self.values.pop()
            _ := self.keys.pop()
        self.pending = frame.key
        (frame, keys, values)

impl Serializer for JsonWriter:
    type Error = never

    fn null(&mut self) -> Result[void, never]:
        self.put(Json.Null)

    fn bool(&mut self, value: bool) -> Result[void, never]:
        self.put(Json.Bool(value))

    fn int(&mut self, value: i64) -> Result[void, never]:
        self.put(Json.Number(Number::from_i64(value)))

    fn uint(&mut self, value: u64) -> Result[void, never]:
        self.put(Json.Number(Number::from_u64(value)))

    # A NaN or an infinity has no JSON number, so it writes `null`, as in
    # serde_json (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, never]:
        match Number::from_f64(value):
            .Some(number) => self.put(Json.Number(number))
            .None => self.put(Json.Null)

    fn text(&mut self, value: string) -> Result[void, never]:
        self.put(Json.Text(value))

    fn begin_list(&mut self, len: usize) -> Result[void, never]:
        self.open(0, "", false, self.no_facts)

    fn end_list(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Array(closed._2))

    fn begin_map(&mut self, len: usize) -> Result[void, never]:
        self.open(1, "", false, self.no_facts)

    fn key(&mut self, key: string) -> Result[void, never]:
        self.pending = key
        .Ok(())

    fn map_key(&mut self, key: MapKeyValue) -> Result[void, never]:
        self.key(map_key_text(key))

    fn end_map(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        self.open(2, v.name, true, facts)

    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        if !facts.items.is_empty():
            match enum_tagging(facts):
                .Some(_) =>
                    let form: i32 = if v.named == 0 && v.included_positional == 0: 0 else: 1
                    return self.open_tagged(v.name, facts, form)
                .None => pass
        # Kind 3 preserves the object payload of a named or mixed variant
        # even when every member is statically skipped.
        let kind: i32 = if !v.of_data && v.named > 0: 3 else: 2
        self.open(kind, v.name, v.of_data, facts)

    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, never]:
        if !facts.items.is_empty() && enum_tagging(facts).is_some():
            return self.open_tagged(v.name, facts, 2)
        self.begin_map(1)?
        self.key(v.name)?
        self.frames[self.frames.len() - 1].name = v.name
        .Ok(())

    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, never]:
        if !facts.items.is_empty() && enum_tagging(facts).is_some():
            return self.open_tagged(v.name, facts, 3)
        self.begin_map(1)?
        self.key(v.name)?
        self.begin_list(len)?
        self.frames[self.frames.len() - 1].name = v.name
        .Ok(())

    fn member(&mut self, m: &Member) -> Result[void, never]:
        facts := if self.frames.is_empty():
            self.no_facts
        else:
            self.frames[self.frames.len() - 1].facts
        self.pending = member_name(m, facts)
        .Ok(())

    fn end_data(&mut self) -> Result[void, never]:
        closed := self.close()
        self.put(Json.Object(object_of(closed._1, closed._2)))

    # A data type is an object; a variant with no member is its name, and
    # other variant forms follow their included members
    # (r-std-json.derive.to-json.included-enum-form).
    fn end_variant(&mut self) -> Result[void, never]:
        frame := self.frames[self.frames.len() - 1]
        if frame.kind >= 4:
            tagging := match enum_tagging(frame.facts):
                .Some(found) => found
                .None => panic("std.encoding.json: tagged frame without an enum representation")
            closed := self.close()
            return self.put(tagged_json(closed._0, closed._1, closed._2, tagging))
        if frame.name != "" && frame.kind == 0:
            self.end_list()?
            return self.end_map()
        if frame.name != "" && frame.kind == 1:
            return self.end_map()
        closed := self.close()
        closed_frame := closed._0
        fields := object_of(closed._1, closed._2)
        if closed_frame.of_data:
            return self.put(Json.Object(fields))
        if fields.len() == 0 && closed_frame.kind != 3:
            return self.put(Json.Text(closed_frame.name))
        let mut outer = JsonObject::new()
        outer.set(closed_frame.name, Json.Object(fields))
        self.put(Json.Object(outer))

fn object_of(keys: List[string], values: List[Json]) -> JsonObject:
    let mut fields = JsonObject::new()
    let index: usize = 0
    while index < keys.len():
        fields.set(keys[index], values[index])
        index = index + 1
    fields

fn tagged_json(
    frame: OpenFrame,
    keys: List[string],
    values: List[Json],
    tagging: EnumTagging,
) -> Json:
    form := frame.kind - 4
    match tagging:
        .Internal(tag) =>
            payload := if form == 2:
                if values.is_empty(): Json.Null else: values[0]
            else:
                Json.Object(object_of(keys, values))
            fields := match payload:
                .Object(found) => found
                _ =>
                    panic(
                        "std.encoding.json: internally tagged variant `${frame.name}` payload must write an object",
                    )
            let mut entries: List[ObjectEntry] = [.Member(tag, Json.Text(frame.name))]
            for (key, value) in fields:
                entries.push(.Member(key, value))
            Json.Object(JsonObject::from_entries(entries))
        .Adjacent(tag, content) =>
            let mut object = JsonObject::new()
            object.set(tag, Json.Text(frame.name))
            if form != 0:
                payload := match form:
                    1 => Json.Object(object_of(keys, values))
                    2 =>
                        if values.is_empty(): Json.Null else: values[0]
                    _ => Json.Array(values)
                object.set(content, payload)
            Json.Object(object)
        .Untagged =>
            match form:
                0 => Json.Null
                1 => Json.Object(object_of(keys, values))
                2 =>
                    if values.is_empty(): Json.Null else: values[0]
                _ => Json.Array(values)

# What an open container of the text writer is.
enum FrameKind:
    # A list, or an enum tuple variant when its stored name is nonempty.
    Items
    # A map, or an enum newtype variant when its stored name is nonempty.
    Entries
    # A data type's object.
    Record
    # An enum variant: its name, or `{"Variant":{...}}`.
    Tagged
    # A named or mixed enum variant, including an empty object payload.
    Named

# The writer met a walk that it does not write directly.
enum Irregular:
    Walk

# Writes the compact text of the `Json` that `JsonWriter` would build, or
# its pretty text when `spaced` is true, as
# the walk reaches each part, into copy-on-write byte room. It writes
# the walks that derived and standard implementations make: one value, a
# key before each value in an object, every key new in its object, and each
# end matching its begin. Any other walk sets `regular` to false and stops,
# and `encode` builds the tree instead: the tree's rules for a missing,
# stale, or repeated key, or for a second value, are the definition.
# A `trusted` writer serves a type whose `regular()` holds: its walk is
# regular (r-std-serde.regular), so every key is new in its object and the
# writer keeps no keys at all; each key costs its own bytes only.
#
# The open containers are a stack of `depth` frames in four lists: each
# frame's kind, its variant name, its number of values so far, and where
# its keys start in `keys`. An object's first 16 keys sit in `keys`, with a
# cheap print of each in `prints`; a larger object moves its keys into a
# map on `indexes`. The stacks keep their slots when a frame closes, and
# the next frame reuses them. `indent` is the nesting level of the pretty
# text: a list, a map, or a record adds one, and a variant two, for its
# `{"Variant": {` once a member opens it.
struct TextWriter:
    pub out: TextRoom
    pub depth: usize
    pub kinds: List[FrameKind]
    pub names: List[string]
    pub counts: List[usize]
    pub key_starts: List[usize]
    pub facts: List[Facts]
    # The facts of a list or a map frame, made once per writer.
    pub no_facts: Facts
    pub key_count: usize
    pub keys: List[string]
    pub prints: List[usize]
    pub pending: string
    pub keyed: bool
    pub written: bool
    pub regular: bool
    pub trusted: bool
    pub spaced: bool
    pub indent: usize

impl TextWriter:
    fn new(spaced: bool) -> TextWriter:
        TextWriter {
            out: TextRoom::new(),
            depth: 0,
            kinds: [],
            names: [],
            counts: [],
            key_starts: [],
            facts: [],
            no_facts: Facts { items: [] },
            key_count: 0,
            keys: [],
            prints: [],
            pending: "",
            keyed: false,
            written: false,
            regular: true,
            trusted: false,
            spaced: spaced,
            indent: 0,
        }

    # The text, or `.None` when the walk was not regular or not complete.
    fn finish(&mut self) -> string?:
        if !self.regular || !self.written || self.depth > 0:
            return .None
        .Some(self.out.take_text())

    fn give_up(&mut self) -> Result[void, Irregular]:
        self.regular = false
        .Err(Irregular.Walk)

    # Starts one value: a comma after an earlier item, and in an object the
    # value's key, which must be new there. The first member of an enum
    # variant opens `{"Variant":{` first.
    fn start(&mut self) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0:
            if self.written:
                return self.give_up()
            self.written = true
            return .Ok(())
        last := self.depth - 1
        count := self.counts[last]
        self.counts[last] = count + 1
        kind := self.kinds[last]
        match kind:
            .Items =>
                if count > 0:
                    TextSink::append_text(&mut self.out, ",")
                line_break(&mut self.out, self.spaced, self.indent)
                return .Ok(())
            _ => pass
        if !self.keyed:
            return self.give_up()
        key := self.pending
        self.keyed = false
        if !self.trusted && !self.add_key(last, key):
            return self.give_up()
        if self.spaced:
            self.spaced_key(kind, count, self.names[last], key)
            return .Ok(())
        if count > 0:
            TextSink::append_text(&mut self.out, ",\"")
        else:
            match kind:
                .Tagged =>
                    TextSink::append_text(&mut self.out, "{\"")
                    push_escaped(&mut self.out, self.names[last])
                    TextSink::append_text(&mut self.out, "\":{\"")
                .Named =>
                    TextSink::append_text(&mut self.out, "{\"")
                    push_escaped(&mut self.out, self.names[last])
                    TextSink::append_text(&mut self.out, "\":{\"")
                _ => TextSink::append_text(&mut self.out, "\"")
        push_escaped(&mut self.out, key)
        TextSink::append_text(&mut self.out, "\":")
        .Ok(())

    # The pretty text before a value of an object: a comma after an earlier
    # entry, a line break, and `"key": `. The first member of a variant
    # opens `{`, its name, and `: {` first, each on its own line.
    fn spaced_key(&mut self, kind: FrameKind, count: usize, name: string, key: string) -> void:
        if count > 0:
            TextSink::append_text(&mut self.out, ",")
        else:
            match kind:
                .Tagged =>
                    TextSink::append_text(&mut self.out, "{")
                    line_break(&mut self.out, true, self.indent - 1)
                    push_quoted(&mut self.out, name)
                    TextSink::append_text(&mut self.out, ": {")
                .Named =>
                    TextSink::append_text(&mut self.out, "{")
                    line_break(&mut self.out, true, self.indent - 1)
                    push_quoted(&mut self.out, name)
                    TextSink::append_text(&mut self.out, ": {")
                _ => pass
        line_break(&mut self.out, true, self.indent)
        push_quoted(&mut self.out, key)
        TextSink::append_text(&mut self.out, ": ")

    # Reuse the writer's key slots across objects. No object allocates a
    # duplicate-key map; nested objects use disjoint ranges of the buffer.
    fn add_key(&mut self, frame: usize, key: string) -> bool:
        start := self.key_starts[frame]
        print := key_print(key)
        let at: usize = start
        while at < self.key_count:
            if self.prints[at] == print && self.keys[at] == key:
                return false
            at = at + 1
        if at < self.keys.len():
            self.keys[at] = key
            self.prints[at] = print
        else:
            self.keys.push(key)
            self.prints.push(print)
        self.key_count = at + 1
        true

    fn open(&mut self, kind: FrameKind, name: string, facts: Facts) -> Result[void, Irregular]:
        self.start()?
        match kind:
            .Items => TextSink::append_text(&mut self.out, "[")
            .Tagged => pass
            .Named => pass
            _ => TextSink::append_text(&mut self.out, "{")
        at := self.depth
        if at < self.kinds.len():
            self.kinds[at] = kind
            self.names[at] = name
            self.counts[at] = 0
            self.key_starts[at] = self.key_count
            self.facts[at] = facts
        else:
            self.kinds.push(kind)
            self.names.push(name)
            self.counts.push(0)
            self.key_starts.push(self.key_count)
            self.facts.push(facts)
        self.depth = at + 1
        self.indent = self.indent + levels_of(kind)
        .Ok(())

    # Ends the innermost frame, which must be of `kind`; `Record` also ends
    # a `Tagged` frame. A variant with no member is its name
    # (r-std-json.derive.to-json.unit-form).
    fn close(&mut self, kind: FrameKind) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        last := self.depth - 1
        count := self.counts[last]
        open_kind := self.kinds[last]
        let spaced = self.spaced && count > 0
        match (kind, open_kind):
            (.Items, .Items) =>
                line_break(&mut self.out, spaced, self.indent - 1)
                TextSink::append_text(&mut self.out, "]")
            (.Entries, .Entries) =>
                line_break(&mut self.out, spaced, self.indent - 1)
                TextSink::append_text(&mut self.out, "}")
            (.Record, .Record) =>
                line_break(&mut self.out, spaced, self.indent - 1)
                TextSink::append_text(&mut self.out, "}")
            (.Record, .Tagged) =>
                if spaced:
                    line_break(&mut self.out, true, self.indent - 1)
                    TextSink::append_text(&mut self.out, "}")
                    line_break(&mut self.out, true, self.indent - 2)
                    TextSink::append_text(&mut self.out, "}")
                else if count > 0:
                    TextSink::append_text(&mut self.out, "}}")
                else:
                    push_quoted(&mut self.out, self.names[last])
            (.Record, .Named) =>
                if count > 0:
                    if spaced:
                        line_break(&mut self.out, true, self.indent - 1)
                        TextSink::append_text(&mut self.out, "}")
                        line_break(&mut self.out, true, self.indent - 2)
                        TextSink::append_text(&mut self.out, "}")
                    else:
                        TextSink::append_text(&mut self.out, "}}")
                else if self.spaced:
                    TextSink::append_text(&mut self.out, "{")
                    line_break(&mut self.out, true, self.indent - 1)
                    push_quoted(&mut self.out, self.names[last])
                    TextSink::append_text(&mut self.out, ": {}")
                    line_break(&mut self.out, true, self.indent - 2)
                    TextSink::append_text(&mut self.out, "}")
                else:
                    TextSink::append_text(&mut self.out, "{\"")
                    push_escaped(&mut self.out, self.names[last])
                    TextSink::append_text(&mut self.out, "\":{}}")
            _ => return self.give_up()
        self.key_count = self.key_starts[last]
        self.depth = last
        self.indent = self.indent - levels_of(open_kind)
        .Ok(())

    # A key or a member name names the next value of an object.
    fn name_next(&mut self, key: string) -> Result[void, Irregular]:
        if !self.regular:
            return .Err(Irregular.Walk)
        if self.depth == 0 || self.keyed:
            return self.give_up()
        match self.kinds[self.depth - 1]:
            .Items => return self.give_up()
            _ => pass
        self.pending = key
        self.keyed = true
        .Ok(())

    fn scalar(&mut self, text: string) -> Result[void, Irregular]:
        self.start()?
        TextSink::append_text(&mut self.out, text)
        .Ok(())

impl Serializer for TextWriter:
    type Error = Irregular

    fn null(&mut self) -> Result[void, Irregular]:
        self.scalar("null")

    fn bool(&mut self, value: bool) -> Result[void, Irregular]:
        self.scalar(if value: "true" else: "false")

    fn int(&mut self, value: i64) -> Result[void, Irregular]:
        self.start()?
        TextSink::append_signed(&mut self.out, value)
        .Ok(())

    fn uint(&mut self, value: u64) -> Result[void, Irregular]:
        self.start()?
        TextSink::append_unsigned(&mut self.out, value)
        .Ok(())

    # A NaN or an infinity writes `null` (r-std-json.std.float-special).
    fn float(&mut self, value: f64) -> Result[void, Irregular]:
        if value.is_finite():
            self.start()?
            if !push_short_float(&mut self.out, value):
                TextSink::append_text(&mut self.out, "$value")
            return .Ok(())
        self.scalar("null")

    fn text(&mut self, value: string) -> Result[void, Irregular]:
        self.start()?
        push_quoted(&mut self.out, value)
        .Ok(())

    fn begin_list(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Items, "", self.no_facts)

    fn end_list(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Items)

    fn begin_map(&mut self, len: usize) -> Result[void, Irregular]:
        self.open(FrameKind.Entries, "", self.no_facts)

    fn key(&mut self, key: string) -> Result[void, Irregular]:
        self.name_next(key)

    fn map_key(&mut self, key: MapKeyValue) -> Result[void, Irregular]:
        self.key(map_key_text(key))

    fn end_map(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Entries)

    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        self.open(FrameKind.Record, v.name, facts)

    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        if !facts.items.is_empty() && enum_tagging(facts).is_some():
            return self.give_up()
        kind := if v.of_data:
            FrameKind.Record
        else if v.named > 0:
            FrameKind.Named
        else:
            FrameKind.Tagged
        self.open(kind, v.name, facts)

    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Irregular]:
        if !facts.items.is_empty() && enum_tagging(facts).is_some():
            return self.give_up()
        self.begin_map(1)?
        self.key(v.name)?
        self.names[self.depth - 1] = v.name
        .Ok(())

    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, Irregular]:
        if !facts.items.is_empty() && enum_tagging(facts).is_some():
            return self.give_up()
        self.begin_map(1)?
        self.key(v.name)?
        self.begin_list(len)?
        self.names[self.depth - 1] = v.name
        .Ok(())

    fn member(&mut self, m: &Member) -> Result[void, Irregular]:
        if !self.regular || self.depth == 0:
            return self.give_up()
        self.name_next(member_name(m, self.facts[self.depth - 1]))

    fn end_data(&mut self) -> Result[void, Irregular]:
        self.close(FrameKind.Record)

    fn end_variant(&mut self) -> Result[void, Irregular]:
        if self.depth == 0:
            return self.give_up()
        last := self.depth - 1
        if self.names[last] != "":
            match self.kinds[last]:
                .Items =>
                    self.end_list()?
                    return self.end_map()
                .Entries => return self.end_map()
                _ => pass
        self.close(FrameKind.Record)

# Appends the Display text of `value` when it is `n / 10^k` for an
# integer `n` below 10^15 and a magnitude from 10^-5 up to 10^15, and
# returns whether it did. The least such `k` gives the shortest digits
# that read back as `value`: below 10^15 two decimals of one length are
# never one float apart, and `n / 10^k` is the correctly rounded value of
# that decimal (Clinger's exact case), so the test is exact. The text is
# fixed notation, as Display writes these magnitudes: `9.5`, `3.0`,
# `0.00125`.
fn push_short_float(out: &mut TextRoom, value: f64) -> bool:
    magnitude := if value < 0.0: -value else: value
    if !(magnitude >= 0.00001 && magnitude < 1000000000000000.0):
        return false
    let power = 1.0
    let k: usize = 0
    while true:
        scaled := magnitude * power
        if scaled >= 1000000000000000.0:
            return false
        n := u64(scaled + 0.5)
        if f64(n) / power == magnitude:
            push_fixed(out, value < 0.0, n, k)
            return true
        power = power * 10.0
        k = k + 1
    false

# Appends `n / 10^k` in fixed notation, with at least one digit after the
# point: the bytes go in from the last, then the run is reversed.
fn push_fixed(out: &mut TextRoom, negative: bool, n: u64, k: usize) -> void:
    start := out.len
    let rest = n
    let place: usize = 0
    while place < k:
        out.push_byte(u8(rest % 10) + 48)
        rest = rest / 10
        place = place + 1
    if k == 0:
        out.push_byte(48)
    out.push_byte(46)
    out.push_byte(u8(rest % 10) + 48)
    rest = rest / 10
    while rest > 0:
        out.push_byte(u8(rest % 10) + 48)
        rest = rest / 10
    if negative:
        out.push_byte(45)
    out.reverse_bytes(start)

# The nesting levels a frame adds to the pretty text: a variant's
# `{"Variant": {` is two.
fn levels_of(kind: FrameKind) -> usize:
    match kind:
        .Tagged => 2
        .Named => 2
        _ => 1

# A key's length with its first and last bytes: equal keys have equal
# prints, and most different keys of one object do not.
fn key_print(key: string) -> usize:
    size := bytes_len(key)
    if size == 0:
        return 0
    size * 65536 + usize(bytes_at(key, 0)) * 256 + usize(bytes_at(key, size - 1))

# What an open container of the reader is.
enum ReadKind:
    # A list, read with `next_item`.
    Items
    # A map, read with `next_key`.
    Entries
    # A data type's object, read with `member`.
    Record
    # An enum variant's payload, read with `member`; its path adds `.Variant`.
    Tagged
    # An enum variant written as its name, with no payload.
    Unit

# Reads one `Json` for `from_json`. `value` is the value at the cursor, and
# `present` is false for a member whose key is missing.
#
# The cursor's path (r-std-json.error.path) is written out only for an
# error. Until then it is its first `depth` steps: step `i` is the item
# index `steps[i]`, or the key `names[i]` when `steps[i]` is -1. The open
# containers are a stack of `open` frames in parallel lists: the container,
# its kind, its next index (for a variant, the member index after the last
# one found), the path depth of its items' container, the depth to restore
# when it closes, and a variant's name. A variant frame's container is the
# payload object, or `null` for a variant written as its name. The stacks
# keep their slots when a frame closes, and the next frame reuses them.
struct JsonReader:
    pub value: Json
    pub present: bool
    pub depth: usize
    pub steps: List[i64]
    pub names: List[string]
    pub open: usize
    pub containers: List[Json]
    pub kinds: List[ReadKind]
    pub next: List[usize]
    pub bases: List[usize]
    pub homes: List[usize]
    pub variants: List[string]
    pub facts: List[Facts]
    # The facts of a list or a map frame, made once per reader.
    pub no_facts: Facts

impl JsonReader:
    fn new(value: Json) -> JsonReader:
        JsonReader {
            value: value,
            present: true,
            depth: 0,
            steps: [],
            names: [],
            open: 0,
            containers: [],
            kinds: [],
            next: [],
            bases: [],
            homes: [],
            variants: [],
            facts: [],
            no_facts: Facts { items: [] },
        }

    # The path of the first `depth` steps: `$`, then `.key` or `[index]`
    # for each.
    fn path_to(&self, depth: usize) -> string:
        let mut parts: List[string] = ["\$"]
        let index: usize = 0
        while index < depth:
            step := self.steps[index]
            if step < 0:
                parts.push(".")
                parts.push(self.names[index])
            else:
                parts.push("[$step]")
            index = index + 1
        concat_all(parts)

    # A missing key is a `MissingField`; any other value that does not fit
    # is a `WrongType` (r-std-json.derive.from-json.missing).
    fn fail(&self, expected: string) -> JsonError:
        path := self.path_to(self.depth)
        if !self.present:
            return JsonError.MissingField(path)
        JsonError.WrongType(path, expected)

    fn step_index(&mut self, slot: usize, index: usize) -> void:
        if slot < self.steps.len():
            self.steps[slot] = i64(index)
        else:
            self.steps.push(i64(index))
            self.names.push("")

    fn step_key(&mut self, slot: usize, key: string) -> void:
        if slot < self.steps.len():
            self.steps[slot] = -1
            self.names[slot] = key
        else:
            self.steps.push(-1)
            self.names.push(key)

    # Opens a frame whose items' container is at path depth `base`.
    fn enter(
        &mut self,
        container: Json,
        kind: ReadKind,
        base: usize,
        name: string,
        facts: Facts,
    ) -> void:
        let opened = container
        match kind:
            .Entries =>
                match container:
                    .Object(fields) =>
                        if fields.has_holes():
                            let mut dense = fields
                            dense.compact()
                            opened = Json.Object(dense)
                    _ => pass
            _ => pass
        at := self.open
        if at < self.containers.len():
            self.containers[at] = opened
            self.kinds[at] = kind
            self.next[at] = 0
            self.bases[at] = base
            self.homes[at] = self.depth
            self.variants[at] = name
            self.facts[at] = facts
        else:
            self.containers.push(opened)
            self.kinds.push(kind)
            self.next.push(0)
            self.bases.push(base)
            self.homes.push(self.depth)
            self.variants.push(name)
            self.facts.push(facts)
        self.open = at + 1

    # The innermost frame.
    fn top(&self) -> usize:
        if self.open == 0:
            panic("std.encoding.json: no open container")
        self.open - 1

    # Closes the innermost frame; the cursor's path is its container's
    # again.
    fn leave(&mut self) -> void:
        last := self.top()
        self.depth = self.homes[last]
        self.open = last

    # The item, or the map value, at `index` of the frame `last`, with its
    # path step.
    fn read_item(&mut self, last: usize, value: Json, index: usize) -> void:
        self.next[last] = index + 1
        self.value = value
        self.present = true
        base := self.bases[last]
        self.step_index(base, index)
        self.depth = base + 1

    # Moves the cursor to the member called `name` of the variant frame
    # `last`: its value, or absent. A decoder reads the members in
    # declaration order, which is most often the text's, so the entry after
    # the last one found is tried before a search.
    fn find_member(&mut self, last: usize, name: string) -> void:
        match self.containers[last]:
            .Object(fields) =>
                let at = self.next[last]
                let found: (string, Json)? = .None
                if at < fields.entries.len():
                    found = fields.entry_at(at)
                let same = false
                match found:
                    .Some((key, _)) => same = key == name
                    .None => pass
                if !same:
                    match fields.position(name):
                        .Some(slot) =>
                            at = slot
                            found = fields.entry_at(slot)
                        .None => found = .None
                match found:
                    .Some((_, value)) =>
                        self.next[last] = at + 1
                        self.value = value
                        self.present = true
                    .None =>
                        self.value = Json.Null
                        self.present = false
            _ =>
                self.value = Json.Null
                self.present = false

impl Deserializer for JsonReader:
    type Error = JsonError

    fn peek(&mut self) -> Result[ValueKind, JsonError]:
        if !self.present:
            return .Ok(ValueKind.Null)
        match self.value:
            .Null => .Ok(ValueKind.Null)
            .Bool(_) => .Ok(ValueKind.Bool)
            .Number(number) =>
                match number.repr:
                    .Negative(_) => .Ok(ValueKind.Int)
                    .NonNegative(found) =>
                        if found < sign_limit(): .Ok(ValueKind.Int) else: .Ok(ValueKind.Uint)
                    .Float(_) => .Ok(ValueKind.Float)
            .Text(_) => .Ok(ValueKind.Text)
            .Array(_) => .Ok(ValueKind.List)
            .Object(_) => .Ok(ValueKind.Map)

    # A missing key reads as `null` (r-std-json.derive.from-json.missing).
    fn is_null(&mut self) -> Result[bool, JsonError]:
        .Ok(!self.present || self.value.is_null())

    fn bool(&mut self, expected: string) -> Result[bool, JsonError]:
        if self.present:
            match self.value:
                .Bool(flag) => return .Ok(flag)
                _ => pass
        .Err(self.fail(expected))

    # A float is never an integer (r-std-json.std.integer.read).
    fn int(&mut self, expected: string) -> Result[i64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_i64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn uint(&mut self, expected: string) -> Result[u64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_u64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn float(&mut self, expected: string) -> Result[f64, JsonError]:
        if self.present:
            match self.value:
                .Number(number) =>
                    match number.as_f64():
                        .Some(found) => return .Ok(found)
                        .None => pass
                _ => pass
        .Err(self.fail(expected))

    fn text(&mut self, expected: string) -> Result[string, JsonError]:
        if self.present:
            match self.value:
                .Text(found) => return .Ok(found)
                _ => pass
        .Err(self.fail(expected))

    fn begin_list(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Array(_) =>
                    self.enter(self.value, ReadKind.Items, self.depth, "", self.no_facts)
                    return .Ok(())
                _ => pass
        .Err(self.fail("array"))

    # An item's path adds `[index]` (r-std-json.std.item-path). A map's
    # items are its values; a variant has none.
    fn next_item(&mut self) -> Result[bool, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            self.read_item(last, items[index], index)
                            return .Ok(true)
                    _ => pass
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        let found = index
                        while found < fields.entries.len():
                            match fields.entry_at(found):
                                .Some((key, value)) =>
                                    if self.variants[last] == "" || key != self.variants[last]:
                                        self.read_item(last, value, found)
                                        return .Ok(true)
                                .None => pass
                            found += 1
                    _ => pass
            _ => pass
        self.leave()
        .Ok(false)

    fn begin_map(&mut self) -> Result[void, JsonError]:
        if self.present:
            match self.value:
                .Object(_) =>
                    let name = ""
                    if self.open > 0:
                        last := self.top()
                        let tagged = false
                        match self.kinds[last]:
                            .Tagged => tagged = true
                            _ => pass
                        if tagged && !self.facts[last].items.is_empty():
                            match enum_tagging(self.facts[last]):
                                .Some(.Internal(_)) => name = self.variants[last]
                                _ => pass
                    self.enter(self.value, ReadKind.Entries, self.depth, name, self.no_facts)
                    return .Ok(())
                _ => pass
        .Err(self.fail("object"))

    # A map value's path adds `.key` (r-std-json.std.item-path). A list
    # has no keys, and a variant has none to iterate.
    fn next_key(&mut self) -> Result[string?, JsonError]:
        last := self.top()
        index := self.next[last]
        match self.kinds[last]:
            .Entries =>
                match self.containers[last]:
                    .Object(fields) =>
                        let found = index
                        while found < fields.entries.len():
                            match fields.entry_at(found):
                                .Some((key, value)) =>
                                    if self.variants[last] == "" || key != self.variants[last]:
                                        self.next[last] = found + 1
                                        self.value = value
                                        self.present = true
                                        base := self.bases[last]
                                        self.step_key(base, key)
                                        self.depth = base + 1
                                        return .Ok(.Some(key))
                                .None => pass
                            found += 1
                    _ => pass
            .Items =>
                match self.containers[last]:
                    .Array(items) =>
                        if index < items.len():
                            panic("std.encoding.json: next_key in a list")
                    _ => pass
            _ => pass
        self.leave()
        .Ok(.None)

    fn next_map_key(&mut self) -> Result[MapKeyValue?, JsonError]:
        match self.next_key()?:
            .Some(key) => .Ok(.Some(MapKeyValue.Text(key)))
            .None => .Ok(.None)

    fn begin_data(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if self.present:
            match self.value:
                .Object(_) =>
                    self.enter(self.value, ReadKind.Record, self.depth, "", facts)
                    return .Ok(0)
                _ => pass
        .Err(self.fail("object"))

    # A data type reads an object. An enum reads `"Variant"` as
    # `{"Variant": {}}`, or an object with exactly one key
    # (r-std-json.derive.from-json.enum).
    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, JsonError]:
        if choices.len() == 1 && choices[0].of_data:
            if self.present:
                match self.value:
                    .Object(_) =>
                        self.enter(self.value, ReadKind.Record, self.depth, "", facts)
                        return .Ok(0)
                    _ => pass
            return .Err(self.fail("object"))
        if !facts.items.is_empty():
            match enum_tagging(facts):
                .Some(.Internal(tag)) =>
                    if !self.present:
                        return .Err(self.fail("variant"))
                    object := self.value
                    fields := match object:
                        .Object(found) => found
                        _ => return .Err(self.fail("object"))
                    let tag_value: Json? = .None
                    let matches: usize = 0
                    for (key, value) in fields:
                        if key == tag:
                            matches += 1
                            if matches == 1:
                                tag_value = .Some(value)
                    if matches > 1:
                        return .Err(JsonError.DuplicateField(self.path_to(self.depth) + "." + tag))
                    depth := self.depth
                    self.step_key(depth, tag)
                    self.value = tag_value.unwrap_or(Json.Null)
                    self.present = tag_value.is_some()
                    self.depth = depth + 1
                    variant_name := match self.value:
                        .Text(found) => found
                        _ => return .Err(self.fail("variant tag"))
                    self.value = object
                    self.present = true
                    self.depth = depth
                    let index: usize = 0
                    while index < choices.len():
                        if choices[index].name == variant_name:
                            self.enter(object, ReadKind.Tagged, depth, tag, facts)
                            return .Ok(index)
                        index += 1
                    return .Err(JsonError.UnknownVariant(self.path_to(self.depth), variant_name))
                .Some(.Adjacent(tag, content)) =>
                    if !self.present:
                        return .Err(self.fail("variant"))
                    fields := match self.value:
                        .Object(found) => found
                        _ => return .Err(self.fail("object"))
                    depth := self.depth
                    tag_value := fields.get(tag)
                    self.step_key(depth, tag)
                    self.value = tag_value.unwrap_or(Json.Null)
                    self.present = tag_value.is_some()
                    self.depth = depth + 1
                    name := match self.value:
                        .Text(found) => found
                        _ => return .Err(self.fail("variant tag"))
                    self.depth = depth
                    let index: usize = 0
                    while index < choices.len():
                        if choices[index].name == name:
                            found := fields.get(content)
                            payload := found.unwrap_or(Json.Null)
                            self.step_key(depth, content)
                            self.present = found.is_some()
                            if (
                                !self.present
                                && (
                                    choices[index].named > 0
                                    || choices[index].included_positional > 0
                                )
                            ):
                                self.depth = depth + 1
                                return .Err(self.fail("variant content"))
                            self.enter(
                                payload,
                                if found.is_some(): ReadKind.Tagged else: ReadKind.Unit,
                                depth + 1,
                                content,
                                facts,
                            )
                            return .Ok(index)
                        index += 1
                    return .Err(JsonError.UnknownVariant(self.path_to(self.depth), name))
                .Some(.Untagged) => return .Err(self.fail("untagged variant attempt"))
                .None => pass
        if !self.present:
            return .Err(self.fail("variant"))
        let name = ""
        let payload = Json.Null
        let named = false
        match self.value:
            .Text(text) =>
                name = text
                named = true
            .Object(fields) =>
                if fields.len() != 1:
                    return .Err(self.fail("variant"))
                for (key, value) in fields:
                    name = key
                    payload = value
            _ => return .Err(self.fail("variant"))
        let index: usize = 0
        while index < choices.len():
            if choices[index].name == name:
                depth := self.depth
                self.step_key(depth, name)
                self.enter(
                    payload,
                    if named: ReadKind.Unit else: ReadKind.Tagged,
                    depth + 1,
                    name,
                    facts,
                )
                return .Ok(index)
            index = index + 1
        .Err(JsonError.UnknownVariant(self.path_to(self.depth), name))

    fn begin_newtype_variant(&mut self) -> Result[void, JsonError]:
        last := self.top()
        match self.kinds[last]:
            .Tagged =>
                if !self.facts[last].items.is_empty():
                    match enum_tagging(self.facts[last]):
                        .Some(.Internal(_)) =>
                            self.value = self.containers[last]
                            self.present = true
                            self.depth = self.bases[last]
                            return .Ok(())
                        _ => pass
                self.kinds[last] = ReadKind.Unit
                if self.present:
                    self.next[last] = 1
                    self.value = self.containers[last]
                    self.depth = self.bases[last]
                    return .Ok(())
            _ => pass
        .Err(self.fail("newtype variant"))

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, JsonError]:
        last := self.top()
        base := self.bases[last]
        self.depth = base
        match self.kinds[last]:
            .Tagged =>
                match self.containers[last]:
                    .Array(items) =>
                        if items.len() == len:
                            self.kinds[last] = ReadKind.Items
                            self.next[last] = 0
                            return .Ok(())
                    _ => pass
            _ => pass
        .Err(self.fail("array of $len items"))

    # A member reads the value of its key; a missing key is absent
    # (r-std-json.derive.from-json.member-wire-name). A list or a map has no members.
    fn member(&mut self, m: &Member) -> Result[void, JsonError]:
        last := self.top()
        name := member_name(m, self.facts[last])
        base := self.bases[last]
        match self.kinds[last]:
            .Record => self.find_member(last, name)
            .Tagged =>
                let internal = false
                if !self.facts[last].items.is_empty():
                    match enum_tagging(self.facts[last]):
                        .Some(.Internal(_)) => internal = true
                        _ => pass
                if internal:
                    self.find_member(last, name)
                else:
                    self.step_key(base - 1, self.variants[last])
                    match self.containers[last]:
                        .Object(_) => self.find_member(last, name)
                        _ => return .Err(JsonError.WrongType(self.path_to(base), "object"))
            _ =>
                self.value = Json.Null
                self.present = false
        self.step_key(base, name)
        self.depth = base + 1
        .Ok(())

    fn end_data(&mut self) -> Result[void, JsonError]:
        self.leave()
        .Ok(())

    fn end_variant(&mut self) -> Result[void, JsonError]:
        last := self.top()
        match self.kinds[last]:
            .Tagged =>
                match self.containers[last]:
                    .Object(_) => pass
                    _ =>
                        base := self.bases[last]
                        self.step_key(base - 1, self.variants[last])
                        return .Err(JsonError.WrongType(self.path_to(base), "object"))
            _ => pass
        self.leave()
        .Ok(())

    fn invalid(&mut self, expected: string) -> JsonError:
        self.fail(expected)

    # A missing key is absent, so a member with a declared default takes
    # it (r-std-json.derive.from-json.default).
    fn is_absent(&mut self) -> bool:
        !self.present

# The tree path of `encode` and `encode_pretty`, out of line: `@cold`
# keeps the inliner from copying it into the encoder, and a `T` whose
# `regular()` holds never calls it. These stay last so no existing item ID
# changes.
@cold
fn encode_fallback[T < Serialize](value: T) -> string:
    "${to_json(value)}"

@cold
fn encode_pretty_fallback[T < Serialize](value: T) -> string:
    to_json(value).pretty()

# ---------------------------------------------------------------------------
# The one-pass decode (r-std-json.decode.direct.v2). `StreamReader` reads the
# text once, in order, and checks each byte it passes as `parse` does. It
# is a keyed reader (r-std-serde.read.keyed): a record's keys come in text
# order through `next_field`, which matches each key to a member without
# copying it and skips the value of a key that names no member. A member
# the record never names is read as absent. Its errors are `parse`'s
# errors and the typed errors with their paths; `decode` lets a syntax
# error anywhere in the text win over them.

# What an open container of the stream reader is, and how it closes.
enum StreamKind:
    # A list, closed by `]`.
    Items
    # A map, closed by `}`.
    Entries
    # A data type's object, or an internally tagged record or unit
    # variant's object: its remaining keys are skipped, then `}`.
    Record
    # An externally tagged variant's one-key object before its payload,
    # closed by `}`.
    Variant
    # A named variant's payload object and its variant object: `}}`.
    VariantRecord
    # A tuple variant's payload list and its variant object: `]}`.
    VariantTuple
    # A variant written as its name, with nothing to close.
    Unit
    # An internally tagged newtype variant's object, which its payload's
    # record or map frame reads and closes.
    Internal
    # An adjacently tagged variant's object, at its content value.
    Adjacent
    # An adjacently tagged named variant's payload object, then the
    # variant object.
    AdjacentRecord
    # An adjacently tagged tuple variant's payload list, then the variant
    # object.
    AdjacentTuple
    # An adjacently tagged variant with no payload: its object only.
    AdjacentUnit

# The open containers are a stack of `open` frames in parallel lists, kept
# when a frame closes and reused by the next frame at that depth: each
# frame's kind, whether its next item is its first, its item count, and
# its path step (an item index, or -1 with the key in `names`). `nest`
# counts the open brackets, which `parse` limits to 128.
#
# A tagged frame (an internally or adjacently tagged variant's object, and
# the record or map that reads an internal newtype's payload in the same
# object) has its tag key in `tags` and that key's quote offset in
# `tag_ats`; every other frame has `no_offset()` there. The key loop passes
# over the tag key read at that offset, and any other key that spells the
# tag is `DuplicateField`. An adjacent frame also has its content key in
# `contents`, the content key's quote in `content_ats` once read, and in
# `ends` the offset after its closing brace when the whole object was
# scanned to find the tag, or `no_offset()`.
struct StreamReader:
    pub parser: Parser
    pub kinds: List[StreamKind]
    pub firsts: List[bool]
    pub counts: List[usize]
    pub steps: List[i64]
    pub names: List[string]
    # A variant frame's variant name, which its path step follows.
    pub variants: List[string]
    # A tuple variant frame's declared item count.
    pub arities: List[usize]
    # Each record frame's name table in `tables`, or `no_offset`.
    pub frame_tables: List[usize]
    # A record or variant frame's container facts, for `member`'s wire
    # names; set by `begin_data` and `begin_variant`, never reset.
    pub frame_facts: List[Facts]
    pub tag_ats: List[usize]
    pub tags: List[string]
    pub contents: List[string]
    pub content_ats: List[usize]
    pub ends: List[usize]
    # The name tables of the record types met so far, each a map from a
    # wire name to its member's index, found by the type's member
    # directory id (`MembersRecord.id`).
    pub tables: List[Map[string, usize]]
    pub by_id: Map[usize, usize]
    pub open: usize
    pub nest: usize
    # The value at the cursor is a member's absent value (`absent_field`).
    pub absent: bool
    # A slot's value is due and no read has started it: a `deserialize`
    # that reads nothing (as `peek` alone) leaves it, and the next slot or
    # the close skips it, so each slot still moves past one value.
    pub pending: bool
    # The value at the cursor is an internal newtype's payload: the rest of
    # the open tagged object, whose `{` is already read.
    pub inner: bool
    # Whether the key `next_quote` last returned has no escape.
    pub plain: bool
    # Keys whose guess missed, counted up to `table_after()`.
    pub misses: usize

impl StreamReader:
    fn new(text: string) -> StreamReader:
        StreamReader {
            parser: Parser { text: text, size: bytes_len(text), at: 0 },
            kinds: [],
            firsts: [],
            counts: [],
            steps: [],
            names: [],
            variants: [],
            arities: [],
            frame_tables: [],
            frame_facts: [],
            tag_ats: [],
            tags: [],
            contents: [],
            content_ats: [],
            ends: [],
            tables: [],
            by_id: {},
            open: 0,
            nest: 0,
            absent: false,
            # The top-level value is due like a slot's.
            pending: true,
            inner: false,
            plain: true,
            misses: 0,
        }

    # Whether the walk read the one value, closed every container, and only
    # whitespace follows.
    fn finish(&mut self) -> bool:
        if self.pending || self.open != 0:
            return false
        self.parser.skip_space()
        self.parser.at >= self.parser.size

    fn path(&self) -> string:
        let mut parts: List[string] = ["\$"]
        let index: usize = 0
        while index < self.open:
            if bytes_len(self.variants[index]) > 0:
                parts.push("." + self.variants[index])
            step := self.steps[index]
            if step < 0:
                if bytes_len(self.names[index]) > 0:
                    parts.push("." + self.names[index])
            else:
                parts.push("[$step]")
            index = index + 1
        concat_all(parts)

    fn fail(&mut self, expected: string) -> JsonError:
        if self.absent:
            self.absent = false
            return JsonError.MissingField(self.path())
        JsonError.WrongType(self.path(), expected)

    # The error at frame `top`'s key `name`.
    fn at_key(&mut self, top: usize, name: string) -> void:
        self.steps[top] = -1
        self.names[top] = name

    # The byte after any whitespace at the cursor, or 0 at the end.
    fn byte(&mut self) -> u8:
        self.parser.skip_space()
        if self.parser.at < self.parser.size:
            return bytes_at(self.parser.text, self.parser.at)
        0

    fn unexpected(&self) -> JsonError:
        self.parser.unexpected(self.parser.at)

    # The first byte of the value at the cursor; a byte that starts no
    # value is a syntax error. An internal newtype's payload is the open
    # object, so it starts with `{`.
    fn value_byte(&mut self, expected: string) -> Result[u8, JsonError]:
        if self.absent:
            return .Err(self.fail(expected))
        if self.inner:
            return .Ok(123)
        self.pending = false
        byte := self.byte()
        if (
            byte == 34
            || byte == 91
            || byte == 123
            || byte == 116
            || byte == 102
            || byte == 110
            || byte == 45
            || is_digit(byte)
        ):
            return .Ok(byte)
        .Err(self.unexpected())

    # Moves past `byte`, after any whitespace.
    fn expect(&mut self, byte: u8) -> Result[void, JsonError]:
        if self.byte() != byte:
            return .Err(self.unexpected())
        self.parser.at = self.parser.at + 1
        .Ok(())

    # Opens the bracket at the cursor.
    fn bracket(&mut self, byte: u8) -> Result[void, JsonError]:
        if self.nest >= 128:
            return .Err(JsonError.NestingTooDeep(self.parser.at))
        self.expect(byte)?
        self.nest = self.nest + 1
        .Ok(())

    fn close(&mut self, byte: u8) -> Result[void, JsonError]:
        self.expect(byte)?
        self.nest = self.nest - 1
        .Ok(())

    fn push(&mut self, kind: StreamKind) -> void:
        at := self.open
        if at < self.kinds.len():
            self.kinds[at] = kind
            self.firsts[at] = true
            self.counts[at] = 0
            self.steps[at] = -1
            self.names[at] = ""
            self.variants[at] = ""
            self.arities[at] = 0
            self.frame_tables[at] = no_offset()
            self.tag_ats[at] = no_offset()
        else:
            self.kinds.push(kind)
            self.firsts.push(true)
            self.counts.push(0)
            self.steps.push(-1)
            self.names.push("")
            self.variants.push("")
            self.arities.push(0)
            self.frame_tables.push(no_offset())
            self.frame_facts.push(Facts { items: [] })
            self.tag_ats.push(no_offset())
            self.tags.push("")
            self.contents.push("")
            self.content_ats.push(no_offset())
            self.ends.push(no_offset())
        self.open = at + 1

    # Opens an object: at the cursor, or the open tagged object for an
    # internal newtype's payload, which then shares that object's keys,
    # tag and first-key state.
    fn open_object(&mut self, kind: StreamKind) -> Result[void, JsonError]:
        if self.inner:
            self.inner = false
            parent := self.open - 1
            self.push(kind)
            top := self.open - 1
            self.firsts[top] = self.firsts[parent]
            self.tag_ats[top] = self.tag_ats[parent]
            self.tags[top] = self.tags[parent]
            return .Ok(())
        self.bracket(123)?
        self.push(kind)
        .Ok(())

    fn top(&self) -> usize:
        if self.open == 0:
            panic("std.encoding.json: no open container")
        self.open - 1

    # A tuple variant's payload with another item count, at the variant.
    fn tuple_error(&mut self, top: usize) -> JsonError:
        self.steps[top] = -1
        self.names[top] = ""
        self.open = top + 1
        JsonError.WrongType(self.path(), "array of ${self.arities[top]} items")

    # Checks and passes over one value at the cursor.
    fn pass_value(&mut self) -> Result[void, JsonError]:
        self.parser.skip_space()
        self.parser.validate(self.nest)

    # Skips a due value that no read started.
    fn settle(&mut self) -> Result[void, JsonError]:
        if self.pending:
            self.pending = false
            self.pass_value()?
        .Ok(())

    # The comma before every member or item of frame `top` but its first.
    fn next_slot(&mut self, top: usize) -> Result[void, JsonError]:
        self.settle()?
        if self.firsts[top]:
            self.firsts[top] = false
            return .Ok(())
        self.expect(44)

    # The quote offset of frame `top`'s next key, with the cursor after the
    # key's closing quote, or `.None` at the closing brace. It passes over
    # the frame's tag key that was read already, value and all; another key
    # that spells the tag is `DuplicateField` at the tag.
    fn next_quote(&mut self, top: usize) -> Result[usize?, JsonError]:
        while true:
            self.settle()?
            if self.byte() == 125:
                return .Ok(.None)
            self.next_slot(top)?
            if self.byte() != 34:
                return .Err(self.unexpected())
            quote := self.parser.at
            self.plain = self.parser.validate_string()?
            tag_at := self.tag_ats[top]
            if tag_at == no_offset() || !self.parser.key_is(quote, self.tags[top])?:
                return .Ok(.Some(quote))
            if quote != tag_at:
                self.at_key(top, self.tags[top])
                return .Err(JsonError.DuplicateField(self.path()))
            self.expect(58)?
            self.pass_value()?
        .Ok(.None)

    # Skips the remaining keys of record frame `top` and its `}`.
    fn close_record(&mut self, top: usize) -> Result[void, JsonError]:
        while self.next_quote(top)?.is_some():
            self.expect(58)?
            self.pass_value()?
        self.close(125)

    # A key and its colon, copied.
    fn key(&mut self) -> Result[string, JsonError]:
        if self.byte() != 34:
            return .Err(self.unexpected())
        key := self.parser.string()?
        self.expect(58)?
        .Ok(key)

    fn number(&mut self, expected: string) -> Result[Number, JsonError]:
        byte := self.value_byte(expected)?
        if byte == 45 || is_digit(byte):
            match self.parser.number()?:
                .Number(number) => return .Ok(number)
                _ => pass
        .Err(self.fail(expected))

    # The index of the member whose wire name the validated key at `quote`
    # spells: `guess` first, then each member whose name has the key's
    # length, or `members.len()` when none does.
    fn match_key(
        &mut self,
        quote: usize,
        members: &List[Member],
        id: usize,
        facts: Facts,
        guess: usize,
    ) -> Result[usize, JsonError]:
        count := members.len()
        plain := self.plain
        length := self.parser.at - quote - 2
        if guess < count && named(&members[guess]):
            name := member_name(&members[guess], facts)
            if (!plain || bytes_len(name) == length) && self.parser.key_is(quote, name)?:
                return .Ok(guess)
        # A small type, or the first misses of a decode, scan the members by
        # name length: cheaper than building a table that a short text
        # would barely use. Past `table_after` misses, each type with more
        # than 8 members gets its table, so the scans cost at most
        # `table_after` times the widest type per decode.
        if (
            count <= 8
            || (self.misses < table_after() && self.frame_tables[self.open - 1] == no_offset())
        ):
            if count > 8:
                self.misses = self.misses + 1
            let k: usize = 0
            while k < count:
                if k != guess && named(&members[k]):
                    name := member_name(&members[k], facts)
                    if (!plain || bytes_len(name) == length) && self.parser.key_is(quote, name)?:
                        return .Ok(k)
                k = k + 1
            return .Ok(count)
        # More members: one hash lookup in the type's name table.
        table := self.table_for(members, id, facts)
        end := self.parser.at
        key := self.parser.key_at(quote)?
        self.parser.at = end
        match self.tables[table].get(key):
            .Some(k) => .Ok(k)
            .None => .Ok(count)

    # The name table of the open record's type: the frame's, or one made
    # once per type per decode, found by the type's directory id.
    fn table_for(&mut self, members: &List[Member], id: usize, facts: Facts) -> usize:
        top := self.open - 1
        known := self.frame_tables[top]
        if known != no_offset():
            return known
        match self.by_id.get(id):
            .Some(found) =>
                self.frame_tables[top] = found
                return found
            .None => pass
        let mut index: Map[string, usize] = {}
        let k: usize = 0
        while k < members.len():
            if named(&members[k]):
                index[member_name(&members[k], facts)] = k
            k = k + 1
        self.tables.push(index)
        made := self.tables.len() - 1
        self.by_id[id] = made
        self.frame_tables[top] = made
        made

    # A record variant's frame, ready for its keys: an externally tagged
    # variant object opens its payload object, an adjacent one its content
    # object; a variant with no keys gives false.
    fn record_frame(&mut self, top: usize) -> Result[bool, JsonError]:
        match self.kinds[top]:
            .Record => pass
            .VariantRecord => pass
            .AdjacentRecord => pass
            .Variant =>
                if self.value_byte("object")? != 123:
                    return .Err(self.fail("object"))
                self.bracket(123)?
                self.kinds[top] = StreamKind.VariantRecord
                self.firsts[top] = true
            .Adjacent =>
                if self.value_byte("object")? != 123:
                    return .Err(self.fail("object"))
                self.bracket(123)?
                self.kinds[top] = StreamKind.AdjacentRecord
                self.firsts[top] = true
                self.tag_ats[top] = no_offset()
            # A unit variant has no keys.
            _ => return .Ok(false)
        .Ok(true)

    # The variant whose wire name the tag value at the cursor spells, for
    # an internally or adjacently tagged object at frame `top`.
    fn tag_variant(
        &mut self,
        top: usize,
        quote: usize,
        choices: &List[VariantInfo],
    ) -> Result[usize, JsonError]:
        self.at_key(top, self.tags[top])
        if self.byte() != 34:
            return .Err(self.fail("variant tag"))
        name := self.parser.string()?
        self.tag_ats[top] = quote
        self.at_key(top, "")
        choose(choices, name, self)

    # Finds the internal tag of the object just opened at frame `top`: the
    # first key (the fast path, one pass), or a later one, found by
    # checking and passing over the keys before it and then going back to
    # the first key. The record then reads every key but the tag.
    fn internal_tag(&mut self, top: usize, choices: &List[VariantInfo]) -> Result[usize, JsonError]:
        start := self.parser.at
        let first = true
        while true:
            if self.byte() == 125:
                self.at_key(top, self.tags[top])
                self.absent = true
                return .Err(self.fail("variant tag"))
            self.next_slot(top)?
            if self.byte() != 34:
                return .Err(self.unexpected())
            quote := self.parser.at
            _ := self.parser.validate_string()?
            is_tag := self.parser.key_is(quote, self.tags[top])?
            self.expect(58)?
            if is_tag:
                index := self.tag_variant(top, quote, choices)?
                if !first:
                    self.parser.at = start
                    self.firsts[top] = true
                return .Ok(index)
            first = false
            self.pass_value()?
        .Ok(0)

    # Finds the adjacent tag of the object just opened at frame `top`.
    # When the tag is the first key, the content is read where it is
    # (`adjacent_content`); otherwise the whole object is checked once to
    # find both keys, the content is read at its offset, and the close
    # jumps past the object (`ends`).
    fn adjacent_tag(&mut self, top: usize, choices: &List[VariantInfo]) -> Result[usize, JsonError]:
        let found = no_offset()
        let content = no_offset()
        let first = true
        while true:
            if self.byte() == 125:
                break
            self.next_slot(top)?
            if self.byte() != 34:
                return .Err(self.unexpected())
            quote := self.parser.at
            _ := self.parser.validate_string()?
            if self.parser.key_is(quote, self.tags[top])?:
                self.expect(58)?
                if found != no_offset():
                    self.at_key(top, self.tags[top])
                    return .Err(JsonError.DuplicateField(self.path()))
                found = self.tag_variant(top, quote, choices)?
                if first:
                    return .Ok(found)
            else if self.parser.key_is(quote, self.contents[top])?:
                self.expect(58)?
                if content != no_offset():
                    self.at_key(top, self.contents[top])
                    return .Err(JsonError.DuplicateField(self.path()))
                self.parser.skip_space()
                content = self.parser.at
                self.content_ats[top] = quote
                self.pass_value()?
            else:
                self.expect(58)?
                self.pass_value()?
            first = false
        if found == no_offset():
            self.at_key(top, self.tags[top])
            self.absent = true
            return .Err(self.fail("variant tag"))
        self.parser.at = self.parser.at + 1
        self.ends[top] = self.parser.at
        if content != no_offset():
            self.parser.at = content
        else:
            self.absent = true
        .Ok(found)

    # After a first-key adjacent tag: moves to the content value, passing
    # over unknown keys; a missing content key reads as absent.
    fn adjacent_content(&mut self, top: usize) -> Result[void, JsonError]:
        while true:
            match self.next_quote(top)?:
                .Some(quote) =>
                    is_content := self.parser.key_is(quote, self.contents[top])?
                    self.expect(58)?
                    if is_content:
                        self.content_ats[top] = quote
                        return .Ok(())
                    self.pass_value()?
                .None =>
                    self.absent = true
                    return .Ok(())
        .Ok(())

    # Closes an adjacently tagged object at frame `top`: past its end when
    # it was scanned whole, else its remaining keys, where a second content
    # key is `DuplicateField`.
    fn close_adjacent(&mut self, top: usize) -> Result[void, JsonError]:
        self.absent = false
        if self.ends[top] != no_offset():
            self.parser.at = self.ends[top]
            self.nest = self.nest - 1
            return .Ok(())
        # The tag was the first key, so any later key that spells it is a
        # second tag; offset 0 is never a key's quote.
        self.tag_ats[top] = 0
        self.firsts[top] = false
        self.variants[top] = ""
        while true:
            match self.next_quote(top)?:
                .Some(quote) =>
                    if self.parser.key_is(quote, self.contents[top])?:
                        if self.content_ats[top] != no_offset():
                            self.at_key(top, self.contents[top])
                            return .Err(JsonError.DuplicateField(self.path()))
                        self.content_ats[top] = quote
                    self.expect(58)?
                    self.pass_value()?
                .None => break
        self.close(125)

# The index of the variant named `name`, or `UnknownVariant` at the
# reader's path.
fn choose(
    choices: &List[VariantInfo],
    name: string,
    reader: &mut StreamReader,
) -> Result[usize, JsonError]:
    let index: usize = 0
    while index < choices.len():
        if choices[index].name == name:
            return .Ok(index)
        index = index + 1
    .Err(JsonError.UnknownVariant(reader.path(), name))

# Key misses per decode answered by a scan before name tables are built.
fn table_after() -> usize:
    64

fn no_offset() -> usize:
    0xFFFF_FFFF

# A member that a key can name: one without `Skip`.
fn named(m: &Member) -> bool:
    m.facts.items.is_empty() || m.facts.find::[Skip]().is_none()

# A variant with nothing to read: no included positional and no named
# member.
fn payload_free(info: &VariantInfo) -> bool:
    info.named == 0 && info.included_positional == 0

impl Deserializer for StreamReader:
    type Error = JsonError

    fn peek(&mut self) -> Result[ValueKind, JsonError]:
        if self.absent:
            return .Ok(ValueKind.Null)
        due := self.pending
        byte := self.value_byte("value")?
        self.pending = due
        if byte == 110:
            return .Ok(ValueKind.Null)
        if byte == 116 || byte == 102:
            return .Ok(ValueKind.Bool)
        if byte == 34:
            return .Ok(ValueKind.Text)
        if byte == 91:
            return .Ok(ValueKind.List)
        if byte == 123:
            return .Ok(ValueKind.Map)
        at := self.parser.at
        number := self.number("number")?
        self.parser.at = at
        self.pending = due
        match number.repr:
            .Negative(_) => .Ok(ValueKind.Int)
            .NonNegative(found) =>
                .Ok(if found < sign_limit(): ValueKind.Int else: ValueKind.Uint)
            .Float(_) => .Ok(ValueKind.Float)

    fn is_null(&mut self) -> Result[bool, JsonError]:
        if self.absent:
            self.absent = false
            return .Ok(true)
        due := self.pending
        if self.value_byte("null")? != 110:
            self.pending = due
            return .Ok(false)
        self.parser.validate_word("null")?
        .Ok(true)

    fn bool(&mut self, expected: string) -> Result[bool, JsonError]:
        byte := self.value_byte(expected)?
        if byte == 116:
            self.parser.validate_word("true")?
            return .Ok(true)
        if byte == 102:
            self.parser.validate_word("false")?
            return .Ok(false)
        .Err(self.fail(expected))

    fn int(&mut self, expected: string) -> Result[i64, JsonError]:
        match self.number(expected)?.as_i64():
            .Some(value) => .Ok(value)
            .None => .Err(self.fail(expected))

    fn uint(&mut self, expected: string) -> Result[u64, JsonError]:
        match self.number(expected)?.as_u64():
            .Some(value) => .Ok(value)
            .None => .Err(self.fail(expected))

    fn float(&mut self, expected: string) -> Result[f64, JsonError]:
        match self.number(expected)?.repr:
            .Negative(value) => .Ok(f64(value))
            .NonNegative(value) => .Ok(f64(value))
            .Float(value) => .Ok(value)

    fn text(&mut self, expected: string) -> Result[string, JsonError]:
        if self.value_byte(expected)? != 34:
            return .Err(self.fail(expected))
        self.parser.string()

    fn begin_list(&mut self) -> Result[void, JsonError]:
        if self.value_byte("array")? != 91:
            return .Err(self.fail("array"))
        self.bracket(91)?
        self.push(StreamKind.Items)
        .Ok(())

    # In a map or a record, the values are the items, as `from_json`'s
    # reader gives them; in a variant with no list, there is none.
    fn next_item(&mut self) -> Result[bool, JsonError]:
        top := self.top()
        let list = false
        match self.kinds[top]:
            .Items => list = true
            .VariantTuple => pass
            .AdjacentTuple => pass
            .Entries => return self.next_value(top)
            .Record => return self.next_value(top)
            _ =>
                self.end_variant()?
                return .Ok(false)
        self.settle()?
        if self.byte() == 93:
            if !list:
                return .Err(self.tuple_error(top))
            self.close(93)?
            self.open = top
            return .Ok(false)
        self.next_slot(top)?
        self.steps[top] = i64(self.counts[top])
        self.counts[top] = self.counts[top] + 1
        self.pending = true
        .Ok(true)

    fn begin_map(&mut self) -> Result[void, JsonError]:
        if self.value_byte("object")? != 123:
            return .Err(self.fail("object"))
        self.open_object(StreamKind.Entries)

    # A repeated key comes again; the map keeps its first place and its
    # last value (r-std-json.parse.object.duplicate-last).
    fn next_key(&mut self) -> Result[string?, JsonError]:
        top := self.top()
        match self.kinds[top]:
            .Entries => pass
            .Record => pass
            .Items =>
                self.settle()?
                if self.byte() != 93:
                    panic("std.encoding.json: next_key in a list")
                self.end_variant()?
                return .Ok(.None)
            _ =>
                self.end_variant()?
                return .Ok(.None)
        match self.next_quote(top)?:
            .Some(quote) =>
                key := self.parser.key_at(quote)?
                self.expect(58)?
                self.steps[top] = -1
                self.names[top] = key
                self.pending = true
                .Ok(.Some(key))
            .None =>
                self.close(125)?
                self.open = top
                .Ok(.None)

    fn begin_data(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, JsonError]:
        if self.value_byte("object")? != 123:
            return .Err(self.fail("object"))
        self.open_object(StreamKind.Record)?
        self.frame_facts[self.open - 1] = facts
        .Ok(0)

    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, JsonError]:
        if !facts.items.is_empty():
            match enum_tagging(facts):
                .Some(tagging) => return self.begin_tagged(facts, choices, tagging)
                .None => pass
        if self.inner:
            return .Err(self.fail("variant"))
        byte := self.value_byte("variant")?
        let object = false
        if byte == 123:
            object = true
            self.bracket(123)?
            if self.byte() == 125:
                return .Err(self.fail("variant"))
        else if byte != 34:
            return .Err(self.fail("variant"))
        name := if object: self.key()? else: self.parser.string()?
        index := choose(&choices, name, self)?
        info := choices[index]
        # The frame goes first, so a payload error's path has the variant.
        # A variant object's payload form is fixed by the next call: a
        # newtype reads it directly, a tuple opens a list, and a record's
        # first `next_field` opens an object.
        self.push(if object: StreamKind.Variant else: StreamKind.Unit)
        top := self.open - 1
        self.variants[top] = name
        self.frame_facts[top] = facts
        if !object:
            # A name alone: its members are absent.
            if info.included_positional > 0 && info.named == 0:
                if info.included_positional == 1:
                    return .Err(self.fail("object"))
                self.arities[top] = info.included_positional
                return .Err(self.tuple_error(top))
        else:
            self.pending = true
        .Ok(index)

    fn begin_newtype_variant(&mut self) -> Result[void, JsonError]:
        top := self.top()
        match self.kinds[top]:
            .Internal => self.inner = true
            _ => pass
        .Ok(())

    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, JsonError]:
        top := self.top()
        self.arities[top] = len
        if self.value_byte("array")? != 91:
            return .Err(self.tuple_error(top))
        self.bracket(91)?
        self.firsts[top] = true
        match self.kinds[top]:
            .Adjacent => self.kinds[top] = StreamKind.AdjacentTuple
            _ => self.kinds[top] = StreamKind.VariantTuple
        .Ok(())

    # Positions a hand-written record walk at member `m`'s value when the
    # record's next key names it; otherwise `m` reads as absent and the key
    # stays for a later member. A keyed reader names members in text order,
    # so this walk honours keys in declaration order only.
    fn member(&mut self, m: &Member) -> Result[void, JsonError]:
        self.absent = false
        top := self.top()
        name := member_name(m, self.frame_facts[top])
        if self.record_frame(top)?:
            self.settle()?
            at := self.parser.at
            first := self.firsts[top]
            match self.next_quote(top)?:
                .Some(quote) =>
                    if self.parser.key_is(quote, name)?:
                        self.expect(58)?
                        self.at_key(top, name)
                        self.pending = true
                        return .Ok(())
                    self.parser.at = at
                    self.firsts[top] = first
                .None => pass
        self.at_key(top, name)
        self.absent = true
        .Ok(())

    fn keyed(&self) -> bool:
        true

    fn next_field(
        &mut self,
        members: &List[Member],
        id: usize,
        facts: Facts,
        guess: usize,
    ) -> Result[usize?, JsonError]:
        self.absent = false
        top := self.top()
        if !self.record_frame(top)?:
            return .Ok(.None)
        while true:
            match self.next_quote(top)?:
                .Some(quote) =>
                    k := self.match_key(quote, members, id, facts, guess)?
                    self.expect(58)?
                    if k < members.len():
                        self.steps[top] = -1
                        self.names[top] = member_name(&members[k], facts)
                        self.pending = true
                        return .Ok(.Some(k))
                    # A key that names no member: its value is checked and
                    # skipped.
                    self.pass_value()?
                .None => return .Ok(.None)
        .Ok(.None)

    fn absent_field(&mut self, m: &Member, facts: Facts) -> void:
        top := self.top()
        self.steps[top] = -1
        self.names[top] = member_name(m, facts)
        self.absent = true

    fn is_absent(&mut self) -> bool:
        self.absent

    fn end_data(&mut self) -> Result[void, JsonError]:
        self.end_variant()

    fn end_variant(&mut self) -> Result[void, JsonError]:
        self.absent = false
        self.settle()?
        top := self.top()
        match self.kinds[top]:
            .Record => self.close_record(top)?
            .Variant => self.close_variant(top)?
            .VariantRecord =>
                self.close_record(top)?
                self.close_variant(top)?
            .VariantTuple =>
                if self.byte() == 44:
                    return .Err(self.tuple_error(top))
                self.close(93)?
                self.close_variant(top)?
            .Unit => pass
            .Items =>
                while true:
                    self.settle()?
                    if self.byte() == 93:
                        break
                    self.next_slot(top)?
                    self.pass_value()?
                self.close(93)?
            .Entries => self.close_record(top)?
            # The payload's frame read and closed the object, unless the
            # payload read nothing.
            .Internal =>
                if self.inner:
                    self.inner = false
                    self.close_record(top)?
            .Adjacent => self.close_adjacent(top)?
            .AdjacentUnit => self.close_adjacent(top)?
            .AdjacentRecord =>
                self.close_record(top)?
                self.close_adjacent(top)?
            .AdjacentTuple =>
                if self.byte() == 44:
                    return .Err(self.tuple_error(top))
                self.close(93)?
                self.close_adjacent(top)?
        self.open = top
        .Ok(())

    fn invalid(&mut self, expected: string) -> JsonError:
        self.fail(expected)

    # The key just named repeats one of the record's earlier keys
    # (r-std-json.derive.duplicate-field); the path ends at that member.
    fn duplicate_field(&mut self) -> JsonError:
        JsonError.DuplicateField(self.path())

    # One value of any kind, checked as `parse` checks it and dropped.
    fn skip(&mut self) -> Result[void, JsonError]:
        _ := self.value_byte("value")?
        if self.inner:
            self.inner = false
            return self.close_record(self.open - 1)
        self.pass_value()

impl StreamReader:
    # The next value of map or record frame `top` as an item, or false
    # after its last, closing it.
    fn next_value(&mut self, top: usize) -> Result[bool, JsonError]:
        match self.next_quote(top)?:
            .Some(_) =>
                self.expect(58)?
                self.steps[top] = i64(self.counts[top])
                self.counts[top] = self.counts[top] + 1
                self.pending = true
                .Ok(true)
            .None =>
                self.close(125)?
                self.open = top
                .Ok(false)

    # Closes a variant object. A second key is a typed error at the
    # variant object: one pass reads the first key's payload only.
    fn close_variant(&mut self, top: usize) -> Result[void, JsonError]:
        if self.byte() == 44:
            self.open = top
            return .Err(self.fail("variant"))
        self.close(125)

    # An internally or adjacently tagged variant (r-std-json.derive.internal.read,
    # r-std-json.derive.adjacent.read). The tag key is found in the object
    # without copying the object; untagged enums never come here, since
    # derived code tries each payload shape itself.
    fn begin_tagged(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
        tagging: EnumTagging,
    ) -> Result[usize, JsonError]:
        match tagging:
            .Untagged => return .Err(self.fail("untagged variant attempt"))
            _ => pass
        if self.value_byte("object")? != 123:
            return .Err(self.fail("object"))
        let index: usize = 0
        match tagging:
            .Internal(tag) =>
                self.open_object(StreamKind.Record)?
                top := self.open - 1
                self.frame_facts[top] = facts
                self.tags[top] = tag
                index = self.internal_tag(top, &choices)?
                if choices[index].included_positional == 1 && choices[index].named == 0:
                    self.kinds[top] = StreamKind.Internal
            .Adjacent(tag, content) =>
                if self.inner:
                    return .Err(self.fail("variant"))
                self.bracket(123)?
                self.push(StreamKind.Adjacent)
                top := self.open - 1
                self.frame_facts[top] = facts
                self.tags[top] = tag
                self.contents[top] = content
                self.content_ats[top] = no_offset()
                self.ends[top] = no_offset()
                index = self.adjacent_tag(top, &choices)?
                if payload_free(&choices[index]):
                    self.kinds[top] = StreamKind.AdjacentUnit
                    self.absent = false
                else:
                    if self.ends[top] == no_offset():
                        self.adjacent_content(top)?
                    # The payload's path goes through the content key.
                    self.variants[top] = content
                    self.at_key(top, "")
                    if self.absent:
                        return .Err(self.fail("variant content"))
                    self.pending = true
            .Untagged => pass
        .Ok(index)

# Decoding a stream of JSON texts (spec/std/json.md#decoding-a-stream). The
# stream frames one top-level value's bytes at a time, tracking strings,
# escapes and bracket depth as Go's `json.Decoder` scans, then decodes them
# with `decode`: memory is O(the largest value) plus one chunk, and each
# byte is scanned once to frame it and once to decode it.
use std.io.{IoError, Read}
use std.text.Utf8Error

## The error of a JSON stream: a read of its source failed, or a value did not decode.
## See [std-json.stream.error](../../../spec/std/json.md#r-std-json.stream.error).
@error
@derive(Debug, Eq)
pub enum StreamError:
    @error("$error")
    Read(error: IoError)
    @error("$error")
    Json(error: JsonError)

## Returns the cursor that decodes the JSON texts of `source` one at a time.
## See [std-json.stream.decl](../../../spec/std/json.md#r-std-json.stream.decl).
pub fn decode_stream[R < Read](source: R) -> JsonStream[R]:
    JsonStream { source: source, buffer: [], at: 0, offset: 0, failed: false }

## The JSON texts of a `Read` source, separated by optional whitespace; `next!` decodes the next one.
## See [std-json.stream.decl](../../../spec/std/json.md#r-std-json.stream.decl).
pub struct JsonStream[R < Read]:
    source: R
    # The chunk last read, its first unread byte, and the stream offset of
    # its first byte.
    buffer: List[u8]
    at: usize
    offset: usize
    failed: bool

impl[R < Read] JsonStream[R]:
    ## Returns the next value as a `T`, its error, or `.None` at the end of the source or after an error.
    ## See [std-json.stream.next](../../../spec/std/json.md#r-std-json.stream.next).
    pub fn next![T < Deserialize](&mut self) -> Result[T, StreamError]?:
        if self.failed:
            return .None
        let found = match self.frame!():
            .Ok(.Some(value)) => value
            .Ok(.None) => return .None
            .Err(error) =>
                self.failed = true
                return .Some(.Err(StreamError.Read(error)))
        let (bytes, start) = found
        let result = match string::from_utf8(bytes):
            .Ok(text) =>
                decode::[T](text).map_err(fn(error: JsonError) -> JsonError: shifted(error, start))
            .Err(error) => .Err(JsonError.UnexpectedCharacter(start + utf8_position(error)))
        match result:
            .Ok(value) => .Some(.Ok(value))
            .Err(error) =>
                self.failed = true
                .Some(.Err(StreamError.Json(error)))

    # Refills the buffer once it is all read: false at the end of the source.
    fn fill!(&mut self) -> Result[bool, IoError]:
        if self.at < self.buffer.len():
            return .Ok(true)
        self.offset = self.offset + self.buffer.len()
        self.buffer = self.source.read!(65536)?
        self.at = 0
        .Ok(self.buffer.len() > 0)

    # The bytes of the next top-level value and its stream offset, or
    # `.None` when only whitespace is left. A container or a string ends at
    # its closing byte; any other value at the next whitespace or
    # structural byte, or the end. A structural byte that starts no value is
    # framed alone, so `decode` reports it.
    fn frame!(&mut self) -> Result[(List[u8], usize)?, IoError]:
        while true:
            if !self.fill!()?:
                return .Ok(.None)
            if !json_space(self.buffer[self.at]):
                break
            self.at = self.at + 1
        start := self.offset + self.at
        first := self.buffer[self.at]
        scalar := first != 123 && first != 91 && first != 34
        let mut value: List[u8] = []
        let depth: usize = 0
        let in_string = false
        let escaped = false
        let done = false
        while !done && self.fill!()?:
            size := self.buffer.len()
            let end = self.at
            while end < size && !done:
                byte := self.buffer[end]
                if in_string:
                    if escaped:
                        escaped = false
                    else if byte == 92:
                        escaped = true
                    else if byte == 34:
                        in_string = false
                        done = depth == 0
                    end = end + 1
                else if scalar:
                    delimiter := json_space(byte) || json_structural(byte)
                    if delimiter && (value.len() > 0 || end > self.at):
                        done = true
                    else:
                        end = end + 1
                        done = delimiter
                else:
                    if byte == 34:
                        in_string = true
                    else if byte == 123 || byte == 91:
                        depth = depth + 1
                    else if (byte == 125 || byte == 93) && depth > 0:
                        depth = depth - 1
                        done = depth == 0
                    end = end + 1
            if value.len() == 0 && done:
                value = self.buffer.slice(self.at, end)
            else:
                value.extend(self.buffer.slice(self.at, end))
            self.at = end
        .Ok(.Some((value, start)))

fn json_space(byte: u8) -> bool:
    byte == 32 || byte == 9 || byte == 10 || byte == 13

fn json_structural(byte: u8) -> bool:
    byte == 123 || byte == 125 || byte == 91 || byte == 93 || byte == 44 || byte == 58 || byte == 34

fn utf8_position(error: Utf8Error) -> usize:
    match error:
        .InvalidSequence(position) => position
        .Truncated(position) => position

# A value's syntax error at a stream position: its offset in the value,
# plus `start`, the value's offset in the stream.
fn shifted(error: JsonError, start: usize) -> JsonError:
    match error:
        .UnexpectedEnd(position) => JsonError.UnexpectedEnd(start + position)
        .UnexpectedCharacter(position) => JsonError.UnexpectedCharacter(start + position)
        .InvalidEscape(position) => JsonError.InvalidEscape(start + position)
        .LoneSurrogate(position) => JsonError.LoneSurrogate(start + position)
        .ControlCharacter(position) => JsonError.ControlCharacter(start + position)
        .NumberOutOfRange(position) => JsonError.NumberOutOfRange(start + position)
        .NestingTooDeep(position) => JsonError.NestingTooDeep(start + position)
        other => other
