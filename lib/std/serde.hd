# std.serde: the format-neutral opt-in to serialization
# (spec/lang/14-annotations.md#serialization). A type opts in once with
# `Serialize` and `Deserialize`, derived or written by hand, and every
# format reads the implementation through `Serializer` and `Deserializer`: JSON
# (spec/std/json.md#typed-json) and the host boundary
# (spec/lang/10-modules.md#r-module.boundary.out). The standard
# implementations and the templates are spec/std/serde.md.
use std.annotation.{annotate, cold}
use std.collections.Set
use std.function.Tuple
use std.hash.Hash
use std.structure.{
    Structure,
    Walker,
    Describer,
    Source,
    Variant,
    VariantInfo,
    Field,
    Member,
    Members,
    Key,
    Facts,
    skips,
}

## A named member's document name, independent of its hd field name.
## See [std-serde.rename.fact](../../spec/std/serde.md#r-std-serde.rename.fact).
@annotate(.Field)
pub struct Rename:
    pub name: string

## Names a member on the document wire.
## See [std-serde.rename.constructor](../../spec/std/serde.md#r-std-serde.rename.constructor).
pub fn rename(name: string) -> Rename:
    Rename { name: name }

## Omits an optional member when it is None.
## See [std-serde.skip-none.fact](../../spec/std/serde.md#r-std-serde.skip-none.fact).
@annotate::[F](.Field)
pub struct SkipNone[F]:
    absent: fn(F) -> bool

## Marks an optional member for omission when absent.
## See [std-serde.skip-none.constructor](../../spec/std/serde.md#r-std-serde.skip-none.constructor).
pub fn skip_none[T]() -> SkipNone[T?]:
    SkipNone::[T?] { absent: fn(value: T?) -> bool: value.is_none() }

## Omits a member from serialization and restores its declared default.
## See [std-serde.skip.fact](../../spec/std/serde.md#r-std-serde.skip.fact).
@annotate(.Field)
pub struct Skip: pass

## Marks a member as skipped in this serde derivation.
## See [std-serde.skip.constructor](../../spec/std/serde.md#r-std-serde.skip.constructor).
pub fn skip() -> Skip:
    Skip {}

## The eight document member-name styles.
## See [std-serde.rename-all.styles](../../spec/std/serde.md#r-std-serde.rename-all.styles).
@derive(Debug, Eq)
pub enum RenameCase:
    Lowercase
    Uppercase
    PascalCase
    CamelCase
    SnakeCase
    ScreamingSnakeCase
    KebabCase
    ScreamingKebabCase

## The default naming style for a record's or enum's members.
## See [std-serde.rename-all.fact](../../spec/std/serde.md#r-std-serde.rename-all.fact).
@annotate(.Data, .Enum)
pub struct RenameAll:
    pub style: RenameCase

## Configures the default document member-name style.
## See [std-serde.rename-all.constructor](../../spec/std/serde.md#r-std-serde.rename-all.constructor).
pub fn rename_all(style: RenameCase) -> RenameAll:
    RenameAll { style: style }

## Resolves a wire name: member rename, then container rename_all, then source name.
## See [std-serde.member-name.precedence](../../spec/std/serde.md#r-std-serde.member-name.precedence).
pub fn member_name(member: &Member, container: Facts) -> string:
    # Most members and containers have no facts, so the searches are skipped.
    if !member.facts.items.is_empty():
        match member.facts.find::[Rename]():
            .Some(fact) => return fact.name
            .None => pass
    if container.items.is_empty():
        return member.name
    match container.find::[RenameAll]():
        .Some(fact) => case_name(member.name, fact.style)
        .None => member.name

fn case_name(name: string, style: RenameCase) -> string:
    match style:
        .Lowercase => name
        .SnakeCase => name
        .Uppercase => uppercase_name(name)
        .ScreamingSnakeCase => uppercase_name(name)
        .KebabCase => name.replace("_", "-")
        .ScreamingKebabCase => uppercase_name(name).replace("_", "-")
        .PascalCase => joined_name(name, false)
        .CamelCase => joined_name(name, true)

# The case changes are ASCII byte changes (r-std-serde.rename-all.conversion):
# they keep the bytes valid UTF-8, and they call no Display or builder, so a
# call of `member_name` writes nothing its caller reaches and borrows its
# arguments.
fn uppercase_name(name: string) -> string:
    let mut bytes = name.to_utf8()
    let changed = false
    for at in 0..bytes.len():
        byte := bytes[at]
        if byte >= 97 && byte <= 122:
            bytes[at] = byte - 32
            changed = true
    if !changed:
        return name
    string_from_bytes(bytes)

fn joined_name(name: string, camel: bool) -> string:
    let mut out: List[u8] = []
    let word_start = true
    let first = true
    for byte in name.to_utf8():
        if byte == 95:
            word_start = true
            continue
        let next = byte
        if word_start && camel && first:
            if byte >= 65 && byte <= 90:
                next = byte + 32
        else if word_start && byte >= 97 && byte <= 122:
            next = byte - 32
        out.push(next)
        word_start = false
        first = false
    string_from_bytes(out)

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# A value that opts in to be written by every format
# (r-annot.serde.definition).
## A type that can write itself to a `Serializer`; the compiler knows it for the boundary rule.
## See [annot.serde.module](../../spec/lang/14-annotations.md#r-annot.serde.module).
pub trait Serialize:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]

# A value that opts in to be built by every format
# (r-annot.serde.definition).
## A type that can read itself from a `Deserializer`; the compiler knows it for the boundary rule.
## See [annot.serde.module](../../spec/lang/14-annotations.md#r-annot.serde.module).
pub trait Deserialize:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Self, R::Error]

# A format's writer: one call per value of the data model
# (r-std-serde.model.one-value).
## The format side of writing: it receives a value's parts, or fails with an error of its own type.
## See [annot.serde.module](../../spec/lang/14-annotations.md#r-annot.serde.module).
pub trait Serializer:
    type Error
    fn null(&mut self) -> Result[void, Self::Error]
    fn bool(&mut self, value: bool) -> Result[void, Self::Error]
    fn int(&mut self, value: i64) -> Result[void, Self::Error]
    fn uint(&mut self, value: u64) -> Result[void, Self::Error]
    fn float(&mut self, value: f64) -> Result[void, Self::Error]
    fn text(&mut self, value: string) -> Result[void, Self::Error]
    fn begin_list(&mut self, len: usize) -> Result[void, Self::Error]
    fn end_list(&mut self) -> Result[void, Self::Error]
    fn begin_map(&mut self, len: usize) -> Result[void, Self::Error]
    fn key(&mut self, key: string) -> Result[void, Self::Error]
    fn end_map(&mut self) -> Result[void, Self::Error]
    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Self::Error]
    fn member(&mut self, m: &Member) -> Result[void, Self::Error]
    fn end_variant(&mut self) -> Result[void, Self::Error]

# What a self-describing format holds next (r-std-serde.read.peek).
## The kind of a single value a `Deserializer` offers.
## See [annot.serde.module](../../spec/lang/14-annotations.md#r-annot.serde.module).
pub enum ValueKind:
    Null
    Bool
    Int
    Uint
    Float
    Text
    List
    Map

# A format's reader: it pulls one value of the data model at a time
# (r-std-serde.read.one-value).
## The format side of reading: it offers a value's parts, or fails with an error of its own type.
## See [annot.serde.module](../../spec/lang/14-annotations.md#r-annot.serde.module).
pub trait Deserializer:
    type Error
    fn peek(&mut self) -> Result[ValueKind, Self::Error]
    fn is_null(&mut self) -> Result[bool, Self::Error]
    fn bool(&mut self, expected: string) -> Result[bool, Self::Error]
    fn int(&mut self, expected: string) -> Result[i64, Self::Error]
    fn uint(&mut self, expected: string) -> Result[u64, Self::Error]
    fn float(&mut self, expected: string) -> Result[f64, Self::Error]
    fn text(&mut self, expected: string) -> Result[string, Self::Error]
    fn begin_list(&mut self) -> Result[void, Self::Error]
    fn next_item(&mut self) -> Result[bool, Self::Error]
    fn begin_map(&mut self) -> Result[void, Self::Error]
    fn next_key(&mut self) -> Result[string?, Self::Error]
    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, Self::Error]
    fn member(&mut self, m: &Member) -> Result[void, Self::Error]
    fn end_variant(&mut self) -> Result[void, Self::Error]
    fn invalid(&mut self, expected: string) -> Self::Error
    # Whether the member that `member(m)` just positioned has no value at
    # all, as a missing key (r-std-serde.read.absent). It reads nothing.
    fn is_absent(&mut self) -> bool:
        false

# ---------------------------------------------------------------------------
# The templates (spec/std/serde.md#derived-implementations).

# Derived `Serialize`: `begin_variant`, then `member` and the member's own
# `serialize` for each included walked member, then `end_variant`
# (r-std-serde.derive.serialize.included-order).
impl[T] Serialize for T by Structure:
    fn serialize[W < Serializer](self, out: *mut W) -> Result[void, W::Error]:
        let mut walker = SerializeWalker::[T, W] { out: out, facts: T::facts() }
        Structure::walk(self, &mut walker)?
        out.end_variant()

# The fields are public because the prototype checks the instantiated
# walker in the deriving module.
struct SerializeWalker[S, W < Serializer]:
    pub out: *mut W
    pub facts: Facts

# `skips::[Skip]()` omits a member whose known facts hold `Skip`, so its
# type needs no `Serialize` (r-std-serde.skip.no-bound). The `Skip` test
# in `member` covers a `Skip` that only a named list or a spread attaches
# (r-std-serde.skip.unknown-fact).
@skips::[Skip]()
impl[S, W < Serializer] Walker[S] for SerializeWalker[S, W]:
    type Error = W::Error

    fn variant(&mut self, v: Variant[S]) -> Result[void, W::Error]:
        self.out.begin_variant(self.facts, &v.info)

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Serialize` here, as `member` needs `F < Serialize`.
    fn rest[T < Serialize](
        &mut self,
        h: Field[S, List[T]],
        items: List[T],
    ) -> Result[void, W::Error]:
        self.member(h, items)

    fn member[F < Serialize](&mut self, h: Field[S, F], value: F) -> Result[void, W::Error]:
        # A member with no facts has neither `Skip` nor `SkipNone`.
        if !h.info.facts.items.is_empty() && skipped(h, value):
            return .Ok(())
        self.out.member(&h.info)?
        value.serialize(self.out)

# Whether a member's facts omit it with `value`: a `Skip`, or a `SkipNone`
# whose test holds. Out of line, since most members have no facts: each
# `member` instance then keeps only the test for an empty list.
@cold
fn skipped[S, F](h: Field[S, F], value: F) -> bool:
    if h.fact::[Skip]().is_some():
        return true
    match h.fact::[SkipNone[F]]():
        .Some(fact) => (fact.absent)(value)
        .None => false

# Derived `Deserialize`: `begin_variant` picks the variant, then each member
# in declaration order is positioned with `member` and read with its own
# `deserialize`, or given its declared default when absent, then
# `end_variant` (r-std-serde.derive.deserialize.unskipped-order).
impl[T] Deserialize for T by Structure:
    fn deserialize[R < Deserializer](input: *mut R) -> Result[T, R::Error]:
        let mut source = DeserializeSource::[T, R] { input: input, facts: T::facts(), at: 0 }
        built := T::build(&mut source)?
        input.end_variant()?
        .Ok(built)

# The fields are public because the prototype checks the instantiated
# source in the deriving module.
struct DeserializeSource[S, R < Deserializer]:
    pub input: *mut R
    pub facts: Facts
    pub at: usize

# `skips::[Skip]()` omits a member whose known facts hold `Skip`: `build`
# fills it from its declared default, and its type needs no `Deserialize`
# (r-std-serde.skip.no-bound, r-std-serde.skip.no-default). The `Skip`
# tests in `next` and `missing` cover a `Skip` that only a named list or a
# spread attaches (r-std-serde.skip.unknown-fact).
@skips::[Skip]()
impl[S, R < Deserializer] Source[S] for DeserializeSource[S, R]:
    type Error = R::Error

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], R::Error]:
        let mut infos: List[VariantInfo] = []
        for choice in choices:
            infos.push(choice.info)
        index := self.input.begin_variant(self.facts, infos)?
        .Ok(choices[index])

    # Every unskipped member, in declaration order.
    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, R::Error]:
        # The member is read in place, not copied out of the list.
        while self.at < members.infos.len():
            at := self.at
            self.at += 1
            if (
                members.infos[at].facts.items.is_empty()
                || members.infos[at].facts.find::[Skip]().is_none()
            ):
                position := members.infos[at].position
                return .Ok(members.at(position))
        .Ok(.None)

    # An absent member that declares a default takes it, and is not read
    # (r-std-serde.derive.deserialize.unskipped-default).
    fn member[F < Deserialize](&mut self, h: Field[S, F], previous: F?) -> Result[F, R::Error]:
        self.input.member(&h.info)?
        if h.has_default() && self.input.is_absent():
            match h.default():
                .Some(value) => return .Ok(value)
                .None => pass
        F::deserialize(self.input)

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, R::Error]:
        if h.fact::[Skip]().is_none():
            panic("std.serde: the source names every unskipped member")
        match h.default():
            .Some(value) => .Ok(value)
            .None =>
                .Err(self.input.invalid("skipped field `${h.info.name}` needs a declared default"))

# ---------------------------------------------------------------------------
# The standard implementations (spec/std/serde.md#standard-implementations).

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for bool:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.bool(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for bool:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[bool, R::Error]:
        input.bool("bool")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for string:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.text(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for string:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[string, R::Error]:
        input.text("string")

# A `char` is a text of one character (r-std-serde.std.char).
# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for char:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.text("$self")

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for char:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[char, R::Error]:
        text := input.text("char")?
        let mut found: List[char] = []
        for item in text.chars():
            found.push(item)
        if found.len() == 1:
            return .Ok(found[0])
        .Err(input.invalid("char"))

# A signed integer in `low` to `high`, or the reader's error for `expected`
# (r-std-serde.std.range).
fn signed_in[R < Deserializer](
    input: &mut R,
    low: i64,
    high: i64,
    expected: string,
) -> Result[i64, R::Error]:
    found := input.int(expected)?
    if found >= low && found <= high:
        return .Ok(found)
    .Err(input.invalid(expected))

fn unsigned_in[R < Deserializer](
    input: &mut R,
    high: u64,
    expected: string,
) -> Result[u64, R::Error]:
    found := input.uint(expected)?
    if found <= high:
        return .Ok(found)
    .Err(input.invalid(expected))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for i8:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.int(i64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for i8:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[i8, R::Error]:
        .Ok(i8(signed_in(input, -128, 127, "i8")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for i16:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.int(i64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for i16:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[i16, R::Error]:
        .Ok(i16(signed_in(input, -32768, 32767, "i16")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for i32:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.int(i64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for i32:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[i32, R::Error]:
        .Ok(i32(signed_in(input, -2147483648, 2147483647, "i32")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for i64:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.int(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for i64:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[i64, R::Error]:
        input.int("i64")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for u8:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.uint(u64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for u8:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[u8, R::Error]:
        .Ok(u8(unsigned_in(input, 255, "u8")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for u16:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.uint(u64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for u16:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[u16, R::Error]:
        .Ok(u16(unsigned_in(input, 65535, "u16")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for u32:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.uint(u64(self))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for usize:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.uint(u64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for u32:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[u32, R::Error]:
        .Ok(u32(unsigned_in(input, 4294967295, "u32")?))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for usize:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[usize, R::Error]:
        .Ok(usize(unsigned_in(input, 4294967295, "usize")?))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for u64:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.uint(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for u64:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[u64, R::Error]:
        input.uint("u64")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for f64:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.float(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for f64:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[f64, R::Error]:
        input.float("f64")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for f32:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.float(f64(self))

# A number past the finite `f32` range does not fit (r-std-serde.std.float-read).
# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for f32:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[f32, R::Error]:
        limit := 340282346638528859811704183484516925440.0
        found := input.float("f32")?
        if found >= -limit && found <= limit:
            return .Ok(f32(found))
        .Err(input.invalid("f32"))

# `.None` is `null` (r-std-serde.std.optional).
# Keep handwritten Serialize: keep the builtin optional wire form instead of a tagged object.
impl[T < Serialize] Serialize for T?:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        match self:
            .Some(found) => found.serialize(out)
            .None => out.null()

# Keep handwritten Deserialize: read the builtin optional wire form instead of a tagged object.
impl[T < Deserialize] Deserialize for T?:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[T?, R::Error]:
        if input.is_null()?:
            return .Ok(.None)
        .Ok(.Some(T::deserialize(input)?))

# A reference writes the value it refers to, and reads into a new object
# (r-std-serde.std.reference).
# Keep handwritten Serialize: delegate through the reference; structural derivation is for its referent.
impl[T < Serialize] Serialize for *T:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        value := *self
        value.serialize(out)

# Keep handwritten Serialize: delegate through the reference; structural derivation is for its referent.
impl[T < Serialize] Serialize for *mut T:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        value := *self
        value.serialize(out)

# Keep handwritten Deserialize: delegate through the reference; structural derivation is for its referent.
impl[T < Deserialize] Deserialize for *T:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[*T, R::Error]:
        .Ok(&T::deserialize(input)?)

# Keep handwritten Deserialize: delegate through the reference; structural derivation is for its referent.
impl[T < Deserialize] Deserialize for *mut T:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[*mut T, R::Error]:
        .Ok(&mut T::deserialize(input)?)

# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[T < Serialize] Serialize for List[T]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_list(self.len())?
        for item in self:
            item.serialize(out)?
        out.end_list()

# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[T < Deserialize] Deserialize for List[T]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[List[T], R::Error]:
        input.begin_list()?
        let mut found: List[T] = []
        while input.next_item()?:
            found.push(T::deserialize(input)?)
        .Ok(found)

# Only `string` keys (r-std-serde.std.map-keys).
# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[V < Serialize] Serialize for Map[string, V]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_map(self.len())?
        for entry in self:
            out.key(entry._0)?
            entry._1.serialize(out)?
        out.end_map()

# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[V < Deserialize] Deserialize for Map[string, V]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Map[string, V], R::Error]:
        input.begin_map()?
        let mut found: Map[string, V] = {}
        while true:
            match input.next_key()?:
                .Some(key) => found[key] = V::deserialize(input)?
                .None => break
        .Ok(found)

# A set is a list of its elements in insertion order
# (r-std-serde.std.set).
# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[T < Eq & Hash & Serialize] Serialize for Set[T]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_list(self.len())?
        for item in self:
            item.serialize(out)?
        out.end_list()

# A repeated element keeps one entry (r-std-serde.std.set).
# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[T < Eq & Hash & Deserialize] Deserialize for Set[T]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Set[T], R::Error]:
        input.begin_list()?
        let mut found: Set[T] = Set::new()
        while input.next_item()?:
            _ := found.insert(T::deserialize(input)?)
        .Ok(found)

# Tuple `Serialize` (r-std-serde.std.tuple): a list of the members, in
# order. A counting pass over the members' types gives `begin_list` its
# length before the one walk over the values.
impl[T < Tuple] Serialize for T by Structure:
    fn serialize[W < Serializer](self, out: *mut W) -> Result[void, W::Error]:
        let mut count = MemberCount { total: 0 }
        _ := T::describe(&mut count)
        out.begin_list(count.total)?
        let mut walker = TupleWriter::[T, W] { out: out }
        Structure::walk(self, &mut walker)?
        out.end_list()

# The fields are public because the prototype checks the instantiated
# walker in the deriving module.
struct MemberCount:
    pub total: usize

impl[S] Describer[S] for MemberCount:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        self.total = self.total + 1
        .Ok(())

struct TupleWriter[S, W < Serializer]:
    pub out: *mut W

impl[S, W < Serializer] Walker[S] for TupleWriter[S, W]:
    type Error = W::Error

    fn variant(&mut self, v: Variant[S]) -> Result[void, W::Error]:
        .Ok(())

    # A rest element is one `List[T]` member (annot.walk.rest.default).
    fn member[F < Serialize](&mut self, h: Field[S, F], value: F) -> Result[void, W::Error]:
        value.serialize(self.out)

# Tuple `Deserialize` (r-std-serde.std.tuple): a list with one item per
# member, in order. A short or a long list is the reader's `invalid`
# error.
impl[T < Tuple] Deserialize for T by Structure:
    fn deserialize[R < Deserializer](input: *mut R) -> Result[T, R::Error]:
        input.begin_list()?
        let mut source = TupleReader::[T, R] { input: input, at: 0 }
        built := T::build(&mut source)?
        if input.next_item()?:
            return .Err(input.invalid("end of the tuple"))
        .Ok(built)

struct TupleReader[S, R < Deserializer]:
    pub input: *mut R
    pub at: usize

impl[S, R < Deserializer] Source[S] for TupleReader[S, R]:
    type Error = R::Error

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], R::Error]:
        .Ok(choices[0])

    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, R::Error]:
        if self.at >= members.infos.len():
            return .Ok(.None)
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    fn member[F < Deserialize](&mut self, h: Field[S, F], previous: F?) -> Result[F, R::Error]:
        if !self.input.next_item()?:
            return .Err(self.input.invalid("tuple element"))
        F::deserialize(self.input)

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, R::Error]:
        panic("std.serde: the source names every member")
