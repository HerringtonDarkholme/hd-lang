        out.float(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for f64:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[f64, R::Error]:
        input.float("f64")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for f32:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.float(f64(self))

# A number past the finite `f32` range does not fit (r-std-serde.std.float-read).
# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for f32:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[f32, R::Error]:
        limit := 340282346638528859811704183484516925440.0
        found := input.float("f32")?
        if found >= -limit && found <= limit:
            return .Ok(f32(found))
        .Err(input.invalid("f32"))

# `.None` is `null` (r-std-serde.std.optional).
# Keep handwritten Serialize: keep the builtin optional wire form instead of a tagged object.
impl[T < Serialize] Serialize for T?:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        match self:
            .Some(found) => found.serialize(out)
            .None => out.null()

    fn is_absent(&self) -> bool:
        self.is_none()

# Keep handwritten Deserialize: read the builtin optional wire form instead of a tagged object.
impl[T < Deserialize] Deserialize for T?:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[T?, R::Error]:
        if input.is_null()?:
            return .Ok(.None)
        .Ok(.Some(T::deserialize(input)?))

# `Result` uses the format-neutral newtype-variant protocol
# (r-std-serde.std.result).
fn result_variant(name: string, index: usize) -> VariantInfo:
    VariantInfo {
        name: name,
        index: index,
        facts: Facts { items: [] },
        doc: .None,
        of_data: false,
        positional: 1,
        named: 0,
        shared: [],
        self_ref: .Absent,
    }

impl[T < Serialize, E < Serialize] Serialize for Result[T, E]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        match self:
            .Ok(value) =>
                variant := result_variant("Ok", 0)
                out.begin_newtype_variant(Facts { items: [] }, &variant)?
                value.serialize(out)?
            .Err(error) =>
                variant := result_variant("Err", 1)
                out.begin_newtype_variant(Facts { items: [] }, &variant)?
                error.serialize(out)?
        out.end_variant()

impl[T < Deserialize, E < Deserialize] Deserialize for Result[T, E]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Result[T, E], R::Error]:
        variants := [result_variant("Ok", 0), result_variant("Err", 1)]
        index := input.begin_variant(Facts { items: [] }, variants)?
        input.begin_newtype_variant()?
        let found: Result[T, E] = match index:
            0 => Result.Ok(T::deserialize(input)?)
            1 => Result.Err(E::deserialize(input)?)
            _ => panic("std.serde: invalid Result variant index")
        input.end_variant()?
        .Ok(found)

# A reference writes the value it refers to, and reads into a new object
# (r-std-serde.std.reference).
# Keep handwritten Serialize: delegate through the reference; structural derivation is for its referent.
impl[T < Serialize] Serialize for *T:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        value := *self
        value.serialize(out)

# Keep handwritten Serialize: delegate through the reference; structural derivation is for its referent.
impl[T < Serialize] Serialize for *mut T:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        value := *self
        value.serialize(out)

# Keep handwritten Deserialize: delegate through the reference; structural derivation is for its referent.
impl[T < Deserialize] Deserialize for *T:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[*T, R::Error]:
        # Boxed because the deserialized reference escapes in the returned value.
        .Ok(box(T::deserialize(input)?))

# Keep handwritten Deserialize: delegate through the reference; structural derivation is for its referent.
impl[T < Deserialize] Deserialize for *mut T:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[*mut T, R::Error]:
        # Boxed because the deserialized mutable reference escapes in the returned value.
        .Ok(box(T::deserialize(input)?))

# Derived `MapKey`: a payload-free enum writes its selected variant name,
# and an empty struct writes its data name. The private bound has no
# implementations, so any payload member rejects the derivation.
impl[T] MapKey for T by Structure:
    fn to_key(self) -> MapKeyValue:
        let mut walker = MapKeyWalker::[T] { name: "" }
        _ := Structure::walk(self, &mut walker)
        MapKeyValue.Text(walker.name)

    fn from_key(value: MapKeyValue) -> T?:
        name := match value:
            .Text(found) => found
            _ => return .None
        let mut source = MapKeySource::[T] { name: name, at: 0 }
        match T::build(&mut source):
            .Ok(found) => .Some(found)
            .Err(_) => .None

trait MapKeyPayload

struct MapKeyWalker[S]:
    pub name: string

impl[S] Walker[S] for MapKeyWalker[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        self.name = v.info.name
        .Ok(())

    fn rest[T < MapKeyPayload](
        &mut self,
        h: Field[S, List[T]],
        items: List[T],
    ) -> Result[void, never]:
        .Ok(())

    fn member[F < MapKeyPayload](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        .Ok(())

struct MapKeySource[S]:
    pub name: string
    pub at: usize

impl[S] Source[S] for MapKeySource[S]:
    type Error = bool

    fn data_variant(&mut self, choice: Variant[S]) -> Result[Variant[S], bool]:
        if choice.info.name == self.name:
            return .Ok(choice)
        .Err(false)

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], bool]:
        for choice in choices:
            if choice.info.name == self.name:
                return .Ok(choice)
        .Err(false)

    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, bool]:
        if self.at >= members.infos.len():
            return .Ok(.None)
        position := members.infos[self.at].position
        self.at += 1
        .Ok(members.at(position))

    fn data_member[F < MapKeyPayload](&mut self, h: Field[S, F], previous: F?) -> Result[F, bool]:
        .Err(false)

    fn member[F < MapKeyPayload](&mut self, h: Field[S, F], previous: F?) -> Result[F, bool]:
        .Err(false)

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, bool]:
        .Err(false)

fn canonical_integer_key(text: string, signed: bool) -> bool:
    if text.is_empty():
        return false
    let start: usize = 0
    if text[0] == 45:
        if !signed:
            return false
        start = 1
    else if text[0] < 48 || text[0] > 57:
        return false
    if start >= text.len():
        return false
    if text[start] == 48 && start + 1 < text.len():
        return false
    let at = start
    while at < text.len():
        if text[at] < 48 || text[at] > 57:
            return false
        at += 1
    true

fn signed_key(value: MapKeyValue, low: i64, high: i64) -> i64?:
    match value:
        .Int(found) =>
            if found >= low && found <= high: .Some(found) else: .None
        .Uint(found) =>
            if found <= u64(high): .Some(i64(found)) else: .None
        .Text(text) =>
            if !canonical_integer_key(text, true):
                return .None
            match text.parse::[i64]():
                .Ok(found) =>
                    if found >= low && found <= high: .Some(found) else: .None
                .Err(_) => .None
        .Bool(_) => .None

fn unsigned_key(value: MapKeyValue, high: u64) -> u64?:
    match value:
        .Uint(found) =>
            if found <= high: .Some(found) else: .None
        .Int(found) =>
            if found >= 0 && u64(found) <= high: .Some(u64(found)) else: .None
        .Text(text) =>
            if !canonical_integer_key(text, false):
                return .None
            match text.parse::[u64]():
                .Ok(found) =>
                    if found <= high: .Some(found) else: .None
                .Err(_) => .None
        .Bool(_) => .None

impl MapKey for string:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Text(self)

    fn from_key(value: MapKeyValue) -> string?:
        match value:
            .Text(found) => .Some(found)
            _ => .None

impl MapKey for bool:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Bool(self)

    fn from_key(value: MapKeyValue) -> bool?:
        match value:
            .Bool(found) => .Some(found)
            .Text("true") => .Some(true)
            .Text("false") => .Some(false)
            _ => .None

impl MapKey for char:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Text("$self")

    fn from_key(value: MapKeyValue) -> char?:
        match value:
            .Text(text) =>
                match text.parse::[char]():
                    .Ok(found) => .Some(found)
                    .Err(_) => .None
            _ => .None

impl MapKey for i8:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Int(i64(self))

    fn from_key(value: MapKeyValue) -> i8?:
        signed_key(value, -128, 127).map(fn(found): i8(found))

impl MapKey for i16:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Int(i64(self))

    fn from_key(value: MapKeyValue) -> i16?:
        signed_key(value, -32768, 32767).map(fn(found): i16(found))

impl MapKey for i32:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Int(i64(self))

    fn from_key(value: MapKeyValue) -> i32?:
        signed_key(value, -2147483648, 2147483647).map(fn(found): i32(found))

impl MapKey for i64:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Int(self)

    fn from_key(value: MapKeyValue) -> i64?:
        signed_key(value, -9223372036854775807 - 1, 9223372036854775807)

impl MapKey for u8:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Uint(u64(self))

    fn from_key(value: MapKeyValue) -> u8?:
        unsigned_key(value, 255u64).map(fn(found): u8(found))

impl MapKey for u16:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Uint(u64(self))

    fn from_key(value: MapKeyValue) -> u16?:
        unsigned_key(value, 65535u64).map(fn(found): u16(found))

impl MapKey for u32:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Uint(u64(self))

    fn from_key(value: MapKeyValue) -> u32?:
        unsigned_key(value, 4294967295u64).map(fn(found): u32(found))

impl MapKey for u64:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Uint(self)

    fn from_key(value: MapKeyValue) -> u64?:
        unsigned_key(value, 18446744073709551615u64)

impl MapKey for usize:
    fn to_key(self) -> MapKeyValue:
        MapKeyValue.Uint(u64(self))

    fn from_key(value: MapKeyValue) -> usize?:
        unsigned_key(value, 4294967295u64).map(fn(found): usize(found))

# A MapKey's format-neutral scalar selects the wire key
# (r-std-serde.std.map-key-bound).
# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[T < Serialize] Serialize for List[T]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_list(self.len())?
        for item in self:
            item.serialize(out)?
        out.end_list()

# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[T < Deserialize] Deserialize for List[T]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[List[T], R::Error]:
        input.begin_list()?
        let mut found: List[T] = []
        while input.next_item()?:
            found.push(T::deserialize(input)?)
        .Ok(found)

# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[K < Eq & Hash & MapKey, V < Serialize] Serialize for Map[K, V]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_map(self.len())?
        for entry in self:
            out.map_key(entry._0.to_key())?
            entry._1.serialize(out)?
        out.end_map()

# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[K < Eq & Hash & MapKey, V < Deserialize] Deserialize for Map[K, V]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Map[K, V], R::Error]:
        input.begin_map()?
        let mut found: Map[K, V] = {}
        while true:
            match input.next_map_key()?:
                .Some(raw) =>
                    key := match K::from_key(raw):
                        .Some(key) => key
                        .None => return .Err(input.invalid("map key"))
                    found[key] = V::deserialize(input)?
                .None => break
        .Ok(found)

# A set is a list of its elements in insertion order
# (r-std-serde.std.set).
# Keep handwritten Serialize: write the collection wire form rather than backing storage.
impl[T < Eq & Hash & Serialize] Serialize for Set[T]:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.begin_list(self.len())?
        for item in self:
            item.serialize(out)?
        out.end_list()

# A repeated element keeps one entry (r-std-serde.std.set).
# Keep handwritten Deserialize: build logical entries from the collection wire form.
impl[T < Eq & Hash & Deserialize] Deserialize for Set[T]:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Set[T], R::Error]:
        input.begin_list()?
        let mut found: Set[T] = Set::new()
        while input.next_item()?:
            _ := found.insert(T::deserialize(input)?)
        .Ok(found)

# Tuple `Serialize` (r-std-serde.std.tuple): a list of the members, in
# order. A counting pass over the members' types gives `begin_list` its
# length before the one walk over the values.
impl[T < Tuple] Serialize for T by Structure:
    fn serialize[W < Serializer](self, out: *mut W) -> Result[void, W::Error]:
        let mut count = MemberCount { total: 0 }
        _ := T::describe(&mut count)
        out.begin_list(count.total)?
        let mut walker = TupleWriter::[T, W] { out: out }
        Structure::walk(self, &mut walker)?
        out.end_list()

# The fields are public because the prototype checks the instantiated
# walker in the deriving module.
struct MemberCount:
    pub total: usize

impl[S] Describer[S] for MemberCount:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        self.total = self.total + 1
        .Ok(())

struct TupleWriter[S, W < Serializer]:
    pub out: *mut W

impl[S, W < Serializer] Walker[S] for TupleWriter[S, W]:
    type Error = W::Error

    fn variant(&mut self, v: Variant[S]) -> Result[void, W::Error]:
        .Ok(())

    # A rest element is one `List[T]` member (annot.walk.rest.default).
    fn member[F < Serialize](&mut self, h: Field[S, F], value: F) -> Result[void, W::Error]:
        value.serialize(self.out)

# Tuple `Deserialize` (r-std-serde.std.tuple): a list with one item per
# member, in order. A short or a long list is the reader's `invalid`
# error.
impl[T < Tuple] Deserialize for T by Structure:
    fn deserialize[R < Deserializer](input: *mut R) -> Result[T, R::Error]:
        input.begin_list()?
        let mut source = TupleReader::[T, R] { input: input, at: 0 }
        built := T::build(&mut source)?
        if input.next_item()?:
            return .Err(input.invalid("end of the tuple"))
        .Ok(built)

struct TupleReader[S, R < Deserializer]:
    pub input: *mut R
    pub at: usize

impl[S, R < Deserializer] Source[S] for TupleReader[S, R]:
    type Error = R::Error

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], R::Error]:
        .Ok(choices[0])

    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, R::Error]:
        if self.at >= members.infos.len():
            return .Ok(.None)
        info := members.infos[self.at]
        self.at = self.at + 1
        .Ok(members.at(info.position))

    fn member[F < Deserialize](&mut self, h: Field[S, F], previous: F?) -> Result[F, R::Error]:
        if !self.input.next_item()?:
            return .Err(self.input.invalid("tuple element"))
        F::deserialize(self.input)

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, R::Error]:
        panic("std.serde: the source names every member")
