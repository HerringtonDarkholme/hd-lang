# std.serde: the format-neutral opt-in to serialization
# (spec/lang/14-annotations.md#serialization). A type opts in once with
# `Serialize` and `Deserialize`, derived or written by hand, and every
# format reads the implementation through `Serializer` and `Deserializer`: JSON
# (spec/std/json.md#typed-json) and the host boundary
# (spec/lang/10-modules.md#r-module.boundary.out). The standard
# implementations and the templates are spec/std/serde.md.
use std.annotation.{annotate, cold}
use std.collections.Set
use std.function.Tuple
use std.hash.Hash
use std.text.Parse
use std.structure.{
    Structure,
    Walker,
    Describer,
    Source,
    Variant,
    VariantInfo,
    Field,
    Member,
    Members,
    Key,
    Facts,
    skips,
}

## A member's or variant's document name, independent of its hd source name.
## See [std-serde.rename.variant-fact](../../spec/std/serde.md#r-std-serde.rename.variant-fact).
@annotate(.Field, .Variant)
pub struct Rename:
    pub name: string

## Names a member or variant on the document wire.
## See [std-serde.rename.variant-fact](../../spec/std/serde.md#r-std-serde.rename.variant-fact).
pub fn rename(name: string) -> Rename:
    Rename { name: name }

## Omits an optional member when it is None.
## See [std-serde.skip-none.fact.phantom](../../spec/std/serde.md#r-std-serde.skip-none.fact.phantom).
@annotate::[F](.Field)
pub struct SkipNone[F]: pass

## Marks an optional member for omission when absent.
## See [std-serde.skip-none.constructor](../../spec/std/serde.md#r-std-serde.skip-none.constructor).
pub fn skip_none[T]() -> SkipNone[T?]:
    SkipNone::[T?] {}

## Omits a member from serialization and restores its declared default.
## See [std-serde.skip.fact](../../spec/std/serde.md#r-std-serde.skip.fact).
@annotate(.Field)
pub struct Skip: pass

## Marks a member as skipped in this serde derivation.
## See [std-serde.skip.constructor](../../spec/std/serde.md#r-std-serde.skip.constructor).
pub fn skip() -> Skip:
    Skip {}

## The eight document member-name styles.
## See [std-serde.rename-all.styles](../../spec/std/serde.md#r-std-serde.rename-all.styles).
@derive(Debug, Eq)
pub enum RenameCase:
    Lowercase
    Uppercase
    PascalCase
    CamelCase
    SnakeCase
    ScreamingSnakeCase
    KebabCase
    ScreamingKebabCase

## The default naming style for a record's members or an enum's variants and members.
## See [std-serde.rename-all.fact](../../spec/std/serde.md#r-std-serde.rename-all.fact).
@annotate(.Data, .Enum)
pub struct RenameAll:
    pub style: RenameCase

## Configures the default document member-name style.
## See [std-serde.rename-all.constructor](../../spec/std/serde.md#r-std-serde.rename-all.constructor).
pub fn rename_all(style: RenameCase) -> RenameAll:
    RenameAll { style: style }

## How an enum is represented on a document wire.
## See [std-serde.enum-tagging.fact](../../spec/std/serde.md#r-std-serde.enum-tagging.fact).
@derive(Debug, Eq)
@annotate(.Enum)
pub enum EnumTagging:
    Internal(tag: string)
    Adjacent(tag: string, content: string)
    Untagged

## Places the variant name under `tag`; `content` selects adjacent form when present.
## See [std-serde.enum-tagging.constructors](../../spec/std/serde.md#r-std-serde.enum-tagging.constructors).
pub fn tag(tag: string, content: string? = .None) -> EnumTagging:
    match content:
        .Some(name) => EnumTagging.Adjacent(tag, name)
        .None => EnumTagging.Internal(tag)

## Writes only the variant payload and tries variants in declaration order when reading.
## See [std-serde.enum-tagging.constructors](../../spec/std/serde.md#r-std-serde.enum-tagging.constructors).
pub fn untagged() -> EnumTagging:
    EnumTagging.Untagged

## Resolves a wire name: member rename, then container rename_all, then source name.
## See [std-serde.member-name.precedence](../../spec/std/serde.md#r-std-serde.member-name.precedence).
pub fn member_name(member: &Member, container: Facts) -> string:
    # Most members and containers have no facts, so the searches are skipped.
    if !member.facts.items.is_empty():
        match member.facts.find::[Rename]():
            .Some(fact) => return fact.name
            .None => pass
    if container.items.is_empty():
        return member.name
    match container.find::[RenameAll]():
        .Some(fact) => case_name(member.name, fact.style)
        .None => member.name

## Resolves a variant wire name: variant rename, then enum rename_all, then source name.
## See [std-serde.rename.variant-fact](../../spec/std/serde.md#r-std-serde.rename.variant-fact).
fn variant_name(variant: &VariantInfo, container: Facts) -> string:
    if !variant.facts.items.is_empty():
        match variant.facts.find::[Rename]():
            .Some(fact) => return fact.name
            .None => pass
    if container.items.is_empty():
        return variant.name
    match container.find::[RenameAll]():
        .Some(fact) => variant_case_name(variant.name, fact.style)
        .None => variant.name

fn wire_variant(variant: &VariantInfo, container: Facts) -> VariantInfo:
    VariantInfo {
        name: variant_name(variant, container),
        index: variant.index,
        facts: variant.facts,
        doc: variant.doc,
        type_doc: variant.type_doc,
        of_data: variant.of_data,
        positional: variant.positional,
        named: variant.named,
        included_positional: variant.included_positional,
        shared: variant.shared,
        self_ref: variant.self_ref,
    }

fn variant_has_rename(variant: &VariantInfo) -> bool:
    if variant.facts.items.is_empty():
        return false
    variant.facts.find::[Rename]().is_some()

fn case_name(name: string, style: RenameCase) -> string:
    match style:
        .Lowercase => name
        .SnakeCase => name
        .Uppercase => uppercase_name(name)
        .ScreamingSnakeCase => uppercase_name(name)
        .KebabCase => name.replace("_", "-")
        .ScreamingKebabCase => uppercase_name(name).replace("_", "-")
        .PascalCase => joined_name(name, false)
        .CamelCase => joined_name(name, true)

fn variant_case_name(name: string, style: RenameCase) -> string:
    match style:
        .Lowercase => lowercase_name(name)
        .Uppercase => uppercase_name(name)
        .PascalCase => name
        .CamelCase => lowercase_first(name)
        .SnakeCase => separated_variant_name(name, 95, false)
        .ScreamingSnakeCase => separated_variant_name(name, 95, true)
        .KebabCase => separated_variant_name(name, 45, false)
        .ScreamingKebabCase => separated_variant_name(name, 45, true)

# The case changes are ASCII byte changes (r-std-serde.rename-all.conversion):
# they keep the bytes valid UTF-8, and they call no Display or builder, so a
# call of `member_name` writes nothing its caller reaches and borrows its
# arguments.
fn uppercase_name(name: string) -> string:
    let mut bytes = name.to_utf8()
    let changed = false
    for at in 0..bytes.len():
        byte := bytes[at]
        if byte >= 97 && byte <= 122:
            bytes[at] = byte - 32
            changed = true
    if !changed:
        return name
    string_from_bytes(bytes)

fn lowercase_name(name: string) -> string:
    let mut bytes = name.to_utf8()
    let changed = false
    for at in 0..bytes.len():
        byte := bytes[at]
        if byte >= 65 && byte <= 90:
            bytes[at] = byte + 32
            changed = true
    if !changed:
        return name
    string_from_bytes(bytes)

fn lowercase_first(name: string) -> string:
    let mut bytes = name.to_utf8()
    if bytes.is_empty() || bytes[0] < 65 || bytes[0] > 90:
        return name
    bytes[0] = bytes[0] + 32
    string_from_bytes(bytes)

fn separated_variant_name(name: string, separator: u8, screaming: bool) -> string:
    bytes := name.to_utf8()
    let mut out: List[u8] = []
    for at in 0..bytes.len():
        let byte = bytes[at]
        upper := byte >= 65 && byte <= 90
        if upper && at > 0:
            before := bytes[at - 1]
            before_lower := before >= 97 && before <= 122
            before_digit := before >= 48 && before <= 57
            after_lower := at + 1 < bytes.len() && bytes[at + 1] >= 97 && bytes[at + 1] <= 122
            if before_lower || before_digit || after_lower:
                out.push(separator)
        if screaming && byte >= 97 && byte <= 122:
            byte = byte - 32
        else if !screaming && upper:
            byte = byte + 32
        out.push(byte)
    string_from_bytes(out)

fn joined_name(name: string, camel: bool) -> string:
    let mut out: List[u8] = []
    let word_start = true
    let first = true
    for byte in name.to_utf8():
        if byte == 95:
            word_start = true
            continue
        let next = byte
        if word_start && camel && first:
            if byte >= 65 && byte <= 90:
                next = byte + 32
        else if word_start && byte >= 97 && byte <= 122:
            next = byte - 32
        out.push(next)
        word_start = false
        first = false
    string_from_bytes(out)

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

# A value that opts in to be written by every format
# (r-annot.serde.definition).
## A type that can write itself to a `Serializer`; the compiler knows it for the boundary rule.
## See [annot.serde.module.v2](../../spec/lang/14-annotations.md#r-annot.serde.module.v2).
pub trait Serialize:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]

    fn is_absent(&self) -> bool:
        false

# A value that opts in to be built by every format
# (r-annot.serde.definition).
## A type that can read itself from a `Deserializer`; the compiler knows it for the boundary rule.
## See [annot.serde.module.v2](../../spec/lang/14-annotations.md#r-annot.serde.module.v2).
pub trait Deserialize:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Self, R::Error]

## The scalar kinds a serialization format may preserve for a map key.
## See [std-serde.map-key.value](../../spec/std/serde.md#r-std-serde.map-key.value).
pub enum MapKeyValue:
    Bool(value: bool)
    Int(value: i64)
    Uint(value: u64)
    Text(value: string)

impl MapKeyValue:
    fn as_text(self) -> string:
        match self:
            .Bool(value) => "$value"
            .Int(value) => "$value"
            .Uint(value) => "$value"
            .Text(value) => value

## A value that a serialization format may use as a map key.
## See [std-serde.map-key.trait](../../spec/std/serde.md#r-std-serde.map-key.trait).
pub trait MapKey:
    fn to_key(self) -> MapKeyValue
    fn from_key(value: MapKeyValue) -> Self?

# A format's writer: one call per value of the data model
# (r-std-serde.model.one-value).
## The format side of writing: it receives a value's parts, or fails with an error of its own type.
## See [annot.serde.module.v2](../../spec/lang/14-annotations.md#r-annot.serde.module.v2).
pub trait Serializer:
    type Error
    fn null(&mut self) -> Result[void, Self::Error]
    fn bool(&mut self, value: bool) -> Result[void, Self::Error]
    fn int(&mut self, value: i64) -> Result[void, Self::Error]
    fn uint(&mut self, value: u64) -> Result[void, Self::Error]
    fn float(&mut self, value: f64) -> Result[void, Self::Error]
    fn text(&mut self, value: string) -> Result[void, Self::Error]
    fn begin_list(&mut self, len: usize) -> Result[void, Self::Error]
    fn end_list(&mut self) -> Result[void, Self::Error]
    fn begin_map(&mut self, len: usize) -> Result[void, Self::Error]
    fn key(&mut self, key: string) -> Result[void, Self::Error]
    fn map_key(&mut self, key: MapKeyValue) -> Result[void, Self::Error]:
        self.key(key.as_text())
    fn end_map(&mut self) -> Result[void, Self::Error]
    fn begin_data(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Self::Error]:
        self.begin_variant(facts, v)
    fn begin_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Self::Error]
    fn begin_newtype_variant(&mut self, facts: Facts, v: &VariantInfo) -> Result[void, Self::Error]
    fn begin_tuple_variant(
        &mut self,
        facts: Facts,
        v: &VariantInfo,
        len: usize,
    ) -> Result[void, Self::Error]
    fn member(&mut self, m: &Member) -> Result[void, Self::Error]
    fn end_data(&mut self) -> Result[void, Self::Error]:
        self.end_variant()
    fn end_variant(&mut self) -> Result[void, Self::Error]

# What a self-describing format holds next (r-std-serde.read.peek).
## The kind of a single value a `Deserializer` offers.
## See [annot.serde.module.v2](../../spec/lang/14-annotations.md#r-annot.serde.module.v2).
pub enum ValueKind:
    Null
    Bool
    Int
    Uint
    Float
    Text
    List
    Map

# A format's reader: it pulls one value of the data model at a time
# (r-std-serde.read.one-value).
## The format side of reading: it offers a value's parts, or fails with an error of its own type.
## See [annot.serde.module.v2](../../spec/lang/14-annotations.md#r-annot.serde.module.v2).
pub trait Deserializer:
    type Error
    fn peek(&mut self) -> Result[ValueKind, Self::Error]
    fn is_null(&mut self) -> Result[bool, Self::Error]
    fn bool(&mut self, expected: string) -> Result[bool, Self::Error]
    fn int(&mut self, expected: string) -> Result[i64, Self::Error]
    fn uint(&mut self, expected: string) -> Result[u64, Self::Error]
    fn float(&mut self, expected: string) -> Result[f64, Self::Error]
    fn text(&mut self, expected: string) -> Result[string, Self::Error]
    fn begin_list(&mut self) -> Result[void, Self::Error]
    fn next_item(&mut self) -> Result[bool, Self::Error]
    fn begin_map(&mut self) -> Result[void, Self::Error]
    fn next_key(&mut self) -> Result[string?, Self::Error]
    fn next_map_key(&mut self) -> Result[MapKeyValue?, Self::Error]:
        match self.next_key()?:
            .Some(key) => .Ok(.Some(MapKeyValue.Text(key)))
            .None => .Ok(.None)
    fn begin_data(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, Self::Error]:
        self.begin_variant(facts, choices)
    fn begin_variant(
        &mut self,
        facts: Facts,
        choices: List[VariantInfo],
    ) -> Result[usize, Self::Error]
    fn begin_newtype_variant(&mut self) -> Result[void, Self::Error]
    fn begin_tuple_variant(&mut self, len: usize) -> Result[void, Self::Error]:
        .Err(self.invalid("tuple variant"))
    fn member(&mut self, m: &Member) -> Result[void, Self::Error]
    fn end_data(&mut self) -> Result[void, Self::Error]:
        self.end_variant()
    fn end_variant(&mut self) -> Result[void, Self::Error]
    fn invalid(&mut self, expected: string) -> Self::Error
    # Whether the member that `member(m)` just positioned has no value at
    # all, as a missing key (r-std-serde.read.absent). It reads nothing.
    fn is_absent(&mut self) -> bool:
        false

# ---------------------------------------------------------------------------
# The templates (spec/std/serde.md#derived-implementations).

# Derived `Serialize`: `begin_variant`, then `member` and the member's own
# `serialize` for each included walked member, then `end_variant`
# (r-std-serde.derive.serialize.data-and-enum-forms).
impl[T] Serialize for T by Structure:
    fn serialize[W < Serializer](self, out: *mut W) -> Result[void, W::Error]:
        let mut walker = SerializeWalker::[T, W] {
            out: out,
            facts: T::facts(),
            form: VariantForm.Record,
        }
        Structure::walk(self, &mut walker)?
        match walker.form:
            .Data => out.end_data()
            _ => out.end_variant()

enum VariantForm:
    Data
    Record
    Newtype
    Tuple
    Raw
    List
    Exhausted

fn variant_form(v: &VariantInfo) -> VariantForm:
    if v.of_data || v.named > 0 || v.positional == 0:
        return VariantForm.Record
    if v.included_positional == 0:
        return VariantForm.Record
    if v.included_positional == 1:
        return VariantForm.Newtype
    VariantForm.Tuple

# The fields are public because the prototype checks the instantiated
# walker in the deriving module.
struct SerializeWalker[S, W < Serializer]:
    pub out: *mut W
    pub facts: Facts
    pub form: VariantForm

# `skips::[Skip]()` omits a member whose known facts hold `Skip`, so its
# type needs no `Serialize` (r-std-serde.skip.no-bound). The `Skip` test
# in `member` covers a `Skip` that only an opaque list or a spread attaches
# to a named member (r-std-serde.skip.named-unknown-fact).
@skips::[Skip]()
impl[S, W < Serializer] Walker[S] for SerializeWalker[S, W]:
    type Error = W::Error

    fn data_variant(&mut self, v: Variant[S]) -> Result[void, W::Error]:
        self.form = VariantForm.Data
        self.out.begin_data(self.facts, &v.info)

    fn variant(&mut self, v: Variant[S]) -> Result[void, W::Error]:
        self.form = variant_form(&v.info)
        if self.facts.items.is_empty() && !variant_has_rename(&v.info):
            return match self.form:
                .Data => self.out.begin_data(self.facts, &v.info)
                .Record => self.out.begin_variant(self.facts, &v.info)
                .Newtype => self.out.begin_newtype_variant(self.facts, &v.info)
                .Tuple =>
                    self.out.begin_tuple_variant(self.facts, &v.info, v.info.included_positional)
                .Raw => .Ok(())
                .List => .Ok(())
                .Exhausted => .Ok(())
        wire := wire_variant(&v.info, self.facts)
        match self.form:
            .Data => self.out.begin_data(self.facts, &v.info)
            .Record => self.out.begin_variant(self.facts, &wire)
            .Newtype => self.out.begin_newtype_variant(self.facts, &wire)
            .Tuple => self.out.begin_tuple_variant(self.facts, &wire, v.info.included_positional)
            .Raw => .Ok(())
            .List => .Ok(())
            .Exhausted => .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Serialize` here, as `member` needs `F < Serialize`.
    fn rest[T < Serialize](
        &mut self,
        h: Field[S, List[T]],
        items: List[T],
    ) -> Result[void, W::Error]:
        self.member(h, items)

    fn data_member[F < Serialize](&mut self, h: Field[S, F], value: F) -> Result[void, W::Error]:
        # A member with no facts has neither `Skip` nor `SkipNone`.
        if !h.info.facts.items.is_empty() && skipped(h, value):
            return .Ok(())
        self.out.member(&h.info)?
        value.serialize(self.out)

    fn member[F < Serialize](&mut self, h: Field[S, F], value: F) -> Result[void, W::Error]:
        # A member with no facts has neither `Skip` nor `SkipNone`.
        if !h.info.facts.items.is_empty() && skipped(h, value):
            return .Ok(())
        match self.form:
            .Record => self.out.member(&h.info)?
            _ => pass
        value.serialize(self.out)

# Whether a member's facts omit it with `value`: a `Skip`, or a `SkipNone`
# whose test holds. Out of line, since most members have no facts: each
# `member` instance then keeps only the test for an empty list.
@cold
fn skipped[S, F < Serialize](h: Field[S, F], value: F) -> bool:
    if h.fact::[Skip]().is_some():
        return true
    match h.fact::[SkipNone[F]]():
        .Some(_) => value.is_absent()
        .None => false

# Derived `Deserialize`: `begin_variant` picks the variant, then each member
# in declaration order is positioned with `member` and read with its own
# `deserialize`, or given its declared default when absent, then
# its matching end hook (r-std-serde.derive.deserialize.data-and-enum-forms).
impl[T] Deserialize for T by Structure:
    fn deserialize[R < Deserializer](input: *mut R) -> Result[T, R::Error]:
        facts := T::facts()
        if !facts.items.is_empty():
            match enum_tagging(facts):
                .Some(.Untagged) =>
                    let attempt: usize = 0
                    while true:
                        saved := *input
                        let mut source = DeserializeSource::[T, R] {
                            input: input,
                            facts: facts,
                            at: attempt + 1,
                            form: VariantForm.Raw,
                        }
                        match T::build(&mut source):
                            .Ok(built) =>
                                let finished = match source.form:
                                    .Data => input.end_data()
                                    .List =>
                                        if input.next_item()?:
                                            .Err(input.invalid("tuple variant end"))
                                        else:
                                            .Ok(())
                                    .Raw => .Ok(())
                                    _ => input.end_variant()
                                match finished:
                                    .Ok(_) => return .Ok(built)
                                    .Err(_) => pass
                            .Err(_) => pass
                        *input = saved
                        match source.form:
                            .Exhausted => return .Err(input.invalid("variant"))
                            _ => pass
                        attempt += 1
                _ => pass
        let mut source = DeserializeSource::[T, R] {
            input: input,
            facts: facts,
            at: 0,
            form: VariantForm.Record,
        }
        built := T::build(&mut source)?
        match source.form:
            .Data => input.end_data()?
            _ => input.end_variant()?
        .Ok(built)

@cold
fn enum_tagging(facts: Facts) -> EnumTagging?:
    facts.find::[EnumTagging]()

# The fields are public because the prototype checks the instantiated
# source in the deriving module.
struct DeserializeSource[S, R < Deserializer]:
    pub input: *mut R
    pub facts: Facts
    pub at: usize
    pub form: VariantForm

# `skips::[Skip]()` omits a member whose known facts hold `Skip`: `build`
# fills a named member from its declared default and a positional member
# from its type's `Default`; its type needs no `Deserialize`
# (r-std-serde.skip.no-bound, r-std-serde.skip.named-no-default,
# r-std-serde.skip.positional-no-default). The `Skip` tests in `next` and
# `missing` cover a `Skip` that only an opaque list or a spread attaches to
# a named member (r-std-serde.skip.named-unknown-fact).
@skips::[Skip]()
impl[S, R < Deserializer] Source[S] for DeserializeSource[S, R]:
    type Error = R::Error

    fn data_variant(&mut self, choice: Variant[S]) -> Result[Variant[S], R::Error]:
        self.form = VariantForm.Data
        _ := self.input.begin_data(self.facts, [choice.info])?
        .Ok(choice)

    fn variant(&mut self, choices: List[Variant[S]]) -> Result[Variant[S], R::Error]:
        if !self.facts.items.is_empty():
            match enum_tagging(self.facts):
                .Some(.Untagged) =>
                    attempt := self.at - 1
                    self.at = 0
                    if attempt >= choices.len():
                        self.form = VariantForm.Exhausted
                        return .Err(self.input.invalid("variant"))
                    choice := choices[attempt]
                    match variant_form(&choice.info):
                        .Record =>
                            if choice.info.named == 0 && choice.info.included_positional == 0:
                                if !self.input.is_null()?:
                                    return .Err(self.input.invalid("null"))
                                self.form = VariantForm.Raw
                            else:
                                _ := self.input.begin_data(self.facts, [choice.info])?
                                self.form = VariantForm.Data
                        .Newtype => self.form = VariantForm.Raw
                        .Tuple =>
                            self.input.begin_list()?
                            self.form = VariantForm.List
                        _ => return .Err(self.input.invalid("variant"))
                    return .Ok(choice)
                _ => pass
        let mut infos: List[VariantInfo] = []
        let any_variant_rename = false
        if self.facts.items.is_empty():
            for choice in choices:
                if variant_has_rename(&choice.info):
                    any_variant_rename = true
                    break
        if self.facts.items.is_empty() && !any_variant_rename:
            for choice in choices:
                infos.push(choice.info)
        else:
            for choice in choices:
                infos.push(wire_variant(&choice.info, self.facts))
        index := self.input.begin_variant(self.facts, infos)?
        self.form = variant_form(&choices[index].info)
        match self.form:
            .Data => pass
            .Record => pass
            .Newtype => self.input.begin_newtype_variant()?
            .Tuple => self.input.begin_tuple_variant(choices[index].info.included_positional)?
            .Raw => pass
            .List => pass
            .Exhausted => pass
        .Ok(choices[index])

    # Every unskipped member, in declaration order.
    fn next(&mut self, members: Members[S]) -> Result[Key[S]?, R::Error]:
        # The member is read in place, not copied out of the list.
        while self.at < members.infos.len():
            at := self.at
            self.at += 1
            if (
                members.infos[at].facts.items.is_empty()
                || members.infos[at].facts.find::[Skip]().is_none()
            ):
                position := members.infos[at].position
                return .Ok(members.at(position))
        .Ok(.None)

    # An absent member that declares a default takes it, and is not read
    # (r-std-serde.derive.deserialize.unskipped-default).
    fn data_member[F < Deserialize](&mut self, h: Field[S, F], previous: F?) -> Result[F, R::Error]:
        self.input.member(&h.info)?
        if h.has_default() && self.input.is_absent():
            match h.default():
                .Some(value) => return .Ok(value)
                .None => pass
        F::deserialize(self.input)

    fn member[F < Deserialize](&mut self, h: Field[S, F], previous: F?) -> Result[F, R::Error]:
        match self.form:
            .Data => self.input.member(&h.info)?
            .Record => self.input.member(&h.info)?
            .Newtype => pass
            .Tuple =>
                if !self.input.next_item()?:
                    return .Err(self.input.invalid("tuple variant item"))
            .Raw => pass
            .List =>
                if !self.input.next_item()?:
                    return .Err(self.input.invalid("tuple variant item"))
            .Exhausted => pass
        if h.has_default() && self.input.is_absent():
            match h.default():
                .Some(value) => return .Ok(value)
                .None => pass
        F::deserialize(self.input)

    fn missing[F](&mut self, h: Field[S, F]) -> Result[F, R::Error]:
        if h.fact::[Skip]().is_none():
            panic("std.serde: the source names every unskipped member")
        match h.default():
            .Some(value) => .Ok(value)
            .None =>
                .Err(self.input.invalid("skipped field `${h.info.name}` needs a declared default"))

# ---------------------------------------------------------------------------
# The standard implementations (spec/std/serde.md#standard-implementations).

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for bool:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.bool(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for bool:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[bool, R::Error]:
        input.bool("bool")

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for string:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.text(self)

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for string:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[string, R::Error]:
        input.text("string")

# A `char` is a text of one character (r-std-serde.std.char).
# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for char:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.text("$self")

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for char:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[char, R::Error]:
        text := input.text("char")?
        let mut found: List[char] = []
        for item in text.chars():
            found.push(item)
        if found.len() == 1:
            return .Ok(found[0])
        .Err(input.invalid("char"))

# A signed integer in `low` to `high`, or the reader's error for `expected`
# (r-std-serde.std.range).
fn signed_in[R < Deserializer](
    input: &mut R,
    low: i64,
    high: i64,
    expected: string,
) -> Result[i64, R::Error]:
    found := input.int(expected)?
    if found >= low && found <= high:
        return .Ok(found)
    .Err(input.invalid(expected))

fn unsigned_in[R < Deserializer](
    input: &mut R,
    high: u64,
    expected: string,
) -> Result[u64, R::Error]:
    found := input.uint(expected)?
    if found <= high:
        return .Ok(found)
    .Err(input.invalid(expected))

# Keep handwritten Serialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Serialize for i8:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.int(i64(self))

# Keep handwritten Deserialize: implement the builtin scalar protocol, which has no derivable declaration.
impl Deserialize for i8:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[i8, R::Error]:
        .Ok(i8(signed_in(input, -128, 127, "i8")?))

