# musl pow.c `log_inline` (Arm): log(x) as `(y, tail)`, with about 15
# extra bits in the tail. `ix` is x's bits, a subnormal normalized with a
# negative exponent.
@inline(.Always)
fn libm_pow_log(ix: u64) -> (f64, f64):
    tmp := ix.wrapping_sub(0x3fe6955500000000)
    k := i64(tmp) >> 52
    iz := ix.wrapping_sub(tmp & 0xfff0000000000000)
    z := f64_from(iz)
    kd := f64(k)
    let (invc_bits, logc_bits, logctail_bits) = libm_pow_entry((tmp >> 45) & 127)
    invc := f64_from(invc_bits)
    logc := f64_from(logc_bits)
    logctail := f64_from(logctail_bits)
    # Split z so rhi, rlo and rhi * rhi are exact and |rlo| <= |r|.
    zhi := f64_from(iz.wrapping_add(0x80000000) & 0xffffffff00000000)
    zlo := z - zhi
    rhi := zhi * invc - 1.0
    rlo := zlo * invc
    r := rhi + rlo
    # k*Ln2 + log(c) + r.
    t1 := kd * 0.6931471805598903 + logc
    t2 := t1 + r
    lo1 := kd * 5.497923018708371e-14 + logctail
    lo2 := t1 - t2 + r
    ar := -0.5 * r
    ar2 := r * ar
    ar3 := r * ar2
    arhi := -0.5 * rhi
    arhi2 := rhi * arhi
    hi := t2 + arhi2
    lo3 := rlo * (ar + arhi)
    lo4 := t2 - hi + arhi2
    # p = log1p(r) - r - A[0]*r*r.
    p := (
        ar3
        * (
            -0.6666666666666679
            + r * 0.5000000000000007
            + ar2 * (
                0.7999999995323976
                + r * -0.6666666663487739
                + ar2 * (-1.142909628459501 + r * 1.0000415263675542)
            )
        )
    )
    lo := lo1 + lo2 + lo3 + lo4 + p
    y := hi + lo
    (y, hi - y + lo)

# musl pow.c `specialcase` (Arm): as exp's, keeping the result's sign.
fn libm_pow_exp_special(tmp: f64, sbits: u64, ki: u64) -> f64:
    if (ki & 0x80000000) == 0:
        scale := f64_from(sbits.wrapping_sub(0x3f10000000000000))
        return 5.486124068793689e+303 * (scale + scale * tmp)
    sbits_low := sbits.wrapping_add(0x3fe0000000000000)
    # Note: sbits is the signed scale.
    scale := f64_from(sbits_low)
    let y = scale + scale * tmp
    if y.abs() < 1.0:
        one := if y < 0.0: -1.0 else: 1.0
        let lo = scale - y + scale * tmp
        hi := one + y
        lo = one - hi + y + lo
        y = (hi + lo) - one
        # Fix the sign of zero.
        if y == 0.0:
            y = f64_from(sbits_low & 0x8000000000000000)
    2.2250738585072014e-308 * y

# musl pow.c `exp_inline` (Arm): sign * exp(x + xtail), where
# |xtail| < 2^-8/128 and |xtail| <= |x|; `sign_bias` is 0x40000 or 0.
@inline(.Always)
fn libm_pow_exp(x: f64, xtail: f64, sign_bias: u64) -> f64:
    let abstop = libm_top12(x) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x3f:
        if abstop.wrapping_sub(0x3c9) >= 0x80000000:
            one := 1.0 + x
            return if sign_bias != 0: -one else: one
        if abstop >= 0x409:
            # Inf and NaN are already handled.
            infinity := if (f64_bits(x) >> 63) != 0: 0.0 else: 1.0 / 0.0
            return if sign_bias != 0: -infinity else: infinity
        abstop = 0
    z := 184.6649652337873 * x
    shifted := z + 6755399441055744.0
    ki := f64_bits(shifted)
    kd := shifted - 6755399441055744.0
    let r = x + kd * -0.005415212348111709 + kd * -1.2864023111638346e-14
    r += xtail
    top := ki.wrapping_add(sign_bias) << 45
    let (tail_bits, scale_bits) = libm_exp_entry(ki & 127)
    tail := f64_from(tail_bits)
    sbits := scale_bits.wrapping_add(top)
    r2 := r * r
    tmp := (
        tail
        + r
        + r2 * (0.49999999999996786 + r * 0.16666666666665886)
        + r2 * r2 * (0.0416666808410674 + r * 0.008333335853059549)
    )
    if abstop == 0:
        return libm_pow_exp_special(tmp, sbits, ki)
    scale := f64_from(sbits)
    scale + scale * tmp

# musl pow.c `checkint` (Arm): 0 if not an integer, 1 if odd, 2 if even,
# for the bits of a nonzero finite value.
fn libm_checkint(iy: u64) -> i32:
    e := i32((iy >> 52) & 0x7ff)
    if e < 0x3ff:
        return 0
    if e > 0x3ff + 52:
        return 2
    if (iy & ((u64(1) << u32(0x3ff + 52 - e)) - 1)) != 0:
        return 0
    if (iy & (u64(1) << u32(0x3ff + 52 - e))) != 0:
        return 1
    2

# musl pow.c `zeroinfnan` (Arm): true for the bits of 0, infinity or NaN.
@inline(.Always)
fn libm_zeroinfnan(i: u64) -> bool:
    (i << 1).wrapping_sub(1) >= 0xffdfffffffffffff

# musl pow.c (Arm): exp(y * log(x)), with log in extra precision. It is
# also the `**` operator at f64, so the backend roots it
# (crates/hd_wasm FLOAT_FNS). Cost: two `match` table lookups and about
# 60 floating operations.
@inline(.Never)
fn float_pow_f64(x: f64, y: f64) -> f64:
    let sign_bias: u64 = 0
    let ix = f64_bits(x)
    iy := f64_bits(y)
    let topx = libm_top12(x)
    topy := libm_top12(y)
    if (
        topx.wrapping_sub(0x001) >= 0x7ff - 0x001
        || (topy & 0x7ff).wrapping_sub(0x3be) >= 0x43e - 0x3be
    ):
        # Either x < 0x1p-1022 or inf or nan, or |y| < 2^-65 or
        # |y| >= 2^63 or nan.
        if libm_zeroinfnan(iy):
            if iy << 1 == 0:
                return 1.0
            if ix == 0x3ff0000000000000:
                return 1.0
            if ix << 1 > 0xffe0000000000000 || iy << 1 > 0xffe0000000000000:
                return x + y
            if ix << 1 == 0x7fe0000000000000:
                return 1.0
            if (ix << 1 < 0x7fe0000000000000) == ((iy >> 63) == 0):
                # |x| < 1 && y == inf, or |x| > 1 && y == -inf.
                return 0.0
            return y * y
        if libm_zeroinfnan(ix):
            let x2 = x * x
            if (ix >> 63) != 0 && libm_checkint(iy) == 1:
                x2 = -x2
            return if (iy >> 63) != 0: 1.0 / x2 else: x2
        # x and y are nonzero finite.
        if (ix >> 63) != 0:
            # Finite x < 0.
            yint := libm_checkint(iy)
            if yint == 0:
                return (x - x) / (x - x)
            if yint == 1:
                sign_bias = 0x40000
            ix = ix & 0x7fffffffffffffff
            topx = topx & 0x7ff
        if (topy & 0x7ff).wrapping_sub(0x3be) >= 0x43e - 0x3be:
            # sign_bias is 0 here because y is not odd.
            if ix == 0x3ff0000000000000:
                return 1.0
            if (topy & 0x7ff) < 0x3be:
                # |y| < 2^-65: x^y ~= 1 + y*log(x).
                return if ix > 0x3ff0000000000000: 1.0 + y else: 1.0 - y
            return if (ix > 0x3ff0000000000000) == (topy < 0x800): 1.0 / 0.0 else: 0.0
        if topx == 0:
            # Normalize a subnormal x so its exponent becomes negative.
            ix = (f64_bits(x * 4503599627370496.0) & 0x7fffffffffffffff).wrapping_sub(
                0x0340000000000000,
            )
    let (hi, lo) = libm_pow_log(ix)
    yhi := f64_from(iy & 0xfffffffff8000000)
    ylo := y - yhi
    lhi := f64_from(f64_bits(hi) & 0xfffffffff8000000)
    llo := hi - lhi + lo
    ehi := yhi * lhi
    # |elo| < |ehi| * 2^-25.
    elo := ylo * lhi + y * llo
    libm_pow_exp(ehi, elo, sign_bias)

# musl exp2f_data.c (Arm): the bits of 2^(i/32) less `i << 47`, for
# expf, exp2f and powf.
@inline(.Always)
fn libm_exp2f_table() -> string:
    "????????o~BsTWDRBZun~BNcW}k`Tln~BPldCOFocn~BzDT^{_j[n~BieJYp[GTn~BwGU\\mhFMn~B`z|FtvhFn~BT[ZKIwn@n~BJfiMv[Y{m~BaObCKXivm~BlcWW_`_rm~BfgaLTj|nm~BA}SfUlAlm~BhODQ\\^oim~BDUdMoyFhm~BLnr^exHgm~Bs|DzgVvfm~BFEoyrPPgm~BRwKRXeWhm~BZBiIATMjm~BdV[ro]rlm~BOA~gAEHpm~B\\TaNqMOtm~BlMlUX}Hym~BFxt}qZv~m~B[IT`\\nXEn~Bh@xz[BqLn~BFQy}[b@Un~B^lx]r[H^n~BYBHha}Ihn~B?TcZZXFsn~B"

# musl expf.c (Arm), evaluated in double: exp(x) = 2^(k/32) * 2^(r/32).
fn libm_expf(x: f32) -> f32:
    xd := f64(x)
    abstop := (f32_bits(x) >> 20) & 0x7ff
    if abstop >= 0x42b:
        # |x| >= 88 or x is nan.
        if f32_bits(x) == 0xff800000:
            return 0.0
        if abstop >= 0x7f8:
            return x + x
        if x > 88.72283:
            return 1.0 / 0.0
        if x < -103.97208:
            return 0.0
    # x*32/ln2 = k + r with r in [-1/2, 1/2] and int k.
    z := 46.16624130844683 * xd
    shifted := z + 6755399441055744.0
    ki := f64_bits(shifted)
    kd := shifted - 6755399441055744.0
    r := z - kd
    let t = libm_word(libm_exp2f_table(), usize(ki & 31))
    t = t.wrapping_add(ki << 47)
    s := f64_from(t)
    p := 1.6938359250920212e-06 * r + 0.00023459809789509004
    r2 := r * r
    let y = 0.021660849396613134 * r + 1.0
    y = p * r2 + y
    y = y * s
    f32(y)

# musl exp2f.c (Arm).
fn libm_exp2f(x: f32) -> f32:
    xd := f64(x)
    abstop := (f32_bits(x) >> 20) & 0x7ff
    if abstop >= 0x430:
        # |x| >= 128 or x is nan.
        if f32_bits(x) == 0xff800000:
            return 0.0
        if abstop >= 0x7f8:
            return x + x
        if x > 0.0:
            return 1.0 / 0.0
        if x <= -150.0:
            return 0.0
    # x = k/32 + r with r in [-1/64, 1/64] and int k.
    shifted := xd + 211106232532992.0
    ki := f64_bits(shifted)
    kd := shifted - 211106232532992.0
    r := xd - kd
    let t = libm_word(libm_exp2f_table(), usize(ki & 31))
    t = t.wrapping_add(ki << 47)
    s := f64_from(t)
    p := 0.05550361559341535 * r + 0.2402284522445722
    r2 := r * r
    let y = 0.6931471806916203 * r + 1.0
    y = p * r2 + y
    y = y * s
    f32(y)

# musl powf_data.c (Arm): for 16 subintervals, the bits of 1/c and
# log2(c). It equals log2f_data.c's table, so log2f reads it too.
@inline(.Always)
fn libm_log2f_table() -> string:
    "}MN}xp]Wu~BX?bdZXk~]~J|_wjIt][t~BcqNtq_uAZ~JoA@{ofRds~Bz\\zFIkWOV~JDM?moUXqr~Bz|[ZYc]fR~JdQEaKcPBr~BpWj{rnXFO~J_ywAzHaVq~BojvMZs@^H~J~ObEIhsmp~B^qrjRM]}A~JyUmaobtGp~B[tG]~mKWx}JfAOe@|Rdo~BM~tPuuxZi}J????????o~B???????????k]ce|rGWm~B|SNH^iKMr}B_ie?^KJhk~ByEHMSdi\\C~BernYVXBGj~BQRMpIl?`M~BlgYgbDloh~B[SepoVc@S~BlFC]BWm`g~Bw~xEkohbW~Ba`sStr|Xf~BKnVkMPIw[~B"

# musl powf.c (Arm): x^y = 2^(y * log2(x)), in double.
fn libm_powf(x: f32, y: f32) -> f32:
    let sign_bias: u64 = 0
    let ix = f32_bits(x)
    iy := f32_bits(y)
    if ix.wrapping_sub(0x00800000) >= 0x7f800000 - 0x00800000 || libm_zeroinfnanf(iy):
        # Either x < 0x1p-126 or inf or nan, or y is 0 or inf or nan.
        if libm_zeroinfnanf(iy):
            if iy << 1 == 0:
                return 1.0
            if ix == 0x3f800000:
                return 1.0
            if ix << 1 > 0xff000000 || iy << 1 > 0xff000000:
                return x + y
            if ix << 1 == 0x7f000000:
                return 1.0
            if (ix << 1 < 0x7f000000) == ((iy & 0x80000000) == 0):
                return 0.0
            return y * y
        if libm_zeroinfnanf(ix):
            let x2 = x * x
            if (ix & 0x80000000) != 0 && libm_checkintf(iy) == 1:
                x2 = -x2
            return if (iy & 0x80000000) != 0: 1.0 / x2 else: x2
        # x and y are nonzero finite.
        if (ix & 0x80000000) != 0:
            # Finite x < 0.
            yint := libm_checkintf(iy)
            if yint == 0:
                return (x - x) / (x - x)
            if yint == 1:
                sign_bias = 0x10000
            ix = ix & 0x7fffffff
        if ix < 0x00800000:
            # Normalize a subnormal x so its exponent becomes negative.
            ix = (f32_bits(x * 8388608.0) & 0x7fffffff).wrapping_sub(0x0b800000)
    # log2(x) in double: musl `log2_inline`.
    tmp := ix.wrapping_sub(0x3f330000)
    i := usize((tmp >> 19) & 15)
    top := tmp & 0xff800000
    iz := ix.wrapping_sub(top)
    k := i32(top) >> 23
    table := libm_log2f_table()
    invc := libm_float(table, 2 * i)
    logc := libm_float(table, 2 * i + 1)
    z := f64(f32_from(iz))
    r := z * invc - 1.0
    y0 := logc + f64(k)
    r2 := r * r
    let lp = 0.288457581109214 * r + -0.36092606229713164
    p := 0.480898481472577 * r + -0.7213474675006291
    r4 := r2 * r2
    let q = 1.4426950408774342 * r + y0
    q = p * r2 + q
    lp = lp * r4 + q
    ylogx := f64(y) * lp
    if ((f64_bits(ylogx) >> 47) & 0xffff) >= 0x80bf:
        # |y*log(x)| >= 126.
        if ylogx > 127.99999995700433:
            return if sign_bias != 0: -(1.0 / 0.0) else: 1.0 / 0.0
        if ylogx <= -150.0:
            return if sign_bias != 0: -0.0 else: 0.0
    # 2^ylogx in double: musl `exp2_inline`.
    shifted := ylogx + 211106232532992.0
    ki := f64_bits(shifted)
    kd := shifted - 211106232532992.0
    re := ylogx - kd
    let t = libm_word(libm_exp2f_table(), usize(ki & 31))
    ski := ki.wrapping_add(sign_bias)
    t = t.wrapping_add(ski << 47)
    s := f64_from(t)
    ze := 0.05550361559341535 * re + 0.2402284522445722
    re2 := re * re
    let ye = 0.6931471806916203 * re + 1.0
    ye = ze * re2 + ye
    ye = ye * s
    f32(ye)

# musl powf.c `checkint` (Arm).
fn libm_checkintf(iy: u32) -> i32:
    e := i32((iy >> 23) & 0xff)
    if e < 0x7f:
        return 0
    if e > 0x7f + 23:
        return 2
    if (iy & ((u32(1) << u32(0x7f + 23 - e)) - 1)) != 0:
        return 0
    if (iy & (u32(1) << u32(0x7f + 23 - e))) != 0:
        return 1
    2

# musl powf.c `zeroinfnan` (Arm).
@inline(.Always)
fn libm_zeroinfnanf(i: u32) -> bool:
    (i << 1).wrapping_sub(1) >= 0xfeffffff

