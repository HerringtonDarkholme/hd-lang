# musl log2.c (Arm): log2(x) = log2(z/c) + log2(c) + k.
fn libm_log2(x: f64) -> f64:
    let ix = f64_bits(x)
    top := u32(ix >> 48)
    if ix.wrapping_sub(0x3feea4af00000000) < 0x000210aa00000000:
        # Close to 1.0.
        if ix == 0x3ff0000000000000:
            return 0.0
        r := x - 1.0
        rhi := f64_from(f64_bits(r) & 0xffffffff00000000)
        rlo := r - rhi
        hi := rhi * 1.4426950407214463
        let lo = rlo * 1.4426950407214463 + r * 1.6751713164886512e-10
        r2 := r * r
        r4 := r2 * r2
        # Worst-case error is less than 0.55 ULP.
        p := r2 * (-0.7213475204444817 + r * 0.48089834696298744)
        let y = hi + p
        lo += hi - y + p
        lo += (
            r4
            * (
                -0.360673760222145
                + r * 0.2885390081805197
                + r2 * (-0.24044917405728863 + r * 0.2060992861022954)
                + r4 * (
                    -0.18033596705327856
                    + r * 0.1603032746063156
                    + r2 * (-0.14483316576701266 + r * 0.13046826811283835)
                )
            )
        )
        y += lo
        return y
    if top.wrapping_sub(0x0010) >= 0x7ff0 - 0x0010:
        # x < 0x1p-1022 or inf or nan.
        if ix << 1 == 0:
            return -1.0 / 0.0
        if ix == 0x7ff0000000000000:
            return x
        if (top & 0x8000) != 0 || (top & 0x7ff0) == 0x7ff0:
            return (x - x) / (x - x)
        # x is subnormal: normalize it.
        ix = f64_bits(x * 4503599627370496.0).wrapping_sub(0x0340000000000000)
    tmp := ix.wrapping_sub(0x3fe6000000000000)
    i := usize((tmp >> 46) & 63)
    k := i64(tmp) >> 52
    iz := ix.wrapping_sub(tmp & 0xfff0000000000000)
    table := libm_log2_table()
    invc := libm_float(table, 4 * i)
    logc := libm_float(table, 4 * i + 1)
    z := f64_from(iz)
    kd := f64(k)
    # r ~= z/c - 1, |r| < 1/128.
    r := (z - libm_float(table, 4 * i + 2) - libm_float(table, 4 * i + 3)) * invc
    rhi := f64_from(f64_bits(r) & 0xffffffff00000000)
    rlo := r - rhi
    t1 := rhi * 1.4426950407214463
    t2 := rlo * 1.4426950407214463 + r * 1.6751713164886512e-10
    # hi + lo = r/ln2 + log2(c) + k.
    t3 := kd + logc
    hi := t3 + t1
    lo := t3 - hi + t1 + t2
    # log2(r+1) = r/ln2 + r^2*poly(r).
    r2 := r * r
    r4 := r2 * r2
    p := (
        -0.7213475204444882
        + r * 0.4808983469629985
        + r2 * (-0.36067375954075914 + r * 0.2885390073180969)
        + r4 * (-0.2404693555628422 + r * 0.2061202382173603)
    )
    lo + r2 * p + hi

# musl log10.c (Sun): log10(x) from fdlibm's log kernel, with k*log10(2)
# and the kernel's result split for extra precision.
fn libm_log10(value: f64) -> f64:
    let x = value
    let bits = f64_bits(x)
    let hx = u32(bits >> 32)
    let k: i32 = 0
    if hx < 0x00100000 || (hx >> 31) != 0:
        if bits << 1 == 0:
            return -1.0 / (x * x)
        if (hx >> 31) != 0:
            return (x - x) / 0.0
        # Subnormal: scale x up.
        k -= 54
        x *= 18014398509481984.0
        bits = f64_bits(x)
        hx = u32(bits >> 32)
    else if hx >= 0x7ff00000:
        return x
    else if hx == 0x3ff00000 && bits << 32 == 0:
        return 0.0
    # Reduce x into [sqrt(2)/2, sqrt(2)].
    hx += 0x3ff00000 - 0x3fe6a09e
    k += i32(hx >> 20) - 0x3ff
    hx = (hx & 0x000fffff) + 0x3fe6a09e
    x = f64_from((u64(hx) << 32) | (bits & 0xffffffff))
    f := x - 1.0
    hfsq := 0.5 * f * f
    s := f / (2.0 + f)
    z := s * s
    w := z * z
    t1 := (
        w
        * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
    )
    t2 := (
        z
        * (
            6.666666666666735130e-01
            + w * (
                2.857142874366239149e-01
                + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)
            )
        )
    )
    r := t2 + t1
    hi := f64_from(f64_bits(f - hfsq) & 0xffffffff00000000)
    lo := f - hi - hfsq + s * (hfsq + r)
    # val_hi + val_lo ~ log10(1+f) + k*log10(2).
    let val_hi = hi * 4.34294481878168880939e-01
    dk := f64(k)
    y := dk * 3.01029995663611771306e-01
    let val_lo = (
        dk * 3.69423907715893078616e-13
        + (lo + hi) * 2.50829467116452752298e-11
        + lo * 4.34294481878168880939e-01
    )
    sum := y + val_hi
    val_lo += (y - sum) + val_hi
    val_hi = sum
    val_lo + val_hi

# musl log1p.c (Sun): log(1+x), with a correction term for the rounding
# of 1+x.
fn libm_log1p(value: f64) -> f64:
    let x = value
    bits := f64_bits(x)
    hx := u32(bits >> 32)
    let k: i32 = 1
    let c = 0.0
    let f = 0.0
    if hx < 0x3fda827a || (hx >> 31) != 0:
        # 1+x < sqrt(2)+.
        if hx >= 0xbff00000:
            # x <= -1.0.
            if x == -1.0:
                return x / 0.0
            return (x - x) / 0.0
        if hx << 1 < 0x79400000:
            # |x| < 2^-53.
            return x
        if hx <= 0xbfd2bec4:
            # sqrt(2)/2- <= 1+x < sqrt(2)+.
            k = 0
            c = 0.0
            f = x
    else if hx >= 0x7ff00000:
        return x
    if k != 0:
        u := 1.0 + x
        let hu = u32(f64_bits(u) >> 32)
        hu += 0x3ff00000 - 0x3fe6a09e
        k = i32(hu >> 20) - 0x3ff
        # Correction term ~ log(1+x) - log(u), avoiding underflow in c/u.
        if k < 54:
            c = if k >= 2: 1.0 - (u - x) else: x - (u - 1.0)
            c /= u
        else:
            c = 0.0
        # Reduce u into [sqrt(2)/2, sqrt(2)].
        hu = (hu & 0x000fffff) + 0x3fe6a09e
        f = f64_from((u64(hu) << 32) | (f64_bits(u) & 0xffffffff)) - 1.0
    hfsq := 0.5 * f * f
    s := f / (2.0 + f)
    z := s * s
    w := z * z
    t1 := (
        w
        * (3.999999999940941908e-01 + w * (2.222219843214978396e-01 + w * 1.531383769920937332e-01))
    )
    t2 := (
        z
        * (
            6.666666666666735130e-01
            + w * (
                2.857142874366239149e-01
                + w * (1.818357216161805012e-01 + w * 1.479819860511658591e-01)
            )
        )
    )
    r := t2 + t1
    dk := f64(k)
    (
        s * (hfsq + r)
        + (dk * 1.90821492927058770002e-10 + c)
        - hfsq
        + f
        + dk * 6.93147180369123816490e-01
    )

# musl logf_data.c (Arm): for 16 subintervals, the bits of 1/c and log(c).
@inline(.Always)
fn libm_logf_table() -> string:
    "}MN}xp]Wu~B]jIb?]~]T~J|_wjIt][t~BZvEofAnnQ~JoA@{ofRds~BfhRS~xiFO~JDM?moUXqr~BhRa_ea\\KJ~JdQEaKcPBr~BW\\FoI{sTE~J_ywAzHaVq~B?CGfFnai@~J~ObEIhsmp~B]x?bMZfRy}JyUmaobtGp~BKrPWYprdp}JfAOe@|Rdo~B]oOwwOnSa}J????????o~B???????????k]ce|rGWm~BCed{\\hYhi}B_ie?^KJhk~BsyaLiMdV{}BernYVXBGj~BGkLGvTmHD~BlgYgbDloh~Bo\\cGLWgoJ~BlFC]BWm`g~B`zFgGnW@P~Ba`sStr|Xf~BHwmlV@B@S~B"

# musl logf.c (Arm), in double.
fn libm_logf(x: f32) -> f32:
    let ix = f32_bits(x)
    if ix == 0x3f800000:
        return 0.0
    if ix.wrapping_sub(0x00800000) >= 0x7f800000 - 0x00800000:
        # x < 0x1p-126 or inf or nan.
        if ix << 1 == 0:
            return -1.0 / 0.0
        if ix == 0x7f800000:
            return x
        if (ix & 0x80000000) != 0 || ix << 1 >= 0xff000000:
            return (x - x) / (x - x)
        # x is subnormal: normalize it.
        ix = f32_bits(x * 8388608.0).wrapping_sub(0x0b800000)
    # x = 2^k z, with z in [OFF, 2*OFF] and exact.
    tmp := ix.wrapping_sub(0x3f330000)
    i := usize((tmp >> 19) & 15)
    k := i32(tmp) >> 23
    iz := ix.wrapping_sub(tmp & 0xff800000)
    table := libm_logf_table()
    invc := libm_float(table, 2 * i)
    logc := libm_float(table, 2 * i + 1)
    z := f64(f32_from(iz))
    # log(x) = log1p(z/c - 1) + log(c) + k*ln2.
    r := z * invc - 1.0
    y0 := logc + f64(k) * 0.6931471805599453
    r2 := r * r
    let y = 0.333456765744066 * r + -0.4999997485802103
    y = -0.25089342214237154 * r2 + y
    y = y * r2 + (y0 + r)
    f32(y)

# musl log2f.c (Arm), in double.
fn libm_log2f(x: f32) -> f32:
    let ix = f32_bits(x)
    if ix == 0x3f800000:
        return 0.0
    if ix.wrapping_sub(0x00800000) >= 0x7f800000 - 0x00800000:
        # x < 0x1p-126 or inf or nan.
        if ix << 1 == 0:
            return -1.0 / 0.0
        if ix == 0x7f800000:
            return x
        if (ix & 0x80000000) != 0 || ix << 1 >= 0xff000000:
            return (x - x) / (x - x)
        # x is subnormal: normalize it.
        ix = f32_bits(x * 8388608.0).wrapping_sub(0x0b800000)
    tmp := ix.wrapping_sub(0x3f330000)
    i := usize((tmp >> 19) & 15)
    top := tmp & 0xff800000
    iz := ix.wrapping_sub(top)
    k := i32(tmp) >> 23
    table := libm_log2f_table()
    invc := libm_float(table, 2 * i)
    logc := libm_float(table, 2 * i + 1)
    z := f64(f32_from(iz))
    # log2(x) = log1p(z/c - 1)/ln2 + log2(c) + k.
    r := z * invc - 1.0
    y0 := logc + f64(k)
    r2 := r * r
    let y = 0.4811247078767291 * r + -0.7213476299867769
    y = -0.36051725506874704 * r2 + y
    p := 1.4426950186867042 * r + y0
    y = y * r2 + p
    f32(y)

# musl log10f.c (Sun), in f32.
fn libm_log10f(value: f32) -> f32:
    let x = value
    let ix = f32_bits(x)
    let k: i32 = 0
    if ix < 0x00800000 || (ix >> 31) != 0:
        if ix << 1 == 0:
            return -1.0 / (x * x)
        if (ix >> 31) != 0:
            return (x - x) / 0.0
        # Subnormal: scale x up.
        k -= 25
        x *= 33554432.0
        ix = f32_bits(x)
    else if ix >= 0x7f800000:
        return x
    else if ix == 0x3f800000:
        return 0.0
    # Reduce x into [sqrt(2)/2, sqrt(2)].
    ix += 0x3f800000 - 0x3f3504f3
    k += i32(ix >> 23) - 0x7f
    ix = (ix & 0x007fffff) + 0x3f3504f3
    x = f32_from(ix)
    f := x - 1.0
    s := f / (2.0 + f)
    z := s * s
    w := z * z
    t1 := w * (0.40000972 + w * 0.24279079)
    t2 := z * (0.6666666 + w * 0.28498787)
    r := t2 + t1
    hfsq := 0.5 * f * f
    hi := f32_from(f32_bits(f - hfsq) & 0xfffff000)
    lo := f - hi - hfsq + s * (hfsq + r)
    dk := f32(k)
    (
        dk * 7.903415e-07
        + (lo + hi) * -3.168997e-05
        + lo * 0.43432617
        + hi * 0.43432617
        + dk * 0.3010292
    )

# musl log1pf.c (Sun), in f32.
fn libm_log1pf(value: f32) -> f32:
    let x = value
    ix := f32_bits(x)
    let k: i32 = 1
    let c: f32 = 0.0
    let f: f32 = 0.0
    if ix < 0x3ed413d0 || (ix >> 31) != 0:
        # 1+x < sqrt(2)+.
        if ix >= 0xbf800000:
            # x <= -1.0.
            if x == -1.0:
                return x / 0.0
            return (x - x) / 0.0
        if ix << 1 < 0x67000000:
            # |x| < 2^-24.
            return x
        if ix <= 0xbe95f619:
            # sqrt(2)/2- <= 1+x < sqrt(2)+.
            k = 0
            c = 0.0
            f = x
    else if ix >= 0x7f800000:
        return x
    if k != 0:
        u := 1.0 + x
        let iu = f32_bits(u)
        iu += 0x3f800000 - 0x3f3504f3
        k = i32(iu >> 23) - 0x7f
        # Correction term ~ log(1+x) - log(u), avoiding underflow in c/u.
        if k < 25:
            c = if k >= 2: 1.0 - (u - x) else: x - (u - 1.0)
            c /= u
        else:
            c = 0.0
        # Reduce u into [sqrt(2)/2, sqrt(2)].
        iu = (iu & 0x007fffff) + 0x3f3504f3
        f = f32_from(iu) - 1.0
    s := f / (2.0 + f)
    z := s * s
    w := z * z
    t1 := w * (0.40000972 + w * 0.24279079)
    t2 := z * (0.6666666 + w * 0.28498787)
    r := t2 + t1
    hfsq := 0.5 * f * f
    dk := f32(k)
    s * (hfsq + r) + (dk * 9.058001e-06 + c) - hfsq + f + dk * 0.6931381

# musl expm1.c (Sun): exp(x) - 1, accurate near zero.
fn libm_expm1(value: f64) -> f64:
    let x = value
    bits := f64_bits(x)
    hx := u32(bits >> 32) & 0x7fffffff
    sign := (bits >> 63) != 0
    # Filter out huge and non-finite arguments.
    if hx >= 0x4043687a:
        # |x| >= 56*ln2.
        if x != x:
            return x
        if sign:
            return -1.0
        if x > 7.09782712893383973096e+02:
            return x * 8.98846567431158e+307
    let k: i32 = 0
    let c = 0.0
    if hx > 0x3fd62e42:
        # |x| > 0.5 ln2: argument reduction.
        let hi = 0.0
        let lo = 0.0
        if hx < 0x3ff0a2b2:
            # and |x| < 1.5 ln2.
            if !sign:
                hi = x - 6.93147180369123816490e-01
                lo = 1.90821492927058770002e-10
                k = 1
            else:
                hi = x + 6.93147180369123816490e-01
                lo = -1.90821492927058770002e-10
                k = -1
        else:
            k = i32(1.44269504088896338700e+00 * x + (if sign: -0.5 else: 0.5))
            t := f64(k)
            # t*ln2_hi is exact here.
            hi = x - t * 6.93147180369123816490e-01
            lo = t * 1.90821492927058770002e-10
        x = hi - lo
        c = (hi - x) - lo
    else if hx < 0x3c900000:
        # |x| < 2^-54: return x.
        return x
    # x is now in the primary range.
    hfx := 0.5 * x
    hxs := x * hfx
    r1 := (
        1.0
        + hxs * (
            -3.33333333333331316428e-02
            + hxs * (
                1.58730158725481460165e-03
                + hxs * (
                    -7.93650757867487942473e-05
                    + hxs * (4.00821782732936239552e-06 + hxs * -2.01099218183624371326e-07)
                )
            )
        )
    )
    t := 3.0 - r1 * hfx
    let e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0:
        # c is 0.
        return x - (x * e - hxs)
    e = x * (e - c) - c
    e -= hxs
    # exp(x) ~ 2^k (x_reduced - e + 1).
    if k == -1:
        return 0.5 * (x - e) - 0.5
    if k == 1:
        if x < -0.25:
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    twopk := f64_from(u64(0x3ff + k) << 52)
    if k < 0 || k > 56:
        # It suffices to return exp(x) - 1.
        let y = x - e + 1.0
        if k == 1024:
            y = y * 2.0 * 8.98846567431158e+307
        else:
            y = y * twopk
        return y - 1.0
    inverse := f64_from(u64(0x3ff - k) << 52)
    if k < 20: (x - e + (1.0 - inverse)) * twopk else: (x - (e + inverse) + 1.0) * twopk

# musl expm1f.c (Sun), in f32.
fn libm_expm1f(value: f32) -> f32:
    let x = value
    bits := f32_bits(x)
    hx := bits & 0x7fffffff
    sign := (bits >> 31) != 0
    if hx >= 0x4195b844:
        # |x| >= 27*ln2.
        if hx > 0x7f800000:
            return x
        if sign:
            return -1.0
        if hx > 0x42b17217:
            # x > log(FLT_MAX).
            return x * 1.7014118e+38
    let k: i32 = 0
    let c: f32 = 0.0
    if hx > 0x3eb17218:
        # |x| > 0.5 ln2: argument reduction.
        let hi: f32 = 0.0
        let lo: f32 = 0.0
        if hx < 0x3f851592:
            # and |x| < 1.5 ln2.
            if !sign:
                hi = x - 0.6931381
                lo = 9.058001e-06
                k = 1
            else:
                hi = x + 0.6931381
                lo = -9.058001e-06
                k = -1
        else:
            k = i32(1.442695 * x + (if sign: -0.5 else: 0.5))
            t := f32(k)
            hi = x - t * 0.6931381
            lo = t * 9.058001e-06
        x = hi - lo
        c = (hi - x) - lo
    else if hx < 0x33000000:
        # |x| < 2^-25: return x.
        return x
    hfx := 0.5 * x
    hxs := x * hfx
    r1 := 1.0 + hxs * (-0.033333212 + hxs * 0.001580717)
    t := 3.0 - r1 * hfx
    let e = hxs * ((r1 - t) / (6.0 - x * t))
    if k == 0:
        return x - (x * e - hxs)
    e = x * (e - c) - c
    e -= hxs
    if k == -1:
        return 0.5 * (x - e) - 0.5
    if k == 1:
        if x < -0.25:
            return -2.0 * (e - (x + 0.5))
        return 1.0 + 2.0 * (x - e)
    twopk := f32_from(u32(0x7f + k) << 23)
    if k < 0 || k > 56:
        let y = x - e + 1.0
        if k == 128:
            y = y * 2.0 * 1.7014118e+38
        else:
            y = y * twopk
        return y - 1.0
    inverse := f32_from(u32(0x7f - k) << 23)
    if k < 23: (x - e + (1.0 - inverse)) * twopk else: (x - (e + inverse) + 1.0) * twopk

# musl __expo2.c: exp(x)/2 for x >= log(DBL_MAX), as exp(x - k ln2) *
# 2^(k-1) with k = 2043.
fn libm_expo2(x: f64, sign: f64) -> f64:
    scale := f64_from(0x7fc0000000000000)
    libm_exp(x - 1416.0996898839683) * (sign * scale) * scale

# musl __expo2f.c: as __expo2.c, with k = 235.
fn libm_expo2f(x: f32, sign: f32) -> f32:
    scale := f32_from(0x7a000000)
    libm_expf(x - 162.88959) * (sign * scale) * scale

# musl sinh.c: (exp(x) - 1/exp(x))/2, through expm1.
fn libm_sinh(x: f64) -> f64:
    h := if (f64_bits(x) >> 63) != 0: -0.5 else: 0.5
    magnitude := f64_bits(x) & 0x7fffffffffffffff
    absx := f64_from(magnitude)
    w := u32(magnitude >> 32)
    # |x| < log(DBL_MAX).
    if w < 0x40862e42:
        t := libm_expm1(absx)
        if w < 0x3ff00000:
            if w < 0x3ff00000 - (26 << 20):
                return x
            return h * (2.0 * t - t * t / (t + 1.0))
        return h * (t + t / (t + 1.0))
    # |x| > log(DBL_MAX) or nan.
    libm_expo2(absx, 2.0 * h)

# musl sinhf.c.
fn libm_sinhf(x: f32) -> f32:
    let h: f32 = 0.5
    if (f32_bits(x) >> 31) != 0:
        h = -h
    w := f32_bits(x) & 0x7fffffff
    absx := f32_from(w)
    # |x| < log(FLT_MAX).
    if w < 0x42b17217:
        t := libm_expm1f(absx)
        if w < 0x3f800000:
            if w < 0x3f800000 - (12 << 23):
                return x
            return h * (2.0 * t - t * t / (t + 1.0))
        return h * (t + t / (t + 1.0))
    libm_expo2f(absx, 2.0 * h)

# musl cosh.c: 1 + (exp(x) - 1)^2 / (2 exp(x)) near zero, else
# (exp(x) + 1/exp(x))/2.
fn libm_cosh(value: f64) -> f64:
    magnitude := f64_bits(value) & 0x7fffffffffffffff
    x := f64_from(magnitude)
    w := u32(magnitude >> 32)
    # |x| < log(2).
    if w < 0x3fe62e42:
        if w < 0x3ff00000 - (26 << 20):
            return 1.0
        t := libm_expm1(x)
        return 1.0 + t * t / (2.0 * (1.0 + t))
    # |x| < log(DBL_MAX).
    if w < 0x40862e42:
        t := libm_exp(x)
        return 0.5 * (t + 1.0 / t)
    # |x| > log(DBL_MAX) or nan.
    libm_expo2(x, 1.0)

# musl coshf.c.
fn libm_coshf(value: f32) -> f32:
    w := f32_bits(value) & 0x7fffffff
    x := f32_from(w)
    # |x| < log(2).
    if w < 0x3f317217:
        if w < 0x3f800000 - (12 << 23):
            return 1.0
        t := libm_expm1f(x)
        return 1.0 + t * t / (2.0 * (1.0 + t))
    # |x| < log(FLT_MAX).
    if w < 0x42b17217:
        t := libm_expf(x)
        return 0.5 * (t + 1.0 / t)
    libm_expo2f(x, 1.0)

# musl tanh.c: (exp(2x) - 1) / (exp(2x) + 1), through expm1.
fn libm_tanh(value: f64) -> f64:
    sign := (f64_bits(value) >> 63) != 0
    magnitude := f64_bits(value) & 0x7fffffffffffffff
    x := f64_from(magnitude)
    w := u32(magnitude >> 32)
    let t = x
    if w > 0x3fe193ea:
        # |x| > log(3)/2 ~= 0.5493 or nan.
        if w > 0x40340000:
            # |x| > 20 or nan.
            t = 1.0 - 0.0 / x
        else:
            t = libm_expm1(2.0 * x)
            t = 1.0 - 2.0 / (t + 2.0)
    else if w > 0x3fd058ae:
        # |x| > log(5/3)/2 ~= 0.2554.
        t = libm_expm1(2.0 * x)
        t = t / (t + 2.0)
    else if w >= 0x00100000:
        # |x| >= 0x1p-1022.
        t = libm_expm1(-2.0 * x)
        t = -t / (t + 2.0)
    if sign: -t else: t

# musl tanhf.c.
fn libm_tanhf(value: f32) -> f32:
    sign := (f32_bits(value) >> 31) != 0
    w := f32_bits(value) & 0x7fffffff
    x := f32_from(w)
    let t = x
    if w > 0x3f0c9f54:
        # |x| > log(3)/2 ~= 0.5493 or nan.
        if w > 0x41200000:
            # |x| > 10.
            t = 1.0 + 0.0 / x
        else:
            t = libm_expm1f(2.0 * x)
            t = 1.0 - 2.0 / (t + 2.0)
    else if w > 0x3e82c578:
        # |x| > log(5/3)/2 ~= 0.2554.
        t = libm_expm1f(2.0 * x)
        t = t / (t + 2.0)
    else if w >= 0x00800000:
        # |x| >= 0x1p-126.
        t = libm_expm1f(-2.0 * x)
        t = -t / (t + 2.0)
    if sign: -t else: t

# musl asinh.c: sign(x) * log(|x| + sqrt(x*x + 1)).
fn libm_asinh(value: f64) -> f64:
    bits := f64_bits(value)
    e := u32(bits >> 52) & 0x7ff
    sign := (bits >> 63) != 0
    let x = f64_from(bits & 0x7fffffffffffffff)
    if e >= 0x3ff + 26:
        # |x| >= 0x1p26 or inf or nan.
        x = libm_log(x) + 0.693147180559945309417232121458176568
    else if e >= 0x3ff + 1:
        # |x| >= 2.
        x = libm_log(2.0 * x + 1.0 / ((x * x + 1.0).sqrt() + x))
    else if e >= 0x3ff - 26:
        # |x| >= 0x1p-26.
        x = libm_log1p(x + x * x / ((x * x + 1.0).sqrt() + 1.0))
    if sign: -x else: x

# musl asinhf.c.
fn libm_asinhf(value: f32) -> f32:
    i := f32_bits(value) & 0x7fffffff
    sign := (f32_bits(value) >> 31) != 0
    let x = f32_from(i)
    if i >= 0x3f800000 + (12 << 23):
        # |x| >= 0x1p12 or inf or nan.
        x = libm_logf(x) + 0.6931472
    else if i >= 0x3f800000 + (1 << 23):
        # |x| >= 2.
        x = libm_logf(2.0 * x + 1.0 / ((x * x + 1.0).sqrt() + x))
    else if i >= 0x3f800000 - (12 << 23):
        # |x| >= 0x1p-12.
        x = libm_log1pf(x + x * x / ((x * x + 1.0).sqrt() + 1.0))
    if sign: -x else: x

# musl acosh.c: log(x + sqrt(x*x - 1)).
fn libm_acosh(x: f64) -> f64:
    e := u32(f64_bits(x) >> 52) & 0x7ff
    if e < 0x3ff + 1:
        # |x| < 2: invalid if x < 1.
        return libm_log1p(x - 1.0 + ((x - 1.0) * (x - 1.0) + 2.0 * (x - 1.0)).sqrt())
    if e < 0x3ff + 26:
        # |x| < 0x1p26.
        return libm_log(2.0 * x - 1.0 / (x + (x * x - 1.0).sqrt()))
    # |x| >= 0x1p26 or nan.
    libm_log(x) + 0.693147180559945309417232121458176568

# musl acoshf.c.
fn libm_acoshf(x: f32) -> f32:
    bits := f32_bits(x)
    if (bits & 0x7fffffff) < 0x3f800000 + (1 << 23):
        # |x| < 2: invalid if x < 1.
        return libm_log1pf(x - 1.0 + ((x - 1.0) * (x - 1.0) + 2.0 * (x - 1.0)).sqrt())
    if bits < 0x3f800000 + (12 << 23):
        # 2 <= x < 0x1p12.
        return libm_logf(2.0 * x - 1.0 / (x + (x * x - 1.0).sqrt()))
    # x >= 0x1p12 or x <= -2 or nan.
    libm_logf(x) + 0.6931472

# musl atanh.c: log1p(2x/(1-x))/2.
fn libm_atanh(value: f64) -> f64:
    bits := f64_bits(value)
    e := u32(bits >> 52) & 0x7ff
    sign := (bits >> 63) != 0
    let y = f64_from(bits & 0x7fffffffffffffff)
    if e < 0x3ff - 1:
        if e >= 0x3ff - 32:
            # |x| < 0.5.
            y = 0.5 * libm_log1p(2.0 * y + 2.0 * y * y / (1.0 - y))
    else:
        # Avoid overflow.
        y = 0.5 * libm_log1p(2.0 * (y / (1.0 - y)))
    if sign: -y else: y

# musl atanhf.c.
fn libm_atanhf(value: f32) -> f32:
    magnitude := f32_bits(value) & 0x7fffffff
    sign := (f32_bits(value) >> 31) != 0
    let y = f32_from(magnitude)
    if magnitude < 0x3f800000 - (1 << 23):
        if magnitude >= 0x3f800000 - (32 << 23):
            # |x| < 0.5.
            y = 0.5 * libm_log1pf(2.0 * y + 2.0 * y * y / (1.0 - y))
    else:
        # Avoid overflow.
        y = 0.5 * libm_log1pf(2.0 * (y / (1.0 - y)))
    if sign: -y else: y

# musl cbrt.c (Sun): a rough cube root from the exponent bits, a
# polynomial to 23 bits, then one Newton step to 53 bits.
fn libm_cbrt(x: f64) -> f64:
    let bits = f64_bits(x)
    let hx = u32(bits >> 32) & 0x7fffffff
    if hx >= 0x7ff00000:
        # cbrt(NaN, INF) is itself.
        return x + x
    if hx < 0x00100000:
        # Zero or subnormal.
        bits = f64_bits(x * 18014398509481984.0)
        hx = u32(bits >> 32) & 0x7fffffff
        if hx == 0:
            return x
        hx = hx / 3 + 696219795
    else:
        hx = hx / 3 + 715094163
    let t = f64_from((bits & 0x8000000000000000) | (u64(hx) << 32))
    # New cbrt to 23 bits: cbrt(x) = t*cbrt(x/t**3) ~= t*P(t**3/x).
    let r = (t * t) * (t / x)
    t = (
        t
        * (
            (1.87595182427177009643 + r * (-1.88497979543377169875 + r * 1.621429720105354466140))
            + ((r * r) * r) * (-0.758397934778766047437 + r * 0.145996192886612446982)
        )
    )
    # Round t away from zero to 23 bits.
    t = f64_from(f64_bits(t).wrapping_add(0x80000000) & 0xffffffffc0000000)
    # One Newton step to 53 bits, with error < 0.667 ulps.
    s := t * t
    r = x / s
    w := t + t
    r = (r - t) / (w + r)
    t + t * r

# musl cbrtf.c (Sun): two Newton steps in double.
fn libm_cbrtf(x: f32) -> f32:
    let bits = f32_bits(x)
    let hx = bits & 0x7fffffff
    if hx >= 0x7f800000:
        # cbrt(NaN, INF) is itself.
        return x + x
    if hx < 0x00800000:
        # Zero or subnormal.
        if hx == 0:
            return x
        bits = f32_bits(x * 16777216.0)
        hx = bits & 0x7fffffff
        hx = hx / 3 + 642849266
    else:
        hx = hx / 3 + 709958130
    let t = f64(f32_from((bits & 0x80000000) | hx))
    xd := f64(x)
    let r = t * t * t
    t = t * (xd + xd + r) / (xd + r + r)
    r = t * t * t
    t = t * (xd + xd + r) / (xd + r + r)
    f32(t)

# musl hypot.c `sq`: x*x as an exact hi + lo, by Dekker's split.
@inline(.Always)
fn libm_square(x: f64) -> (f64, f64):
    xc := x * 134217729.0
    xh := x - xc + xc
    xl := x - xh
    hi := x * x
    (hi, xh * xh - hi + 2.0 * xh * xl + xl * xl)

# musl hypot.c: sqrt(x*x + y*y) with the squares exact and the sum
# scaled out of overflow and underflow.
fn libm_hypot(a: f64, b: f64) -> f64:
    let ux = f64_bits(a) & 0x7fffffffffffffff
    let uy = f64_bits(b) & 0x7fffffffffffffff
    # Arrange |x| >= |y|.
    if ux < uy:
        swap := ux
        ux = uy
        uy = swap
    ex := i32(ux >> 52)
    ey := i32(uy >> 52)
    let x = f64_from(ux)
    let y = f64_from(uy)
    # hypot(inf, nan) == inf.
    if ey == 0x7ff:
        return y
    if ex == 0x7ff || uy == 0:
        return x
    if ex - ey > 64:
        return x + y
    # A precise sqrt argument without overflow.
    let z = 1.0
    if ex > 0x3ff + 510:
        z = 5.260135901548374e+210
        x *= 1.90109156629516e-211
        y *= 1.90109156629516e-211
    else if ey < 0x3ff - 450:
        z = 1.90109156629516e-211
        x *= 5.260135901548374e+210
        y *= 5.260135901548374e+210
    let (hx, lx) = libm_square(x)
    let (hy, ly) = libm_square(y)
    z * (ly + lx + hy + hx).sqrt()

# musl hypotf.c: the sum of squares in double.
fn libm_hypotf(a: f32, b: f32) -> f32:
    let ux = f32_bits(a) & 0x7fffffff
    let uy = f32_bits(b) & 0x7fffffff
    if ux < uy:
        swap := ux
        ux = uy
        uy = swap
    let x = f32_from(ux)
    let y = f32_from(uy)
    if uy == 0x7f800000:
        return y
    if ux >= 0x7f800000 || uy == 0 || ux - uy >= 25 << 23:
        return x + y
    let z: f32 = 1.0
    if ux >= (0x7f + 60) << 23:
        z = 1.23794004e+27
        x *= 8.077936e-28
        y *= 8.077936e-28
    else if uy < (0x7f - 60) << 23:
        z = 8.077936e-28
        x *= 1.23794004e+27
        y *= 1.23794004e+27
    z * f32(f64(x) * f64(x) + f64(y) * f64(y)).sqrt()

# musl scalbn.c: x * 2^n, rounding once.
fn libm_scalbn(x: f64, count: i32) -> f64:
    let n = count
    let y = x
    if n > 1023:
        y *= 8.98846567431158e+307
        n -= 1023
        if n > 1023:
            y *= 8.98846567431158e+307
            n -= 1023
            if n > 1023:
                n = 1023
    else if n < -1022:
        # Make the final n < -53 to avoid a double rounding in the
        # subnormal range.
        y *= 2.004168360008973e-292
        n += 1022 - 53
        if n < -1022:
            y *= 2.004168360008973e-292
            n += 1022 - 53
            if n < -1022:
                n = -1022
    y * f64_from(u64(0x3ff + n) << 52)

# musl fma.c `normalize`: the significand shifted so its top 10 bits and
# last bit are 0, its exponent, and its sign bit (0x800 or 0).
fn libm_fma_split(x: f64) -> (u64, i32, i32):
    let ix = f64_bits(x)
    let e = i32(ix >> 52)
    sign := e & 0x800
    e = e & 0x7ff
    if e == 0:
        ix = f64_bits(x * 9.223372036854776e+18)
        e = i32((ix >> 52) & 0x7ff)
        e = if e != 0: e - 63 else: 0x800
    ix = (ix & 0x000fffffffffffff) | 0x0010000000000000
    (ix << 1, e - (0x3ff + 52 + 1), sign)

# musl fma.c `mul`: the 128-bit product of two significands, as (hi, lo).
fn libm_fma_mul(x: u64, y: u64) -> (u64, u64):
    xlo := x & 0xffffffff
    xhi := x >> 32
    ylo := y & 0xffffffff
    yhi := y >> 32
    t1 := xlo * ylo
    t2 := xlo * yhi + xhi * ylo
    t3 := xhi * yhi
    lo := t1.wrapping_add(t2 << 32)
    (t3 + (t2 >> 32) + (if t1 > lo: 1 else: 0), lo)

# musl fma.c: x*y + z with one rounding, in 128-bit integer arithmetic.
# Every path is a fixed number of steps.
fn libm_fma(x: f64, y: f64, z: f64) -> f64:
    let (mx, ex, sx) = libm_fma_split(x)
    let (my, ey, sy) = libm_fma_split(y)
    let (mz, ez, sz) = libm_fma_split(z)
    # 971 is 0x7ff - 0x3ff - 52 - 1: a zero, infinity or NaN.
    if ex >= 971 || ey >= 971:
        return x * y + z
    if ez >= 971:
        if ez > 971:
            # z == 0.
            return x * y + z
        return z
    # mul: r = x*y; either the top 20 or 21 bits of rhi and the last 2
    # bits of rlo are 0.
    let (rhi, rlo) = libm_fma_mul(mx, my)
    # Align the exponents: z <<= kz and r >>= kr, with kz + kr == d.
    let e = ex + ey
    let d = ez - e
    let zhi: u64 = 0
    let zlo: u64 = 0
    if d > 0:
        if d < 64:
            zlo = mz << u32(d)
            zhi = mz >> u32(64 - d)
        else:
            zlo = 0
            zhi = mz
            e = ez - 64
            d -= 64
            if d == 0:
                pass
            else if d < 64:
                let sticky: u64 = if (rlo << u32(64 - d)) != 0: 1 else: 0
                rlo = (rhi << u32(64 - d)) | (rlo >> u32(d)) | sticky
                rhi = rhi >> u32(d)
            else:
                rlo = 1
                rhi = 0
    else:
        zhi = 0
        d = -d
        if d == 0:
            zlo = mz
        else if d < 64:
            zlo = (mz >> u32(d)) | (if (mz << u32(64 - d)) != 0: 1 else: 0)
        else:
            zlo = 1
    # Add.
    let negative = (sx ^ sy) != 0
    let nonzero = true
    if (sx ^ sy ^ sz) == 0:
        # r += z.
        rlo = rlo.wrapping_add(zlo)
        rhi = rhi.wrapping_add(zhi.wrapping_add(if rlo < zlo: 1 else: 0))
    else:
        # r -= z.
        t := rlo
        rlo = rlo.wrapping_sub(zlo)
        rhi = rhi.wrapping_sub(zhi).wrapping_sub(if t < rlo: 1 else: 0)
        if (rhi >> 63) != 0:
            rlo = u64(0).wrapping_sub(rlo)
            rhi = u64(0).wrapping_sub(rhi).wrapping_sub(if rlo != 0: 1 else: 0)
            negative = !negative
        nonzero = rhi != 0
    # Set rhi to the top 63 bits of the result; the last bit is sticky.
    if nonzero:
        e += 64
        d = i32(rhi.leading_zeros()) - 1
        # d > 0.
        let sticky: u64 = if (rlo << u32(d)) != 0: 1 else: 0
        rhi = (rhi << u32(d)) | (rlo >> u32(64 - d)) | sticky
    else if rlo != 0:
        d = i32(rlo.leading_zeros()) - 1
        if d < 0:
            rhi = (rlo >> 1) | (rlo & 1)
        else:
            rhi = rlo << u32(d)
    else:
        # An exact +-0.
        return x * y + z
    e -= d
    # Convert to double: i is in [1<<62, (1<<63)-1].
    let i = i64(rhi)
    if negative:
        i = -i
    # |r| is in [0x1p62, 0x1p63].
    let r = f64(i)
    if e < -1022 - 62:
        # The result is subnormal before rounding.
        if e == -1022 - 63:
            c := if negative: -9.223372036854776e+18 else: 9.223372036854776e+18
            if r == c:
                # The minimum normal after rounding; musl imitates the
                # underflow with a conversion to float.
                smallest := f32(1.2744734909236908e-57 * r)
                return 1.8928834978668395e-270 * f64(smallest)
            # One bit is lost when scaled: add another top bit to round
            # only once at the conversion when it is inexact.
            if (rhi << 53) != 0:
                i = i64((rhi >> 1) | (rhi & 1) | 0x4000000000000000)
                if negative:
                    i = -i
                r = f64(i)
                # Remove the top bit.
                r = 2.0 * r - c
        else:
            # Round only once when scaled.
            let sticky: u64 = if (rhi << 54) != 0: 1 else: 0
            i = i64(((rhi >> 10) | sticky) << 10)
            if negative:
                i = -i
            r = f64(i)
    libm_scalbn(r, e)

