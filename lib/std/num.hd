    @inline(.Always)
    fn get(&self, index: i32) -> f64:
        f64_from(load_u64(address_of(&self.cells) + usize(index) * 8))

    @inline(.Always)
    fn set(&mut self, index: i32, value: f64) -> void:
        store_u64(address_of(&self.cells) + usize(index) * 8, f64_bits(value))

# The 66 24-bit limbs used by fdlibm for IEEE binary64; wider long-double
# tables are not needed because hd's largest binary format is binary64.
fn float_two_over_pi(index: i32) -> f64:
    # Base64 holds each 24-bit limb in four ASCII bytes: the same 264 bytes
    # as the C table, in immutable string storage rather than a heap list.
    words := "ovmDbk5EFSn8J1fR9TTdwNtilZk8Q5BB/lFjq967xWG3JG46Qk3S4AZJLuoJ0ZIc/h3rHLEppz7ogjX1LrtEhOmccCa0X35BOZHWOYNTOfSchF+LvfkoOx/4l//eBZgP7y8Ri1oKbR9tNn7PJ8sJt09GP2aeX+otdSe6x+vl8Xs9Bzn3ilKS6mv7X7EfjV0IVgMwRvx7a6vwz7wgmvQ2HanjkWFe5hsIZZmFXxSgaECN/9iATXMnMQYGFVbKc6jJYOJ7wIxr"
    start := usize(index) * 4
    first := float_limb_digit(bytes_at(words, start))
    second := float_limb_digit(bytes_at(words, start + 1))
    third := float_limb_digit(bytes_at(words, start + 2))
    fourth := float_limb_digit(bytes_at(words, start + 3))
    f64((first << 18) | (second << 12) | (third << 6) | fourth)

@inline(.Always)
fn float_limb_digit(byte: u8) -> u32:
    if byte >= 65 && byte <= 90:
        return u32(byte) - 65
    if byte >= 97 && byte <= 122:
        return u32(byte) - 71
    if byte >= 48 && byte <= 57:
        return u32(byte) + 4
    if byte == 43: 62 else: 63

fn float_scale_binary(value: f64, exponent: i32) -> f64:
    if exponent < -1022:
        return value * float_power_of_two(exponent + 1022) * float_power_of_two(-1022)
    if exponent > 1023:
        return value * float_power_of_two(exponent - 1023) * float_power_of_two(1023)
    value * float_power_of_two(exponent)

fn float_reduction_digit(digits: (f64, f64, f64), index: i32) -> f64:
    match index:
        0 => digits._0
        1 => digits._1
        _ => digits._2

fn float_half_pi_digit(index: i32) -> f64:
    match index:
        0 => 1.57079625129699707031e+00
        1 => 7.54978941586159635335e-08
        2 => 5.39030252995776476554e-15
        3 => 3.28200341580791294123e-22
        _ => 1.27065575308067607349e-29

# fdlibm's double-precision Payne-Hanek kernel: multiply only the window
# of 2/pi that contributes the low three quotient bits and remainder.
# Each input has at most three 24-bit digits. The table fixes the total
# width; recomputation extends its window and never recurses.
fn float_reduce_large(value: f64) -> (i32, f64, f64):
    magnitude := value.abs()
    exponent := i32(high_word(magnitude) >> 20) - 1046
    scaled := f64_from((f64_bits(magnitude) & 0x000fffffffffffff) | (1046 << 52))
    first := scaled.trunc()
    rest := (scaled - first) * 16777216.0
    second := rest.trunc()
    third := (rest - second) * 16777216.0
    digits := (first, second, third)
    last := if third != 0.0: +2 else: (if second != 0.0: +1 else: +0)
    start := if exponent > 3: (exponent - 3) / 24 else: +0
    let scale = exponent - 24 * (start + 1)
    let mut f = FloatReductionWords::new()
    let mut q = FloatReductionWords::new()
    let mut iq = FloatReductionWords::new()
    let mut fq = FloatReductionWords::new()
    let i: i32 = 0
    while i <= last + 4:
        at := start - last + i
        f.set(i, if at < 0: 0.0 else: float_two_over_pi(at))
        i += 1
    i = 0
    while i <= 4:
        let sum = 0.0
        let j: i32 = 0
        while j <= last:
            sum += float_reduction_digit(digits, j) * f.get(last + i - j)
            j += 1
        q.set(i, sum)
        i += 1
    let end: i32 = 4
    let n: i32 = 0
    let z = 0.0
    let half: i32 = 0
    while true:
        z = q.get(end)
        let j = end
        i = 0
        while j > 0:
            carry := (z * 5.9604644775390625e-08).trunc()
            iq.set(i, z - 16777216.0 * carry)
            z = q.get(j - 1) + carry
            i += 1
            j -= 1
        z = float_scale_binary(z, scale)
        z -= 8.0 * (z * 0.125).floor()
        n = i32(z)
        z -= f64(n)
        half = 0
        if scale > 0:
            top := i32(iq.get(end - 1))
            extra := top >> u32(24 - scale)
            n += extra
            iq.set(end - 1, f64(top - (extra << u32(24 - scale))))
            half = i32(iq.get(end - 1)) >> u32(23 - scale)
        else if scale == 0:
            half = i32(iq.get(end - 1)) >> 23
        else if z >= 0.5:
            half = 2
        if half > 0:
            n += 1
            let carry: i32 = 0
            i = 0
            while i < end:
                digit := i32(iq.get(i))
                if carry == 0:
                    if digit != 0:
                        carry = 1
                        iq.set(i, f64(16777216 - digit))
                else:
                    iq.set(i, f64(16777215 - digit))
                i += 1
            if scale == 1:
                iq.set(end - 1, f64(i32(iq.get(end - 1)) & 0x7fffff))
            else if scale == 2:
                iq.set(end - 1, f64(i32(iq.get(end - 1)) & 0x3fffff))
            if half == 2:
                z = 1.0 - z
                if carry != 0:
                    z -= float_scale_binary(1.0, scale)
        if z == 0.0:
            let any: i32 = 0
            i = end - 1
            while i >= 4:
                any = any | i32(iq.get(i))
                i -= 1
            if any == 0:
                let more: i32 = 1
                while iq.get(4 - more) == 0.0:
                    more += 1
                i = end + 1
                while i <= end + more:
                    f.set(last + i, float_two_over_pi(start + i))
                    let sum = 0.0
                    let j: i32 = 0
                    while j <= last:
                        sum += float_reduction_digit(digits, j) * f.get(last + i - j)
                        j += 1
                    q.set(i, sum)
                    i += 1
                end += more
                continue
        break
    if z == 0.0:
        end -= 1
        scale -= 24
        while iq.get(end) == 0.0:
            end -= 1
            scale -= 24
    else:
        z = float_scale_binary(z, -scale)
        if z >= 16777216.0:
            carry := (z * 5.9604644775390625e-08).trunc()
            iq.set(end, z - 16777216.0 * carry)
            end += 1
            scale += 24
            iq.set(end, carry)
        else:
            iq.set(end, z)
    let weight = float_scale_binary(1.0, scale)
    i = end
    while i >= 0:
        q.set(i, weight * iq.get(i))
        weight *= 5.9604644775390625e-08
        i -= 1
    i = end
    while i >= 0:
        let sum = 0.0
        let k: i32 = 0
        while k <= 4 && k <= end - i:
            sum += float_half_pi_digit(k) * q.get(i + k)
            k += 1
        fq.set(end - i, sum)
        i -= 1
    let head = 0.0
    i = end
    while i >= 0:
        head += fq.get(i)
        i -= 1
    let tail = fq.get(0) - head
    i = 1
    while i <= end:
        tail += fq.get(i)
        i += 1
    if half != 0:
        head = -head
        tail = -tail
    if value < 0.0: (-(n & 7), -head, -tail) else: (n & 7, head, tail)

fn float_reduce_half_pi(value: f64) -> (i32, f64, f64):
    word := high_word(value) & 0x7fffffff
    if word >= 0x413921fb:
        return float_reduce_large(value)
    # The medium algorithm also covers the four small nonzero quadrants.
    # Wasm's native nearest replaces fdlibm's rounding-mode add/sub trick.
    count := (value * 6.36619772367581382433e-01).round_ties_even()
    let r = value - count * 1.57079632673412561417
    let w = count * 6.07710050650619224932e-11
    let head = r - w
    original_exponent := i32(word >> 20)
    if original_exponent - i32((high_word(head) >> 20) & 0x7ff) > 16:
        previous := r
        part := count * 6.07710050630396597660e-11
        r = previous - part
        w = count * 2.02226624879595063154e-21 - ((previous - r) - part)
        head = r - w
        if original_exponent - i32((high_word(head) >> 20) & 0x7ff) > 49:
            previous := r
            part := count * 2.02226624871116645580e-21
            r = previous - part
            w = count * 8.47842766036889956997e-32 - ((previous - r) - part)
            head = r - w
    (i32(count), head, (r - head) - w)

fn float_sin_kernel(x: f64, tail: f64, reduced: bool) -> f64:
    square := x * x
    fourth := square * square
    remainder := (
        8.33333333332248946124e-03
        + square * (-1.98412698298579493134e-04 + square * 2.75573137070700676789e-06)
        + square * fourth * (-2.50507602534068634195e-08 + square * 1.58969099521155010221e-10)
    )
    cube := square * x
    if !reduced:
        return x + cube * (-1.66666666666666324348e-01 + square * remainder)
    x - ((square * (0.5 * tail - cube * remainder) - tail) - cube * -1.66666666666666324348e-01)

fn float_cos_kernel(x: f64, tail: f64) -> f64:
    square := x * x
    fourth := square * square
    lower_tail := -1.38888888888741095749e-03 + square * 2.48015872894767294178e-05
    lower := square * (4.16666666666666019037e-02 + square * lower_tail)
    upper_tail := 2.08757232129817482790e-09 + square * -1.13596475577881948265e-11
    upper := fourth * fourth * (-2.75573143513906633035e-07 + square * upper_tail)
    remainder := lower + upper
    half_square := 0.5 * square
    head := 1.0 - half_square
    head + (((1.0 - head) - half_square) + (square * remainder - x * tail))

fn float_tan_kernel(value: f64, tail: f64, inverse: bool) -> f64:
    transformed := (high_word(value) & 0x7fffffff) >= 0x3fe59428
    let x = value
    let y = tail
    if transformed:
        if value < 0.0:
            x = -x
            y = -y
        x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y)
        y = 0.0
    square := x * x
    fourth := square * square
    odd4 := 7.81794442939557092300e-05 + fourth * -1.85586374855275456654e-05
    odd3 := 5.88041240820264096874e-04 + fourth * odd4
    odd2 := 3.59207910759131235356e-03 + fourth * odd3
    odd1 := 2.18694882948595424599e-02 + fourth * odd2
    odd := 1.33333333333201242699e-01 + fourth * odd1
    even4 := 7.14072491382608190305e-05 + fourth * 2.59073051863633712884e-05
    even3 := 2.46463134818469906812e-04 + fourth * even4
    even2 := 1.45620945432529025516e-03 + fourth * even3
    even1 := 8.86323982359930005737e-03 + fourth * even2
    even := square * (5.39682539762260521377e-02 + fourth * even1)
    cube := square * x
    correction := (y + square * (cube * (odd + even) + y)) + 3.33333333333334091986e-01 * cube
    sum := x + correction
    if transformed:
        direction := if inverse: -1.0 else: 1.0
        result := direction - 2.0 * (x - (sum * sum / (sum + direction) - correction))
        return if value < 0.0: -result else: result
    if !inverse:
        return sum
    if sum == 0.0:
        return -1.0 / sum
    head := low_cleared(sum)
    tail_sum := correction - (head - x)
    reciprocal := -1.0 / sum
    reciprocal_head := low_cleared(reciprocal)
    reciprocal_head + reciprocal * ((1.0 + reciprocal_head * head) + reciprocal_head * tail_sum)

impl f64:
    ## The sine of this angle in radians.
    ## See [std-num.float-math.sin](../../spec/std/num.md#r-std-num.float-math.sin).
    pub fn sin(self) -> f64:
        word := high_word(self) & 0x7fffffff
        if word < 0x3e500000:
            return self
        if !self.is_finite():
            return self - self
        if word <= 0x3fe921fb:
            return float_sin_kernel(self, 0.0, false)
        reduced := float_reduce_half_pi(self)
        match reduced._0 & 3:
            0 => float_sin_kernel(reduced._1, reduced._2, true)
            1 => float_cos_kernel(reduced._1, reduced._2)
            2 => -float_sin_kernel(reduced._1, reduced._2, true)
            _ => -float_cos_kernel(reduced._1, reduced._2)
    ## The cosine of this angle in radians.
    ## See [std-num.float-math.cos](../../spec/std/num.md#r-std-num.float-math.cos).
    pub fn cos(self) -> f64:
        word := high_word(self) & 0x7fffffff
        if word < 0x3e400000:
            return 1.0
        if !self.is_finite():
            return self - self
        if word <= 0x3fe921fb:
            return float_cos_kernel(self, 0.0)
        reduced := float_reduce_half_pi(self)
        match reduced._0 & 3:
            0 => float_cos_kernel(reduced._1, reduced._2)
            1 => -float_sin_kernel(reduced._1, reduced._2, true)
            2 => -float_cos_kernel(reduced._1, reduced._2)
            _ => float_sin_kernel(reduced._1, reduced._2, true)
    ## The tangent of this angle in radians.
    ## See [std-num.float-math.tan](../../spec/std/num.md#r-std-num.float-math.tan).
    pub fn tan(self) -> f64:
        word := high_word(self) & 0x7fffffff
        if word < 0x3e400000:
            return self
        if !self.is_finite():
            return self - self
        if word <= 0x3fe921fb:
            return float_tan_kernel(self, 0.0, false)
        reduced := float_reduce_half_pi(self)
        float_tan_kernel(reduced._1, reduced._2, (reduced._0 & 1) != 0)

impl f32:
    ## The sine of this angle in radians.
    ## See [std-num.float-math.sin](../../spec/std/num.md#r-std-num.float-math.sin).
    pub fn sin(self) -> f32:
        f32(f64(self).sin())
    ## The cosine of this angle in radians.
    ## See [std-num.float-math.cos](../../spec/std/num.md#r-std-num.float-math.cos).
    pub fn cos(self) -> f32:
        f32(f64(self).cos())
    ## The tangent of this angle in radians.
    ## See [std-num.float-math.tan](../../spec/std/num.md#r-std-num.float-math.tan).
    pub fn tan(self) -> f32:
        f32(f64(self).tan())
