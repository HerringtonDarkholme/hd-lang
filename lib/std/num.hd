# musl exp.c `specialcase` (Arm): scale * (1 + tmp) without an
# intermediate overflow or a double rounding in the subnormal range.
# `sbits` may have its exponent overflowed into the sign bit.
fn libm_exp_special(tmp: f64, sbits: u64, ki: u64) -> f64:
    if (ki & 0x80000000) == 0:
        # k > 0: the exponent of scale might have overflowed by <= 460.
        scale := f64_from(sbits.wrapping_sub(0x3f10000000000000))
        return 5.486124068793689e+303 * (scale + scale * tmp)
    # k < 0: round y to the right precision before scaling it into the
    # subnormal range.
    scale := f64_from(sbits.wrapping_add(0x3fe0000000000000))
    let y = scale + scale * tmp
    if y < 1.0:
        let lo = scale - y + scale * tmp
        hi := 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
        if y == 0.0:
            y = 0.0
    2.2250738585072014e-308 * y

# musl exp.c (Arm): exp(x) = 2^(k/128) * exp(r), with the table above and a
# degree-5 polynomial. Cost: one table pair and 10 floating operations.
fn libm_exp(x: f64) -> f64:
    let abstop = libm_top12(x) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x3f:
        if abstop.wrapping_sub(0x3c9) >= 0x80000000:
            # |x| < 2^-54: avoid a spurious underflow; 0 is a common input.
            return 1.0 + x
        if abstop >= 0x409:
            if f64_bits(x) == 0xfff0000000000000:
                return 0.0
            if abstop >= 0x7ff:
                return 1.0 + x
            return if (f64_bits(x) >> 63) != 0: 0.0 else: 1.0 / 0.0
        # Large x is special cased below.
        abstop = 0
    # x = ln2/128*k + r, with int k and r in [-ln2/256, ln2/256].
    z := 184.6649652337873 * x
    shifted := z + 6755399441055744.0
    ki := f64_bits(shifted)
    kd := shifted - 6755399441055744.0
    r := x + kd * -0.005415212348111709 + kd * -1.2864023111638346e-14
    idx := usize(2 * (ki & 127))
    top := ki << 45
    table := libm_exp_table()
    tail := libm_float(table, idx)
    sbits := libm_word(table, idx + 1).wrapping_add(top)
    r2 := r * r
    tmp := (
        tail
        + r
        + r2 * (0.49999999999996786 + r * 0.16666666666665886)
        + r2 * r2 * (0.0416666808410674 + r * 0.008333335853059549)
    )
    if abstop == 0:
        return libm_exp_special(tmp, sbits, ki)
    scale := f64_from(sbits)
    scale + scale * tmp

# musl exp2.c `specialcase` (Arm).
fn libm_exp2_special(tmp: f64, sbits: u64, ki: u64) -> f64:
    if (ki & 0x80000000) == 0:
        # k > 0: the exponent of scale might have overflowed by 1.
        scale := f64_from(sbits.wrapping_sub(0x0010000000000000))
        return 2.0 * (scale + scale * tmp)
    scale := f64_from(sbits.wrapping_add(0x3fe0000000000000))
    let y = scale + scale * tmp
    if y < 1.0:
        let lo = scale - y + scale * tmp
        hi := 1.0 + y
        lo = 1.0 - hi + y + lo
        y = (hi + lo) - 1.0
        if y == 0.0:
            y = 0.0
    2.2250738585072014e-308 * y

# musl exp2.c (Arm): 2^x = 2^(k/128) * 2^r with exp's table.
fn libm_exp2(x: f64) -> f64:
    let abstop = libm_top12(x) & 0x7ff
    if abstop.wrapping_sub(0x3c9) >= 0x3f:
        if abstop.wrapping_sub(0x3c9) >= 0x80000000:
            return 1.0 + x
        if abstop >= 0x409:
            if f64_bits(x) == 0xfff0000000000000:
                return 0.0
            if abstop >= 0x7ff:
                return 1.0 + x
            if (f64_bits(x) >> 63) == 0:
                return 1.0 / 0.0
            else if f64_bits(x) >= 0xc090cc0000000000:
                return 0.0
        if f64_bits(x) << 1 > 0x811a000000000000:
            # Large x is special cased below.
            abstop = 0
    # x = k/128 + r, with int k and r in [-1/256, 1/256].
    shifted := x + 52776558133248.0
    ki := f64_bits(shifted)
    kd := shifted - 52776558133248.0
    r := x - kd
    idx := usize(2 * (ki & 127))
    top := ki << 45
    table := libm_exp_table()
    tail := libm_float(table, idx)
    sbits := libm_word(table, idx + 1).wrapping_add(top)
    r2 := r * r
    tmp := (
        tail
        + r * 0.6931471805599453
        + r2 * (0.24022650695909065 + r * 0.0555041086686087)
        + r2 * r2 * (0.009618131975721055 + r * 0.0013332074570119598)
    )
    if abstop == 0:
        return libm_exp2_special(tmp, sbits, ki)
    scale := f64_from(sbits)
    scale + scale * tmp

# The tables of the f64 `**` path as code. The backend roots `float_pow_f64`
# in every program (crates/hd_wasm FLOAT_FNS), and static data a rooted
# function allocates keeps its address range after the function is
# dropped, so a string table there would change the Wasm of programs that
# never use a power. A `match` is code, which is dropped whole. Its compare
# chain costs pow about 17 ns a call over the string tables (#2407).
# musl exp_data.c (Arm): entry k is (bits of T[k], bits of H[k] less
# `k << 45`), as `libm_exp_table` holds them.
fn libm_exp_entry(k: u64) -> (u64, u64):
    match k:
        0 => (0x0000000000000000, 0x3ff0000000000000)
        1 => (0x3c9b3b4f1a88bf6e, 0x3feff63da9fb3335)
        2 => (0xbc7160139cd8dc5d, 0x3fefec9a3e778061)
        3 => (0xbc905e7a108766d1, 0x3fefe315e86e7f85)
        4 => (0x3c8cd2523567f613, 0x3fefd9b0d3158574)
        5 => (0xbc8bce8023f98efa, 0x3fefd06b29ddf6de)
        6 => (0x3c60f74e61e6c861, 0x3fefc74518759bc8)
        7 => (0x3c90a3e45b33d399, 0x3fefbe3ecac6f383)
        8 => (0x3c979aa65d837b6d, 0x3fefb5586cf9890f)
        9 => (0x3c8eb51a92fdeffc, 0x3fefac922b7247f7)
        10 => (0x3c3ebe3d702f9cd1, 0x3fefa3ec32d3d1a2)
