# A double has more than twice a float's precision, so x*y + z in double
# is exact but for one rounding, except in a halfway case.
fn libm_fmaf(x: f32, y: f32, z: f32) -> f32:
    xy := f64(x) * f64(y)
    zd := f64(z)
    result := xy + zd
    let bits = f64_bits(result)
    e := (bits >> 52) & 0x7ff
    # The common case: not a halfway case, NaN, or exact.
    if (bits & 0x1fffffff) != 0x10000000 || e == 0x7ff || (result - xy == zd && result - zd == xy):
        return f32(result)
    # Inexact and exactly halfway between two floats: move the low bit
    # toward the error.
    negative := (bits >> 63) != 0
    err := if negative == (zd > xy): xy - result + zd else: zd - result + xy
    if negative == (err < 0.0):
        bits += 1
    else:
        bits -= 1
    f32(f64_from(bits))

# musl __rem_pio2_large.c (Sun): Payne-Hanek reduction of a huge
# argument, given as up to three 24-bit digits `x` scaled by 2^e0, by the
# window of 2/pi that the low three quotient bits and the remainder need.
# `prec` 0 (f32) sums the result into `y0`; 1 (f64) also gives the tail
# `y1`. A recomputation widens the window; it never recurses, and the
# 66-limb table bounds it: the arrays hold at most 20 terms, as musl's do.
fn libm_rem_pio2_large(x: (f64, f64, f64), nx: i32, e0: i32, prec: i32) -> (i32, f64, f64):
    jk := if prec == 0: +3 else: +4
    jp := jk
    # Determine jx, jv and q0; note that 3 > q0.
    jx := nx - 1
    let jv = (e0 - 3) / 24
    if jv < 0:
        jv = 0
    let q0 = e0 - 24 * (jv + 1)
    let mut f = FloatReductionWords::new()
    let mut q = FloatReductionWords::new()
    let mut fq = FloatReductionWords::new()
    let mut iq = FloatReductionWords::new()
    # Set up f[0] to f[jx+jk], where f[jx+jk] = ipio2[jv+jk].
    let j = jv - jx
    let i: i32 = 0
    while i <= jx + jk:
        f.set(i, if j < 0: 0.0 else: float_two_over_pi(j))
        i += 1
        j += 1
    # Compute q[0], q[1], ... q[jk].
    i = 0
    while i <= jk:
        let sum = 0.0
        j = 0
        while j <= jx:
            sum += float_reduction_digit(x, j) * f.get(jx + i - j)
            j += 1
        q.set(i, sum)
        i += 1
    let jz = jk
    let n: i32 = 0
    let z = 0.0
    let ih: i32 = 0
    while true:
        # Distill q[] into iq[] in reverse.
        i = 0
        j = jz
        z = q.get(jz)
        while j > 0:
            high := (5.960464477539063e-08 * z).trunc()
            iq.set(i, (z - 16777216.0 * high).trunc())
            z = q.get(j - 1) + high
            i += 1
            j -= 1
        # Compute n.
        z = libm_scalbn(z, q0)
        # Trim off the integer part >= 8.
        z -= 8.0 * (z * 0.125).floor()
        n = i32(z)
        z -= f64(n)
        ih = 0
        if q0 > 0:
            # iq[jz-1] is needed to determine n.
            top := i32(iq.get(jz - 1))
            extra := top >> u32(24 - q0)
            n += extra
            iq.set(jz - 1, f64(top - (extra << u32(24 - q0))))
            ih = i32(iq.get(jz - 1)) >> u32(23 - q0)
        else if q0 == 0:
            ih = i32(iq.get(jz - 1)) >> 23
        else if z >= 0.5:
            ih = 2
        if ih > 0:
            # q > 0.5: compute 1 - q.
            n += 1
            let carry: i32 = 0
            i = 0
            while i < jz:
                digit := i32(iq.get(i))
                if carry == 0:
                    if digit != 0:
                        carry = 1
                        iq.set(i, f64(0x1000000 - digit))
                else:
                    iq.set(i, f64(0xffffff - digit))
                i += 1
            if q0 > 0:
                # A rare case: a chance of 1 in 12.
                if q0 == 1:
                    iq.set(jz - 1, f64(i32(iq.get(jz - 1)) & 0x7fffff))
                else if q0 == 2:
                    iq.set(jz - 1, f64(i32(iq.get(jz - 1)) & 0x3fffff))
            if ih == 2:
                z = 1.0 - z
                if carry != 0:
                    z -= libm_scalbn(1.0, q0)
        # Check whether recomputation is needed.
        if z == 0.0:
            let any: i32 = 0
            i = jz - 1
            while i >= jk:
                any = any | i32(iq.get(i))
                i -= 1
            if any == 0:
                # k is the number of terms needed.
                let k: i32 = 1
                while iq.get(jk - k) == 0.0:
                    k += 1
                # Add q[jz+1] to q[jz+k].
                i = jz + 1
                while i <= jz + k:
                    f.set(jx + i, float_two_over_pi(jv + i))
                    let sum = 0.0
                    j = 0
                    while j <= jx:
                        sum += float_reduction_digit(x, j) * f.get(jx + i - j)
                        j += 1
                    q.set(i, sum)
                    i += 1
                jz += k
                continue
        break
    # Chop off zero terms.
    if z == 0.0:
        jz -= 1
        q0 -= 24
        while iq.get(jz) == 0.0:
            jz -= 1
            q0 -= 24
    else:
        # Break z into 24-bit digits if necessary.
        z = libm_scalbn(z, -q0)
        if z >= 16777216.0:
            high := (5.960464477539063e-08 * z).trunc()
            iq.set(jz, (z - 16777216.0 * high).trunc())
            jz += 1
            q0 += 24
            iq.set(jz, high)
        else:
            iq.set(jz, z.trunc())
    # Convert the integer chunks to floating point.
    let fw = libm_scalbn(1.0, q0)
    i = jz
    while i >= 0:
        q.set(i, fw * iq.get(i))
        fw *= 5.960464477539063e-08
        i -= 1
    # Compute PIo2[0, ..., jp] * q[jz, ..., 0].
    i = jz
    while i >= 0:
        fw = 0.0
        let k: i32 = 0
        while k <= jp && k <= jz - i:
            fw += float_half_pi_digit(k) * q.get(i + k)
            k += 1
        fq.set(jz - i, fw)
        i -= 1
    # Compress fq[] into y[].
    fw = 0.0
    i = jz
    while i >= 0:
        fw += fq.get(i)
        i -= 1
    y0 := if ih == 0: fw else: -fw
    if prec == 0:
        return (n & 7, y0, 0.0)
    fw = fq.get(0) - fw
    i = 1
    while i <= jz:
        fw += fq.get(i)
        i += 1
    (n & 7, y0, if ih == 0: fw else: -fw)

# musl __rem_pio2.c (Sun): x - n*pi/2 as (n, y0, y1), with y0 + y1 in
# [-pi/4, pi/4]. The caller handles |x| ~<= pi/4.
fn libm_rem_pio2(x: f64) -> (i32, f64, f64):
    bits := f64_bits(x)
    sign := (bits >> 63) != 0
    ix := u32(bits >> 32) & 0x7fffffff
    if ix <= 0x400f6a7a:
        # |x| ~<= 5pi/4. Near pi/2 or 2pi/2 cancellation needs the medium case.
        if (ix & 0xfffff) != 0x921fb:
            return libm_rem_pio2_small(x, sign, if ix <= 0x4002d97c: +1 else: +2)
    else if ix <= 0x401c463b:
        # |x| ~<= 9pi/4. Near 3pi/2 or 4pi/2 cancellation needs the medium case.
        if ix <= 0x4015fdbc:
            if ix != 0x4012d97c:
                return libm_rem_pio2_small(x, sign, +3)
        else if ix != 0x401921fb:
            return libm_rem_pio2_small(x, sign, +4)
    if ix < 0x413921fb:
        # |x| ~< 2^20*(pi/2), medium size: rint(x/(pi/2)).
        let fnv = x * 6.36619772367581382433e-01 + 6755399441055744.0 - 6755399441055744.0
        let n = i32(fnv)
        let r = x - fnv * 1.57079632673412561417e+00
        # The first round, good to 85 bits.
        let w = fnv * 6.07710050650619224932e-11
        if r - w < -0.7853981633974483:
            n -= 1
            fnv -= 1.0
            r = x - fnv * 1.57079632673412561417e+00
            w = fnv * 6.07710050650619224932e-11
        else if r - w > 0.7853981633974483:
            n += 1
            fnv += 1.0
            r = x - fnv * 1.57079632673412561417e+00
            w = fnv * 6.07710050650619224932e-11
        let y0 = r - w
        ex := i32(ix >> 20)
        if ex - i32((f64_bits(y0) >> 52) & 0x7ff) > 16:
            # The second round, good to 118 bits.
            t := r
            w = fnv * 6.07710050630396597660e-11
            r = t - w
            w = fnv * 2.02226624879595063154e-21 - ((t - r) - w)
            y0 = r - w
            if ex - i32((f64_bits(y0) >> 52) & 0x7ff) > 49:
                # The third round, good to 151 bits, covers all cases.
                t2 := r
                w = fnv * 2.02226624871116645580e-21
                r = t2 - w
                w = fnv * 8.47842766036889956997e-32 - ((t2 - r) - w)
                y0 = r - w
        return (n, y0, (r - y0) - w)
    # All other, large arguments.
    if ix >= 0x7ff00000:
        # x is inf or NaN.
        return (0, x - x, x - x)
    # z = scalbn(|x|, -ilogb(x) + 23), split into three 24-bit digits.
    let z = f64_from((bits & 0x000fffffffffffff) | 0x4160000000000000)
    first := f64(i32(z))
    z = (z - first) * 16777216.0
    second := f64(i32(z))
    third := (z - second) * 16777216.0
    # Skip zero terms; the first term is nonzero.
    count := if third != 0.0: +3 else: (if second != 0.0: +2 else: +1)
    let (n, y0, y1) = libm_rem_pio2_large(
        (first, second, third),
        count,
        i32(ix >> 20) - (0x3ff + 23),
        1,
    )
    if sign: (-n, -y0, -y1) else: (n, y0, y1)

# musl __rem_pio2.c's cases for |x| ~<= 9pi/4: x - k*pi/2 with pi/2 in two
# parts, the first exact in k*pio2_1.
fn libm_rem_pio2_small(x: f64, negative: bool, k: i32) -> (i32, f64, f64):
    multiple := f64(k)
    if !negative:
        # One round, good to 85 bits.
        z := x - multiple * 1.57079632673412561417e+00
        y0 := z - multiple * 6.07710050650619224932e-11
        return (k, y0, (z - y0) - multiple * 6.07710050650619224932e-11)
    z := x + multiple * 1.57079632673412561417e+00
    y0 := z + multiple * 6.07710050650619224932e-11
    (-k, y0, (z - y0) + multiple * 6.07710050650619224932e-11)

# musl __sin.c (Sun): sin(x + y) on [-pi/4, pi/4], y the tail of x;
# `tail` false means y is 0.
fn libm_sin_kernel(x: f64, y: f64, tail: bool) -> f64:
    z := x * x
    w := z * z
    r := (
        8.33333333332248946124e-03
        + z * (-1.98412698298579493134e-04 + z * 2.75573137070700676789e-06)
        + z * w * (-2.50507602534068634195e-08 + z * 1.58969099521155010221e-10)
    )
    v := z * x
    if !tail:
        return x + v * (-1.66666666666666324348e-01 + z * r)
    x - ((z * (0.5 * y - v * r) - y) - v * -1.66666666666666324348e-01)

# musl __cos.c (Sun): cos(x + y) on [-pi/4, pi/4].
fn libm_cos_kernel(x: f64, y: f64) -> f64:
    z := x * x
    let w = z * z
    r := (
        z * (
            4.16666666666666019037e-02
            + z * (-1.38888888888741095749e-03 + z * 2.48015872894767294178e-05)
        )
        + w * w * (
            -2.75573143513906633035e-07
            + z * (2.08757232129817482790e-09 + z * -1.13596475577881948265e-11)
        )
    )
    hz := 0.5 * z
    w = 1.0 - hz
    w + (((1.0 - w) - hz) + (z * r - x * y))

# musl __tan.c (Sun): tan(x + y) on [-pi/4, pi/4], or -1/tan when `odd`.
fn libm_tan_kernel(value: f64, tail: f64, odd: bool) -> f64:
    let x = value
    let y = tail
    hx := u32(f64_bits(x) >> 32)
    # |x| >= 0.6744.
    big := (hx & 0x7fffffff) >= 0x3fe59428
    sign := (hx >> 31) != 0
    if big:
        if sign:
            x = -x
            y = -y
        x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y)
        y = 0.0
    z := x * x
    let w = z * z
    # x^5 (T[1] + x^4 T[3] + ...) + x^5 (x^2 (T[2] + x^4 T[4] + ...)).
    let r = (
        1.33333333333201242699e-01
        + w * (
            2.18694882948595424599e-02
            + w * (
                3.59207910759131235356e-03
                + w * (
                    5.88041240820264096874e-04
                    + w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05)
                )
            )
        )
    )
    let v = (
        z
        * (
            5.39682539762260521377e-02
            + w * (
                8.86323982359930005737e-03
                + w * (
                    1.45620945432529025516e-03
                    + w * (
                        2.46463134818469906812e-04
                        + w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)
                    )
                )
            )
        )
    )
    let s = z * x
    r = y + z * (s * (r + v) + y) + s * 3.33333333333334091986e-01
    w = x + r
    if big:
        s = if odd: -1.0 else: 1.0
        v = s - 2.0 * (x + (r - w * w / (w + s)))
        return if sign: -v else: v
    if !odd:
        return w
    # -1.0/(x+r) has up to 2 ulp error, so compute it accurately.
    w0 := f64_from(f64_bits(w) & 0xffffffff00000000)
    # w0 + v = r + x.
    v = r - (w0 - x)
    a := -1.0 / w
    a0 := f64_from(f64_bits(a) & 0xffffffff00000000)
    a0 + a * (1.0 + a0 * w0 + a0 * v)

# musl sin.c (Sun).
fn libm_sin(x: f64) -> f64:
    ix := u32(f64_bits(x) >> 32) & 0x7fffffff
    # |x| ~< pi/4.
    if ix <= 0x3fe921fb:
        if ix < 0x3e500000:
            # |x| < 2^-26.
            return x
        return libm_sin_kernel(x, 0.0, false)
    # sin(Inf or NaN) is NaN.
    if ix >= 0x7ff00000:
        return x - x
    let (n, y0, y1) = libm_rem_pio2(x)
    match n & 3:
        0 => libm_sin_kernel(y0, y1, true)
        1 => libm_cos_kernel(y0, y1)
        2 => -libm_sin_kernel(y0, y1, true)
        _ => -libm_cos_kernel(y0, y1)

# musl cos.c (Sun).
fn libm_cos(x: f64) -> f64:
    ix := u32(f64_bits(x) >> 32) & 0x7fffffff
    # |x| ~< pi/4.
    if ix <= 0x3fe921fb:
        if ix < 0x3e46a09e:
            # |x| < 2^-27 * sqrt(2).
            return 1.0
        return libm_cos_kernel(x, 0.0)
    # cos(Inf or NaN) is NaN.
    if ix >= 0x7ff00000:
        return x - x
    let (n, y0, y1) = libm_rem_pio2(x)
    match n & 3:
        0 => libm_cos_kernel(y0, y1)
        1 => -libm_sin_kernel(y0, y1, true)
        2 => -libm_cos_kernel(y0, y1)
        _ => libm_sin_kernel(y0, y1, true)

# musl tan.c (Sun).
fn libm_tan(x: f64) -> f64:
    ix := u32(f64_bits(x) >> 32) & 0x7fffffff
    # |x| ~< pi/4.
    if ix <= 0x3fe921fb:
        if ix < 0x3e400000:
            # |x| < 2^-27.
            return x
        return libm_tan_kernel(x, 0.0, false)
    # tan(Inf or NaN) is NaN.
    if ix >= 0x7ff00000:
        return x - x
    let (n, y0, y1) = libm_rem_pio2(x)
    libm_tan_kernel(y0, y1, (n & 1) != 0)

# musl __rem_pio2f.c (Sun): x - n*pi/2 in double, with 25+53 bits of
# pi/2 for medium arguments and __rem_pio2_large for huge ones.
fn libm_rem_pio2f(x: f32) -> (i32, f64):
    bits := f32_bits(x)
    ix := bits & 0x7fffffff
    xd := f64(x)
    if ix < 0x4dc90fdb:
        # |x| ~< 2^28*(pi/2), medium size.
        let fnv = xd * 6.36619772367581382433e-01 + 6755399441055744.0 - 6755399441055744.0
        let n = i32(fnv)
        let y = xd - fnv * 1.57079631090164184570e+00 - fnv * 1.58932547735281966916e-08
        if y < -0.7853981852531433:
            n -= 1
            fnv -= 1.0
            y = xd - fnv * 1.57079631090164184570e+00 - fnv * 1.58932547735281966916e-08
        else if y > 0.7853981852531433:
            n += 1
            fnv += 1.0
            y = xd - fnv * 1.57079631090164184570e+00 - fnv * 1.58932547735281966916e-08
        return (n, y)
    if ix >= 0x7f800000:
        # x is inf or NaN.
        return (0, f64(x - x))
    # Scale x into [2^23, 2^24 - 1].
