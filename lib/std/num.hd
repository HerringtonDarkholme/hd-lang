# std.num: the numeric traits, integer arithmetic variants, and parsing.
# Overflow is checked by default; the arithmetic methods make the other
# behaviors explicit. They are declared for every integer width.
use std.ops.{Add, BitAnd, BitOr, BitXor, Div, Mul, Neg, Not, Rem, Shl, Shr, Sub}
use std.annotation.inline
use std.cmp.Ordering
use std.text.Parse
use std.rt.bytes.{string_from_bytes, panic_with}

# The numeric traits (spec/lang/09-traits.md#numeric-traits). They are sealed:
# only these implementations exist, one per primitive number type
# (r-trait.num.sealed). `from_i64` is checked (r-trait.num.from-i64-checked):
# a value the integer type cannot hold panics with integer overflow.
## The trait every built-in number type implements: ordered, displayable, and closed under `+`, `-`, `*`, `/`, and `%`.
## See [trait.num.num-ordered](../../spec/lang/09-traits.md#r-trait.num.num-ordered).
pub trait Num < AnyVal & PartialOrd & Display & Add[Out = Self] & Sub[Out = Self] & Mul[
    Out = Self,
] & Div[Out = Self] & Rem[Out = Self]:
    fn zero() -> Self
    fn one() -> Self
    fn from_i64(n: i64) -> Self

## The trait every built-in integer type implements: `Num` plus a total order, the bitwise operators, and the shifts.
## See [trait.num.integer](../../spec/lang/09-traits.md#r-trait.num.integer).
## `to_u64` and `from_u64` convert to and from `u64`, panicking with `integer-overflow` when the value does not fit.
## See [trait.num.integer-u64](../../spec/std/num.md#r-std-num.u64.members).
pub trait Integer < Num & Ord & BitAnd[Out = Self] & BitOr[Out = Self] & BitXor[Out = Self] & Not[
    Out = Self,
] & Shl[u32, Out = Self] & Shr[u32, Out = Self]:
    fn to_u64(self) -> u64
    fn from_u64(n: u64) -> Self

## The trait the built-in floating-point types implement: `Num` plus negation.
## See [trait.num.float](../../spec/lang/09-traits.md#r-trait.num.float).
pub trait Float < Num & PartialOrd & Neg[Out = Self]

impl Num for i8:
    fn zero() -> i8:
        0
    fn one() -> i8:
        1
    fn from_i64(n: i64) -> i8:
        i8(fit(n, -128, 127))

impl Num for i16:
    fn zero() -> i16:
        0
    fn one() -> i16:
        1
    fn from_i64(n: i64) -> i16:
        i16(fit(n, -32768, 32767))

impl Num for i32:
    fn zero() -> i32:
        0
    fn one() -> i32:
        1
    fn from_i64(n: i64) -> i32:
        i32(fit(n, -2147483648, 2147483647))

impl Num for i64:
    fn zero() -> i64:
        0
    fn one() -> i64:
        1
    fn from_i64(n: i64) -> i64:
        n

impl Num for u8:
    fn zero() -> u8:
        0
    fn one() -> u8:
        1
    fn from_i64(n: i64) -> u8:
        u8(fit(n, 0, 255))

impl Num for u16:
    fn zero() -> u16:
        0
    fn one() -> u16:
        1
    fn from_i64(n: i64) -> u16:
        u16(fit(n, 0, 65535))

impl Num for u32:
    fn zero() -> u32:
        0
    fn one() -> u32:
        1
    fn from_i64(n: i64) -> u32:
        u32(fit(n, 0, 4294967295))

impl Num for usize:
    fn zero() -> usize:
        0
    fn one() -> usize:
        1
    fn from_i64(n: i64) -> usize:
        usize(fit(n, 0, 4294967295))

impl Num for u64:
    fn zero() -> u64:
        0
    fn one() -> u64:
        1
    fn from_i64(n: i64) -> u64:
        u64(fit(n, 0, i64_max()))

impl Num for f32:
    fn zero() -> f32:
        0.0
    fn one() -> f32:
        1.0
    fn from_i64(n: i64) -> f32:
        f32(n)

impl Num for f64:
    fn zero() -> f64:
        0.0
    fn one() -> f64:
        1.0
    fn from_i64(n: i64) -> f64:
        f64(n)

impl Integer for i8:
    fn to_u64(self) -> u64:
        nonneg_u64(i64(self))
    fn from_u64(n: u64) -> i8:
        i8(fit_u64(n, 127))

impl Integer for i16:
    fn to_u64(self) -> u64:
        nonneg_u64(i64(self))
    fn from_u64(n: u64) -> i16:
        i16(fit_u64(n, 32767))

impl Integer for i32:
    fn to_u64(self) -> u64:
        nonneg_u64(i64(self))
    fn from_u64(n: u64) -> i32:
        i32(fit_u64(n, 2147483647))

impl Integer for i64:
    fn to_u64(self) -> u64:
        nonneg_u64(i64(self))
    fn from_u64(n: u64) -> i64:
        i64(fit_u64(n, 9223372036854775807))

impl Integer for u8:
    fn to_u64(self) -> u64:
        u64(self)
    fn from_u64(n: u64) -> u8:
        u8(fit_u64(n, 255))

impl Integer for u16:
    fn to_u64(self) -> u64:
        u64(self)
    fn from_u64(n: u64) -> u16:
        u16(fit_u64(n, 65535))

impl Integer for u32:
    fn to_u64(self) -> u64:
        u64(self)
    fn from_u64(n: u64) -> u32:
        u32(fit_u64(n, 4294967295))

impl Integer for usize:
    fn to_u64(self) -> u64:
        u64(self)
    fn from_u64(n: u64) -> usize:
        usize(fit_u64(n, 4294967295))

impl Integer for u64:
    fn to_u64(self) -> u64:
        self
    fn from_u64(n: u64) -> u64:
        n

impl Float for f32

impl Float for f64

## Why number parsing failed: `Empty`, `InvalidDigit(position)`, or `OutOfRange`.
## See [std-num.parse.error-import](../../spec/std/num.md#r-std-num.parse.error-import).
@derive(Debug, Eq)
@error
pub enum ParseNumberError:
    @error("cannot parse a number from empty text")
    Empty
    @error("invalid digit at position $position")
    InvalidDigit(position: usize)
    @error("number out of range for its type")
    OutOfRange

# The integer methods (spec/std/num.md), written once for every integer
# width by r-trait.target.numeric-family. Generic code has no literals or
# casts, so the bounds come from `int_min` and `int_max`. Other std code
# does not call them: in the prototype, each concrete type a std function
# calls them with adds dictionary wrappers to every program.
impl[N < Integer] N:
    ## The sum, or `.None` when it is out of the type's range.
    ## See [std-num.checked.add](../../spec/std/num.md#r-std-num.checked.add).
    pub fn checked_add(self, other: N) -> N?:
        zero := N::zero()
        if other > zero && self > int_max::[N]() - other:
            return .None
        if other < zero && self < int_min::[N]() - other:
            return .None
        .Some(self + other)

    ## The difference, or `.None` when it is out of the type's range.
    ## See [std-num.checked.sub](../../spec/std/num.md#r-std-num.checked.sub).
    pub fn checked_sub(self, other: N) -> N?:
        zero := N::zero()
        if other > zero && self < int_min::[N]() + other:
            return .None
        if other < zero && self > int_max::[N]() + other:
            return .None
        .Some(self - other)

    ## The product, or `.None` when it is out of the type's range.
    ## See [std-num.checked.mul](../../spec/std/num.md#r-std-num.checked.mul).
    pub fn checked_mul(self, other: N) -> N?:
        zero := N::zero()
        if self == zero || other == zero:
            return .Some(zero)
        lowest := int_min::[N]()
        highest := int_max::[N]()
        let overflows = false
        if self > zero:
            overflows = if other > zero: self > highest / other else: other < lowest / self
        else:
            overflows = if other > zero: self < lowest / other else: other < highest / self
        if overflows: .None else: .Some(self * other)

    ## The quotient, or `.None` for a zero divisor or the one overflowing case.
    ## See [std-num.checked.div](../../spec/std/num.md#r-std-num.checked.div).
    pub fn checked_div(self, other: N) -> N?:
        zero := N::zero()
        if other == zero:
            return .None
        # `~zero` is -1 in a signed type, and the minimum over -1 overflows.
        minus_one := ~zero
        if minus_one < zero && other == minus_one && self == int_min::[N]():
            return .None
        .Some(self / other)

    ## The sum, wrapping around the type's range.
    ## See [std-num.wrapping.add](../../spec/std/num.md#r-std-num.wrapping.add).
    @intrinsic("int_wrapping_add")
    pub fn wrapping_add(self, other: N) -> N:
        panic("intrinsic")

    ## The difference, wrapping around the type's range.
    ## See [std-num.wrapping.sub](../../spec/std/num.md#r-std-num.wrapping.sub).
    @intrinsic("int_wrapping_sub")
    pub fn wrapping_sub(self, other: N) -> N:
        panic("intrinsic")

    ## The product, wrapping around the type's range.
    ## See [std-num.wrapping.mul](../../spec/std/num.md#r-std-num.wrapping.mul).
    @intrinsic("int_wrapping_mul")
    pub fn wrapping_mul(self, other: N) -> N:
        panic("intrinsic")

    ## The sum, capped at the type's largest or smallest value.
    ## See [std-num.saturating.add](../../spec/std/num.md#r-std-num.saturating.add).
    pub fn saturating_add(self, other: N) -> N:
        match self.checked_add(other):
            .Some(sum) => sum
            .None =>
                if other > N::zero(): int_max::[N]() else: int_min::[N]()

    ## The difference, capped at the type's largest or smallest value.
    ## See [std-num.saturating.sub](../../spec/std/num.md#r-std-num.saturating.sub).
    pub fn saturating_sub(self, other: N) -> N:
        match self.checked_sub(other):
            .Some(difference) => difference
            .None =>
                if other > N::zero(): int_min::[N]() else: int_max::[N]()

    ## The number of one bits in the value.
    ## See [std-num.bits.count-ones-u32](../../spec/std/num.md#r-std-num.bits.count-ones-u32).
    @intrinsic("int_count_ones")
    pub fn count_ones(self) -> u32:
        panic("intrinsic")

    ## The number of zero bits before the value's first one bit.
    ## See [std-num.bits.leading-zeros-u32](../../spec/std/num.md#r-std-num.bits.leading-zeros-u32).
    @intrinsic("int_leading_zeros")
    pub fn leading_zeros(self) -> u32:
        panic("intrinsic")

    ## The number of zero bits after the value's last one bit, or its width for zero.
    ## See [std-num.bits.trailing-zeros-u32](../../spec/std/num.md#r-std-num.bits.trailing-zeros-u32).
    @intrinsic("int_trailing_zeros")
    pub fn trailing_zeros(self) -> u32:
        panic("intrinsic")

# Rotation moves the bits of the fixed-width form around the ends
# (r-std-num.rotate.left). The count is taken modulo the bit width, and the
# bits that leave one end are the low or high bits of the logical shift of
# the other, so a signed `>>` copying the sign bit is masked off.
impl[N < Integer] N:
    ## The bits rotated `count` places toward the most significant bit.
    ## See [std-num.rotate.left](../../spec/std/num.md#r-std-num.rotate.left).
    pub fn rotate_left(self, count: u32) -> N:
        zero := N::zero()
        width := zero.leading_zeros()
        shift := count % width
        if shift == 0:
            return self
        # The low `shift` bits, set; they receive the bits shifted out on the left.
        low_mask := ~((~zero) << shift)
        (self << shift) | ((self >> (width - shift)) & low_mask)

    ## The bits rotated `count` places toward the least significant bit.
    ## See [std-num.rotate.right](../../spec/std/num.md#r-std-num.rotate.right).
    pub fn rotate_right(self, count: u32) -> N:
        width := N::zero().leading_zeros()
        shift := count % width
        if shift == 0:
            return self
        self.rotate_left(width - shift)

# `pow` multiplies by squaring, so it uses `*` and overflows as `*` does:
# a panic in a debug or test build, wrapping in a release build. The base
# is squared only while exponent bits remain, so a squaring past the last
# needed one never overflows on its own (r-std-num.pow.overflow).
impl[N < Integer] N:
    ## The value raised to the power `exp`; `exp` of 0 gives 1.
    ## See [std-num.pow.value](../../spec/std/num.md#r-std-num.pow.value).
    pub fn pow(self, exp: u32) -> N:
        let result = N::one()
        let base = self
        let rest = exp
        while rest != 0:
            if rest & 1 == 1:
                result = result * base
            rest = rest >> 1
            if rest != 0:
                base = base * base
        result

# Radix text (r-std-num.radix.to-radix, r-std-num.radix.parse-radix).
# `to_radix` writes the digits of the remainders into one byte list, least
# significant first, and copies them out reversed into a second list: one
# string is built, never one per digit.
# A negative value takes the negative remainders `%` gives and negates each,
# so the minimum value needs no negation of the whole. Generic code has no
# casts, so `digit_byte` reads a remainder (0 to 35) bit by bit.
impl[N < Integer] N:
    ## The value's digits in `radix` (2 to 36), lowercase, with a leading `-` when negative.
    ## See [std-num.radix.to-radix](../../spec/std/num.md#r-std-num.radix.to-radix).
    pub fn to_radix(self, radix: u32) -> string:
        if radix < 2 || radix > 36:
            panic("to_radix: the radix must be 2 to 36")
        zero := N::zero()
        if self == zero:
            return "0"
        base := N::from_i64(i64(radix))
        negative := self < zero
        let rest = self
        let mut reversed: List[u8] = []
        while rest != zero:
            rem := rest % base
            reversed.push(digit_byte(if negative: zero - rem else: rem))
            rest = rest / base
        let mut out: List[u8] = []
        if negative:
            out.push(45)
        let index = reversed.len()
        while index > 0:
            index = index - 1
            out.push(reversed[index])
        string_from_bytes(out)

    ## Reads `text` as an integer in `radix` (2 to 36), or the first error.
    ## See [std-num.radix.parse-radix](../../spec/std/num.md#r-std-num.radix.parse-radix).
    pub fn parse_radix(text: string, radix: u32) -> Result[N, ParseNumberError]:
        if radix < 2 || radix > 36:
            panic("parse_radix: the radix must be 2 to 36")
        size := text.len()
        if size == 0:
            return .Err(ParseNumberError.Empty)
        zero := N::zero()
        # `~zero` is negative exactly in a signed type.
        signed := ~zero < zero
        negative := signed && text[0] == 45
        let index: usize = if negative || text[0] == 43: 1 else: 0
        if index == size:
            return .Err(ParseNumberError.InvalidDigit(index))
        base := N::from_i64(i64(radix))
        low := int_min::[N]()
        high := int_max::[N]()
        let value = zero
        while index < size:
            found := byte_digit(text[index])
            if found >= radix:
                return .Err(ParseNumberError.InvalidDigit(index))
            digit := N::from_i64(i64(found))
            # Division truncates toward zero, so each bound is exact and the
            # product never leaves the type's range.
            if negative:
                if value < (low + digit) / base:
                    return .Err(ParseNumberError.OutOfRange)
                value = value * base - digit
            else:
                if value > (high - digit) / base:
                    return .Err(ParseNumberError.OutOfRange)
                value = value * base + digit
            index = index + 1
        .Ok(value)

# The byte of a digit value, 0 to 35: `0` to `9`, then `a` to `z`.
fn digit_byte[N < Integer](digit: N) -> u8:
    zero := N::zero()
    one := N::one()
    let value: u8 = 0
    let bit: u32 = 0
    while bit < 6:
        if ((digit >> bit) & one) != zero:
            value = value + u8(1 << bit)
        bit = bit + 1
    if value < 10: 48 + value else: 87 + value

# The value of an ASCII digit or letter, either case, or 255 for any other byte.
fn byte_digit(byte: u8) -> u32:
    if byte >= 48 && byte <= 57:
        return u32(byte - 48)
    if byte >= 97 && byte <= 122:
        return u32(byte - 87)
    if byte >= 65 && byte <= 90:
        return u32(byte - 55)
    255

# `abs_diff` returns the unsigned type of the same width, a mapping that
# `Integer` cannot name, so each width declares it. A narrow signed
# difference is exact in `i64`, and the cast keeps the distance.
impl i8:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.i8](../../spec/std/num.md#r-std-num.abs-diff.i8).
    pub fn abs_diff(self, other: i8) -> u8:
        if self > other: u8(i64(self) - i64(other)) else: u8(i64(other) - i64(self))

impl i16:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.i16](../../spec/std/num.md#r-std-num.abs-diff.i16).
    pub fn abs_diff(self, other: i16) -> u16:
        if self > other: u16(i64(self) - i64(other)) else: u16(i64(other) - i64(self))

impl i32:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.i32](../../spec/std/num.md#r-std-num.abs-diff.i32).
    pub fn abs_diff(self, other: i32) -> u32:
        if self > other: u32(i64(self) - i64(other)) else: u32(i64(other) - i64(self))

# Operands of one sign subtract exactly. Otherwise the distance is
# `high + (-(low + 1)) + 1`, and each part fits in `u64`.
impl i64:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.i64](../../spec/std/num.md#r-std-num.abs-diff.i64).
    pub fn abs_diff(self, other: i64) -> u64:
        high := if self > other: self else: other
        low := if self > other: other else: self
        if low >= 0 || high < 0:
            return u64(high - low)
        u64(high) + u64(-(low + 1)) + 1

# `abs` is `-self` for a negative value, so the minimum overflows as `Neg` does.
impl i8:
    ## The absolute value; the minimum value overflows as `-self` does.
    ## See [std-num.abs.i8](../../spec/std/num.md#r-std-num.abs.i8).
    pub fn abs(self) -> i8:
        if self < 0: -self else: self

impl i16:
    ## The absolute value; the minimum value overflows as `-self` does.
    ## See [std-num.abs.i16](../../spec/std/num.md#r-std-num.abs.i16).
    pub fn abs(self) -> i16:
        if self < 0: -self else: self

impl i32:
    ## The absolute value; the minimum value overflows as `-self` does.
    ## See [std-num.abs.i32](../../spec/std/num.md#r-std-num.abs.i32).
    pub fn abs(self) -> i32:
        if self < 0: -self else: self

impl i64:
    ## The absolute value; the minimum value overflows as `-self` does.
    ## See [std-num.abs.i64](../../spec/std/num.md#r-std-num.abs.i64).
    pub fn abs(self) -> i64:
        if self < 0: -self else: self

impl u8:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.u8](../../spec/std/num.md#r-std-num.abs-diff.u8).
    pub fn abs_diff(self, other: u8) -> u8:
        if self > other: self - other else: other - self

impl u16:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.u16](../../spec/std/num.md#r-std-num.abs-diff.u16).
    pub fn abs_diff(self, other: u16) -> u16:
        if self > other: self - other else: other - self

impl u32:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.u32](../../spec/std/num.md#r-std-num.abs-diff.u32).
    pub fn abs_diff(self, other: u32) -> u32:
        if self > other: self - other else: other - self

impl usize:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.usize](../../spec/std/num.md#r-std-num.abs-diff.usize).
    pub fn abs_diff(self, other: usize) -> usize:
        if self > other: self - other else: other - self

impl u64:
    ## The absolute difference of the two values.
    ## See [std-num.abs-diff.u64](../../spec/std/num.md#r-std-num.abs-diff.u64).
    pub fn abs_diff(self, other: u64) -> u64:
        if self > other: self - other else: other - self

# `to_bits` and `from_bits` are Rust's: the IEEE 754 bit pattern, with the
# sign bit on top (r-std-num.float-bits.exact).
impl f64:
    ## The IEEE 754 bit pattern of the value.
    ## See [std-num.float-bits.to](../../spec/std/num.md#r-std-num.float-bits.to).
    pub fn to_bits(self) -> u64:
        f64_bits(self)

    ## The value whose IEEE 754 bit pattern is `bits`.
    ## See [std-num.float-bits.from](../../spec/std/num.md#r-std-num.float-bits.from).
    pub fn from_bits(bits: u64) -> f64:
        f64_from(bits)

impl f32:
    ## The IEEE 754 bit pattern of the value.
    ## See [std-num.float-bits.to](../../spec/std/num.md#r-std-num.float-bits.to).
    pub fn to_bits(self) -> u32:
        f32_bits(self)

    ## The value whose IEEE 754 bit pattern is `bits`.
    ## See [std-num.float-bits.from](../../spec/std/num.md#r-std-num.float-bits.from).
    pub fn from_bits(bits: u32) -> f32:
        f32_from(bits)

# `total_cmp` is the IEEE 754 totalOrder: a pattern with the sign bit set
# is flipped whole, so a more negative value gets a smaller key, and any
# other pattern gets the sign bit set, above every negative one. The keys
# then compare as unsigned integers (r-std-num.float-total-cmp.order).
impl f64:
    ## The IEEE 754 total order of two values, which orders NaNs and the zeros.
    ## See [std-num.float-total-cmp.order](../../spec/std/num.md#r-std-num.float-total-cmp.order).
    pub fn total_cmp(self, other: f64) -> Ordering:
        left := self.to_bits()
        right := other.to_bits()
        let sign: u64 = 9223372036854775808
        left_key := if left >= sign: ~left else: left | sign
        right_key := if right >= sign: ~right else: right | sign
        left_key.cmp(&right_key)

impl f32:
    ## The IEEE 754 total order of two values, which orders NaNs and the zeros.
    ## See [std-num.float-total-cmp.order](../../spec/std/num.md#r-std-num.float-total-cmp.order).
    pub fn total_cmp(self, other: f32) -> Ordering:
        left := self.to_bits()
        right := other.to_bits()
        let sign: u32 = 2147483648
        left_key := if left >= sign: ~left else: left | sign
        right_key := if right >= sign: ~right else: right | sign
        left_key.cmp(&right_key)

    ## True when the value is NaN.
    ## See [std-num.is-nan](../../spec/std/num.md#r-std-num.is-nan).
    pub fn is_nan(self) -> bool:
        self != self

    ## True when the value is neither NaN nor an infinity.
    ## See [std-num.is-finite](../../spec/std/num.md#r-std-num.is-finite).
    pub fn is_finite(self) -> bool:
        self - self == 0.0

impl f64:
    ## True when the value is NaN.
    ## See [std-num.is-nan](../../spec/std/num.md#r-std-num.is-nan).
    pub fn is_nan(self) -> bool:
        self != self

    # Neither NaN nor an infinity: only then is `self - self` zero.
    ## True when the value is neither NaN nor an infinity.
    ## See [std-num.is-finite](../../spec/std/num.md#r-std-num.is-finite).
    pub fn is_finite(self) -> bool:
        self - self == 0.0

    # Fixed-point text with `digits` fractional digits, correctly rounded
    # with ties to even (spec/std/num.md#fixed-point-text). The host hook
    # does the rounding, which needs big-number arithmetic.
    ## The value in fixed-point text with `digits` digits after the point.
    ## See [std-num.to-fixed.decl](../../spec/std/num.md#r-std-num.to-fixed.decl).
    pub fn to_fixed(self, digits: usize) -> string:
        if digits > 100:
            panic("to_fixed: digits must be from 0 to 100")
        host_format_f64_fixed(self, digits)

impl f64:
    ## The absolute value; `-0.0` gives `0.0` and NaN stays NaN.
    ## See [std-num.float-abs](../../spec/std/num.md#r-std-num.float-abs).
    @intrinsic
    pub fn abs(self) -> f64

    ## The integer part, toward zero.
    ## See [std-num.float-round.trunc](../../spec/std/num.md#r-std-num.float-round.trunc).
    @intrinsic
    pub fn trunc(self) -> f64

    ## The largest integer not above the value.
    ## See [std-num.float-round.floor](../../spec/std/num.md#r-std-num.float-round.floor).
    @intrinsic
    pub fn floor(self) -> f64

    ## The smallest integer not below the value.
    ## See [std-num.float-round.ceil](../../spec/std/num.md#r-std-num.float-round.ceil).
    @intrinsic
    pub fn ceil(self) -> f64

    ## The nearest integer, with a tie rounded away from zero.
    ## See [std-num.float-round.round](../../spec/std/num.md#r-std-num.float-round.round).
    pub fn round(self) -> f64:
        if !(self.abs() < 4503599627370496.0) || self == 0.0:
            return self
        size := self.abs()
        whole := size.trunc()
        # `size - whole` is exact, so the tie test never misreads 0.49999999999999994.
        up := if size - whole >= 0.5: whole + 1.0 else: whole
        if self < 0.0: -up else: up

    ## The nearest integer, with a tie rounded to the even integer.
    ## See [std-num.float-round.ties-even](../../spec/std/num.md#r-std-num.float-round.ties-even).
    @intrinsic
    pub fn round_ties_even(self) -> f64

    ## The magnitude of this value with the sign of `sign`.
    ## See [std-num.float-copysign](../../spec/std/num.md#r-std-num.float-copysign).
    @intrinsic
    pub fn copysign(self, sign: f64) -> f64

impl f32:
    ## The absolute value; `-0.0` gives `0.0` and NaN stays NaN.
    ## See [std-num.float-abs](../../spec/std/num.md#r-std-num.float-abs).
    @intrinsic
    pub fn abs(self) -> f32

    ## The integer part, toward zero.
    ## See [std-num.float-round.trunc](../../spec/std/num.md#r-std-num.float-round.trunc).
    @intrinsic
    pub fn trunc(self) -> f32

    ## The largest integer not above the value.
    ## See [std-num.float-round.floor](../../spec/std/num.md#r-std-num.float-round.floor).
    @intrinsic
    pub fn floor(self) -> f32

    ## The smallest integer not below the value.
    ## See [std-num.float-round.ceil](../../spec/std/num.md#r-std-num.float-round.ceil).
    @intrinsic
    pub fn ceil(self) -> f32

    ## The nearest integer, with a tie rounded away from zero.
    ## See [std-num.float-round.round](../../spec/std/num.md#r-std-num.float-round.round).
    pub fn round(self) -> f32:
        f32(f64(self).round())

    ## The nearest integer, with a tie rounded to the even integer.
    ## See [std-num.float-round.ties-even](../../spec/std/num.md#r-std-num.float-round.ties-even).
    @intrinsic
    pub fn round_ties_even(self) -> f32

    ## The magnitude of this value with the sign of `sign`.
    ## See [std-num.float-copysign](../../spec/std/num.md#r-std-num.float-copysign).
    @intrinsic
    pub fn copysign(self, sign: f32) -> f32

# Floating power and remainder are ordinary std code. Wasm has no native
# instructions for either operation, so the backend roots these two private
# entry points and calls them for both widths (widening and narrowing f32).
# Power uses double-double arithmetic for its logarithm and exponential;
# remainder uses exact shift-and-subtract on the significands.
struct DoubleDouble:
    high: f64
    low: f64

fn two_sum(left: f64, right: f64) -> DoubleDouble:
    sum := left + right
    back := sum - left
    error := (left - (sum - back)) + (right - back)
    DoubleDouble { high: sum, low: error }

fn quick_two_sum(left: f64, right: f64) -> DoubleDouble:
    sum := left + right
    DoubleDouble { high: sum, low: right - (sum - left) }

fn split_float(value: f64) -> (f64, f64):
    scaled := 134217729.0 * value
    high := scaled - (scaled - value)
    (high, value - high)

fn two_product(left: f64, right: f64) -> DoubleDouble:
    product := left * right
    let (left_high, left_low) = split_float(left)
    let (right_high, right_low) = split_float(right)
    error := (
        ((left_high * right_high - product) + left_high * right_low + left_low * right_high)
        + left_low * right_low
    )
    DoubleDouble { high: product, low: error }

fn dd_add(left: DoubleDouble, right: DoubleDouble) -> DoubleDouble:
    high_sum := two_sum(left.high, right.high)
    low_sum := two_sum(left.low, right.low)
    middle := high_sum.low + low_sum.high
    rounded := quick_two_sum(high_sum.high, middle)
    quick_two_sum(rounded.high, rounded.low + low_sum.low)

fn dd_add_float(value: DoubleDouble, addend: f64) -> DoubleDouble:
    sum := two_sum(value.high, addend)
    quick_two_sum(sum.high, sum.low + value.low)

fn dd_sub(left: DoubleDouble, right: DoubleDouble) -> DoubleDouble:
    dd_add(left, DoubleDouble { high: -right.high, low: -right.low })

fn dd_mul(left: DoubleDouble, right: DoubleDouble) -> DoubleDouble:
    product := two_product(left.high, right.high)
    error := product.low + (left.high * right.low + left.low * right.high)
    quick_two_sum(product.high, error)

fn dd_mul_float(value: DoubleDouble, factor: f64) -> DoubleDouble:
    product := two_product(value.high, factor)
    quick_two_sum(product.high, product.low + value.low * factor)

fn dd_div_float(value: DoubleDouble, divisor: f64) -> DoubleDouble:
    first := value.high / divisor
    product := two_product(first, divisor)
    difference := two_sum(value.high, -product.high)
    error := difference.low - product.low + value.low
    second := (difference.high + error) / divisor
    quick_two_sum(first, second)

fn dd_div(left: DoubleDouble, right: DoubleDouble) -> DoubleDouble:
    first := left.high / right.high
    first_product := dd_mul_float(right, first)
    first_remainder := dd_sub(left, first_product)
    second := first_remainder.high / right.high
    second_product := dd_mul_float(right, second)
    second_remainder := dd_sub(first_remainder, second_product)
    third := second_remainder.high / right.high
    dd_add_float(quick_two_sum(first, second), third)

fn float_power_of_two(exponent: i32) -> f64:
    f64_from(u64(exponent + 1023) << 52)

fn float_log(value: f64) -> DoubleDouble:
    let x = value
    let exponent_offset = 0.0
    if x < 2.2250738585072014e-308:
        x = x * 18014398509481984.0
        exponent_offset = -54.0
    bits := f64_bits(x)
    let exponent = exponent_offset + f64((bits >> 52) & 2047) - 1023.0
    let mantissa = f64_from((bits & 4503599627370495) | 4607182418800017408)
    if mantissa > 1.4142135623730951:
        mantissa = mantissa * 0.5
        exponent = exponent + 1.0
    numerator := mantissa - 1.0
    denominator := two_sum(mantissa, 1.0)
    ratio := dd_div(DoubleDouble { high: numerator, low: 0.0 }, denominator)
    ratio_squared := dd_mul(ratio, ratio)
    let sum = ratio
    let power = ratio
    let denominator_value = 1.0
    let remaining = +24
    while remaining > 0:
        power = dd_mul(power, ratio_squared)
        denominator_value = denominator_value + 2.0
        sum = dd_add(sum, dd_div_float(power, denominator_value))
        remaining = remaining - 1
    logarithm := DoubleDouble { high: 2.0 * sum.high, low: 2.0 * sum.low }
    ln2 := DoubleDouble { high: 0.6931471805599453, low: 2.3190468138462996e-17 }
    dd_add(dd_mul_float(ln2, exponent), logarithm)

fn rounded_double_double(value: DoubleDouble) -> f64:
    bits := f64_bits(value.high)
    other_bits := if value.low > 0.0: bits + 1 else: bits - 1
    other := f64_from(other_bits)
    half_gap := (other - value.high) * 0.5
    near_middle := (
        (value.low.abs() - half_gap.abs()).abs()
        < value.high * 8.271806125530277e-25
    )
    odd := bits & 1 == 1
    if near_middle && odd: other else: value.high

fn subnormal_power(exponent: i32, value: DoubleDouble, sign: f64) -> f64:
    scale := float_power_of_two(exponent + 1074)
    upper := value.high * scale
    lower := value.low * scale
    rounded := upper.round_ties_even()
    difference := (upper - rounded) + lower
    step := 1.0.copysign(difference)
    even := (rounded * 0.5).trunc() * 2.0 == rounded
    tie := (difference.abs() - 0.5).abs() < 5.820766091346741e-11
    let result = rounded
    if tie:
        if !even:
            result = rounded + step
    else if difference.abs() > 0.5:
        result = rounded + step
    half := float_power_of_two(-537)
    (result * half * half).copysign(sign)

fn power_special_cases(x: f64, y: f64) -> (bool, f64, f64):
    if y == 0.0 || x == 1.0:
        return (true, 1.0, 1.0)
    if x != x || y != y:
        return (true, x + y, 1.0)
    y_magnitude := y.abs()
    small_integer := y_magnitude < 9007199254740992.0
    integer := y_magnitude >= 9007199254740992.0 || y.trunc() == y
    odd := integer && small_integer && (y * 0.5).trunc() * 2.0 != y
    infinity := f64_from(9218868437227405312)
    if y_magnitude == infinity:
        x_magnitude := x.abs()
        if x_magnitude == 1.0:
            return (true, 1.0, 1.0)
        if (x_magnitude > 1.0) == (y > 0.0):
            return (true, infinity, 1.0)
        return (true, 0.0, 1.0)
    if x == 0.0:
        result := if y < 0.0: infinity else: 0.0
        return (true, if odd: result.copysign(x) else: result, 1.0)
    if x.abs() == infinity:
        result := if y < 0.0: 0.0 else: infinity
        return (true, if x < 0.0 && odd: -result else: result, 1.0)
    if x < 0.0 && !integer:
        return (true, f64_from(9221120237041090560), 1.0)
    sign := if x < 0.0 && odd: -1.0 else: 1.0
    (false, x.abs(), sign)

@inline(.Never)
fn float_pow_f64(x: f64, y: f64) -> f64:
    let (done, magnitude, sign) = power_special_cases(x, y)
    if done:
        return magnitude
    logarithm := float_log(magnitude)
    approximate := y * logarithm.high
    infinity := f64_from(9218868437227405312)
    if approximate > 800.0:
        return infinity.copysign(sign)
    if approximate < -800.0:
        return 0.0.copysign(sign)
    product := dd_mul_float(logarithm, y)
    multiple := (product.high * 1.4426950408889634).round_ties_even()
    ln2 := DoubleDouble { high: 0.6931471805599453, low: 2.3190468138462996e-17 }
    reduced := dd_sub(product, dd_mul_float(ln2, multiple))
    small := DoubleDouble { high: reduced.high / 256.0, low: reduced.low / 256.0 }
    let term = small
    let sum = small
    let divisor = 1.0
    let remaining = +10
    while remaining > 0:
        divisor = divisor + 1.0
        term = dd_div_float(dd_mul(term, small), divisor)
        sum = dd_add(sum, term)
        remaining = remaining - 1
    let halvings = +8
    while halvings > 0:
        doubled := DoubleDouble { high: 2.0 * sum.high, low: 2.0 * sum.low }
        sum = dd_add(doubled, dd_mul(sum, sum))
        halvings = halvings - 1
    result := dd_add_float(sum, 1.0)
    exponent := i32(multiple)
    if multiple < -1022.0 || (multiple == -1022.0 && result.high < 1.0):
        return subnormal_power(exponent, result, sign)
    rounded := rounded_double_double(result)
    first_exponent := exponent / 2
    second_exponent := exponent - first_exponent
    (rounded * float_power_of_two(first_exponent) * float_power_of_two(second_exponent))
        .copysign(sign)

fn normalized_float(bits: u64) -> (i32, u64):
    let exponent = i32((bits >> 52) & 2047)
    let significand = bits & 4503599627370495
    if exponent == 0:
        shift := significand.leading_zeros() - 11
        return (1 - i32(shift), significand << shift)
    (exponent, significand | 4503599627370496)

@inline(.Never)
fn float_rem_f64(x: f64, y: f64) -> f64:
    x_bits := f64_bits(x)
    y_bits := f64_bits(y)
    sign := x_bits & 9223372036854775808
    x_magnitude := x_bits << 1
    y_magnitude := y_bits << 1
    let infinity_magnitude: u64 = 18437736874454810624
    if y_magnitude == 0 || y_magnitude > infinity_magnitude || x_magnitude >= infinity_magnitude:
        return f64_from(9221120237041090560)
    if x_magnitude <= y_magnitude:
        if x_magnitude == y_magnitude:
            return f64_from(sign)
        return x
    let (x_exponent, x_significand) = normalized_float(x_bits)
    let (y_exponent, y_significand) = normalized_float(y_bits)
    let exponent = x_exponent
    let significand = x_significand
    while exponent > y_exponent:
        if significand >= y_significand:
            significand = significand - y_significand
            if significand == 0:
                return f64_from(sign)
        significand = significand << 1
        exponent = exponent - 1
    if significand >= y_significand:
        significand = significand - y_significand
        if significand == 0:
            return f64_from(sign)
    shift := significand.leading_zeros() - 11
    significand = significand << shift
    exponent = exponent - i32(shift)
    bits := if exponent > 0:
        (significand - 4503599627370496) | (u64(exponent) << 52)
    else:
        significand >> u32(1 - exponent)
    f64_from(bits | sign)

# The square root is an intrinsic method (spec/lang/09-traits.md#intrinsic-methods):
# the compiler supplies its body, the one correctly rounded IEEE 754
# square-root instruction of the width.
impl f64:
    ## The correctly rounded square root; a negative value gives NaN.
    ## See [std-num.float-sqrt](../../spec/std/num.md#r-std-num.float-sqrt).
    @intrinsic
    pub fn sqrt(self) -> f64

impl f32:
    ## The correctly rounded square root; a negative value gives NaN.
    ## See [std-num.float-sqrt](../../spec/std/num.md#r-std-num.float-sqrt).
    @intrinsic
    pub fn sqrt(self) -> f32

# Parsing accepts an optional `+` or `-` and then decimal digits only.
# Every scalar before the first invalid one is ASCII, so the scalar index
# that `InvalidDigit` reports is also its byte offset (Strings STR10).
# Reads the digits toward the sign, so the minimum value parses. Each step
# checks the bound first, so the arithmetic stays inside `low` to `high`.
# It reads the text's UTF-8 bytes: a non-ASCII byte is no digit, and every
# byte before the first invalid one is ASCII, so the byte index is the
# reported position.
fn parse_integer(text: string, low: i64, high: i64) -> Result[i64, ParseNumberError]:
    size := text.len()
    if size == 0:
        return .Err(ParseNumberError.Empty)
    negative := text[0] == 45
    let index: usize = if negative || text[0] == 43: 1 else: 0
    # A lone sign ends where a digit must follow: the end-of-text index.
    if index == size:
        return .Err(ParseNumberError.InvalidDigit(index))
    let value: i64 = 0
    while index < size:
        byte := text[index]
        if byte < 48 || byte > 57:
            return .Err(ParseNumberError.InvalidDigit(index))
        digit := i64(byte - 48)
        # Division truncates toward zero, so each bound is exact.
        if negative:
            if value < (low + digit) / 10:
                return .Err(ParseNumberError.OutOfRange)
            value = value * 10 - digit
        else:
            if value > (high - digit) / 10:
                return .Err(ParseNumberError.OutOfRange)
            value = value * 10 + digit
        index = index + 1
    .Ok(value)

# Unsigned parsing (r-std-num.parse.unsigned-type-grammar): the signed grammar without
# `-`, which is an invalid digit at position 0. A `u64` holds every result,
# so one reader serves every width.
fn parse_unsigned(text: string, high: u64) -> Result[u64, ParseNumberError]:
    size := text.len()
    if size == 0:
        return .Err(ParseNumberError.Empty)
    let index: usize = if text[0] == 43: 1 else: 0
    if index == size:
        return .Err(ParseNumberError.InvalidDigit(index))
    let value: u64 = 0
    while index < size:
        byte := text[index]
        if byte < 48 || byte > 57:
            return .Err(ParseNumberError.InvalidDigit(index))
        digit := u64(byte - 48)
        # Division truncates, so the bound is exact and the product cannot overflow.
        if value > (high - digit) / 10:
            return .Err(ParseNumberError.OutOfRange)
        value = value * 10 + digit
        index = index + 1
    .Ok(value)

# `Parse` for the numbers (r-std-num.parse.trait-impls): each impl reads the
# grammar and the range of its type, and the error is `ParseNumberError`.
impl Parse for i8:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[i8, ParseNumberError]:
        match parse_integer(text, -128, 127):
            .Ok(value) => .Ok(i8(value))
            .Err(error) => .Err(error)

impl Parse for i16:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[i16, ParseNumberError]:
        match parse_integer(text, -32768, 32767):
            .Ok(value) => .Ok(i16(value))
            .Err(error) => .Err(error)

impl Parse for i32:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[i32, ParseNumberError]:
        match parse_integer(text, -2147483648, 2147483647):
            .Ok(value) => .Ok(i32(value))
            .Err(error) => .Err(error)

impl Parse for i64:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[i64, ParseNumberError]:
        parse_integer(text, -i64_max() - 1, i64_max())

impl Parse for u8:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[u8, ParseNumberError]:
        match parse_unsigned(text, 255):
            .Ok(value) => .Ok(u8(value))
            .Err(error) => .Err(error)

impl Parse for u16:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[u16, ParseNumberError]:
        match parse_unsigned(text, 65535):
            .Ok(value) => .Ok(u16(value))
            .Err(error) => .Err(error)

impl Parse for u32:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[u32, ParseNumberError]:
        match parse_unsigned(text, 4294967295):
            .Ok(value) => .Ok(u32(value))
            .Err(error) => .Err(error)

impl Parse for u64:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[u64, ParseNumberError]:
        parse_unsigned(text, 18446744073709551615)

# `usize` has the target's width, 32 bits on Wasm32 (r-std-num.parse.usize-type-range).
impl Parse for usize:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[usize, ParseNumberError]:
        match parse_unsigned(text, 4294967295):
            .Ok(value) => .Ok(usize(value))
            .Err(error) => .Err(error)

impl Parse for f64:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[f64, ParseNumberError]:
        read_float64(text)

# The `f32` is the `f64` that `f64.parse` reads, rounded to `f32`
# (r-std-num.parse.float32).
impl Parse for f32:
    type Error = ParseNumberError

    fn parse(text: string) -> Result[f32, ParseNumberError]:
        match read_float64(text):
            .Ok(value) => .Ok(f32(value))
            .Err(error) => .Err(error)

# Float parsing (spec/std/num.md#float-parsing), in the grammar of Rust's
# `str::parse::<f64>`. The sign, the grammar, and the words `nan`, `inf`,
# and `infinity` are read here, so every error and its position are std's.
# The host hook only rounds an unsigned decimal number, and has no error
# signal (r-std-num.parse-f64.hook.total).
fn read_float64(text: string) -> Result[f64, ParseNumberError]:
    size := text.len()
    if size == 0:
        return .Err(ParseNumberError.Empty)
    negative := text[0] == 45
    let start: usize = if negative || text[0] == 43: 1 else: 0
    if start == size:
        return .Err(ParseNumberError.InvalidDigit(start))
    first := text[start]
    let magnitude = 0.0
    # `n`, `N`, `i`, `I`: a special word.
    if first == 110 || first == 78 || first == 105 || first == 73:
        match word_error(text, start):
            .Some(position) => return .Err(ParseNumberError.InvalidDigit(position))
            .None => pass
        magnitude = if first == 110 || first == 78: 0.0 / 0.0 else: 1.0 / 0.0
    else:
        match decimal_error(text, start):
            .Some(position) => return .Err(ParseNumberError.InvalidDigit(position))
            .None => pass
        # The sign is one ASCII byte, so the unsigned text starts at byte 1.
        magnitude = round_decimal(if start == 0: text else: text.slice(1, size))
    if negative: .Ok(-magnitude) else: .Ok(magnitude)

# Where the bytes of `text` from `start` first break a decimal number
# (r-std-num.parse-f64.decimal): the offset of the byte no continuation
# allows, or the text's length when it ends where more must follow.
# `.None` when all of it matches. Every byte before the first invalid one
# is ASCII, so the byte offset is the position the spec reports.
fn decimal_error(text: string, start: usize) -> usize?:
    size := text.len()
    let at = after_digits(text, start)
    let digits = at > start
    if at < size && text[at] == 46:
        fraction := after_digits(text, at + 1)
        digits = digits || fraction > at + 1
        at = fraction
    # Either side of the point may be empty, but not both.
    if !digits:
        return .Some(at)
    if at < size && (text[at] == 101 || text[at] == 69):
        at = at + 1
        if at < size && (text[at] == 43 || text[at] == 45):
            at = at + 1
        if at >= size:
            return .Some(size)
        if text[at] < 48 || text[at] > 57:
            return .Some(at)
        at = after_digits(text, at)
    if at < size: .Some(at) else: .None

# Where the bytes of `text` from `start` first break the word `nan`, `inf`,
# or `infinity`, each letter in either case (r-std-num.parse-f64.special):
# the offset of the byte no word allows, or the text's length when it ends
# inside a word. `.None` when the rest is one whole word.
fn word_error(text: string, start: usize) -> usize?:
    nan := text[start] == 110 || text[start] == 78
    word := if nan: "nan" else: "infinity"
    size := text.len()
    let index: usize = 0
    while start + index < size:
        byte := text[start + index]
        # An upper-case letter is 32 below its lower-case letter.
        if index >= word.len() || (byte != word[index] && byte != word[index] - 32):
            return .Some(start + index)
        index = index + 1
    # `inf` is a whole word as well as the start of `infinity`.
    if index == word.len() || (!nan && index == 3): .None else: .Some(size)

# The offset after the run of decimal digits that starts at `at`.
fn after_digits(text: string, at: usize) -> usize:
    let index = at
    while index < text.len() && text[index] >= 48 && text[index] <= 57:
        index = index + 1
    index

# The correctly rounded `f64` of an unsigned decimal number, ties to
# even: positive infinity past the range and `0.0` below it. Callers pass
# only text in the grammar (spec/std/README.md#standard-library-primitives).
@intrinsic("parse_f64")
fn round_decimal(text: string) -> f64:
    panic("intrinsic")

# The bit casts between a float and the unsigned integer of its width: one
# reinterpret instruction each, keeping every bit
# (spec/std/README.md#standard-library-primitives).
@intrinsic("f64_to_bits")
fn f64_bits(value: f64) -> u64:
    panic("intrinsic")

@intrinsic("f64_from_bits")
fn f64_from(bits: u64) -> f64:
    panic("intrinsic")

@intrinsic("f32_to_bits")
fn f32_bits(value: f32) -> u32:
    panic("intrinsic")

@intrinsic("f32_from_bits")
fn f32_from(bits: u32) -> f32:
    panic("intrinsic")

# The fixed-point text of `value` with `digits` fractional digits, from 0
# to 100: correctly rounded, ties to even. The hook writes `NaN`, `inf`,
# `-inf`, and the sign of `-0.0` (spec/std/README.md#standard-library-primitives).
@intrinsic("format_f64_fixed")
fn host_format_f64_fixed(value: f64, digits: usize) -> string:
    panic("intrinsic")

# The compiler supplies each integer type's bounds as constants.
@intrinsic("int_min")
fn int_min[N < Integer]() -> N:
    panic("intrinsic")

@intrinsic("int_max")
fn int_max[N < Integer]() -> N:
    panic("intrinsic")

# Returns `n` when `low <= n <= high`. Otherwise it panics with integer
# overflow, in every build (r-trait.num.from-i64-checked): a release build
# wraps `+`, so the panic is explicit.
fn fit(n: i64, low: i64, high: i64) -> i64:
    if n < low || n > high:
        panic_with("integer-overflow", "integer overflow")
    n

# Returns `n` when `n <= high`. Otherwise it panics with integer overflow,
# in every build (r-std-num.u64.checked).
fn fit_u64(n: u64, high: u64) -> u64:
    if n > high:
        panic_with("integer-overflow", "integer overflow")
    n

# Returns a non-negative `n` as a `u64`. A negative `n` panics with integer
# overflow, in every build (r-std-num.u64.checked).
fn nonneg_u64(n: i64) -> u64:
    if n < 0:
        panic_with("integer-overflow", "integer overflow")
    u64(n)

# `i64` literals take their type from context, so the bound is a function.
fn i64_max() -> i64:
    9223372036854775807
