    ## See [std-num.float-min.value](../../spec/std/num.md#r-std-num.float-min.value).
    pub fn min(self, other: f32) -> f32:
        if other != other || self < other: self else: other

    ## The larger input, returning the numeric input when the other is NaN.
    ## See [std-num.float-max.value](../../spec/std/num.md#r-std-num.float-max.value).
    pub fn max(self, other: f32) -> f32:
        if other != other || self > other: self else: other

