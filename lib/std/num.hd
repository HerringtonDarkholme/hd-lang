# The signed exponent has at most 32 bits, including i32's minimum value.
# Widen before negation; repeated squaring consumes one exponent bit per step.
fn float_integer_power[F < Float](value: F, exponent: i32) -> F:
    let bits = u32(if exponent < 0: -i64(exponent) else: i64(exponent))
    let factor = if exponent < 0: F::one() / value else: value
    let result = F::one()
    while bits != 0:
        if (bits & 1) != 0:
            result *= factor
        bits = bits >> 1
        if bits != 0:
            factor *= factor
    result

impl f64:
    ## The sine of this angle in radians.
    ## See [std-num.float-math.sin](../../spec/std/num.md#r-std-num.float-math.sin).
    pub fn sin(self) -> f64:
        libm_sin(self)
    ## The cosine of this angle in radians.
    ## See [std-num.float-math.cos](../../spec/std/num.md#r-std-num.float-math.cos).
    pub fn cos(self) -> f64:
        libm_cos(self)
    ## The tangent of this angle in radians.
    ## See [std-num.float-math.tan](../../spec/std/num.md#r-std-num.float-math.tan).
    pub fn tan(self) -> f64:
        libm_tan(self)
    ## The principal arcsine in radians.
    ## See [std-num.float-math.asin](../../spec/std/num.md#r-std-num.float-math.asin).
    pub fn asin(self) -> f64:
        libm_asin(self)
    ## The principal arccosine in radians.
    ## See [std-num.float-math.acos](../../spec/std/num.md#r-std-num.float-math.acos).
    pub fn acos(self) -> f64:
