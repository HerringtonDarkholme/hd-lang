# std.num: the numeric traits, integer arithmetic variants, and parsing.
# Overflow is checked by default; the arithmetic methods make the other
# behaviors explicit. They are declared for every integer width.
use std.ops.{Add, BitAnd, BitOr, BitXor, Div, Mul, Neg, Not, Rem, Shl, Shr, Sub}
use std.format.DebugWriter

# The numeric traits (spec/lang/09-traits.md#numeric-traits). They are sealed:
# only these implementations exist, one per primitive number type
# (r-trait.num.sealed). `from_i64` is checked (r-trait.num.from-i64-checked):
# a value the integer type cannot hold panics with integer overflow.
pub trait Num < AnyVal & PartialOrd & Display & Add[Out = Self] & Sub[Out = Self] & Mul[Out = Self] & Div[Out = Self] & Rem[Out = Self]:
    fn zero() -> Self
    fn one() -> Self
    fn from_i64(n: i64) -> Self

pub trait Integer < Num & Ord & BitAnd[Out = Self] & BitOr[Out = Self] & BitXor[Out = Self] & Not[Out = Self] & Shl[u32, Out = Self] & Shr[u32, Out = Self]

pub trait Float < Num & PartialOrd & Neg[Out = Self]

impl Num for i8:
    fn zero() -> i8: 0
    fn one() -> i8: 1
    fn from_i64(n: i64) -> i8: i8(fit(n, -128, 127))

impl Num for i16:
    fn zero() -> i16: 0
    fn one() -> i16: 1
    fn from_i64(n: i64) -> i16: i16(fit(n, -32768, 32767))

impl Num for i32:
    fn zero() -> i32: 0
    fn one() -> i32: 1
    fn from_i64(n: i64) -> i32: i32(fit(n, -2147483648, 2147483647))

impl Num for i64:
    fn zero() -> i64: 0
    fn one() -> i64: 1
    fn from_i64(n: i64) -> i64: n

impl Num for u8:
    fn zero() -> u8: 0
    fn one() -> u8: 1
    fn from_i64(n: i64) -> u8: u8(fit(n, 0, 255))

impl Num for u16:
    fn zero() -> u16: 0
    fn one() -> u16: 1
    fn from_i64(n: i64) -> u16: u16(fit(n, 0, 65535))

impl Num for u32:
    fn zero() -> u32: 0
    fn one() -> u32: 1
    fn from_i64(n: i64) -> u32: u32(fit(n, 0, 4294967295))

impl Num for u64:
    fn zero() -> u64: 0
    fn one() -> u64: 1
    fn from_i64(n: i64) -> u64: u64(fit(n, 0, i64_max()))

impl Num for f32:
    fn zero() -> f32: 0.0
    fn one() -> f32: 1.0
    fn from_i64(n: i64) -> f32: f32(n)

impl Num for f64:
    fn zero() -> f64: 0.0
    fn one() -> f64: 1.0
    fn from_i64(n: i64) -> f64: f64(n)

impl Integer for i8

impl Integer for i16

impl Integer for i32

impl Integer for i64

impl Integer for u8

impl Integer for u16

impl Integer for u32

impl Integer for u64

impl Float for f32

impl Float for f64

pub enum ParseNumberError:
    Empty
    InvalidDigit(position: i32)
    OutOfRange

impl Eq for ParseNumberError:
    fn eq(self, other: ParseNumberError) -> bool:
        match (self, other):
            (.Empty, .Empty) => true
            (.InvalidDigit(left), .InvalidDigit(right)) => left == right
            (.OutOfRange, .OutOfRange) => true
            _ => false

impl Display for ParseNumberError:
    fn to_string(self) -> string:
        match self:
            .Empty => "cannot parse a number from empty text"
            .InvalidDigit(position) => "invalid digit at position $position"
            .OutOfRange => "number out of range for its type"

# The integer methods (spec/std/num.md), written once for every integer
# width by r-trait.target.numeric-family. Generic code has no literals or
# casts, so the bounds come from `int_min` and `int_max`. Other std code
# does not call them: in the prototype, each concrete type a std function
# calls them with adds dictionary wrappers to every program.
impl[N < Integer] N:
    pub fn checked_add(self, other: N) -> N?:
        zero := N::zero()
        if other > zero && self > int_max::[N]() - other:
            return .None
        if other < zero && self < int_min::[N]() - other:
            return .None
        .Some(self + other)

    pub fn checked_sub(self, other: N) -> N?:
        zero := N::zero()
        if other > zero && self < int_min::[N]() + other:
            return .None
        if other < zero && self > int_max::[N]() + other:
            return .None
        .Some(self - other)

    pub fn checked_mul(self, other: N) -> N?:
        zero := N::zero()
        if self == zero || other == zero:
            return .Some(zero)
        lowest := int_min::[N]()
        highest := int_max::[N]()
        let overflows = false
        if self > zero:
            overflows = if other > zero: self > highest / other else: other < lowest / self
        else:
            overflows = if other > zero: self < lowest / other else: other < highest / self
        if overflows: .None else: .Some(self * other)

    pub fn checked_div(self, other: N) -> N?:
        zero := N::zero()
        if other == zero:
            return .None
        # `~zero` is -1 in a signed type, and the minimum over -1 overflows.
        minus_one := ~zero
        if minus_one < zero && other == minus_one && self == int_min::[N]():
            return .None
        .Some(self / other)

    # Fixed-width addition by carries: `<<` drops the carry out of the top
    # bit, so the sum keeps the low bits of the exact result.
    pub fn wrapping_add(self, other: N) -> N:
        zero := N::zero()
        let sum = self
        let carry = other
        while carry != zero:
            next := (sum & carry) << 1
            sum = sum ^ carry
            carry = next
        sum

    # `~other + 1`, wrapped, is the two's-complement negation of `other`.
    pub fn wrapping_sub(self, other: N) -> N:
        self.wrapping_add((~other).wrapping_add(N::one()))

    pub fn saturating_add(self, other: N) -> N:
        match self.checked_add(other):
            .Some(sum) => sum
            .None => if other > N::zero(): int_max::[N]() else: int_min::[N]()

    pub fn saturating_sub(self, other: N) -> N:
        match self.checked_sub(other):
            .Some(difference) => difference
            .None => if other > N::zero(): int_min::[N]() else: int_max::[N]()

    pub fn count_ones(self) -> u32:
        zero := N::zero()
        let count: u32 = 0
        let bit = N::one()
        while bit != zero:
            if (self & bit) != zero:
                count = count + 1
            bit = bit << 1
        count

    # Read from the low bit up: a set bit resets the count of zeros above it.
    pub fn leading_zeros(self) -> u32:
        zero := N::zero()
        let zeros: u32 = 0
        let bit = N::one()
        while bit != zero:
            zeros = if (self & bit) != zero: 0 else: zeros + 1
            bit = bit << 1
        zeros

# `abs_diff` returns the unsigned type of the same width, a mapping that
# `Integer` cannot name, so each width declares it. A narrow signed
# difference is exact in `i64`, and the cast keeps the distance.
impl i8:
    pub fn abs_diff(self, other: i8) -> u8:
        if self > other: u8(i64(self) - i64(other)) else: u8(i64(other) - i64(self))

impl i16:
    pub fn abs_diff(self, other: i16) -> u16:
        if self > other: u16(i64(self) - i64(other)) else: u16(i64(other) - i64(self))

impl i32:
    pub fn abs_diff(self, other: i32) -> u32:
        if self > other: u32(i64(self) - i64(other)) else: u32(i64(other) - i64(self))

# Operands of one sign subtract exactly. Otherwise the distance is
# `high + (-(low + 1)) + 1`, and each part fits in `u64`.
impl i64:
    pub fn abs_diff(self, other: i64) -> u64:
        high := if self > other: self else: other
        low := if self > other: other else: self
        if low >= 0 || high < 0:
            return u64(high - low)
        u64(high) + u64(-(low + 1)) + 1

impl u8:
    pub fn abs_diff(self, other: u8) -> u8:
        if self > other: self - other else: other - self

impl u16:
    pub fn abs_diff(self, other: u16) -> u16:
        if self > other: self - other else: other - self

impl u32:
    pub fn abs_diff(self, other: u32) -> u32:
        if self > other: self - other else: other - self

impl u64:
    pub fn abs_diff(self, other: u64) -> u64:
        if self > other: self - other else: other - self

impl f64:
    pub fn is_nan(self) -> bool:
        self != self

    # Neither NaN nor an infinity: only then is `self - self` zero.
    pub fn is_finite(self) -> bool:
        self - self == 0.0

    # Fixed-point text with `digits` fractional digits, correctly rounded
    # with ties to even (spec/std/num.md#fixed-point-text). The host hook
    # does the rounding, which needs big-number arithmetic.
    pub fn to_fixed(self, digits: i32) -> string:
        if digits < 0 || digits > 100:
            panic("to_fixed: digits must be from 0 to 100")
        host_format_f64_fixed(self, digits)

# Parsing accepts an optional `+` or `-` and then decimal digits only.
# Every scalar before the first invalid one is ASCII, so the scalar index
# that `InvalidDigit` reports is also its byte offset (Strings STR10).
pub fn parse_i32(text: string) -> Result[i32, ParseNumberError]:
    match parse_integer(text, -2147483648, 2147483647):
        .Ok(value) => .Ok(i32(value))
        .Err(error) => .Err(error)

pub fn parse_i64(text: string) -> Result[i64, ParseNumberError]:
    parse_integer(text, -i64_max() - 1, i64_max())

# Reads the digits toward the sign, so the minimum value parses. Each step
# checks the bound first, so the arithmetic stays inside `low` to `high`.
fn parse_integer(text: string, low: i64, high: i64) -> Result[i64, ParseNumberError]:
    scalars := text.split("")
    if scalars.len() == 0:
        return .Err(ParseNumberError.Empty)
    negative := scalars[0] == "-"
    let index = if negative || scalars[0] == "+": 1 else: 0
    # A lone sign ends where a digit must follow: the end-of-text index.
    if index == scalars.len():
        return .Err(ParseNumberError.InvalidDigit(index))
    let value: i64 = 0
    while index < scalars.len():
        digit := match digit_value(scalars[index]):
            .Some(found) => i64(found)
            .None => return .Err(ParseNumberError.InvalidDigit(index))
        # Division truncates toward zero, so each bound is exact.
        if negative:
            if value < (low + digit) / 10:
                return .Err(ParseNumberError.OutOfRange)
            value = value * 10 - digit
        else:
            if value > (high - digit) / 10:
                return .Err(ParseNumberError.OutOfRange)
            value = value * 10 + digit
        index = index + 1
    .Ok(value)

# Float parsing (spec/std/num.md#float-parsing), in the grammar of Rust's
# `str::parse::<f64>`. The sign, the grammar, and the words `nan`, `inf`,
# and `infinity` are read here, so every error and its position are std's.
# The host hook only rounds an unsigned decimal number, and has no error
# signal (r-std-num.parse-f64.hook.total).
pub fn parse_f64(text: string) -> Result[f64, ParseNumberError]:
    scalars := text.split("")
    if scalars.len() == 0:
        return .Err(ParseNumberError.Empty)
    negative := scalars[0] == "-"
    start := if negative || scalars[0] == "+": 1 else: 0
    if start == scalars.len():
        return .Err(ParseNumberError.InvalidDigit(start))
    first := scalars[start]
    let magnitude = 0.0
    if first == "n" || first == "N" || first == "i" || first == "I":
        match word_error(scalars, start):
            .Some(position) => return .Err(ParseNumberError.InvalidDigit(position))
            .None => pass
        magnitude = if first == "n" || first == "N": 0.0 / 0.0 else: 1.0 / 0.0
    else:
        match decimal_error(scalars, start):
            .Some(position) => return .Err(ParseNumberError.InvalidDigit(position))
            .None => pass
        # The sign is one ASCII byte, so the unsigned text starts at byte 1.
        magnitude = host_parse_f64(if start == 0: text else: text.slice(1, text.len()))
    if negative: .Ok(-magnitude) else: .Ok(magnitude)

# Where `scalars` from `start` first breaks a decimal number
# (r-std-num.parse-f64.decimal): the index of the scalar no continuation
# allows, or the text's length when it ends where more must follow.
# `.None` when all of it matches.
fn decimal_error(scalars: List[string], start: i32) -> i32?:
    size := scalars.len()
    let at = after_digits(scalars, start)
    let digits = at > start
    if at < size && scalars[at] == ".":
        fraction := after_digits(scalars, at + 1)
        digits = digits || fraction > at + 1
        at = fraction
    # Either side of the point may be empty, but not both.
    if !digits:
        return .Some(at)
    if at < size && (scalars[at] == "e" || scalars[at] == "E"):
        at = at + 1
        if at < size && (scalars[at] == "+" || scalars[at] == "-"):
            at = at + 1
        if at >= size:
            return .Some(size)
        if digit_value(scalars[at]).is_none():
            return .Some(at)
        at = after_digits(scalars, at)
    if at < size: .Some(at) else: .None

# Where `scalars` from `start` first breaks the word `nan`, `inf`, or
# `infinity`, each letter in either case (r-std-num.parse-f64.special): the
# index of the scalar no word allows, or the text's length when it ends
# inside a word. `.None` when the rest is one whole word.
fn word_error(scalars: List[string], start: i32) -> i32?:
    nan := scalars[start] == "n" || scalars[start] == "N"
    lower := if nan: ["n", "a", "n"] else: ["i", "n", "f", "i", "n", "i", "t", "y"]
    upper := if nan: ["N", "A", "N"] else: ["I", "N", "F", "I", "N", "I", "T", "Y"]
    let index = 0
    while start + index < scalars.len():
        scalar := scalars[start + index]
        if index >= lower.len() || (scalar != lower[index] && scalar != upper[index]):
            return .Some(start + index)
        index = index + 1
    # `inf` is a whole word as well as the start of `infinity`.
    if index == lower.len() || (!nan && index == 3): .None else: .Some(scalars.len())

# The index after the run of decimal digits that starts at `at`.
fn after_digits(scalars: List[string], at: i32) -> i32:
    let index = at
    while index < scalars.len() && digit_value(scalars[index]).is_some():
        index = index + 1
    index

# The correctly rounded `f64` of an unsigned decimal number, ties to
# even: positive infinity past the range and `0.0` below it. Callers pass
# only text in the grammar (spec/std/README.md#standard-library-primitives).
@intrinsic("parse_f64")
fn host_parse_f64(text: string) -> f64:
    panic("intrinsic")

# The fixed-point text of `value` with `digits` fractional digits, from 0
# to 100: correctly rounded, ties to even. The hook writes `NaN`, `inf`,
# `-inf`, and the sign of `-0.0` (spec/std/README.md#standard-library-primitives).
@intrinsic("format_f64_fixed")
fn host_format_f64_fixed(value: f64, digits: i32) -> string:
    panic("intrinsic")

# The smallest value of an integer type: zero when unsigned, and the sign
# bit alone when signed. `~zero` is negative exactly in a signed type, and
# shifting one left reaches the sign bit before the bits run out.
fn int_min[N < Integer]() -> N:
    zero := N::zero()
    if ~zero > zero:
        return zero
    let bit = N::one()
    while bit > zero:
        bit = bit << 1
    bit

# The largest value: every bit of the smallest flipped.
fn int_max[N < Integer]() -> N:
    ~int_min::[N]()


# Returns `n` when `low <= n <= high`. Otherwise the checked sum of the
# largest `i64` and one panics with integer overflow.
fn fit(n: i64, low: i64, high: i64) -> i64:
    if n < low || n > high:
        return i64_max() + 1
    n

# `i64` literals take their type from context, so the bound is a function.
fn i64_max() -> i64:
    9223372036854775807

fn digit_value(scalar: string) -> i32?:
    match scalar:
        "0" => .Some(0)
        "1" => .Some(1)
        "2" => .Some(2)
        "3" => .Some(3)
        "4" => .Some(4)
        "5" => .Some(5)
        "6" => .Some(6)
        "7" => .Some(7)
        "8" => .Some(8)
        "9" => .Some(9)
        _ => .None

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.mapping): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for ParseNumberError:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Empty => out.write("Empty")
            .InvalidDigit(position) => out.debug_struct("InvalidDigit").field("position", position).finish()
            .OutOfRange => out.write("OutOfRange")
