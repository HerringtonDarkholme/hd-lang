# musl log.c (Arm): log(x) = log1p(z/c - 1) + log(c) + k*ln2.
# Cost: one table quadruple and about 25 floating operations.
fn libm_log(x: f64) -> f64:
    let ix = f64_bits(x)
    top := u32(ix >> 48)
    if ix.wrapping_sub(0x3fee000000000000) < 0x0003090000000000:
        # Close to 1.0.
        if ix == 0x3ff0000000000000:
            return 0.0
        r := x - 1.0
        r2 := r * r
        r3 := r * r2
        let y = (
            r3
            * (
                0.3333333333333352
                + r * -0.24999999999998432
                + r2 * 0.19999999999320328
                + r3 * (
                    -0.16666666669929706
                    + r * 0.14285715076560868
                    + r2 * -0.12499997863982555
                    + r3 * (
                        0.11110712032936046
                        + r * -0.10000486757818193
                        + r2 * 0.09181994006195467
                        + r3 * -0.08328363062289341
                    )
                )
            )
        )
        # Worst-case error is around 0.507 ULP.
        let w = r * 134217728.0
        rhi := r + w - w
        rlo := r - rhi
        w = rhi * rhi * -0.5
        hi := r + w
        let lo = r - hi + w
        lo += -0.5 * rlo * (rhi + r)
        y += lo
        y += hi
        return y
    if top.wrapping_sub(0x0010) >= 0x7ff0 - 0x0010:
        # x < 0x1p-1022 or inf or nan.
        if ix << 1 == 0:
            return -1.0 / 0.0
        if ix == 0x7ff0000000000000:
            return x
        if (top & 0x8000) != 0 || (top & 0x7ff0) == 0x7ff0:
            return (x - x) / (x - x)
        # x is subnormal: normalize it.
        ix = f64_bits(x * 4503599627370496.0).wrapping_sub(0x0340000000000000)
    # x = 2^k z, with z in [OFF, 2*OFF) and exact.
    tmp := ix.wrapping_sub(0x3fe6000000000000)
    i := usize((tmp >> 45) & 127)
    k := i64(tmp) >> 52
    iz := ix.wrapping_sub(tmp & 0xfff0000000000000)
    table := libm_log_table()
    invc := libm_float(table, 4 * i)
    logc := libm_float(table, 4 * i + 1)
    z := f64_from(iz)
    # r ~= z/c - 1, |r| < 1/256.
    r := (z - libm_float(table, 4 * i + 2) - libm_float(table, 4 * i + 3)) * invc
    kd := f64(k)
    # hi + lo = r + log(c) + k*ln2.
    w := kd * 0.6931471805598903 + logc
    hi := w + r
    lo := w - hi + r + kd * 5.497923018708371e-14
    # log(x) = lo + (log1p(r) - r) + hi.
    r2 := r * r
    (
        lo
        + r2 * -0.5000000000000001
        + r * r2 * (
            0.33333333331825593
            + r * -0.2499999999622955
            + r2 * (0.20000304511814496 + r * -0.16667054827627667)
        )
        + hi
    )

