# Word `index` of a packed table of 64-bit words: eleven characters per
# word, each `?` (63) plus six bits, least significant first. The words
# are musl's, as scripts/generate-libm-vectors.py --tables prints them; a
# string literal is static data, but its bytes must be text, so each byte
# carries six bits. Two loads and a fixed set of shifts read a word, with
# no heap list and no bounds check (the callers' indices are masked).
@inline(.Always)
fn libm_word(table: string, index: usize) -> u64:
    at := string_bytes(table).address + index * 11
    let low = load_u64(at) - 0x3f3f3f3f3f3f3f3f
    low = (low & 0x003f003f003f003f) | ((low >> 2) & 0x0fc00fc00fc00fc0)
    low = (low & 0x00000fff00000fff) | ((low >> 4) & 0x00fff00000fff000)
    low = (low & 0x0000000000ffffff) | ((low >> 8) & 0x0000ffffff000000)
    high := (load_u64(at + 3) - 0x3f3f3f3f3f3f3f3f) >> 40
    low | ((high & 0x3f) << 48) | ((high & 0x3f00) << 46) | ((high & 0x3f0000) << 44)

@inline(.Always)
fn libm_float(table: string, index: usize) -> f64:
    f64_from(libm_word(table, index))

# The top 12 bits of a double: its sign and exponent.
@inline(.Always)
fn libm_top12(x: f64) -> u32:
    u32(f64_bits(x) >> 52)

# musl exp_data.c (Arm): `tab[2k]` is the bits of T[k] and `tab[2k+1]` the
# bits of H[k] less `k << 45`, where 2^(k/128) ~= H[k] * (1 + T[k]).
# Read by exp and exp2; pow reads the same words as code (`libm_exp_entry`).
