# std.text: the `string` methods, `join`, and `StringBuilder`
# (spec/lang/10-modules.md#string-methods for the intrinsics, spec/std/text.md for
# the methods above them).
# Positions and lengths are byte offsets (Strings STR1-STR6, STR10). The
# built-in methods (`len`, `chars`, `char_indices`, `bytes`, `slice`, `trim`,
# `lower`, `split`, `replace`, `starts_with`) are ordinary hd code here too. Every method is built on the byte primitives at the end of this
# file; `lower` and `upper` call the host, which holds the Unicode case
# tables (src/README.md, Compiler/library boundary). The raw-text prefix
# `r` is here too (Literal Suffixes L20), with the prefix helpers
# `interpolate`, `process_escapes`, and `EscapeError` (L22).
use std.ops.{Template, str_prefix}
use std.format.DebugWriter

# The standard raw-text prefix (spec/std/text.md#r-std-text.prefix.std.r):
# no escape is processed.
@str_prefix
## The standard string prefix: raw text with the values' `Display` text interpolated, as in `r"cost $5"`.
## See [std-text.prefix.std.r](../../spec/std/text.md#r-std-text.prefix.std.r).
pub fn r(t: Template[dyn Display]) -> string:
    interpolate(t)

# The raw pieces joined with the values' `Display` text, in order
# (the specification names only `r`).
## Joins a template's pieces with the `Display` text of each value, which every literal function uses.
## See [std-text.prefix-helper.interpolate](../../spec/std/text.md#r-std-text.prefix-helper.interpolate).
pub fn interpolate[T < Display](t: Template[T]) -> string:
    let pieces: mut List[string] = [t.raw_parts[0]]
    let index: usize = 0
    while index < t.values.len():
        pieces.push(t.values[index].to_string())
        pieces.push(t.raw_parts[index + 1])
        index = index + 1
    join(pieces, "")

# An invalid escape sequence: `position` is the byte offset of its backslash
# (Literal Suffixes L21, L22; Strings STR10).
## A template expression that is not well formed, at a byte position.
## See [std-text.prefix-helper.escape-error](../../spec/std/text.md#r-std-text.prefix-helper.escape-error).
pub data EscapeError:
    ## The byte offset of the first character that makes the expression malformed.
    ## See [std-text.prefix-helper.escape-error](../../spec/std/text.md#r-std-text.prefix-helper.escape-error).
    pub position: usize

impl Eq for EscapeError:
    fn eq(self, other: EscapeError) -> bool:
        self.position == other.position

# The text with each escape sequence replaced by its meaning, or an
# `EscapeError` at the first invalid one (spec/lang/01-lexical-structure.md#escape-sequences). Every escape is ASCII, so
# the walk reads bytes and copies each run of plain text whole. The pieces
# are joined once at the end (see `replace`).
## Reads one template expression's escapes: `\n`, `\t`, `\r`, `\u{...}`, `\"`, `\$`, `\\`, `\{`, and `\}`.
## See [std-text.prefix-helper.escapes](../../spec/std/text.md#r-std-text.prefix-helper.escapes).
pub fn process_escapes(text: string) -> Result[string, EscapeError]:
    size := bytes_len(text)
    let pieces: mut List[string] = []
    let plain: usize = 0
    let index: usize = 0
    while index < size:
        if bytes_at(text, index) != 92:
            index = index + 1
            continue
        pieces.push(bytes_slice(text, plain, index))
        backslash := index
        if index + 1 >= size:
            return .Err(EscapeError { position: backslash })
        escaped := bytes_at(text, index + 1)
        index = index + 2
        if escaped == 117:
            match unicode_escape(text, index):
                .Some(found) =>
                    pieces.push(found.text)
                    index = found.end
                .None =>
                    return .Err(EscapeError { position: backslash })
        else:
            match simple_escape(escaped):
                .Some(meaning) =>
                    pieces.push(meaning)
                .None =>
                    return .Err(EscapeError { position: backslash })
        plain = index
    pieces.push(bytes_slice(text, plain, size))
    .Ok(join(pieces, ""))

# The meaning of a simple escape, by the byte after the backslash. The
# carriage return is written `\u{d}` because the std loader renames every
# bare word equal to a top-level name.
fn simple_escape(escaped: u8) -> string?:
    match escaped:
        92 => .Some("\\")
        34 => .Some("\"")
        39 => .Some("'")
        110 => .Some("\n")
        114 => .Some("\u{d}")
        116 => .Some("\t")
        48 => .Some("\0")
        36 => .Some("\$")
        _ => .None

data EscapedScalar:
    text: string
    end: usize

# `{` hex digits `}` at byte `start`, after `\u`: one to six digits
# naming a Unicode scalar value (spec/lang/01-lexical-structure.md#r-lex.escape.unicode).
fn unicode_escape(text: string, start: usize) -> EscapedScalar?:
    size := bytes_len(text)
    if start >= size || bytes_at(text, start) != 123:
        return .None
    let point = +0
    let digits = 0
    let index = start + 1
    while index < size && bytes_at(text, index) != 125:
        value := hex_digit(i32(bytes_at(text, index)))
        if value < 0 || digits == 6:
            return .None
        point = point * 16 + value
        digits = digits + 1
        index = index + 1
    if index >= size || digits == 0:
        return .None
    match char_from_scalar(u32(point)):
        .Some(scalar) => .Some(EscapedScalar { text: "${scalar}", end: index + 1 })
        .None => .None

# The value of an ASCII hex digit byte, or -1.
fn hex_digit(byte: i32) -> i32:
    if byte >= 48 && byte <= 57:
        return byte - 48
    if byte >= 97 && byte <= 102:
        return byte - 87
    if byte >= 65 && byte <= 70:
        return byte - 55
    -1

# Whether `point` is a Unicode scalar value: at most U+10FFFF and not a
# surrogate.
fn scalar_value(point: i32) -> bool:
    point >= 0 && point <= 1114111 && (point < 55296 || point > 57343)

# A malformed byte sequence given to `string::from_utf8`.
## A malformed byte sequence given to `string::from_utf8`.
## See [std-text.utf8.error.declared](../../spec/std/text.md#r-std-text.utf8.error.declared).
pub enum Utf8Error:
    # The byte offset where the first invalid sequence starts.
    InvalidSequence(position: usize)
    # The bytes end inside a sequence.
    Truncated

impl Eq for Utf8Error:
    fn eq(self, other: Utf8Error) -> bool:
        match (self, other):
            (.InvalidSequence(left), .InvalidSequence(right)) => left == right
            (.Truncated, .Truncated) => true
            _ => false

# The texts of r-std-text.utf8.error.display.invalid and
# r-std-text.utf8.error.display.truncated.
impl Display for Utf8Error:
    fn to_string(self) -> string:
        match self:
            .InvalidSequence(position) => "invalid UTF-8 sequence at byte $position"
            .Truncated => "incomplete UTF-8 sequence at the end of the bytes"

impl string:
    # The number of bytes (spec/lang/04-type-system.md#r-types.string.len-bytes).
    ## Returns the number of bytes in the string.
    ## See [ilt-in-methods](../../spec/lang/10-modules.md#built-in-methods).
    pub fn len(self) -> usize:
        bytes_len(self)

    # The scalar values in order (spec/lang/10-modules.md#r-module.string.chars).
    ## Iterates the string's characters, one Unicode scalar value at a time.
    ## See [module.string.chars](../../spec/lang/10-modules.md#r-module.string.chars).
    pub fn chars(self) -> mut Iterator[char]:
        let at: usize = 0
        Iterator::from_fn(fn() -> char?:
            if at >= bytes_len(self):
                return .None
            point := scalar_at(self, at)
            at = scalar_end(self, at)
            char_from_scalar(u32(point))
        )

    # Each scalar value with the byte offset where its encoding starts
    # (spec/lang/10-modules.md#r-module.string.char-indices).
    ## Iterates `(byte offset, character)` pairs, one per character.
    ## See [module.string.char-indices](../../spec/lang/10-modules.md#r-module.string.char-indices).
    pub fn char_indices(self) -> mut Iterator[(usize, char)]:
        let at: usize = 0
        Iterator::from_fn(fn() -> (usize, char)?:
            if at >= bytes_len(self):
                return .None
            start := at
            at = scalar_end(self, start)
            match char_from_scalar(u32(scalar_at(self, start))):
                .Some(scalar) => .Some((start, scalar))
                .None => .None
        )

    # The bytes in order (spec/lang/10-modules.md#r-module.string.bytes).
    ## Iterates the string's bytes, one `u8` at a time.
    ## See [module.string.bytes](../../spec/lang/10-modules.md#r-module.string.bytes).
    pub fn bytes(self) -> mut Iterator[u8]:
        let at: usize = 0
        Iterator::from_fn(fn() -> u8?:
            if at >= bytes_len(self):
                return .None
            at = at + 1
            .Some(bytes_at(self, at - 1))
        )

    # The bytes from offset `start` up to `end`. Both must be scalar
    # boundaries with `start <= end`, or it panics with `index-out-of-bounds`
    # (spec/lang/10-modules.md#r-module.string.slice.bad-offset). The result
    # shares the bytes (spec/lang/10-modules.md#r-module.string.slice.shared).
    ## Returns the characters from byte offset `start` up to `end`, sharing the string's bytes.
    ## See [module.string.slice](../../spec/lang/10-modules.md#r-module.string.slice).
    pub fn slice(self, start: usize, end: usize) -> string:
        if start > end || !boundary(self, start) || !boundary(self, end):
            panic_with("index-out-of-bounds", "")
        bytes_slice(self, start, end)

    # A copy of the bytes.
    ## Returns the string's bytes as a new list.
    ## See [std-text.utf8.round-trip](../../spec/std/text.md#r-std-text.utf8.round-trip).
    pub fn to_utf8(self) -> List[u8]:
        let found: mut List[u8] = []
        for byte in self.bytes():
            found.push(byte)
        found

    # The string whose UTF-8 encoding is `bytes`, or where they are not
    # valid UTF-8 (spec/lang/04-type-system.md#r-types.string.from-bytes).
    ## Decodes well-formed UTF-8 bytes into a string, or the first malformed sequence.
    ## See [std-text.utf8.round-trip](../../spec/std/text.md#r-std-text.utf8.round-trip).
    pub fn from_utf8(bytes: List[u8]) -> Result[string, Utf8Error]:
        let index: usize = 0
        size := bytes.len()
        while index < size:
            lead := i32(bytes[index])
            let width: usize = 1
            let point = lead
            let lowest: i32 = 0
            if lead >= 240 && lead <= 244:
                width = 4
                point = lead - 240
                lowest = 65536
            else if lead >= 224 && lead < 240:
                width = 3
                point = lead - 224
                lowest = 2048
            else if lead >= 194 && lead < 224:
                width = 2
                point = lead - 192
                lowest = 128
            else if lead >= 128:
                return .Err(Utf8Error.InvalidSequence(index))
            let at: usize = 1
            while at < width:
                if index + at >= size:
                    return .Err(Utf8Error.Truncated)
                if !continuation_byte(bytes[index + at]):
                    return .Err(Utf8Error.InvalidSequence(index))
                point = point * 64 + i32(bytes[index + at]) - 128
                at = at + 1
            if point < lowest || !scalar_value(point):
                return .Err(Utf8Error.InvalidSequence(index))
            index = index + width
        .Ok(string_from_bytes(bytes))

    ## True exactly when the string has no characters.
    ## See [std-text.more.is-empty](../../spec/std/text.md#r-std-text.more.is-empty).
    pub fn is_empty(self) -> bool:
        bytes_len(self) == 0

    ## True when the string begins with `prefix`.
    ## See [std-text.string.starts-with](../../spec/std/text.md#r-std-text.string.starts-with).
    pub fn starts_with(self, prefix: string) -> bool:
        bytes_len(prefix) <= bytes_len(self) && bytes_match(self, prefix, 0)

    ## True when the string ends with `suffix`.
    ## See [std-text.more.ends-with](../../spec/std/text.md#r-std-text.more.ends-with).
    pub fn ends_with(self, suffix: string) -> bool:
        bytes_len(suffix) <= bytes_len(self) && bytes_match(self, suffix, bytes_len(self) - bytes_len(suffix))

    ## True when `needle` occurs in the string.
    ## See [std-text.more.contains](../../spec/std/text.md#r-std-text.more.contains).
    pub fn contains(self, needle: string) -> bool:
        match byte_find(self, needle, 0):
            .Some(_) => true
            .None => false

    # The byte offset of the first `needle`; an empty needle is at 0.
    ## Returns the byte offset of the first occurrence of `needle`, in `.Some`, or `.None`.
    ## See [std-text.more.find](../../spec/std/text.md#r-std-text.more.find).
    pub fn find(self, needle: string) -> usize?:
        byte_find(self, needle, 0)

    # The pieces between separators, keeping empty ones. An empty separator
    # splits into one-scalar strings.
    ## Splits the string around each occurrence of `separator`, in order.
    ## See [std-text.string.split](../../spec/std/text.md#r-std-text.string.split).
    pub fn split(self, separator: string) -> List[string]:
        let pieces: mut List[string] = []
        size := bytes_len(self)
        if bytes_len(separator) == 0:
            let start: usize = 0
            while start < size:
                end := scalar_end(self, start)
                pieces.push(bytes_slice(self, start, end))
                start = end
            return pieces
        let start: usize = 0
        let searching = true
        while searching:
            match byte_find(self, separator, start):
                .Some(found) =>
                    pieces.push(bytes_slice(self, start, found))
                    start = found + bytes_len(separator)
                .None =>
                    searching = false
        pieces.push(bytes_slice(self, start, size))
        pieces

    # Replaces non-overlapping matches from left to right. An empty `old`
    # inserts `replacement` at every scalar boundary.
    ## Returns the string with each occurrence of `old` replaced by `replacement`.
    ## See [std-text.string.replace](../../spec/std/text.md#r-std-text.string.replace).
    pub fn replace(self, old: string, replacement: string) -> string:
        size := bytes_len(self)
        # The pieces are joined once at the end, since appending each to
        # the text so far would copy that text again every time.
        let pieces: mut List[string] = []
        if bytes_len(old) == 0:
            pieces.push(replacement)
            let start: usize = 0
            while start < size:
                end := scalar_end(self, start)
                pieces.push(bytes_slice(self, start, end))
                pieces.push(replacement)
                start = end
            return join(pieces, "")
        let start: usize = 0
        let searching = true
        while searching:
            match byte_find(self, old, start):
                .Some(found) =>
                    pieces.push(bytes_slice(self, start, found))
                    pieces.push(replacement)
                    start = found + bytes_len(old)
                .None =>
                    searching = false
        pieces.push(bytes_slice(self, start, size))
        join(pieces, "")

    # Removes the Unicode White_Space property at both ends.
    ## Returns the string without whitespace at either end.
    ## See [std-text.string.trim](../../spec/std/text.md#r-std-text.string.trim).
    pub fn trim(self) -> string:
        self.trim_start().trim_end()

    ## Returns the string without whitespace at its start.
    ## See [std-text.more.trim-ends](../../spec/std/text.md#r-std-text.more.trim-ends).
    pub fn trim_start(self) -> string:
        size := bytes_len(self)
        let start: usize = 0
        while start < size && white_space(scalar_at(self, start)):
            start = scalar_end(self, start)
        bytes_slice(self, start, size)

    ## Returns the string without whitespace at its end.
    ## See [std-text.more.trim-ends](../../spec/std/text.md#r-std-text.more.trim-ends).
    pub fn trim_end(self) -> string:
        let end = bytes_len(self)
        let trimming = end > 0
        while trimming:
            start := scalar_start(self, end)
            if white_space(scalar_at(self, start)):
                end = start
                trimming = end > 0
            else:
                trimming = false
        bytes_slice(self, 0, end)

    ## Returns the string in lowercase.
    ## See [std-text.string.lower](../../spec/std/text.md#r-std-text.string.lower).
    pub fn lower(self) -> string:
        host_lower(self)

    ## Returns the string in uppercase.
    ## See [std-text.more.upper](../../spec/std/text.md#r-std-text.more.upper).
    pub fn upper(self) -> string:
        host_upper(self)

    ## Returns the string without its `prefix` when it starts with it, in `.Some`, or `.None`.
    ## See [std-text.more.strip](../../spec/std/text.md#r-std-text.more.strip).
    pub fn strip_prefix(self, prefix: string) -> string?:
        if self.starts_with(prefix): .Some(bytes_slice(self, bytes_len(prefix), bytes_len(self))) else: .None

    ## Returns the string without its `suffix` when it ends with it, in `.Some`, or `.None`.
    ## See [std-text.more.strip](../../spec/std/text.md#r-std-text.more.strip).
    pub fn strip_suffix(self, suffix: string) -> string?:
        if self.ends_with(suffix): .Some(bytes_slice(self, 0, bytes_len(self) - bytes_len(suffix))) else: .None

    # The pieces between "\n" separators; a final "\n" ends the last line
    # rather than starting an empty one. A carriage return directly before
    # a "\n" is removed (r-std-text.string.lines); it is written `\u{d}`
    # for the reason that `simple_escape` gives.
    ## Splits the string into its lines, without their endings.
    ## See [std-text.string.lines](../../spec/std/text.md#r-std-text.string.lines).
    pub fn lines(self) -> List[string]:
        pieces := self.split("\n")
        let found: mut List[string] = []
        let index: usize = 0
        while index < pieces.len():
            piece := pieces[index]
            if index < pieces.len() - 1:
                if piece.ends_with("\u{d}"):
                    found.push(bytes_slice(piece, 0, bytes_len(piece) - 1))
                else:
                    found.push(piece)
            else if piece.len() > 0:
                found.push(piece)
            index = index + 1
        found

    # Doubles a run of copies and adds the runs that the bits of `count`
    # name, so the bytes copied stay proportional to the result's length.
    ## Joins `count` copies of the string.
    ## See [std-text.string.repeat](../../spec/std/text.md#r-std-text.string.repeat).
    pub fn repeat(self, count: usize) -> string:
        let repeated = ""
        let run = self
        let remaining = count
        while remaining > 0:
            if remaining % 2 == 1:
                repeated = repeated + run
            remaining = remaining / 2
            if remaining > 0:
                run = run + run
        repeated

    # The text before and after the first `separator`, or `.None` when it
    # does not occur. An empty separator is found at 0
    # (spec/std/text.md#splitting-and-padding).
    ## Splits around the first occurrence of `separator`, in `.Some`, or `.None` when there is none.
    ## See [std-text.split-once](../../spec/std/text.md#r-std-text.split-once).
    pub fn split_once(self, separator: string) -> (string, string)?:
        match byte_find(self, separator, 0):
            .Some(found) => .Some((bytes_slice(self, 0, found), bytes_slice(self, found + bytes_len(separator), bytes_len(self))))
            .None => .None

    # The runs of scalars between runs of Unicode White_Space, with no
    # empty piece.
    ## Splits on runs of whitespace, with no empty pieces.
    ## See [std-text.split-whitespace](../../spec/std/text.md#r-std-text.split-whitespace).
    pub fn split_whitespace(self) -> List[string]:
        let pieces: mut List[string] = []
        size := bytes_len(self)
        let start: usize = 0
        while start < size:
            if white_space(scalar_at(self, start)):
                start = scalar_end(self, start)
            else:
                let end = start
                while end < size && !white_space(scalar_at(self, end)):
                    end = scalar_end(self, end)
                pieces.push(bytes_slice(self, start, end))
                start = end
        pieces

    # The spec gives `fill` the default ' ' (r-std-text.pad.fill-default).
    ## Pads the string on the left with `fill` until it is `width` characters long.
    ## See [std-text.pad.start](../../spec/std/text.md#r-std-text.pad.start).
    pub fn pad_start(self, width: usize, fill: char = ' ') -> string:
        size := scalar_count(self)
        if width <= size: self else: "$fill".repeat(width - size) + self

    ## Pads the string on the right with `fill` until it is `width` characters long.
    ## See [std-text.pad.end](../../spec/std/text.md#r-std-text.pad.end).
    pub fn pad_end(self, width: usize, fill: char = ' ') -> string:
        size := scalar_count(self)
        if width <= size: self else: self + "$fill".repeat(width - size)

    # Non-overlapping matches from left to right. An empty needle matches
    # at every scalar boundary, so it counts the scalars plus one.
    ## Returns the number of occurrences of `needle` in the string.
    ## See [std-text.count](../../spec/std/text.md#r-std-text.count).
    pub fn count(self, needle: string) -> usize:
        if bytes_len(needle) == 0:
            return scalar_count(self) + 1
        let found: usize = 0
        let start: usize = 0
        let searching = true
        while searching:
            match byte_find(self, needle, start):
                .Some(at) =>
                    found = found + 1
                    start = at + bytes_len(needle)
                .None =>
                    searching = false
        found

# Character classification (spec/std/text.md#character-classification).
# The Unicode properties are those of Unicode 17.0
# (r-std-text.char.unicode-version).
impl char:
    ## True when the character is an ASCII digit `0` to `9`.
    ## See [std-text.char.ascii-digit](../../spec/std/text.md#r-std-text.char.ascii-digit).
    pub fn is_ascii_digit(self) -> bool:
        point := i32(char_scalar(self))
        point >= 48 && point <= 57

    # The Unicode Alphabetic property (r-std-text.char.alphabetic).
    ## True when the character has the Unicode Alphabetic property.
    ## See [std-text.char.alphabetic](../../spec/std/text.md#r-std-text.char.alphabetic).
    pub fn is_alphabetic(self) -> bool:
        alphabetic_point(i32(char_scalar(self)))

    # Alphabetic, or the general category Nd, Nl, or No
    # (r-std-text.char.alphanumeric).
    ## True when the character is alphabetic or a digit.
    ## See [std-text.char.alphanumeric](../../spec/std/text.md#r-std-text.char.alphanumeric).
    pub fn is_alphanumeric(self) -> bool:
        point := i32(char_scalar(self))
        alphabetic_point(point) || in_ranges(numeric_ranges(), point)

    # The Unicode White_Space property, the one `trim` removes
    # (r-std-text.char.whitespace).
    ## True when the character has the Unicode White_Space property.
    ## See [std-text.char.whitespace](../../spec/std/text.md#r-std-text.char.whitespace).
    pub fn is_whitespace(self) -> bool:
        white_space(i32(char_scalar(self)))

    # The value of an ASCII digit or letter in `radix`, as Rust's
    # `char::to_digit` gives it (r-std-text.char.to-digit).
    ## Reads the character as a digit of `radix` (2 to 36), or `.None` when it is not one.
    ## See [std-text.char.to-digit](../../spec/std/text.md#r-std-text.char.to-digit).
    pub fn to_digit(self, radix: u32) -> u32?:
        if radix < 2 || radix > 36:
            panic("to_digit: the radix must be 2 to 36")
        point := i32(char_scalar(self))
        let value = +36
        if point >= 48 && point <= 57:
            value = point - 48
        else if point >= 97 && point <= 122:
            value = point - 87
        else if point >= 65 && point <= 90:
            value = point - 55
        if u32(value) < radix: .Some(u32(value)) else: .None

## Returns the parts in order with `separator` between each two.
## See [std-text.join.decl](../../spec/std/text.md#r-std-text.join.decl).
pub fn join(parts: List[string], separator: string) -> string:
    if parts.len() == 0:
        return ""
    join_range(parts, separator, 0, parts.len())

# The parts from `start` up to `end`, which is above `start`, joined by
# halves. Appending each part to the joined text so far copies that text
# again for every part, a quadratic cost; joining halves copies each byte
# at most twice per level, and there are about log2(n) levels.
fn join_range(parts: List[string], separator: string, start: usize, end: usize) -> string:
    if end - start == 1:
        return parts[start]
    middle := start + (end - start) / 2
    join_range(parts, separator, start, middle) + separator + join_range(parts, separator, middle, end)

impl List[string]:
    # The parts in order with `separator` between each two
    # (r-std-text.join.method).
    ## Joins the list's elements with `separator` between each two.
    ## See [std-text.join.method](../../spec/std/text.md#r-std-text.join.method).
    pub fn join(self, separator: string) -> string:
        join(self, separator)

## Joins many pieces of text by pushing them, cheaper than repeated concatenation.
## See [std-text.builder.decl](../../spec/std/text.md#r-std-text.builder.decl).
pub data StringBuilder:
    parts: mut List[string]

impl StringBuilder:
    ## Returns an empty builder.
    ## See [std-text.builder.new](../../spec/std/text.md#r-std-text.builder.new).
    pub fn new() -> mut StringBuilder:
        StringBuilder { parts: [] }

    ## Appends `text`.
    ## See [std-text.builder.push](../../spec/std/text.md#r-std-text.builder.push).
    pub fn push(mut self, text: string) -> void:
        self.parts.push(text)

    ## Returns every pushed text in push order, joined with nothing between. It leaves the builder unchanged.
    ## See [std-text.builder.build](../../spec/std/text.md#r-std-text.builder.build).
    pub fn build(self) -> string:
        join(self.parts, "")

# Whether `needle`'s bytes appear in `text` at byte `start`. A valid UTF-8
# needle can only match at a scalar boundary, so comparing bytes is exact.
fn bytes_match(text: string, needle: string, start: usize) -> bool:
    let index: usize = 0
    width := bytes_len(needle)
    while index < width:
        if bytes_at(text, start + index) != bytes_at(needle, index):
            return false
        index = index + 1
    true

# The byte position of the first `needle` at or after byte `from`.
fn byte_find(text: string, needle: string, from: usize) -> usize?:
    let start = from
    if bytes_len(needle) > bytes_len(text):
        return .None
    last := bytes_len(text) - bytes_len(needle)
    while start <= last:
        if bytes_match(text, needle, start):
            return .Some(start)
        start = start + 1
    .None

# The number of scalars in `text`.
fn scalar_count(text: string) -> usize:
    size := bytes_len(text)
    let found: usize = 0
    let at: usize = 0
    while at < size:
        at = scalar_end(text, at)
        found = found + 1
    found

fn continuation_byte(byte: u8) -> bool:
    byte >= 128 && byte < 192

# Whether byte `offset` is a scalar boundary of `text`
# (spec/lang/04-type-system.md#r-types.string.boundary).
fn boundary(text: string, offset: usize) -> bool:
    size := bytes_len(text)
    offset == size || (offset < size && !continuation_byte(bytes_at(text, offset)))

# The byte position just past the scalar that starts at byte `start`.
fn scalar_end(text: string, start: usize) -> usize:
    let end = start + 1
    size := bytes_len(text)
    while end < size && continuation_byte(bytes_at(text, end)):
        end = end + 1
    end

# The byte position where the scalar that ends at byte `end` starts.
fn scalar_start(text: string, end: usize) -> usize:
    let start = end - 1
    while start > 0 && continuation_byte(bytes_at(text, start)):
        start = start - 1
    start

# The code point of the scalar that starts at byte `start`.
fn scalar_at(text: string, start: usize) -> i32:
    lead := i32(bytes_at(text, start))
    if lead < 128:
        return lead
    let point: i32 = 0
    let width: usize = 4
    if lead < 224:
        point = lead - 192
        width = 2
    else:
        if lead < 240:
            point = lead - 224
            width = 3
        else:
            point = lead - 240
    let index: usize = 1
    while index < width:
        point = point * 64 + i32(bytes_at(text, start + index)) - 128
        index = index + 1
    point

# The Unicode White_Space property.
fn white_space(point: i32) -> bool:
    if point <= 32:
        return point == 32 || (point >= 9 && point <= 13)
    if point < 8192:
        return point == 133 || point == 160 || point == 5760
    point <= 8202 || point == 8232 || point == 8233 || point == 8239 || point == 8287 || point == 12288

# The Unicode Alphabetic property, with ASCII answered directly.
fn alphabetic_point(point: i32) -> bool:
    if point < 128:
        return (point >= 65 && point <= 90) || (point >= 97 && point <= 122)
    in_ranges(alphabetic_ranges(), point)

# Whether `point` is in one of `table`'s ranges, by binary search. A table
# is sorted range pairs: each 12-byte record is a line break or a space,
# the first scalar value as five hex digits, `-`, and the last one.
fn in_ranges(table: string, point: i32) -> bool:
    let low: usize = 0
    let high = bytes_len(table) / 12
    while low < high:
        middle := (low + high) / 2
        if point < range_field(table, middle * 12 + 1):
            high = middle
        else if point > range_field(table, middle * 12 + 7):
            low = middle + 1
        else:
            return true
    false

# The five hex digits at byte `start`.
fn range_field(table: string, start: usize) -> i32:
    let value = +0
    let index = start
    while index < start + 5:
        value = value * 16 + hex_digit(i32(bytes_at(table, index)))
        index = index + 1
    value

