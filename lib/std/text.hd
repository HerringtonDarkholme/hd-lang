# std.text: the `string` methods, `join`, and `StringBuilder`
# (spec/lang/10-modules.md#string-methods for the intrinsics, spec/std/text.md for
# the methods above them).
# Positions and lengths are byte offsets (Strings STR1-STR6, STR10). The
# built-in methods (`len`, `chars`, `char_indices`, `bytes`, `slice`, `trim`,
# `lower`, `split`, `replace`, `starts_with`) are ordinary hd code here too. Every method is built on the byte primitives at the end of this
# file; `lower` and `upper` call the host, which holds the Unicode case
# tables (src/README.md, Compiler/library boundary). The raw-text prefix
# `r` is here too (Literal Suffixes L20), with the prefix helpers
# `interpolate`, `process_escapes`, and `EscapeError` (L22).
use std.ops.{Template, str_prefix}
use std.format.DebugWriter

# The standard raw-text prefix (spec/std/text.md#r-std-text.prefix.std.r):
# no escape is processed.
@str_prefix
pub fn r(t: Template[Display]) -> string:
    interpolate(t)

# The raw pieces joined with the values' `Display` text, in order
# (the specification names only `r`).
pub fn interpolate[T < Display](t: Template[T]) -> string:
    let joined = t.raw_parts[0]
    let index = 0
    while index < t.values.len():
        joined = joined + t.values[index].to_string() + t.raw_parts[index + 1]
        index = index + 1
    joined

# An invalid escape sequence: `offset` is the byte offset of its backslash
# (Literal Suffixes L21, L22; Strings STR10).
pub data EscapeError:
    pub offset: i32

# The text with each escape sequence replaced by its meaning, or an
# `EscapeError` at the first invalid one (spec/lang/01-lexical-structure.md#escape-sequences). Every escape is ASCII, so
# the walk reads bytes and copies each run of plain text whole.
pub fn process_escapes(text: string) -> Result[string, EscapeError]:
    size := bytes_len(text)
    let processed = ""
    let plain = 0
    let index = 0
    while index < size:
        if bytes_at(text, index) != 92:
            index = index + 1
            continue
        processed = processed + bytes_slice(text, plain, index)
        backslash := index
        if index + 1 >= size:
            return .Err(EscapeError { offset: backslash })
        escaped := bytes_at(text, index + 1)
        index = index + 2
        if escaped == 117:
            match unicode_escape(text, index):
                .Some(found) =>
                    processed = processed + found.text
                    index = found.end
                .None =>
                    return .Err(EscapeError { offset: backslash })
        else:
            match simple_escape(escaped):
                .Some(meaning) =>
                    processed = processed + meaning
                .None =>
                    return .Err(EscapeError { offset: backslash })
        plain = index
    .Ok(processed + bytes_slice(text, plain, size))

# The meaning of a simple escape, by the byte after the backslash. The
# carriage return is written `\u{d}` because the std loader renames every
# bare word equal to a top-level name.
fn simple_escape(escaped: u8) -> string?:
    match escaped:
        92 => .Some("\\")
        34 => .Some("\"")
        39 => .Some("'")
        110 => .Some("\n")
        114 => .Some("\u{d}")
        116 => .Some("\t")
        48 => .Some("\0")
        36 => .Some("\$")
        _ => .None

data EscapedScalar:
    text: string
    end: i32

# `{` hex digits `}` at byte `start`, after `\u`: one to six digits
# naming a Unicode scalar value (spec/lang/01-lexical-structure.md#r-lex.escape.unicode).
fn unicode_escape(text: string, start: i32) -> EscapedScalar?:
    size := bytes_len(text)
    if start >= size || bytes_at(text, start) != 123:
        return .None
    let point = 0
    let digits = 0
    let index = start + 1
    while index < size && bytes_at(text, index) != 125:
        value := hex_digit(i32(bytes_at(text, index)))
        if value < 0 || digits == 6:
            return .None
        point = point * 16 + value
        digits = digits + 1
        index = index + 1
    if index >= size || digits == 0 || !scalar_value(point):
        return .None
    .Some(EscapedScalar { text: "${scalar_char(point)}", end: index + 1 })

# The value of an ASCII hex digit byte, or -1.
fn hex_digit(byte: i32) -> i32:
    if byte >= 48 && byte <= 57:
        return byte - 48
    if byte >= 97 && byte <= 102:
        return byte - 87
    if byte >= 65 && byte <= 70:
        return byte - 55
    -1

# Whether `point` is a Unicode scalar value: at most U+10FFFF and not a
# surrogate.
fn scalar_value(point: i32) -> bool:
    point >= 0 && point <= 1114111 && (point < 55296 || point > 57343)

# A malformed byte sequence given to `string::from_utf8`.
pub enum Utf8Error:
    # The byte offset where the first invalid sequence starts.
    InvalidSequence(position: i32)
    # The bytes end inside a sequence.
    Truncated

impl string:
    # The number of bytes (spec/lang/04-type-system.md#r-types.string.len-bytes).
    pub fn len(self) -> i32:
        bytes_len(self)

    # The scalar values in order (spec/lang/10-modules.md#r-module.string.chars).
    pub fn chars(self) -> mut Iterator[char]:
        let at = 0
        Iterator::from_fn(fn() -> char?:
            if at >= bytes_len(self):
                return .None
            point := scalar_at(self, at)
            at = scalar_end(self, at)
            .Some(scalar_char(point))
        )

    # Each scalar value with the byte offset where its encoding starts
    # (spec/lang/10-modules.md#r-module.string.char-indices).
    pub fn char_indices(self) -> mut Iterator[(i32, char)]:
        let at = 0
        Iterator::from_fn(fn() -> (i32, char)?:
            if at >= bytes_len(self):
                return .None
            start := at
            at = scalar_end(self, start)
            .Some((start, scalar_char(scalar_at(self, start))))
        )

    # The bytes in order (spec/lang/10-modules.md#r-module.string.bytes).
    pub fn bytes(self) -> mut Iterator[u8]:
        let at = 0
        Iterator::from_fn(fn() -> u8?:
            if at >= bytes_len(self):
                return .None
            at = at + 1
            .Some(bytes_at(self, at - 1))
        )

    # The bytes from offset `start` up to `end`. Both must be scalar
    # boundaries with `start <= end`, or it panics with `index-out-of-bounds`
    # (spec/lang/10-modules.md#r-module.string.slice.bad-offset). The result
    # shares the bytes (spec/lang/10-modules.md#r-module.string.slice.shared).
    pub fn slice(self, start: i32, end: i32) -> string:
        if start < 0 || start > end || !boundary(self, start) || !boundary(self, end):
            panic_with("index-out-of-bounds", "")
        bytes_slice(self, start, end)

    # A copy of the bytes.
    pub fn to_utf8(self) -> List[u8]:
        let found: mut List[u8] = []
        for byte in self.bytes():
            found.append(byte)
        found

    # The string whose UTF-8 encoding is `bytes`, or where they are not
    # valid UTF-8 (spec/lang/04-type-system.md#r-types.string.from-bytes).
    pub fn from_utf8(bytes: List[u8]) -> Result[string, Utf8Error]:
        let index = 0
        size := bytes.len()
        while index < size:
            lead := i32(bytes[index])
            let width = 1
            let point = lead
            let lowest = 0
            if lead >= 240 && lead <= 244:
                width = 4
                point = lead - 240
                lowest = 65536
            else if lead >= 224 && lead < 240:
                width = 3
                point = lead - 224
                lowest = 2048
            else if lead >= 194 && lead < 224:
                width = 2
                point = lead - 192
                lowest = 128
            else if lead >= 128:
                return .Err(Utf8Error.InvalidSequence(index))
            let at = 1
            while at < width:
                if index + at >= size:
                    return .Err(Utf8Error.Truncated)
                if !continuation_byte(bytes[index + at]):
                    return .Err(Utf8Error.InvalidSequence(index))
                point = point * 64 + i32(bytes[index + at]) - 128
                at = at + 1
            if point < lowest || !scalar_value(point):
                return .Err(Utf8Error.InvalidSequence(index))
            index = index + width
        .Ok(string_from_bytes(bytes))

    pub fn is_empty(self) -> bool:
        bytes_len(self) == 0

    pub fn starts_with(self, prefix: string) -> bool:
        bytes_len(prefix) <= bytes_len(self) && bytes_match(self, prefix, 0)

    pub fn ends_with(self, suffix: string) -> bool:
        bytes_len(suffix) <= bytes_len(self) && bytes_match(self, suffix, bytes_len(self) - bytes_len(suffix))

    pub fn contains(self, needle: string) -> bool:
        match byte_find(self, needle, 0):
            .Some(_) => true
            .None => false

    # The byte offset of the first `needle`; an empty needle is at 0.
    pub fn find(self, needle: string) -> i32?:
        byte_find(self, needle, 0)

    # The pieces between separators, keeping empty ones. An empty separator
    # splits into one-scalar strings.
    pub fn split(self, separator: string) -> List[string]:
        let pieces: mut List[string] = []
        size := bytes_len(self)
        if bytes_len(separator) == 0:
            let start = 0
            while start < size:
                end := scalar_end(self, start)
                pieces.append(bytes_slice(self, start, end))
                start = end
            return pieces
        let start = 0
        let searching = true
        while searching:
            match byte_find(self, separator, start):
                .Some(found) =>
                    pieces.append(bytes_slice(self, start, found))
                    start = found + bytes_len(separator)
                .None =>
                    searching = false
        pieces.append(bytes_slice(self, start, size))
        pieces

    # Replaces non-overlapping matches from left to right. An empty `old`
    # inserts `replacement` at every scalar boundary.
    pub fn replace(self, old: string, replacement: string) -> string:
        size := bytes_len(self)
        if bytes_len(old) == 0:
            let replaced = replacement
            let start = 0
            while start < size:
                end := scalar_end(self, start)
                replaced = replaced + bytes_slice(self, start, end) + replacement
                start = end
            return replaced
        let replaced = ""
        let start = 0
        let searching = true
        while searching:
            match byte_find(self, old, start):
                .Some(found) =>
                    replaced = replaced + bytes_slice(self, start, found) + replacement
                    start = found + bytes_len(old)
                .None =>
                    searching = false
        replaced + bytes_slice(self, start, size)

    # Removes the Unicode White_Space property at both ends.
    pub fn trim(self) -> string:
        self.trim_start().trim_end()

    pub fn trim_start(self) -> string:
        size := bytes_len(self)
        let start = 0
        while start < size && white_space(scalar_at(self, start)):
            start = scalar_end(self, start)
        bytes_slice(self, start, size)

    pub fn trim_end(self) -> string:
        let end = bytes_len(self)
        let trimming = end > 0
        while trimming:
            start := scalar_start(self, end)
            if white_space(scalar_at(self, start)):
                end = start
                trimming = end > 0
            else:
                trimming = false
        bytes_slice(self, 0, end)

    pub fn lower(self) -> string:
        host_lower(self)

    pub fn upper(self) -> string:
        host_upper(self)

    pub fn strip_prefix(self, prefix: string) -> string?:
        if self.starts_with(prefix): .Some(bytes_slice(self, bytes_len(prefix), bytes_len(self))) else: .None

    pub fn strip_suffix(self, suffix: string) -> string?:
        if self.ends_with(suffix): .Some(bytes_slice(self, 0, bytes_len(self) - bytes_len(suffix))) else: .None

    # The pieces between "\n" separators; a final "\n" ends the last line
    # rather than starting an empty one. A carriage return directly before
    # a "\n" is removed (r-std-text.string.lines); it is written `\u{d}`
    # for the reason that `simple_escape` gives.
    pub fn lines(self) -> List[string]:
        pieces := self.split("\n")
        let found: mut List[string] = []
        let index = 0
        while index < pieces.len():
            piece := pieces[index]
            if index < pieces.len() - 1:
                if piece.ends_with("\u{d}"):
                    found.append(bytes_slice(piece, 0, bytes_len(piece) - 1))
                else:
                    found.append(piece)
            else if piece.len() > 0:
                found.append(piece)
            index = index + 1
        found

    pub fn repeat(self, count: i32) -> string:
        if count < 0:
            panic("repeat: count must not be negative")
        let repeated = ""
        let index = 0
        while index < count:
            repeated = repeated + self
            index = index + 1
        repeated

pub fn join(parts: List[string], separator: string) -> string:
    let joined = ""
    let index = 0
    for part in parts:
        if index > 0:
            joined = joined + separator
        joined = joined + part
        index = index + 1
    joined

pub data StringBuilder:
    parts: mut List[string]

impl StringBuilder:
    pub fn new() -> mut StringBuilder:
        StringBuilder { parts: [] }

    pub fn push(mut self, text: string) -> void:
        self.parts.append(text)

    pub fn build(self) -> string:
        join(self.parts, "")

# Whether `needle`'s bytes appear in `text` at byte `start`. A valid UTF-8
# needle can only match at a scalar boundary, so comparing bytes is exact.
fn bytes_match(text: string, needle: string, start: i32) -> bool:
    let index = 0
    width := bytes_len(needle)
    while index < width:
        if bytes_at(text, start + index) != bytes_at(needle, index):
            return false
        index = index + 1
    true

# The byte position of the first `needle` at or after byte `from`.
fn byte_find(text: string, needle: string, from: i32) -> i32?:
    let start = from
    last := bytes_len(text) - bytes_len(needle)
    while start <= last:
        if bytes_match(text, needle, start):
            return .Some(start)
        start = start + 1
    .None

fn continuation_byte(byte: u8) -> bool:
    byte >= 128 && byte < 192

# Whether byte `offset` is a scalar boundary of `text`
# (spec/lang/04-type-system.md#r-types.string.boundary).
fn boundary(text: string, offset: i32) -> bool:
    size := bytes_len(text)
    offset == size || (offset >= 0 && offset < size && !continuation_byte(bytes_at(text, offset)))

# The byte position just past the scalar that starts at byte `start`.
fn scalar_end(text: string, start: i32) -> i32:
    let end = start + 1
    size := bytes_len(text)
    while end < size && continuation_byte(bytes_at(text, end)):
        end = end + 1
    end

# The byte position where the scalar that ends at byte `end` starts.
fn scalar_start(text: string, end: i32) -> i32:
    let start = end - 1
    while start > 0 && continuation_byte(bytes_at(text, start)):
        start = start - 1
    start

# The code point of the scalar that starts at byte `start`.
fn scalar_at(text: string, start: i32) -> i32:
    lead := i32(bytes_at(text, start))
    if lead < 128:
        return lead
    let point = 0
    let width = 4
    if lead < 224:
        point = lead - 192
        width = 2
    else:
        if lead < 240:
            point = lead - 224
            width = 3
        else:
            point = lead - 240
    let index = 1
    while index < width:
        point = point * 64 + i32(bytes_at(text, start + index)) - 128
        index = index + 1
    point

# The Unicode White_Space property.
fn white_space(point: i32) -> bool:
    if point <= 32:
        return point == 32 || (point >= 9 && point <= 13)
    if point < 8192:
        return point == 133 || point == 160 || point == 5760
    point <= 8202 || point == 8232 || point == 8233 || point == 8239 || point == 8287 || point == 12288

# The string kernel. `+` and interpolation on strings compile to calls of
# `string_concat`, `==` and `!=` to `string_equal`, and `<`, `<=`, `>`,
# and `>=` to `string_compare`, which orders by byte
# (spec/lang/05-expressions.md#r-expr.ord.std.string-bytes). Every program
# gets them (src/README.md, Compiler/library boundary).
fn string_concat(left: string, right: string) -> string:
    bytes_concat(left, right)

fn string_equal(left: string, right: string) -> bool:
    size := bytes_len(left)
    if size != bytes_len(right):
        return false
    let index = 0
    while index < size:
        if bytes_at(left, index) != bytes_at(right, index):
            return false
        index = index + 1
    true

# -1, 0, or 1 as `left` orders before, equal to, or after `right`.
fn string_compare(left: string, right: string) -> i32:
    left_size := bytes_len(left)
    right_size := bytes_len(right)
    shorter := if left_size < right_size: left_size else: right_size
    let index = 0
    while index < shorter:
        left_byte := bytes_at(left, index)
        right_byte := bytes_at(right, index)
        if left_byte != right_byte:
            return if left_byte < right_byte: -1 else: 1
        index = index + 1
    if left_size < right_size: -1 else if left_size > right_size: 1 else: 0

# Primitives (spec/std/README.md#standard-library-primitives). The compiler
# supplies each body: the byte primitives come from the Wasm runtime and the
# case mappings from the host. `@intrinsic` is prototype-internal and
# accepted only in lib/std.

@intrinsic("bytes_len")
fn bytes_len(text: string) -> i32:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: i32) -> u8:
    panic("intrinsic")

# The bytes from offset `start` up to `end`, sharing them in constant time.
@intrinsic("bytes_slice")
fn bytes_slice(text: string, start: i32, end: i32) -> string:
    panic("intrinsic")

@intrinsic("bytes_concat")
fn bytes_concat(left: string, right: string) -> string:
    panic("intrinsic")

# The string of `bytes`, which the caller has checked are UTF-8.
@intrinsic("string_from_bytes")
fn string_from_bytes(bytes: List[u8]) -> string:
    panic("intrinsic")

@intrinsic("string_lower")
fn host_lower(text: string) -> string:
    panic("intrinsic")

@intrinsic("string_upper")
fn host_upper(text: string) -> string:
    panic("intrinsic")

# The `char` of a scalar value.
@intrinsic("char_from_scalar")
fn scalar_char(point: i32) -> char:
    panic("intrinsic")

# The checked runtime panic of `category`, such as `index-out-of-bounds`,
# showing `message`, or no message when it is empty; it does not return.
@intrinsic("panic")
fn panic_with(category: string, message: string) -> void:
    panic("intrinsic")

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.mapping): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for EscapeError:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("EscapeError").field("offset", self.offset).finish()

impl Debug for Utf8Error:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .InvalidSequence(position) => out.debug_struct("InvalidSequence").field("position", position).finish()
            .Truncated => out.write("Truncated")

impl Debug for StringBuilder:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("StringBuilder").field("parts", self.parts).finish()
