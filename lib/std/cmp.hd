# std.cmp. `Eq`,
# `PartialOrd`, `Ord`, and `Ordering` are prelude names, declared here
# (spec/lang/09-traits.md#comparison-traits).
use std.function.Tuple
use std.num.{Num, Integer}
use std.structure.{Structure, Walker, Variant, Field}
use std.format.DebugWriter

pub enum Ordering:
    Less
    Equal
    Greater

pub trait Eq:
    fn eq(self, other: Self) -> bool

# Two orderings are equal when they are the same case (r-std-cmp.ordering.eq).
impl Eq for Ordering:
    fn eq(self, other: Ordering) -> bool:
        match self:
            .Less =>
                match other:
                    .Less => true
                    _ => false
            .Equal =>
                match other:
                    .Equal => true
                    _ => false
            .Greater =>
                match other:
                    .Greater => true
                    _ => false

# `.None` means unordered.
pub trait PartialOrd < Eq:
    fn partial_cmp(self, other: Self) -> Ordering?

pub trait Ord < PartialOrd:
    fn cmp(self, other: Self) -> Ordering

# The smaller of two values; `a` when they are equal (r-std-cmp.min-max.tie).
pub fn min[T < Ord](a: T, b: T) -> T:
    match b.cmp(a):
        .Less => b
        _ => a

# The larger of two values; `a` when they are equal, so `min` and `max`
# both give the first of equal values, as Python's do.
pub fn max[T < Ord](a: T, b: T) -> T:
    match b.cmp(a):
        .Greater => b
        _ => a

# `value` limited to `low..=high`; panics when `low > high`.
pub fn clamp[T < Ord](value: T, low: T, high: T) -> T:
    match high.cmp(low):
        .Less => panic("clamp: low must not exceed high")
        _ => pass
    match value.cmp(low):
        .Less => return low
        _ => pass
    match high.cmp(value):
        .Less => high
        _ => value

# Orders values in reverse.
pub data Reverse[T]:
    pub value: T

impl[T < Ord] Eq for Reverse[T]:
    fn eq(self, other: Reverse[T]) -> bool:
        match self.value.cmp(other.value):
            .Equal => true
            _ => false

impl[T < Ord] PartialOrd for Reverse[T]:
    fn partial_cmp(self, other: Reverse[T]) -> Ordering?:
        .Some(other.value.cmp(self.value))

impl[T < Ord] Ord for Reverse[T]:
    fn cmp(self, other: Reverse[T]) -> Ordering:
        other.value.cmp(self.value)

# Equality and order of the primitives (spec/lang/05-expressions.md#r-expr.eq.std,
# #r-expr.ord.std). The number types, `char`, and `bool` compare through
# intrinsic methods (spec/lang/09-traits.md#intrinsic-methods), whose bodies
# the compiler supplies, so no body is written with the operator it
# implements. Floats follow IEEE 754: NaN is unequal to itself and
# unordered, and they have no `Ord` (#r-expr.eq.float, #r-expr.ord.total).
# Characters order by scalar value (#r-expr.ord.std.char-scalar), and
# `bool` has `Eq` only.
impl[N < Num] Eq for N:
    @intrinsic
    fn eq(self, other: N) -> bool

impl[N < Num] PartialOrd for N:
    @intrinsic
    fn partial_cmp(self, other: N) -> Ordering?

impl[N < Integer] Ord for N:
    @intrinsic
    fn cmp(self, other: N) -> Ordering

impl Eq for char:
    @intrinsic
    fn eq(self, other: char) -> bool

impl PartialOrd for char:
    @intrinsic
    fn partial_cmp(self, other: char) -> Ordering?

impl Ord for char:
    @intrinsic
    fn cmp(self, other: char) -> Ordering

impl Eq for bool:
    @intrinsic
    fn eq(self, other: bool) -> bool

# Strings are hd over their bytes, not intrinsics, and order by byte
# (#r-expr.ord.std.string-bytes).
impl Eq for string:
    fn eq(self, other: string) -> bool:
        if self.len() != other.len():
            return false
        match string_order(self, other):
            .Equal => true
            _ => false

impl PartialOrd for string:
    fn partial_cmp(self, other: string) -> Ordering?:
        .Some(string_order(self, other))

impl Ord for string:
    fn cmp(self, other: string) -> Ordering:
        string_order(self, other)

# The first unequal byte decides; otherwise the shorter string is less.
fn string_order(left: string, right: string) -> Ordering:
    left_size := left.len()
    right_size := right.len()
    shorter := if left_size < right_size: left_size else: right_size
    let index: usize = 0
    while index < shorter:
        if left[index] != right[index]:
            return if left[index] < right[index]: .Less else: .Greater
        index = index + 1
    if left_size < right_size: .Less else if left_size > right_size: .Greater else: .Equal

# Equality and order of the built-in composites
# (spec/lang/05-expressions.md#r-expr.eq.std, #r-expr.ord.std). `==`, `<`, and
# the other comparison operators call these through `Eq.eq` and
# `PartialOrd.partial_cmp`. Tuples compare through the tuple templates
# at the end of this module.

# Lists are equal when they have the same length and equal elements in order.
impl[T < Eq] Eq for List[T]:
    fn eq(self, other: List[T]) -> bool:
        if self.len() != other.len():
            return false
        let index: usize = 0
        while index < self.len():
            if self[index] != other[index]:
                return false
            index = index + 1
        true

# Lexicographic: the first unequal element decides, and an unordered one,
# such as NaN, makes the lists unordered; otherwise the shorter list is less
# (spec/lang/05-expressions.md#r-expr.ord.std.sequences, #r-expr.ord.composite).
impl[T < PartialOrd] PartialOrd for List[T]:
    fn partial_cmp(self, other: List[T]) -> Ordering?:
        let index: usize = 0
        while index < self.len() && index < other.len():
            if self[index] != other[index]:
                return self[index].partial_cmp(other[index])
            index = index + 1
        if self.len() < other.len():
            return .Some(.Less)
        if self.len() > other.len():
            return .Some(.Greater)
        .Some(.Equal)

impl[T < Eq] Eq for T?:
    fn eq(self, other: T?) -> bool:
        match self:
            .Some(left) =>
                match other:
                    .Some(right) => left == right
                    .None => false
            .None =>
                match other:
                    .Some(_) => false
                    .None => true

# `.None` is less than every present value
# (spec/lang/05-expressions.md#r-expr.ord.std.optional).
impl[T < PartialOrd] PartialOrd for T?:
    fn partial_cmp(self, other: T?) -> Ordering?:
        match self:
            .Some(left) =>
                match other:
                    .Some(right) => left.partial_cmp(right)
                    .None => .Some(.Greater)
            .None =>
                match other:
                    .Some(_) => .Some(.Less)
                    .None => .Some(.Equal)

impl[T < Eq, E < Eq] Eq for Result[T, E]:
    fn eq(self, other: Result[T, E]) -> bool:
        match self:
            .Ok(left) =>
                match other:
                    .Ok(right) => left == right
                    .Err(_) => false
            .Err(left) =>
                match other:
                    .Err(right) => left == right
                    .Ok(_) => false

# Maps are equal when they have the same keys, each with an equal value, in
# any order (spec/lang/05-expressions.md#r-expr.eq.map-order).
impl[K < Eq & Hash, V < Eq] Eq for Map[K, V]:
    fn eq(self, other: Map[K, V]) -> bool:
        if self.len() != other.len():
            return false
        for (key, value) in self:
            match other.get(key):
                .Some(found) =>
                    if found != value:
                        return false
                .None => return false
        true

impl[T < Ord] Ord for List[T]:
    fn cmp(self, other: List[T]) -> Ordering:
        let index: usize = 0
        while index < self.len() && index < other.len():
            if self[index] != other[index]:
                return self[index].cmp(other[index])
            index = index + 1
        if self.len() < other.len():
            return .Less
        if self.len() > other.len():
            return .Greater
        .Equal

impl[T < Ord] Ord for T?:
    fn cmp(self, other: T?) -> Ordering:
        match self:
            .Some(left) =>
                match other:
                    .Some(right) => left.cmp(right)
                    .None => .Greater
            .None =>
                match other:
                    .Some(_) => .Less
                    .None => .Equal

# Derived `Eq` (spec/std/cmp.md#derived-equality): `self` and `other` are
# equal when they hold the same variant and every member of `self` equals
# the same member of `other`. The walk stops at the first difference.
impl[T] Eq for T by Structure:
    fn eq(self, other: T) -> bool:
        let w: mut EqualWalker[T] = EqualWalker::[T] { other: other }
        match Structure::walk(self, w):
            .Ok(_) => true
            .Err(_) => false

# The fields are public because the prototype checks the instantiated
# walker in the deriving module. A walk's `.Err` only stops it.
data EqualWalker[S]:
    pub other: S

impl[S] Walker[S] for EqualWalker[S]:
    type Error = bool

    fn variant(mut self, v: Variant[S]) -> Result[void, bool]:
        if v.holds(self.other):
            return .Ok(())
        .Err(false)

    fn member[F < Eq](mut self, h: Field[S, F], value: F) -> Result[void, bool]:
        if value == h.get(self.other):
            return .Ok(())
        .Err(false)

# Derived `PartialOrd` and `Ord` (spec/std/cmp.md#derived-ordering):
# distinct variants compare by declaration order, and the same variant's
# members compare in declaration order until one differs. A first walk
# reads the variant index of `other`.
impl[T] PartialOrd for T by Structure:
    fn partial_cmp(self, other: T) -> Ordering?:
        let probe: mut VariantIndex[T] = VariantIndex::[T] { index: 0 }
        _ := Structure::walk(other, probe)
        let w: mut PartialOrderWalker[T] = PartialOrderWalker::[T] { other: other, other_index: probe.index, result: .Some(.Equal) }
        _ := Structure::walk(self, w)
        w.result

impl[T] Ord for T by Structure:
    fn cmp(self, other: T) -> Ordering:
        let probe: mut VariantIndex[T] = VariantIndex::[T] { index: 0 }
        _ := Structure::walk(other, probe)
        let w: mut OrderWalker[T] = OrderWalker::[T] { other: other, other_index: probe.index, result: .Equal }
        _ := Structure::walk(self, w)
        w.result

# Reads a value's variant index, then stops.
data VariantIndex[S]:
    pub index: i32

impl[S] Walker[S] for VariantIndex[S]:
    type Error = bool

    fn variant(mut self, v: Variant[S]) -> Result[void, bool]:
        self.index = v.info.index
        .Err(true)

    fn member[F](mut self, h: Field[S, F], value: F) -> Result[void, bool]:
        .Ok(())

# Holds the order once it is decided, and stops the walk.
data PartialOrderWalker[S]:
    pub other: S
    pub other_index: i32
    pub result: Ordering?

impl[S] Walker[S] for PartialOrderWalker[S]:
    type Error = bool

    fn variant(mut self, v: Variant[S]) -> Result[void, bool]:
        if v.holds(self.other):
            return .Ok(())
        if v.info.index < self.other_index:
            self.result = .Some(.Less)
        else:
            self.result = .Some(.Greater)
        .Err(true)

    # An unordered member, such as NaN, makes the values unordered
    # (r-std-cmp.derive.ord.partial).
    fn member[F < PartialOrd](mut self, h: Field[S, F], value: F) -> Result[void, bool]:
        let order = value.partial_cmp(h.get(self.other))
        match order:
            .Some(decided) =>
                match decided:
                    .Equal => return .Ok(())
                    _ => pass
            .None => pass
        self.result = order
        .Err(true)

data OrderWalker[S]:
    pub other: S
    pub other_index: i32
    pub result: Ordering

impl[S] Walker[S] for OrderWalker[S]:
    type Error = bool

    fn variant(mut self, v: Variant[S]) -> Result[void, bool]:
        if v.holds(self.other):
            return .Ok(())
        if v.info.index < self.other_index:
            self.result = .Less
        else:
            self.result = .Greater
        .Err(true)

    fn member[F < Ord](mut self, h: Field[S, F], value: F) -> Result[void, bool]:
        let order = value.cmp(h.get(self.other))
        match order:
            .Equal => return .Ok(())
            _ => pass
        self.result = order
        .Err(true)

# Tuple comparison (spec/std/cmp.md#tuple-comparison): the derived walkers,
# element by element, in order, at every size. A tuple has one variant, so
# no walk reads `other`'s variant index. A rest element compares as its
# list (r-std-cmp.tuple.rest).
impl[T < Tuple] Eq for T by Structure:
    fn eq(self, other: T) -> bool:
        let w: mut EqualWalker[T] = EqualWalker::[T] { other: other }
        match Structure::walk(self, w):
            .Ok(_) => true
            .Err(_) => false

impl[T < Tuple] PartialOrd for T by Structure:
    fn partial_cmp(self, other: T) -> Ordering?:
        let w: mut PartialOrderWalker[T] = PartialOrderWalker::[T] { other: other, other_index: 0, result: .Some(.Equal) }
        _ := Structure::walk(self, w)
        w.result

impl[T < Tuple] Ord for T by Structure:
    fn cmp(self, other: T) -> Ordering:
        let w: mut OrderWalker[T] = OrderWalker::[T] { other: other, other_index: 0, result: .Equal }
        _ := Structure::walk(self, w)
        w.result

# `Debug` for this module's public types (r-std-format.debug.std-types),
# written by hand with the builder calls that `@derive(Debug)` generates
# (r-std-format.debug.derive-builders.mapping): the prototype runs the
# derivation pass before it joins std (src/checker/program.ts), so a
# `@derive` on a std declaration has no effect.

impl Debug for Ordering:
    fn debug(self, out: mut DebugWriter) -> void:
        match self:
            .Less => out.write("Less")
            .Equal => out.write("Equal")
            .Greater => out.write("Greater")

impl[T < Debug] Debug for Reverse[T]:
    fn debug(self, out: mut DebugWriter) -> void:
        out.debug_struct("Reverse").field("value", self.value).finish()
