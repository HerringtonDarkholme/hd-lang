# std.hash: `Hash` and `Hasher` (spec/lang/09-traits.md#hashing). Only
# `Hash` is a prelude name. The standard implementations write the bytes that
# spec/std/hash.md#bytes-written gives: an integer its little-endian bytes
# at its own width, a `bool` one byte, a `char` its scalar as a `u32`, a
# string or a list its length as a `u64` and then its contents, and an
# optional or a result a tag byte and then its payload. `DefaultHasher` is
# 64-bit FNV-1a, and `hash_of` hashes a value into a new one
# (spec/std/hash.md#default-hasher).
use std.annotation.inline
use std.function.Tuple
use std.structure.{Structure, UnionType, Walker, Variant, Field}
use std.rt.bytes.{bytes_len, bytes_at, char_scalar}
use std.rt.memory.{load_u32, load_u64, string_bytes}

# `Hash` and `Hasher` are declared in std.core, which `Map` names.
pub use std.core.{Hash, Hasher}

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for string:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(bytes_len(*self)))
        state.write_str(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for char:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        char_scalar(*self).hash(state)

# An optional writes the tag byte 0 for `.None`, or 1 and then its payload.
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < ?Copy & Hash] Hash for T?:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        match self:
            .None => state.write_u8(0)
            .Some(value) =>
                state.write_u8(1)
                value.hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for *T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for *mut T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for &T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < ?Copy & Hash] Hash for &mut T:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        (*(*self)).hash(state)

# A result writes the tag byte 0 and then its `.Ok` payload, or 1 and then
# its `.Err` payload (spec/std/hash.md#r-std-hash.bytes.result).
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < ?Copy & Hash, E < ?Copy & Hash] Hash for Result[T, E]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        match self:
            .Ok(value) =>
                state.write_u8(0)
                value.hash(state)
            .Err(error) =>
                state.write_u8(1)
                error.hash(state)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for bool:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let byte: u8 = 0
        if *self:
            byte = 1
        state.write_u8(byte)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i8:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i8(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i16:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i16(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i32:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i32(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i64:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_i64(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u8:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u8(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u16:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u16(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u32:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u32(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for usize:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_usize(*self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u64:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(*self)

# A list hashes its length as a `u64`, then each item in order
# (spec/std/hash.md#list-hashing), so equal lists hash the same.
# Keep handwritten Hash: hash the logical length and entries, not backing storage.
impl[T < Hash] Hash for List[T]:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        state.write_u64(u64(self.len()))
        for item in self:
            item.hash(state)

# The standard `Hasher`: 64-bit FNV-1a with no seed
# (r-std-hash.default.algorithm, r-std-hash.default.fixed). The state
# starts at the FNV offset basis `0xcbf29ce484222325`.
## The standard hasher: 64-bit FNV-1a over the bytes written to it.
## See [std-hash.default.declarations](../../spec/std/hash.md#r-std-hash.default.declarations).
@derive(Debug)
pub struct DefaultHasher:
    state: u64

impl DefaultHasher:
    ## Returns a fresh hasher value whose state is the FNV offset basis.
    ## See [std-hash.default.new-value](../../spec/std/hash.md#r-std-hash.default.new-value).
    pub fn new() -> DefaultHasher:
        DefaultHasher { state: 14695981039346656037 }

    # The state, unchanged (r-std-hash.default.finish).
    ## The hash of the bytes written so far.
    ## See [std-hash.default.finish](../../spec/std/hash.md#r-std-hash.default.finish).
    pub fn finish(self) -> u64:
        self.state

# Each byte is XORed in, then the state is multiplied by the FNV prime
# `0x100000001b3` modulo 2^64, so two writes equal one write of both lists
# (r-std-hash.default.write). The prime is 256 * 2^32 + 435, and the
# state is split into 32-bit halves, so no intermediate product overflows
# the checked `u64` arithmetic.
# One FNV-1a step on the state.
fn fnv_mix(state: u64, byte: u8) -> u64:
    let mask: u64 = 4294967295
    mixed := state ^ u64(byte)
    low := mixed & mask
    low_product := low * 435
    middle := (low * 256 + (mixed >> 32) * 435 + (low_product >> 32)) & mask
    (middle << 32) | (low_product & mask)

# Each method mixes into a local and stores the state once, so a write
# through the reference happens once per call, not once per byte.
impl DefaultHasher:
    fn write_integer(&mut self, value: u64, width: usize) -> void:
        let state = self.state
        let rest = value
        let index: usize = 0
        while index < width:
            state = fnv_mix(state, u8(rest & 255))
            rest = rest >> 8
            index = index + 1
        self.state = state

impl Hasher for DefaultHasher:
    fn write(&mut self, bytes: List[u8]) -> void:
        let state = self.state
        for byte in bytes:
            state = fnv_mix(state, byte)
        self.state = state

    fn write_u8(&mut self, value: u8) -> void:
        self.write_integer(u64(value), 1)

    fn write_u16(&mut self, value: u16) -> void:
        self.write_integer(u64(value), 2)

    fn write_u32(&mut self, value: u32) -> void:
        self.write_integer(u64(value), 4)

    fn write_u64(&mut self, value: u64) -> void:
        self.write_integer(value, 8)

    fn write_usize(&mut self, value: usize) -> void:
        self.write_integer(u64(value), 4)

    fn write_i8(&mut self, value: i8) -> void:
        self.write_integer(u64(u8(value)), 1)

    fn write_i16(&mut self, value: i16) -> void:
        self.write_integer(u64(u16(value)), 2)

    fn write_i32(&mut self, value: i32) -> void:
        self.write_integer(u64(u32(value)), 4)

    fn write_i64(&mut self, value: i64) -> void:
        self.write_integer(u64(value), 8)

    # The string's bytes, read in place.
    fn write_str(&mut self, text: string) -> void:
        let state = self.state
        n := bytes_len(text)
        let index: usize = 0
        while index < n:
            state = fnv_mix(state, bytes_at(text, index))
            index = index + 1
        self.state = state

# Hashes `value` into a local `DefaultHasher` (r-std-hash.hash-of-local).
## `value`'s hash under a fresh `DefaultHasher`.
## See [std-hash.hash-of-local](../../spec/std/hash.md#r-std-hash.hash-of-local).
pub fn hash_of[T < Hash](value: T) -> u64:
    let mut hasher = DefaultHasher::new()
    value.hash(&mut hasher)
    hasher.finish()

# Derived `Hash` (spec/std/hash.md#derived-hashing): an enum's variant index
# as a `u32`, then each member in declaration order.
impl[T < ?Copy] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# Union `Hash`: the ordinary enum derivation, including the active case index.
impl[T < ?Copy & UnionType] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# The field is public because the prototype checks the instantiated walker
# in the deriving module.
struct HashWalker[S < ?Copy, H < Hasher, 'a]:
    pub state: &'a mut H

impl['a, S < ?Copy, H < Hasher] Walker[S] for HashWalker[S, H, 'a]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        if !v.info.of_data:
            u32(v.info.index).hash(&mut *self.state)
        .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Hash` here, as `member` needs `F < Hash`.
    fn rest[T < Hash](&mut self, h: Field[S, List[T]], items: &List[T]) -> Result[void, never]:
        self.member(h, items)

    fn member[F < ?Copy & Hash](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        value.hash(&mut *self.state)
        .Ok(())

# Tuple hashing (spec/std/hash.md#tuple-hashing): each element in order, at
# every size. A rest element hashes as its `List`, so a rest tuple is
# hashable when its rest's items are (r-std-hash.tuple.rest-list).
impl[T < ?Copy & Tuple] Hash for T by Structure:
    fn hash[H < Hasher](&self, state: &mut H) -> void:
        let mut w = HashWalker::[T, H] { state: state }
        _ := Structure::walk(self, &mut w)

# Equality of non-inline map keys is ordinary value equality.
fn key_equal[T < Eq](left: T, right: T) -> bool:
    left == right

# foldhash 0.2.0 fast, with its non-wide-arithmetic Wasm multiply.
# Port of Orson Peters' foldhash (2024), distributed under Zlib/Apache-2.0/MIT.
# Source: https://github.com/orlp/foldhash/tree/8f878c636fda9c9e93384824ea45e06d03f009f5/src
# Map bucket hashes use the low 32 bits (std-hash.map.foldhash-fast).
# DefaultHasher and hash_of keep their separate published FNV-1a algorithm.
# Copyright (c) 2024 Orson Peters
#
# This software is provided 'as-is', without any express or implied warranty. In
# no event will the authors be held liable for any damages arising from the use of
# this software.
#
# Permission is granted to anyone to use this software for any purpose, including
# commercial applications, and to alter it and redistribute it freely, subject to
# the following restrictions:
#
# 1. The origin of this software must not be misrepresented; you must not claim
#     that you wrote the original software. If you use this software in a product,
#     an acknowledgment in the product documentation would be appreciated but is
#     not required.
#
# 2. Altered source versions must be plainly marked as such, and must not be
#     misrepresented as being the original software.
#
# 3. This notice may not be removed or altered from any source distribution.

@inline(.Always)
fn fold_seed0() -> u64:
    13883517620612518109u64
@inline(.Always)
fn fold_seed1() -> u64:
    4577018097722394903u64
@inline(.Always)
fn fold_seed2() -> u64:
    10526836309316205339u64
@inline(.Always)
fn fold_seed3() -> u64:
    15073842237943035308u64
@inline(.Always)
fn fold_seed4() -> u64:
    3458046377305235383u64
@inline(.Always)
fn fold_seed5() -> u64:
    13322122606961655446u64

# Four 32 x 32 products, so none overflows even in checked arithmetic.
# This deliberately matches foldhash's Wasm approximation, not u128 mul.
@inline(.Always)
fn folded_multiply(x: u64, y: u64) -> u64:
    mask := 4294967295u64
    lx := x & mask
    ly := y & mask
    hx := x >> 32
    hy := y >> 32
    ll := lx * ly
    lh := lx * hy
    hl := hx * ly
    hh := hx * hy
    cross := hl ^ lh
    (hh ^ ll) ^ ((cross >> 32) | (cross << 32))

fn rotate_right(value: u64, count: usize) -> u64:
    shift := count & 63
    if shift == 0:
        return value
    (value >> shift) | (value << (64 - shift))

# The only wrapping additions in the algorithm initialize parallel lanes.
# Two 32-bit halves avoid checked u64 overflow without another intrinsic.
fn add_wrapping(left: u64, right: u64) -> u64:
    mask := 4294967295u64
    lo := (left & mask) + (right & mask)
    hi := ((left >> 32) + (right >> 32) + (lo >> 32)) & mask
    (hi << 32) | (lo & mask)

# Both concrete inputs are read in place. The generic helpers have two
# static instances: strings use unaligned word loads; byte lists index
# their existing buffer. No conversion or copied input buffer is needed.
trait HashBytes:
    fn size(&self) -> usize
    fn byte(&self, at: usize) -> u64
    fn word4(&self, at: usize) -> u64
    fn word8(&self, at: usize) -> u64

impl HashBytes for string:
    fn size(&self) -> usize:
        bytes_len(*self)
    fn byte(&self, at: usize) -> u64:
        u64(bytes_at(*self, at))
    fn word4(&self, at: usize) -> u64:
        u64(load_u32(string_bytes(*self).address + at))
    fn word8(&self, at: usize) -> u64:
        load_u64(string_bytes(*self).address + at)

impl HashBytes for List[u8]:
    fn size(&self) -> usize:
        self.len()
    fn byte(&self, at: usize) -> u64:
        u64(self[at])
    fn word4(&self, at: usize) -> u64:
        (
            u64(self[at])
            | (u64(self[at + 1]) << 8)
            | (u64(self[at + 2]) << 16)
            | (u64(self[at + 3]) << 24)
        )
    fn word8(&self, at: usize) -> u64:
        self.word4(at) | (self.word4(at + 4) << 32)

fn hash_bytes_short[B < HashBytes](bytes: &B, accumulator: u64) -> u64:
    size := bytes.size()
    let s0 = accumulator
    let s1 = fold_seed1()
    if size >= 8:
        s0 = s0 ^ bytes.word8(0)
        s1 = s1 ^ bytes.word8(size - 8)
    else if size >= 4:
        s0 = s0 ^ bytes.word4(0)
        s1 = s1 ^ bytes.word4(size - 4)
    else if size > 0:
        s0 = s0 ^ bytes.byte(0)
        s1 = s1 ^ ((bytes.byte(size - 1) << 8) | bytes.byte(size / 2))
    folded_multiply(s0, s1)

# Each loop consumes at least 64 bytes; the overlapping final reads stay
# within the remaining span. This is O(n) time and O(1) auxiliary space.
fn hash_bytes_long[B < HashBytes](bytes: &B, accumulator: u64) -> u64:
    let start: usize = 0
    let size = bytes.size()
    let s0 = accumulator
    let s1 = add_wrapping(s0, fold_seed1())
    if size > 128:
        let s2 = add_wrapping(s0, fold_seed2())
        let s3 = add_wrapping(s0, fold_seed3())
        if size > 256:
            let s4 = add_wrapping(s0, fold_seed4())
            let s5 = add_wrapping(s0, fold_seed5())
            while true:
                s0 = folded_multiply(
                    bytes.word8(start) ^ s0,
                    bytes.word8(start + 48) ^ fold_seed0(),
                )
                s1 = folded_multiply(
                    bytes.word8(start + 8) ^ s1,
                    bytes.word8(start + 56) ^ fold_seed0(),
                )
                s2 = folded_multiply(
                    bytes.word8(start + 16) ^ s2,
                    bytes.word8(start + 64) ^ fold_seed0(),
                )
                s3 = folded_multiply(
                    bytes.word8(start + 24) ^ s3,
                    bytes.word8(start + 72) ^ fold_seed0(),
                )
                s4 = folded_multiply(
                    bytes.word8(start + 32) ^ s4,
                    bytes.word8(start + 80) ^ fold_seed0(),
                )
                s5 = folded_multiply(
                    bytes.word8(start + 40) ^ s5,
                    bytes.word8(start + 88) ^ fold_seed0(),
                )
                start += 96
                size -= 96
                if size <= 256:
                    break
            s0 = s0 ^ s4
            s1 = s1 ^ s5
        while true:
            s0 = folded_multiply(bytes.word8(start) ^ s0, bytes.word8(start + 32) ^ fold_seed0())
            s1 = folded_multiply(
                bytes.word8(start + 8) ^ s1,
                bytes.word8(start + 40) ^ fold_seed0(),
            )
            s2 = folded_multiply(
                bytes.word8(start + 16) ^ s2,
                bytes.word8(start + 48) ^ fold_seed0(),
            )
            s3 = folded_multiply(
                bytes.word8(start + 24) ^ s3,
                bytes.word8(start + 56) ^ fold_seed0(),
            )
            start += 64
            size -= 64
            if size <= 128:
                break
        s0 = s0 ^ s2
        s1 = s1 ^ s3
    s0 = folded_multiply(bytes.word8(start) ^ s0, bytes.word8(start + size - 16) ^ fold_seed0())
    s1 = folded_multiply(bytes.word8(start + 8) ^ s1, bytes.word8(start + size - 8) ^ fold_seed0())
    if size >= 32:
        s0 = folded_multiply(
            bytes.word8(start + 16) ^ s0,
            bytes.word8(start + size - 32) ^ fold_seed0(),
        )
        s1 = folded_multiply(
            bytes.word8(start + 24) ^ s1,
            bytes.word8(start + size - 24) ^ fold_seed0(),
        )
        if size >= 64:
            s0 = folded_multiply(
                bytes.word8(start + 32) ^ s0,
                bytes.word8(start + size - 48) ^ fold_seed0(),
            )
            s1 = folded_multiply(
                bytes.word8(start + 40) ^ s1,
                bytes.word8(start + size - 40) ^ fold_seed0(),
            )
            if size >= 96:
                s0 = folded_multiply(
                    bytes.word8(start + 48) ^ s0,
                    bytes.word8(start + size - 64) ^ fold_seed0(),
                )
                s1 = folded_multiply(
                    bytes.word8(start + 56) ^ s1,
                    bytes.word8(start + size - 56) ^ fold_seed0(),
                )
    s0 ^ s1

fn hash_bytes[B < HashBytes](bytes: &B, accumulator: u64) -> u64:
    size := bytes.size()
    rotated := rotate_right(accumulator, size)
    if size <= 16: hash_bytes_short(bytes, rotated) else: hash_bytes_long(bytes, rotated)

struct FoldHasher:
    accumulator: u64
    low: u64
    high: u64
    bits: usize

impl FoldHasher:
    @inline(.Always)
    fn new(seed: u64) -> FoldHasher:
        FoldHasher { accumulator: seed, low: 0, high: 0, bits: 0 }

    # hd Hash names one byte stream, independent of write boundaries.
    # Pack that stream into fixed 16-byte blocks before foldhash mixing.
    # A crossing typed word fills the old block and carries its suffix;
    # this is equivalent to upstream FoldHasher.write_u8 for every byte.
    @inline(.Always)
    fn write_num(&mut self, value: u64, width: usize) -> void:
        let h = *self
        let low = h.low
        let high = h.high
        let bits = h.bits
        let accumulator = h.accumulator
        if bits == 128:
            accumulator = folded_multiply(low ^ accumulator, high ^ fold_seed0())
            low = 0
            high = 0
            bits = 0
        if bits + width > 128:
            remaining := 128 - bits
            high = high | (value << (bits - 64))
            accumulator = folded_multiply(low ^ accumulator, high ^ fold_seed0())
            low = value >> remaining
            high = 0
            bits = width - remaining
        else:
            if bits < 64:
                low = low | (value << bits)
                if bits + width > 64:
                    high = high | (value >> (64 - bits))
            else:
                high = high | (value << (bits - 64))
            bits += width
        *self = FoldHasher { accumulator: accumulator, low: low, high: high, bits: bits }

    # Word reads preserve the input's little-endian byte order, with at
    # most seven individual bytes at the end. Zero-byte writes do nothing.
    # This is O(n) time, O(1) state, and never buffers or replays Hash.
    @inline(.Always)
    fn write_bytes[B < HashBytes](&mut self, bytes: &B) -> void:
        size := bytes.size()
        let index: usize = 0
        while size - index >= 8:
            self.write_num(bytes.word8(index), 64)
            index += 8
        while index < size:
            self.write_num(bytes.byte(index), 8)
            index += 1

    @inline(.Always)
    fn finish(self) -> u64:
        if self.bits == 0:
            self.accumulator
        else:
            folded_multiply(self.low ^ self.accumulator, self.high ^ fold_seed0())

impl Hasher for FoldHasher:
    @inline(.Always)
    fn write(&mut self, bytes: List[u8]) -> void:
        self.write_bytes(&bytes)
    @inline(.Always)
    fn write_str(&mut self, text: string) -> void:
        self.write_bytes(&text)
    @inline(.Always)
    fn write_u8(&mut self, value: u8) -> void:
        self.write_num(u64(value), 8)
    @inline(.Always)
    fn write_u16(&mut self, value: u16) -> void:
        self.write_num(u64(value), 16)
    @inline(.Always)
    fn write_u32(&mut self, value: u32) -> void:
        self.write_num(u64(value), 32)
    @inline(.Always)
    fn write_u64(&mut self, value: u64) -> void:
        self.write_num(value, 64)
    @inline(.Always)
    fn write_usize(&mut self, value: usize) -> void:
        self.write_num(u64(value), 32)
    @inline(.Always)
    fn write_i8(&mut self, value: i8) -> void:
        self.write_num(u64(u8(value)), 8)
    @inline(.Always)
    fn write_i16(&mut self, value: i16) -> void:
        self.write_num(u64(u16(value)), 16)
    @inline(.Always)
    fn write_i32(&mut self, value: i32) -> void:
        self.write_num(u64(u32(value)), 32)
    @inline(.Always)
    fn write_i64(&mut self, value: i64) -> void:
        self.write_num(u64(value), 64)

# A single numeric key has one typed word in an otherwise empty sponge.
pub fn hash_integer(value: u64, seed: u64) -> u32:
    u32(folded_multiply(value ^ seed, fold_seed0()))

# Strings use the fast byte path, without allocating an intermediate list.
pub fn hash_string(value: string, seed: u64) -> u32:
    u32(hash_bytes(&value, seed))

# General hd Hash byte streams use canonical 16-byte foldhash sponge blocks.
pub fn hash_key[T < Hash](value: T, seed: u64) -> u32:
    let mut hasher = FoldHasher::new(seed)
    value.hash(&mut hasher)
    u32(hasher.finish())
