# std.hash: `Hash` and `Hasher` (spec/lang/09-traits.md#hashing). Only
# `Hash` is a prelude name. The standard implementations write the bytes that
# spec/std/hash.md#bytes-written gives: an integer its little-endian bytes
# at its own width, a `bool` one byte, a `char` its scalar as a `u32`, a
# string or a list its length as a `u64` and then its contents, and an
# optional or a result a tag byte and then its payload. `DefaultHasher` is
# 64-bit FNV-1a, and `hash_of` hashes a value into a new one
# (spec/std/hash.md#default-hasher).
use std.function.Tuple
use std.structure.{Structure, Walker, Variant, Field}

## A sink that hashes the bytes written to it; its methods change it, so a hasher is passed as `&mut dyn Hasher`.
## See [trait.hash.ref-receiver](../../spec/lang/09-traits.md#r-trait.hash.ref-receiver).
pub trait Hasher:
    fn write(&mut self, bytes: List[u8]) -> void

    ## Writes the byte `value`.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u8(&mut self, value: u8) -> void:
        self.write([value])

    ## Writes the 2 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u16(&mut self, value: u16) -> void:
        self.write(unsigned_bytes(u64(value), 2))

    ## Writes the 4 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u32(&mut self, value: u32) -> void:
        self.write(unsigned_bytes(u64(value), 4))

    ## Writes the 8 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_u64(&mut self, value: u64) -> void:
        self.write(unsigned_bytes(value, 8))

    ## Writes the 4 little-endian bytes of `value`.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_usize(&mut self, value: usize) -> void:
        self.write(unsigned_bytes(u64(value), 4))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i8(&mut self, value: i8) -> void:
        self.write_u8(u8(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i16(&mut self, value: i16) -> void:
        self.write_u16(u16(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i32(&mut self, value: i32) -> void:
        self.write_u32(u32(value))

    ## Writes the two's-complement bytes of `value` at its width.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_i64(&mut self, value: i64) -> void:
        self.write_u64(u64(value))

    ## Writes the UTF-8 bytes of `text`, with no length, as `write` would.
    ## See [trait.hash.typed-methods](../../spec/lang/09-traits.md#r-trait.hash.typed-methods).
    fn write_str(&mut self, text: string) -> void:
        self.write(text.to_utf8())

## A type whose values write their hash bytes to a `Hasher`; a map key needs it with `Eq`.
## See [trait.hash.module](../../spec/lang/09-traits.md#r-trait.hash.module).
pub trait Hash:
    fn hash(self, state: &mut dyn Hasher) -> void

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for string:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u64(u64(bytes_len(self)))
        state.write_str(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for char:
    fn hash(self, state: &mut dyn Hasher) -> void:
        char_scalar(self).hash(state)

# An optional writes the tag byte 0 for `.None`, or 1 and then its payload.
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < Hash] Hash for T?:
    fn hash(self, state: &mut dyn Hasher) -> void:
        match self:
            .None => state.write_u8(0)
            .Some(value) =>
                state.write_u8(1)
                value.hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < Hash] Hash for *T:
    fn hash(self, state: &mut dyn Hasher) -> void:
        (*self).hash(state)

# Keep handwritten Hash: delegate through the reference; structural derivation is for its referent.
impl[T < Hash] Hash for *mut T:
    fn hash(self, state: &mut dyn Hasher) -> void:
        (*self).hash(state)

# A result writes the tag byte 0 and then its `.Ok` payload, or 1 and then
# its `.Err` payload (spec/std/hash.md#r-std-hash.bytes.result).
# Keep handwritten Hash: keep one-byte variant tags instead of structural tag hashing.
impl[T < Hash, E < Hash] Hash for Result[T, E]:
    fn hash(self, state: &mut dyn Hasher) -> void:
        match self:
            .Ok(value) =>
                state.write_u8(0)
                value.hash(state)
            .Err(error) =>
                state.write_u8(1)
                error.hash(state)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for bool:
    fn hash(self, state: &mut dyn Hasher) -> void:
        let byte: u8 = 0
        if self:
            byte = 1
        state.write_u8(byte)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i8:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_i8(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i16:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_i16(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i32:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_i32(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for i64:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_i64(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u8:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u8(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u16:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u16(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u32:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u32(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for usize:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_usize(self)

# Keep handwritten Hash: implement the builtin scalar protocol, which has no derivable declaration.
impl Hash for u64:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u64(self)

# A list hashes its length as a `u64`, then each item in order
# (spec/std/hash.md#list-hashing), so equal lists hash the same.
# Keep handwritten Hash: hash the logical length and entries, not backing storage.
impl[T < Hash] Hash for List[T]:
    fn hash(self, state: &mut dyn Hasher) -> void:
        state.write_u64(u64(self.len()))
        for item in self:
            item.hash(state)

fn unsigned_bytes(value: u64, count: usize) -> List[u8]:
    let mut bytes: List[u8] = []
    let rest = value
    let index: usize = 0
    while index < count:
        bytes.push(u8(rest & 255))
        rest = rest >> 8
        index = index + 1
    bytes

# The standard `Hasher`: 64-bit FNV-1a with no seed
# (r-std-hash.default.algorithm, r-std-hash.default.fixed). The state
# starts at the FNV offset basis `0xcbf29ce484222325`.
## The standard hasher: 64-bit FNV-1a over the bytes written to it.
## See [std-hash.default.decl-struct](../../spec/std/hash.md#r-std-hash.default.decl-struct).
@derive(Debug)
pub struct DefaultHasher:
    state: u64

impl DefaultHasher:
    # A new object, so `value.hash(hasher)` changes the one hasher that
    # `finish` then reads (r-std-hash.default.new-ref).
    ## Returns a fresh hasher, a new object that `value.hash` and `finish` share.
    ## See [std-hash.default.new-ref](../../spec/std/hash.md#r-std-hash.default.new-ref).
    pub fn new() -> *mut DefaultHasher:
        &mut DefaultHasher { state: 14695981039346656037 }

    # The state, unchanged (r-std-hash.default.finish).
    ## The hash of the bytes written so far.
    ## See [std-hash.default.finish](../../spec/std/hash.md#r-std-hash.default.finish).
    pub fn finish(self) -> u64:
        self.state

# Each byte is XORed in, then the state is multiplied by the FNV prime
# `0x100000001b3` modulo 2^64, so two writes equal one write of both lists
# (r-std-hash.default.write). The prime is 256 * 2^32 + 435, and the
# state is split into 32-bit halves, so no intermediate product overflows
# the checked `u64` arithmetic.
# One FNV-1a step on the state.
fn fnv_mix(state: u64, byte: u8) -> u64:
    let mask: u64 = 4294967295
    mixed := state ^ u64(byte)
    low := mixed & mask
    low_product := low * 435
    middle := (low * 256 + (mixed >> 32) * 435 + (low_product >> 32)) & mask
    (middle << 32) | (low_product & mask)

# Each method mixes into a local and stores the state once, so a write
# through the reference happens once per call, not once per byte.
impl DefaultHasher:
    fn write_integer(&mut self, value: u64, width: usize) -> void:
        let state = self.state
        let rest = value
        let index: usize = 0
        while index < width:
            state = fnv_mix(state, u8(rest & 255))
            rest = rest >> 8
            index = index + 1
        self.state = state

impl Hasher for DefaultHasher:
    fn write(&mut self, bytes: List[u8]) -> void:
        let state = self.state
        for byte in bytes:
            state = fnv_mix(state, byte)
        self.state = state

    fn write_u8(&mut self, value: u8) -> void:
        self.write_integer(u64(value), 1)

    fn write_u16(&mut self, value: u16) -> void:
        self.write_integer(u64(value), 2)

    fn write_u32(&mut self, value: u32) -> void:
        self.write_integer(u64(value), 4)

    fn write_u64(&mut self, value: u64) -> void:
        self.write_integer(value, 8)

    fn write_usize(&mut self, value: usize) -> void:
        self.write_integer(u64(value), 4)

    fn write_i8(&mut self, value: i8) -> void:
        self.write_integer(u64(u8(value)), 1)

    fn write_i16(&mut self, value: i16) -> void:
        self.write_integer(u64(u16(value)), 2)

    fn write_i32(&mut self, value: i32) -> void:
        self.write_integer(u64(u32(value)), 4)

    fn write_i64(&mut self, value: i64) -> void:
        self.write_integer(u64(value), 8)

    # The string's bytes, read in place.
    fn write_str(&mut self, text: string) -> void:
        let state = self.state
        n := bytes_len(text)
        let index: usize = 0
        while index < n:
            state = fnv_mix(state, bytes_at(text, index))
            index = index + 1
        self.state = state

# Hashes `value` into a new `DefaultHasher` (r-std-hash.hash-of).
## `value`'s hash under a fresh `DefaultHasher`.
## See [std-hash.hash-of](../../spec/std/hash.md#r-std-hash.hash-of).
pub fn hash_of[T < Hash](value: T) -> u64:
    hasher := DefaultHasher::new()
    value.hash(hasher)
    hasher.finish()

# Derived `Hash` (spec/std/hash.md#derived-hashing): an enum's variant index
# as a `u32`, then each member in declaration order.
impl[T] Hash for T by Structure:
    fn hash(self, state: *mut dyn Hasher) -> void:
        let mut w = HashWalker::[T] { state: state }
        _ := Structure::walk(self, &mut w)

# The field is public because the prototype checks the instantiated walker
# in the deriving module.
struct HashWalker[S]:
    pub state: *mut dyn Hasher

impl[S] Walker[S] for HashWalker[S]:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        if !v.info.of_data:
            u32(v.info.index).hash(self.state)
        .Ok(())

    # A rest member is one `List[T]` member (annot.walk.rest.default),
    # which needs `T < Hash` here, as `member` needs `F < Hash`.
    fn rest[T < Hash](&mut self, h: Field[S, List[T]], items: List[T]) -> Result[void, never]:
        self.member(h, items)

    fn member[F < Hash](&mut self, h: Field[S, F], value: F) -> Result[void, never]:
        value.hash(self.state)
        .Ok(())

# Tuple hashing (spec/std/hash.md#tuple-hashing): each element in order, at
# every size. A rest element hashes as its `List`, so a rest tuple is
# hashable when its rest's items are (r-std-hash.tuple.rest-list).
impl[T < Tuple] Hash for T by Structure:
    fn hash(self, state: *mut dyn Hasher) -> void:
        let mut w = HashWalker::[T] { state: state }
        _ := Structure::walk(self, &mut w)

# The keyed hasher the built-in `Map` buckets its keys by
# (r-std-hash.map.bucket-hash): HalfSipHash-1-3, the 32-bit-lane SipHash,
# keyed by the run's 64-bit seed, so keys that collide cannot be chosen
# without the seed. A key that is not an integer or a string writes its
# `Hash` bytes to one (`key_bucket_hash`); a string key gets the same
# digest of its bytes without a copy (`string_bucket_hash`). An integer
# key takes a cheaper keyed mix of its bits (`int_bucket_hash`), since
# this hasher would cost twice the map operation. Each lane lives in a
# `u64`, masked after each step: the sum of two lanes never overflows, so
# the same code runs in a debug build, where `+` checks, and in a release
# build. SipHash-1-3's 64-bit lanes would need a wrapping `u64` addition,
# which std can only build from 32-bit halves today; that measures 2.5
# times slower on short keys. A message word is four bytes,
# little-endian; the last word holds the leftover bytes, with the
# length's low byte on top. One round per word, then three.
struct BucketHasher:
    v0: u64
    v1: u64
    v2: u64
    v3: u64
    # The bytes of the word being filled, little-endian.
    word: u64
    # The bytes written so far.
    count: usize

# The hasher is a value: each step computes in locals and builds the next
# value once, since a struct value is rebuilt on every field write.
impl BucketHasher:
    fn new() -> BucketHasher:
        seed := map_hash_seed()
        v0 := seed & 4294967295
        v1 := seed >> 32
        BucketHasher { v0: v0, v1: v1, v2: v0 ^ 1819895653, v3: v1 ^ 1952801890, word: 0, count: 0 }

    fn write_integer(&mut self, value: u64, width: usize) -> void:
        let h = *self
        let word = h.word
        let count = h.count
        let rest = value
        let index: usize = 0
        while index < width:
            word = word | ((rest & 255) << ((count & 3) * 8))
            count += 1
            if count & 3 == 0:
                h = h.absorb(word)
                word = 0
            rest = rest >> 8
            index += 1
        *self = BucketHasher { v0: h.v0, v1: h.v1, v2: h.v2, v3: h.v3, word: word, count: count }

    # The lanes after one full message word, with the word emptied.
    fn absorb(self, m: u64) -> BucketHasher:
        lanes := sip_round(self.v0, self.v1, self.v2, self.v3 ^ m)
        BucketHasher {
            v0: lanes._0 ^ m,
            v1: lanes._1,
            v2: lanes._2,
            v3: lanes._3,
            word: 0,
            count: self.count,
        }

    # The last word, then the three finishing rounds.
    fn finish(self) -> u32:
        last := self.absorb(self.word | (u64(self.count & 255) << 24))
        let lanes = sip_round(last.v0, last.v1, last.v2 ^ 255, last.v3)
        lanes = sip_round(lanes._0, lanes._1, lanes._2, lanes._3)
        lanes = sip_round(lanes._0, lanes._1, lanes._2, lanes._3)
        u32(lanes._1 ^ lanes._3)

# The four lanes after one SipRound.
fn sip_round(a: u64, b: u64, c: u64, d: u64) -> (u64, u64, u64, u64):
    mask := u64(4294967295)
    let v0 = a
    let v1 = b
    let v2 = c
    let v3 = d
    v0 = (v0 + v1) & mask
    v1 = ((v1 << 5) | (v1 >> 27)) & mask
    v1 = v1 ^ v0
    v0 = ((v0 << 16) | (v0 >> 16)) & mask
    v2 = (v2 + v3) & mask
    v3 = ((v3 << 8) | (v3 >> 24)) & mask
    v3 = v3 ^ v2
    v0 = (v0 + v3) & mask
    v3 = ((v3 << 7) | (v3 >> 25)) & mask
    v3 = v3 ^ v0
    v2 = (v2 + v1) & mask
    v1 = ((v1 << 13) | (v1 >> 19)) & mask
    v1 = v1 ^ v2
    v2 = ((v2 << 16) | (v2 >> 16)) & mask
    (v0, v1, v2, v3)

# The word and the count stay in locals; the lanes change once a word fills.
impl Hasher for BucketHasher:
    fn write(&mut self, bytes: List[u8]) -> void:
        let h = *self
        let word = h.word
        let count = h.count
        for byte in bytes:
            word = word | (u64(byte) << ((count & 3) * 8))
            count = count + 1
            if count & 3 == 0:
                h = h.absorb(word)
                word = 0
        *self = BucketHasher { v0: h.v0, v1: h.v1, v2: h.v2, v3: h.v3, word: word, count: count }

    fn write_u8(&mut self, value: u8) -> void:
        self.write_integer(u64(value), 1)

    fn write_u16(&mut self, value: u16) -> void:
        self.write_integer(u64(value), 2)

    fn write_u32(&mut self, value: u32) -> void:
        self.write_integer(u64(value), 4)

    fn write_u64(&mut self, value: u64) -> void:
        self.write_integer(value, 8)

    fn write_usize(&mut self, value: usize) -> void:
        self.write_integer(u64(value), 4)

    fn write_i8(&mut self, value: i8) -> void:
        self.write_integer(u64(u8(value)), 1)

    fn write_i16(&mut self, value: i16) -> void:
        self.write_integer(u64(u16(value)), 2)

    fn write_i32(&mut self, value: i32) -> void:
        self.write_integer(u64(u32(value)), 4)

    fn write_i64(&mut self, value: i64) -> void:
        self.write_integer(u64(value), 8)

    fn write_str(&mut self, text: string) -> void:
        let h = *self
        let word = h.word
        let count = h.count
        let index: usize = 0
        size := bytes_len(text)
        while index < size:
            word = word | (u64(bytes_at(text, index)) << ((count & 3) * 8))
            count += 1
            if count & 3 == 0:
                h = h.absorb(word)
                word = 0
            index += 1
        *self = BucketHasher { v0: h.v0, v1: h.v1, v2: h.v2, v3: h.v3, word: word, count: count }

# The bucket hash of a key that is not an integer or a string: its `Hash`
# bytes under a fresh `BucketHasher`.
fn key_bucket_hash[T < Hash](value: T) -> u32:
    let mut hasher = BucketHasher::new()
    value.hash(&mut hasher)
    hasher.finish()

# The bucket hash of an integer, `bool` or `char` key, given its bits:
# the keyed mix Go's runtime hashes an 8-byte key by on 32-bit platforms
# (`memhash64Fallback`), three 32 x 32 -> 64-bit products, with the seed's
# halves as Go's secret `hashkey` words. No product overflows a `u64`, so
# a debug build's check never fires.
fn int_bucket_hash(value: u64) -> u32:
    mask := u64(4294967295)
    seed := map_hash_seed()
    k1 := seed & mask
    k2 := seed >> 32
    let c = k1 * (k2 ^ 8)
    let a = (c & mask) ^ (value & mask)
    let b = (c >> 32) ^ (value >> 32)
    c = (a ^ k1) * (b ^ k2)
    a = c & mask
    b = c >> 32
    c = (a ^ k1) * (b ^ k2)
    u32((c & mask) ^ (c >> 32))

# The bucket hash of a string key: the `BucketHasher` digest of its bytes,
# read in place, with the lanes in locals. Feeding a `BucketHasher`
# instead measures 15 to 25 percent slower on short keys, since each round
# then reads and writes the hasher's fields.
fn string_bucket_hash(key: string) -> u32:
    mask := u64(4294967295)
    seed := map_hash_seed()
    let v0 = seed & mask
    let v1 = seed >> 32
    let v2 = v0 ^ 1819895653
    let v3 = v1 ^ 1952801890
    n := bytes_len(key)
    let i: usize = 0
    let last = false
    while !last:
        let m: u64 = 0
        if i + 4 <= n:
            m = (
                u64(bytes_at(key, i))
                | (u64(bytes_at(key, i + 1)) << 8)
                | (u64(bytes_at(key, i + 2)) << 16)
                | (u64(bytes_at(key, i + 3)) << 24)
            )
            i = i + 4
        else:
            m = u64(n & 255) << 24
            rest := n - i
            if rest > 0:
                m = m | u64(bytes_at(key, i))
                if rest > 1:
                    m = m | (u64(bytes_at(key, i + 1)) << 8)
                    if rest > 2:
                        m = m | (u64(bytes_at(key, i + 2)) << 16)
            last = true
        v3 = v3 ^ m
        v0 = (v0 + v1) & mask
        v1 = ((v1 << 5) | (v1 >> 27)) & mask
        v1 = v1 ^ v0
        v0 = ((v0 << 16) | (v0 >> 16)) & mask
        v2 = (v2 + v3) & mask
        v3 = ((v3 << 8) | (v3 >> 24)) & mask
        v3 = v3 ^ v2
        v0 = (v0 + v3) & mask
        v3 = ((v3 << 7) | (v3 >> 25)) & mask
        v3 = v3 ^ v0
        v2 = (v2 + v1) & mask
        v1 = ((v1 << 13) | (v1 >> 19)) & mask
        v1 = v1 ^ v2
        v2 = ((v2 << 16) | (v2 >> 16)) & mask
        v0 = v0 ^ m
    v2 = v2 ^ 255
    let r = +0
    while r < 3:
        v0 = (v0 + v1) & mask
        v1 = ((v1 << 5) | (v1 >> 27)) & mask
        v1 = v1 ^ v0
        v0 = ((v0 << 16) | (v0 >> 16)) & mask
        v2 = (v2 + v3) & mask
        v3 = ((v3 << 8) | (v3 >> 24)) & mask
        v3 = v3 ^ v2
        v0 = (v0 + v3) & mask
        v3 = ((v3 << 7) | (v3 >> 25)) & mask
        v3 = v3 ^ v0
        v2 = (v2 + v1) & mask
        v1 = ((v1 << 13) | (v1 >> 19)) & mask
        v1 = v1 ^ v2
        v2 = ((v2 << 16) | (v2 >> 16)) & mask
        r = r + 1
    u32(v1 ^ v3)

# The run's 64-bit map hash key: the host draws it at random once per run,
# and a REPL session's journal records it, so a replay hashes alike.
@intrinsic("map_hash_seed")
fn map_hash_seed() -> u64:
    panic("intrinsic")

# A string's bytes, read in place.
@intrinsic("bytes_len")
fn bytes_len(text: string) -> usize:
    panic("intrinsic")

# The byte at offset `index`, which must be below `bytes_len(text)`.
@intrinsic("bytes_at")
fn bytes_at(text: string, index: usize) -> u8:
    panic("intrinsic")

# A `char` is its scalar value at run time
# (spec/std/README.md#standard-library-primitives).
@intrinsic("char_scalar")
fn char_scalar(value: char) -> u32:
    panic("intrinsic")
