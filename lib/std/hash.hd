# std.hash: `Hash` and `Hasher` (spec/09-traits.md#hashing), both prelude
# names. The standard implementations feed a value's bytes to the hasher:
# a string its UTF-8 bytes, an integer its little-endian bytes at its own
# width, and a `bool` one byte. The specification names no standard hasher
# yet, so none is declared here.
use std.text.{byte_at, byte_len}
use std.function.Tuple
use std.structure.{Structure, Walker, Variant, Field}

pub trait Hasher:
    fn write(mut self, bytes: List[u8]) -> void

pub trait Hash:
    fn hash(self, state: mut Hasher) -> void

impl Hash for string:
    fn hash(self, state: mut Hasher) -> void:
        let bytes: mut List[u8] = []
        let index = 0
        while index < byte_len(self):
            bytes.append(u8(byte_at(self, index)))
            index = index + 1
        state.write(bytes)

# A `char` hashes as the one-scalar string of its UTF-8 bytes.
impl Hash for char:
    fn hash(self, state: mut Hasher) -> void:
        "${self}".hash(state)

impl Hash for bool:
    fn hash(self, state: mut Hasher) -> void:
        let byte: u8 = 0
        if self:
            byte = 1
        state.write([byte])

impl Hash for i8:
    fn hash(self, state: mut Hasher) -> void:
        state.write(signed_bytes(self, 1))

impl Hash for i16:
    fn hash(self, state: mut Hasher) -> void:
        state.write(signed_bytes(self, 2))

impl Hash for i32:
    fn hash(self, state: mut Hasher) -> void:
        state.write(signed_bytes(self, 4))

impl Hash for i64:
    fn hash(self, state: mut Hasher) -> void:
        state.write(signed_bytes(self, 8))

impl Hash for u8:
    fn hash(self, state: mut Hasher) -> void:
        state.write([self])

impl Hash for u16:
    fn hash(self, state: mut Hasher) -> void:
        state.write(unsigned_bytes(self, 2))

impl Hash for u32:
    fn hash(self, state: mut Hasher) -> void:
        state.write(unsigned_bytes(self, 4))

impl Hash for u64:
    fn hash(self, state: mut Hasher) -> void:
        state.write(unsigned_bytes(self, 8))

# The low `count` bytes of a two's-complement value, least significant first.
fn signed_bytes(value: i64, count: i32) -> List[u8]:
    let bytes: mut List[u8] = []
    let rest = value
    let index = 0
    while index < count:
        bytes.append(u8(rest & 255))
        rest = rest >> 8
        index = index + 1
    bytes

fn unsigned_bytes(value: u64, count: i32) -> List[u8]:
    let bytes: mut List[u8] = []
    let rest = value
    let index = 0
    while index < count:
        bytes.append(u8(rest & 255))
        rest = rest >> 8
        index = index + 1
    bytes

# Derived `Hash` (spec/std/hash.md#derived-hashing): an enum's variant index
# as an `i32`, then each member in declaration order.
impl[T] Hash for T by Structure:
    fn hash(self, state: mut Hasher) -> void:
        let w: mut HashWalker[T] = HashWalker::[T] { state: state }
        _ := Structure::walk(self, w)

# The field is public because the prototype checks the instantiated walker
# in the deriving module.
data HashWalker[S]:
    pub state: mut Hasher

impl[S] Walker[S] for HashWalker[S]:
    type Error = never

    fn variant(mut self, v: Variant[S]) -> Result[void, never]:
        if !v.info.of_data:
            v.info.index.hash(self.state)
        .Ok()

    fn member[F < Hash](mut self, h: Field[S, F], value: F) -> Result[void, never]:
        value.hash(self.state)
        .Ok()

# Tuple hashing (spec/std/hash.md#tuple-hashing): each element in order, at
# every size. A rest element is a `List`, which has no `Hash`, so a rest
# tuple has none (r-std-hash.tuple.rest).
impl[T < Tuple] Hash for T by Structure:
    fn hash(self, state: mut Hasher) -> void:
        let w: mut HashWalker[T] = HashWalker::[T] { state: state }
        _ := Structure::walk(self, w)
