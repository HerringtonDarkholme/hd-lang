# std.http: the host capability trait `Http`, its helpers `send!`, `get!`,
# `get_text!` and `post_json!`, the struct values `Request` and `Response`, `Method`,
# `HttpError`, and the deterministic provider `ScriptedHttp` (spec/std/http.md). The default
# profile binds a host `Http` that checks the command's `--cap Http=` grant
# (src/commands/http-host.ts).
use std.time.Duration
use std.json.{JsonError, decode, encode}
use std.serde.{Deserialize, Serialize}

## An HTTP method: a standard one, or `Other(name)`.
## See [std-http.types.decl-struct](../../spec/std/http.md#r-std-http.types.decl-struct).
@derive(Debug, Eq)
pub enum Method:
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Other(name: string)

# A request (r-std-http.types.decl-struct). Only `url` has no default
# (r-std-http.request.defaults).
## An HTTP request; only `url` has no default.
## See [std-http.types.decl-struct](../../spec/std/http.md#r-std-http.types.decl-struct).
@derive(Debug, Eq)
pub struct Request:
    ## The request's method; `Get` by default.
    ## See [std-http.request.defaults](../../spec/std/http.md#r-std-http.request.defaults).
    pub method: Method = Method.Get
    ## The request's URL, the one field without a default.
    ## See [std-http.request.defaults](../../spec/std/http.md#r-std-http.request.defaults).
    pub url: string
    ## The request's headers as name and value pairs; a repeated name keeps every value, in order.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)] = []
    ## The request's whole body; there is no streaming body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8] = []
    ## The request's timeout, or the provider's default for `.None`.
    ## See [std-http.request.defaults](../../spec/std/http.md#r-std-http.request.defaults).
    pub timeout: Duration? = .None

## A whole HTTP response.
## See [std-http.types.decl-struct](../../spec/std/http.md#r-std-http.types.decl-struct).
@derive(Debug, Eq)
pub struct Response:
    ## The response's status code.
    ## See [std-http.types.decl-struct](../../spec/std/http.md#r-std-http.types.decl-struct).
    pub status: u16
    ## The response's headers as name and value pairs.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)]
    ## The response's whole body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8]
    ## The URL that answered, after every redirect; `""` for a response built by hand.
    ## See [std-http.response.url](../../spec/std/http.md#r-std-http.response.url).
    pub url: string = ""

impl Response:
    # The first value of the header `name`, ignoring ASCII case
    # (r-std-http.response.header).
    ## The first value whose name equals `name`, ignoring ASCII case.
    ## See [std-http.response.header](../../spec/std/http.md#r-std-http.response.header).
    pub fn header(self, name: string) -> string?:
        for (key, value) in self.headers:
            if ascii_case_equal(key, name):
                return .Some(value)
        .None

    # The body as UTF-8, with U+FFFD for each invalid sequence
    # (r-std-http.response.text).
    ## The body read as UTF-8 text.
    ## See [std-http.response.text](../../spec/std/http.md#r-std-http.response.text).
    pub fn text(self) -> string:
        match string::from_utf8(self.body):
            .Ok(text) => text
            .Err(_) => lossy_text(self.body)

    # The response itself for a status from 200 to 299, else
    # `HttpError.Status` (r-std-http.response.ok).
    ## `.Ok(self)` for a status from 200 to 299, else `.Err(HttpError.Status(status, url))`.
    ## See [std-http.response.ok](../../spec/std/http.md#r-std-http.response.ok).
    pub fn ok(self) -> Result[Response, HttpError]:
        if self.status >= 200 && self.status <= 299:
            .Ok(self)
        else:
            .Err(.Status(self.status, self.url))

    # The body's text decoded as JSON into `T` (r-std-http.response.json).
    ## Decodes the body text as JSON into `T`; a failure is `.Err(HttpError.Json(error))`.
    ## See [std-http.response.json](../../spec/std/http.md#r-std-http.response.json).
    pub fn json[T < Deserialize](self) -> Result[T, HttpError]:
        match decode::[T](self.text()):
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(.Json(error))

## Why a request failed: invalid URL, DNS, connect, TLS, timeout, too many redirects, not granted, or another reason.
## See [std-http.error.decl](../../spec/std/http.md#r-std-http.error.decl).
@error
@derive(Debug, Eq)
pub enum HttpError:
    @error("http access to ${host} is not granted; run with --cap Http=${host}")
    NotGranted(host: string)
    @error("invalid URL: ${url}")
    InvalidUrl(url: string)
    @error("cannot resolve host ${host}")
    Dns(host: string)
    @error("$message")
    Connect(message: string)
    @error("TLS failed: ${message}")
    Tls(message: string)
    @error("the request timed out")
    Timeout
    @error("too many redirects; the last went to ${url}")
    TooManyRedirects(url: string)
    @error("$message")
    Other(message: string)
    @error("HTTP status ${status} for ${url}")
    Status(status: u16, url: string)
    @error("invalid JSON in the response: ${error}")
    Json(error: JsonError)

# The host capability to send a request (r-std-http.trait.decl-ref).
## The host capability to send an HTTP request and complete with the whole response.
## See [std-http.trait.decl-ref](../../spec/std/http.md#r-std-http.trait.decl-ref).
pub trait Http:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]

# Sends `request` through the covering `Http` provider
# (r-std-http.helper.send).
## Sends `request` on the `Http` provider that covers the call.
## See [std-http.helper.send](../../spec/std/http.md#r-std-http.helper.send).
pub fn send!(request: Request) -> Result[Response, HttpError] $ Http:
    client := $.use(Http)
    client.send!(request)

# Sends a `Get` of `url` (r-std-http.helper.get).
## Sends a `Get` of `url` on the `Http` provider that covers the call.
## See [std-http.helper.get](../../spec/std/http.md#r-std-http.helper.get).
pub fn get!(url: string) -> Result[Response, HttpError] $ Http:
    send!(Request { url: url })

# Sends a `Get` of `url` and returns the text of a 2xx response
# (r-std-http.helper.get-text).
## Sends a `Get` of `url`; the text of a status from 200 to 299, else the error.
## See [std-http.helper.get-text](../../spec/std/http.md#r-std-http.helper.get-text).
pub fn get_text!(url: string) -> Result[string, HttpError] $ Http:
    response := get!(url)?.ok()?
    .Ok(response.text())

# Sends a `Post` of `value` as JSON (r-std-http.helper.post-json).
## Sends a `Post` of `value` encoded as JSON, with `Content-Type: application/json`.
## See [std-http.helper.post-json](../../spec/std/http.md#r-std-http.helper.post-json).
pub fn post_json![T < Serialize](url: string, value: T) -> Result[Response, HttpError] $ Http:
    send!(Request {
        method: Method.Post,
        url: url,
        headers: [("Content-Type", "application/json")],
        body: encode(value).to_utf8(),
    })

# The deterministic `Http` (spec/std/http.md#scripted-http): it answers a
# URL by its exact text, and records every request it receives.
## The deterministic `Http` provider: it answers each URL from a table and records what it sent, with no host access.
## See [std-http.scripted.decl](../../spec/std/http.md#r-std-http.scripted.decl).
@derive(Debug)
pub struct ScriptedHttp:
    responses: Map[string, Response]
    requests: List[Request]

impl ScriptedHttp:
    ## Returns the provider that answers each URL with `responses`' entry for it.
    ## See [std-http.scripted.new-ref](../../spec/std/http.md#r-std-http.scripted.new-ref).
    pub fn new(responses: Map[string, Response]) -> &mut ScriptedHttp:
        &mut ScriptedHttp { responses: responses, requests: [] }

    # Every request received, in order (r-std-http.scripted.sent-ref).
    ## The requests the provider sent, in order.
    ## See [std-http.scripted.sent-ref](../../spec/std/http.md#r-std-http.scripted.sent-ref).
    pub fn sent(&self) -> List[Request]:
        self.requests

impl Http for ScriptedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.requests.push(request)
        match self.responses.get(request.url):
            .Some(response) => .Ok(Response { status: response.status, headers: response.headers, body: response.body, url: request.url })
            .None => .Err(.Connect("ScriptedHttp has no response for ${request.url}"))

fn ascii_case_equal(left: string, right: string) -> bool:
    a := left.to_utf8()
    b := right.to_utf8()
    if a.len() != b.len():
        return false
    let index: usize = 0
    while index < a.len():
        if ascii_lower(a[index]) != ascii_lower(b[index]):
            return false
        index = index + 1
    true

fn ascii_lower(byte: u8) -> u8:
    if byte >= 65 && byte <= 90:
        byte + 32
    else:
        byte

# Decodes `bytes` as UTF-8, with one U+FFFD for each maximal invalid
# subpart, as the WHATWG decoder does.
fn lossy_text(bytes: List[u8]) -> string:
    let mut out: List[u8] = []
    size := bytes.len()
    let index: usize = 0
    while index < size:
        lead := bytes[index]
        let width: usize = 0
        let low: u8 = 128
        let high: u8 = 191
        if lead < 128:
            width = 1
        else if lead >= 194 && lead <= 223:
            width = 2
        else if lead >= 224 && lead <= 239:
            width = 3
            if lead == 224:
                low = 160
            if lead == 237:
                high = 159
        else if lead >= 240 && lead <= 244:
            width = 4
            if lead == 240:
                low = 144
            if lead == 244:
                high = 143
        if width == 0:
            push_replacement(&mut out)
            index = index + 1
        else:
            let at: usize = 1
            let valid = true
            while valid && at < width:
                if index + at >= size:
                    valid = false
                else:
                    next := bytes[index + at]
                    bottom := if at == 1: low else: 128
                    top := if at == 1: high else: 191
                    if next < bottom || next > top:
                        valid = false
                    else:
                        at = at + 1
            if valid:
                let copied: usize = 0
                while copied < width:
                    out.push(bytes[index + copied])
                    copied = copied + 1
                index = index + width
            else:
                push_replacement(&mut out)
                index = index + at
    match string::from_utf8(out):
        .Ok(text) => text
        .Err(_) => ""

fn push_replacement(out: &mut List[u8]) -> void:
    out.push(239)
    out.push(191)
    out.push(189)

# The text of each variant; `NotGranted` names the flag that grants the
# host (r-std-http.error.not-granted.text).

# A std error type implements `Error` (r-std-error.std-types.impl.reference-values).
