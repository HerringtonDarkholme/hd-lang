# std.http: the host capability trait `Http`, its free helper `get!`,
# the struct values `Request` and `Response`, `Method`,
# `HttpError`, and the deterministic provider `ScriptedHttp` (spec/std/http.md). The default
# profile binds a host `Http` that checks the command's `--cap Http=` grant
# (src/commands/http-host.ts).
use std.text.StringBuilder
use std.json.{JsonError, decode}
use std.serde.Deserialize

## An HTTP method: a standard one, or `Other(name)`.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub enum Method:
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Other(name: string)

# A request (r-std-http.types.builder-response-defaults). Only `url` has no default
# (r-std-http.request.builder-defaults).
## An HTTP request; only `url` has no default.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub struct Request:
    ## The request's method; `Get` by default.
    ## See [std-http.request.builder-defaults](../../spec/std/http.md#r-std-http.request.builder-defaults).
    pub method: Method = Method.Get
    ## The request's URL, the one field without a default.
    ## See [std-http.request.builder-defaults](../../spec/std/http.md#r-std-http.request.builder-defaults).
    pub url: string
    ## Query pairs appended to the URL when this request is sent.
    ## See [std-http.request.query](../../spec/std/http.md#r-std-http.request.query).
    pub query: List[(string, string)] = []
    ## The request's headers as name and value pairs; a repeated name keeps every value, in order.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)] = []
    ## The request's whole body; there is no streaming body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8] = []
    ## The maximum number of redirects to follow; zero returns the redirect response.
    ## See [std-http.request.redirects](../../spec/std/http.md#r-std-http.request.redirects).
    pub redirects: usize = 10

impl Request:
    ## Returns a GET request for `url` with the default fields.
    ## See [std-http.request.get](../../spec/std/http.md#r-std-http.request.get).
    pub fn get(url: string) -> &mut Request:
        Request::new(.Get, url)

    ## Returns a POST request for `url` with the default fields.
    ## See [std-http.request.post](../../spec/std/http.md#r-std-http.request.post).
    pub fn post(url: string) -> &mut Request:
        Request::new(.Post, url)

    ## Returns a request with `method`, `url`, and the other default fields.
    ## See [std-http.request.new](../../spec/std/http.md#r-std-http.request.new).
    pub fn new(method: Method, url: string) -> &mut Request:
        &mut Request { method: method, url: url }

    ## Appends a header and returns this builder.
    ## See [std-http.request.header](../../spec/std/http.md#r-std-http.request.header).
    pub fn header(&mut self, name: string, value: string) -> &mut Request:
        self.headers.push((name, value))
        self

    ## Appends an unencoded query pair and returns this builder.
    ## See [std-http.request.query](../../spec/std/http.md#r-std-http.request.query).
    pub fn query[T < Display](&mut self, name: string, value: T) -> &mut Request:
        self.query.push((name, "$value"))
        self

    ## Replaces the body and returns this builder.
    ## See [std-http.request.body](../../spec/std/http.md#r-std-http.request.body).
    pub fn body(&mut self, bytes: List[u8]) -> &mut Request:
        self.body = bytes
        self

    ## Sets the redirect limit and returns this builder.
    ## See [std-http.request.redirects](../../spec/std/http.md#r-std-http.request.redirects).
    pub fn redirects(&mut self, count: usize) -> &mut Request:
        self.redirects = count
        self

    ## Sends a copy through the covering Http provider, encoding query pairs once.
    ## See [std-http.request.send](../../spec/std/http.md#r-std-http.request.send).
    pub fn send!(self) -> Result[Response, HttpError] $ Http:
        let mut request = self
        request.url = query_url(self.url, self.query)
        $.use(Http).send!(request)

fn query_url(url: string, pairs: List[(string, string)]) -> string:
    if pairs.is_empty():
        return url
    let (base, fragment) = url.split_once("#").unwrap_or((url, ""))
    out := StringBuilder::new()
    out.push(base)
    let separator = if !base.contains("?"): "?" else if base.ends_with("?") || base.ends_with("&"): "" else: "&"
    for (name, value) in pairs:
        out.push(separator)
        encode_query(out, name)
        out.push("=")
        encode_query(out, value)
        separator = "&"
    if url.contains("#"):
        out.push("#")
        out.push(fragment)
    out.build()

fn encode_query(out: &mut StringBuilder, text: string) -> void:
    digits := "0123456789ABCDEF"
    let index = 0
    for byte in text.to_utf8():
        if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 126:
            out.push(text.slice(index, index + 1))
        else:
            out.push("%")
            high := usize(byte / 16)
            low := usize(byte % 16)
            out.push(digits.slice(high, high + 1))
            out.push(digits.slice(low, low + 1))
        index += 1

## Shared base URL and default headers for HTTP requests.
## See [std-http.client.http-only](../../spec/std/http.md#r-std-http.client.http-only).
pub struct Client:
    base: string
    headers: List[(string, string)]

impl Client:
    ## Returns a client without a base URL or default headers.
    ## See [std-http.client.new-empty](../../spec/std/http.md#r-std-http.client.new-empty).
    pub fn new() -> &mut Client:
        &mut Client { base: "", headers: [] }

    ## Sets the base URL and returns this client.
    ## See [std-http.client.base-url](../../spec/std/http.md#r-std-http.client.base-url).
    pub fn base_url(&mut self, url: string) -> &mut Client:
        self.base = url
        self

    ## Appends a default header and returns this client.
    ## See [std-http.client.default-header](../../spec/std/http.md#r-std-http.client.default-header).
    pub fn header(&mut self, name: string, value: string) -> &mut Client:
        self.headers.push((name, value))
        self

    ## Sends with the base URL and defaults, requiring only Http.
    ## See [std-http.client.send-http-only](../../spec/std/http.md#r-std-http.client.send-http-only).
    pub fn send!(&mut self, request: Request) -> Result[Response, HttpError] $ Http:
        let mut headers = request.headers
        for (name, value) in self.headers:
            let present = false
            for (key, _) in request.headers:
                if ascii_case_equal(key, name):
                    present = true
                    break
            if !present:
                headers.push((name, value))
        Request { ...request, url: client_url(self.base, request.url), headers: headers }.send!()

fn client_url(base: string, url: string) -> string:
    if base.is_empty() || !url.starts_with("/"):
        return url
    match base.split_once("://"):
        .Some((scheme, rest)) =>
            if url.starts_with("//"):
                return "$scheme:$url"
            authority := rest.split_once("/").map(fn(pair): pair._0).unwrap_or(rest)
            without_query := authority.split_once("?").map(fn(pair): pair._0).unwrap_or(authority)
            host := without_query.split_once("#").map(fn(pair): pair._0).unwrap_or(without_query)
            "$scheme://$host$url"
        .None => "$base$url"

## A whole HTTP response.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub struct Response:
    ## The response's status code.
    ## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
    pub status: u16
    ## The response's headers as name and value pairs.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)] = []
    ## The response's whole body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8] = []
    ## The URL that answered, after every redirect; `""` for a response built by hand.
    ## See [std-http.response.url](../../spec/std/http.md#r-std-http.response.url).
    pub url: string = ""

impl Response:
    # The first value of the header `name`, ignoring ASCII case
    # (r-std-http.response.header).
    ## The first value whose name equals `name`, ignoring ASCII case.
    ## See [std-http.response.header](../../spec/std/http.md#r-std-http.response.header).
    pub fn header(self, name: string) -> string?:
        for (key, value) in self.headers:
            if ascii_case_equal(key, name):
                return .Some(value)
        .None

    # The body as UTF-8, with U+FFFD for each invalid sequence
    # (r-std-http.response.text).
    ## The body read as UTF-8 text.
    ## See [std-http.response.text](../../spec/std/http.md#r-std-http.response.text).
    pub fn text(self) -> string:
        match string::from_utf8(self.body):
            .Ok(text) => text
            .Err(_) => lossy_text(self.body)

    ## Checks 400–599 and retains the whole response when it failed.
    ## See [std-http.response.ok.retained-error](../../spec/std/http.md#r-std-http.response.ok.retained-error).
    pub fn ok(self) -> Result[Response, HttpError]:
        if self.status >= 400 && self.status <= 599:
            .Err(.Status(self))
        else:
            .Ok(self)

    # The body's text decoded as JSON into `T` (r-std-http.response.json).
    ## Decodes the body text as JSON into `T`; a failure is `.Err(HttpError.Json(error))`.
    ## See [std-http.response.json](../../spec/std/http.md#r-std-http.response.json).
    pub fn json[T < Deserialize](self) -> Result[T, HttpError]:
        match decode::[T](self.text()):
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(.Json(error))

## Why a request failed: invalid URL, DNS, connect, TLS, timeout, too many redirects, not granted, or another reason.
## See [std-http.error.decl-retained-response](../../spec/std/http.md#r-std-http.error.decl-retained-response).
@error
@derive(Debug, Eq)
pub enum HttpError:
    @error("http access to ${host} is not granted")
    NotGranted(host: string)
    @error("invalid URL: ${url}")
    InvalidUrl(url: string)
    @error("cannot resolve host ${host}")
    Dns(host: string)
    @error("$message")
    Connect(message: string)
    @error("TLS failed: ${message}")
    Tls(message: string)
    @error("the request timed out")
    Timeout
    @error("too many redirects; the last went to ${url}")
    TooManyRedirects(url: string)
    @error("$message")
    Other(message: string)
    @error("HTTP status ${response.status} for ${status_url(response.url)}")
    Status(response: Response)
    @error("invalid JSON in the response: ${error}")
    Json(error: JsonError)

impl HttpError:
    ## Whether a timeout, connection failure or retryable status may succeed on retry.
    ## See [std-http.error.transient-kinds](../../spec/std/http.md#r-std-http.error.transient-kinds).
    pub fn is_transient(self) -> bool:
        match self:
            .Timeout => true
            .Connect(_) => true
            .Status(response) =>
                status := response.status
                status == 408 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
            _ => false

# Status diagnostics show the URL without exposing query or fragment data.
fn status_url(url: string) -> string:
    without_query := url.split_once("?").map(fn(parts): parts._0).unwrap_or(url)
    without_query.split_once("#").map(fn(parts): parts._0).unwrap_or(without_query)

# The host capability to send a request (r-std-http.trait.decl-ref).
## The host capability to send an HTTP request and complete with the whole response.
## See [std-http.trait.decl-ref](../../spec/std/http.md#r-std-http.trait.decl-ref).
pub trait Http:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]

## Sends a GET and checks its response for a 400–599 failure.
## See [std-http.helper.get.checked-response](../../spec/std/http.md#r-std-http.helper.get.checked-response).
pub fn get!(url: string) -> Result[Response, HttpError] $ Http:
    Request::get(url).send!()?.ok()

# Each URL owns one mutable queue, so appending a reply does not copy its
# earlier replies. The cursor stops after the last consumed result.
@derive(Debug)
struct HttpReplies:
    items: List[Result[Response, HttpError]]
    next: usize

## A deterministic Http provider with queued replies and a log of received requests.
## See [std-http.scripted.decl](../../spec/std/http.md#r-std-http.scripted.decl).
@derive(Debug)
pub struct ScriptedHttp:
    responses: Map[string, &mut HttpReplies]
    requests: List[Request]

impl ScriptedHttp:
    ## Returns a new provider with no replies or received requests.
    ## See [std-http.scripted.new-empty](../../spec/std/http.md#r-std-http.scripted.new-empty).
    pub fn new() -> &mut ScriptedHttp:
        &mut ScriptedHttp { responses: {}, requests: [] }

    ## Appends a result to this URL's reply queue.
    ## See [std-http.scripted.reply](../../spec/std/http.md#r-std-http.scripted.reply).
    pub fn reply(&mut self, url: string, result: Result[Response, HttpError]) -> void:
        match self.responses.get(url):
            .Some(replies) => replies.items.push(result)
            .None => self.responses[url] = &mut HttpReplies { items: [result], next: 0 }

    ## The received requests in order, including requests without a reply.
    ## See [std-http.scripted.received-ref](../../spec/std/http.md#r-std-http.scripted.received-ref).
    pub fn received(&self) -> List[Request]:
        self.requests

impl Http for ScriptedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.requests.push(request)
        match self.responses.get(request.url):
            .Some(replies) =>
                index := if replies.next < replies.items.len(): replies.next else: replies.items.len() - 1
                result := replies.items[index]
                if replies.next < replies.items.len():
                    replies.next += 1
                match result:
                    .Ok(response) => .Ok(Response { ...response, url: request.url })
                    .Err(error) => .Err(error)
            .None => .Err(.Connect("ScriptedHttp has no response for ${request.url}"))

fn ascii_case_equal(left: string, right: string) -> bool:
    a := left.to_utf8()
    b := right.to_utf8()
    if a.len() != b.len():
        return false
    let index: usize = 0
    while index < a.len():
        if ascii_lower(a[index]) != ascii_lower(b[index]):
            return false
        index = index + 1
    true

fn ascii_lower(byte: u8) -> u8:
    if byte >= 65 && byte <= 90:
        byte + 32
    else:
        byte

# Decodes `bytes` as UTF-8, with one U+FFFD for each maximal invalid
# subpart, as the WHATWG decoder does.
fn lossy_text(bytes: List[u8]) -> string:
    let mut out: List[u8] = []
    size := bytes.len()
    let index: usize = 0
    while index < size:
        lead := bytes[index]
        let width: usize = 0
        let low: u8 = 128
        let high: u8 = 191
        if lead < 128:
            width = 1
        else if lead >= 194 && lead <= 223:
            width = 2
        else if lead >= 224 && lead <= 239:
            width = 3
            if lead == 224:
                low = 160
            if lead == 237:
                high = 159
        else if lead >= 240 && lead <= 244:
            width = 4
            if lead == 240:
                low = 144
            if lead == 244:
                high = 143
        if width == 0:
            push_replacement(&mut out)
            index = index + 1
        else:
            let at: usize = 1
            let valid = true
            while valid && at < width:
                if index + at >= size:
                    valid = false
                else:
                    next := bytes[index + at]
                    bottom := if at == 1: low else: 128
                    top := if at == 1: high else: 191
                    if next < bottom || next > top:
                        valid = false
                    else:
                        at = at + 1
            if valid:
                let copied: usize = 0
                while copied < width:
                    out.push(bytes[index + copied])
                    copied = copied + 1
                index = index + width
            else:
                push_replacement(&mut out)
                index = index + at
    match string::from_utf8(out):
        .Ok(text) => text
        .Err(_) => ""

fn push_replacement(out: &mut List[u8]) -> void:
    out.push(239)
    out.push(191)
    out.push(189)

# NotGranted describes the refused host (r-std-http.error.not-granted.plain).

# A std error type implements `Error` (r-std-error.std-types.impl.reference-values).
