# std.http: the host capability trait `Http`, its free helper `get!`,
# the struct values `Request` and `Response`, `Method`,
# `HttpError`, and the deterministic provider `ScriptedHttp` (spec/std/http.md). The default
# profile binds a host `Http` that checks the command's `--cap Http=` grant
# (src/commands/http-host.ts).
use std.convert.From
use std.task.TimedOut
use std.text.StringBuilder
use std.json.{JsonError, decode, encode}
use std.serde.{Deserialize, Serialize, Serializer}
use std.structure.{Facts, VariantInfo, Member}

## An HTTP method: a standard one, or `Other(name)`.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub enum Method:
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Other(name: string)

# A request (r-std-http.types.builder-response-defaults). Only `url` has no default
# (r-std-http.request.builder-defaults).
## An HTTP request; only `url` has no default.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub struct Request:
    ## The request's method; `Get` by default.
    ## See [std-http.request.builder-defaults](../../spec/std/http.md#r-std-http.request.builder-defaults).
    pub method: Method = Method.Get
    ## The request's URL, the one field without a default.
    ## See [std-http.request.builder-defaults](../../spec/std/http.md#r-std-http.request.builder-defaults).
    pub url: string
    ## Query pairs appended to the URL when this request is sent.
    ## See [std-http.request.query](../../spec/std/http.md#r-std-http.request.query).
    pub query: List[(string, string)] = []
    ## The request's headers as name and value pairs; a repeated name keeps every value, in order.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)] = []
    ## The request's whole body; there is no streaming body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8] = []
    ## The maximum number of redirects to follow; zero returns the redirect response.
    ## See [std-http.request.redirects](../../spec/std/http.md#r-std-http.request.redirects).
    pub redirects: usize = 10

impl Request:
    ## Returns a GET request for `url` with the default fields.
    ## See [std-http.request.get](../../spec/std/http.md#r-std-http.request.get).
    pub fn get(url: string) -> &mut Request:
        Request::new(.Get, url)

    ## Returns a POST request for `url` with the default fields.
    ## See [std-http.request.post](../../spec/std/http.md#r-std-http.request.post).
    pub fn post(url: string) -> &mut Request:
        Request::new(.Post, url)

    ## Returns a request with `method`, `url`, and the other default fields.
    ## See [std-http.request.new](../../spec/std/http.md#r-std-http.request.new).
    pub fn new(method: Method, url: string) -> &mut Request:
        &mut Request { method: method, url: url }

    ## Appends a header and returns this builder.
    ## See [std-http.request.header](../../spec/std/http.md#r-std-http.request.header).
    pub fn header(&mut self, name: string, value: string) -> &mut Request:
        self.headers.push((name, value))
        self

    ## Appends an unencoded query pair and returns this builder.
    ## See [std-http.request.query](../../spec/std/http.md#r-std-http.request.query).
    pub fn query[T < Display](&mut self, name: string, value: T) -> &mut Request:
        self.query.push((name, "$value"))
        self

    ## Replaces the body and returns this builder.
    ## See [std-http.request.body](../../spec/std/http.md#r-std-http.request.body).
    pub fn body(&mut self, bytes: List[u8]) -> &mut Request:
        self.body = bytes
        self

    ## Encodes the typed value as JSON and returns this builder.
    ## See [std-http.request.json-serialize](../../spec/std/http.md#r-std-http.request.json-serialize).
    pub fn json[T < Serialize](&mut self, value: T) -> &mut Request:
        self.body = encode(value).to_utf8()
        self.content_type("application/json")

    ## Encodes a flat typed record or string map as form fields.
    ## See [std-http.request.form-serialize](../../spec/std/http.md#r-std-http.request.form-serialize).
    pub fn form[T < Serialize](&mut self, value: T) -> &mut Request:
        writer := FormWriter::new()
        _ := value.serialize(writer)
        self.body = writer.finish().to_utf8()
        self.content_type("application/x-www-form-urlencoded")

    fn content_type(&mut self, value: string) -> &mut Request:
        for (name, _) in self.headers:
            if ascii_case_equal(name, "Content-Type"):
                return self
        self.headers.push(("Content-Type", value))
        self

    ## Sets the redirect limit and returns this builder.
    ## See [std-http.request.redirects](../../spec/std/http.md#r-std-http.request.redirects).
    pub fn redirects(&mut self, count: usize) -> &mut Request:
        self.redirects = count
        self

    ## Sends a copy through the covering Http provider, encoding query pairs once.
    ## See [std-http.request.send](../../spec/std/http.md#r-std-http.request.send).
    pub fn send!(self) -> Result[Response, HttpError] $ Http:
        let mut request = self
        request.url = query_url(self.url, self.query)
        $.use(Http).send!(request)

fn query_url(url: string, pairs: List[(string, string)]) -> string:
    if pairs.is_empty():
        return url
    let (base, fragment) = url.split_once("#").unwrap_or((url, ""))
    out := StringBuilder::new()
    out.push(base)
    let separator = if !base.contains("?"): "?" else if base.ends_with("?") || base.ends_with("&"): "" else: "&"
    for (name, value) in pairs:
        out.push(separator)
        encode_component(out, name, false)
        out.push("=")
        encode_component(out, value, false)
        separator = "&"
    if url.contains("#"):
        out.push("#")
        out.push(fragment)
    out.build()

fn encode_component(out: &mut StringBuilder, text: string, form: bool) -> void:
    digits := "0123456789ABCDEF"
    let index = 0
    for byte in text.to_utf8():
        if form && byte == 32:
            out.push("+")
        else if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || (if form: byte == 42 else: byte == 126):
            out.push(text.slice(index, index + 1))
        else:
            out.push("%")
            high := usize(byte / 16)
            low := usize(byte % 16)
            out.push(digits.slice(high, high + 1))
            out.push(digits.slice(low, low + 1))
        index += 1

# A flat Serializer: the root record/map supplies names, and only scalar
# values (or one list of them) write pairs. Buffer a variant's name until
# its end, so a payload member can reject it before it writes a value.
struct FormWriter:
    pub out: &mut StringBuilder
    pub started: bool
    pub finished: bool
    pub map: bool
    pub keyed: bool
    pub name: string
    pub repeated: bool
    pub tagged: bool
    pub tag: string
    pub written: bool

impl FormWriter:
    fn new() -> &mut FormWriter:
        &mut FormWriter { out: StringBuilder::new(), started: false, finished: false, map: false, keyed: false, name: "\$", repeated: false, tagged: false, tag: "", written: false }

    fn unsupported(&self) -> never:
        panic("std.http.form: unsupported value for member `${self.name}`")

    fn finish(&self) -> string:
        if !self.finished || self.repeated || self.tagged:
            self.unsupported()
        self.out.build()

    fn scalar(&mut self, value: string, text: bool) -> Result[void, never]:
        if !self.started || self.finished || !self.keyed || self.tagged || (self.map && !text):
            self.unsupported()
        if self.written:
            self.out.push("&")
        self.written = true
        encode_component(self.out, self.name, true)
        self.out.push("=")
        encode_component(self.out, value, true)
        if !self.repeated:
            self.keyed = false
        .Ok(())

impl Serializer for FormWriter:
    type Error = never

    fn null(&mut self) -> Result[void, never]:
        if !self.started || self.finished || !self.keyed || self.map || self.repeated || self.tagged:
            self.unsupported()
        self.keyed = false
        .Ok(())

    fn bool(&mut self, value: bool) -> Result[void, never]:
        self.scalar(if value: "true" else: "false", false)

    fn int(&mut self, value: i64) -> Result[void, never]:
        self.scalar("$value", false)

    fn uint(&mut self, value: u64) -> Result[void, never]:
        self.scalar("$value", false)

    fn float(&mut self, value: f64) -> Result[void, never]:
        self.scalar("$value", false)

    fn text(&mut self, value: string) -> Result[void, never]:
        self.scalar(value, true)

    fn begin_list(&mut self, len: usize) -> Result[void, never]:
        if !self.started || self.finished || !self.keyed || self.map || self.repeated || self.tagged:
            self.unsupported()
        self.repeated = true
        .Ok(())

    fn end_list(&mut self) -> Result[void, never]:
        if !self.repeated || self.tagged:
            self.unsupported()
        self.repeated = false
        self.keyed = false
        .Ok(())

    fn begin_map(&mut self, len: usize) -> Result[void, never]:
        if self.started:
            self.unsupported()
        self.started = true
        self.map = true
        .Ok(())

    fn key(&mut self, key: string) -> Result[void, never]:
        if !self.map || self.finished || self.keyed:
            self.unsupported()
        self.name = key
        self.keyed = true
        .Ok(())

    fn end_map(&mut self) -> Result[void, never]:
        if !self.map || self.keyed:
            self.unsupported()
        self.finished = true
        .Ok(())

    fn begin_variant(&mut self, facts: Facts, v: VariantInfo) -> Result[void, never]:
        if !self.started:
            if !v.of_data:
                self.unsupported()
            self.started = true
        else:
            if v.of_data || self.map || self.finished || !self.keyed || self.tagged:
                self.unsupported()
            self.tagged = true
            self.tag = v.name
        .Ok(())

    fn member(&mut self, m: Member) -> Result[void, never]:
        if self.tagged || self.repeated || self.keyed || self.finished:
            self.unsupported()
        self.name = m.name
        self.keyed = true
        .Ok(())

    fn end_variant(&mut self) -> Result[void, never]:
        if self.tagged:
            self.tagged = false
            return self.scalar(self.tag, false)
        if !self.started || self.map || self.keyed || self.repeated || self.finished:
            self.unsupported()
        self.finished = true
        .Ok(())

## Shared base URL, default headers and host-only cookies for HTTP requests.
## See [std-http.client.http-only](../../spec/std/http.md#r-std-http.client.http-only).
pub struct Client:
    base: string
    headers: List[(string, string)]
    cookies: Map[string, List[ClientCookie]]

struct ClientCookie:
    name: string
    value: string
    secure: bool

impl Client:
    ## Returns a client without a base URL, default headers or cookies.
    ## See [std-http.client.new-empty-jar](../../spec/std/http.md#r-std-http.client.new-empty-jar).
    pub fn new() -> &mut Client:
        &mut Client { base: "", headers: [], cookies: {} }

    ## Sets the base URL and returns this client.
    ## See [std-http.client.base-url](../../spec/std/http.md#r-std-http.client.base-url).
    pub fn base_url(&mut self, url: string) -> &mut Client:
        self.base = url
        self

    ## Appends a default header and returns this client.
    ## See [std-http.client.default-header](../../spec/std/http.md#r-std-http.client.default-header).
    pub fn header(&mut self, name: string, value: string) -> &mut Client:
        self.headers.push((name, value))
        self

    ## Reads a stored cookie that this client would send to the resolved URL.
    ## See [std-http.client.cookie](../../spec/std/http.md#r-std-http.client.cookie).
    pub fn cookie(self, url: string, name: string) -> string?:
        let (host, secure) = cookie_host(client_url(self.base, url))?
        for item in self.cookies.get(host).unwrap_or([]):
            if item.name == name && (!item.secure || secure):
                return .Some(item.value)
        .None

    ## Sends with shared defaults and cookies, following redirects itself.
    ## See [std-http.client.send-http-only](../../spec/std/http.md#r-std-http.client.send-http-only).
    pub fn send!(&mut self, request: Request) -> Result[Response, HttpError] $ Http:
        let mut headers = request.headers
        for (name, value) in self.headers:
            let present = false
            for (key, _) in request.headers:
                if ascii_case_equal(key, name):
                    present = true
                    break
            if !present:
                headers.push((name, value))
        let mut current = Request { ...request, url: query_url(client_url(self.base, request.url), request.query), query: [], headers: headers, redirects: 0 }
        let followed: usize = 0
        while true:
            let mut sent = current
            let explicit_cookie = false
            for (name, _) in current.headers:
                if ascii_case_equal(name, "Cookie"):
                    explicit_cookie = true
            if !explicit_cookie:
                match cookie_host(current.url):
                    .Some((host, secure)) =>
                        let mut pairs: List[string] = []
                        for item in self.cookies.get(host).unwrap_or([]):
                            if !item.secure || secure:
                                pairs.push("${item.name}=${item.value}")
                        if !pairs.is_empty():
                            sent.headers.push(("Cookie", pairs.join("; ")))
                    .None => pass
            response := $.use(Http).send!(sent)?
            self.remember(current.url, response.headers)
            location := response.header("Location")
            redirect := response.status == 301 || response.status == 302 || response.status == 303 || response.status == 307 || response.status == 308
            if !redirect || location.is_none() || request.redirects == 0:
                return .Ok(Response { ...response, url: current.url })
            target := redirect_url(current.url, location.unwrap_or(""))
            if followed == request.redirects:
                return .Err(.TooManyRedirects(target))
            if cookie_host(current.url).map(fn(pair): pair._0) != cookie_host(target).map(fn(pair): pair._0):
                current.headers = current.headers.filter(fn(pair): !ascii_case_equal(pair._0, "Authorization") && !ascii_case_equal(pair._0, "Cookie"))
            if response.status == 303 || ((response.status == 301 || response.status == 302) && current.method == Method.Post):
                current.method = .Get
                current.body = []
                current.headers = current.headers.filter(fn(pair): !ascii_case_equal(pair._0, "Content-Type") && !ascii_case_equal(pair._0, "Content-Length") && !ascii_case_equal(pair._0, "Transfer-Encoding"))
            current.url = target
            followed += 1

    fn remember(&mut self, url: string, headers: List[(string, string)]) -> void:
        host := match cookie_host(url):
            .Some((host, _)) => host
            .None => return
        for (header, text) in headers:
            if !ascii_case_equal(header, "Set-Cookie"):
                continue
            parts := text.split(";")
            let (name, value) = match parts[0].split_once("="):
                .Some((name, value)) => (name.trim(), value.trim())
                .None => continue
            if name.is_empty():
                continue
            let secure = false
            let remove = false
            for attribute in parts.iter().skip(1):
                let (key, setting) = attribute.trim().split_once("=").unwrap_or((attribute.trim(), ""))
                if ascii_case_equal(key.trim(), "Secure"):
                    secure = true
                if ascii_case_equal(key.trim(), "Max-Age") && setting.trim() == "0":
                    remove = true
            let mut cookies = self.cookies.get(host).unwrap_or([]).filter(fn(item): item.name != name)
            if !remove:
                cookies.push(ClientCookie { name: name, value: value, secure: secure })
            self.cookies[host] = cookies

# Only the hostname keys the jar: ports do not widen it, Domain is never
# consulted, and Secure is checked against the request's scheme.
fn cookie_host(url: string) -> (string, bool)?:
    let (scheme, rest) = url.split_once("://")?
    if !ascii_case_equal(scheme, "http") && !ascii_case_equal(scheme, "https"):
        return .None
    let authority = rest.split_once("/").map(fn(pair): pair._0).unwrap_or(rest)
    authority = authority.split_once("?").map(fn(pair): pair._0).unwrap_or(authority)
    authority = authority.split_once("#").map(fn(pair): pair._0).unwrap_or(authority)
    match authority.rfind("@"):
        .Some(at) => authority = authority.slice(at + 1, authority.len())
        .None => pass
    host := if authority.starts_with("["):
        authority.split_once("]").map(fn(pair): pair._0 + "]").unwrap_or("")
    else:
        authority.split_once(":").map(fn(pair): pair._0).unwrap_or(authority)
    if host.is_empty():
        return .None
    .Some((host.lower(), ascii_case_equal(scheme, "https")))

fn client_url(base: string, url: string) -> string:
    if base.is_empty() || !url.starts_with("/"):
        return url
    match base.split_once("://"):
        .Some((scheme, rest)) =>
            if url.starts_with("//"):
                return "$scheme:$url"
            authority := rest.split_once("/").map(fn(pair): pair._0).unwrap_or(rest)
            without_query := authority.split_once("?").map(fn(pair): pair._0).unwrap_or(authority)
            host := without_query.split_once("#").map(fn(pair): pair._0).unwrap_or(without_query)
            "$scheme://$host$url"
        .None => "$base$url"

# RFC 3986 components keep an absent query distinct from an empty one.
struct ClientUrl:
    scheme: string?
    authority: string?
    path: string
    query: string?
    fragment: string?

fn client_url_parts(url: string) -> ClientUrl:
    let rest = url
    let fragment: string? = .None
    match rest.split_once("#"):
        .Some((before, value)) =>
            rest = before
            fragment = .Some(value)
        .None => pass
    let query: string? = .None
    match rest.split_once("?"):
        .Some((before, value)) =>
            rest = before
            query = .Some(value)
        .None => pass
    let scheme: string? = .None
    match rest.split_once(":"):
        .Some((name, after)) =>
            let valid = !name.is_empty()
            for (at, byte) in name.to_utf8().iter().enumerate():
                letter := (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
                if !letter && (at == 0 || !((byte >= 48 && byte <= 57) || byte == 43 || byte == 45 || byte == 46)):
                    valid = false
            if valid:
                scheme = .Some(name)
                rest = after
        .None => pass
    let authority: string? = .None
    if rest.starts_with("//"):
        tail := rest.slice(2, rest.len())
        end := tail.find("/").unwrap_or(tail.len())
        authority = .Some(tail.slice(0, end))
        rest = tail.slice(end, tail.len())
    ClientUrl { scheme: scheme, authority: authority, path: rest, query: query, fragment: fragment }

fn redirect_url(base: string, location: string) -> string:
    origin := client_url_parts(base)
    reference := client_url_parts(location)
    let mut target = reference
    if reference.scheme.is_some():
        target.path = client_url_path(reference.path)
    else:
        target.scheme = origin.scheme
        if reference.authority.is_some():
            target.path = client_url_path(reference.path)
        else:
            target.authority = origin.authority
            if reference.path.is_empty():
                target.path = origin.path
                if reference.query.is_none():
                    target.query = origin.query
            else if reference.path.starts_with("/"):
                target.path = client_url_path(reference.path)
            else:
                directory := if origin.authority.is_some() && origin.path.is_empty():
                    "/"
                else:
                    origin.path.rfind("/").map(fn(at): origin.path.slice(0, at + 1)).unwrap_or("")
                target.path = client_url_path(directory + reference.path)
    out := StringBuilder::new()
    match target.scheme:
        .Some(scheme) => out.push(scheme + ":")
        .None => pass
    match target.authority:
        .Some(authority) => out.push("//" + authority)
        .None => pass
    out.push(target.path)
    match target.query:
        .Some(query) => out.push("?" + query)
        .None => pass
    match target.fragment:
        .Some(fragment) => out.push("#" + fragment)
        .None => pass
    out.build()

# RFC 3986 section 5.2.4; percent-encoded dots remain encoded.
fn client_url_path(path: string) -> string:
    let input = path
    let output = ""
    while !input.is_empty():
        if input.starts_with("../"):
            input = input.slice(3, input.len())
        else if input.starts_with("./"):
            input = input.slice(2, input.len())
        else if input.starts_with("/./"):
            input = input.slice(2, input.len())
        else if input == "/.":
            input = "/"
        else if input.starts_with("/../") || input == "/..":
            input = if input == "/..": "/" else: input.slice(3, input.len())
            output = output.slice(0, output.rfind("/").unwrap_or(0))
        else if input == "." || input == "..":
            input = ""
        else:
            start := if input.starts_with("/"): 1 else: 0
            end := input.slice(start, input.len()).find("/").map(fn(at): at + start).unwrap_or(input.len())
            output += input.slice(0, end)
            input = input.slice(end, input.len())
    output

## A whole HTTP response.
## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
@derive(Debug, Eq)
pub struct Response:
    ## The response's status code.
    ## See [std-http.types.builder-response-defaults](../../spec/std/http.md#r-std-http.types.builder-response-defaults).
    pub status: u16
    ## The response's headers as name and value pairs.
    ## See [std-http.headers.pairs](../../spec/std/http.md#r-std-http.headers.pairs).
    pub headers: List[(string, string)] = []
    ## The response's whole body.
    ## See [std-http.bodies](../../spec/std/http.md#r-std-http.bodies).
    pub body: List[u8] = []
    ## The URL that answered, after every redirect; `""` for a response built by hand.
    ## See [std-http.response.url](../../spec/std/http.md#r-std-http.response.url).
    pub url: string = ""

impl Response:
    # The first value of the header `name`, ignoring ASCII case
    # (r-std-http.response.header).
    ## The first value whose name equals `name`, ignoring ASCII case.
    ## See [std-http.response.header](../../spec/std/http.md#r-std-http.response.header).
    pub fn header(self, name: string) -> string?:
        for (key, value) in self.headers:
            if ascii_case_equal(key, name):
                return .Some(value)
        .None

    # The body as UTF-8, with U+FFFD for each invalid sequence
    # (r-std-http.response.text).
    ## The body read as UTF-8 text.
    ## See [std-http.response.text](../../spec/std/http.md#r-std-http.response.text).
    pub fn text(self) -> string:
        match string::from_utf8(self.body):
            .Ok(text) => text
            .Err(_) => lossy_text(self.body)

    ## Checks 400–599 and retains the whole response when it failed.
    ## See [std-http.response.ok.retained-error](../../spec/std/http.md#r-std-http.response.ok.retained-error).
    pub fn ok(self) -> Result[Response, HttpError]:
        if self.status >= 400 && self.status <= 599:
            .Err(.Status(self))
        else:
            .Ok(self)

    # The body's text decoded as JSON into `T` (r-std-http.response.json).
    ## Decodes the body text as JSON into `T`; a failure is `.Err(HttpError.Json(error))`.
    ## See [std-http.response.json](../../spec/std/http.md#r-std-http.response.json).
    pub fn json[T < Deserialize](self) -> Result[T, HttpError]:
        match decode::[T](self.text()):
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(.Json(error))

## Why a request failed: invalid URL, DNS, connect, TLS, timeout, too many redirects, not granted, or another reason.
## See [std-http.error.decl-retained-response](../../spec/std/http.md#r-std-http.error.decl-retained-response).
@error
@derive(Debug, Eq)
pub enum HttpError:
    @error("http access to ${host} is not granted")
    NotGranted(host: string)
    @error("invalid URL: ${url}")
    InvalidUrl(url: string)
    @error("cannot resolve host ${host}")
    Dns(host: string)
    @error("$message")
    Connect(message: string)
    @error("TLS failed: ${message}")
    Tls(message: string)
    @error("the request timed out")
    Timeout
    @error("too many redirects; the last went to ${url}")
    TooManyRedirects(url: string)
    @error("$message")
    Other(message: string)
    @error("HTTP status ${response.status} for ${status_url(response.url)}")
    Status(response: Response)
    @error("invalid JSON in the response: ${error}")
    Json(error: JsonError)

# A composed deadline has the same error as the operation it bounds.
impl From[TimedOut] for HttpError:
    fn from(error: TimedOut) -> HttpError:
        .Timeout

impl HttpError:
    ## Whether a timeout, connection failure or retryable status may succeed on retry.
    ## See [std-http.error.transient-kinds](../../spec/std/http.md#r-std-http.error.transient-kinds).
    pub fn is_transient(self) -> bool:
        match self:
            .Timeout => true
            .Connect(_) => true
            .Status(response) =>
                status := response.status
                status == 408 || status == 429 || status == 500 || status == 502 || status == 503 || status == 504
            _ => false

# Status diagnostics show the URL without exposing query or fragment data.
fn status_url(url: string) -> string:
    without_query := url.split_once("?").map(fn(parts): parts._0).unwrap_or(url)
    without_query.split_once("#").map(fn(parts): parts._0).unwrap_or(without_query)

# The host capability to send a request (r-std-http.trait.decl-ref).
## The host capability to send an HTTP request and complete with the whole response.
## See [std-http.trait.decl-ref](../../spec/std/http.md#r-std-http.trait.decl-ref).
pub trait Http:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]

## Sends a GET and checks its response for a 400–599 failure.
## See [std-http.helper.get.checked-response](../../spec/std/http.md#r-std-http.helper.get.checked-response).
pub fn get!(url: string) -> Result[Response, HttpError] $ Http:
    Request::get(url).send!()?.ok()

# Each URL owns one mutable queue, so appending a reply does not copy its
# earlier replies. The cursor stops after the last consumed result.
@derive(Debug)
struct HttpReplies:
    items: List[Result[Response, HttpError]]
    next: usize

## A deterministic Http provider with queued replies and a log of received requests.
## See [std-http.scripted.decl](../../spec/std/http.md#r-std-http.scripted.decl).
@derive(Debug)
pub struct ScriptedHttp:
    responses: Map[string, &mut HttpReplies]
    requests: List[Request]

impl ScriptedHttp:
    ## Returns a new provider with no replies or received requests.
    ## See [std-http.scripted.new-empty](../../spec/std/http.md#r-std-http.scripted.new-empty).
    pub fn new() -> &mut ScriptedHttp:
        &mut ScriptedHttp { responses: {}, requests: [] }

    ## Appends a result to this URL's reply queue.
    ## See [std-http.scripted.reply](../../spec/std/http.md#r-std-http.scripted.reply).
    pub fn reply(&mut self, url: string, result: Result[Response, HttpError]) -> void:
        match self.responses.get(url):
            .Some(replies) => replies.items.push(result)
            .None => self.responses[url] = &mut HttpReplies { items: [result], next: 0 }

    ## The received requests in order, including requests without a reply.
    ## See [std-http.scripted.received-ref](../../spec/std/http.md#r-std-http.scripted.received-ref).
    pub fn received(&self) -> List[Request]:
        self.requests

impl Http for ScriptedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.requests.push(request)
        match self.responses.get(request.url):
            .Some(replies) =>
                index := if replies.next < replies.items.len(): replies.next else: replies.items.len() - 1
                result := replies.items[index]
                if replies.next < replies.items.len():
                    replies.next += 1
                match result:
                    .Ok(response) => .Ok(Response { ...response, url: request.url })
                    .Err(error) => .Err(error)
            .None => .Err(.Connect("ScriptedHttp has no response for ${request.url}"))

fn ascii_case_equal(left: string, right: string) -> bool:
    a := left.to_utf8()
    b := right.to_utf8()
    if a.len() != b.len():
        return false
    let index: usize = 0
    while index < a.len():
        if ascii_lower(a[index]) != ascii_lower(b[index]):
            return false
        index = index + 1
    true

fn ascii_lower(byte: u8) -> u8:
    if byte >= 65 && byte <= 90:
        byte + 32
    else:
        byte

# Decodes `bytes` as UTF-8, with one U+FFFD for each maximal invalid
# subpart, as the WHATWG decoder does.
fn lossy_text(bytes: List[u8]) -> string:
    let mut out: List[u8] = []
    size := bytes.len()
    let index: usize = 0
    while index < size:
        lead := bytes[index]
        let width: usize = 0
        let low: u8 = 128
        let high: u8 = 191
        if lead < 128:
            width = 1
        else if lead >= 194 && lead <= 223:
            width = 2
        else if lead >= 224 && lead <= 239:
            width = 3
            if lead == 224:
                low = 160
            if lead == 237:
                high = 159
        else if lead >= 240 && lead <= 244:
            width = 4
            if lead == 240:
                low = 144
            if lead == 244:
                high = 143
        if width == 0:
            push_replacement(&mut out)
            index = index + 1
        else:
            let at: usize = 1
            let valid = true
            while valid && at < width:
                if index + at >= size:
                    valid = false
                else:
                    next := bytes[index + at]
                    bottom := if at == 1: low else: 128
                    top := if at == 1: high else: 191
                    if next < bottom || next > top:
                        valid = false
                    else:
                        at = at + 1
            if valid:
                let copied: usize = 0
                while copied < width:
                    out.push(bytes[index + copied])
                    copied = copied + 1
                index = index + width
            else:
                push_replacement(&mut out)
                index = index + at
    match string::from_utf8(out):
        .Ok(text) => text
        .Err(_) => ""

fn push_replacement(out: &mut List[u8]) -> void:
    out.push(239)
    out.push(191)
    out.push(189)

# NotGranted describes the refused host (r-std-http.error.not-granted.plain).

# A std error type implements `Error` (r-std-error.std-types.impl.reference-values).
