use dep.server_sdk.server.{HttpServer, serve}
use std.http.{Request, Response}
use std.serde.{Deserialize, Serialize}
use std.time.{Clock, sleep, ms}

struct Hits:
    count: usize

@derive(Deserialize)
struct Input:
    message: string

@derive(Serialize)
struct Reply:
    count: usize
    message: string

fn handle!(request: Request, hits: &mut Hits) -> Response $ Clock:
    input := match request.json::[Input]():
        .Ok(input) => input
        .Err(_) => return Response::status(.BadRequest)
    hits.count = hits.count + 1
    count := hits.count
    if request.url.path.ends_with("/slow"):
        sleep!(ms(150))
    Response::status(.Ok).set_json(Reply { count: count, message: input.message })

pub fn main!() -> void $ HttpServer + Clock + Console:
    hits := &mut Hits { count: 0 }
    serve!(4, hits, handle).expect("server")
    println("total ${hits.count}")
