# calc: tokenizer, recursive-descent parser into an enum, and an evaluator.
# Shows enums with payloads, exhaustive match, Result with `?`, a mutable
# parser cursor, and unit tests.
use std.num.parse_i32
use std.testing.{Arbitrary, assert, assert_equal, it_prop}

enum Token:
    Num(value: i32)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen

data Spanned:
    token: Token
    pos: i32

@derive(Eq, Debug, Arbitrary)
enum Op:
    Add
    Sub
    Mul
    Div

impl Op:
    fn symbol(self) -> string:
        match self:
            .Add => "+"
            .Sub => "-"
            .Mul => "*"
            .Div => "/"

@derive(Eq, Debug, Arbitrary)
enum Expr:
    Lit(value: i32)
    Neg(inner: Expr)
    Bin(op: Op, left: Expr, right: Expr, pos: i32)

@derive(Eq, Debug)
enum CalcError:
    BadChar(ch: char, pos: i32)
    BadNumber(pos: i32)
    Unexpected(pos: i32)
    UnexpectedEnd
    DivByZero(pos: i32)

fn tokenize(src: string) -> Result[List[Spanned], CalcError]:
    let out: mut List[Spanned] = []
    let chars: mut List[char] = []
    for c in src.chars():
        chars.push(c)
    let i = 0
    while i < chars.len():
        c := chars[i]
        if c == ' ':
            i = i + 1
        else if c.is_ascii_digit():
            let start = i
            let text = ""
            while i < chars.len() && chars[i].is_ascii_digit():
                text = text + chars[i].to_string()
                i = i + 1
            match parse_i32(text):
                .Ok(n) => out.push(Spanned { token: .Num(n), pos: start })
                .Err(_) => return .Err(CalcError.BadNumber(start))
        else:
            tok := match c:
                '+' => Token.Plus
                '-' => Token.Minus
                '*' => Token.Star
                '/' => Token.Slash
                '(' => Token.LParen
                ')' => Token.RParen
                _ => return .Err(CalcError.BadChar(c, i))
            out.push(Spanned { token: tok, pos: i })
            i = i + 1
    .Ok(out)

data Parser:
    toks: List[Spanned]
    at: i32

impl Parser:
    fn peek(self) -> Spanned?:
        if self.at < self.toks.len():
            self.toks[self.at]
        else:
            .None

    fn bump(mut self) -> void:
        self.at = self.at + 1

    fn expr(mut self) -> Result[Expr, CalcError]:
        let left = self.term()?
        while true:
            match self.peek():
                .Some(s) =>
                    op := match s.token:
                        .Plus => Op.Add
                        .Minus => Op.Sub
                        _ => break
                    self.bump()
                    right := self.term()?
                    left = Expr.Bin(op, left, right, s.pos)
                .None => break
        .Ok(left)

    fn term(mut self) -> Result[Expr, CalcError]:
        let left = self.unary()?
        while true:
            match self.peek():
                .Some(s) =>
                    op := match s.token:
                        .Star => Op.Mul
                        .Slash => Op.Div
                        _ => break
                    self.bump()
                    right := self.unary()?
                    left = Expr.Bin(op, left, right, s.pos)
                .None => break
        .Ok(left)

    fn unary(mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .Some(s) =>
                match s.token:
                    .Minus =>
                        self.bump()
                        inner := self.unary()?
                        .Ok(Expr.Neg(inner))
                    _ => self.atom()
            .None => .Err(CalcError.UnexpectedEnd)

    fn atom(mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .None => .Err(CalcError.UnexpectedEnd)
            .Some(s) =>
                match s.token:
                    .Num(n) =>
                        self.bump()
                        .Ok(Expr.Lit(n))
                    .LParen =>
                        self.bump()
                        inner := self.expr()?
                        match self.peek():
                            .Some(close) =>
                                match close.token:
                                    .RParen =>
                                        self.bump()
                                        .Ok(inner)
                                    _ => .Err(CalcError.Unexpected(close.pos))
                            .None => .Err(CalcError.UnexpectedEnd)
                    _ => .Err(CalcError.Unexpected(s.pos))

fn parse(src: string) -> Result[Expr, CalcError]:
    toks := tokenize(src)?
    let mut p = Parser { toks: toks, at: 0 }
    e := p.expr()?
    match p.peek():
        .Some(s) => .Err(CalcError.Unexpected(s.pos))
        .None => .Ok(e)

fn eval(e: Expr) -> Result[i32, CalcError]:
    match e:
        .Lit(v) => .Ok(v)
        .Neg(inner) => .Ok(0 - eval(inner)?)
        .Bin(op, l, r, pos) =>
            a := eval(l)?
            b := eval(r)?
            match op:
                .Add => .Ok(a + b)
                .Sub => .Ok(a - b)
                .Mul => .Ok(a * b)
                .Div =>
                    if b == 0:
                        .Err(CalcError.DivByZero(pos))
                    else:
                        .Ok(a / b)

fn calc(src: string) -> Result[i32, CalcError]:
    eval(parse(src)?)

fn describe(error: CalcError) -> string:
    match error:
        .BadChar(ch, pos) => "bad character '${ch}' at ${pos}"
        .BadNumber(pos) => "bad number at ${pos}"
        .Unexpected(pos) => "unexpected token at ${pos}"
        .UnexpectedEnd => "unexpected end of input"
        .DivByZero(pos) => "division by zero at ${pos}"

# Fully parenthesized form; parsing it back yields the same tree.
fn show(e: Expr) -> string:
    match e:
        .Lit(v) => v.to_string()
        .Neg(inner) => "(-${show(inner)})"
        .Bin(op, l, r, _) => "(${show(l)} ${op.symbol()} ${show(r)})"

# Positions depend on the text, and a negative literal parses back as a
# negation, so compare trees with positions cleared and literals made
# non-negative.
fn strip(e: Expr) -> Expr:
    match e:
        .Lit(v) =>
            if v < 0:
                .Neg(.Lit(0 - v))
            else:
                .Lit(v)
        .Neg(inner) => .Neg(strip(inner))
        .Bin(op, l, r, _) => .Bin(op, strip(l), strip(r), 0)

pub fn main() -> void $ Console:
    for src in ["1 + 2 * 3", "(1 + 2) * 3", "-4 * (2 - 5)", "10 / (5 - 5)", "2 +", "3 $ 4", "7 / 2"]:
        match calc(src):
            .Ok(v) => println("$src = $v")
            .Err(e) => println("$src -> error: ${describe(e)}")

tests:
    it("precedence"):
        assert_equal(calc("1 + 2 * 3"), .Ok(7), reason="mul binds tighter")
        assert_equal(calc("(1 + 2) * 3"), .Ok(9), reason="parens")
        assert_equal(calc("10 - 4 - 3"), .Ok(3), reason="left associative")
    it("unary minus"):
        assert_equal(calc("-4 * (2 - 5)"), .Ok(12), reason="neg")
    it("errors carry positions"):
        assert_equal(calc("10 / (5 - 5)"), .Err(CalcError.DivByZero(3)), reason="div")
        assert_equal(calc("3 $ 4"), .Err(CalcError.BadChar('$', 2)), reason="char")
        assert_equal(calc("2 +"), .Err(CalcError.UnexpectedEnd), reason="end")
        assert_equal(calc("2 3"), .Err(CalcError.Unexpected(2)), reason="trailing")
    it("show then parse round-trips a fixed tree"):
        e := Expr.Bin(.Mul, .Neg(.Lit(2)), .Bin(.Add, .Lit(1), .Lit(3), 0), 0)
        assert_equal(show(e), "((-2) * (1 + 3))", reason="show")
        match parse(show(e)):
            .Ok(back) => assert_equal(strip(back), e, reason="round trip")
            .Err(_) => assert(false, reason="reparse failed")
    it_prop("show then parse is the identity on trees", prop=fn!(e: Expr):
        match parse(show(e)):
            .Ok(back) => assert_equal(strip(back), strip(e), reason="round trip")
            .Err(_) => assert(false, reason="reparse failed")
    )
