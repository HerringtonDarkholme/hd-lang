data Counter:
    value: i32

fn adjust(counter: Counter, enabled: bool) -> i32:
    if enabled:
        counter.value + 1
    else:
        counter.value

pub fn main() -> void $ Console:
    let total: i32 = 0
    while total < 6:
        total = total + 1
    println("${adjust(Counter { value: total }, true)}")
