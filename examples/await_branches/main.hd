# Bang calls inside branches and loops (#146): a guarded comprehension,
# a trailing `if`, a `while` body, a `break` value, a branch tail, a
# `for` over a range followed by a value, and a retry loop. Each runs on
# the ready path, then on the resume path.
use std.time.{Clock, ms, sleep}

# Waits on the host timer when `millis` is positive (the resume path), else
# completes at once (the ready path).
fn fetch!(n: i32, millis: i64) -> i32 $ Clock:
    if millis > 0:
        sleep!(ms(millis))
    n * 10

fn guarded!(ids: List[i32], millis: i64) -> List[i32] $ Clock:
    [for id in ids if id != 2 => fetch!(id, millis)]

fn trailing_if!(millis: i64) -> void $ Clock:
    if true:
        _ := fetch!(1, millis)

fn while_body!(millis: i64) -> i32 $ Clock:
    let count = +0
    while count < 3:
        _ := fetch!(count, millis)
        count = count + 1
    count

fn break_value!(millis: i64) -> i32 $ Clock:
    total := while true:
        break fetch!(4, millis)
    else:
        0
    total + 1

fn branch_tail!(flag: bool, millis: i64) -> i32 $ Clock:
    if flag:
        fetch!(5, millis)
    else:
        fetch!(6, millis)

fn range_sum!(millis: i64) -> i32 $ Clock:
    let sum = +0
    for k in 0..3:
        sum = sum + fetch!(k, millis)
    sum + 1

fn retry!(millis: i64) -> i32 $ Clock:
    let tries = +0
    while true:
        tries = tries + 1
        if fetch!(tries, millis) >= 30:
            break
    tries

pub fn main!() -> void $ Console + Clock:
    for millis in [0, 1]:
        xs := guarded!([1, 2, 3], millis)
        trailing_if!(millis)
        println("${xs.len()} ${xs[0]} ${xs[1]} ${while_body!(millis)} ${break_value!(millis)} ${branch_tail!(true, millis)} ${branch_tail!(false, millis)} ${range_sum!(millis)} ${retry!(millis)}")
