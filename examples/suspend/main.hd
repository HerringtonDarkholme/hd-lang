use std.ops.defer
use std.time.{Clock, Duration, sleep}
use std.task.{all, race}

# Logs its start, sleeps on the host timer, then logs its end; its
# cleanup runs on completion and on cancellation alike.
fn work!(n: i32, ms: i64, log: &mut List[string]) -> i32 $ Clock:
    log.push("start $n")
    defer(fn() -> void: log.push("cleanup $n"))
    sleep!(Duration::milliseconds(ms))
    log.push("done $n")
    n * 10

pub fn main!() -> void $ Console + Clock:
    let mut log: List[string] = []
    sleep!(Duration::milliseconds(2))
    println("slept")
    # The 245ms gap keeps task 2 first even when timer wakes coalesce
    # under load; a 15ms gap reordered the log (issue #55).
    let (a, b) = all!(work(1, 250, &mut log), work(2, 5, &mut log))
    println("all $a $b")
    w := race!(work(3, 5, &mut log), work(4, 500, &mut log))
    println("race $w")
    for line in log:
        println(line)
