# Structured concurrency: `all!` runs two calls together and joins them.
fn page!(id: i32) -> string $ Clock:
    let (profile, orders) = all!(fetch_profile(id), fetch_orders(id))  # ← both at once
    "${profile.name} has ${orders.len()} orders"

tests:
    it("both results arrive together, on a fake clock"):
        let clock: mut ManualClock = ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Clock=clock):
            assert_equal(page!(7), "user-7 has 2 orders", reason="joined page")

# ── plumbing ──────────
use std.task.all
use std.testing.assert_equal
use std.time.{Clock, ManualClock, Timestamp, ms}

data Profile:
    name: string

# Stand-ins for two services: each waits on the injected clock.
fn fetch_profile!(id: i32) -> Profile $ Clock:
    let mut clock = $.use(Clock)
    clock.sleep!(120ms)
    Profile { name: "user-$id" }

fn fetch_orders!(id: i32) -> List[string] $ Clock:
    let mut clock = $.use(Clock)
    clock.sleep!(80ms)
    ["book", "lamp"]

pub fn main!() -> void $ Console:
    let clock: mut ManualClock = ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Clock=clock):
        println(page!(7))
