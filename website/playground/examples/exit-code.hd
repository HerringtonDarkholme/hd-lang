# `?` in `main` turns an early error into a failing exit code.
pub fn main() -> Result[ExitCode, string] $ Console:
    changed := changed_files(["a.hd", "b.hd"])?  # ← an `.Err` exits with 1
    println("${changed.len()} files changed")
    .Ok(if changed.len() > 0: ExitCode(1) else: ExitCode(0))

# ── plumbing ──────────
use std.process.ExitCode

fn changed_files(paths: List[string]) -> Result[List[string], string]:
    if paths.len() == 0:
        return .Err("no paths given")
    .Ok(paths)
