# `main` returns any `Termination` type: `void`, an `ExitCode`, or a
# `Result` over one. `ExitCode(0)` is success; an `.Err` exits with 1.
use std.process.ExitCode

fn changed_files(paths: List[string]) -> Result[List[string], string]:
    if paths.len() == 0:
        return .Err("no paths given")
    .Ok(paths)

pub fn main() -> Result[ExitCode, string] $ Console:
    changed := changed_files(["a.hd", "b.hd"])?
    changes := changed.len()
    println("$changes files changed")
    .Ok(if changes > 0: ExitCode(1) else: ExitCode(0))
