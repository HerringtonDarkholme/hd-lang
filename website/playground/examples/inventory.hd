# No class, no `new`, no null: a missing item is `.None`.
fn find(items: List[Item], sku: string) -> Item?:  # ← the type says it may be missing
    for item in items:
        if item.sku == sku:
            return .Some(item)
    .None

tests:
    it("a missing sku is .None, never null"):
        assert_equal(find(stock(), "sofa"), .None, reason="no sofa")
        assert_equal(find(stock(), "lamp"), .Some(Item { sku: "lamp", on_hand: 3 }), reason="lamp")

# ── plumbing ──────────
use std.testing.assert_equal

@derive(Debug, Eq)
data Item:
    sku: string
    on_hand: i32

fn stock() -> List[Item]:
    [Item { sku: "lamp", on_hand: 3 }, Item { sku: "desk", on_hand: 12 }]

pub fn main() -> void $ Console:
    match find(stock(), "sofa"):
        .Some(item) => println("found ${item.sku}")
        .None => println("no sofa in stock")
