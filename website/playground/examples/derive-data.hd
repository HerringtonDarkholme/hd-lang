# One type, three derivations: JSON, validation, and a table schema.
@derive(Serialize, Deserialize, Table)
struct User:
    @column("user_id") # ← a typed fact that only Table reads
    id: i64
    email: string

impl Validate for User by Structure:
    email = [email()]

pub fn main() -> void $ Console:
    println("SELECT ${User::columns()} FROM users")
    println(encode(User { id: 7, email: "ada@example.com" }))
    bob := decode::[User]("{\"id\":8,\"email\":\"bob\"}").expect("JSON")
    println(bob.validated().err().expect("bob is invalid"))

# Run prints:
#   SELECT user_id, email FROM users
#   {"id":7,"email":"ada@example.com"}
#   $.email: must be a valid email address

# ── plumbing ──────────
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}
use std.structure.{Describer, Field, Structure, Variant}
use std.validate.{Validate, email}

# Table is a library trait: its template is plain hd over the type's members.
struct Column:
    name: string

fn column(name: string) -> Column:
    Column { name: name }

trait Table:
    fn columns() -> string

impl[T] Table for T by Structure:
    fn columns() -> string:
        let mut list = ColumnList { names: "" }
        _ := T::describe(&mut list)
        list.names

struct ColumnList:
    names: string

impl[S] Describer[S] for ColumnList:
    type Error = never

    fn variant(&mut self, v: Variant[S]) -> Result[void, never]:
        .Ok(())

    fn member[F](&mut self, h: Field[S, F]) -> Result[void, never]:
        name := match h.info.facts.find::[Column]():
            .Some(column) => column.name
            .None => h.info.name
        separator := if self.names == "": "" else: ", "
        self.names = "${self.names}$separator$name"
        .Ok(())
