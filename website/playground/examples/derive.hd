# One line of `@derive` gives property tests. They find the bug examples miss.
@derive(Arbitrary, Debug, Eq)
data Money:
    cents: i32

tests:
    it_prop("parse undoes print", prop=fn!(m: Money):
        if m.cents > -2147483648:  # 0 - MIN overflows
            assert_equal(parse(print(m)), .Some(m), reason="round trip")
    )

# The first `print` wrote 5 cents as "0.5", which `parse` rejects.
# Two hand-picked examples (150 and 1200) passed. `hd test` then reported:
#   property test "parse undoes print" shrunk input Money { cents: -1000 };
#   assertion-failed: round trip: actual Option.None, expected Option.Some(Money { cents: -1000 })

# ── plumbing ──────────
use std.num.parse_i32
use std.testing.{Arbitrary, assert_equal, it_prop}

fn pad(n: i32) -> string:
    if n < 10:
        "0$n"
    else:
        n.to_string()

fn print(m: Money) -> string:
    sign := if m.cents < 0: "-" else: ""
    abs := if m.cents < 0: 0 - m.cents else: m.cents
    "$sign${abs / 100}.${pad(abs % 100)}"

fn parse(text: string) -> Money?:
    negative := text.starts_with("-")
    body := if negative: text.slice(1, text.len()) else: text
    match body.split_once("."):
        .None => .None
        .Some((whole, frac)) =>
            if frac.len() != 2:
                return .None
            match parse_i32(whole):
                .Err(_) => .None
                .Ok(w) =>
                    match parse_i32(frac):
                        .Err(_) => .None
                        .Ok(f) =>
                            cents := w * 100 + f
                            .Some(Money { cents: if negative: 0 - cents else: cents })

pub fn main() -> void $ Console:
    for cents in [5, 150, -1000]:
        println(print(Money { cents: cents }))
