# Tests live next to the code. Run `hd test`: nothing to install.
tests:
    use std.testing.{assert_equal, it_each, snapshot}

    it("lowers and joins words"):
        assert_equal(slug(" Hello World "), "hello-world", reason="trimmed and joined")

    it_each("keeps one word", ["hd", "lang"], body=fn!(word: string):  # ← one case per row
        assert_equal(slug(word), word, reason="nothing to change")
    )

    it("renders a title"):
        snapshot(slug("Tests And Snapshots"), expect="tests-and-snapshots")

    it("an empty list has no first item", expect_panic="index-out-of-bounds"):
        _ := first([])

# ── plumbing ──────────
fn slug(title: string) -> string:
    title.trim().lower().replace(" ", "-")

fn first(items: List[i32]) -> i32: items[0]
