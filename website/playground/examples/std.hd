# Messy input, no crashes: a bad row is a `.None` you handle.
fn score(line: string) -> i32?:
    match parse_i32(line.split(" ")[1]):
        .Ok(n) => .Some(n)  # ← the number, or...
        .Err(_) => .None  # ← ...a value to handle

tests:
    use std.testing.assert_equal

    it("a bad row is None, not a crash"):
        assert_equal(score("ada 36"), .Some(36), reason="good row")
        assert_equal(score("bob x"), .None, reason="bad row")

# ── plumbing ──────────
use std.num.parse_i32
use std.text.join

pub fn main() -> void $ Console:
    let names: mut List[string] = []
    for line in "ada 36\nbob x\ncy 41\n".lines():
        match score(line):
            .Some(_) => names.push(line.split(" ")[0].upper())
            .None => println("skipped '$line'")
    println(join(names, ", "))
