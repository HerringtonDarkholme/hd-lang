# A number with a suffix calls its suffix function, one marked
# `@num_suffix`: `12px` means `px(12)`. `std.time` declares `ms`, `s`,
# `min`, and `h`, so `250ms` and `5s` are both a `Duration`.
use std.ops.num_suffix
use std.time.{Duration, ms, s}

data Pixels:
    count: i32

@num_suffix
fn px(count: i32) -> Pixels: Pixels { count: count }

fn add(a: Pixels, b: Pixels) -> Pixels: Pixels { count: a.count + b.count }

fn backoff() -> List[Duration]: [250ms, 1s, 5s]

pub fn main() -> void $ Console:
    width := add(12px, -4px)
    println("width ${width.count}px")
    println("${backoff().len()} retry delays")
