# Units live in the type: `250ms` is a Duration, `12px` is Pixels.
fn backoff() -> List[Duration]: [250ms, 1s, 5s]  # ← a retry schedule reads as data

tests:
    it("pixels add as pixels"):
        assert_equal(add(12px, 4px).count, 16, reason="sum")

# Pass pixels where a Duration is expected and it won't compile:
#     wait(12px)
#     error: type-mismatch: expected Duration, found Pixels

# ── plumbing ──────────
use std.ops.num_suffix
use std.testing.assert_equal
use std.time.{Duration, ms, s}

data Pixels:
    count: i32

@num_suffix
fn px(count: i32) -> Pixels: Pixels { count: count }

fn add(a: Pixels, b: Pixels) -> Pixels: Pixels { count: a.count + b.count }

fn wait(delay: Duration) -> void: pass

pub fn main() -> void $ Console:
    println("width ${add(12px, 4px).count}px")
    println("${backoff().len()} retry delays")
