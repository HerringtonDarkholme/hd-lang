# `main` limits what the whole program can reach.
pub fn main!() -> void $ Console:  # ← the console, and nothing else
    let mut outbox = Outbox { sent: [] }
    $.with(Mailer=&mut outbox, Clock=epoch()):
        welcome!("ada@example.com")
    println(outbox.sent[0])

# `welcome!` needs `Mailer + Clock`, and the `$.with` installs both.
# Nothing else is reachable: no files, no network.

# ── plumbing ──────────
use std.time.{Clock, ManualClock, Timestamp}

fn welcome!(email: string) -> void $ Mailer + Clock:
    mailer := $.use(Mailer)
    mailer.send!(email, "Welcome at ${$.use(Clock).now()}")

trait Mailer:
    fn send!(&mut self, to: string, body: string) -> void

struct Outbox:
    sent: List[string]

impl Mailer for Outbox:
    fn send!(&mut self, to: string, body: string) -> void:
        self.sent.push("$to|$body")

fn epoch() -> *mut ManualClock:
    ManualClock::new(Timestamp::from_unix_milliseconds(0))
