# Add a variant. The compiler lists every `match` to update.
fn can_cancel(status: OrderStatus) -> bool:
    match status:
        .Pending => true
        .Paid(_) => true
        .Shipped(_) => false
        .Cancelled => false

tests:
    it("shipped orders cannot be cancelled"):
        assert_equal(can_cancel(.Shipped("DHL")), false, reason="too late")

# Add `Refunded(cents: i32)` to OrderStatus and it won't compile:
#     main.hd:3:5: nonexhaustive-match: match does not cover: Refunded
#     main.hd:29:5: nonexhaustive-match: match does not cover: Refunded
# A `_ =>` arm would have hidden both.

# ── plumbing ──────────
use std.testing.assert_equal

enum OrderStatus:
    Pending
    Paid(cents: i32)
    Shipped(carrier: string)
    Cancelled

fn label(status: OrderStatus) -> string:
    match status:
        .Pending => "waiting for payment"
        .Paid(cents) => "paid ${cents / 100} dollars"
        .Shipped(carrier) => "on its way with $carrier"
        .Cancelled => "cancelled"

pub fn main() -> void $ Console:
    for status in [OrderStatus.Pending, OrderStatus.Paid(4999), OrderStatus.Shipped("DHL")]:
        println("${label(status)}; can cancel: ${can_cancel(status)}")
