use std.random.Rng
use std.text.StringBuilder

# Generation parameters bound program size, not the language. Expression
# construction is iterative; each expression has at most three extra layers.
pub struct Program:
    pub source: string
    pub expressions: List[string]

struct State:
    rng: *mut Rng
    values: List[string]
    expressions: List[string]

impl State:
    fn literal(&mut self) -> string:
        match self.rng.int(0usize..6usize):
            0 => "0i64"
            1 => "1i64"
            2 => "-1i64"
            3 => "9223372036854775807i64"
            4 => "-9223372036854775808i64"
            _ => "${self.rng.int(-1000i64..=1000i64)}i64"

    fn atom(&mut self) -> string:
        if self.rng.bool():
            return self.literal()
        self.values[self.rng.int(0usize..self.values.len())]

    fn expression(&mut self) -> string:
        let text = self.atom()
        for _ in 0..self.rng.int(0usize..4usize):
            other := self.atom()
            text = match self.rng.int(0usize..5usize):
                0 => "(${text}).wrapping_add(${other})"
                1 => "(${text}).wrapping_sub(${other})"
                2 => "(${text}).wrapping_mul(${other})"
                3 => "(${text} ^ ${other})"
                _ => "(if ${text} < ${other}: ${text} else: ${other})"
        self.expressions.push(text)
        text

fn declarations() -> string:
    out := StringBuilder::new()
    out.push("use std.ops.Fn\n\n")
    out.push("struct Record:\n    number: i64\n    text: string\n    items: List[i64]\n\n")
    out.push("enum Choice:\n    One(value: i64)\n    Two(pair: (i64, i64))\n    Empty\n\n")
    out.push(
        "fn optional(value: i64?, other: i64) -> i64:\n    let .Some(found) = value else: return other\n    found\n\n",
    )
    out.push(
        "fn choose(value: Choice) -> i64:\n    match value:\n        .One(number) => number\n        .Two(pair) => pair._0.wrapping_add(pair._1)\n        .Empty => 0i64\n\n",
    )
    out.push("fn direct(body: fn(i64) -> i64, value: i64) -> i64: body(value)\n\n")
    out.push("fn generic[F < Fn[(i64,), i64]](body: F, value: i64) -> i64: body(value)\n\n")
    out.push(
        "fn read_record(value: &Record) -> i64:\n    value.number.wrapping_add(i64(value.text.len())).wrapping_add(i64(value.items.len()))\n\n",
    )
    out.push(
        "fn change_record(value: &mut Record, delta: i64) -> void:\n    value.number = value.number.wrapping_add(delta)\n    value.items.push(value.number)\n    value.text = value.text + \"!\"\n\n",
    )
    out.build()

# Each block yields an i64 witness. Later expressions can use any earlier
# witness, so the constructs interact instead of running as isolated samples.
fn block(state: *mut State, out: *mut StringBuilder, kind: usize, serial: usize) -> void:
    name := "local_${serial}"
    saved := "saved_${serial}"
    value := "value_${serial}"
    a := state.expression()
    b := state.expression()
    c := state.expression()
    record := "Record { number: ${a}, text: \"λ🦀\", items: [${b}, ${c}] }"
    out.push("    # construct ${kind}\n")
    match kind:
        0 =>
            out.push("    ${name} := ${record}\n    ${saved} := ${name}\n")
            out.push(
                "    ${value} := read_record(&${saved}).wrapping_add(${name}.items[${state.rng.int(0usize..2usize)}])\n",
            )
        1 =>
            selected := match state.rng.int(0usize..3usize):
                0 => "Choice.One(${a})"
                1 => "Choice.Two((${a}, ${b}))"
                _ => "Choice.Empty"
            out.push(
                "    ${name} := ${selected}\n    ${value} := choose(${name}).wrapping_add(${c})\n",
            )
        2 =>
            out.push("    ${name} := (${a}, ${record}, [${b}, ${c}])\n")
            out.push(
                "    ${value} := ${name}._0.wrapping_add(read_record(&${name}._1)).wrapping_add(${name}._2[1])\n",
            )
        3 =>
            selected := if state.rng.bool(): ".Some(${a})" else: ".None"
            out.push(
                "    let ${name}: i64? = ${selected}\n    ${value} := optional(${name}, ${b})\n",
            )
        4 =>
            out.push("    let mut ${name} = [${a}, ${b}, ${c}]\n    ${saved} := ${name}\n")
            out.push(
                "    ${name}[${state.rng.int(0usize..3usize)}] = ${b}\n    ${name}.push(${c})\n",
            )
            out.push(
                "    let ${value} = ${saved}[${state.rng.int(0usize..3usize)}]\n    for item_${serial} in ${name}:\n        ${value} = ${value}.wrapping_add(item_${serial})\n",
            )
        5 =>
            out.push(
                "    let mut ${name}: Map[string, i64] = {\"a\": ${a}, \"b\": ${b}}\n    ${saved} := ${name}\n",
            )
            out.push(
                "    ${name}[\"a\"] = ${b}\n    ${name}[\"c\"] = ${c}\n    let ${value} = ${saved}[\"a\"]\n",
            )
            out.push(
                "    for (key_${serial}, item_${serial}) in ${name}:\n        ${value} = ${value}.wrapping_add(*item_${serial}).wrapping_add(i64(key_${serial}.len()))\n",
            )
        6 =>
            text := if state.rng.bool(): "λ🦀abc" else: "éz"
            out.push(
                "    ${name} := \"${text}\" + \"more\"\n    ${value} := i64(${name}.len()).wrapping_add(i64(${name}.chars().count())).wrapping_add(${a})\n",
            )
        7 =>
            limit := state.rng.int(2usize..10usize)
            skip := state.rng.int(0usize..limit)
            stop := state.rng.int(0usize..limit)
            inner := state.rng.int(1usize..4usize)
            out.push(
                "    let ${value} = ${a}\n    for index_${serial} in 0..${limit}:\n        if index_${serial} == ${skip}: continue\n",
            )
            out.push(
                "        let inner_${serial} = 0usize\n        while inner_${serial} < ${inner}:\n            inner_${serial} += 1\n            ${value} = ${value}.wrapping_add(i64(index_${serial})).wrapping_mul(${b})\n",
            )
            out.push("        if index_${serial} == ${stop}: break\n")
        8 =>
            out.push(
                "    ${saved} := ${a}\n    let ticks_${serial} = 0i64\n    ${name} := fn(number: i64) -> i64:\n        ticks_${serial} = ticks_${serial}.wrapping_add(1)\n        number.wrapping_add(${saved})\n",
            )
            out.push(
                "    ${value} := generic(fn(number: i64) -> i64: number.wrapping_add(${saved}), ${b}).wrapping_add(direct(${name}, ${c})).wrapping_add(ticks_${serial})\n",
            )
        9 =>
            out.push(
                "    let mut ${name} = ${record}\n    ${saved} := ${name}\n    change_record(&mut ${name}, ${b})\n",
            )
            out.push("    ${value} := read_record(&${name}).wrapping_add(read_record(&${saved}))\n")
        _ =>
            out.push(
                "    ${name} := box(${record})\n    ${saved} := ${name}\n    change_record(&mut *${name}, ${b})\n",
            )
            out.push("    ${value} := read_record(&*${saved}).wrapping_add(${name}.number)\n")
    state.values.push(value)

pub fn generate(seed: u64) -> Program:
    state := box(State { rng: Rng::new(seed), values: ["0i64"], expressions: [] })
    out := StringBuilder::new()
    out.push("# fuzz seed ${seed}\n")
    out.push(declarations())
    out.push("fn checksum() -> i64:\n")
    let mut kinds = [for kind in 0..11usize => kind]
    state.rng.shuffle(&mut kinds)
    for (serial, kind) in kinds.enumerate():
        block(state, out, kind, serial)
    extra := state.rng.int(0usize..8usize)
    for n in 0..extra:
        block(state, out, state.rng.int(0usize..11usize), kinds.len() + n)
    out.push("    let total = 0i64\n")
    for value in state.values:
        out.push("    total = total.wrapping_add(${value})\n")
    out.push("    total\n\npub fn main() -> void \$ Console:\n    println(checksum())\n")
    Program { source: out.build(), expressions: state.expressions }

tests:
    it("one seed reproduces exactly"):
        a := generate(123u64)
        b := generate(123u64)
        assert_equal(a.source, b.source)
        assert_equal(a.expressions, b.expressions)

    it("every program covers all eleven constructs"):
        source := generate(1u64).source
        for kind in 0..11usize:
            assert(source.contains("# construct ${kind}\n"))
