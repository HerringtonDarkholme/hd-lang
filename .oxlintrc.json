{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "max-lines": [
      "error",
      {
        "max": 1500
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "curly": [
      "error",
      "all"
    ],
    "promise/no-callback-in-promise": "error",
    "promise/no-new-statics": "error",
    "promise/valid-params": "error"
  },
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "promise"
  ]
}
