#### T01 requirement clause after function-typed result: owner?
fn make() -> fn() -> i32 $ Console:
    pass
#### T02 closure header with function-typed result and requirement
fn main() -> void:
    f := fn() -> fn() -> i32 $ Console: g
#### T03 function type result optional
fn f(x: fn() -> i32?) -> void:
    pass
#### T04 trait method bodyless vs default
trait Show:
    fn show(self) -> string
    fn twice(self) -> string: self.show()
#### T05 supertrait with generic and bound
trait Child[T < Eq] < Parent[T] + Other:
    fn f(self) -> T
#### T06 marker trait with supertrait
trait Marker < Parent
#### T07 where clause in impl
impl[T] Show for Box[T] where T < Show:
    fn show(self) -> string: "box"
#### T08 impl generic params then type starting with bracket? (tuple type)
impl[T] Show for (T, T):
    fn show(self) -> string: "pair"
#### T09 qualified call with type args on trait and member
fn main() -> void:
    x := Add[Money]::add[i32](a, b)
#### T10 qualified suspending call with member type args
fn main!() -> void:
    x := Store::load[User]!(key)
#### T11 generic function reference without call
fn main() -> void:
    f := first[string]
#### T12 index then call
fn main() -> void:
    x := handlers[0](event)
#### T13 optional propagation then member
fn f() -> i32?:
    x := a?.b?.c
    x
#### T14 optional type in let
fn main() -> void:
    let x: i32? = nil
#### T15 optional pattern
fn main() -> void:
    match v:
        x? => pass
        nil => pass
#### T16 bang call on member and generic
fn main!() -> void:
    x := db.get[User]!(id)
#### T17 bang function declaration and bang type
fn fetch!(url: string) -> string $ Net:
    pass
#### T18 suspending closure
fn main() -> void:
    f := fn!() -> i32: 1
#### T19 not-equal vs bang call spacing
fn main() -> void:
    x := a != b
    y := a ! (b)
#### T20 interpolation of reserved word self
fn show(self) -> string:
    "value: $self"
#### T21 interpolation followed by dot
fn main() -> void:
    s := "$name.len"
#### T22 dollar digit in string
fn main() -> void:
    s := "costs $5"
#### T23 context use and context type
fn f(c: $.Context[Clock + Log]) -> void $ Clock:
    x := $.use(Clock)
#### T24 row type argument vs type argument
fn main() -> void:
    x := run[Clock + Log](f)
#### T25 empty row argument
fn main() -> void:
    x := run[$()](f)
#### T26 data expression vs map
fn main() -> void:
    p := Point { x: 1, y: 2 }
    m := { x: 1, y: 2 }
#### T27 data pattern uses = while data literal uses :
fn main() -> void:
    match p:
        Point { x: 0, y } => pass
        _ => pass
#### T28 named argument uses =
fn main() -> void:
    f(a, retries = 3)
#### T29 keyword member name after dot
fn main() -> void:
    x := token.type
#### T30 keyword as named argument label
fn main() -> void:
    f(type = 1)
#### T31 contextual test as identifier
fn test() -> void:
    pass
#### T32 contextual pack as a local variable with a map method
fn main() -> void:
    pack := [1, 2]
    y := pack.map(xs, f)
#### T33 derive as an ordinary decorator function name
@derive(Eq)
data P:
    pass
#### T34 enum variant with generic params and result
enum Expr[T]:
    IntLit(value: i32) -> Expr[i32]
    Pair[A, B](left: Expr[A], right: Expr[B]) -> Expr[(A, B)]
#### T35 variant result with arguments
enum Status(code: i32):
    NotFound -> Status(404)
#### T36 type alias vs newtype
type Id = i32
type UserId(i32)
#### T37 tuple type vs grouped type
fn f(a: (i32,), b: (i32), c: ()) -> void:
    pass
#### T38 mut function type vs mut result
fn f(g: mut fn() -> mut User) -> void:
    pass
#### T39 generic parameter with variance
data Box[+T]:
    value: T
#### T40 negative literal pattern
fn main() -> void:
    match n:
        -1 => pass
        _ => pass
#### T41 power with unary
fn main() -> void:
    x := -2 ** -2
#### T42 comparison is
fn main() -> void:
    x := a is b
#### T43 shape expression
fn main() -> void:
    s := shape(Point)
#### T44 annotation runtime access
fn main() -> void:
    a := Point::annotation(Validation)
#### T45 facet annotation with expression facet
annotate Validation(max = 3) for Point:
    pass
#### T46 member metadata annotate
annotate Point.name:
    label = "Name"
#### T47 pack map
fn f[T...](values: T...) -> void:
    x := pack.map(values, box)
#### T48 use forms
use std.io
use pkg.models as m
pub use super.shared.{Email, Phone as P}
#### T49 grouped binding in parens vs tuple
fn main() -> void:
    t := (a, b := pair)
    u := (a, (b := pair))
#### T50 decorator on parameter
fn f(@range(0, 10) x: i32) -> void:
    pass
#### T51 enum parameter with default
enum Level(weight: i32 = 1):
    Low
#### T52 associated type projection in parameter
fn f[T < Iter](it: T) -> T::Item:
    pass
#### T53 Self projection
trait Iter:
    type Item
    fn next(mut self) -> Self::Item?
#### T54 trailing block on generic call
fn main() -> void:
    with_lock[State]:
        go()
#### T55 generic bound with mut
fn f[T < mut Show](x: T) -> void:
    pass
#### T56 vararg with default (spec says syntax error)
fn f(xs: i32 = 1...) -> void:
    pass
#### T57 map comprehension
fn main() -> void:
    m := {for k in ks => k: 1}
#### T58 spread in list and args
fn main() -> void:
    f(xs...)
    t := (xs...)
#### T59 copy update
fn main() -> void:
    q := Point { ...p, x: 1 }
#### T60 empty map vs empty data
fn main() -> void:
    m := {}
    p := Unit {}
