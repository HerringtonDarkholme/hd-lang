#### R01 bracketed for with indented body in a list (spec: valid)
fn main() -> void:
    v := [for x in xs:
        x
    ]
#### R02 bracketed if with indented body in a list (spec: valid)
fn main() -> void:
    v := [if c:
        1
    else:
        2]
#### R03 map item whose value is an equality comparison
fn main() -> void:
    m := {
        a: b == c,
    }
#### R04 data literal field whose value is an equality comparison
fn main() -> void:
    p := Flag {
        on: x == y,
    }
#### R05 interpolated reserved word
fn f(self) -> string:
    "$self and $true"
#### R06 raw char literal spelling
fn main() -> void:
    c := r'a'
#### R07 closing delimiter ends the body line of an if inside parens
fn main() -> void:
    x := (if c:
        1
    else:
        2)
#### R08 comparison chain regex vs function type in a where clause
impl[T] Show for Box[T] where T < Show:
    fn show(self) -> string: "box"
#### R09 map key comparison inside call on one line
fn main() -> void:
    f({a: b == c})
#### R10 named argument whose value is a comparison, then a closure
fn main() -> void:
    f(flag = a == b, fn(): go())
#### R11 tuple index with separator
fn main() -> void:
    x := t.1_0
#### R12 dedent to a non-level column inside brackets
fn main() -> void:
    f(fn(a):
            one()
          two()
    )
#### R13 multi-line parameter decorator inside an impl method (spec: decorators only on module-level functions)
impl P:
    fn f(
        @range(0, 1)
        x: i32,
    ) -> void:
        pass
#### R14 comparison chaining regex across a closure boundary
fn main() -> void:
    ok := check(fn(x: i32) -> bool: x > 0) == true
#### R15 missing-let regex on a keyword-argument line inside a multiline call
fn main() -> void:
    f(
        a == b,
    )
#### R16 missing-let false positive: map literal line in a continuation with == in value
fn main() -> void:
    m := {"k": a == b}
#### R17 trailing-block-position regex on list of closures
fn main() -> void:
    fs := [fn(x: i32) -> i32:
        x
    ]
