# Count word frequencies in a paragraph and print the top 5.

fn count_words(text: string) -> Map[string, usize]:
    let counts: mut Map[string, usize] = {}
    spaced := text.lower().replace(".", " ").replace(",", " ").replace(";", " ").replace("!", " ").replace("?", " ")
    for word in spaced.split_whitespace():
        counts[word] = counts.get(word).unwrap_or(0) + 1
    counts

fn top_words(counts: Map[string, usize], n: usize) -> List[(string, usize)]:
    let pairs: mut List[(string, usize)] = []
    for (word, count) in counts:
        pairs.push((word, count))
    sorted := pairs.sorted_by_key(fn(pair: (string, usize)) -> i32: 0 - i32(pair._1))
    sorted.take(n)

paragraph := "The quick brown fox jumps over the lazy dog. The dog sleeps, and the fox runs. A fox is quick; the dog is lazy. The end."

counts := count_words(paragraph)
for (word, count) in top_words(counts, 5):
    println("$word: $count")
