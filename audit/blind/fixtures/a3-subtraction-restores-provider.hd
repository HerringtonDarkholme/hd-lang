# test: a row-subtracting provider is visible to the callback only, then the outer one returns
# expect: test
use std.testing.assert_equal

trait Tag:
    fn name(self) -> string

data FixedTag:
    value: string

impl Tag for FixedTag:
    fn name(self) -> string:
        self.value

fn current() -> string $ Tag:
    $.use(Tag).name()

fn provide_inner[r](callback: fn() -> string $ r) -> string $ (r - Tag):
    $.with(Tag=FixedTag { value: "inner" }):
        callback()

test "callback sees the local provider, caller sees its own afterwards":
    $.with(Tag=FixedTag { value: "outer" }):
        seen := provide_inner(current)
        after := current()
        assert_equal(seen, "inner", reason="removed key is supplied inside the callee")
        assert_equal(after, "outer", reason="outer provider is restored lexically")

test "subtracted row needs no provider at the call site":
    assert_equal(provide_inner(current), "inner", reason="r - Tag normalizes to the empty row")

test "a closure that captured a provider keeps it inside the subtracting callee":
    reader := $.with(Tag=FixedTag { value: "captured" }):
        fn() -> string: current()
    assert_equal(provide_inner(reader), "captured", reason="closure providers bind at creation")
