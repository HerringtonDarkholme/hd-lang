# test: NaN makes every relational operator false, directly and inside composites
# expect: test
use std.testing.assert

fn lower[T: PartialOrd](left: T, right: T) -> bool:
    left < right

fn at_least[T: PartialOrd](left: T, right: T) -> bool:
    left >= right

test "all four relational operators are false for NaN":
    nan := 0.0 / 0.0
    assert(not (nan < 1.0), reason="<")
    assert(not (nan <= 1.0), reason="<=")
    assert(not (nan > 1.0), reason=">")
    assert(not (nan >= 1.0), reason=">=")
    assert(not (1.0 < nan), reason="NaN on the right")
    assert(not lower(nan, 1.0), reason="generic < is unordered")
    assert(not at_least(nan, nan), reason="generic >= is unordered")

test "composite ordering stops at the first unordered element":
    nan := 0.0 / 0.0
    assert(not ([nan, 1.0] < [nan, 2.0]), reason="first element unordered")
    assert(not ([nan, 1.0] >= [nan, 2.0]), reason="unordered makes >= false")
    assert([1.0, nan] < [2.0, nan], reason="first unequal element decides before NaN")
    assert(not ((nan, 1.0) < (nan, 2.0)), reason="tuples stop at an unordered field")
    assert(not lower([nan], [1.0]), reason="generic list ordering keeps IEEE semantics")

test "optional ordering with NaN payloads":
    nan := 0.0 / 0.0
    let absent: f64? = nil
    let present: f64? = nan
    let one: f64? = 1.0
    assert(absent < present, reason="nil sorts before every present value")
    assert(not (present < one), reason="present NaN is unordered")
    assert(not (one < present), reason="present NaN is unordered")
