# test: growth through a mutable alias invalidates an iterator from a readonly view
fn run(values: mut list[i32]) -> void:
    let view: list[i32] = values
    let iterator: mut Iterator[i32] = view.iter()
    _ := iterator.next()
    values.append(3)
    _ := iterator.next()  # panic: iterator-invalidated

let values: mut list[i32] = [1, 2]
run(values)
