# test: map literals evaluate key then value; comprehension filters run in place
# expect: test
use std.testing.assert_equal

data Log:
    text: string

fn note(log: mut Log, tag: string, value: i32) -> i32:
    log.text = log.text + tag
    value

fn key(log: mut Log, tag: string, value: string) -> string:
    log.text = log.text + tag
    value

fn flag(log: mut Log, tag: string, value: bool) -> bool:
    log.text = log.text + tag
    value

fn keys(values: map[string, i32]) -> list[string]:
    let result: mut list[string] = []
    for name, value in values:
        if value >= 0:
            result.append(name)
    result

test "map literal evaluates each key before its value":
    let log: mut Log = Log { text: "" }
    values := {key(log, "k1", "a"): note(log, "v1", 1), key(log, "k2", "b"): note(log, "v2", 2)}
    assert_equal(log.text, "k1v1k2v2", reason="entries left to right, key before value")
    assert_equal(values.len(), 2, reason="two distinct keys")

test "duplicate key keeps first position with the later value":
    values := {"a": 1, "b": 2, "a": 3}
    let three: i32? = 3
    assert_equal(keys(values), ["a", "b"], reason="first insertion position kept")
    assert_equal(values["a"], three, reason="later value wins")
    assert_equal(values.len(), 2, reason="one entry per key")

test "comprehension filter runs at its position":
    let log: mut Log = Log { text: "" }
    kept := [for item in [1, 2, 3] if flag(log, "$item", item != 2) => note(log, "r", item)]
    assert_equal(kept, [1, 3], reason="filter drops the middle item")
    assert_equal(log.text, "1r23r", reason="filter then result, per item")
