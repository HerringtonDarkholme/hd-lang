# test: an exhausted list iterator still panics on next after the list grows
fn run(values: mut list[i32]) -> void:
    let iterator: mut Iterator[i32] = values.iter()
    _ := iterator.next()
    _ := iterator.next()
    values.append(3)
    _ := iterator.next()  # panic: iterator-invalidated

let values: mut list[i32] = [1]
run(values)
