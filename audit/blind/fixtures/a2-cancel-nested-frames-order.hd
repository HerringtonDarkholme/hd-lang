# test: cancellation runs defer suites innermost frame first, LIFO within a frame
# fixture-runtime-scenario: cancellation-cleanup
# fixture-runtime-pending-function: wait
let trace: string = ""

fn wait!() -> void:
    pass

fn inner!() -> void:
    defer:
        trace = trace + "i1;"
    defer:
        trace = trace + "i2;"
    wait!()
    trace = trace + "inner-after;"

fn middle!() -> void:
    defer:
        trace = trace + "m;"
    inner!()
    trace = trace + "middle-after;"

fn outer!() -> void:
    defer:
        trace = trace + "o;"
    middle!()
    trace = trace + "outer-after;"

pub fn main!() -> void:
    outer!()
    trace = trace + "main-after;"

pub fn cleanup_ran() -> bool:
    trace == "i2;i1;m;o;"
