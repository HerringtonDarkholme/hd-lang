fn c10(n: i32) -> i32 $ R1 + R2 + R3 + R4 + R5:
    n + $.use(R1).v()

fn c9(n: i32) -> i32 $ R1 + R2 + R3 + R4 + R5:
    c10(n)

fn c8(n: i32) -> i32 $ R1 + R2 + R3 + R4 + R5:
