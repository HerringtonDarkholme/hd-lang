# probe 5.1: fieldless variant and fieldless data: shared singleton or allocated each time
data Unit: pass

enum Color:
    Red
    Green

enum Maybe[T]:
    Some(value: T)
    None

fn unit_count(value: Unit) -> i32: 1

fn is_red(color: Color) -> i32:
    match color:
        Color.Red => 1
        Color.Green => 0

fn is_none(value: Maybe[i32]) -> i32:
    match value:
        Maybe.Some(actual) => 0
        Maybe.None => 1

fn loop_units(n: i32) -> i32:
    let total = 0
    let i = 0
    while i < n:
        let none: Maybe[i32] = Maybe.None
        total = total + unit_count(Unit {}) + is_red(Color.Red) + is_none(none)
        i = i + 1
    total

fn main() -> i32: loop_units(14)
