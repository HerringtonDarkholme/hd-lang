# probe 5.1: closure environment layout; allocation per creation
fn apply(f: fn(i32) -> i32, value: i32) -> i32: f(value)

fn loop_create(n: i32) -> i32:
    base := 1
    scale := 2.0
    let total = 0
    let i = 0
    while i < n:
        add := fn(value: i32) -> i32: value + base + (1 - above(scale, 1.0))
        total = total + apply(add, i)
        i = i + 1
    total

fn loop_reuse(n: i32) -> i32:
    base := 1
    add := fn(value: i32) -> i32: value + base
    let total = 0
    let i = 0
    while i < n:
        total = total + add(i)
        i = i + 1
    total

fn noncapturing(n: i32) -> i32:
    inc := fn(value: i32) -> i32: value + 1
    apply(inc, n)

fn main() -> i32: loop_create(3) + loop_reuse(3) + noncapturing(1)

fn above(value: f64, limit: f64) -> i32:  # uses == because f64 ordering fails to assemble (F-160)
    if value == limit:
        1
    else:
        0
