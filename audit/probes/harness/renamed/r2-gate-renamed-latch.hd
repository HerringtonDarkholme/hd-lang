# fixture-runtime-profile: pending-gate
# fixture-runtime-scenario: cancellation-cleanup
let cleaned: bool = false

pub trait Latch:
    fn wait!(self) -> void

fn pending!() -> void $ Latch:
    defer:
        cleaned = true
    $.use(Latch).wait!()

pub fn main!() -> void $ Latch:
    pending!()

pub fn cleanup_ran() -> bool:
    cleaned
