# test: host provider scalar arguments and results
# fixture-runtime-profile: ready-counter
# expect: test

use std.testing.assert_equal

let provider_result: i32 = 0

pub trait Adder:
    fn add!(self, left: i32, right: i32) -> i32

fn calculate!() -> i32 $ Adder:
    $.use(Adder).add!(20, 22)

pub fn main!() -> void $ Adder:
    provider_result = calculate!()

pub fn recorded_result() -> i32:
    provider_result

test "host provider returned its scalar result":
    assert_equal(
        provider_result,
        42,
        reason="host arguments and result must cross the boundary intact",
    )
