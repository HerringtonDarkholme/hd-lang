# fixture-runtime-profile: pending-gate
# fixture-runtime-scenario: cancellation-cleanup
let cleaned: bool = false

pub trait Gate:
    fn wait!(self) -> void

fn pending!() -> void $ Gate:
    defer:
        cleaned = true
    $.use(Gate).wait!()

pub fn main!() -> void $ Gate:
    pending!()

pub fn cleanup_done() -> bool:
    cleaned
