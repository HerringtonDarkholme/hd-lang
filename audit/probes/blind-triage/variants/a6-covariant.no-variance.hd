# test: [variant: declared-variance Producer removed] readonly collections and covariant data weaken mut U to U without copying
# expect: test
use std.testing.{assert, assert_equal}

data User:
    name: string

fn total_length(users: list[User]) -> i32:
    let total: i32 = 0
    for user in users:
        total = total + user.name.len()
    total

fn value_length(users: map[string, User]) -> i32:
    let total: i32 = 0
    for key, user in users:
        total = total + key.len() + user.name.len()
    total

fn as_readonly(users: list[User]) -> list[User]:
    users

test "list[mut User] weakens to list[User] and aliases the same list":
    let users: mut list[mut User] = [User { name: "ab" }]
    assert_equal(total_length(users), 2, reason="weakened view reads elements")
    let first: mut User = users[0]
    first.name = "abcd"
    assert_equal(total_length(users), 4, reason="the view observes later mutation")
    assert(as_readonly(users) is users, reason="weakening preserves identity")

test "map[string, mut User] weakens to map[string, User]":
    let users: mut map[string, mut User] = {"k": User { name: "abc" }}
    assert_equal(value_length(users), 4, reason="covariant value weakening")

