trait Logger:
    fn write(self, message: string) -> void

fn log_message(message: string) -> i32 $ Logger:
    logger := $.use(Logger)
    logger.write(message)
    1

fn direct() -> i32 $ Logger:
    log_message("a")

fn in_for(items: list[string]) -> void $ Logger:
    for item in items:
        _ := log_message(item)

fn in_tuple() -> (i32, i32) $ Logger:
    (log_message("a"), 2)

fn in_interp() -> string $ Logger:
    "n=${log_message("a")}"

fn in_comprehension(items: list[string]) -> list[i32] $ Logger:
    [for item in items => log_message(item)]

fn main() -> i32:
    0
