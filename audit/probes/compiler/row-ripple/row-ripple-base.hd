trait Logger:
    fn write(self, message: string) -> void

trait Cache:
    fn size(self) -> i32

data L: pass
data C: pass

impl Logger for L:
    fn write(self, message: string) -> void: pass

impl Cache for C:
    fn size(self) -> i32: 1

fn f0() -> i32 $ Logger:
    cb := fn(): f2()
    f1() + cb()

fn f1() -> i32 $ Logger:
    cb := fn(): f4()
    f3() + cb()

