fn f13() -> i32 $ Logger:
    cb := fn(): f28()
    f27() + cb()

fn f14() -> i32 $ Logger:
    cb := fn(): f30()
    f29() + cb()

fn f15() -> i32 $ Logger:
    $.use(Logger).write("leaf")
    1

