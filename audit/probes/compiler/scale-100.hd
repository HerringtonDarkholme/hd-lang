    x: i32
    y: i32 = 2

fn g93(a: i32, b: i32 = 1, rest: i32...) -> i32:
    p := P93 { x: a + 3 }
    q := P93 { ...p, x: b }
    let total: i32 = 0
    for v in rest:
        total = total + v
    doubled := [for v in rest if v > 1 => v * 2]
    _ := "v=${q.x}"
    if total > 10:
        total + q.y + doubled.len()
    else:
        g92(total, rest=[1, 2])

