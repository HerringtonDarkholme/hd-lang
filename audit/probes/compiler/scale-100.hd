data P0:
    x: i32
    y: i32 = 2

fn g0(a: i32, b: i32 = 1, rest: i32...) -> i32:
    p := P0 { x: a + 3 }
    q := P0 { ...p, x: b }
    let total: i32 = 0
    for v in rest:
        total = total + v
    doubled := [for v in rest if v > 1 => v * 2]
    _ := "v=${q.x}"
    if total > 10:
        total + q.y + doubled.len()
    else:
        0

data P1:
    x: i32
    y: i32 = 2

fn g1(a: i32, b: i32 = 1, rest: i32...) -> i32:
    p := P1 { x: a + 3 }
    q := P1 { ...p, x: b }
    let total: i32 = 0
    for v in rest:
        total = total + v
    doubled := [for v in rest if v > 1 => v * 2]
    _ := "v=${q.x}"
    if total > 10:
        total + q.y + doubled.len()
    else:
        g0(total, rest=[1, 2])

