# Control for h1-default-reads-mutable-global: the top-level let is never
# reassigned, and the default reads it directly.
use std.testing.assert_equal

let limit: i32 = 10

fn current(value: i32 = limit) -> i32:
    value

test "default reads a never-reassigned top-level let":
    assert_equal(current(), 10, reason="read is not a write")
