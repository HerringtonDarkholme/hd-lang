use std.testing.assert_equal

pub trait TextBridge:
    fn join!(self, left: string, right: string) -> string

fn main!() -> i32 $ TextBridge:
    result := $.use(TextBridge).join!("\u{FEFF}", "x")
    assert_equal(result, "\u{FEFF}x", reason="host join must preserve every UTF-8 byte")
    result.len()
