pub trait Counter:
    fn add!(self, left: i32, right: i32) -> i32

fn helper(value: i32) -> i32: value * 2

## Adds one through the host.
fn child!(value: i32) -> i32 $ Counter:
    $.use(Counter).add!(value, 1)

fn leaf!() -> i32: 0

fn main!() -> i32 $ Counter:
    first := child!(20)
    zero := leaf!()
    helper(first) + zero
