# test: generic suspension frames retain trait dictionaries across child polls
# expect-result: main = 42

trait Score:
    fn score(self) -> i32

data Value:
    amount: i32

impl Score for Value:
    fn score(self) -> i32: self.amount

fn pause!() -> void: pass

fn read![T: Score](value: T) -> i32:
    pause!()
    value.score()

fn main!() -> i32:
    read!(Value { amount: 42 })
