# test: CFG suspension lowering preserves loops, continue, break values, and cleanup
# expect-result: main = 42

fn step!(value: i32) -> i32: value

fn main!() -> i32:
    let index: i32 = 0
    let total: i32 = 0
    value := while index < 5:
        defer:
            total = total + 10
        index = step!(index + 1)
        if index == 2:
            continue
        total = total + step!(index)
        if index == 4:
            break total
    else:
        0
    value + total - 44
