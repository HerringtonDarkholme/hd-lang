# test: CFG suspension lowering branches and short-circuits around child frames
# expect-result: main = 42

fn value!(input: i32) -> i32: input

fn choose!(flag: bool) -> i32:
    if flag and value!(1) == 1:
        value!(20) + value!(22)
    else:
        value!(99)

fn main!() -> i32: choose!(true)
