# test: traits / suspending cancel
# expect: accept

trait Job:
    fn run!(self) -> void

data Worker:
    value: i32

fn wait!() -> void: pass

impl Job for Worker:
    fn run!(self) -> void:
        defer:
            _ := self.value
        wait!()

fn main!() -> void:
    let job: Job = Worker { value: 42 }
    job.run!()
