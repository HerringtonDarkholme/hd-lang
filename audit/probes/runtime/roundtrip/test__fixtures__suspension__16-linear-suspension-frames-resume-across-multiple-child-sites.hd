# test: linear suspension frames resume across multiple child sites
# expect-result: main = 42

fn left!(value: i32) -> i32: value
fn right!(value: i32) -> i32: value
fn main!() -> i32:
    base := 1
    left_value := left!(20)
    middle := 1
    right_value := right!(20)
    base + left_value + middle + right_value
