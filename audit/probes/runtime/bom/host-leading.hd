# F-400: a leading U+FEFF must survive the host boundary
# run: hd test --profile ready-text audit/probes/runtime/bom/host-leading.hd
use std.testing.assert_equal

pub trait TextBridge:
    fn join!(self, left: string, right: string) -> string

pub fn main!() -> void $ TextBridge:
    bridge := $.use(TextBridge)
    assert_equal(bridge.join!("a\u{FEFF}", "x").len(), 3, reason="control: a middle U+FEFF survives")
    assert_equal(bridge.join!("\u{FEFF}", "x").len(), 2, reason="a leading U+FEFF argument survives")
