# test: unordered float components make all four relational operators false; nil orders first
# expect: test
use std.testing.assert_equal

test "ordering":
    nan := 0.0 / 0.0
    left := (nan, 1)
    right := (1.0, 1)
    assert_equal(left < right or left <= right or left > right or left >= right, false, reason="all false")
    assert_equal([1, 2] < [1, 3], true, reason="lexicographic list")
    assert_equal([1] < [1, 0], true, reason="shorter prefix first")
    let none: i32? = nil
    let some: i32? = 0
    assert_equal(none < some, true, reason="nil first")
