# test: comprehensions evaluate nested clauses left to right with filters and duplicate-key replacement
# expect: test
use std.testing.assert_equal

test "comprehension":
    pairs := [for left in [1, 2] for right in [10, 20] if left + right != 12 => left * 100 + right]
    assert_equal(pairs, [110, 120, 220], reason="outer clause first")
    by_parity := {for value in [1, 2, 3, 4] => value % 2: value}
    assert_equal(by_parity[1], 3, reason="later duplicate replaces")
    assert_equal(by_parity.len(), 2, reason="two keys")
