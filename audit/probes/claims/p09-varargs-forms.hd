# test: varargs accept positional elements, one final positional spread, or a named list
# expect: test
use std.testing.assert_equal

fn total(values: i32...) -> i32:
    let sum: i32 = 0
    for value in values:
        sum = sum + value
    sum

fn count[T](values: T...) -> i32: values.len()

test "vararg forms":
    rest := [3, 4]
    assert_equal(total(), 0, reason="empty")
    assert_equal(total(1, 2), 3, reason="positional")
    assert_equal(total(rest...), 7, reason="one list spread")
    assert_equal(total(values=[5, 6]), 11, reason="named list")
    assert_equal(count("a", "b", "c"), 3, reason="generic vararg")
