# Hand-written while loops, the baseline

pub fn w1(n: i32) -> i32:
    let total = 0
    let at = 0
    let count = 0
    while at < n:
        if at % 3 != 0:
            let v = at * 2 + 1
            if count >= (n / 2):
                break
            count = count + 1
            total = (total + v) % 1000003
        at = at + 1
    total

pub fn w2_1(n: i32) -> i32:
    let total = 0
    let at = 0
    while at < n:
        let v = at + 1
        total = (total + v) % 1000003
        at = at + 1
    total

pub fn w2_2(n: i32) -> i32:
    let total = 0
    let at = 0
    while at < n:
        let v = at + 1 + 1
        total = (total + v) % 1000003
        at = at + 1
    total

pub fn w2_4(n: i32) -> i32:
    let total = 0
    let at = 0
    while at < n:
        let v = at + 1 + 1 + 1 + 1
        total = (total + v) % 1000003
        at = at + 1
    total

pub fn w2_8(n: i32) -> i32:
    let total = 0
    let at = 0
    while at < n:
        let v = at + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1
        total = (total + v) % 1000003
        at = at + 1
    total

pub fn w3(n: i32) -> i32:
    let total = 0
    let at = 0
    let idx = 0
    while at < n:
        let x = at
        if idx % 2 == 0:
            let v = x * 3
            total = (total + v) % 1000003
        at = at + 1
        idx = idx + 1
    total

pub fn main() -> void $ Console:
    println("${w1(1000)}")
    println("${w2_4(1000)}")
    println("${w3(1000)}")
