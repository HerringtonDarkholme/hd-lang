# What a hand-written implementation writes under the proposal.
use std.structure.{Facts, Member}
use pkg.json_decode.{Deserialize, Deserializer}
use std.serde.ValueKind

# A hand-written Deserialize for a record reads its keys in any order, as
# serde's manual `visit_map` does: one slot per member, a duplicate or a
# missing key is an error, and an unknown key is skipped.
pub struct Window:
    pub start: i64
    pub end: i64

impl Deserialize for Window:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Window, R::Error]:
        let mut start: i64? = .None
        let mut end: i64? = .None
        input.begin_map()?
        while true:
            match input.next_key()?:
                .None => break
                .Some(key) =>
                    if key == "start":
                        if start.is_some():
                            return .Err(input.invalid("one `start`"))
                        start = .Some(input.int("i64")?)
                    else if key == "end":
                        if end.is_some():
                            return .Err(input.invalid("one `end`"))
                        end = .Some(input.int("i64")?)
                    else:
                        input.skip()?
        match (start, end):
            (.Some(s), .Some(e)) => .Ok(Window { start: s, end: e })
            _ => .Err(input.invalid("`start` and `end`"))

# A format opts in to the key loop: a reader over `key=value` pairs whose
# values are integers. It names each record member in the pairs' order.
pub struct Pairs:
    pub keys: List[string]
    pub values: List[i64]
    pub at: usize
    pub absent: bool

impl Deserializer for Pairs:
    type Error = string

    fn peek(&mut self) -> Result[ValueKind, string]:
        .Ok(if self.absent: ValueKind.Null else: ValueKind.Int)

    fn is_null(&mut self) -> Result[bool, string]:
        absent := self.absent
        self.absent = false
        .Ok(absent)

    fn int(&mut self, expected: string) -> Result[i64, string]:
        if self.absent:
            return .Err("missing ${expected}")
        value := self.values[self.at - 1]
        .Ok(value)

    fn text(&mut self, expected: string) -> Result[string, string]:
        .Err("expected ${expected}")

    fn begin_map(&mut self) -> Result[void, string]:
        .Ok(())

    fn next_key(&mut self) -> Result[string?, string]:
        if self.at >= self.keys.len():
            return .Ok(.None)
        self.at = self.at + 1
        .Ok(.Some(self.keys[self.at - 1]))

    fn invalid(&mut self, expected: string) -> string:
        "expected ${expected}"

    fn keyed(&self) -> bool:
        true

    # One comparison when the guess holds, a scan otherwise; the std JSON
    # reader uses the per-type name table instead (JSON_DECODE.md, Cost).
    fn next_field(
        &mut self,
        members: &List[Member],
        facts: Facts,
        guess: usize,
    ) -> Result[usize?, string]:
        while self.at < self.keys.len():
            key := self.keys[self.at]
            self.at = self.at + 1
            if guess < members.len() && members[guess].name == key:
                return .Ok(.Some(guess))
            let k: usize = 0
            while k < members.len():
                if members[k].name == key:
                    return .Ok(.Some(k))
                k = k + 1
        .Ok(.None)

    fn absent_field(&mut self, m: &Member, facts: Facts) -> void:
        self.absent = true

    fn skip(&mut self) -> Result[void, string]:
        .Ok(())

pub fn window_from_pairs(keys: List[string], values: List[i64]) -> Result[Window, string]:
    let mut input = Pairs { keys: keys, values: values, at: 0, absent: false }
    Window::deserialize(&mut input)
