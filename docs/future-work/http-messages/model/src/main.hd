# Mechanism prototype only: local candidate types, not implemented std APIs.
# Buffered one-shot body errors, mutation-after-read and media hint names are provisional.
# URL construction/transport below are fixture-only, not a parser or real network transport.
use std.convert.From
use std.http.Method
use std.hash.{Hasher, hash_of}
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}

@derive(Eq, Debug)
pub enum ReadError:
    Used
    Decode
    Fixture
    InvalidHeader(name: string)

pub struct Body:
    payload: List[u8]
    used: bool

impl Body:
    fn empty() -> *mut Body:
        &mut Body { payload: [], used: false }

    fn from_bytes(payload: List[u8]) -> *mut Body:
        &mut Body { payload: payload, used: false }

    fn set_bytes(&mut self, value: List[u8]) -> void:
        self.payload = value

    fn set_text(&mut self, value: string) -> void:
        self.payload = value.to_utf8()

    fn set_json[T < Serialize](&mut self, value: T) -> void:
        self.payload = encode(value).to_utf8()

    fn bytes(&mut self) -> Result[List[u8], ReadError]:
        if self.used:
            return .Err(.Used)
        self.used = true
        .Ok(self.payload)

    fn text(&mut self) -> Result[string, ReadError]:
        match string::from_utf8(self.bytes()? ):
            .Ok(text) => .Ok(text)
            .Err(_) => .Err(.Decode)

    fn json[T < Deserialize](&mut self) -> Result[T, ReadError]:
        match decode::[T](self.text()? ):
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(.Decode)

# HTTP field names fold ASCII only; non-ASCII remains invalid for wire validation.
fn fold_header_name(name: string) -> string:
    let mut bytes = name.to_utf8()
    for at in 0..bytes.len():
        if bytes[at] >= 65 && bytes[at] <= 90:
            bytes[at] = bytes[at] + 32
    string::from_utf8(bytes).expect("ASCII folding preserves UTF-8")

@derive(Debug)
pub enum HeaderName:
    Accept
    AcceptEncoding
    Authorization
    CacheControl
    Connection
    ContentEncoding
    ContentLength
    ContentType
    Cookie
    Host
    Location
    Origin
    ProxyAuthorization
    RetryAfter
    SetCookie
    TransferEncoding
    UserAgent
    Vary
    XForwardedFor
    XForwardedProto
    Other(name: string)

impl HeaderName:
    fn wire(&self) -> string:
        match *self:
            .Accept => "accept"
            .AcceptEncoding => "accept-encoding"
            .Authorization => "authorization"
            .CacheControl => "cache-control"
            .Connection => "connection"
            .ContentEncoding => "content-encoding"
            .ContentLength => "content-length"
            .ContentType => "content-type"
            .Cookie => "cookie"
            .Host => "host"
            .Location => "location"
            .Origin => "origin"
            .ProxyAuthorization => "proxy-authorization"
            .RetryAfter => "retry-after"
            .SetCookie => "set-cookie"
            .TransferEncoding => "transfer-encoding"
            .UserAgent => "user-agent"
            .Vary => "vary"
            .XForwardedFor => "x-forwarded-for"
            .XForwardedProto => "x-forwarded-proto"
            .Other(name) => fold_header_name(name)

    fn parse(name: string) -> HeaderName:
        match fold_header_name(name):
            "accept" => .Accept
            "accept-encoding" => .AcceptEncoding
            "authorization" => .Authorization
            "cache-control" => .CacheControl
            "connection" => .Connection
            "content-encoding" => .ContentEncoding
            "content-length" => .ContentLength
            "content-type" => .ContentType
            "cookie" => .Cookie
            "host" => .Host
            "location" => .Location
            "origin" => .Origin
            "proxy-authorization" => .ProxyAuthorization
            "retry-after" => .RetryAfter
            "set-cookie" => .SetCookie
            "transfer-encoding" => .TransferEncoding
            "user-agent" => .UserAgent
            "vary" => .Vary
            "x-forwarded-for" => .XForwardedFor
            "x-forwarded-proto" => .XForwardedProto
            _ => .Other(name)

impl Eq for HeaderName:
    fn eq(self, other: HeaderName) -> bool: self.wire() == other.wire()

impl Hash for HeaderName:
    fn hash(self, state: &mut dyn Hasher) -> void: self.wire().hash(state)

@derive(Eq, Debug)
pub enum HeaderError:
    Invalid(name: string)

impl HeaderError:
    fn name(&self) -> string:
        match *self:
            .Invalid(name) => name

pub struct Headers:
    pairs: List[(HeaderName, string)]

impl Headers:
    fn get(&self, name: HeaderName) -> string?:
        for (key, value) in self.pairs:
            if key == name:
                return .Some(value)
        .None

    fn get_all(&self, name: HeaderName) -> List[string]:
        [for (key, value) in self.pairs if key == name => value]

    fn set(&mut self, name: HeaderName, value: string) -> void:
        self.pairs = self.pairs.filter(fn(pair): pair._0 != name)
        self.pairs.push((name, value))

    fn append(&mut self, name: HeaderName, value: string) -> void:
        self.pairs.push((name, value))

    fn from_pairs(pairs: List[(string, string)]) -> Headers:
        Headers { pairs: pairs.map(fn(pair): (HeaderName::parse(pair._0), pair._1)) }

    fn to_pairs(&self) -> List[(string, string)]:
        self.pairs.map(fn(pair): (pair._0.wire(), pair._1))

    fn validate(&self) -> Result[void, HeaderError]:
        for (name, value) in self.pairs:
            wire := name.wire()
            if wire.is_empty():
                return .Err(.Invalid(wire))
            for byte in wire.to_utf8():
                let allowed = (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
                for punctuation in [33u8, 35u8, 36u8, 37u8, 38u8, 39u8, 42u8, 43u8, 45u8, 46u8, 94u8, 95u8, 96u8, 124u8, 126u8]:
                    if byte == punctuation:
                        allowed = true
                if !allowed:
                    return .Err(.Invalid(wire))
            bytes := value.to_utf8()
            let at = 0
            while at < bytes.len():
                byte := bytes[at]
                if byte < 128:
                    if byte != 9 && (byte < 32 || byte == 127):
                        return .Err(.Invalid(wire))
                    at += 1
                else:
                    if (byte != 194 && byte != 195) || at + 1 >= bytes.len():
                        return .Err(.Invalid(wire))
                    at += 2
        .Ok(())

impl From[List[(string, string)]] for Headers:
    fn from(pairs: List[(string, string)]) -> Headers:
        Headers::from_pairs(pairs)

impl From[Map[string, string]] for Headers:
    fn from(values: Map[string, string]) -> Headers:
        let mut pairs: List[(string, string)] = []
        for (name, value) in values:
            pairs.push((name, value))
        Headers::from_pairs(pairs)

# User-owned typed conversion; no Serialize or Deserialize derivation is involved.
@derive(Eq, Debug)
struct HeaderView:
    content_type: string
    trace: string

impl From[HeaderView] for Headers:
    fn from(value: HeaderView) -> Headers:
        let mut headers = Headers { pairs: [] }
        headers.append(.ContentType, value.content_type)
        headers.append(.Other("x-trace"), value.trace)
        headers

impl From[Headers] for HeaderView:
    fn from(value: Headers) -> HeaderView:
        HeaderView { content_type: value.get(.ContentType).unwrap_or(""), trace: value.get(.Other("x-trace")).unwrap_or("") }

pub struct Url:
    origin: string
    path_value: string
    query_pairs: List[(string, string)]

impl Url:
    fn path(&self) -> string: self.path_value

    fn query(&self, name: string) -> string?:
        for (key, value) in self.query_pairs:
            if key == name:
                return .Some(value)
        .None

    fn query_all(&self, name: string) -> List[string]:
        [for (key, value) in self.query_pairs if key == name => value]

    fn append_query(&mut self, name: string, value: string) -> void:
        self.query_pairs.push((name, value))

    fn set_path(&mut self, path: string) -> void:
        self.path_value = path

    fn to_string(&self) -> string:
        suffix := self.query_pairs.map(fn(pair): "${pair._0}=${pair._1}").join("&")
        self.origin + self.path_value + (if suffix.is_empty(): "" else: "?$suffix")

fn sample_url() -> Url:
    Url { origin: "https://example.test", path_value: "/orders", query_pairs: [("mode", "fast")] }

pub struct Request:
    pub method: Method
    pub url: Url
    pub headers: Headers
    pub body: *mut Body

@derive(Debug)
pub enum HttpStatus:
    Ok
    Created
    PayloadTooLarge
    NoContent
    MovedPermanently
    Found
    SeeOther
    NotModified
    TemporaryRedirect
    PermanentRedirect
    BadRequest
    Unauthorized
    Forbidden
    NotFound
    RequestTimeout
    TooManyRequests
    InternalServerError
    BadGateway
    ServiceUnavailable
    GatewayTimeout
    Other(code: u16)

impl HttpStatus:
    fn code(&self) -> u16:
        match *self:
            .Ok => 200
            .Created => 201
            .PayloadTooLarge => 413
            .NoContent => 204
            .MovedPermanently => 301
            .Found => 302
            .SeeOther => 303
            .NotModified => 304
            .TemporaryRedirect => 307
            .PermanentRedirect => 308
            .BadRequest => 400
            .Unauthorized => 401
            .Forbidden => 403
            .NotFound => 404
            .RequestTimeout => 408
            .TooManyRequests => 429
            .InternalServerError => 500
            .BadGateway => 502
            .ServiceUnavailable => 503
            .GatewayTimeout => 504
            .Other(code) => code

    fn from_code(code: u16) -> HttpStatus:
        match code:
            200 => .Ok
            201 => .Created
            413 => .PayloadTooLarge
            204 => .NoContent
            301 => .MovedPermanently
            302 => .Found
            303 => .SeeOther
            304 => .NotModified
            307 => .TemporaryRedirect
            308 => .PermanentRedirect
            400 => .BadRequest
            401 => .Unauthorized
            403 => .Forbidden
            404 => .NotFound
            408 => .RequestTimeout
            429 => .TooManyRequests
            500 => .InternalServerError
            502 => .BadGateway
            503 => .ServiceUnavailable
            504 => .GatewayTimeout
            _ => .Other(code)

impl Eq for HttpStatus:
    fn eq(self, other: HttpStatus) -> bool: self.code() == other.code()

impl Hash for HttpStatus:
    fn hash(self, state: &mut dyn Hasher) -> void: self.code().hash(state)

pub struct Response:
    pub status: HttpStatus
    pub headers: Headers
    pub body: *mut Body
    pub url: Url?

impl Request:
    fn post(url: Url) -> Request:
        Request { method: .Post, url: url, headers: Headers { pairs: [] }, body: Body::empty() }

impl Response:
    fn status(code: HttpStatus) -> Response:
        Response { status: code, headers: Headers { pairs: [] }, body: Body::empty(), url: .None }

impl Request:
    fn set_json[T < Serialize](mut self, value: T) -> Request:
        self.body = Body::empty()
        self.body.set_json(value)
        self.headers.set(.ContentType, "application/json")
        self

    fn set_text(mut self, value: string) -> Request:
        self.body = Body::empty()
        self.body.set_text(value)
        self.headers.set(.ContentType, "text/plain; charset=utf-8")
        self

    fn set_bytes(mut self, value: List[u8]) -> Request:
        self.body = Body::from_bytes(value)
        self

    fn set_header(mut self, name: HeaderName, value: string) -> Request:
        self.headers.set(name, value)
        self

    fn header(&self, name: HeaderName) -> string?: self.headers.get(name)
    fn bytes(&self) -> Result[List[u8], ReadError]: self.body.bytes()
    fn text(&self) -> Result[string, ReadError]: self.body.text()
    fn json[T < Deserialize](&self) -> Result[T, ReadError]: self.body.json::[T]()

impl Response:
    fn set_json[T < Serialize](mut self, value: T) -> Response:
        self.body = Body::empty()
        self.body.set_json(value)
        self.headers.set(.ContentType, "application/json")
        self

    fn set_text(mut self, value: string) -> Response:
        self.body = Body::empty()
        self.body.set_text(value)
        self.headers.set(.ContentType, "text/plain; charset=utf-8")
        self

    fn set_bytes(mut self, value: List[u8]) -> Response:
        self.body = Body::from_bytes(value)
        self

    fn set_header(mut self, name: HeaderName, value: string) -> Response:
        self.headers.set(name, value)
        self

    fn header(&self, name: HeaderName) -> string?: self.headers.get(name)
    fn bytes(&self) -> Result[List[u8], ReadError]: self.body.bytes()
    fn text(&self) -> Result[string, ReadError]: self.body.text()
    fn json[T < Deserialize](&self) -> Result[T, ReadError]: self.body.json::[T]()

# Public message-level provider, implemented here by a guest adapter.
pub trait Http:
    fn send!(&mut self, request: Request, redirects: usize) -> Result[Response, ReadError]

impl Request:
    fn send!(&self, redirects: usize = 10) -> Result[Response, ReadError] $ Http:
        $.use(Http).send!(*self, redirects)

# Wire-only fixture types. The real implementation places its @host interface internally.
pub struct WireRequest:
    pub method: Method
    pub url: string
    pub headers: List[(string, string)]
    pub body: List[u8]

pub struct WireResponse:
    pub status: u16
    pub headers: List[(string, string)]
    pub body: List[u8]
    pub url: string

trait WireTransport:
    fn send!(&mut self, request: WireRequest, redirects: usize) -> Result[WireResponse, ReadError]

struct HttpAdapter:
    wire: *mut dyn WireTransport

impl Http for HttpAdapter:
    fn send!(&mut self, request: Request, redirects: usize) -> Result[Response, ReadError]:
        request.headers.validate().map_err(fn(error): ReadError.InvalidHeader(error.name()))?
        wire := WireRequest { method: request.method, url: request.url.to_string(), headers: request.headers.to_pairs(), body: request.bytes()? }
        response := self.wire.send!(wire, redirects)?
        if response.url != "https://example.test/orders?mode=fast":
            return .Err(.Fixture)
        .Ok(Response { status: HttpStatus::from_code(response.status), headers: Headers::from_pairs(response.headers), body: Body::from_bytes(response.body), url: .Some(sample_url()) })

@derive(Serialize, Deserialize, Eq, Debug)
struct Order:
    quantity: usize

@derive(Serialize, Deserialize, Eq, Debug)
struct Reply:
    accepted: usize

fn handle!(request: &Request) -> Result[Response, ReadError]:
    if request.method != .Post || request.url.path() != "/orders" || request.url.query("mode") != .Some("fast"):
        return .Err(.Fixture)
    if request.header(.Other("X-Trace")) != .Some("demo"):
        return .Err(.Fixture)
    order := request.json::[Order]()?
    .Ok(Response::status(.Created).set_json(Reply { accepted: order.quantity }))

struct Loopback:
    calls: usize
    redirects: usize
    bad_response: bool = false
    issues: List[string] = []

impl WireTransport for Loopback:
    fn send!(&mut self, wire: WireRequest, redirects: usize) -> Result[WireResponse, ReadError]:
        if wire.url != "https://example.test/orders?mode=fast":
            return .Err(.Fixture)
        self.calls += 1
        self.redirects = redirects
        request := Request { method: wire.method, url: sample_url(), headers: Headers::from_pairs(wire.headers), body: Body::from_bytes(wire.body) }
        normal := handle!(&request)?
        response := if self.bad_response: normal.set_header(.Other("x-bad"), "injected\r\nvalue") else: normal
        match response.headers.validate():
            .Err(error) =>
                self.issues.push(error.name())
                return .Ok(WireResponse { status: 500, headers: [], body: "invalid response header".to_utf8(), url: wire.url })
            .Ok(_) => pass
        .Ok(WireResponse { status: response.status.code(), headers: response.headers.to_pairs(), body: response.bytes()?, url: wire.url })

fn outgoing(quantity: usize) -> Request:
    Request::post(sample_url()).set_header(.Other("x-trace"), "demo").set_json(Order { quantity: quantity })

fn transaction!() -> Result[usize, ReadError]:
    transport := &mut Loopback { calls: 0, redirects: 0 }
    adapter := &mut HttpAdapter { wire: transport }
    $.with(Http=adapter):
        response := outgoing(42).send!(redirects=3)?
        reply := response.json::[Reply]()?
        .Ok(reply.accepted)

pub fn main!() -> void $ Console:
    value := match transaction!():
        .Ok(value) => value
        .Err(_) => panic("modeled request/response transaction")
    println(value)

tests:
    use std.testing.assert_equal

    it("message methods match the owner examples on all four directions"):
        request := outgoing(42)
        assert_equal(request.header(.ContentType), .Some("application/json"), reason="JSON Content-Type is set immediately on the message")
        response := Response::status(.Ok).set_json(Reply { accepted: 3 })
        assert_equal(response.status, .Ok, reason="status constructor coexists with status field")
        assert_equal(response.json::[Reply](), .Ok(Reply { accepted: 3 }), reason="typed incoming response read")
        assert_equal(transaction!(), .Ok(42), reason="client and read-only handler use the same message API")

    it("value setters detach body and owned fields from prior copies"):
        original := outgoing(1)
        changed := original.set_header(.Other("X-New"), "yes").set_json(Order { quantity: 2 })
        assert_equal(original.header(.Other("X-New")), .None, reason="headers remain owned value fields")
        assert_equal(original.json::[Order](), .Ok(Order { quantity: 1 }), reason="set_json replaces rather than mutates the shared old Body")
        assert_equal(changed.json::[Order](), .Ok(Order { quantity: 2 }), reason="returned message owns a new Body")

    it("raw shared mutation and message replacement have distinct proxy effects"):
        original := Response::status(.Ok).set_text("first")
        proxy := original
        proxy.body.set_text("shared")
        assert_equal(original.text(), .Ok("shared"), reason="private/raw Body mutation is visible to both aliases")
        assert_equal(proxy.text(), .Err(.Used), reason="copies share one consumption state")
        detached := proxy.set_text("replacement")
        assert_equal(detached.text(), .Ok("replacement"), reason="message setter replaces Body and permits a fresh read")
        assert_equal(original.text(), .Err(.Used), reason="replacement never resets the original")

    it("JSON writes replace the Content-Type before explicit later header override"):
        request := Request::post(sample_url()).set_header(.ContentType, "custom").set_json(Order { quantity: 1 })
        assert_equal(request.header(.ContentType), .Some("application/json"), reason="set_json writes matching media type")
        changed := request.set_header(.ContentType, "application/custom")
        assert_equal(changed.header(.ContentType), .Some("application/custom"), reason="a later explicit message header setter wins")

    it("malformed JSON and empty bodies are consumed once in this model"):
        malformed := Response::status(.Ok).set_text("not JSON")
        assert_equal(malformed.json::[Order](), .Err(.Decode), reason="provisional error marker")
        assert_equal(malformed.bytes(), .Err(.Used), reason="bad decoding still consumes")
        empty := Response::status(.Ok)
        assert_equal(empty.bytes(), .Ok([]), reason="empty is still a complete read")
        assert_equal(empty.text(), .Err(.Used), reason="empty is not reusable")

    it("send twice is Used but a message body setter permits a new send"):
        request := outgoing(4)
        transport := &mut Loopback { calls: 0, redirects: 0 }
        adapter := &mut HttpAdapter { wire: transport }
        $.with(Http=adapter):
            first := match request.send!():
                .Ok(value) => value
                .Err(_) => panic("fixture")
            assert_equal(first.json::[Reply](), .Ok(Reply { accepted: 4 }), reason="first send")
            used := match request.send!():
                .Err(.Used) => true
                _ => false
            assert_equal(used, true, reason="second send fails before wire transport")
            second := match request.set_json(Order { quantity: 5 }).send!():
                .Ok(value) => value
                .Err(_) => panic("fixture")
            assert_equal(second.json::[Reply](), .Ok(Reply { accepted: 5 }), reason="replacement can send")
        assert_equal(transport.calls, 2, reason="only fresh bodies reach transport")

    it("message byte writes and repeated header/query atoms remain typed"):
        response := Response::status(.Ok).set_bytes([116, 101, 97])
        assert_equal(response.text(), .Ok("tea"), reason="matching set_bytes and text methods")
        let mut cookies = Headers { pairs: [] }
        cookies.append(.SetCookie, "a=1")
        cookies.append(.SetCookie, "b=2")
        assert_equal(cookies.get_all(.SetCookie), ["a=1", "b=2"], reason="cookie values remain separate")
        let mut url = sample_url()
        url.append_query("mode", "safe")
        assert_equal(url.query_all("mode"), ["fast", "safe"], reason="repeated query values remain separate")

    it("known and Other header names share canonical Eq Hash and Map keys"):
        assert_equal(HeaderName.Other("ACCEPT"), HeaderName.Accept, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("ACCEPT-ENCODING"), HeaderName.AcceptEncoding, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("AUTHORIZATION"), HeaderName.Authorization, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("CACHE-CONTROL"), HeaderName.CacheControl, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("CONNECTION"), HeaderName.Connection, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("CONTENT-ENCODING"), HeaderName.ContentEncoding, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("CONTENT-LENGTH"), HeaderName.ContentLength, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("CONTENT-TYPE"), HeaderName.ContentType, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("COOKIE"), HeaderName.Cookie, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("HOST"), HeaderName.Host, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("LOCATION"), HeaderName.Location, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("ORIGIN"), HeaderName.Origin, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("PROXY-AUTHORIZATION"), HeaderName.ProxyAuthorization, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("RETRY-AFTER"), HeaderName.RetryAfter, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("SET-COOKIE"), HeaderName.SetCookie, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("TRANSFER-ENCODING"), HeaderName.TransferEncoding, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("USER-AGENT"), HeaderName.UserAgent, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("VARY"), HeaderName.Vary, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("X-FORWARDED-FOR"), HeaderName.XForwardedFor, reason="canonical known/Other equality")
        assert_equal(HeaderName.Other("X-FORWARDED-PROTO"), HeaderName.XForwardedProto, reason="canonical known/Other equality")
        assert_equal(hash_of(HeaderName.Other("Cache-Control")), hash_of(HeaderName.CacheControl), reason="Eq and Hash use the same lowercase wire name")
        let mut names: Map[HeaderName, usize] = {}
        names[.CacheControl] = 7
        assert_equal(names.get(.Other("CACHE-CONTROL")), .Some(7), reason="map lookup reaches the canonical key")
        assert_equal(HeaderName::parse("cOnTeNt-TyPe"), .ContentType, reason="incoming parser canonicalizes known names")

    it("header construction is infallible and outgoing wire validation rejects CR LF"):
        request := outgoing(4).set_header(.Other("x-bad"), "bad\r\nvalue")
        assert_equal(request.header(.Other("x-bad")), .Some("bad\r\nvalue"), reason="construction has no hidden invalid state")
        transport := &mut Loopback { calls: 0, redirects: 0 }
        adapter := &mut HttpAdapter { wire: transport }
        $.with(Http=adapter):
            invalid := match request.send!():
                .Err(.InvalidHeader(name)) => name
                _ => "not rejected"
            assert_equal(invalid, "x-bad", reason="client rejects invalid header at wire boundary")
        assert_equal(transport.calls, 0, reason="bad header bytes never reach transport")

    it("invalid server response becomes 500 and records the reason before wire"):
        transport := &mut Loopback { calls: 0, redirects: 0, bad_response: true }
        adapter := &mut HttpAdapter { wire: transport }
        $.with(Http=adapter):
            response := match outgoing(4).send!():
                .Ok(value) => value
                .Err(_) => panic("fixture")
            assert_equal(response.status, .InternalServerError, reason="invalid response header is replaced")
            assert_equal(response.header(.Other("x-bad")), .None, reason="bad bytes are never emitted")
        assert_equal(transport.issues, ["x-bad"], reason="fixture logger records the validation reason")

    it("known and Other status values share code Eq Hash and Map keys"):
        assert_equal(HttpStatus.Other(200), HttpStatus.Ok, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(201), HttpStatus.Created, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(413), HttpStatus.PayloadTooLarge, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(204), HttpStatus.NoContent, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(301), HttpStatus.MovedPermanently, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(302), HttpStatus.Found, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(303), HttpStatus.SeeOther, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(304), HttpStatus.NotModified, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(307), HttpStatus.TemporaryRedirect, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(308), HttpStatus.PermanentRedirect, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(400), HttpStatus.BadRequest, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(401), HttpStatus.Unauthorized, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(403), HttpStatus.Forbidden, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(404), HttpStatus.NotFound, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(408), HttpStatus.RequestTimeout, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(429), HttpStatus.TooManyRequests, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(500), HttpStatus.InternalServerError, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(502), HttpStatus.BadGateway, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(503), HttpStatus.ServiceUnavailable, reason="canonical known/Other status equality")
        assert_equal(HttpStatus.Other(504), HttpStatus.GatewayTimeout, reason="canonical known/Other status equality")
        assert_equal(hash_of(HttpStatus.Other(404)), hash_of(HttpStatus.NotFound), reason="Eq and Hash use the same status code")
        let mut statuses: Map[HttpStatus, string] = {}
        statuses[.NotFound] = "missing"
        assert_equal(statuses.get(.Other(404)), .Some("missing"), reason="canonical status map lookup")
        assert_equal(HttpStatus::from_code(404), .NotFound, reason="incoming parser canonicalizes known status")
        assert_equal(HttpStatus::from_code(777).code(), 777, reason="unknown status remains exact without clamping")

    it("ASCII-only canonicalization never repairs a non-ASCII header into Cookie"):
        assert_equal(HeaderName.Other("Cookie"), .Cookie, reason="valid ASCII custom names canonicalize")
        assert_equal(hash_of(HeaderName.Other("Cookie")), hash_of(HeaderName.Cookie), reason="valid ASCII equality has matching Hash")
        assert_equal(HeaderName.Other("CooKie") == HeaderName.Cookie, false, reason="Kelvin sign stays non-ASCII")
        assert_equal(HeaderName::parse("CooKie") == HeaderName.Cookie, false, reason="incoming canonicalization does not repair invalid bytes")
        request := outgoing(4).set_header(.Other("CooKie"), "secret")
        assert_equal(request.header(.Cookie), .None, reason="invalid custom spelling never aliases Cookie")
        transport := &mut Loopback { calls: 0, redirects: 0 }
        adapter := &mut HttpAdapter { wire: transport }
        $.with(Http=adapter):
            rejected := match request.send!():
                .Err(.InvalidHeader(_)) => true
                _ => false
            assert_equal(rejected, true, reason="invalid name is rejected at wire boundary")
        assert_equal(transport.calls, 0, reason="no repaired credential header reaches transport")

    it("ordinary From handles pair lists maps and user-owned typed headers"):
        repeated := Headers::from([("Set-Cookie", "a=1"), ("set-cookie", "b=2")])
        assert_equal(repeated.get_all(.SetCookie), ["a=1", "b=2"], reason="ordinary pair conversion preserves repeats")
        mapped := Headers::from({"X-Trace": "map"})
        assert_equal(mapped.get(.Other("x-trace")), .Some("map"), reason="ordinary string map conversion")
        view := HeaderView { content_type: "application/json", trace: "typed" }
        assert_equal(HeaderView::from(Headers::from(view)), view, reason="user supplies both typed conversions without Serde")
        invalid := Headers::from({"x-bad": "bad\r\nvalue"})
        assert_equal(invalid.get(.Other("x-bad")), .Some("bad\r\nvalue"), reason="conversion remains infallible and preserves plain strings")
        assert_equal(invalid.validate().is_err(), true, reason="early validation is explicit")
