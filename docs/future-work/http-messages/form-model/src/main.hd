# Mechanism probe only: duplicate scalar rejection, strict percent/UTF8,
# absent Lists empty; one bracket level per owner 6404702917.
# Unsupported values reject when visited; empty record lists/absent records are allowed.
use std.serde.{Serialize, Deserialize, Serializer, Deserializer, ValueKind, member_name, rename}
use std.structure.{Facts, VariantInfo, Member}
use std.text.{Parse, StringBuilder}

@derive(Debug, Eq)
pub enum FormError:
    Shape(path: string)
    Missing(path: string)
    Duplicate(path: string)
    Invalid(path: string, reason: string)
    Percent(position: usize)
    Utf8

fn join_path(parent: string, name: string) -> string:
    if parent == "": name else: "$parent[$name]"

fn component(text: string) -> string:
    out := StringBuilder::new()
    digits := "0123456789ABCDEF"
    let index: usize = 0
    for byte in text.to_utf8():
        if byte == 32:
            out.push("+")
        else if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46 || byte == 95 || byte == 42:
            out.push(text.slice(index, index + 1))
        else:
            out.push("%")
            out.push(digits.slice(usize(byte / 16), usize(byte / 16) + 1))
            out.push(digits.slice(usize(byte % 16), usize(byte % 16) + 1))
        index += 1
    out.build()

fn hex(byte: u8) -> u8?:
    if byte >= 48 && byte <= 57: return .Some(byte - 48)
    if byte >= 65 && byte <= 70: return .Some(byte - 55)
    if byte >= 97 && byte <= 102: return .Some(byte - 87)
    .None

fn uncomponent(text: string) -> Result[string, FormError]:
    bytes := text.to_utf8()
    let mut out: List[u8] = []
    let at: usize = 0
    while at < bytes.len():
        byte := bytes[at]
        if byte == 43:
            out.push(32)
        else if byte == 37:
            if at + 2 >= bytes.len(): return .Err(.Percent(at))
            hi := match hex(bytes[at + 1]):
                .Some(value) => value
                .None => return .Err(.Percent(at))
            lo := match hex(bytes[at + 2]):
                .Some(value) => value
                .None => return .Err(.Percent(at))
            out.push(hi * 16 + lo)
            at += 2
        else:
            out.push(byte)
        at += 1
    match string::from_utf8(out):
        .Ok(value) => .Ok(value)
        .Err(_) => .Err(.Utf8)

pub fn parse_pairs(text: string) -> Result[List[(string, string)], FormError]:
    let mut pairs: List[(string, string)] = []
    for part in text.split("&"):
        if part == "": continue
        let (name, value) = part.split_once("=").unwrap_or((part, ""))
        pairs.push((uncomponent(name)?, uncomponent(value)?))
    .Ok(pairs)

struct Frame:
    path: string
    facts: Facts

struct FormWriter:
    frames: List[Frame] = []
    path: string = ""
    keyed: bool = false
    repeated: bool = false
    started: bool = false
    finished: bool = false
    pairs: List[(string, string)] = []

impl FormWriter:
    fn scalar(&mut self, value: string) -> Result[void, FormError]:
        if self.frames.is_empty() || !self.keyed || self.finished: return .Err(.Shape(self.path))
        self.pairs.push((self.path, value))
        self.keyed = self.repeated
        .Ok(())

impl Serializer for FormWriter:
    type Error = FormError
    fn null(&mut self) -> Result[void, FormError]:
        if !self.keyed || self.repeated || self.frames.is_empty(): return .Err(.Shape(self.path))
        self.keyed = false
        .Ok(())
    fn bool(&mut self, value: bool) -> Result[void, FormError]: self.scalar(if value: "true" else: "false")
    fn int(&mut self, value: i64) -> Result[void, FormError]: self.scalar("$value")
    fn uint(&mut self, value: u64) -> Result[void, FormError]: self.scalar("$value")
    fn float(&mut self, value: f64) -> Result[void, FormError]: self.scalar("$value")
    fn text(&mut self, value: string) -> Result[void, FormError]: self.scalar(value)
    fn begin_list(&mut self, len: usize) -> Result[void, FormError]:
        if !self.keyed || self.repeated || self.frames.len() != 1: return .Err(.Shape(self.path))
        self.repeated = true
        .Ok(())
    fn end_list(&mut self) -> Result[void, FormError]:
        if !self.repeated: return .Err(.Shape(self.path))
        self.repeated = false
        self.keyed = false
        .Ok(())
    fn begin_map(&mut self, len: usize) -> Result[void, FormError]: .Err(.Shape(self.path))
    fn key(&mut self, key: string) -> Result[void, FormError]: .Err(.Shape(self.path))
    fn end_map(&mut self) -> Result[void, FormError]: .Err(.Shape(self.path))
    fn begin_variant(&mut self, facts: Facts, v: VariantInfo) -> Result[void, FormError]:
        if !v.of_data || self.repeated || self.finished || self.frames.len() >= 2: return .Err(.Shape(self.path))
        if self.started && self.frames.is_empty(): return .Err(.Shape(self.path))
        self.started = true
        self.frames.push(Frame { path: self.path, facts: facts })
        self.keyed = false
        .Ok(())
    fn member(&mut self, m: Member) -> Result[void, FormError]:
        if self.frames.is_empty() || self.keyed || self.repeated: return .Err(.Shape(self.path))
        frame := self.frames[self.frames.len() - 1]
        self.path = join_path(frame.path, member_name(m, frame.facts))
        self.keyed = true
        .Ok(())
    fn end_variant(&mut self) -> Result[void, FormError]:
        if self.frames.is_empty() || self.keyed || self.repeated: return .Err(.Shape(self.path))
        frame := self.frames.pop().expect("nonempty frame stack")
        self.path = frame.path
        self.keyed = false
        self.finished = self.frames.is_empty()
        .Ok(())

pub fn encode[T < Serialize](value: T) -> Result[string, FormError]:
    let mut writer = FormWriter {}
    value.serialize(&mut writer)?
    if !writer.finished: return .Err(.Shape(writer.path))
    out := StringBuilder::new()
    let separator = ""
    for (name, text) in writer.pairs:
        out.push(separator)
        out.push(component(name))
        out.push("=")
        out.push(component(text))
        separator = "&"
    .Ok(out.build())

struct FormReader:
    groups: Map[string, *mut List[string]]
    frames: List[Frame] = []
    path: string = ""
    values: List[string] = []
    current: string? = .None
    repeated: bool = false
    at: usize = 0

impl FormReader:
    fn present(&self) -> bool:
        if self.groups.contains_key(self.path): return true
        prefix := self.path + "["
        for (key, _) in self.groups:
            if key.starts_with(prefix): return true
        false
    fn read_text(&self) -> Result[string, FormError]:
        if !self.repeated && self.values.len() > 1: return .Err(.Duplicate(self.path))
        match self.current:
            .Some(value) => .Ok(value)
            .None => .Err(.Missing(self.path))
    fn parse[T < Parse[Error = E], E < Display](&self) -> Result[T, FormError]:
        text := self.read_text()?
        match T::parse(text):
            .Ok(value) => .Ok(value)
            .Err(error) => .Err(.Invalid(self.path, error.to_string()))

impl Deserializer for FormReader:
    type Error = FormError
    fn peek(&mut self) -> Result[ValueKind, FormError]: .Ok(if self.current.is_some(): .Text else: .Null)
    fn is_null(&mut self) -> Result[bool, FormError]: .Ok(if self.repeated: self.current.is_none() else: !self.present())
    fn bool(&mut self, expected: string) -> Result[bool, FormError]: self.parse::[bool]()
    fn int(&mut self, expected: string) -> Result[i64, FormError]: self.parse::[i64]()
    fn uint(&mut self, expected: string) -> Result[u64, FormError]: self.parse::[u64]()
    fn float(&mut self, expected: string) -> Result[f64, FormError]: self.parse::[f64]()
    fn text(&mut self, expected: string) -> Result[string, FormError]: self.read_text()
    fn begin_list(&mut self) -> Result[void, FormError]:
        if self.repeated || self.frames.len() != 1: return .Err(.Shape(self.path))
        self.repeated = true
        self.at = 0
        .Ok(())
    fn next_item(&mut self) -> Result[bool, FormError]:
        if !self.repeated: return .Err(.Shape(self.path))
        if self.at == self.values.len():
            self.repeated = false
            return .Ok(false)
        self.current = .Some(self.values[self.at])
        self.at += 1
        .Ok(true)
    fn begin_map(&mut self) -> Result[void, FormError]: .Err(.Shape(self.path))
    fn next_key(&mut self) -> Result[string?, FormError]: .Err(.Shape(self.path))
    fn begin_variant(&mut self, facts: Facts, choices: List[VariantInfo]) -> Result[usize, FormError]:
        if self.repeated || self.frames.len() >= 2 || choices.len() != 1 || !choices[0].of_data: return .Err(.Shape(self.path))
        self.frames.push(Frame { path: self.path, facts: facts })
        .Ok(0)
    fn member(&mut self, m: Member) -> Result[void, FormError]:
        frame := self.frames[self.frames.len() - 1]
        self.path = join_path(frame.path, member_name(m, frame.facts))
        self.values = match self.groups.get(self.path):
            .Some(values) => *values
            .None => []
        self.current = self.values.get(0)
        .Ok(())
    fn end_variant(&mut self) -> Result[void, FormError]:
        frame := self.frames.pop().expect("nonempty record stack")
        self.path = frame.path
        .Ok(())
    fn invalid(&mut self, expected: string) -> FormError: .Invalid(self.path, expected)
    fn is_absent(&mut self) -> bool: !self.present()

pub fn decode[T < Deserialize](text: string) -> Result[T, FormError]:
    let mut groups: Map[string, *mut List[string]] = {}
    for (key, value) in parse_pairs(text)?:
        match groups.get(key):
            .Some(values) => values.push(value)
            .None => groups[key] = &mut [value]
    let mut reader = FormReader { groups: groups }
    T::deserialize(&mut reader)

@derive(Serialize, Deserialize, Debug, Eq)
struct Inner:
    @rename("wire-count")
    count: u32
    note: string?
    defaulted: usize = 17

@derive(Serialize, Deserialize, Debug, Eq)
struct Outer:
    nested: Inner
    tags: List[string]
    active: bool

@derive(Serialize, Deserialize, Debug, Eq)
struct Optional:
    nested: Inner?
    list: List[string]

@derive(Serialize, Deserialize)
struct BadList:
    items: List[Inner]

@derive(Serialize, Deserialize)
struct BadMap:
    values: Map[string, string]

@derive(Serialize, Deserialize)
struct NumberList:
    values: List[usize]

@derive(Serialize, Deserialize)
struct NestedList:
    details: NumberList

struct Deferred:
    body: Result[string, FormError]
    query: Result[string, FormError]

impl Deferred:
    fn set_form[T < Serialize](mut self, value: T) -> Deferred:
        self.body = encode(value)
        self
    fn set_query[T < Serialize](mut self, value: T) -> Deferred:
        self.query = encode(value)
        self
    fn transport(&self, calls: &mut List[usize]) -> Result[string, FormError]:
        query := self.query?
        body := self.body?
        calls.push(1)
        .Ok(query + "|" + body)

@derive(Serialize, Deserialize, Debug, Eq)
struct Deep:
    outer: Outer

@derive(Serialize, Deserialize)
struct OptionalDeep:
    outer: Outer?

struct Once:
    calls: *mut List[usize]

impl Serialize for Once:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        self.calls.push(1)
        out.text("once")

@derive(Serialize)
struct OnceRecord:
    value: Once

pub fn main() -> void $ Console:
    value := Outer { nested: Inner { count: 42, note: .None }, tags: ["a", "b"], active: true }
    text := match encode(value):
        .Ok(found) => found
        .Err(_) => panic("encoding failed")
    decoded := match decode::[Outer](text):
        .Ok(found) => found
        .Err(_) => panic("decoding failed")
    println(decoded.nested.count)

tests:
    it("nested records rename scalar Parse repeated order and wire brackets"):
        value := Outer { nested: Inner { count: 42, note: .None }, tags: ["a b", "+"], active: true }
        expected := "nested%5Bwire-count%5D=42&nested%5Bdefaulted%5D=17&tags=a+b&tags=%2B&active=true"
        assert_equal(encode(value), .Ok(expected), reason="actual Serializer traversal")
        assert_equal(decode::[Outer](expected), .Ok(value), reason="actual Deserialize traversal")
    it("unknown keys interleaved repeats optional absence and field default"):
        expected := Outer { nested: Inner { count: 9, note: .None }, tags: ["first", "last"], active: false }
        text := "tags=first&unknown[__proto__]=x&nested[wire-count]=9&active=false&tags=last"
        assert_equal(decode::[Outer](text), .Ok(expected), reason="declared fields only, independent pair order")
        assert_equal(decode::[Optional]("unknown=x"), .Ok(Optional { nested: .None, list: [] }), reason="model assumes absent List is empty")
    it("empty string is present rather than None"):
        value := Outer { nested: Inner { count: 1, note: .Some("") }, tags: [], active: true }
        assert_equal(decode::[Outer]("nested[wire-count]=1&nested[note]=&active=true"), .Ok(value), reason="empty optional text is Some empty")
    it("duplicate scalars and malformed Parse return typed errors"):
        assert_equal(decode::[Outer]("nested[wire-count]=1&nested[wire-count]=2&active=true"), .Err(.Duplicate("nested[wire-count]")), reason="explicit model duplicate policy")
        assert_equal(decode::[Outer]("nested[wire-count]=oops&active=true").is_err(), true, reason="Parse rejects malformed number")
    it("nested struct lists and maps return errors without panic"):
        inner := Inner { count: 1, note: .None }
        assert_equal(encode(BadList { items: [inner] }), .Err(.Shape("items")), reason="encountered list element is a struct")
        assert_equal(decode::[BadList]("items=x").is_err(), true, reason="encountered struct element rejects")
        assert_equal(encode(BadMap { values: {"x": "y"} }), .Err(.Shape("values")), reason="dynamic map rejects")
        assert_equal(decode::[BadMap]("values[x]=y").is_err(), true, reason="dynamic map cannot be built")
    it("strict percent UTF8 plus and equals mechanics"):
        assert_equal(parse_pairs("a%2Bb=x+y&bare&=v&&x=a=b"), .Ok([("a+b", "x y"), ("bare", ""), ("", "v"), ("x", "a=b")]), reason="ordered pair atom")
        assert_equal(parse_pairs("a=%GG"), .Err(.Percent(0)), reason="explicit strict percent assumption")
        assert_equal(parse_pairs("a=%FF"), .Err(.Utf8), reason="explicit strict UTF8 assumption")
    it("deferred failures block transport and component repair stays separate"):
        let mut calls: List[usize] = []
        inner := Inner { count: 1, note: .None }
        bad := Deferred { body: .Ok("old"), query: .Ok("old") }.set_form(BadMap { values: {} }).set_query(BadList { items: [inner] })
        assert_equal(bad.transport(&mut calls).is_err(), true, reason="setter completes, boundary refuses")
        assert_equal(calls.len(), 0, reason="no transport before validation")
        only_body := bad.set_form(inner)
        assert_equal(only_body.transport(&mut calls).is_err(), true, reason="repair body preserves query failure")
        fixed := only_body.set_query(inner)
        assert_equal(fixed.transport(&mut calls).is_ok(), true, reason="both components repaired")
        assert_equal(calls.len(), 1, reason="only valid state reaches transport")

    it("second bracket level rejects and optional one-level record works"):
        inner := Inner { count: 12, note: .None }
        deep := Deep { outer: Outer { nested: inner, tags: [], active: true } }
        assert_equal(encode(deep), .Err(.Shape("outer[nested]")), reason="next struct exceeds approved depth")
        assert_equal(decode::[Deep]("outer[nested][wire-count]=12"), .Err(.Shape("outer[nested]")), reason="no recursive construction")
        assert_equal(decode::[Optional]("nested[wire-count]=12"), .Ok(Optional { nested: .Some(inner), list: [] }), reason="one-level optional record")

    it("deferred boundary never repeats Serialize"):
        let mut serialized: List[usize] = []
        let mut transported: List[usize] = []
        request := Deferred { body: .Ok(""), query: .Ok("") }.set_form(OnceRecord { value: Once { calls: &mut serialized } })
        assert_equal(serialized.len(), 1, reason="encode at setter time")
        assert_equal(request.transport(&mut transported).is_ok(), true, reason="complete encoded value reaches transport")
        assert_equal(serialized.len(), 1, reason="boundary only validates stored result")

    it("deepObject child lists reject even when empty"):
        assert_equal(encode(NestedList { details: NumberList { values: [] } }), .Err(.Shape("details[values]")), reason="deepObject properties must be scalars")
        assert_equal(decode::[NestedList]("details[values]=1").is_err(), true, reason="reader uses identical child shape restriction")

    it("empty record lists and absent deeper records are allowed"):
        assert_equal(encode(BadList { items: [] }), .Ok(""), reason="no unsupported element is visited")
        match decode::[BadList](""):
            .Ok(empty) => assert_equal(empty.items.len(), 0, reason="empty record list remains empty")
            .Err(_) => panic("empty record list must decode")
        assert_equal(encode(OptionalDeep { outer: .None }), .Ok(""), reason="absent record does not descend")
        match decode::[OptionalDeep](""):
            .Ok(absent) => assert_equal(absent.outer.is_none(), true, reason="no deeper value is visited")
            .Err(_) => panic("absent optional record must decode")
