# Scratch proposal: tagged cookie entries and Result-bearing encoded body.
# This is not a production HTTP provider, form codec, URL parser or date codec.
use std.hash.Hasher
use std.time.{Duration, Timestamp}

fn fold_header_name(name: string) -> string:
    let mut bytes = name.to_utf8()
    for at in 0..bytes.len():
        if bytes[at] >= 65 && bytes[at] <= 90:
            bytes[at] = bytes[at] + 32
    string::from_utf8(bytes).expect("ASCII folding preserves UTF-8")

@derive(Debug)
pub enum HeaderName:
    Accept
    AcceptEncoding
    Authorization
    CacheControl
    Connection
    ContentEncoding
    ContentLength
    ContentType
    Cookie
    Host
    Location
    Origin
    ProxyAuthorization
    RetryAfter
    SetCookie
    TransferEncoding
    UserAgent
    Vary
    XForwardedFor
    XForwardedProto
    Other(name: string)

impl HeaderName:
    fn wire(&self) -> string:
        match *self:
            .Accept => "accept"
            .AcceptEncoding => "accept-encoding"
            .Authorization => "authorization"
            .CacheControl => "cache-control"
            .Connection => "connection"
            .ContentEncoding => "content-encoding"
            .ContentLength => "content-length"
            .ContentType => "content-type"
            .Cookie => "cookie"
            .Host => "host"
            .Location => "location"
            .Origin => "origin"
            .ProxyAuthorization => "proxy-authorization"
            .RetryAfter => "retry-after"
            .SetCookie => "set-cookie"
            .TransferEncoding => "transfer-encoding"
            .UserAgent => "user-agent"
            .Vary => "vary"
            .XForwardedFor => "x-forwarded-for"
            .XForwardedProto => "x-forwarded-proto"
            .Other(name) => fold_header_name(name)

    fn parse(name: string) -> HeaderName:
        match fold_header_name(name):
            "accept" => .Accept
            "accept-encoding" => .AcceptEncoding
            "authorization" => .Authorization
            "cache-control" => .CacheControl
            "connection" => .Connection
            "content-encoding" => .ContentEncoding
            "content-length" => .ContentLength
            "content-type" => .ContentType
            "cookie" => .Cookie
            "host" => .Host
            "location" => .Location
            "origin" => .Origin
            "proxy-authorization" => .ProxyAuthorization
            "retry-after" => .RetryAfter
            "set-cookie" => .SetCookie
            "transfer-encoding" => .TransferEncoding
            "user-agent" => .UserAgent
            "vary" => .Vary
            "x-forwarded-for" => .XForwardedFor
            "x-forwarded-proto" => .XForwardedProto
            _ => .Other(name)

impl Eq for HeaderName:
    fn eq(self, other: HeaderName) -> bool: self.wire() == other.wire()

impl Hash for HeaderName:
    fn hash(self, state: &mut dyn Hasher) -> void: self.wire().hash(state)

@derive(Eq, Debug)
enum SameSite:
    Strict
    Lax
    None

@derive(Eq, Debug)
struct Cookie:
    name: string
    value: string
    path: string? = .Some("/")
    domain: string? = .None
    max_age: Duration? = .None
    expires: Timestamp? = .None
    secure: bool = true
    http_only: bool = true
    same_site: SameSite = .Lax

@derive(Eq, Debug)
enum FormError:
    Unsupported(path: string)

@derive(Eq, Debug)
enum PrepError:
    Used
    Cookie(name: string)
    Form(cause: FormError)
    UnmodeledExpires
    UnmodeledSubsecondMaxAge

fn token(name: string) -> bool:
    if name.is_empty():
        return false
    for byte in name.to_utf8():
        let allowed = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || (byte >= 48 && byte <= 57)
        for punctuation in [33u8, 35u8, 36u8, 37u8, 38u8, 39u8, 42u8, 43u8, 45u8, 46u8, 94u8, 95u8, 96u8, 124u8, 126u8]:
            if byte == punctuation:
                allowed = true
        if !allowed:
            return false
    true

impl Cookie:
    fn validate(&self) -> Result[void, PrepError]:
        if !token(self.name) || (self.same_site == .None && !self.secure):
            return .Err(.Cookie(self.name))
        for byte in self.value.to_utf8():
            if byte < 33 || byte > 126 || byte == 34 || byte == 44 || byte == 59 || byte == 92:
                return .Err(.Cookie(self.name))
        for attribute in [self.path, self.domain]:
            if attribute.is_some():
                for byte in attribute.unwrap_or("").to_utf8():
                    if byte < 32 || byte > 126 || byte == 59:
                        return .Err(.Cookie(self.name))
        if self.max_age.is_some() && self.max_age.unwrap_or(0s).as_milliseconds() % 1000 != 0:
            return .Err(.UnmodeledSubsecondMaxAge)
        if self.expires.is_some():
            return .Err(.UnmodeledExpires)
        .Ok(())

    fn wire_after_validation(&self) -> string:
        let line = self.name + "=" + self.value
        if self.path.is_some():
            line += "; Path=" + self.path.unwrap_or("")
        if self.domain.is_some():
            line += "; Domain=" + self.domain.unwrap_or("")
        if self.max_age.is_some():
            line += "; Max-Age=" + "${self.max_age.unwrap_or(0s).as_milliseconds() / 1000}"
        if self.secure:
            line += "; Secure"
        if self.http_only:
            line += "; HttpOnly"
        line += match self.same_site:
            .Strict => "; SameSite=Strict"
            .Lax => "; SameSite=Lax"
            .None => "; SameSite=None"
        line

@derive(Eq, Debug)
enum HeaderEntry:
    Raw(name: HeaderName, value: string)
    TypedCookie(cookie: Cookie)

impl HeaderEntry:
    fn name(&self) -> HeaderName:
        match *self:
            .Raw(name, _) => name
            .TypedCookie(_) => .SetCookie

struct Headers:
    entries: List[HeaderEntry] = []

impl Headers:
    fn append_cookie(&mut self, cookie: Cookie) -> void:
        self.entries.push(.TypedCookie(cookie))

    fn set(&mut self, name: HeaderName, value: string) -> void:
        self.entries = self.entries.filter(fn(entry): entry.name() != name)
        self.entries.push(.Raw(name, value))

    fn materialize(&self) -> Result[List[(string, string)], PrepError]:
        let mut pairs: List[(string, string)] = []
        for entry in self.entries:
            match entry:
                .Raw(name, value) => pairs.push((name.wire(), value))
                .TypedCookie(cookie) =>
                    cookie.validate()?
                    pairs.push(("set-cookie", cookie.wire_after_validation()))
        .Ok(pairs)

@derive(Eq, Debug)
enum Payload:
    Bytes(bytes: List[u8])
    Form(result: Result[List[u8], FormError])

struct Body:
    payload: Payload
    used: bool = false

impl Body:
    fn from_bytes(bytes: List[u8]) -> *mut Body:
        &mut Body { payload: .Bytes(bytes) }

    fn from_form_result(result: Result[List[u8], FormError]) -> *mut Body:
        &mut Body { payload: .Form(result) }

    fn take(&mut self) -> Result[List[u8], PrepError]:
        if self.used:
            return .Err(.Used)
        self.used = true
        match self.payload:
            .Bytes(bytes) => .Ok(bytes)
            .Form(result) => result.map_err(fn(error): PrepError.Form(error))

    fn replace_bytes(&mut self, bytes: List[u8]) -> Result[void, PrepError]:
        if self.used:
            return .Err(.Used)
        self.payload = .Bytes(bytes)
        .Ok(())

struct Message:
    headers: Headers = Headers {}
    body: *mut Body

impl Message:
    fn new(bytes: List[u8]) -> Message:
        Message { body: Body::from_bytes(bytes) }

    fn set_cookie(mut self, cookie: Cookie) -> Message:
        self.headers.append_cookie(cookie)
        self

    fn set_header(mut self, name: HeaderName, value: string) -> Message:
        self.headers.set(name, value)
        self

    fn set_bytes(mut self, bytes: List[u8]) -> Message:
        self.body = Body::from_bytes(bytes)
        self

    fn set_form_result(mut self, result: Result[List[u8], FormError]) -> Message:
        self.body = Body::from_form_result(result)
        self

struct FakeTransport:
    calls: usize = 0
    sent: List[(string, string)] = []
    bytes: List[u8] = []

impl FakeTransport:
    fn send(&mut self, message: &Message) -> Result[void, PrepError]:
        headers := message.headers.materialize()?
        bytes := message.body.take()?
        self.calls += 1
        self.sent = headers
        self.bytes = bytes
        .Ok(())

pub fn main() -> void:
    pass

tests:
    use std.testing.assert_equal

    it("deferred cookie delimiter is rejected before flattening body or transport"):
        message := Message::new([1u8]).set_cookie(Cookie { name: "sid", value: "x; Secure" })
        let mut transport = FakeTransport {}
        assert_equal(transport.send(&message), .Err(.Cookie("sid")), reason="original typed value survives")
        assert_equal(transport.calls, 0, reason="no wire effect")
        assert_equal(message.body.used, false, reason="head error precedes body claim")
        assert_equal(message.headers.entries.len(), 1, reason="bad cookie is retained data")

    it("deferred SameSite None stays distinct from Option absence"):
        message := Message::new([]).set_cookie(Cookie { name: "sid", value: "x", same_site: .None, secure: false })
        let mut transport = FakeTransport {}
        assert_equal(transport.send(&message), .Err(.Cookie("sid")), reason="None requires Secure")
        assert_equal(transport.calls, 0, reason="no transport")

    it("deferred form result is reported by send and replacement detaches a body"):
        bad := Message::new([]).set_form_result(.Err(.Unsupported("items")))
        copy := bad
        repaired := copy.set_bytes([7u8])
        let mut transport = FakeTransport {}
        assert_equal(transport.send(&repaired), .Ok(()), reason="replacement owns fresh bytes")
        assert_equal(transport.bytes, [7u8], reason="new body bytes")
        assert_equal(bad.body.used, false, reason="old shared body untouched by replacement")
        assert_equal(transport.send(&bad), .Err(.Form(.Unsupported("items"))), reason="pending failure reaches terminal")
        assert_equal(transport.calls, 1, reason="failed send adds no effect")
        assert_equal(copy.body.used, true, reason="failed body preparation consumes shared source in this proposal")

    it("deferred head copies are independent while body aliases share consumption"):
        original := Message::new([1u8])
        edited := original.set_cookie(Cookie { name: "a", value: "1" }).set_cookie(Cookie { name: "b", value: "2" })
        let mut transport = FakeTransport {}
        assert_equal(original.headers.entries.len(), 0, reason="owned head")
        assert_equal(transport.send(&edited), .Ok(()), reason="two cookies can be sent")
        assert_equal(transport.sent.len(), 2, reason="separate Set-Cookie lines")
        assert_equal(transport.sent[0]._0, "set-cookie", reason="canonical HeaderName is preserved")
        assert_equal(transport.sent[1]._0, "set-cookie", reason="append never replace")
        assert_equal(original.body.used, true, reason="header setter retains shared body")
        assert_equal(transport.send(&original), .Err(.Used), reason="no body rewind")

    it("deferred header replacement removes superseded cookie provenance"):
        bad := Message::new([]).set_cookie(Cookie { name: "sid", value: "bad; injected" })
        repaired := bad.set_header(.SetCookie, "sid=clean")
        let mut transport = FakeTransport {}
        assert_equal(transport.send(&repaired), .Ok(()), reason="explicit raw replacement removes old logical slot")
        assert_equal(transport.sent, [("set-cookie", "sid=clean")], reason="only replacement is materialized")

    it("deferred in-place Body mutation is shared and cannot revive used aliases"):
        original := Message::new([1u8])
        copy := original
        assert_equal(copy.body.replace_bytes([9u8]), .Ok(()), reason="unread referent mutation is shared")
        let mut transport = FakeTransport {}
        assert_equal(transport.send(&original), .Ok(()), reason="shared new payload")
        assert_equal(transport.bytes, [9u8], reason="alias saw mutation")
        assert_equal(copy.body.replace_bytes([3u8]), .Err(.Used), reason="no resetting used state")
