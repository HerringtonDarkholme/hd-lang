use pkg.examples.{decode_archives, encoded_bytes, gzip_text}
use std.http.{Http, HttpError}
use std.time.Clock

pub fn main!() -> Result[void, HttpError] $ Http + Clock:
    _ := gzip_text!("https://example.com/releases.txt")
    _ := encoded_bytes!("https://example.com/archive.gz")
    _ := decode_archives([], [])
    .Ok(())
