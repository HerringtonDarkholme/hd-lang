use std.http.{CookieJar, Http, HttpError, Request, Response}
use std.time.Clock

@error
@derive(Debug, Eq)
pub enum InflateError:
    @error("invalid compressed data")
    InvalidData
    @error("decoded body exceeds the $limit byte limit")
    OutputTooLarge(limit: usize)

