use pkg.http_decompression.Client
use std.http.{CookieJar, Http, HttpError, Request, Url}

pub fn gzip_text!(url: string) -> Result[string, HttpError] $ Http:
    let mut client = Client::new()
    request := Request::get(Url::parse(url)?)
    response := client.send!(&request)?
    .Ok(response.text()?)

pub fn authenticated_gzip_text!(url: string, jar: CookieJar) -> Result[string, HttpError] $ Http:
    let mut client = Client::with_jar(jar)
    request := Request::get(Url::parse(url)?)
    response := client.send!(&request)?
    .Ok(response.text()?)

pub fn direct_gzip_text!(url: string) -> Result[string, HttpError] $ Http:
    response := Request::get(Url::parse(url)?).send!()?
    .Ok(response.text()?)
