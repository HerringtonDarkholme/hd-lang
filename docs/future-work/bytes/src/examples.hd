use pkg.list_view.ListView

## Keeps multipart payloads as shared sub-views, then releases a large parent for one saved part.
fn multipart_parts(
    body: ListView[u8],
    header_end: usize,
    saved_end: usize,
) -> (ListView[u8], ListView[u8]):
    header := body[..header_end]
    payload := body[header_end..]
    saved := payload[0..saved_end - header_end].compact()
    (header, saved)

## A digest or codec borrows one selected run without copying it.
fn checksum(bytes: &ListView[u8]) -> u64:
    let total: u64 = 0
    for byte in *bytes:
        total = total.wrapping_add(u64(byte))
    total

## Indexing reads the selected elements, not the backing list's unused prefix.
fn png_prefix(bytes: ListView[u8]) -> bool:
    bytes.len() >= 4 && bytes[0] == 0x89

## Host boundaries convert explicitly because their wire ABI owns a mutable list.
fn host_body(bytes: ListView[u8]) -> List[u8]:
    bytes.to_list()

## Equality compares selected elements across different buffers and offsets.
fn same_payload(left: ListView[u8], right: ListView[u8]) -> bool:
    left == right
