use std.ops.{Index, Range, RangeFrom, RangeTo}

## An immutable, cheaply copied view of contiguous bytes.
pub struct Bytes:
    storage: List[u8]
    start: usize
    end: usize

## The cursor returned when a Bytes value is iterated.
pub struct BytesIter:
    bytes: Bytes
    at: usize

impl Bytes:
    ## Takes a value snapshot of a byte list without copying its buffer.
    pub fn from_list(values: List[u8]) -> Bytes:
        panic("todo")

    ## Returns the number of bytes in this view.
    pub fn len(&self) -> usize:
        panic("todo")

    ## True when this view has no bytes.
    pub fn is_empty(&self) -> bool:
        panic("todo")

    ## Returns the byte at index, or None when it is outside this view.
    pub fn get(&self, index: usize) -> u8?:
        panic("todo")

    ## Copies this view into a mutable list.
    pub fn to_list(&self) -> List[u8]:
        panic("todo")

    ## Returns this view in a right-sized buffer, copying only when it retains unused bytes.
    pub fn compact(&self) -> Bytes:
        panic("todo")

impl Index[usize] for Bytes:
    type Out = u8
    fn index(self, key: usize) -> u8:
        panic("todo")

impl Index[Range[usize]] for Bytes:
    type Out = Bytes
    fn index(self, key: Range[usize]) -> Bytes:
        panic("todo")

impl Index[RangeFrom[usize]] for Bytes:
    type Out = Bytes
    fn index(self, key: RangeFrom[usize]) -> Bytes:
        panic("todo")

impl Index[RangeTo[usize]] for Bytes:
    type Out = Bytes
    fn index(self, key: RangeTo[usize]) -> Bytes:
        panic("todo")

impl Iterable[u8] for Bytes:
    type IntoIter = BytesIter
    fn iter(self) -> BytesIter:
        panic("todo")

impl Iterator[u8] for BytesIter:
    fn next(&mut self) -> u8?:
        panic("todo")

impl Eq for Bytes:
    fn eq(self, other: Bytes) -> bool:
        panic("todo")
