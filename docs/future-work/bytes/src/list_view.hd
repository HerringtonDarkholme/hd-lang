        panic("todo")

impl[T] Index[RangeTo[usize]] for ListView[T]:
    type Out = ListView[T]
    fn index(self, key: RangeTo[usize]) -> ListView[T]:
        panic("todo")

impl[T] Iterable[T] for ListView[T]:
