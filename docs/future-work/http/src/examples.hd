# Usage examples for the proposed std.http message API (src/http.hd).

use std.convert.From
use std.serde.{Deserialize, Serialize}
use pkg.http.{Cookie, HeaderName, Headers, Http, HttpError, HttpStatus, Request, Response, Url, get, post}

@derive(Serialize, Deserialize)
struct NewOrder:
    item: string
    quantity: u32

@derive(Serialize, Deserialize)
struct Order:
    id: u64
    item: string
    quantity: u32

@derive(Serialize, Deserialize)
struct Page:
    page: u32 = 1
    per_page: u32 = 20
    tags: List[string] = []

# ---- Client: write a request, read a response ---------------------------

fn create_order!(api: string, token: string, order: NewOrder) -> Result[Order, HttpError] $ Http:
    url := Url::parse("$api/orders")?
    response := Request::post(url)
        .set_header(.Authorization, "Bearer $token")
        .set_json(order)
        .send!()?
    created := response.ok()?.json::[Order]()?
    .Ok(created)

fn search!(api: string) -> Result[List[Order], HttpError] $ Http:
    let mut url = Url::parse("$api/orders")?
    url.add_query("page", 2)
    url.add_query("tag", "tea")
    orders := Request::get(url).send!()?.ok()?.json::[List[Order]]()?
    .Ok(orders)

# The free helpers take URL text.
fn quick!(api: string) -> Result[string, HttpError] $ Http:
    health := get!("$api/health")?.text()?
    _ := post!("$api/events", NewOrder { item: "tea", quantity: 1 })?
    .Ok(health)

# A 400-599 error keeps the response, so its body can still be read.
fn explain!(api: string) -> string $ Http:
    match get!("$api/missing"):
        .Ok(response) => response.status.code().to_string()
        .Err(.Status(response)) => response.text().unwrap_or("")
        .Err(error) => "$error"

# ---- Server: read a request, write a response ---------------------------

fn handle(req: &Request) -> Response:
    match req.url.path():
        "/orders" => orders(req)
        "/login" => login(req)
        _ => Response::status(.NotFound)

fn orders(req: &Request) -> Response:
    match req.method:
        .Get =>
            match req.query::[Page]():
                .Ok(page) => Response::status(.Ok).set_json(list_orders(page))
                .Err(error) => Response::status(.BadRequest).set_text("$error")
        .Post =>
            match req.json::[NewOrder]():
                .Ok(order) => Response::status(.Created).set_json(save(order))
                .Err(error) => Response::status(.BadRequest).set_text("$error")
        _ => Response::status(.Other(405))

fn login(req: &Request) -> Response:
    if req.cookie("session").is_some():
        return Response::status(.NoContent)
    Response::status(.Ok)
        .set_header(.CacheControl, "no-store")
        .set_cookie(Cookie { name: "session", value: "s3cr3t", max_age: .Some(3600s) })

fn logout() -> Response:
    Response::status(.NoContent).set_cookie(Cookie::expired("session"))

# ---- Proxy: forward an incoming request ---------------------------------

fn forward!(req: &Request, upstream: Url) -> Response $ Http:
    let mut out = Request::new(req.method, upstream)
    out.headers = req.headers
    out.body = req.body
    out = out.set_header(.XForwardedFor, "10.0.0.1")
    match out.send!():
        .Ok(response) => response
        .Err(.Status(response)) => response
        .Err(_) => Response::status(.BadGateway)

# ---- Typed headers through the ordinary From trait ------------------------

struct ApiHeaders:
    token: string
    request_id: string

impl From[ApiHeaders] for Headers:
    fn from(value: ApiHeaders) -> Headers:
        let mut headers = Headers::new()
        headers.set(.Authorization, "Bearer ${value.token}")
        headers.set(.XRequestId, value.request_id)
        headers

fn with_headers!(url: Url, auth: ApiHeaders) -> Result[HttpStatus, HttpError] $ Http:
    let mut req = Request::get(url)
    req.headers = Headers::from(auth)
    response := req.send!()?
    for cookie in response.cookies():
        _ := cookie.name
    .Ok(response.status)

fn list_orders(page: Page) -> List[Order]:
    []

fn save(order: NewOrder) -> Order:
    Order { id: 1, item: order.item, quantity: order.quantity }
