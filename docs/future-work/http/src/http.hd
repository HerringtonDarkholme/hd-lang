# std.http message API (#847): signatures for review. Bodies are
# `panic("todo")`; examples.hd uses every part of it, and both check.

use std.convert.From
use std.hash.{Hash, Hasher}
use std.task.TimedOut
use std.text.Parse
use std.json.JsonError
use std.serde.{Deserialize, Serialize}
use std.time.{Duration, Timestamp}

# ---- Status and header names ----------------------------------------

## An HTTP status; known codes are variants, any other code is `Other`.
@derive(Debug)
pub enum HttpStatus:
    Ok                    # 200
    Created               # 201
    Accepted              # 202
    NoContent             # 204
    PartialContent        # 206
    MovedPermanently      # 301
    Found                 # 302
    SeeOther              # 303
    NotModified           # 304
    TemporaryRedirect     # 307
    PermanentRedirect     # 308
    BadRequest            # 400
    Unauthorized          # 401
    Forbidden             # 403
    NotFound              # 404
    MethodNotAllowed      # 405
    RequestTimeout        # 408
    Conflict              # 409
    Gone                  # 410
    PreconditionFailed    # 412
    ContentTooLarge       # 413
    UnsupportedMediaType  # 415
    UnprocessableContent  # 422
    TooManyRequests       # 429
    InternalServerError   # 500
    NotImplemented        # 501
    BadGateway            # 502
    ServiceUnavailable    # 503
    GatewayTimeout        # 504
    Other(code: u16)

impl HttpStatus:
    pub fn code(&self) -> u16: panic("todo")
    ## 404 gives `.NotFound`, never `.Other(404)`.
    pub fn from_code(code: u16) -> HttpStatus: panic("todo")
    ## 200 to 299.
    pub fn is_success(&self) -> bool: panic("todo")

## Equal when the codes are equal: `.Other(404) == .NotFound`.
impl Eq for HttpStatus:
    fn eq(self, other: HttpStatus) -> bool: panic("todo")

impl Hash for HttpStatus:
    fn hash(self, state: &mut dyn Hasher) -> void: panic("todo")

## A header name; compared and hashed by its lowercase wire name.
@derive(Debug)
pub enum HeaderName:
    # Content and negotiation
    Accept
    AcceptEncoding
    AcceptLanguage
    ContentDisposition
    ContentEncoding
    ContentLength
    ContentRange
    ContentType
    Range
    # Caching and conditional requests
    CacheControl
    ETag
    Expires
    IfMatch
    IfModifiedSince
    IfNoneMatch
    LastModified
    Vary
    # Auth, cookies, retries
    Authorization
    Cookie
    RetryAfter
    SetCookie
    WwwAuthenticate
    # CORS
    AccessControlAllowCredentials
    AccessControlAllowHeaders
    AccessControlAllowMethods
    AccessControlAllowOrigin
    AccessControlMaxAge
    AccessControlRequestHeaders
    AccessControlRequestMethod
    Origin
    # Security
    ContentSecurityPolicy
    StrictTransportSecurity
    XContentTypeOptions
    XFrameOptions
    # Routing and proxies
    Allow
    Forwarded
    Host
    Location
    Referer
    XForwardedFor
    XForwardedHost
    XForwardedProto
    # General
    Date
    Server
    UserAgent
    XRequestId
    # Connection, Transfer-Encoding, Upgrade and Keep-Alive belong to the host.
    Other(name: string)

impl HeaderName:
    ## The lowercase name sent on the wire.
    pub fn wire_name(&self) -> string: panic("todo")

## `"content-type".parse::[HeaderName]()` gives `.ContentType` in any case,
## never `Other`; text that is not an RFC 9110 token is `InvalidName`.
impl Parse for HeaderName:
    type Error = HeaderError
    fn parse(text: string) -> Result[HeaderName, HeaderError]: panic("todo")

impl Eq for HeaderName:
    fn eq(self, other: HeaderName) -> bool: panic("todo")

impl Hash for HeaderName:
    fn hash(self, state: &mut dyn Hasher) -> void: panic("todo")

## Ordered name/value pairs; a name may repeat. Incoming headers are
## checked by the host when it parses the request; outgoing ones by send!
## and the server, which reject CR/LF before writing (InvalidHeader).
@derive(Debug, Eq)
pub struct Headers:
    pairs: List[(HeaderName, string)]

impl Headers:
    pub fn new() -> Headers: panic("todo")
    ## Every value of `name`, joined with ", " as RFC 9110 §5.3 allows.
    ## Set-Cookie lines can't be joined; read them with response_cookies().
    pub fn get(&self, name: HeaderName) -> string?: panic("todo")
    ## Replaces every value of `name`. A list-valued header takes one
    ## comma-separated value (RFC 9110 §5.3).
    pub fn set(&mut self, name: HeaderName, value: string) -> void: panic("todo")
    pub fn remove(&mut self, name: HeaderName) -> void: panic("todo")
    ## Every name/value pair in order, as received or set.
    pub fn entries(&self) -> List[(HeaderName, string)]: panic("todo")

    # Request cookies, the Cookie header: name=value pairs, no attributes.
    pub fn request_cookie(&self, name: string) -> string?: panic("todo")
    pub fn request_cookies(&self) -> List[(string, string)]: panic("todo")
    ## Sets `name=value` in the one Cookie header, replacing that name.
    pub fn set_request_cookie(&mut self, name: string, value: string) -> void: panic("todo")

    # Response cookies, the Set-Cookie lines: one line per cookie, with attributes.
    pub fn response_cookies(&self) -> List[Cookie]: panic("todo")
    ## Sets one Set-Cookie line, replacing an earlier line for the same name.
    pub fn set_response_cookie(&mut self, cookie: Cookie) -> void: panic("todo")

impl From[List[(string, string)]] for Headers:
    fn from(pairs: List[(string, string)]) -> Headers: panic("todo")

impl From[Map[string, string]] for Headers:
    fn from(map: Map[string, string]) -> Headers: panic("todo")

# ---- URL --------------------------------------------------------------

## A parsed absolute URL: parse once, then read the parts as fields.
@derive(Debug, Eq)
pub struct Url:
    pub scheme: string
    pub host: string
    pub port: u16?
    ## Percent-decoded.
    pub path: string
    ## Percent-decoded name/value pairs, in order; a name may repeat.
    pub query: List[(string, string)] = []
    pub fragment: string? = .None

impl Url:
    pub fn parse(text: string) -> Result[Url, UrlError]: panic("todo")
    pub fn resolve(&self, reference: string) -> Result[Url, UrlError]: panic("todo")

    ## The whole query decoded into `T`, OpenAPI form style: a list field
    ## takes repeated keys, a struct field one bracket level (`f[x]=1`).
    pub fn query_as[T < Deserialize](&self) -> Result[T, FormError]: panic("todo")
    ## Replaces the whole query with `value`, the same encoding.
    pub fn set_query_as[T < Serialize](&mut self, value: T) -> void: panic("todo")
    ## The first value of one key.
    pub fn param(&self, name: string) -> string?: panic("todo")
    ## Adds one `name=value` pair.
    pub fn add_param[T < Display](&mut self, name: string, value: T) -> void: panic("todo")

## The URL encoded as text.
impl Display for Url:
    fn to_string(self) -> string: panic("todo")

# ---- Body -------------------------------------------------------------

## A body read once: a second read is `BodyError.Used`. Equal and printed by its bytes.
@derive(Debug, Eq)
pub struct Body:
    bytes: List[u8]
    used: bool

impl Body:
    fn empty() -> *mut Body: panic("todo")
    pub fn from_bytes(bytes: List[u8]) -> *mut Body: panic("todo")

    # Each read consumes the body; a second read is `BodyError.Used`.
    pub fn bytes(&mut self) -> Result[List[u8], BodyError]: panic("todo")
    ## Invalid UTF-8 is replaced with U+FFFD.
    pub fn text(&mut self) -> Result[string, BodyError]: panic("todo")
    pub fn json[T < Deserialize](&mut self) -> Result[T, BodyError]: panic("todo")
    ## OpenAPI form style, the same rules as Url.query_as.
    pub fn form[T < Deserialize](&mut self) -> Result[T, BodyError]: panic("todo")

# ---- Cookies ----------------------------------------------------------

@derive(Debug, Eq)
pub enum SameSite:
    Strict
    Lax
    None

## A Set-Cookie value. The defaults are the secure ones.
@derive(Debug, Eq)
pub struct Cookie:
    pub name: string
    pub value: string
    pub path: string? = .Some("/")
    pub domain: string? = .None
    pub max_age: Duration? = .None
    pub expires: Timestamp? = .None
    pub secure: bool = true
    pub http_only: bool = true
    pub same_site: SameSite = .Lax

impl Cookie:
    ## A cookie that deletes `name` (Max-Age=0).
    pub fn expired(name: string) -> Cookie: panic("todo")

# ---- Client cookie jar ----------------------------------------------------

## Cookies a client keeps between requests: matched by domain, path,
## expiry and Secure (RFC 6265). Plain data, so a program saves it with
## serde through its own file capability.
@derive(Debug, Eq, Serialize, Deserialize)
pub struct CookieJar:
    cookies: List[StoredCookie]

@derive(Debug, Eq, Serialize, Deserialize)
struct StoredCookie:
    name: string
    value: string
    domain: string
    host_only: bool
    path: string
    expires: Timestamp?
    secure: bool
    http_only: bool

impl CookieJar:
    pub fn new() -> CookieJar: panic("todo")
    ## The name/value pairs to send to `url`.
    pub fn cookies_for(&self, url: &Url) -> List[(string, string)]: panic("todo")
    ## Records a response's Set-Cookie lines; Max-Age=0 deletes.
    pub fn store(&mut self, url: &Url, response: &Response) -> void: panic("todo")
    ## Drops expired cookies.
    pub fn clear_expired(&mut self) -> void: panic("todo")

## Sends requests with one jar: fills the Cookie header before each send
## and stores every Set-Cookie line after, across redirects too.
pub struct Client:
    pub jar: CookieJar = CookieJar::new()

impl Client:
    pub fn new() -> Client: panic("todo")
    pub fn with_jar(jar: CookieJar) -> Client: panic("todo")
    pub fn send!(&mut self, request: &Request, redirects: usize = 10) -> Result[Response, HttpError] $ Http: panic("todo")

# ---- Request ----------------------------------------------------------

## The same type in both directions: `set_*` writes, plain names read.
@derive(Debug, Eq)
pub struct Request:
    pub method: Method = .Get
    pub url: Url
    pub headers: Headers = Headers::new()
    pub body: *mut Body = Body::empty()

impl Request:
    pub fn new(method: Method, url: Url) -> Request: panic("todo")
    pub fn get(url: Url) -> Request: panic("todo")
    pub fn post(url: Url) -> Request: panic("todo")

    # Writers: return the changed request, so they chain.
    ## JSON body and Content-Type.
    pub fn set_json[T < Serialize](mut self, value: T) -> Request: panic("todo")
    pub fn set_text(mut self, text: string) -> Request: panic("todo")
    pub fn set_bytes(mut self, bytes: List[u8]) -> Request: panic("todo")
    ## Form body, OpenAPI form style; one bracket level for a nested struct.
    pub fn set_form[T < Serialize](mut self, value: T) -> Request: panic("todo")
    ## url.set_query_as, chained.
    pub fn set_query_as[T < Serialize](mut self, value: T) -> Request: panic("todo")
    ## headers.set, chained.
    pub fn set_header(mut self, name: HeaderName, value: string) -> Request: panic("todo")
    ## headers.set_request_cookie, chained. A request cookie is only a name and value.
    pub fn set_cookie(mut self, name: string, value: string) -> Request: panic("todo")

    # Readers, short for body.*, url.query_as and headers.* .
    pub fn json[T < Deserialize](&self) -> Result[T, BodyError]: panic("todo")
    pub fn text(&self) -> Result[string, BodyError]: panic("todo")
    pub fn bytes(&self) -> Result[List[u8], BodyError]: panic("todo")
    pub fn form[T < Deserialize](&self) -> Result[T, BodyError]: panic("todo")
    pub fn query_as[T < Deserialize](&self) -> Result[T, FormError]: panic("todo")
    pub fn header(&self, name: HeaderName) -> string?: panic("todo")
    pub fn cookie(&self, name: string) -> string?: panic("todo")

    ## Checks headers, then sends through the covering provider.
    pub fn send!(&self, redirects: usize = 10) -> Result[Response, HttpError] $ Http: panic("todo")

# ---- Response ---------------------------------------------------------

@derive(Debug, Eq)
pub struct Response:
    pub status: HttpStatus = .Ok
    pub headers: Headers = Headers::new()
    pub body: *mut Body = Body::empty()
    ## The URL that answered, after redirects; set by send!.
    pub url: Url? = .None

impl Response:
    pub fn status(code: HttpStatus) -> Response: panic("todo")

    pub fn set_json[T < Serialize](mut self, value: T) -> Response: panic("todo")
    pub fn set_text(mut self, text: string) -> Response: panic("todo")
    pub fn set_bytes(mut self, bytes: List[u8]) -> Response: panic("todo")
    pub fn set_header(mut self, name: HeaderName, value: string) -> Response: panic("todo")
    ## headers.set_response_cookie, chained: one Set-Cookie line with its attributes.
    pub fn set_cookie(mut self, cookie: Cookie) -> Response: panic("todo")

    # Readers, short for body.* and headers.* .
    pub fn json[T < Deserialize](&self) -> Result[T, BodyError]: panic("todo")
    pub fn text(&self) -> Result[string, BodyError]: panic("todo")
    pub fn bytes(&self) -> Result[List[u8], BodyError]: panic("todo")
    pub fn header(&self, name: HeaderName) -> string?: panic("todo")
    ## headers.response_cookies: every Set-Cookie line, parsed.
    pub fn cookies(&self) -> List[Cookie]: panic("todo")
    ## A 400–599 status is `.Err(HttpError.Status(response))`, which keeps the
    ## whole response so its error body can still be read.
    pub fn ok(&self) -> Result[Response, HttpError]: panic("todo")

# ---- Provider and helpers -----------------------------------------------

pub trait Http:
    fn send!(&mut self, request: &Request, redirects: usize) -> Result[Response, HttpError]

## GET `url` (text), checked with ok().
pub fn get!(url: string) -> Result[Response, HttpError] $ Http: panic("todo")

## POST `value` as JSON to `url` (text), checked with ok().
pub fn post![T < Serialize](url: string, value: T) -> Result[Response, HttpError] $ Http: panic("todo")

# ---- Errors -------------------------------------------------------------

@derive(Debug, Eq)
pub enum Method:
    Get
    Head
    Post
    Put
    Patch
    Delete
    Options
    Other(name: string)

@error
@derive(Debug, Eq)
pub enum BodyError:
    @error("the body was already read")
    Used
    @error("invalid JSON body: $error")
    Json(error: JsonError)
    @error("invalid form body: $error")
    Form(error: FormError)

@error
@derive(Debug, Eq)
pub enum FormError:
    ## A nested struct deeper than one bracket level, a list of structs, or a map.
    @error("field ${field} has no form encoding")
    Unsupported(field: string)
    @error("missing field ${field}")
    Missing(field: string)
    @error("field ${field}: cannot read ${text}")
    Invalid(field: string, text: string)

@error
@derive(Debug, Eq)
pub enum HeaderError:
    @error("invalid header name ${name}")
    InvalidName(name: string)
    @error("invalid value for header ${name}")
    InvalidValue(name: string)

@error
@derive(Debug, Eq)
pub enum UrlError:
    @error("invalid URL: ${text}")
    Invalid(text: string)
    @error("relative URL without a base: ${text}")
    RelativeWithoutBase(text: string)

@error
@derive(Debug, Eq)
pub enum HttpError:
    @error("http access to ${host} is not granted")
    NotGranted(host: string)
    @error("invalid URL: ${url}")
    InvalidUrl(url: string)
    @error("invalid header ${name}")
    InvalidHeader(name: string)
    @error("cannot resolve host ${host}")
    Dns(host: string)
    @error("$message")
    Connect(message: string)
    @error("TLS failed: ${message}")
    Tls(message: string)
    @error("the request timed out")
    Timeout
    @error("too many redirects; the last went to ${url}")
    TooManyRedirects(url: string)
    ## A 400–599 response from ok(), kept whole.
    @error("HTTP status ${response.status.code()}")
    Status(response: Response)
    ## A body that could not be encoded when sent.
    @error("$error")
    Body(error: BodyError)
    @error("$message")
    Other(message: string)

impl HttpError:
    ## A timeout, a connection failure, or status 408, 429, 500, 502, 503 or 504.
    pub fn is_transient(&self) -> bool: panic("todo")

## A composed deadline has the same error as the operation it bounds.
impl From[TimedOut] for HttpError:
    fn from(error: TimedOut) -> HttpError: panic("todo")

impl From[BodyError] for HttpError:
    fn from(error: BodyError) -> HttpError: panic("todo")

## `Url::parse(text)?` in a function returning HttpError gives InvalidUrl.
impl From[UrlError] for HttpError:
    fn from(error: UrlError) -> HttpError: panic("todo")
