use std.task.map_all
use std.time.{Clock, sleep}

struct State:
    next: usize
    admitted: usize
    completed: usize
    stopping: bool
    workers: List[usize]

fn worker!(slot: usize, jobs: List[usize], state: &mut State) -> void $ Clock:
    state.workers.push(slot)
    while !state.stopping && state.next < jobs.len():
        index := state.next
        state.next = index + 1
        state.admitted = state.admitted + 1
        # Script a soft-stop notification while an earlier job is pending.
        if index == 1:
            state.stopping = true
        sleep!(1ms)
        state.completed = state.completed + 1

pub fn main!() -> void $ Clock + Console:
    state := &mut State { next: 0, admitted: 0, completed: 0, stopping: false, workers: [] }
    jobs := [0, 1, 2]
    _ := map_all!([0, 1], 2, fn!(slot: usize) -> void $ Clock: worker!(slot, jobs, state))
    println("admitted=${state.admitted} completed=${state.completed} queued=${jobs.len() - state.next} workers=${state.workers.len()}")
