use std.format.DebugWriter
use std.host.{Env, ScriptedEnv, env_decode}
use std.serde.Deserialize

@derive(Debug, Deserialize)
struct Config:
    port: u16
    topic: string

struct Secret:
    text: string

impl Debug for Secret:
    fn debug(self, out: &mut DebugWriter) -> void:
        out.write("[redacted]")

impl Secret:
    fn reveal(&self) -> string: self.text

pub fn main() -> void $ Console:
    $.with(Env=&ScriptedEnv::new({"PORT": "8080", "TOPIC": "jobs"})):
        config := env_decode::[Config]().expect("synthetic config")
        println(debug(config))
    $.with(Env=&ScriptedEnv::new({"PORT": "70000", "TOPIC": "jobs"})):
        println("invalid=${env_decode::[Config]().is_err()}")
    secret := Secret { text: "synthetic-only" }
    println(debug(secret))
    println("revealed-bytes=${secret.reveal().len()}")
