use std.task.race
use std.time.{Clock, sleep}

struct State:
    completed: usize
    cleaned: usize

fn job!(state: &mut State) -> usize $ Clock:
    defer: state.cleaned = state.cleaned + 1
    sleep!(1s)
    state.completed = state.completed + 1
    7

fn stop!() -> usize: 0

pub fn main!() -> void $ Clock + Console:
    state := &mut State { completed: 0, cleaned: 0 }
    winner := race!(job(state), stop())
    println("winner=$winner completed=${state.completed} cleaned=${state.cleaned}")
