use std.task.map_all
use std.time.{Clock, sleep}

struct Counter:
    value: usize

fn stale!(counter: &mut Counter) -> void $ Clock:
    old := counter.value
    sleep!(1ms)
    counter.value = old + 1

fn current!(counter: &mut Counter) -> void $ Clock:
    sleep!(1ms)
    counter.value = counter.value + 1

pub fn main!() -> void $ Clock + Console:
    a := &mut Counter { value: 0 }
    b := &mut Counter { value: 0 }
    _ := map_all!([0, 1], 2, fn!(slot: usize) -> void $ Clock: stale!(a))
    _ := map_all!([0, 1], 2, fn!(slot: usize) -> void $ Clock: current!(b))
    println("stale=${a.value} current=${b.value}")
