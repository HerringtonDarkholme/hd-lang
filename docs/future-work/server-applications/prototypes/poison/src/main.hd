use std.host.{Args, args}
use std.task.all
use std.time.{Clock, sleep}

fn pending!() -> void $ Clock + Console:
    defer: dbg("cleanup-marker")
    println("pending")
    sleep!(5ms)
    println("completed")

fn fault!(crash: bool) -> void:
    if crash:
        panic("handler crashed")

pub fn main!() -> void $ Args + Clock + Console:
    _ := all!(pending(), fault(args()[0] == "panic"))
