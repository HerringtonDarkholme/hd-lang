use std.host.{Args, args}
use std.net.{Net, NetError, connect}
use std.task.all

fn client!(port: u16) -> Result[usize, NetError] $ Net:
    using stream = connect!("127.0.0.1", port)?
    stream.write!("ready".to_utf8())?
    bytes := stream.read!(1)?
    .Ok(bytes.len())

pub fn main!() -> void $ Args + Net + Console:
    port := args()[0].parse::[u16]().expect("port")
    let (a, b) = all!(client(port), client(port))
    println("${a.unwrap_or(0)} ${b.unwrap_or(0)}")
