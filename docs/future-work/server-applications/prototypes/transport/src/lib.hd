use std.net.{Net, NetError, TcpStream, connect}
use std.task.map_all
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}

# Control transport only: four-byte little-endian length, at most 64 KiB.
fn exact!(stream: &mut dyn TcpStream, count: usize) -> Result[List[u8], NetError]:
    let mut bytes: List[u8] = []
    while bytes.len() < count:
        chunk := stream.read!(count - bytes.len())?
        if chunk.is_empty():
            break
        for byte in chunk:
            bytes.push(byte)
    .Ok(bytes)

fn receive!(stream: &mut dyn TcpStream) -> Result[string?, NetError]:
    header := exact!(stream, 4)?
    if header.is_empty():
        return .Ok(.None)
    if header.len() != 4:
        return .Err(.Other("truncated frame header"))
    size := usize(header[0]) + usize(header[1]) * 256 + usize(header[2]) * 65536 + usize(header[3]) * 16777216
    if size > 65536:
        return .Err(.Other("frame exceeds 65536 bytes"))
    body := exact!(stream, size)?
    if body.len() != size:
        return .Err(.Other("truncated frame body"))
    match string::from_utf8(body):
        .Ok(text) => .Ok(.Some(text))
        .Err(_) => .Err(.Other("frame is not UTF-8"))

fn send!(stream: &mut dyn TcpStream, text: string) -> Result[void, NetError]:
    bytes := text.to_utf8()
    size := bytes.len()
    if size > 65536:
        return .Err(.Other("frame exceeds 65536 bytes"))
    let header: List[u8] = [u8(size % 256), u8(size / 256 % 256), u8(size / 65536 % 256), u8(size / 16777216)]
    stream.write!(header)?
    stream.write!(bytes)?
    .Ok(())

fn worker![S, $R](port: u16, slot: usize, state: &mut S, handle: fn!(string, &mut S) -> string $ R) -> Result[void, NetError] $ R + Net:
    using stream = connect!("127.0.0.1", port)?
    stream.set_nodelay(true)?
    send!(stream, "$slot")?
    while true:
        frame := receive!(stream)?
        text := match frame:
            .Some(value) => value
            .None => break
        if text == "stop":
            break
        response := handle!(text, state)
        send!(stream, response)?
    .Ok(())

# Two persistent worker loops, not one instance or process per message.
pub fn serve![S, $R](port: u16, state: &mut S, handle: fn!(string, &mut S) -> string $ R) -> Result[void, NetError] $ R + Net:
    results := map_all!([0, 1], 2, fn!(slot: usize) -> Result[void, NetError] $ R + Net: worker!(port, slot, state, handle))
    for result in results:
        match result:
            .Ok(_) => pass
            .Err(error) => return .Err(error)
    .Ok(())

# Typed outer API, in ordinary hd. Private errors have an explicit public map.
pub fn serve_typed![S, I < Deserialize, O < Serialize, E, $R](port: u16, state: &mut S, handle: fn!(I, &mut S) -> Result[O, E] $ R, invalid: O, failed: fn(E) -> O) -> Result[void, NetError] $ R + Net:
    adapter := fn!(raw: string, shared: &mut S) -> string $ R:
        input := match decode::[I](raw):
            .Ok(value) => value
            .Err(_) => return encode(invalid)
        output := match handle!(input, shared):
            .Ok(value) => value
            .Err(error) => failed(error)
        encode(output)
    serve!(port, state, adapter)
