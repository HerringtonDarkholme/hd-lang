use dep.model.{Event, Reply, State, handle, start, stop}
use dep.transport.serve_typed
use std.host.{Args, args}
use std.http.Request
use std.net.{Net, NetError}
use std.serde.Deserialize
use std.time.{Clock, sleep}

@derive(Deserialize)
struct Input:
    kind: string
    number: i32 = +0
    body: string = ""

enum Failure:
    UnknownEvent

fn public_failure(error: Failure) -> Reply:
    Reply { status: 500, text: "event failed", acknowledge: false }

fn dispatch!(input: Input, state: &mut State) -> Result[Reply, Failure] $ Clock:
    event := match input.kind:
        "http" => Event.Http(Request { url: "/greet", body: input.body.to_utf8() })
        "worker" => Event.Work(input.number)
        "hold" =>
            sleep!(200ms)
            Event.Work(input.number)
        "queue" => Event.Queue(input.number)
        "cron" => Event.Cron(input.number)
        _ => return .Err(Failure.UnknownEvent)
    .Ok(handle!(event, state))

pub fn main!() -> Result[void, NetError] $ Args + Console + Net + Clock:
    port := args()[0].parse::[u16]().expect("broker port")
    state := start()
    invalid := Reply { status: 400, text: "invalid event", acknowledge: false }
    serve_typed!(port, state, dispatch, invalid, public_failure)?
    stop(state)
    println("count=${state.count} stopped=${state.stopped}")
    .Ok(())
