use dep.model.{State, start, stop, wire}
use dep.transport.serve
use std.host.{Args, args}
use std.net.{Net, NetError}
use std.time.Clock

# These hooks remain ordinary functions. main emulates the missing driver.
pub fn initialize!() -> &mut State: start()

pub fn dispatch!(text: string, state: &mut State) -> string $ Clock:
    wire!(text, state)

pub fn shutdown!(state: &mut State) -> void: stop(state)

pub fn main!() -> Result[void, NetError] $ Args + Console + Net + Clock:
    port := args()[0].parse::[u16]().expect("broker port")
    state := initialize!()
    serve!(port, state, dispatch)?
    shutdown!(state)
    println("count=${state.count} stopped=${state.stopped}")
    .Ok(())
