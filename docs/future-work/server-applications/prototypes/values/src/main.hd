struct Counter:
    count: i32

pub fn main() -> void $ Console:
    let mut original = Counter { count: +1 }
    let mut copy = original
    copy.count = +9
    reference := &mut original
    alias := reference
    alias.count = +2
    let pointer: &mut Counter = reference
    captured := fn() -> i32: pointer.count
    pointer = &mut Counter { count: +3 }
    println("original=${original.count} copy=${copy.count} captured=${captured()}")
