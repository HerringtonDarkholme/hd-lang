use std.http.{Request, Response}
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}
use std.time.{Clock, sleep}

pub enum Event:
    Http(Request)
    Work(i32)
    Queue(i32)
    Cron(i32)

pub struct State:
    pub count: i32
    pub seen: List[(string, i32)]
    pub stopped: bool

@derive(Deserialize)
struct Name:
    name: string

@derive(Serialize)
struct Greeting:
    greeting: string

@derive(Serialize)
pub struct Reply:
    pub status: u16
    pub text: string
    pub acknowledge: bool

pub fn start() -> &mut State:
    &mut State { count: +0, seen: [], stopped: false }

pub fn json(request: Request) -> Response:
    text := match string::from_utf8(request.body):
        .Ok(value) => value
        .Err(_) => return Response { status: 400 }
    input := match decode::[Name](text):
        .Ok(value) => value
        .Err(_) => return Response { status: 400 }
    Response { status: 200, headers: [("content-type", "application/json")], body: encode(Greeting { greeting: "Hello ${input.name}" }).to_utf8() }

fn commit(state: &mut State, namespace: string, id: i32) -> Reply:
    key := (namespace, id)
    if state.seen.contains(key):
        return Reply { status: 200, text: "duplicate", acknowledge: true }
    state.seen.push(key)
    state.count = state.count + 1
    Reply { status: 200, text: "$namespace:$id", acknowledge: true }

pub fn handle!(event: Event, state: &mut State) -> Reply $ Clock:
    match event:
        .Http(request) =>
            response := json(request)
            Reply { status: response.status, text: string::from_utf8(response.body).expect("JSON is UTF-8"), acknowledge: false }
        .Work(value) =>
            sleep!(1ms)
            state.count = state.count + value
            Reply { status: 200, text: "worked:$value", acknowledge: false }
        .Queue(id) =>
            sleep!(1ms)
            commit(state, "queue", id)
        .Cron(id) =>
            sleep!(1ms)
            commit(state, "cron", id)

pub fn stop(state: &mut State) -> void:
    state.stopped = true

pub fn cases(mode: string) -> List[Event]:
    if mode == "http":
        return [Event.Http(Request { url: "/greet", body: "{\"name\":\"Ada\"}".to_utf8() }), Event.Http(Request { url: "/greet", body: "bad json".to_utf8() })]
    if mode == "worker":
        return [Event.Work(+3), Event.Work(+4)]
    if mode == "queue":
        return [Event.Queue(+7), Event.Queue(+7), Event.Queue(+8)]
    [Event.Cron(+7), Event.Cron(+7), Event.Cron(+8)]

@derive(Deserialize)
struct Wire:
    kind: string
    number: i32 = +0
    body: string = ""

# Decode at the app boundary; transport and lifecycle do not know HTTP.
pub fn wire!(text: string, state: &mut State) -> string $ Clock:
    input := match decode::[Wire](text):
        .Ok(value) => value
        .Err(_) => return encode(Reply { status: 400, text: "invalid event", acknowledge: false })
    event := match input.kind:
        "http" => Event.Http(Request { url: "/greet", body: input.body.to_utf8() })
        "worker" => Event.Work(input.number)
        "hold" =>
            sleep!(200ms)
            Event.Work(input.number)
        "queue" => Event.Queue(input.number)
        "cron" => Event.Cron(input.number)
        _ => return encode(Reply { status: 400, text: "unknown event", acknowledge: false })
    encode(handle!(event, state))
