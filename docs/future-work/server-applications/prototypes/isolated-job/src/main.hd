use dep.model.{Event, Reply, handle, start, stop}
use std.host.{Args, args}
use std.http.Request
use std.json.encode
use std.serde.Serialize
use std.time.Clock

@derive(Serialize)
struct Finished:
    reply: Reply
    count: i32

# This command deliberately owns stdout as its one-reply protocol.
pub fn main!() -> void $ Args + Console + Clock:
    words := args()
    kind := words[0]
    event := if kind == "http":
        Event.Http(Request { url: "/greet", body: words[1].to_utf8() })
    else:
        number := words[1].parse::[i32]().expect("job number")
        match kind:
            "worker" => Event.Work(number)
            "queue" => Event.Queue(number)
            "cron" => Event.Cron(number)
            _ => panic("unknown job")
    state := start()
    reply := handle!(event, state)
    stop(state)
    println(encode(Finished { reply: reply, count: state.count }))
