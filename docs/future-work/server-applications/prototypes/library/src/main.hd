use dep.model.{cases, handle, start, stop}
use std.host.{Args, args}
use std.json.encode
use std.time.Clock

# Finite ingress control, not a registered host ingress or signal bridge.
pub fn main!() -> void $ Args + Clock + Console:
    state := start()
    for event in cases(args()[0]):
        println(encode(handle!(event, state)))
    stop(state)
    println("count=${state.count} stopped=${state.stopped}")
