use std.http.{CookieJar, Http, HttpError, Request, Response, Url}
use std.time.{Clock, Duration}

## A validated HTTP CONNECT proxy endpoint.
@derive(Debug, Eq)
pub struct Proxy:
    url: Url

impl Proxy:
    ## Validates an `http` proxy endpoint without credentials.
    pub fn http(url: Url) -> Result[Proxy, ClientConfigError]:
        panic("todo")

## One PEM-encoded certificate that may extend the host's trusted roots.
@derive(Debug, Eq)
pub struct Certificate:
    pem: string

impl Certificate:
    ## Parses one PEM certificate.
    pub fn from_pem(pem: string) -> Result[Certificate, ClientConfigError]:
        panic("todo")

## A PEM client certificate chain and its PEM private key.
## Debug is deliberately absent so diagnostics cannot print key material.
pub struct Identity:
    certificate_chain: string
    private_key: string

impl Identity:
    ## Parses a PEM certificate chain and matching private key.
    pub fn from_pem(
        certificate_chain: string,
        private_key: string,
    ) -> Result[Identity, ClientConfigError]:
        panic("todo")

## Why a client setting could not be constructed.
@error
@derive(Debug, Eq)
pub enum ClientConfigError:
    @error("invalid HTTP proxy URL: $url")
    InvalidProxy(url: string)
    @error("invalid PEM certificate")
    InvalidCertificate
    @error("invalid PEM client identity")
    InvalidIdentity

## A value builder for one client with fixed settings.
pub struct ClientBuilder:
    jar: CookieJar

impl ClientBuilder:
    ## Replaces the cookie jar that the built client will share.
    pub fn jar(mut self, jar: CookieJar) -> ClientBuilder:
        self.jar = jar
        self

    ## Applies the existing task timeout policy around every later send.
    pub fn timeout(mut self, limit: Duration) -> ClientBuilder:
        panic("todo")

    ## Routes every later send through one HTTP CONNECT proxy.
    pub fn proxy(mut self, proxy: Proxy) -> ClientBuilder:
        panic("todo")

    ## Adds one root certificate to the host's ordinary trust store.
    pub fn root_certificate(mut self, certificate: Certificate) -> ClientBuilder:
        panic("todo")

    ## Supplies one client identity for mutual TLS.
    pub fn identity(mut self, identity: Identity) -> ClientBuilder:
        panic("todo")

    ## Validates the complete configuration and returns a shared client with fixed settings.
    pub fn build(self) -> Result[*mut Client, ClientConfigError]:
        panic("todo")

## A reusable cookie-aware client with fixed transport settings.
pub struct Client:
    pub jar: CookieJar

impl Client:
    ## Starts a value builder with an empty cookie jar and host-default transport.
    pub fn builder() -> ClientBuilder:
