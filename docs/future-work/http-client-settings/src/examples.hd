use pkg.http_client_settings.{Certificate, Http, HttpConfigError, HttpError, Identity, dns_servers}
use std.http.{Request, Response}
use std.task.{apply, timeout}
use std.time.{Clock, s}

## Narrows the covering host transport without changing it or `Client`.
pub fn internal_transport(
    root_pem: string,
    certificate_chain_pem: string,
    private_key_pem: string,
) -> Result[*mut dyn Http, HttpConfigError] $ Http:
    resolver := dns_servers(["10.0.0.2"])?
    root := Certificate::from_pem(root_pem)?
    identity := Identity::from_pem(certificate_chain_pem, private_key_pem)?
    transport := $.use(Http).resolver(resolver)
        .tls(roots=[root], identity= .Some(identity))
        .connect_timeout(2s)
        .tls_handshake_timeout(3s)
        .response_header_timeout(5s)
        .body_read_timeout(20s)
    .Ok(transport)

## Installs one narrowed transport while the existing timeout policy bounds the whole operation.
pub fn send_internal!(
    request: *Request,
    transport: *mut dyn Http,
) -> Result[Response, HttpError] $ Http + Clock:
    $.with(Http=transport):
        apply!(timeout(10s)):
            $.use(Http).send!(request, 10)
