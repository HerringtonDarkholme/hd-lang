# Realistic uses of every item in stdlib_references.hd. Each `.iter()`
# loop is written `for x in xs:` once the borrowing loop lands; the
# package keeps `.iter()` because a user type cannot opt into that rule.

use pkg.stdlib_references.{
    Deque,
    Heap,
    Json,
    NewList,
    NewMap,
    OptionCopied,
    OptionPlace,
    Set,
    Walk,
    Walker,
    empty_list,
    encode,
    new_list,
    new_map,
    parse,
    replace,
    swap,
}
use std.json.JsonError
use std.serde.Serialize
use std.structure.Field

# --- Order totals -------------------------------------------------------

@derive(Serialize)
struct Line:
    sku: string
    cents: i64
    qty: i64

## The order total: each line is read where it lives.
fn order_total(lines: &NewList[Line]) -> i64:
    let sum: i64 = 0
    for line in lines.iter():
        sum += line.cents * line.qty
    sum

## The SKU of the most expensive line, or "".
fn priciest(lines: &NewList[Line]) -> string:
    match lines.max_by_key(fn(line: &Line) -> i64: line.cents * line.qty):
        .Some(line) => line.sku
        .None => ""

## Drops empty lines and sorts the rest by SKU, in place.
fn tidy(lines: &mut NewList[Line]) -> void:
    lines.retain(fn(line: &Line) -> bool: line.qty > 0)
    lines.sort_by_key(fn(line: &Line) -> string: line.sku)

## One receipt row per line, and the gift lines copied out for a second list.
fn receipt(lines: &NewList[Line]) -> (NewList[string], NewList[Line]):
    rows := lines.map(fn(line: &Line) -> string: "${line.sku} x${line.qty}")
    gifts := lines.filter(fn(line: &Line) -> bool: line.sku.starts_with("gift"))
    (rows, gifts.sorted_by_key(fn(line: &Line) -> i64: line.cents))

## Adds one to the first line's quantity, through a mutable reference.
fn bump_first(lines: &mut NewList[Line]) -> void:
    match lines.get_mut(0):
        .Some(line) => line.qty += 1
        .None => pass

## The cents of the line with `sku`; a copy of a scalar field comes out.
fn price_of(lines: &NewList[Line], sku: string) -> i64:
    match lines.find(fn(line: &Line) -> bool: line.sku == sku):
        .Some(line) => line.cents
        .None => 0

## The first, middle and last SKUs, for a summary line.
fn ends(lines: &NewList[Line]) -> string:
    if lines.is_empty():
        return "empty"
    first := lines.first().map(fn(line: &Line) -> string: line.sku).unwrap_or("")
    middle := lines.get(lines.len() / 2).map(fn(line: &Line) -> string: line.sku).unwrap_or("")
    last := lines.last().map(fn(line: &Line) -> string: line.sku).unwrap_or("")
    "$first, $middle..$last of ${lines.len()}"

## True when any line is a gift card, and whether SKU "tea" is ordered.
fn flags(lines: &NewList[Line], skus: &NewList[string]) -> (bool, bool):
    gift := lines.any(fn(line: &Line) -> bool: line.sku == "gift-card")
    (gift, skus.contains("tea"))

## The order as JSON; `encode` only reads the order.
fn order_json(line: &Line) -> string:
    encode(line)

# --- Word counts --------------------------------------------------------

## Counts the words of `text` that are not stop words.
fn word_counts(text: string, stop: &Set[string]) -> NewMap[string, usize]:
    let mut counts = new_map::[string, usize]({})
    for word in text.split_whitespace():
        if !stop.contains(word):
            *counts.get_or_insert(word, 0) += 1
    counts

## The usual stop words.
fn stop_words() -> Set[string]:
    let mut words: Set[string] = Set::new()
    _ := words.insert("the")
    _ := words.insert("a")
    words

## How often `word` occurs; `copied` turns the borrowed count into a value.
fn count_of(counts: &NewMap[string, usize], word: string) -> usize:
    counts.get(word).copied().unwrap_or(0)

## "word: n" for each repeated word, sorted by word.
fn report(counts: &NewMap[string, usize]) -> NewList[string]:
    let mut words = counts.keys()
    words.sort_by_key(fn(word: &string) -> string: *word)
    let mut rows = new_list::[string]([])
    for word in words.iter():
        n := count_of(counts, *word)
        if n > 1:
            rows.push("$word: $n")
    rows

## The number of counted words; each entry is borrowed as `(&K, &V)`.
fn total_words(counts: &NewMap[string, usize]) -> usize:
    let total: usize = 0
    for (_, n) in counts.iter():
        total += *n
    total

## Forgets one word and returns how often it had occurred.
fn forget(counts: &mut NewMap[string, usize], word: string) -> usize:
    counts.remove(word).unwrap_or(0)

# --- JSON ---------------------------------------------------------------

struct Server:
    host: string
    port: i64

## `doc.section.key`, read in place: no subtree is copied.
fn setting(doc: &Json, section: string, key: string) -> (&Json)?:
    doc.get(section)?.get(key)

## Reads the server block of a config file.
fn server_config(text: string) -> Result[Server, JsonError]:
    doc := parse(text)?
    host := match setting(&doc, "server", "host"):
        .Some(value) => value.as_text().copied().unwrap_or("localhost")
        .None => "localhost"
    port := match setting(&doc, "server", "port"):
        .Some(value) => value.as_i64().unwrap_or(8080)
        .None => 8080
    .Ok(Server { host: host, port: port })

## The text items of the `tags` array.
fn tags(doc: &Json) -> NewList[string]:
    let mut out = new_list::[string]([])
    found := match doc.get("tags"):
        .Some(list) => list
        .None => return out
    let index: usize = 0
    while true:
        match found.at(index):
            .Some(item) =>
                match item.as_text():
                    .Some(text) => out.push(*text)
                    .None => pass
            .None => break
        index += 1
    out

# --- A worker pool with non-copyable connections ------------------------

struct Conn:
    id: u32
    served: usize

impl !Copy for Conn

@derive(Eq, PartialOrd, Ord)
struct Job:
    priority: i32
    id: u32

struct Pool:
    idle: NewList[Conn]
    waiting: Deque[Job]
    urgent: Heap[Job]
    current: Conn?
    primary: Conn
    spare: Conn

## The next job: urgent ones first, then the queue in order.
fn next_job(pool: &mut Pool) -> Job?:
    match pool.urgent.pop():
        .Some(job) => .Some(job)
        .None => pool.waiting.pop_front()

## Runs one job on an idle connection, then returns the connection.
fn run_one(pool: &mut Pool) -> u32?:
    job := next_job(pool)?
    let mut conn = match pool.idle.pop():
        .Some(found) => found
        .None => Conn { id: 0, served: 0 }
    conn.served += 1
    pool.idle.push(conn) # conn moves back; no copy of it ever existed
    .Some(job.id)

## What runs next, read without taking it.
fn peek_next(pool: &Pool) -> u32:
    match pool.urgent.peek():
        .Some(job) => job.id
        .None =>
            pool.waiting.front().map(fn(job: &Job) -> u32: job.id).unwrap_or(0)

## The busiest idle connection's id; each connection is borrowed.
fn busiest(pool: &Pool) -> u32:
    let best: usize = 0
    let id: u32 = 0
    for conn in pool.idle.iter():
        if conn.served > best:
            best = conn.served
            id = conn.id
    id

## Closes worn connections and moves the least used to the end.
fn rebalance(pool: &mut Pool) -> Conn?:
    pool.idle.retain(fn(conn: &Conn) -> bool: conn.served < 1000)
    pool.idle.sort_by(fn(a: &Conn, b: &Conn) -> Ordering: b.served.cmp(&a.served))
    if pool.idle.len() > 1:
        pool.idle.swap(0, pool.idle.len() - 1)
    if pool.idle.len() > 8: .Some(pool.idle.remove_at(0)) else: .None

## Retires the current connection, leaving none, and promotes the spare.
fn rotate(pool: &mut Pool, fresh: Conn) -> (Conn?, Conn):
    old := pool.current.take()
    swap(&mut pool.primary, &mut pool.spare)
    retired := replace(&mut pool.spare, fresh)
    (old, retired)

## The current connection's id, read through `as_ref`.
fn current_id(pool: &Pool) -> u32:
    pool.current.as_ref().map(fn(conn: &Conn) -> u32: conn.id).unwrap_or(0)

## A fresh pool with queued work.
fn new_pool(primary: Conn, spare: Conn) -> Pool:
    let mut waiting: Deque[Job] = Deque::new()
    waiting.push_back(Job { priority: +0, id: 1 })
    let mut urgent: Heap[Job] = Heap::new()
    urgent.push(Job { priority: +9, id: 2 })
    Pool {
        idle: empty_list::[Conn](),
        waiting: waiting,
        urgent: urgent,
        current: .None,
        primary: primary,
        spare: spare,
    }

# --- Derivation walks a borrowed value ----------------------------------

struct Header:
    names: List[string]

impl[S] Walker[S] for Header:
    type Error = never
    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, never]:
        self.names.push(h.info.name)
        .Ok(())

## The CSV header of any walkable row; the row is never copied.
fn csv_header[T < Walk](row: &T) -> List[string]:
    let mut header = Header { names: [] }
    _ := row.walk(&mut header)
    header.names

pub fn main() -> void $ Console:
    let mut lines = new_list([Line { sku: "tea", cents: 250, qty: 2 }])
    tidy(&mut lines)
    bump_first(&mut lines)
    let (rows, gifts) = receipt(&lines)
    skus := new_list(["tea"])
    let (gift, tea) = flags(&lines, &skus)
    println("${order_total(&lines)} ${priciest(&lines)} ${price_of(&lines, "tea")} ${ends(&lines)}")
    println(
        "${rows.len()} ${gifts.len()} $gift $tea ${order_json(&Line { sku: "x", cents: 1, qty: 1 })}",
    )
    let mut counts = word_counts("the tea the cake tea", &stop_words())
    println(
        "${count_of(&counts, "tea")} ${report(&counts).len()} ${total_words(&counts)} ${forget(&mut counts, "tea")}",
    )
    match server_config("{}"):
        .Ok(server) => println("${server.host}:${server.port}")
        .Err(error) => println("bad config: $error")
    let mut pool = new_pool(Conn { id: 1, served: 0 }, Conn { id: 2, served: 0 })
    _ := run_one(&mut pool)
    _ := rebalance(&mut pool)
    println("${peek_next(&pool)} ${busiest(&pool)} ${current_id(&pool)}")
    let (old, retired) = rotate(&mut pool, Conn { id: 3, served: 0 })
    println("${old.is_some()} ${retired.id} ${tags(&Json.Null).len()}")
