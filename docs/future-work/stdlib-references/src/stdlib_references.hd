    pub fn new() -> Set[T]:
        panic("todo")

    ## True when the set holds `value`.
    pub fn contains(&self, value: T) -> bool:
        panic("todo")

    ## Adds `value`; false when it was already there.
    pub fn insert(&mut self, value: T) -> bool:
        panic("todo")

## std's `Deque[T]`, for any item.
pub struct Deque[T < ?Copy]:
    count: usize

impl[T < ?Copy] Deque[T]:
    ## An empty deque.
    pub fn new() -> Deque[T]:
        panic("todo")

    ## Moves `value` in at the back.
    pub fn push_back(&mut self, value: T) -> void:
        panic("todo")

    ## Moves the front item out: `self.slots[self.head].take()`, no copy.
    pub fn pop_front(&mut self) -> T?:
        panic("todo")

    ## The front item by reference.
    pub fn front(&self) -> (&T)?:
        panic("todo")

## std's `Heap[T]`, a max-heap.
pub struct Heap[T < Ord]:
    count: usize

impl[T < Ord] Heap[T]:
    ## An empty heap.
    pub fn new() -> Heap[T]:
        panic("todo")

    ## Moves `value` in; sifts with `swap`, so no item is copied.
    pub fn push(&mut self, value: T) -> void:
        panic("todo")

    ## Moves the largest item out.
    pub fn pop(&mut self) -> T?:
        panic("todo")

    ## The largest item by reference.
    pub fn peek(&self) -> (&T)?:
        panic("todo")

## Option additions; in std these are inherent methods of `T?` and `(&T)?`.
pub trait OptionPlace[T < ?Copy] < ?Copy:
    ## The payload by reference, leaving the optional in place.
    fn as_ref(&self) -> (&T)?
    ## Moves the payload out and leaves `.None`.
    fn take(&mut self) -> T?

impl[T < ?Copy] OptionPlace[T] for T?:
    fn as_ref(&self) -> (&T)?:
        panic("todo")

    fn take(&mut self) -> T?:
        replace(self, .None)

## `copied` on a borrowed payload; in std an inherent method of `(&T)?`.
pub trait OptionCopied[T]:
    ## A copy of the referenced payload.
    fn copied(self) -> T?

impl['a, T] OptionCopied[T] for (&'a T)?:
    fn copied(self) -> T?:
        match self:
            .Some(found) => .Some(*found)
            .None => .None

## Exchanges two places, as Rust's `mem::swap`. Intrinsic body `swap`.
pub fn swap[T < ?Copy](a: &mut T, b: &mut T) -> void:
    panic("todo")

## Puts `value` in `place` and returns the old value, as Rust's `mem::replace`. Plain hd over `swap`.
pub fn replace[T < ?Copy](place: &mut T, value: T) -> T:
    let mut held = value
    swap(place, &mut held)
    held

## std's `Json` tree. Lookups take `&self` and return copies of the subtree.
pub enum Json:
    Null
    Bool(value: bool)
    Number(value: f64)
    Text(value: string)
    Array(items: List[Json])
    Object(fields: Map[string, Json])

impl Json:
    ## The member `key` of an object.
    pub fn get(&self, key: string) -> Json?:
        panic("todo")

    ## The item at `index` of an array.
    pub fn at(&self, index: usize) -> Json?:
        panic("todo")

    ## The text of a `Text`.
    pub fn as_text(&self) -> string?:
        panic("todo")

    ## A whole-number `Number` as an `i64`; scalars come back by value.
    pub fn as_i64(&self) -> i64?:
        panic("todo")

## Parses JSON text.
pub fn parse(text: string) -> Result[Json, JsonError]:
    panic("todo")

## Encodes a value it only reads, as serde_json's `to_string(&value)`.
pub fn encode[T < Serialize](value: &T) -> string:
    panic("todo")

## `Structure`'s visitor after the redesign: each field is lent, never copied.
pub trait Walker[S]:
    type Error
    ## Visits one field, lent for the call.
    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, Self::Error]

## `Structure::walk(&value, w)`: the walk borrows the value, so `@derive` needs no `Copy`.
pub trait Walk:
    ## Lends each field to `w` in declaration order.
    fn walk[W < Walker[Self]](&self, w: &mut W) -> Result[void, W::Error]
