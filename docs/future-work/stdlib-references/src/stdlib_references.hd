# The reference-first std surface (docs/future-work/STDLIB_REFERENCES.md).
#
# Prelude names cannot be shadowed (`prelude-name-shadow`), so `NewList`
# and `NewMap` model std's `List` and `Map`, and `new_list`/`new_map` stand
# in for a literal. `Set`, `Deque`, `Heap` and `Json` model the std types
# of the same names. Blocks written `[T < ?Copy]` accept any item; blocks
# written `[T]` are the methods that build copies, so they need `Copy`
# (after a generic-default flip they would read `[T]` and `[T < Copy]`).
# Bodies are `panic("todo")`, except where plain hd is the point.

use std.json.JsonError
use std.serde.Serialize
use std.structure.Field

## std's `List[T]`: one list type for copyable and non-copyable items.
pub struct NewList[T < ?Copy]:
    count: usize

## Stands in for a list literal `[...]` of copyable items.
pub fn new_list[T](items: List[T]) -> NewList[T]:
    panic("todo")

## Stands in for `[]` of any item type, which needs ch. 13's `ref.copy.collections` lifted.
pub fn empty_list[T < ?Copy]() -> NewList[T]:
    panic("todo")

impl[T] NewList[T]:
    ## A copy of the item at `index`, or `.None` past the end.
    pub fn get(&self, index: usize) -> T?:
        panic("todo")

impl[T < ?Copy] NewList[T]:
    ## The number of items.
    pub fn len(&self) -> usize:
        panic("todo")

    ## True exactly when the list has no items.
    pub fn is_empty(&self) -> bool:
        panic("todo")

    ## The item at `index` by reference, or `.None` past the end.
    pub fn get_ref(&self, index: usize) -> (&T)?:
        panic("todo")

    ## The item at `index` by mutable reference, or `.None` past the end.
    pub fn get_mut(&mut self, index: usize) -> (&mut T)?:
        panic("todo")

    ## The first item by reference, or `.None` for an empty list.
    pub fn first_ref(&self) -> (&T)?:
        panic("todo")

    ## The last item by reference, or `.None` for an empty list.
    pub fn last_ref(&self) -> (&T)?:
        panic("todo")

    ## A cursor that borrows the list and yields `&T` in order.
    pub fn iter['a](&'a self) -> ListIter[T, 'a]:
        panic("todo")

    ## Moves `value` in at the end.
    pub fn push(&mut self, value: T) -> void:
        panic("todo")

    ## Moves the last item out, or `.None` for an empty list. Intrinsic body `list_take_last`.
    pub fn pop(&mut self) -> T?:
        panic("todo")

    ## Moves the item at `index` out and closes the gap.
    pub fn remove_at(&mut self, index: usize) -> T:
        panic("todo")

    ## Exchanges two items in place. Intrinsic body `list_swap`.
    pub fn swap(&mut self, a: usize, b: usize) -> void:
        panic("todo")

    ## Keeps the items `keep` accepts, in order, in place.
    pub fn retain(&mut self, keep: fn(&T) -> bool) -> void:
        panic("todo")

    ## A stable in-place sort by `compare`.
    pub fn sort_by(&mut self, compare: fn(&T, &T) -> Ordering) -> void:
        panic("todo")

    ## A stable in-place sort by `key`, called once per item.
    pub fn sort_by_key[K < Ord](&mut self, key: fn(&T) -> K) -> void:
        panic("todo")

    ## The first item `test` accepts, by reference.
    pub fn find(&self, test: fn(&T) -> bool) -> (&T)?:
        panic("todo")

    ## True when `test` accepts some item.
    pub fn any(&self, test: fn(&T) -> bool) -> bool:
        panic("todo")

    ## The first item with the largest `key`, by reference.
    pub fn max_by_key[K < Ord](&self, key: fn(&T) -> K) -> (&T)?:
        panic("todo")

    ## A new list of `transform` applied to each item.
    pub fn map[U < ?Copy](&self, transform: fn(&T) -> U) -> NewList[U]:
        panic("todo")

# The builders: each returns a new list of copied items.
impl[T] NewList[T]:
    ## A new list of the items `keep` accepts.
    pub fn filter(&self, keep: fn(&T) -> bool) -> NewList[T]:
        panic("todo")

    ## A new list sorted by `key`; the receiver is unchanged.
    pub fn sorted_by_key[K < Ord](&self, key: fn(&T) -> K) -> NewList[T]:
        panic("todo")

# A value only compared is taken by value, as a map key is.
impl[T < Eq] NewList[T]:
    ## True when an item equals `value`.
    pub fn contains(&self, value: T) -> bool:
        panic("todo")

## The cursor of `NewList.iter`: each item by reference.
pub struct ListIter[T < ?Copy, 'a]:
    items: &'a NewList[T]
    at: usize

impl[T < ?Copy, 'a] Iterator[&'a T] for ListIter[T, 'a]:
    fn next(&mut self) -> (&'a T)?:
        panic("todo")

## std's `Map[K, V]`: keys are copyable, as Swift's `Dictionary` keys are; values may be anything.
pub struct NewMap[K < Eq & Hash, V < ?Copy]:
    count: usize

## Stands in for a map literal `{...}`.
pub fn new_map[K < Eq & Hash, V](entries: Map[K, V]) -> NewMap[K, V]:
    panic("todo")

impl[K < Eq & Hash, V] NewMap[K, V]:
    ## A copy of the value of `key`, or `.None`.
    pub fn get(&self, key: K) -> V?:
        panic("todo")

impl[K < Eq & Hash, V < ?Copy] NewMap[K, V]:
    ## The value of `key` by reference, or `.None`.
    pub fn get_ref(&self, key: K) -> (&V)?:
        panic("todo")

    ## The value of `key`, inserting `default` first when the key is missing.
    pub fn get_or_insert(&mut self, key: K, default: V) -> &mut V:
        panic("todo")

    ## Moves the value of `key` out, or `.None`.
    pub fn remove(&mut self, key: K) -> V?:
        panic("todo")

    ## A cursor that borrows the map and yields `(&K, &V)` in iteration order.
    pub fn iter['a](&'a self) -> MapIter[K, V, 'a]:
        panic("todo")

# Builders of copies.
impl[K < Eq & Hash, V] NewMap[K, V]:
    ## A new list of the keys, in iteration order.
    pub fn keys(&self) -> NewList[K]:
        panic("todo")

## The cursor of `NewMap.iter`.
pub struct MapIter[K < Eq & Hash, V < ?Copy, 'a]:
    map: &'a NewMap[K, V]
    at: usize

impl[K < Eq & Hash, V < ?Copy, 'a] Iterator[(&'a K, &'a V)] for MapIter[K, V, 'a]:
    fn next(&mut self) -> (&'a K, &'a V)?:
        panic("todo")

