use pkg.bench.{BenchmarkRunner, BenchError, Throughput, bench, black_box, iter, iter_batched}

## Current-syntax model for the target top-level registrations under `benches/` in HD_BENCH.md.
pub fn registrations() -> void $ BenchmarkRunner:
    bench("text/split/21b"):
        input := black_box("red,green,blue,black")
        iter!(
            Throughput.Bytes(input.len()),
            fn!() -> Result[void, BenchError]:
                fields := input.split(",")
                if black_box(fields.len()) != 4:
                    return .Err(BenchError.Work("split returned the wrong fields"))
                .Ok(())
            ,
        )

    bench("text/contains"):
        input := black_box("the quick brown fox")
        iter!(
            Throughput.Operations(1),
            fn!() -> Result[void, BenchError]:
                if !black_box(input.contains("brown")):
                    return .Err(BenchError.Work("contains missed a word"))
                .Ok(())
            ,
        )

    bench("collections/sort/5"):
        source := black_box([5i64, 3i64, 4i64, 1i64, 2i64])
        iter_batched!(
            Throughput.Items(source.len()),
            fn!() -> Result[List[i64], BenchError]: .Ok(source),
            fn!(values: &mut List[i64]) -> Result[void, BenchError]:
                ordered := values.sorted()
                if black_box(ordered[0]) != 1:
                    return .Err(BenchError.Work("sort returned the wrong first item"))
                .Ok(())
            ,
        )
