## The completed work one callback represents for throughput reporting.
@derive(Debug, Eq)
pub enum Throughput:
    Operations(count: usize)
    Bytes(count: usize)
    Items(count: usize)

## Why a benchmark root could not produce a valid measurement.
@derive(Debug, Eq)
@error
pub enum BenchError:
    @error("invalid benchmark definition: $message")
    Definition(message: string)
    @error("benchmark work failed: $message")
    Work(message: string)
    @error("benchmark clock failed: $message")
    Clock(message: string)
    @error("benchmark protocol failed: $message")
    Protocol(message: string)

## The runner supplied to each registered benchmark body; it owns the real clock.
pub trait BenchmarkRunner:
    fn begin(&mut self, throughput: Throughput) -> usize
    fn finish(&mut self, completed: usize) -> Result[void, BenchError]

## Registers one named benchmark in benchmark position, like `it` in test position.
pub fn bench[T < Termination, $ R](name: string, body: fn!() -> T $ R) -> void $ R:
    panic("std.bench: bench registers cases only in benchmark position")

## Repeats and measures `work`, reporting `throughput` per completed invocation.
pub fn iter![$ R](
    throughput: Throughput,
    work: fn!() -> Result[void, BenchError] $ R,
) -> Result[void, BenchError] $ R + BenchmarkRunner:
    panic("todo")

## Prepares a fresh `S` outside timing, then measures one call with a local writable reference.
pub fn iter_batched![S, $ R](
    throughput: Throughput,
    setup: fn!() -> Result[S, BenchError] $ R,
    work: fn!(&mut S) -> Result[void, BenchError] $ R,
) -> Result[void, BenchError] $ R + BenchmarkRunner:
    panic("todo")

## Returns `value` unchanged while blocking optimization assumptions across this call.
pub fn black_box[T](value: T) -> T:
    panic("todo")
