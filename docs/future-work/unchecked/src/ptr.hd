# The proposed public module `std.ptr`, as signatures (bodies are stubs).
# In std it is `pub use` of std.rt.memory's declarations; this copy lets
# the user code next to it check today. `unchecked fn` is not parsed yet,
# so the four methods that need it say so in their comment.

## The address of a value of type `T`. Copying it copies the address. It
## is neither `Send` nor `Sync`, so a type that keeps its state behind one
## is neither unless it says so with `unchecked impl`.
pub struct Ptr[T < ?Copy]:
    address: usize

impl[T < ?Copy] Ptr[T]:
    ## The address, as a number.
    pub fn address(self) -> usize:
        self.address

    ## The pointer at `address`, made from this one: the only way user code
    ## turns a number back into a `Ptr`.
    pub fn with_address(self, address: usize) -> Ptr[T]:
        Ptr::[T] { address: address }

    ## The same address, as a pointer to a `U`.
    pub fn cast[U < ?Copy](self) -> Ptr[U]:
        Ptr::[U] { address: self.address }

    ## The address `count` values of `T` past this one.
    pub fn offset(self, count: usize) -> Ptr[T]:
        Ptr::[T] { address: self.address + count * size_of::[T]() }

    ## unchecked fn: moves the value at the address out.
    pub fn read(self) -> T:
        panic("todo")

    ## unchecked fn: moves `value` to the address, dropping nothing there.
    pub fn write(self, value: T) -> void:
        panic("todo")

    ## unchecked fn: lends the value at the address for `'a`.
    pub fn as_ref['a](self) -> &'a T:
        panic("todo")

    ## unchecked fn: lends the value at the address writable for `'a`.
    pub fn as_mut['a](self) -> &'a mut T:
        panic("todo")

## The bytes one value of `T` takes.
pub fn size_of[T < ?Copy]() -> usize:
    panic("todo")

## The alignment of a value of `T`: a power of two, at most 8.
pub fn align_of[T < ?Copy]() -> usize:
    panic("todo")

## Raw memory with one owner, room for `capacity()` values of `T`, at an
## address that is a multiple of 8. Dropping it frees the room and drops
## none of the values in it.
pub struct Buffer[T < ?Copy]:
    address: usize
    capacity: usize

impl[T < ?Copy] !Copy for Buffer[T]

impl[T < ?Copy] Buffer[T]:
    ## Room for `capacity` values of `T`, none of which holds a value yet.
    pub fn new(capacity: usize) -> Buffer[T]:
        Buffer::[T] { address: 0, capacity: capacity }

    ## How many values of `T` the buffer has room for.
    pub fn capacity(&self) -> usize:
        self.capacity

    ## The place of value `index` of the room; no bound is checked.
    pub fn at(&self, index: usize) -> Ptr[T]:
        Ptr::[T] { address: self.address }.offset(index)

    ## Moves the room's bytes to room for `capacity` values; a smaller
    ## `capacity` has no effect.
    pub fn grow(&mut self, capacity: usize) -> void:
        if capacity > self.capacity:
            self.capacity = capacity
