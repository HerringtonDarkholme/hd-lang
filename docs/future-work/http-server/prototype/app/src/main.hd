use std.host.{Args, args}
use std.http.{Http, HttpError, Request, Response, get}
use std.json.{decode, encode}
use std.serde.{Deserialize, Serialize}
use std.task.{block_on, timeout}
use std.time.{Clock, sleep}

@derive(Deserialize)
struct Incoming:
    method: string
    url: string
    headers: List[(string, string)]
    body: List[u8]

@derive(Serialize)
struct Outgoing:
    status: u16
    headers: List[(string, string)]
    body: List[u8]

@derive(Deserialize)
struct Name:
    name: string

@derive(Serialize)
struct Greeting:
    greeting: string

fn json_response(request: Request) -> Response:
    text := match string::from_utf8(request.body):
        .Ok(value) => value
        .Err(_) => return Response { status: 400 }
    name := match decode::[Name](text):
        .Ok(value) => value
        .Err(_) => return Response { status: 400 }
    Response { status: 200, headers: [("content-type", "application/json")], body: encode(Greeting { greeting: "Hello ${name.name}" }).to_utf8() }

fn slow!() -> Response $ Clock:
    sleep!(50ms)
    Response { status: 200, body: "late".to_utf8() }

pub fn handle!(request: Request) -> Response $ Http + Clock:
    if request.url.ends_with("/json"):
        return json_response(request)
    if request.url.ends_with("/timeout"):
        result := timeout!(1ms, cleanup=1ms):
            slow!()
        return match result:
            .Ok(response) => response
            .Err(_) => Response { status: 504, body: "deadline".to_utf8() }
    if request.url.ends_with("/blocking"):
        upstream := string::from_utf8(request.body).expect("upstream URL is UTF-8")
        let call: mut Suspend[Result[Response, HttpError]] = get(upstream)
        return match block_on(call):
            .Completed(.Ok(response)) => response
            _ => Response { status: 502 }
    if request.url.ends_with("/fetch"):
        upstream := string::from_utf8(request.body).expect("upstream URL is UTF-8")
        return match get!(upstream):
            .Ok(response) => response
            .Err(_) => Response { status: 502, body: "upstream failed".to_utf8() }
    Response { status: 200, headers: [("content-type", "application/json")], body: encode(request.url).to_utf8() }

# Control bridge only: this is not the proposed handler registration or ABI.
pub fn main!() -> void $ Args + Console + Http + Clock:
    incoming := decode::[Incoming](args()[0]).expect("request envelope")
    request := Request { method: .Other(incoming.method), url: incoming.url, headers: incoming.headers, body: incoming.body }
    response := handle!(request)
    println(encode(Outgoing { status: response.status, headers: response.headers, body: response.body }))
