use std.format.DebugWriter
use std.hash.Hasher
use std.ops.{Add, Sub, Mul, Div, Rem, Neg}
use std.serde.{Serialize, Serializer, Deserialize, Deserializer}
use std.text.Parse

## A fixed 128-bit decimal value with a 96-bit coefficient and scale 0 through 28.
pub struct Decimal:
    coefficient_low: u64
    coefficient_high: u32
    flags: u32

## How a decimal operation chooses a value when it removes digits.
@derive(Debug, Eq)
pub enum RoundingMode:
    NearestEven
    NearestAwayFromZero
    TowardZero
    TowardNegativeInfinity
    TowardPositiveInfinity

## Why decimal text could not be read exactly.
@derive(Debug, Eq)
@error
pub enum ParseDecimalError:
    @error("cannot parse a decimal from empty text")
    Empty
    @error("invalid decimal syntax at byte $position")
    Invalid(position: usize)
    @error("decimal is outside the fixed 128-bit range")
    OutOfRange

impl Decimal:
    ## Constructs an exact decimal integer.
    pub fn from_i64(value: i64) -> Decimal:
        panic("todo")

    ## Rounds to at most `scale` fractional digits and retains a smaller existing scale.
    pub fn round(self, scale: u8, mode: RoundingMode = .NearestEven) -> Decimal:
        panic("todo")

    ## Divides at exactly `scale` fractional digits using `mode`.
    pub fn divide(self, rhs: Decimal, scale: u8, mode: RoundingMode = .NearestEven) -> Decimal:
        panic("todo")

impl Parse for Decimal:
    type Error = ParseDecimalError

    fn parse(text: string) -> Result[Decimal, ParseDecimalError]:
        panic("todo")

