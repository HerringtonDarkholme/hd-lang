    fn neg(self) -> Decimal:
        panic("todo")

impl Serialize for Decimal:
    fn serialize[W < Serializer](self, out: &mut W) -> Result[void, W::Error]:
        out.text(self.to_string())

impl Deserialize for Decimal:
    fn deserialize[R < Deserializer](input: &mut R) -> Result[Decimal, R::Error]:
        text := input.text("decimal string")?
        match text.parse::[Decimal]():
            .Ok(value) => .Ok(value)
            .Err(_) => .Err(input.invalid("decimal string"))
