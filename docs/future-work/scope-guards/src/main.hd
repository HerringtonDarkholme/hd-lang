# Current-syntax model for SCOPE_GUARDS.md.
#
# Target: synchronous guards use `using guard = ...` in `fn` and `fn!`.
# Target: suspending resources use `using! resource = ...` in `fn!`.
# Target: an `@auto_closing` statement call returning `AutoClosing` registers
# its result; binding, storing, or using that call as a value is an error.
# Target: `unbound-disposable` is an error-level lint for an ordinary disposable
# statement or binding, but stays quiet for transfer, return, and storage.
# Target tier 2: a scoped `fn once() ->{local} void` may be stored in a guard
# whose lifetime cannot exceed `local`.

use std.ops.Disposable

struct ScopeGuard:
    action: fn() -> void

impl Disposable for ScopeGuard:
    fn dispose!(&mut self) -> void:
        (self.action)()

fn on_exit(action: fn() -> void) -> ScopeGuard:
    ScopeGuard { action: action }

fn current_guard!() -> void:
    using guard = on_exit(fn() -> void: pass)

pub fn main!() -> void:
    current_guard!()
