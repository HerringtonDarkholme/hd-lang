# Proposal (docs/future-work/ARENA.md, #1410): `std.arena`, an untyped
# arena, as bumpalo's `Bump`. Bodies are `panic("todo")`; std writes them
# over `std.rt.memory.Ptr` and `std.rt.alloc`, as `std.sync.Arc` is written.

## Values of any types that live and die together. `alloc` moves a value
## in and lends it writable for as long as the arena is borrowed; no value
## is counted, and `reset` or the arena's drop drops them all at once.
## Proposal: in std, `alloc` carries `@disjoint` (`std.rt.memory`), so each
## result holds the arena shared and many are written at once. The arena
## is neither `Send` nor `Sync`.
pub struct Arena:
    state: usize

impl !Copy for Arena

impl Arena:
    ## An empty arena; its first chunk is taken by the first `alloc`.
    pub fn new() -> Arena:
        panic("todo")

    ## An empty arena whose first chunk holds `bytes` bytes.
    pub fn with_capacity(bytes: usize) -> Arena:
        panic("todo")

    ## Moves `val` into the arena at `T`'s alignment and lends it writable
    ## while the arena is borrowed. Each call lends a new value. A value
    ## whose type has drop work is dropped by `reset` or the arena's drop.
    pub fn alloc[T < ?Copy](&self, val: T) -> &mut T:
        panic("todo")

    ## How many bytes the arena's values and padding take.
    pub fn allocated_bytes(&self) -> usize:
        panic("todo")

    ## Drops every value, newest first, and keeps the newest chunk.
    pub fn reset(&mut self) -> void:
        panic("todo")
