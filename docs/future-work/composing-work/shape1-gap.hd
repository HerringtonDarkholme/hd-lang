# The shape-1 compiler gap, reduced. `hd check` passes; `hd FILE` traps
# `internal error: unreachable` at the call `f()`. The row parameter `S`
# is fixed only through the binding `Out = fn() -> void $ S`. Writing the
# row at the call, `call::[$ Console, Hello](Hello {})`, makes it print
# `hello`, and so does an empty row (`fn() -> void`) or a type parameter
# fixed the same way (`Out = fn() -> T`).
trait Make:
    type Out
    fn make(self) -> Self::Out

struct Hello: pass

impl Make for Hello:
    type Out = fn() -> void $ Console
    fn make(self) -> (fn() -> void $ Console):
        fn() -> void $ Console: println("hello")

fn call[$S, P < Make[Out = fn() -> void $ S]](maker: P) -> void $ S:
    f := maker.make()
    f()

pub fn main() -> void $ Console:
    call(Hello {})
