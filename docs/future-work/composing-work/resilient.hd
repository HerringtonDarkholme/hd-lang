use std.convert.From
use std.task.{Backoff, TimedOut, retry, timeout}
use std.time.{Clock, Duration, ms, sleep}

## Time policy for one operation: retries with backoff, a deadline per
## attempt, and a deadline for the whole operation.
pub struct Policy:
    pub retry: Backoff = Backoff { attempts: 1 }
    pub attempt: Duration? = .None
    pub total: Duration? = .None

# Run `work` under an optional deadline; a timeout becomes E.
fn within![T, E < From[TimedOut], $R](limit: Duration?, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + Clock:
    match limit:
        .None => work!()
        .Some(d) =>
            match timeout!(d, work=work):
                .Ok(inner) => inner
                .Err(t) => .Err(E::from(t))

## Runs `work` under `policy`: each attempt gets `attempt`, failures that
## `when` accepts are retried with backoff, and the whole run gets `total`.
pub fn resilient![T, E < From[TimedOut], $R](policy: Policy, when: fn(E) -> bool = fn(error: E): true, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + Clock:
    within!(policy.total):
        retry!(policy.retry, when=when):
            within!(policy.attempt, work=work)

@error
@derive(Debug, Eq)
enum AppError:
    @error("timed out")
    Timeout
    @error("failed $n")
    Failed(n: i32)

impl From[TimedOut] for AppError:
    fn from(value: TimedOut) -> AppError:
        AppError.Timeout

fn slow!(log: &mut List[string], delay: Duration) -> Result[i32, AppError] $ Clock:
    log.push("try")
    sleep!(delay)
    .Ok(42)

pub fn main!() -> void $ Console + Clock:
    let mut fast_log: List[string] = []
    fast := resilient!(Policy { retry: Backoff { attempts: 3, initial: ms(1) }, attempt: .Some(ms(200)) }):
        slow!(&mut fast_log, ms(5))
    println("fast: ${debug(fast)} tries=${fast_log.len()}")

    let mut slow_log: List[string] = []
    late := resilient!(Policy { retry: Backoff { attempts: 3, initial: ms(1) }, attempt: .Some(ms(20)) }):
        slow!(&mut slow_log, ms(100))
    println("per-attempt: ${debug(late)} tries=${slow_log.len()}")

    let mut budget_log: List[string] = []
    capped := resilient!(Policy { retry: Backoff { attempts: 10, initial: ms(1) }, attempt: .Some(ms(20)), total: .Some(ms(50)) }):
        slow!(&mut budget_log, ms(100))
    println("total budget: ${debug(capped)} tries=${budget_log.len()}")
