use std.convert.From
use std.function.{SuspendFn, Tuple}
use std.http.{Http, HttpError, Request, Response, ScriptedHttp, get}
use std.task.{Backoff, TimedOut, race, retry, with_timeout}
use std.time.{Clock, Duration, ms, sleep}

# Shape 2: each policy is one bang function. This single adapter lifts any
# bang function, with its complete argument tuple, into repeatable work.
fn deferred[Args < Tuple, O, $R](f: SuspendFn[Args, O, $ R], args...: Args) -> (fn!() -> O $ R):
    fn!() -> O $ R:
        f!(args...)

fn fallback![T, E, $R, $S](other: fn!() -> Result[T, E] $ S, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + S:
    match work!():
        .Ok(value) => .Ok(value)
        .Err(_) => other!()

struct CircuitOpen: pass

struct Breaker:
    failures: usize
    limit: usize
    calls: usize

fn guarded![T, E < From[CircuitOpen], $R](state: &mut Breaker, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R:
    if state.failures >= state.limit:
        return .Err(E::from(CircuitOpen {}))
    state.calls += 1
    result := work!()
    state.failures = if result.is_ok(): 0 else: state.failures + 1
    result

fn hedged![T, E, $R](delay: Duration, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + Clock:
    race!(work(), late_copy(work, delay))

fn late_copy![T, E, $R](work: fn!() -> Result[T, E] $ R, delay: Duration) -> Result[T, E] $ R + Clock:
    sleep!(delay)
    work!()

# A user policy, defined once; no separate traced/tapped combinator.
fn trace![T, E, $R](label: string, work: fn!() -> Result[T, E] $ R) -> Result[T, E] $ R + Console:
    println("trace $label")
    work!()

@derive(Debug)
enum Failure:
    Http(HttpError)
    Timeout
    Open

impl From[HttpError] for Failure:
    fn from(error: HttpError) -> Failure: .Http(error)

impl From[TimedOut] for Failure:
    fn from(error: TimedOut) -> Failure: .Timeout

impl From[CircuitOpen] for Failure:
    fn from(error: CircuitOpen) -> Failure: .Open

fn transient(error: Failure) -> bool:
    match error:
        .Http(inner) => inner.is_transient()
        .Timeout => true
        .Open => false

# A fake HTTP provider records the request before holding primary replies.
# The caller's timeout cancels that pending reply, without changing Http's row.
struct DelayedHttp:
    inner: &mut ScriptedHttp
    clock: &mut dyn Clock
    finished_primary: usize

impl Http for DelayedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        slow := request.url == "http://primary/item"
        result := self.inner.send!(request)
        if slow:
            self.clock.sleep!(ms(500))
            self.finished_primary += 1
        result

fn fetch!(url: string) -> Result[string, Failure] $ Http:
    response := get!(url)?
    .Ok("${response.status}")

fn delayed!() -> Result[string, Failure] $ Clock:
    sleep!(ms(500))
    .Ok("late")

struct Replicas:
    started: usize
    finished: usize
    closed: usize

fn replica!(state: &mut Replicas) -> Result[string, Failure] $ Http + Clock:
    state.started += 1
    number := state.started
    defer: state.closed += 1
    sleep!(if number == 1: ms(500) else: ms(10))
    _ := get!("http://replica/$number")?
    state.finished += 1
    .Ok("replica $number")

# Both forms call the same trace!; neither adds Clock to this function.
fn pure_port!() -> Result[usize, string] $ Console:
    let immediate: Result[usize, string] = trace!("block"):
        .Ok(3)
    println("block ${debug(immediate)}")
    work := fn!() -> Result[usize, string]: .Ok(9)
    later := deferred(trace, "pure", work)
    later!()

pub fn main!() -> void $ Console + Clock:
    println("pure ${debug(pure_port!())}")
    timed := with_timeout!(ms(10)):
        delayed!()
    println("timeout ${debug(timed)}")
    match timed:
        .Err(.Timeout) => pass
        _ => panic("timeout did not expire")

    http := ScriptedHttp::new()
    http.reply("http://primary/item", .Err(.Connect("first")))
    http.reply("http://primary/item", .Err(.Connect("second")))
    http.reply("http://backup/item", .Ok(Response { status: 200 }))
    http.reply("http://down/item", .Err(.Connect("down")))
    http.reply("http://replica/2", .Ok(Response { status: 200 }))
    let mut delayed_http = DelayedHttp { inner: http, clock: $.use(Clock), finished_primary: 0 }
    $.with(Http=&mut delayed_http):
        backup := fn!() -> Result[string, Failure] $ Http: fetch!("http://backup/item")
        response := (fn!() -> Result[string, Failure] $ Http: fetch!("http://primary/item"))
            |> deferred(with_timeout, ms(50), .None, _)
            |> deferred(retry, Backoff { attempts: 2, initial: ms(1) }, transient, _)
            |> deferred(fallback, backup, _)
            |> _!()
        println("http ${debug(response)} requests=${http.received().len()}")
        if http.received().len() != 3 || delayed_http.finished_primary != 0:
            panic("expected two cancelled primary replies and one fallback request")

        let mut breaker = Breaker { failures: 0, limit: 2, calls: 0 }
        guarded_call := (fn!() -> Result[string, Failure] $ Http: fetch!("http://down/item"))
            |> deferred(guarded, &mut breaker, _)
        for i in 0..4:
            println("breaker $i ${debug(guarded_call!())}")
        println("breaker calls=${breaker.calls} failures=${breaker.failures}")
        if breaker.calls != 2 || breaker.failures != 2:
            panic("the breaker did not stop repeated calls")

        let mut state = Replicas { started: 0, finished: 0, closed: 0 }
        hedged_call := (fn!() -> Result[string, Failure] $ Http + Clock: replica!(&mut state))
            |> deferred(hedged, ms(10), _)
        result := hedged_call!()
        println("hedge ${debug(result)} started=${state.started} finished=${state.finished} closed=${state.closed}")
        if state.started != 2 || state.finished != 1 || state.closed != 2:
            panic("the hedge did not complete one request and close both scopes")
