# Shape 3: policies as provider middleware, as Tower layers wrap a service.
# Each policy is an `Http` provider that wraps another; one `$.with` block
# applies the stack. Application code keeps the row `$ Http`. Runs today.
use std.http.{Http, HttpError, Request, Response, ScriptedHttp, get}
use std.task.{Backoff, race, retry, with_timeout}
use std.time.{Clock, Duration, ms, sleep}

# ---- 1. the policies, written for Http ----

# A deadline per request. The clock is captured where the stack is built.
struct TimedHttp:
    inner: &mut dyn Http
    clock: &mut dyn Clock
    limit: Duration

impl Http for TimedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        inner := self.inner
        limit := self.limit
        $.with(Clock=self.clock):
            with_timeout!(limit):
                inner.send!(request)

fn timed(inner: &mut dyn Http, limit: Duration) -> &mut dyn Http $ Clock:
    &mut TimedHttp { inner: inner, clock: $.use(Clock), limit: limit }

struct RetriedHttp:
    inner: &mut dyn Http
    clock: &mut dyn Clock
    backoff: Backoff

impl Http for RetriedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        inner := self.inner
        backoff := self.backoff
        $.with(Clock=self.clock):
            retry!(backoff, when=transient):
                inner.send!(request)

fn transient(error: HttpError) -> bool: error.is_transient()

fn retried(inner: &mut dyn Http, backoff: Backoff) -> &mut dyn Http $ Clock:
    &mut RetriedHttp { inner: inner, clock: $.use(Clock), backoff: backoff }

# On failure, sends the request again to `backup` instead of its own host.
struct FallbackHttp:
    inner: &mut dyn Http
    from: string
    to: string

impl Http for FallbackHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        match self.inner.send!(request):
            .Ok(response) => .Ok(response)
            .Err(error) =>
                if !request.url.starts_with(self.from):
                    return .Err(error)
                rest := request.url.strip_prefix(self.from).unwrap_or("")
                self.inner.send!(Request { ...request, url: self.to + rest })

fn falls_back(inner: &mut dyn Http, from: string, to: string) -> &mut dyn Http:
    &mut FallbackHttp { inner: inner, from: from, to: to }

struct Breaker:
    failures: usize
    limit: usize
    calls: usize

# The provider fixes the error type, so an open circuit must be spelled
# as an HttpError: there is no `CircuitOpen` the caller can match.
struct BreakerHttp:
    inner: &mut dyn Http
    state: &mut Breaker

impl Http for BreakerHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        if self.state.failures >= self.state.limit:
            return .Err(.Other("circuit open"))
        self.state.calls += 1
        result := self.inner.send!(request)
        self.state.failures = if result.is_ok(): 0 else: self.state.failures + 1
        result

fn broken_by(inner: &mut dyn Http, state: &mut Breaker) -> &mut dyn Http:
    &mut BreakerHttp { inner: inner, state: state }

struct HedgedHttp:
    inner: &mut dyn Http
    clock: &mut dyn Clock
    delay: Duration

impl Http for HedgedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        inner := self.inner
        delay := self.delay
        $.with(Clock=self.clock):
            race!(inner.send(request), late_send(inner, request, delay))

fn late_send!(inner: &mut dyn Http, request: Request, delay: Duration) -> Result[Response, HttpError] $ Clock:
    sleep!(delay)
    inner.send!(request)

fn hedged(inner: &mut dyn Http, delay: Duration) -> &mut dyn Http $ Clock:
    &mut HedgedHttp { inner: inner, clock: $.use(Clock), delay: delay }

# ---- 2. fakes ----

# Records each request, then holds primary replies for 500 ms.
struct DelayedHttp:
    inner: &mut ScriptedHttp
    clock: &mut dyn Clock
    finished_primary: usize

impl Http for DelayedHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        slow := request.url.starts_with("http://primary/")
        result := self.inner.send!(request)
        if slow:
            self.clock.sleep!(ms(500))
            self.finished_primary += 1
        result

# The first send of a request takes 500 ms, the second 10 ms.
struct Replicas:
    inner: &mut ScriptedHttp
    clock: &mut dyn Clock
    started: usize
    finished: usize
    closed: usize

impl Http for Replicas:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.started += 1
        number := self.started
        defer: self.closed += 1
        self.clock.sleep!(if number == 1: ms(500) else: ms(10))
        result := self.inner.send!(request)
        self.finished += 1
        result

# ---- 3. the programs: application code needs only Http ----

fn fetch!(url: string) -> Result[string, HttpError] $ Http:
    response := get!(url)?
    .Ok("${response.status}")

pub fn main!() -> void $ Console + Clock:
    http := ScriptedHttp::new()
    http.reply("http://primary/item", .Err(.Connect("first")))
    http.reply("http://primary/item", .Err(.Connect("second")))
    http.reply("http://backup/item", .Ok(Response { status: 200 }))
    http.reply("http://down/item", .Err(.Connect("down")))
    http.reply("http://replica/item", .Ok(Response { status: 200 }))

    # 1. a deadline per attempt, two attempts, then the backup host.
    let mut delayed_http = DelayedHttp { inner: http, clock: $.use(Clock), finished_primary: 0 }
    stack := &mut delayed_http
        |> timed(_, ms(50))
        |> retried(_, Backoff { attempts: 2, initial: ms(1) })
        |> falls_back(_, "http://primary/", "http://backup/")
    $.with(Http=stack):
        response := fetch!("http://primary/item")
        println("http ${debug(response)} requests=${http.received().len()}")
    if http.received().len() != 3 || delayed_http.finished_primary != 0:
        panic("expected two cancelled primary replies and one fallback request")

    # 2. a breaker whose state outlives each request.
    let mut breaker = Breaker { failures: 0, limit: 2, calls: 0 }
    $.with(Http=broken_by(http, &mut breaker)):
        for i in 0..4:
            println("breaker $i ${debug(fetch!("http://down/item"))}")
    println("breaker calls=${breaker.calls} failures=${breaker.failures}")
    if breaker.calls != 2 || breaker.failures != 2:
        panic("the breaker did not stop repeated calls")

    # 3. a hedged request: a second send after 10 ms.
    let mut replicas = Replicas { inner: http, clock: $.use(Clock), started: 0, finished: 0, closed: 0 }
    $.with(Http=hedged(&mut replicas, ms(10))):
        result := fetch!("http://replica/item")
        println("hedge ${debug(result)} started=${replicas.started} finished=${replicas.finished} closed=${replicas.closed}")
    if replicas.started != 2 || replicas.finished != 1 || replicas.closed != 2:
        panic("the hedge did not complete one request and close both sends")
