use std.http.{Http, HttpError, Response, ScriptedHttp, get}
use std.serde.{Deserialize}
use std.convert.From
use std.task.{Backoff, TimedOut, retry, timeout}
use std.time.{Clock, Duration, ms, sleep}

# Approach A: work is a re-runnable closure; combinators map work to work.

pub fn timed[T, E < From[TimedOut], $R](limit: Duration, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
    fn!() -> Result[T, E] $ R + Clock:
        match timeout!(limit, work=work):
            .Ok(inner) => inner
            .Err(t) => .Err(E::from(t))

pub fn retried[T, E, $R](policy: Backoff, when: fn(E) -> bool, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
    fn!() -> Result[T, E] $ R + Clock:
        retry!(policy, when=when, attempt=work)

## Runs `other` when `work` fails.
pub fn or_else[T, E, $R, $S](other: fn!() -> Result[T, E] $ S, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + S):
    fn!() -> Result[T, E] $ R + S:
        match work!():
            .Ok(value) => .Ok(value)
            .Err(_) => other!()

## Recovers from errors that `handle` maps to a value; others pass through.
pub fn recovered[T, E, $R](handle: fn(E) -> Result[T, E], work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R):
    fn!() -> Result[T, E] $ R:
        match work!():
            .Ok(value) => .Ok(value)
            .Err(error) => handle(error)


@derive(Debug, Deserialize)
struct Todo:
    id: u32
    title: string

# Effect:
#   const getTodo = (id: number) => HttpClient.get(`/todos/${id}`).pipe(
#     Effect.flatMap(HttpClientResponse.schemaBodyJson(Todo)),
#     Effect.timeout("1 second"),
#     Effect.retry(Schedule.exponential("100 millis").pipe(Schedule.intersect(Schedule.recurs(3)))),
#     Effect.catchTag("ResponseError", () => Effect.succeed(fallbackTodo)))
# Written before Response.json returned JsonError (2026-10-23): today the
# closure needs an error type covering HttpError and JsonError.
fn get_todo(id: u32) -> (fn!() -> Result[Todo, HttpError] $ Http + Clock):
    (fn!() -> Result[Todo, HttpError] $ Http: get!("http://api/todos/$id")?.json::[Todo]())
        |> timed(ms(1000), _)
        |> retried(Backoff { attempts: 4, initial: ms(100) }, transient, _)
        |> recovered(missing_todo, _)

fn missing_todo(error: HttpError) -> Result[Todo, HttpError]:
    match error:
        .Status(_) => .Ok(Todo { id: 0, title: "(missing)" })
        other => .Err(other)

pub fn main!() -> void $ Console + Clock:
    let mut http = ScriptedHttp::new()
    http.reply("http://api/todos/1", .Ok(Response { status: 200, body: "{\"id\":1,\"title\":\"write proposal\"}".to_utf8() }))
    http.reply("http://api/todos/2", .Ok(Response { status: 404 }))
    $.with(Http=http):
        println(debug(get_todo(1)!()))
        println(debug(get_todo(2)!()))

fn transient(error: HttpError) -> bool: error.is_transient()
