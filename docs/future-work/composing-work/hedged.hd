use std.task.{race}
use std.time.{Clock, Duration, ms, sleep}

# A concurrency combinator: start a second copy of the work if the first
# has not finished after `delay`, and take whichever finishes first.
pub fn hedged[T, E, $R](delay: Duration, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
    fn!() -> Result[T, E] $ R + Clock:
        race!(work(), late_copy(work, delay))

fn late_copy![T, E, $R](work: fn!() -> Result[T, E] $ R, delay: Duration) -> Result[T, E] $ R + Clock:
    sleep!(delay)
    work!()

struct Counter:
    calls: usize

fn lookup!(counter: &mut Counter) -> Result[string, string] $ Console + Clock:
    counter.calls += 1
    n := counter.calls
    # The first call is a slow replica; the second is fast.
    sleep!(if n == 1: ms(200) else: ms(10))
    println("  replica $n answered")
    .Ok("replica $n")

pub fn main!() -> void $ Console + Clock:
    let mut counter = Counter { calls: 0 }
    get := (fn!(): lookup!(&mut counter))
        |> hedged(ms(30), _)
    println(debug(get!()))
