use std.http.{Http, HttpError, Request, Response, get}
use std.task.{Backoff, retry, with_timeout}
use std.time.{Clock, Duration, ms, sleep}

# Approach C: policies are provider decorators (Tower layers, Effect layers,
# Go RoundTrippers). Each wraps an Http and is itself an Http, so ordinary
# `get!` calls inside `$.with(Http=...)` get the policy, and their rows stay
# `$ Http`: the decorator holds its own Clock.

struct Timed:
    inner: &mut dyn Http
    clock: &mut dyn Clock
    limit: Duration

impl Http for Timed:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        inner := self.inner
        limit := self.limit
        $.with(Clock=self.clock):
            with_timeout!(limit):
                inner.send!(request)

struct Retried:
    inner: &mut dyn Http
    clock: &mut dyn Clock
    policy: Backoff

impl Http for Retried:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        inner := self.inner
        policy := self.policy
        $.with(Clock=self.clock):
            retry!(policy, when=fn(e: HttpError): e.is_transient(), attempt=fn!(): inner.send!(request))

# A user-defined layer composes the same way.
struct Logged:
    inner: &mut dyn Http
    console: &mut dyn Console

impl Http for Logged:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        url := request.url
        result := self.inner.send!(request)
        _ := self.console.write_line!("${url} -> ${if result.is_ok(): "ok" else: "error"}")
        result

# A slow fake server: the first `slow_tries` sends take 100 ms.
struct SlowHttp:
    clock: &mut dyn Clock
    slow_tries: usize
    sent: usize

impl Http for SlowHttp:
    fn send!(&mut self, request: Request) -> Result[Response, HttpError]:
        self.sent += 1
        if self.sent <= self.slow_tries:
            self.clock.sleep!(ms(100))
        .Ok(Response { status: 200, url: request.url })

# Application code: plain `$ Http`, no Clock, no policy in sight.
fn fetch_status!(url: string) -> Result[u16, HttpError] $ Http:
    response := get!(url)?
    .Ok(response.status)

pub fn main!() -> void $ Console + Clock:
    clock := $.use(Clock)
    console := $.use(Console)
    let mut server = SlowHttp { clock: clock, slow_tries: 2, sent: 0 }
    let mut timed = Timed { inner: &mut server, clock: clock, limit: ms(20) }
    let mut retried = Retried { inner: &mut timed, clock: clock, policy: Backoff { attempts: 3, initial: ms(1) } }
    let mut logged = Logged { inner: &mut retried, console: console }
    $.with(Http=&mut logged):
        println("status: ${debug(fetch_status!("http://example/a"))} after ${server.sent} sends")
