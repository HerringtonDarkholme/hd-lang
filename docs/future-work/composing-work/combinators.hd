use std.convert.From
use std.task.{Backoff, TimedOut, retry, with_timeout}
use std.time.{Clock, Duration, ms, sleep}

# Approach A: work is a re-runnable closure; combinators map work to work.

pub fn timed[T, E < From[TimedOut], $R](limit: Duration, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
    fn!() -> Result[T, E] $ R + Clock:
        with_timeout!(limit, work=work)

pub fn retried[T, E, $R](policy: Backoff, when: fn(E) -> bool, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + Clock):
    fn!() -> Result[T, E] $ R + Clock:
        retry!(policy, when=when, attempt=work)

## Runs `other` when `work` fails.
pub fn or_else[T, E, $R, $S](other: fn!() -> Result[T, E] $ S, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R + S):
    fn!() -> Result[T, E] $ R + S:
        match work!():
            .Ok(value) => .Ok(value)
            .Err(_) => other!()

# A stateful user-defined policy: after `limit` failures in a row the
# circuit opens and calls fail fast without running the work.
struct CircuitOpen: pass

struct Breaker:
    failures: usize
    limit: usize

fn guarded[T, E < From[CircuitOpen], $R](breaker: &mut Breaker, work: fn!() -> Result[T, E] $ R) -> (fn!() -> Result[T, E] $ R):
    fn!() -> Result[T, E] $ R:
        if breaker.failures >= breaker.limit:
            return .Err(E::from(CircuitOpen {}))
        result := work!()
        breaker.failures = if result.is_ok(): 0 else: breaker.failures + 1
        result

@error
@derive(Debug, Eq)
enum AppError:
    @error("timed out")
    Timeout
    @error("circuit open")
    Open
    @error("down")
    Down

impl From[TimedOut] for AppError:
    fn from(value: TimedOut) -> AppError:
        AppError.Timeout

impl From[CircuitOpen] for AppError:
    fn from(value: CircuitOpen) -> AppError:
        AppError.Open

fn primary!(delay: Duration) -> Result[string, AppError] $ Console + Clock:
    println("  primary")
    sleep!(delay)
    .Ok("primary")

fn secondary!() -> Result[string, AppError] $ Console:
    println("  secondary")
    .Ok("secondary")

fn down!() -> Result[string, AppError] $ Console:
    println("  down")
    .Err(AppError.Down)

pub fn main!() -> void $ Console + Clock:
    # S1 timeout per attempt, retry, then fall back to another source.
    backup := fn!(): secondary!()
    r1 := (fn!(): primary!(ms(100)))
        |> timed(ms(20), _)
        |> retried(Backoff { attempts: 2, initial: ms(1) }, is_timeout, _)
        |> or_else(backup, _)
        |> _!()
    println("S1 ${debug(r1)}")

    # The same combinator with a trailing block: the work is the last parameter.
    slow := timed(ms(20)):
        primary!(ms(100))
    println("block form ${debug(slow!())}")

    # S2 a reusable guarded call: two failures open the circuit.
    let mut breaker = Breaker { failures: 0, limit: 2 }
    call := (fn!(): down!())
        |> guarded(&mut breaker, _)
    for i in 0..4:
        println("S2 call $i: ${debug(call!())}")

fn is_timeout(error: AppError) -> bool: error == AppError.Timeout
