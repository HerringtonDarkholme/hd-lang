# Proposed validation with std.http; stubs never run.
use std.cli.Cli
use std.console.eprintln
use std.fs.{FsError, FsRead, read_text}
use std.host.{Args, Env, HostError, env_decode}
use std.http.{Request, Response}
use std.json.{JsonError, decode}
use std.path.Path
use std.process.ExitCode
use std.serde.{Deserialize, Rename, Serialize, rename}
use std.structure.Structure
use pkg.validation.{
    PathStep,
    Problem,
    Range,
    Validate,
    ValidationContext,
    ValidationError,
    byte_length,
    check,
    email,
    length,
    max,
    max_length,
    min,
    min_length,
    one_of,
    pattern,
    range,
    unique,
    url,
    uuid,
}

@derive(Deserialize, Eq)
enum Role:
    Reader
    Writer
    Admin
impl Validate for Role by Structure

struct Address:
    street: string
    city: string
impl Deserialize for Address by Structure
impl Validate for Address by Structure:
    street = [length(1, 120)]
    city = [min_length(1)]

# Payload facts are on the declaration: derivation lines name whole variants.
@derive(Deserialize)
enum Contact:
    Email(
        @email()
        address: string,
    )
    Postal(address: Address)
impl Validate for Contact by Structure

struct Signup:
    username: string
    email: string
    request_id: string
    website: string? = .None
    age: u8
    role: Role
    contact: Contact
    addresses: List[Address]
    tags: List[string]
    limits: Map[string, u8]
    password: string
    confirmation: string
    invited: bool = false
    invite: string? = .None

fn available_name(name: &string) -> Result[void, Problem]:
    if name.starts_with("sys_") || name.contains("admin"):
        return .Err(Problem { code: "reserved-name", message: "choose another username" })
    .Ok(())

impl Deserialize for Signup by Structure
impl Validate for Signup by Structure:
    username = [
        length(3, 40, message="username must be 3-40 characters"),
        pattern("^[a-z][a-z0-9_]*$"),
        check(available_name),
    ]
    email = [email()]
    request_id = [uuid()]
    website = [url()]
    age = [min(18), max(130)]
    role = [one_of([Role.Reader, Role.Writer])]
    addresses = [length(1, 8)] # Address/list elements validate automatically.
    tags = [min_length(1), max_length(20), unique()]
    password = [byte_length(12, 256)]
    invite = [pattern("^[A-Z0-9]{8}$")]
    fn record(&self, context: &mut ValidationContext) -> void:
        if self.password != self.confirmation:
            context.reject("confirmation", "passwords must match")
        if self.invited && self.invite.is_none():
            context.reject("invite-required", "an invitation code is required")

@derive(Serialize)
struct ApiIssue:
    path: string
    code: string
    message: string

# The same combinator works after an HTTP reader; errors stay typed.
fn signup(req: &Request) -> Response:
    value := match req.json::[Signup]():
        .Ok(value) => value
        .Err(error) => return Response::status(.BadRequest).set_text("$error")
    match value.validated(max_errors=8):
        .Ok(_) => Response::status(.Created)
        .Err(.Definition(_, reason)) => Response::status(.InternalServerError).set_text(reason)
        .Err(error) =>
            issues := error.issues()
            Response::status(.UnprocessableContent)
                .set_json(
                    [for issue in issues => ApiIssue {
                        path: issue.display_with(json_step),
                        code: issue.problem.code,
                        message: issue.problem.message,
                    }],
                )

fn review_signup(value: Signup) -> Result[Signup, ValidationError]:
    value.validated(max_errors=1)

# Pydantic's documented UserModel password validator, translated literally.
# https://docs.pydantic.dev/latest/concepts/validators/#model-validators
struct Passwords:
    username: string
    password: string
    password_repeat: string
impl Deserialize for Passwords by Structure
impl Validate for Passwords by Structure:
    fn record(&self, context: &mut ValidationContext) -> void:
        if self.password != self.password_repeat:
            context.reject("password-match", "passwords must match")
fn pydantic_model(text: string) -> Result[Passwords, ConfigError]:
    value := decode::[Passwords](text)?
    .Ok(value.validated()?)

struct ServerConfig:
    port: u32 = 8080
    tls: bool = false
    certificate: string? = .None
fn port_rule() -> Range[u32]:
    range(1, 65535)
impl Deserialize for ServerConfig by Structure:
    port = [rename("listenPort")]
impl Validate for ServerConfig by Structure:
    port = [port_rule()]
    certificate = [min_length(1)]
    fn record(&self, context: &mut ValidationContext) -> void:
        if self.tls && self.certificate.is_none():
            context.reject("tls-certificate", "TLS needs a certificate")

@error
enum ConfigError:
    @error("$cause")
    File(
        @from
        cause: FsError,
    )
    @error("$cause")
    Json(
        @from
        cause: JsonError,
    )
    @error("$cause")
    Validation(
        @from
        cause: ValidationError,
    )
fn load_config!(file: Path) -> Result[ServerConfig, ConfigError] $ FsRead:
    text := read_text!(file)?
    value := decode::[ServerConfig](text)?
    match value.validated():
        .Ok(config) => .Ok(config)
        .Err(error) => .Err(.Validation(error))

struct Options:
    port: u32 = 8080
impl Cli for Options by Structure
impl Validate for Options by Structure:
    port = [port_rule()]
fn command_line() -> ExitCode $ Args + Console:
    options := match Options::parse_args():
        .Ok(value) => value
        .Err(error) => return error.exit()
    match options.validated(max_errors=1):
        .Ok(config) =>
            println("listening on ${config.port}")
            ExitCode(0)
        .Err(error) =>
            eprintln(render_issues(error, cli_step))
            ExitCode(2)

@error
enum EnvironmentError:
    @error("$cause")
    Read(
        @from
        cause: HostError,
    )
    @error("$message")
    Validation(message: string)
fn config_from_env() -> Result[ServerConfig, EnvironmentError] $ Env:
    value := env_decode::[ServerConfig](prefix="APP_")?
    match value.validated():
        .Ok(config) => .Ok(config)
        .Err(error) => .Err(.Validation(render_issues(error, env_step)))

fn json_step(step: &PathStep) -> string:
    match step:
        .Field(member) =>
            match member.facts.find::[Rename]():
                .Some(rename) => ".${rename.name}"
                .None => ".${member.name}"
        .Index(index) => "[$index]"
        .Key(name) => "[\"$name\"]"

fn cli_step(step: &PathStep) -> string:
    match step:
        .Field(member) => "--${member.name.replace("_", "-")}"
        .Index(index) => "[$index]"
        .Key(name) => "[$name]"

fn env_step(step: &PathStep) -> string:
    match step:
        .Field(member) => "APP_" + member.name.upper()
        .Index(index) => "[$index]"
        .Key(name) => "[$name]"

fn render_issues(error: ValidationError, name: fn(&PathStep) -> string) -> string:
    [for issue in error.issues() => "${issue.display_with(name)}: ${issue.problem.message}"].join(
        "\n",
    )
