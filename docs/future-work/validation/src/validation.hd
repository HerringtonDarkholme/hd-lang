# Proposed signatures (#846); bodies are unexecuted stubs.
# Each rule kind is one distinct, data-only fact. Check is the sole callback rule.
use std.annotation.annotate
use std.hash.Hash
use std.structure.{Field, Member, Structure, Variant, Walker}

pub enum PathStep:
    Field(member: Member)
    Index(value: usize)
    Key(name: string)

pub struct Problem:
    pub code: string
    pub message: string

pub struct Violation:
    pub path: List[PathStep]
    pub problem: Problem

impl Violation:
    ## Renders this issue with names chosen by the reader that produced the value.
    pub fn display_with(&self, name: fn(&PathStep) -> string) -> string:
        panic("todo")

@error
pub enum ValidationError:
    @error("${format_issues(&issues, truncated)}")
    Invalid(issues: List[Violation], truncated: bool)
    @error("invalid validation rule: $reason")
    Definition(path: List[PathStep], reason: string)

impl ValidationError:
    pub fn issues(self) -> List[Violation]:
        panic("todo")

# Display uses source field names. Readers use Violation.display_with for their spellings.
fn format_issues(issues: &List[Violation], truncated: bool) -> string:
    panic("todo")

pub struct ValidationContext:
    placeholder: usize

impl ValidationContext:
    pub fn reject(&mut self, code: string, message: string) -> void:
        panic("todo")

pub trait Validate:
    fn collect(&self, context: &mut ValidationContext) -> void
    ## Skipped when the positive issue cap stops validation before record checks.
    fn record(&self, context: &mut ValidationContext) -> void:
        panic("todo")
    ## Returns the same value without conversion or normalization.
    fn validated(self, max_errors: usize = 64) -> Result[Self, ValidationError]:
        panic("todo")
    # Rule operations are defaulted here because a generic Structure walker
    # already has only the member's Validate bound.
    fn length_of(&self) -> usize?:
        .None
    fn text_of(&self) -> string?:
        .None
    fn partial_cmp_of(&self, other: &Self) -> Result[Ordering?, void]:
        .Err(())
    fn equal_to(&self, other: &Self) -> bool?:
        .None
    fn unique_items(&self) -> bool?:
        .None
    fn path_name(&self) -> string?:
        .None
    fn apply_attached[S](&self, field: Field[S, Self], context: &mut ValidationContext) -> void:
        panic("todo")

impl[T] Validate for T by Structure:
    # Required template walk is unreachable: the stub panics before constructing it.
    fn collect(&self, context: &mut ValidationContext) -> void:
        let mut walker: ValidationWalker[T] = panic("todo")
        _ := Structure::walk(*self, &mut walker)

struct ValidationWalker[S]: pass

impl[S] Walker[S] for ValidationWalker[S]:
    type Error = never
    fn variant(&mut self, variant: Variant[S]) -> Result[void, never]:
        panic("todo")
    fn member[F](&mut self, field: Field[S, F], value: F) -> Result[void, never]:
        panic("todo")

# Containers recurse automatically; plain leaves have no-op validation.
impl[T < Validate] Validate for List[T]:
    fn collect(&self, context: &mut ValidationContext) -> void:
        panic("todo")
    fn length_of(&self) -> usize?:
        .Some(self.len())
    fn equal_to(&self, other: &List[T]) -> bool?:
        panic("todo")
    fn unique_items(&self) -> bool?:
        panic("todo")
impl[T < Validate] Validate for T?:
    fn collect(&self, context: &mut ValidationContext) -> void:
        panic("todo")
    fn length_of(&self) -> usize?:
        match self:
            .Some(value) => value.length_of()
            .None => .None
    fn text_of(&self) -> string?:
        match self:
            .Some(value) => value.text_of()
            .None => .None
    fn apply_attached[S](&self, field: Field[S, T?], context: &mut ValidationContext) -> void:
        panic("todo")
impl[K < Eq & Hash & Validate, V < Validate] Validate for Map[K, V]:
    fn collect(&self, context: &mut ValidationContext) -> void:
        panic("todo")
    fn length_of(&self) -> usize?:
        .Some(self.len())
impl Validate for string:
    fn collect(&self, context: &mut ValidationContext) -> void:
        panic("todo")
    fn length_of(&self) -> usize?:
        .Some(self.chars().count())
    fn text_of(&self) -> string?:
        .Some(*self)
    fn partial_cmp_of(&self, other: &string) -> Result[Ordering?, void]:
        .Ok(self.partial_cmp(*other))
    fn equal_to(&self, other: &string) -> bool?:
        .Some(*self == *other)
    fn path_name(&self) -> string?:
        .Some(*self)
