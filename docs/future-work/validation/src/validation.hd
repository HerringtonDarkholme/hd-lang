# Proposed signatures (#846); bodies are unexecuted stubs.
# Each fact kind has a distinct type, per review 6408275959.
use std.annotation.annotate
use std.hash.Hash
use std.structure.{Structure, Walker, Variant, Field}

pub enum Mode:
    First
    All

@derive(Eq)
pub enum PathStep:
    Field(name: string)
    Index(value: usize)
    Key(name: string)

pub struct Problem:
    pub code: string
    pub message: string

pub struct Violation:
    pub path: List[PathStep]
    pub display: string
    pub problem: Problem
    # Owned metadata; never a retained local reference to input.
    names: ReaderNames

struct ReaderNames:
    json: string
    cli: string
    env: string

@error
pub enum ValidationError:
    @error("${format_issues(&issues, truncated)}")
    Invalid(issues: List[Violation], truncated: bool)
    @error("invalid validation rule: $reason")
    Definition(path: List[PathStep], reason: string)

impl ValidationError:
    pub fn for_json(&self) -> ValidationError: panic("todo")
    pub fn for_cli(&self) -> ValidationError: panic("todo")
    ## An explicit root names scalar input; records use their own facts.
    pub fn for_env(&self, root: string = "") -> ValidationError: panic("todo")
    pub fn issues(&self) -> List[Violation]: panic("todo")

# Display emits one line per issue and an optional truncation line.
fn format_issues(issues: &List[Violation], truncated: bool) -> string: panic("todo")

pub struct ValidationContext:
    placeholder: usize

impl ValidationContext:
    pub fn reject(&mut self, code: string, message: string) -> void: panic("todo")

pub trait Validate:
    fn collect(&self, context: &mut ValidationContext) -> void
    ## Skipped when First/the cap stopped validation before record checks.
    fn record(&self, context: &mut ValidationContext) -> void: panic("todo")
    ## Returns the same value without conversion or normalization.
    fn validated(self, mode: Mode = .All, max_errors: usize = 64) -> Result[Self, ValidationError]: panic("todo")

impl[T] Validate for T by Structure:
    # Required template walk is unreachable: the stub panics before constructing it.
    fn collect(&self, context: &mut ValidationContext) -> void:
        let mut walker: ValidationWalker[T] = panic("todo")
        _ := Structure::walk(*self, &mut walker)

struct ValidationWalker[S]: pass

impl[S] Walker[S] for ValidationWalker[S]:
    type Error = never
    fn variant(&mut self, variant: Variant[S]) -> Result[void, never]: panic("todo")
    fn member[F](&mut self, field: Field[S, F], value: F) -> Result[void, never]: panic("todo")

# Containers recurse automatically; plain leaves have no-op validation.
impl[T < Validate] Validate for List[T]:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl[T < Validate] Validate for T?:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl[K < Eq & Hash & Validate, V < Validate] Validate for Map[K, V]:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl Validate for string:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl Validate for u8:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl Validate for u32:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")
impl Validate for bool:
    fn collect(&self, context: &mut ValidationContext) -> void: panic("todo")

## A private callback in each concrete fact owns its rule data.
## This protocol composes wrappers; facts remain distinct concrete types.
pub trait Rule[F]:
    fn apply(&self, value: &F, context: &mut ValidationContext) -> void
    fn message(self, text: string) -> Self
    fn optional(self) -> Optional[F?]: panic("todo")
    fn each(self) -> Each[List[F]]: panic("todo")

## Strings count Unicode scalars; collections count elements or entries.
pub trait HasLength:
    fn length(&self) -> usize
impl HasLength for string:
    fn length(&self) -> usize: panic("todo")
impl[T] HasLength for List[T]:
    fn length(&self) -> usize: panic("todo")
impl[K < Eq & Hash, V] HasLength for Map[K, V]:
    fn length(&self) -> usize: panic("todo")

