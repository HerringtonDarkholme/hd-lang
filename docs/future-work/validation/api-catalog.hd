# Signature-only proposal. Every panic is an unimplemented shape stub.
# These are not current std.validation APIs. Do not run this as a library.
use std.cli.{Cli, CliError}
use std.host.{Args, Env, HostError}
use std.json.JsonError
use std.process.ExitCode
use std.serde.Deserialize
use std.text.Parse

pub enum Mode:
    First
    All

pub enum PathStep:
    Field(variant: usize, position: usize, name: string)
    Index(value: usize)
    Key(value: string)

pub struct Problem:
    pub code: string
    pub message: string

pub struct Violation:
    pub path: List[PathStep]
    pub problem: Problem

pub enum ValidationError:
    Invalid(issues: List[Violation], truncated: bool)
    Definition(path: List[PathStep], reason: string)

pub enum CheckedReadError[E]:
    Read(cause: E)
    Validation(cause: ValidationError, locations: List[Location])

pub struct Location:
    pub path: List[PathStep]
    pub display: string

pub struct ValidationContext:
    placeholder: usize

impl ValidationContext:
    pub fn reject(&mut self, problem: Problem) -> void:
        panic("shape-only")
    pub fn is_stopped(&self) -> bool:
        panic("shape-only")

pub trait Validate:
    fn collect(self, context: *mut ValidationContext) -> void
    fn record(self, context: *mut ValidationContext) -> void:
        pass

pub struct Rule[F]:
    placeholder: usize

pub struct Rules[F]:
    placeholder: usize

pub enum TextLengthUnit:
    Bytes
    Scalars

pub fn validate[T < Validate](
    value: T,
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[void, ValidationError]:
    panic("shape-only")
pub fn check[F](test: fn(F) -> Result[void, Problem]) -> Rule[F]:
    panic("shape-only")
pub fn rules[F](items: List[Rule[F]]) -> Rules[F]:
    panic("shape-only")
pub fn range[F < PartialOrd](low: F, high: F) -> Rule[F]:
    panic("shape-only")
pub fn length_by[F](min: usize, max: usize, measure: fn(F) -> usize) -> Rule[F]:
    panic("shape-only")
pub fn text_length(min: usize, max: usize, unit: TextLengthUnit = .Scalars) -> Rule[string]:
    panic("shape-only")
pub fn list_length[F](min: usize, max: usize) -> Rule[List[F]]:
    panic("shape-only")
pub fn pattern(source: string) -> Rule[string]:
    panic("shape-only")
pub fn one_of[F < Eq](values: List[F]) -> Rule[F]:
    panic("shape-only")
pub fn optional[F](rule: Rule[F]) -> Rule[F?]:
    panic("shape-only")
pub fn nested[F < Validate]() -> Rule[F]:
    panic("shape-only")
pub fn each[F](rule: Rule[F]) -> Rule[List[F]]:
    panic("shape-only")

pub fn decode_checked[T < Deserialize & Validate](
    text: string,
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[T, CheckedReadError[JsonError]]:
    panic("shape-only")
pub fn parse_checked[T < Cli & Validate](
    arguments: List[string],
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[T, CheckedReadError[CliError]]:
    panic("shape-only")
pub fn parse_args_checked[T < Cli & Validate](
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[T, CheckedReadError[CliError]] $ Args:
    panic("shape-only")
# Proposed std.cli.exit_checked, named descriptively in this standalone catalog.
pub fn exit_checked_cli(error: CheckedReadError[CliError]) -> ExitCode $ Console:
    panic("shape-only")
pub fn env_as_checked[T < Parse[Error = E] & Validate, E < Display](
    name: string,
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[T?, CheckedReadError[HostError]] $ Env:
    panic("shape-only")
pub fn env_decode_checked[T < Deserialize & Validate](
    prefix: string = "",
    mode: Mode = .All,
    max_errors: usize = 64,
) -> Result[T, CheckedReadError[HostError]] $ Env:
    panic("shape-only")

pub fn json_entry[T < Deserialize & Validate](
    text: string,
) -> Result[T, CheckedReadError[JsonError]]:
    decode_checked::[T](text)

pub fn cli_entry[T < Cli & Validate]() -> Result[T, CheckedReadError[CliError]] $ Args:
    parse_args_checked::[T]()

pub fn env_entry[T < Parse[Error = E] & Validate, E < Display](
    name: string,
) -> Result[T?, CheckedReadError[HostError]] $ Env:
    env_as_checked::[T](name)
