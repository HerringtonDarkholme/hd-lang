{
  "name": "hd-lang",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web-compiler": "node scripts/build-web-compiler.js",
    "check": "pnpm run check:types && pnpm run lint && pnpm run format:check && pnpm test && bash spec/check.sh",
    "check:types": "tsc --noEmit && tsc --noEmit -p website/playground",
    "format": "oxfmt --write 'host/**/*.mjs' 'host/**/*.mts' 'spec/**/*.ts' 'bench/**/*.ts' 'scripts/**/*.js' 'website/*.ts' 'website/src/**/*.ts' 'website/client/**/*.ts' 'website/test/**/*.ts' 'website/assets/**/*.js' 'website/playground/**/*.ts' package.json .oxfmtrc.json .oxlintrc.json",
    "format:check": "oxfmt --check 'host/**/*.mjs' 'host/**/*.mts' 'spec/**/*.ts' 'bench/**/*.ts' 'scripts/**/*.js' 'website/*.ts' 'website/src/**/*.ts' 'website/client/**/*.ts' 'website/test/**/*.ts' 'website/assets/**/*.js' 'website/playground/**/*.ts' package.json .oxfmtrc.json .oxlintrc.json",
    "lint": "oxlint .",
    "test": "node --test --experimental-strip-types 'host/*.test.mjs' 'bench/metrics/*.test.ts' 'spec/tools/*.test.ts'",
    "test:all": "pnpm test && pnpm run test:ui",
    "test:ui": "node --test --experimental-strip-types 'website/test/*.test.ts' 'website/playground/test/**/*.test.ts'",
    "fuzz:smoke": "node --experimental-strip-types spec/tools/fuzz/fuzz.ts --fuzzer parse,contract,phase --fail-on phase --seed smoke --cases 100",
    "metrics": "node --experimental-strip-types bench/metrics/run.ts",
    "test:web-compiler": "pnpm run -s build:web-compiler && node scripts/test-web-compiler.js",
    "spec": "node --experimental-strip-types spec/tools/spec.ts",
    "website:build": "node --experimental-strip-types website/build.ts",
    "website:dev": "node --experimental-strip-types website/serve.ts",
    "website:e2e": "node --experimental-strip-types website/e2e.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "@types/node": "26.6.2",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "markdown-it": "15.0.2",
    "markdown-it-footnote": "4.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@10.8.0"
}
