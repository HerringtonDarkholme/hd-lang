# Git fast-import streams are fed to git byte-exact: CRLF would corrupt
# their ref names and data lengths.
*.fi -text
# These fixtures judge byte offsets of fix-it edits, which depend on the
# line ending; check them out with LF everywhere so Windows sees the same
# bytes as the expectations.
spec/conformance/cli/fix-derivation-fact/** text eol=lf
spec/conformance/cli/mutable-and-signed-hints/** text eol=lf
spec/conformance/cli/fix-existing-mut-receiver/** text eol=lf
spec/conformance/cli/fix-parser-byte-edits/** text eol=lf
spec/conformance/cli/fix-parser-migrations/** text eol=lf
spec/conformance/cli/fix-parser-punctuation/** text eol=lf
spec/conformance/cli/fix-elif-continuations/** text eol=lf
spec/conformance/cli/fix-known-name-errors/** text eol=lf
spec/conformance/cli/unknown-name-suggestions/methods.hd text eol=lf
spec/conformance/cli/fix-legacy-syntax/** text eol=lf
spec/conformance/cli/fix-reassigned-bindings/** text eol=lf
spec/conformance/cli/fix-private-main/src/*.hd text eol=lf
spec/conformance/cli/fix-private-main-bang/src/*.hd text eol=lf
spec/conformance/cli/fix-private-main-clash/src/*.hd text eol=lf
spec/conformance/cli/fix-private-main-unsafe/src/*.hd text eol=lf
