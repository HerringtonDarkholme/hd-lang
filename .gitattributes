# Every text file checks out with LF on every platform. Tests compare
# fixtures, snapshots and baselines byte for byte, and Windows' CRLF
# checkout broke main three times on 2026-11-17 with per-path rules.
# Files that must keep other bytes opt out below with -text (last match wins).
* text=auto eol=lf

# Git fast-import streams are fed to git byte-exact: CRLF would corrupt
# their ref names and data lengths.
*.fi -text

# A missing import's fix-it in a CRLF file: stored with CRLF bytes and
# never converted, so every checkout on every platform has them.
spec/conformance/cli/check-fix-std-import-crlf/src/*.hd -text
spec/conformance/cli/check-fix-std-import-crlf/want/* -text

# Byte-sensitive conformance inputs: preserve CRLF and the UTF-8 BOM.
spec/conformance/lang/lexical/physical-and-logical-lines/crlf-line-endings.hd -text whitespace=cr-at-eol
spec/conformance/lang/lexical/physical-and-logical-lines/bare-carriage-return.hd -text
spec/conformance/lang/lexical/processing-model/utf8-bom.hd -text

# Prefixed string raw parts exercise physical CRLF before interpolation.
crates/hd_driver/tests/cases/literal-lines/*-crlf.hd -text whitespace=cr-at-eol
spec/conformance/lang/lexical/literals/prefixed-string-crlf-raw-parts.hd -text whitespace=cr-at-eol
