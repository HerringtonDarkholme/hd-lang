# mistake: a comma between requirement keys
# log: 2026-10-06 P1j playground host probe
# expect: old-row-separator
# fixed: fn stamp() -> string $ Clock + Ids:

trait Clock:
    fn now(self) -> i64

trait Ids:
    fn next(self) -> i64

fn stamp() -> string $ Clock, Ids:  # diagnostic: old-row-separator
    "${$.use(Clock).now()}-${$.use(Ids).next()}"
