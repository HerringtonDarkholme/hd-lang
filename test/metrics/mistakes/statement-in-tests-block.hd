# mistake: a plain statement inside a `tests:` block
# log: 2026-10-06 probe 6
# expect: invalid-test-statement

use std.testing.assert_equal

fn twice(n: i32) -> i32:
    n * 2

tests:
    it("doubles"):
        assert_equal(twice(2), 4, reason="double")
    total := twice(5)  # diagnostic: invalid-test-statement
