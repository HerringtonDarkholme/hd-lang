# test: shared enum data uses per-variant factories and pure ordered defaults
# expect-result: main = 84

enum Status(code: i32, doubled: i32 = code * 2):
    Unknown -> Status(21)

enum Tagged[T](tag: T):
    Value(value: T) -> Tagged(value)

fn read_tagged(value: Tagged[i32]) -> i32:
    match value:
        Tagged.Value(payload) => value.tag + payload

fn main() -> i32:
    status := Status.Unknown
    status.doubled + read_tagged(Tagged.Value(21))
