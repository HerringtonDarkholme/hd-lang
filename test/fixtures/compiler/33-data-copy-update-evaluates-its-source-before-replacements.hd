# test: data copy-update evaluates its source before replacements
# expect-result: main = 42

data Pair[T]:
    first: T
    second: T

fn source!() -> Pair[i32]: Pair { first: 20, second: 1 }
fn replacement!() -> i32: 22
fn main!() -> i32:
    pair := Pair { ...source!(), second: replacement!() }
    pair.first + pair.second
