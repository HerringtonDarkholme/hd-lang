# test: named local functions capture enclosing values and recurse
# expect-result: main = 42

fn total_with_bonus(values: list[i32], bonus: i32) -> i32:
    fn add_bonus(value: i32) -> i32:
        value + bonus
    let total: i32 = 0
    for value in values:
        total = total + add_bonus(value)
    total

fn factorial(n: i32) -> i32:
    fn step(value: i32) -> i32:
        if value <= 1:
            1
        else:
            value * step(value - 1)
    step(n)

fn main() -> i32: total_with_bonus([1, 2, 3], 10) + factorial(3)
