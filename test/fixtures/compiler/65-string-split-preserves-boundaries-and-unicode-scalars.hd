# test: string split preserves empty pieces and splits an empty separator at Unicode scalars
# expect-result: separated = 1
# expect-result: scalars = 1
# expect-result: empty_input = 1

fn separated() -> i32:
    pieces := ",a,,β,".split(",")
    if pieces.len() == 5 and pieces[0] == "" and pieces[1] == "a" and pieces[2] == "" and pieces[3] == "β" and pieces[4] == "":
        1
    else:
        0

fn scalars() -> i32:
    pieces := "Aβ🙂".split("")
    if pieces.len() == 3 and pieces[0] == "A" and pieces[1] == "β" and pieces[2] == "🙂":
        1
    else:
        0

fn empty_input() -> i32:
    if "".split("").len() == 0: 1
    else: 0
