# test: Result patterns recursively match imported enum payloads
# expect-result: main = 42

use std.resource.ResourceError

data Failure:
    code: i32

fn outcome() -> Result[i32, ResourceError[Failure]]:
    Err(ResourceError.Disposed)

fn main() -> i32:
    match outcome():
        Err(ResourceError.Disposed) => 42
        _ => 0
