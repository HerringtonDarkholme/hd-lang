# test: mutable maps grow from empty storage and remove entries in insertion order
# expect-result: main = 42

fn main() -> i32:
    let values: mut map[string, i32] = {}
    values["a"] = 1
    values["b"] = 2
    values["c"] = 3
    values["d"] = 4
    values["e"] = 5
    values["f"] = 27
    removed := match values.remove(key="c"):
        value? => value
        nil => 0
    missing := match values.get("c"):
        value? => value
        nil => 0
    let remaining = 0
    for key, value in values:
        _ := key
        remaining = remaining + value
    removed + missing + remaining
