# test: host provider polls record and replay
# fixture-runtime-profile: ready-gate
# expect: test

use std.testing.assert_equal

let provider_result: i32 = 0

pub trait Gate:
    fn wait!(self) -> void

fn wait_once!() -> void $ Gate:
    $.use(Gate).wait!()

pub fn main!() -> void $ Gate:
    wait_once!()
    provider_result = 42

pub fn recorded_result() -> i32:
    provider_result

test "host provider completed":
    assert_equal(
        provider_result,
        42,
        reason="the host suspension must complete before the test runs",
    )
