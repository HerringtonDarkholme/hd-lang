# test: suspending closure values forward their requirement rows
# expect: test

use std.testing.assert_equal

trait Increment:
    fn next!(self, value: i32) -> i32

data FixedIncrement: pass

impl Increment for FixedIncrement:
    fn next!(self, value: i32) -> i32:
        value + 1

fn drive_required_closure!() -> i32:
    operation := fn!(value: i32) -> i32 $ Increment:
        provider := $.use(Increment)
        provider.next!(value)
    $.with(Increment=FixedIncrement {}):
        operation!(41)

test "the closure receives its provider when its suspension is constructed":
    assert_equal(
        drive_required_closure!(),
        42,
        reason="the callable requirement row must reach the generated closure frame",
    )
