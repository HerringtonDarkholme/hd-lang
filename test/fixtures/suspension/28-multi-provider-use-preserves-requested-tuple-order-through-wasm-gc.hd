# test: multi-provider use preserves requested tuple order through Wasm GC
# expect-result: main = 42

trait Left:
    fn value(self) -> i32

trait Right:
    fn value(self) -> i32

data Number:
    value: i32

impl Left for Number:
    fn value(self) -> i32: self.value

impl Right for Number:
    fn value(self) -> i32: self.value

fn main() -> i32:
    $.with(Left=Number { value: 20 }, Right=Number { value: 22 }):
        left, right := $.use(Left, Right)
        left.value() + right.value()
