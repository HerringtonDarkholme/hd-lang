# test: host provider f64 values use durable bit encoding
# fixture-runtime-profile: ready-float
# expect: test

use std.testing.assert

let provider_result: f64 = 1.0

pub trait FloatCell:
    fn sample!(self, value: f64) -> f64

fn sample!() -> f64 $ FloatCell:
    $.use(FloatCell).sample!(-0.0)

pub fn main!() -> void $ FloatCell:
    provider_result = sample!()
    assert(
        "${provider_result}" == "-0.0",
        reason="the runtime profile echoes -0.0 with its sign bit",
    )

pub fn recorded_result() -> f64:
    provider_result
