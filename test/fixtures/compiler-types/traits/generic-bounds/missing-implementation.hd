# test: traits / generic bounds / missing implementation

trait Describe:
    fn describe(self) -> i32

data Number:
    value: i32

impl Describe for Number:
    fn describe(self) -> i32: self.value

fn show[T < Describe](value: T) -> i32:
    value.describe()

fn identity[T < Describe](value: T) -> T:
    value

fn main() -> i32:
    returned := identity(Number { value: 22 })
    show(42) + returned.value  # diagnostic: missing-trait-implementation
