# test: data / generic / erased layout
# expect-result: main = 42

data Box[T]:
    value: T

data Pair[A, B]:
    first: A
    second: B

fn keep[T](box: Box[T]) -> Box[T]: box

fn main() -> i32:
    box := Box { value: 40 }
    pair := Pair { first: keep(box), second: "hd" }
    pair.first.value + pair.second.len()
