# test: requirements / row subtraction / provider restoration
# expect-result: main = 42

fn provide_logger[r](callback: fn() -> i32 $ r) -> i32 $ (r - Logger) + Backup:
    $.with(Logger=$.use(Backup)):
        callback()

fn read() -> i32 $ Clock + Logger:
    _ := $.use(Clock)
    _ := $.use(Logger)
    42

fn main() -> i32 $ Clock + Backup:
    provide_logger(read)
