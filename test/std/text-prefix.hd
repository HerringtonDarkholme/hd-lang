# std.text: the string-prefix helpers `interpolate` and `process_escapes`,
# which the specification does not name.
# `process_escapes` returns `Result[string, EscapeError]` (Literal Suffixes
# L21), and both live in `std.text` beside `r` (L22).
use std.ops.{Template, str_prefix}
use std.text.{interpolate, process_escapes}
# A prefix that processes escapes in its pieces, then joins them.
@str_prefix
fn cooked(t: Template[i32]) -> string:
    let pieces: mut List[string] = []
    for piece in t.raw_parts:
        pieces.push(escaped(piece))
    interpolate(Template { raw_parts: pieces, values: t.values })

# The processed text, or "?" and the offset of the bad escape.
fn escaped(text: string) -> string:
    match process_escapes(text):
        .Ok(processed) => processed
        .Err(error) => "?${error.position}"

tests:
    use std.testing.assert_equal

    it("interpolate joins pieces and values in order"):
        joined := interpolate(Template { raw_parts: ["a", "b", "c"], values: [1, 2] })
        assert_equal(joined, "a1b2c", reason="pieces around values")

    it("process_escapes replaces each escape"):
        assert_equal(escaped("a\\tb\\u{41}\\\\n\\\$"), "a\tbA\\n\$", reason="escapes")
        assert_equal(escaped("bad\\q"), "?3", reason="an invalid escape at byte 3")
        assert_equal(escaped("end\\"), "?3", reason="a lone final backslash")
        assert_equal(escaped("\\u{110000}"), "?0", reason="beyond the scalar range")
        assert_equal(escaped("é\\q"), "?2", reason="the offset counts bytes")

    it("a prefix can process escapes in its pieces"):
        n := +7
        assert_equal(cooked"n=$n\n", "n=7\n", reason="the escape after the value is processed")
