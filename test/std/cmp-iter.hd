# std.cmp and std.iter.
use std.cmp.{clamp, max, min, Reverse}
use std.iter.range
use std.testing.{assert, assert_equal}

fn is_greater(order: Ordering) -> bool:
    match order:
        .Greater => true
        _ => false

tests:
    it("min, max, and clamp"):
        assert_equal(min(3, 2), 2, reason="min")
        assert_equal(max("a", "b"), "b", reason="max")
        assert_equal(clamp(15, 0, 10), 10, reason="above the range")
        assert_equal(clamp(-5, 0, 10), 0, reason="below the range")
        assert_equal(clamp(5, 0, 10), 5, reason="inside the range")

    it("clamp rejects an empty range", expect_panic="explicit-panic"):
        _ := clamp(1, 10, 0)

    it("Reverse inverts the order"):
        assert(is_greater(Reverse { value: 1 }.cmp(Reverse { value: 2 })), reason="1 sorts after 2")

    it("range and collect"):
        assert_equal(range(2, 5).collect(), [2, 3, 4], reason="the end is exclusive")
        assert_equal(range(5, 2).collect(), [], reason="an empty range")
        let total = 0
        for value in range(0, 4):
            total = total + value
        assert_equal(total, 6, reason="a range drives a for loop")

    it("adapters"):
        evens := range(0, 100).filter(fn(value: i32) -> bool: value % 2 == 0).take(3).collect()
        assert_equal(evens, [0, 2, 4], reason="filter then take")
        assert_equal([1, 2].iter().map(fn(value: i32) -> string: "$value").collect(), ["1", "2"], reason="map")
        assert_equal(["a", "b"].iter().enumerate().collect(), [(0, "a"), (1, "b")], reason="enumerate")
        assert_equal(range(1, 5).fold(0, fn(sum: i32, value: i32) -> i32: sum + value), 10, reason="fold")

    it("take reads only what it yields"):
        let source: mut Iterator[i32] = [1, 2, 3].iter()
        assert_equal(source.take(1).collect(), [1], reason="the first item")
        assert_equal(source.collect(), [2, 3], reason="the rest stays in the source")

    it("composites compare through std.cmp"):
        assert([1, 2] < [1, 3] && [1] < [1, 0] && !([2] < [1, 9]), reason="lists order lexicographically")
        let missing: i32? = .None
        let present: i32? = 0
        assert(missing < present && missing != present, reason=".None comes first")
        assert(!([1.0, 0.0 / 0.0] < [1.0, 2.0]), reason="an unordered element makes the lists unordered")
        let failed: Result[i32, string] = .Err("e")
        let succeeded: Result[i32, string] = .Ok(1)
        assert(failed != succeeded && failed == failed, reason="Result compares its variants")
        assert({"a": 1, "b": 2} == {"b": 2, "a": 1}, reason="map equality ignores order")
        assert_equal(min([2, 1], [1, 9]), [1, 9], reason="Ord for lists")

    it("repeated comparisons start each time from the first element"):
        let unequal = 0
        for pair in [([1, 2], [1, 2]), ([1, 2], [1, 3]), ([1, 2], [1, 3])]:
            if pair._0 != pair._1:
                unequal = unequal + 1
        assert_equal(unequal, 2, reason="each comparison reads its own lists")
