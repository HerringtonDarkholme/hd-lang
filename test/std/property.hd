# std.testing property tests: it_prop and it_prop_with run generated cases.
use std.testing.{assert, Choices, it_prop, it_prop_with}

fn small(c: mut Choices) -> i64:
    c.int(0, 9)

fn pair(c: mut Choices) -> List[i64]:
    c.list(3, fn(inner: mut Choices) -> i64: inner.int(-5, 5))

fn even(c: mut Choices) -> i64:
    let value: i64 = c.int(0, 100)
    c.assume(value % 2 == 0)
    value

fn stock(c: mut Choices) -> Map[string, i32]:
    c.map(3, key=fn(inner: mut Choices) -> string: inner.string(max_chars=1), value=fn(inner: mut Choices) -> i32: inner.int(0, 9))

fn byte(c: mut Choices) -> u8:
    c.int(250, 255)

# A leaf-first recursive generator ends once the draw limit is spent.
fn depth(c: mut Choices) -> i32:
    match c.int(0, 3):
        0 => 0
        _ => 1 + depth(c)

tests:
    it_prop("addition commutes", prop=fn!(value: i64):
        let one: i64 = 1
        assert(value.wrapping_add(one) == one.wrapping_add(value), reason="commutes, with wrapping at the largest value")
    )

    it_prop_with("draws stay in range", gen=small, cases=50, prop=fn!(n: i64):
        assert(n >= 0 && n <= 9, reason="in range")
    )

    it_prop_with("lists stay short", pair, prop=fn!(items: List[i64]):
        assert(items.len() <= 3, reason="at most max items")
    )

    it_prop_with("assume discards odd values", gen=even, prop=fn!(n: i64):
        assert(n % 2 == 0, reason="only even values reach the property")
    )

    it_prop("a string is at most 16 chars", prop=fn!(text: string):
        let count: usize = 0
        for letter in text.chars():
            count = count + 1
        assert(count <= 16, reason="the default string size counts chars")
    )

    it_prop_with("a map holds at most max entries", gen=stock, prop=fn!(entries: Map[string, i32]):
        assert(entries.len() <= 3, reason="a drawn key again keeps one entry")
    )

    it_prop_with("int takes its type from the context", gen=byte, prop=fn!(b: u8):
        assert(b >= 250, reason="from 250 to 255")
    )

    it_prop_with("the draw budget ends recursion", gen=depth, prop=fn!(d: i32):
        assert(d >= 0, reason="a finite depth")
    )

    it_prop("an f64 may be any value", prop=fn!(x: f64):
        assert(x == x || x != x, reason="NaN is not equal to itself")
    )
