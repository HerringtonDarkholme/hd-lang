# std.time Duration and std.process.
use std.process.{ExitCode, Process, ProcessOutput, ScriptedProcess, Termination}
use std.time.{Duration, h, min, ms, s}

fn status!(program: string) -> i32 $ Process:
    match $.use(Process).run!(program, [], ""):
        .Ok(output) => output.status
        .Err(_) => -1

fn code(value: ExitCode) -> u8:
    u8(value)

tests:
    use std.testing.assert_equal

    it("Duration counts whole milliseconds"):
        assert_equal(Duration::milliseconds(250).as_milliseconds(), 250, reason="milliseconds")
        assert_equal(Duration::seconds(2).as_milliseconds(), 2000, reason="seconds")
        assert_equal(250ms.as_milliseconds(), 250, reason="ms suffix")
        assert_equal(5s.as_milliseconds(), 5000, reason="s suffix")
        assert_equal(2min.as_milliseconds(), 120000, reason="min suffix")
        assert_equal(1h.as_milliseconds(), 3600000, reason="h suffix")

    it("Duration arithmetic and Display"):
        assert_equal((1h - 1ms).as_milliseconds(), 3599999, reason="sub")
        assert_equal((30s + 30s).to_string(), "1min0s", reason="every component below the first")
        assert_equal((-(1500ms)).to_string(), "-1.5s", reason="a negative fraction of a second")
        assert_equal(Duration::milliseconds(-9_223_372_036_854_775_807 - 1).to_string(), "-2562047788015h12min55.808s", reason="the most negative duration")

    it("Termination reports exit codes"):
        let failed: Result[void, string] = .Err("no")
        assert_equal(code(failed.report()), 1, reason="an Err reports 1")
        assert_equal(code(ExitCode(3).report()), 3, reason="an ExitCode reports itself")

    it("ScriptedProcess answers by program"):
        let mut scripted = ScriptedProcess::new({"git": ProcessOutput { stdout: "", stderr: "", status: 0 }})
        $.with(Process=scripted):
            assert_equal(status!("git"), 0, reason="git is scripted")
            assert_equal(status!("make"), -1, reason="make is not")
