# The sized numeric types: arithmetic, explicit widening, casts, and Display.
fn widen_signed(value: i8) -> i64:
    i64(value)

fn widen_unsigned(value: u16) -> u64:
    u64(value)

tests:
    use std.testing.{assert, assert_equal}

    it("narrow signed arithmetic stays in range"):
        let small: i8 = 100
        let other: i8 = 27
        assert_equal("${small + other}", "127", reason="i8 maximum")
        let minimum: i16 = -32768
        assert_equal("$minimum", "-32768", reason="i16 minimum")
        assert_equal(widen_signed(small), 100, reason="i8 widens to i64")

    it("i8 overflow panics", expect_panic="integer-overflow"):
        let small: i8 = 100
        _ := small + small

    it("i8 MIN / -1 panics", expect_panic="integer-overflow"):
        let minimum: i8 = -128
        let divisor: i8 = -1
        _ := minimum / divisor

    it("unsigned 32-bit values compare and display as unsigned"):
        let large: u32 = 4000000000
        let small: u32 = 5
        assert(large > small, reason="unsigned comparison")
        assert_equal("$large", "4000000000", reason="u32 Display")
        assert_equal("${large / small}", "800000000", reason="unsigned division")

    it("u32 subtraction below zero panics", expect_panic="integer-overflow"):
        let small: u32 = 5
        let large: u32 = 6
        _ := small - large

    it("u64 keeps its full range"):
        let top: u64 = 18446744073709551615
        let half: u64 = 9223372036854775808
        assert(top > half, reason="unsigned 64-bit comparison")
        assert_equal("${top - half}", "9223372036854775807", reason="u64 subtraction")
        assert_equal("${half / 2}", "4611686018427387904", reason="u64 division")
        assert_equal(widen_unsigned(65535), 65535, reason="u16 widens to u64")

    it("u64 overflow panics", expect_panic="integer-overflow"):
        let top: u64 = 18446744073709551615
        _ := top + 1

    it("numeric casts convert in range"):
        let wide: i64 = 300
        assert_equal("${i16(wide)}", "300", reason="in range")
        assert_equal("${u8(i32(200))}", "200", reason="i32 to u8")
        assert_equal("${i32(2.9)}", "2", reason="a float truncates toward zero")
        assert_equal("${i32(-2.9)}", "-2", reason="toward zero for negatives")
        let single: f32 = 0.5
        assert_equal("${f64(single)}", "0.5", reason="f32 to f64")
        assert_equal("${f32(0.1)}", "0.1", reason="f64 to f32 rounds")
        assert_equal("${u64(i64(7))}", "7", reason="i64 to u64")

    it("an out-of-range integer cast wraps"):
        let wide: i64 = 300
        assert_equal("${i8(wide)}", "44", reason="300 keeps its low eight bits")
        let negative: i64 = -1
        assert_equal("${u64(negative)}", "18446744073709551615", reason="-1 wraps to the u64 maximum")
        assert_equal("${u32(negative)}", "4294967295", reason="-1 wraps to the u32 maximum")

    it("an out-of-range float cast saturates"):
        assert_equal("${i8(300.0)}", "127", reason="clamps to the i8 maximum")
        assert_equal("${u8(-3.5)}", "0", reason="clamps to the u8 minimum")

    it("f32 arithmetic keeps f32 width"):
        let a: f32 = 0.1
        let b: f32 = 0.2
        assert_equal("${a + b}", "0.3", reason="f32 sum displays at f32 width")
        wide := f64(a)
        assert(wide != 0.1, reason="f32 0.1 widens exactly, not to f64 0.1")

    it("narrow shifts keep the width"):
        let bits: u8 = 1
        assert_equal("${bits << 7}", "128", reason="u8 shift")
        let signed: i16 = -8
        assert_equal("${signed >> 1}", "-4", reason="arithmetic shift")
