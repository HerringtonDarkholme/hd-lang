# std.num: checked, wrapping, and saturating arithmetic, bit counts, and parsing.
use std.num.{parse_i32, parse_i64, ParseNumberError}
use std.testing.{assert, assert_equal}

fn describe(result: Result[i32, ParseNumberError]) -> string:
    match result:
        .Ok(value) => "ok $value"
        .Err(.Empty) => "empty"
        .Err(.InvalidDigit(position)) => "invalid digit at $position"
        .Err(.OutOfRange) => "out of range"

fn i32_max() -> i32:
    2147483647

fn i32_min() -> i32:
    -2147483647 - 1

tests:
    it("checked arithmetic reports overflow as None"):
        assert_equal(i32_max().checked_add(1), .None, reason="add overflows")
        assert_equal(i32_min().checked_sub(1), .None, reason="sub overflows")
        assert_equal(i32_max().checked_mul(2), .None, reason="mul overflows")
        assert_equal((-3).checked_mul(4), .Some(-12), reason="mul fits")
        assert_equal(7.checked_div(0), .None, reason="division by zero")
        assert_equal(i32_min().checked_div(-1), .None, reason="the one overflowing division")
        assert_equal(7.checked_div(2), .Some(3), reason="division truncates")

    it("wrapping and saturating arithmetic"):
        assert_equal(i32_max().wrapping_add(1), i32_min(), reason="wraps up")
        assert_equal(i32_min().wrapping_sub(1), i32_max(), reason="wraps down")
        assert_equal(0.wrapping_sub(i32_min()), i32_min(), reason="negating the minimum wraps")
        assert_equal(i32_max().saturating_add(5), i32_max(), reason="saturates up")
        assert_equal(i32_min().saturating_sub(5), i32_min(), reason="saturates down")
        assert_equal(3.abs_diff(10), 7, reason="abs_diff")

    it("bit counts"):
        assert_equal(7.count_ones(), 3, reason="count_ones")
        assert_equal((-1).count_ones(), 32, reason="every bit of -1")
        assert_equal(1.leading_zeros(), 31, reason="leading_zeros")
        assert_equal((-1).leading_zeros(), 0, reason="the sign bit is set")
        let one: i64 = 1
        assert_equal(one.leading_zeros(), 63, reason="i64 width")
        let ones: u32 = (-1).count_ones()
        assert_equal(ones, 32, reason="count_ones returns u32")
        let eight: i64 = 8
        assert_equal(one << (63 - eight.leading_zeros()), eight, reason="leading_zeros is a u32 shift count")

    it("i64 methods"):
        let largest: i64 = 9223372036854775807
        assert(largest.checked_add(1).is_none(), reason="i64 add overflows")
        assert_equal(largest.wrapping_add(1).checked_sub(1), .None, reason="wraps to the minimum")

    it("f64 classification"):
        nan := 0.0 / 0.0
        assert(nan.is_nan() && !nan.is_finite(), reason="NaN")
        assert(!(1.0 / 0.0).is_finite(), reason="infinity")
        assert(2.5.is_finite() && !2.5.is_nan(), reason="an ordinary value")

    it("parse_i32 and parse_i64"):
        assert_equal(describe(parse_i32("42")), "ok 42", reason="digits")
        assert_equal(describe(parse_i32("+7")), "ok 7", reason="a plus sign")
        assert_equal(describe(parse_i32("-2147483648")), "ok -2147483648", reason="the minimum")
        assert_equal(describe(parse_i32("2147483648")), "out of range", reason="one past the maximum")
        assert_equal(describe(parse_i32("")), "empty", reason="empty")
        assert_equal(describe(parse_i32("12a")), "invalid digit at 2", reason="the bad scalar's position")
        assert_equal(describe(parse_i32("-")), "invalid digit at 1", reason="a sign alone: the end-of-text index")
        assert(parse_i64("9223372036854775807").is_ok(), reason="the i64 maximum")
        assert(parse_i64("-9223372036854775808").is_ok(), reason="the i64 minimum")
        assert(parse_i64("9223372036854775808").is_err(), reason="one past the i64 maximum")
        assert_equal(describe(parse_i32("99999999999x")), "out of range", reason="the first error wins")

    it("every integer width"):
        let small: i8 = -128
        assert_equal(small.checked_sub(1), .None, reason="i8 sub overflows")
        assert_equal(small.wrapping_sub(1), 127, reason="i8 wraps down")
        assert_equal(small.saturating_sub(1), -128, reason="i8 saturates down")
        assert_equal(small.checked_div(-1), .None, reason="the i8 minimum over -1")
        assert_equal(small.abs_diff(127), 255, reason="i8 abs_diff is u8")
        let byte: u8 = 250
        assert_equal(byte.checked_add(5), .Some(255), reason="u8 add fits")
        assert_equal(byte.checked_add(10), .None, reason="u8 add overflows")
        assert_equal(byte.wrapping_add(10), 4, reason="u8 wraps up")
        assert_equal(byte.saturating_add(10), 255, reason="u8 saturates up")
        assert_equal(byte.checked_div(255), .Some(0), reason="u8 has no overflowing division")
        assert_equal(byte.count_ones(), 6, reason="u8 count_ones")
        assert_equal(byte.leading_zeros(), 0, reason="u8 leading_zeros")
        let short: i16 = 5
        assert_equal(short.abs_diff(-5), 10, reason="i16 abs_diff")
        assert_equal(short.leading_zeros(), 13, reason="i16 width")
        let word: u16 = 0
        assert_equal(word.checked_sub(1), .None, reason="u16 sub overflows")
        assert_equal(word.leading_zeros(), 16, reason="u16 zero")
        let unsigned: u32 = 0
        assert_equal(unsigned.wrapping_sub(1), 4294967295, reason="u32 wraps down")
        assert_equal(unsigned.saturating_sub(1), 0, reason="u32 saturates down")
        assert_equal(unsigned.abs_diff(4294967295), 4294967295, reason="u32 abs_diff")
        let large: u64 = 3
        assert_equal(large.checked_mul(6148914691236517205), .Some(18446744073709551615), reason="u64 mul fits")
        assert_equal(large.checked_mul(6148914691236517206), .None, reason="u64 mul overflows")
        assert_equal(large.leading_zeros(), 62, reason="u64 width")
        let wide: i64 = 9223372036854775807
        assert_equal(wide.abs_diff(-wide - 1), 18446744073709551615, reason="i64 abs_diff spans the range")
