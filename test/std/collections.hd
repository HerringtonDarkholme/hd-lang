# std.collections: inherent List methods, callable without a use.
use std.testing.assert_equal

fn by_length(a: string, b: string) -> Ordering:
    if a.len() < b.len():
        .Less
    else if a.len() > b.len():
        .Greater
    else:
        .Equal

tests:
    it("map and filter"):
        items := [3, 1, 2]
        assert_equal(items.map(fn(value: i32) -> string: "<$value>"), ["<3>", "<1>", "<2>"], reason="map")
        assert_equal(items.filter(fn(value: i32) -> bool: value > 1), [3, 2], reason="filter")

    it("first, last, and reversed"):
        let empty: List[i32] = []
        assert_equal([4, 5].first(), .Some(4), reason="first")
        assert_equal([4, 5].last(), .Some(5), reason="last")
        assert_equal(empty.first(), .None, reason="an empty list has no first")
        assert_equal([1, 2, 3].reversed(), [3, 2, 1], reason="reversed")

    it("sorted_by is stable"):
        words := ["ccc", "a", "bb", "b", "aa"]
        assert_equal(words.sorted_by(by_length), ["a", "b", "bb", "aa", "ccc"], reason="stable by length")
        assert_equal(words, ["ccc", "a", "bb", "b", "aa"], reason="the receiver is unchanged")

    it("chunks and zip"):
        assert_equal([1, 2, 3, 4, 5].chunks(2), [[1, 2], [3, 4], [5]], reason="the last chunk is short")
        assert_equal([1, 2, 3].zip(["a", "b"]), [(1, "a"), (2, "b")], reason="zip stops at the shorter")

    it("chunks rejects a zero size", expect_panic="explicit-panic"):
        _ := [1].chunks(0)
